<%# ================= SITE CONFIG =================
    Runtime configuration for the static site, rendered into <head> on every page
    before anything that reads it (_partials/analytics, assets/js/caphive.js).

    Why the form endpoint is RESOLVED IN THE BROWSER rather than baked in at
    build time: public/website is built once and committed, and the same built
    files are served by both deployments. caphive.com and caphive.us are separate
    stacks with separate databases, so a single hardcoded URL would post every US
    lead into the India database. The host the visitor is actually on is the only
    thing that can decide, and only the browser knows it.

    Measurement IDs are NOT here — _partials/analytics.html owns the GA4 tag and
    its Consent Mode setup, and having two files that both configure analytics is
    how they drift.
-%>
<script>
(function(){
  /* Website host -> the app host that receives its demo requests. Mirrors
     WEBSITE_HOSTS in each deployment's .env file; keep the two in step, because
     the receiving endpoint only returns CORS headers for origins in that list
     and a mismatch here fails as a browser-side CORS error with nothing in our
     logs to explain it. */
  var ENDPOINTS = {
    'caphive.com':          'https://app.caphive.com/website_leads',
    'www.caphive.com':      'https://app.caphive.com/website_leads',
    'caphive.us':           'https://app.caphive.us/website_leads',
    'www.caphive.us':       'https://app.caphive.us/website_leads',
    /* Staging is deliberately not a caphive.* domain. */
    'altconnects.com':      'https://dev.altconnects.com/website_leads',
    'www.altconnects.com':  'https://dev.altconnects.com/website_leads',
    'dev.altconnects.com':  'https://dev.altconnects.com/website_leads'
  };

  /* Development is the one case the table cannot express. A single Rails process
     serves BOTH the website (Host: caphive.localhost) and the app (Host:
     localhost), on whichever port the developer started it on — 3000 and 3001
     are both in use across this repo's Procfiles and .env.development. So derive
     the app origin from the page's own port rather than hardcoding one and
     having it fail on the other. Still cross-origin: the hostname differs, so
     this exercises the real CORS path rather than quietly bypassing it. */
  function endpointFor(hostname){
    if(/(^|\.)localhost$/.test(hostname)){
      return location.protocol + '//localhost' + (location.port ? ':' + location.port : '') + '/website_leads';
    }
    return ENDPOINTS[hostname] || '';
  }

  window.CAPHIVE = {
    /* Empty for an unrecognised host — a preview deploy, someone's laptop, an
       archived copy. The form then falls back to composing an email in the
       visitor's own mail client rather than posting into a stack that would
       reject it, so an unlisted host degrades instead of silently losing leads. */
    formEndpoint: endpointFor(location.hostname),

    /* Where the browser goes after a successful submission. Having its own URL
       is what makes the conversion measurable. Do not change without updating
       the conversion trigger in the analytics property. */
    thankYouUrl: 'thank-you.html',

    /* The public scheduling link. Every booking CTA on the site stays HIDDEN
       while this is empty, and the header button keeps pointing at the contact
       form — an advertised booking link that does not book is worse than no
       booking link at all.

       Availability must be genuinely bookable in US business hours; for an
       India-based team that means evenings IST. The SAME url belongs in the
       outbound email signature, which is not wired and must be edited by hand
       (docs/marketing/gtm_prerequisites_work/C6_outbound_email_template.md §4).

       If this account is ever closed or renamed, blank this line rather than
       leaving a dead link on the highest-intent button on the site. */
    bookingUrl: 'https://calendly.com/caphive-support'
  };
}());
</script>
