 "cards": [
  {
   "dot": "emerald",
   "title": "Aggregation levels",
   "items": [
    "FundRatioCalcInitializer returns FundPortfolioCalcs (whole fund), CapitalCommitmentCalcs (one commitment), or InvestorKycCalcs when kyc_level_data_gen is on",
    "Calculators compute DPI, RVPI, TVPI, XIRR and friends from ledger cash flows",
    "RatioFormulas add/reduce cashflows, numerators, and denominators per ratio and label"
   ]
  },
  {
   "dot": "violet",
   "title": "Scenario & batch runs",
   "items": [
    "FundRatiosScenarioJob handles cross-fund and cross-portfolio runs; parameters fingerprint into an auditable FundRatioRun (unique per entity + date + name)",
    "FundRatio rows link to their run via the polymorphic computation_context",
    "FundRatioRunTemplateBatchJob fans out template runs; suppress_notification lets a batch send one consolidated alert"
   ]
  },
  {
   "dot": "cyan",
   "title": "After the run",
   "items": [
    "fund.update_latest_fund_ratios(end_date) flags the latest rows per fund",
    "Success or failure lands as a user notification; commitment-level loops skip commitments marked to skip doc gen",
    "xirr_py is the Docker sidecar at ENV[XIRR_API], health-checked by HealthCheckController"
   ]
  }
 ]
