    {
      "dot": "emerald",
      "title": "Application",
      "items": [
        "Rails monolith, server-rendered with Hotwire (Turbo + Stimulus)",
        "Devise with two-factor auth; Pundit policies on every action",
        "Domain packs: core, funds, ai, allocation_engine, secondaries, startups"
      ]
    },
    {
      "dot": "cyan",
      "title": "Data & jobs",
      "items": [
        "MySQL primary + read replica (SQLite in test env)",
        "Sidekiq + sidekiq-cron workers drain Redis queues",
        "Elasticsearch (Chewy) for search; fund documents on S3"
      ]
    },
    {
      "dot": "violet",
      "title": "Integrations",
      "items": [
        "Outbound email over SMTP via Amazon SES; SendGrid Inbound Parse receives mail add-in filings",
        "AI features call OpenAI / Gemini through ruby_llm",
        "xirr_py Docker sidecar computes XIRR / fund ratios over HTTP",
        "caphive.com website served by Rails middleware from public/website"
      ]
    }
