{
  "expo": {
    "name": "CapHive",
    "slug": "caphive-lp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caphive",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.caphive.lp",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock CapHive with Face ID instead of your password."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2023",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.caphive.lp"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F2023",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock CapHive with Face ID instead of your password."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF4D00"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appEnv": "development",
      "regions": [
        {
          "code": "IN",
          "label": "India",
          "url": "http://localhost:3000"
        },
        {
          "code": "US",
          "label": "United States",
          "url": "http://localhost:3000"
        }
      ],
      "eas": {
        "projectId": "216c4051-fca2-44dc-9585-28fb004cc11b"
      },
      "router": {}
    }
  }
}
