#!/usr/bin/env ruby
require "socket"

def container_state(name)
  output = `docker inspect -f "{{.State.Running}}" #{name} 2>/dev/null`.strip
  return :absent if output.empty?
  output == "true" ? :running : :stopped
end

# Resumes an existing stopped container, or creates it (with the given
# `docker run` args) if it has never been created on this machine.
def ensure_container_running(name, *docker_run_args)
  case container_state(name)
  when :running
    # nothing to do
  when :stopped
    puts "Resuming container #{name}..."
    system("docker", "start", name)
  when :absent
    puts "Starting container #{name}..."
    system("docker", "run", "-d", "--name", name, *docker_run_args)
  end
end

ensure_container_running("xirr_py", "--rm", "-p", "8000:80", "-v", "/tmp:/tmp", "thimmaiah/xirr_py:v2.6")
ensure_container_running("mysql8", "-p", "3306:3306",
                          "-e", "MYSQL_ROOT_PASSWORD=root",
                          "-v", "mysql8-data:/var/lib/mysql",
                          "mysql:8")
ensure_container_running("redis", "-p", "6379:6379", "redis/redis-stack-server:latest")
ensure_container_running("elasticsearch", "--rm", "-p", "9200:9200", "-p", "9300:9300",
                          "-e", "ES_JAVA_OPTS=-Xms512m -Xmx512m",
                          "-e", "discovery.type=single-node",
                          "-e", "xpack.security.enabled=false",
                          "elasticsearch:8.15.0")

def port_open?(port, host: "localhost")
  TCPSocket.new(host, port).close
  true
rescue Errno::ECONNREFUSED, SocketError
  false
end

if port_open?(9394)
  puts "Prometheus exporter already running, skipping..."
else
  puts "Starting Prometheus exporter..."
  Process.detach(spawn("bundle exec prometheus_exporter -b 0.0.0.0"))
end

# Bind to all interfaces so the LP mobile app on a phone (same Wi-Fi) can reach it
puts "Starting Rails server on 0.0.0.0:3001..."
exec "./bin/rails", "server", "-b", "0.0.0.0", "-p", "3001", *ARGV

