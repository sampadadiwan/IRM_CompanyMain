<div class="table-responsive">
  <table class="table table-bordered table-hover table-sm align-middle mb-0">
    <thead class="table-dark">
      <tr>
        <% @columns.each do |col| %>
          <th class="text-nowrap"><%= column_label(col) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% if @rows.empty? %>
        <tr>
          <td colspan="<%= @columns.size %>" class="text-center py-4 text-muted">
            No data found matching your filters.
          </td>
        </tr>
      <% else %>
        <% @rows.each do |row| %>
          <tr>
            <% @columns.each do |col| %>
              <% key = column_key(col) %>
              <% clean_key = key.split(";").first.strip %>
              <td>
                <%= format_value(row[clean_key] || row[key], key) %>
              </td>
            <% end %>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
