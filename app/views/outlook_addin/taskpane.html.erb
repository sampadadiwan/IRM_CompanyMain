<div id="main-content">
    <% if Rails.env.development? %>
    <div id="simulator-controls" style="display: none;" class="card">
        <div class="section-title">Simulator: Test Emails</div>
        <input type="text" id="sim-from" placeholder="Enter sender email..." value="john@example.com" class="investor-select">
        <button id="sim-reload" class="btn btn-secondary" style="margin-top:12px;">Refresh Match</button>
    </div>
    <% end %>

    <div id="loading" class="card" style="text-align: center; padding: 40px 20px;">
        <div class="loading-spinner"></div>
        <p style="color: var(--text-muted); font-size: 14px; margin: 0;">Analyzing email context...</p>
    </div>

    <div id="app-body" style="display: none;">
        <div id="message-container"></div>

        <div class="card">
            <div class="section-title">Filing Target</div>
            <div id="investor-display">
                <div id="investor-name" class="value-large">-</div>
            </div>

            <div id="investor-selector-container" style="display: none; margin-top: 8px;">
                <select id="investor-select" class="investor-select">
                    <option value="">Choose an investor...</option>
                </select>
            </div>

            <button id="change-investor-button" class="btn-secondary" style="margin-top: 12px; border:none; background:none; color: var(--primary); font-size: 13px; font-weight:600; cursor:pointer; padding:0; display:none;">
                Change Investor
            </button>
        </div>

        <div class="card">
            <div class="section-title">Email Subject</div>
            <div id="email-subject" style="font-size: 14px; color: var(--text-main); font-weight: 500;">-</div>
        </div>

        <div style="margin-top: 24px;">
            <button id="file-button" class="btn" disabled>
                File to CapHive
            </button>
        </div>
    </div>
</div>

<script type="text/javascript">
    window.emailData = {
        subject: '',
        from: '',
        to: [],
        cc: [],
        body: '',
        messageId: '',
        internetMessageId: '',
        receivedAt: null
    };
    window.matchedInvestors = [];
</script>
