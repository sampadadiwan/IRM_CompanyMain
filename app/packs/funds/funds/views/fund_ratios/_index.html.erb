<% fund ||= nil %>
<% valuation ||= nil %>
<% import_upload_id ||= nil %>
<% data_source ||= fund_ratios_path(params: params.to_unsafe_h, import_upload_id: import_upload_id) %>
<%
  # A fund's Ratios list (fund team and LP): the fund's latest headline ratios as cards, under the
  # heading. When they share one date, the title's subtitle carries it (naming the fund: a feeder's LP
  # page shows its master fund's ratios) and the cards show plain names.
  headline = @headline_ratios.presence
  headline_dates = headline&.map(&:end_date)&.uniq
  shared_date = headline_dates.first if headline_dates&.size == 1
  header_subtitle = "Latest ratios for #{headline.first.fund&.name}, as of #{l(shared_date)}" if shared_date
  # A feeder fund with no ratios of its own: the LP is looking at its master fund's (funds/_investor_fund_details).
  # Only trusted when that fund really is this list's fund's feeder.
  feeder = Fund.find_by(id: params[:ratios_from_master_of]) if params[:ratios_from_master_of].present?
  if feeder && fund && feeder.master_fund_id == fund.id
    caveat = "#{feeder.name} has no ratios of its own yet. These are its master fund #{fund.name}'s ratios."
    header_subtitle = [caveat, header_subtitle].compact.join(" ")
  end
%>
<%= render "fund_ratios/index_header", fund: , valuation: , data_source:, subtitle: header_subtitle %>
<%= render "fund_ratios/headline_cards", fund_ratios: headline, shared_date: shared_date if headline %>
<%= render "fund_ratios/analytics", fund: %>
<% fund_ratios_frame = with_frame("fund_ratios_frame") %>
<% q ||=nil %>
<%=render SearchComponent.new(data_source: data_source, turbo_frame: fund_ratios_frame) %>
<div class="">
  <%= render RansackTable.new(FundRatio, q: q, current_user: current_user, records: fund_ratios, report_id: params["report_id"], turbo_frame: fund_ratios_frame, referrer: request.referrer, pagy: @pagy) %>
</div>
