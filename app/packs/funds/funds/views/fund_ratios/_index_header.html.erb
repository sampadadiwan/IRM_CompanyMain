<% valuation ||= nil %>
<% show_currency_filter ||= nil %>
<%# Optional muted line under the title (e.g. the headline ratio cards' "as of" date). The title column is
    .flex-grow-1 with the small right after the h1, so scaffolds.scss indents it to start where the title does %>
<% subtitle ||= nil %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <div class="flex-grow-1">
    <h1 class="h3 mb-0 text-gray-800">
      <%= params[:title].presence || "Fund Ratios" %>
      <%= link_to l(valuation.valuation_date), valuation if valuation %>
    </h1>
    <% if subtitle.present? %>
      <small class="text-muted" id="fund_ratios_subtitle"><%= subtitle %></small>
    <% end %>
  </div>
  <div class="d-flex flex-wrap align-items-center gap-2">
    <% if show_currency_filter %>
    <div class="d-flex justify-content-end">
      <label for="metrics_filter_select" class="me-2 align-self-center mb-0">Currency:</label>
      <select
        id="metrics_filter_select"
        class="form-select form-select-sm"
        style="width: 120px;"
        data-fund-ratios-filter-target="select"
        data-action="change->fund-ratios-filter#applyFilter">
        <% available_currencies.each do |currency| %>
          <option value="<%= currency %>" <%= 'selected' if currency == entity_currency %>><%= currency %></option>
          <% end %>
        </select>
      </div>
    <% end %>
    <% if fund.present? && !current_user.curr_role_investor? %>
      <%= user_guide_info_icon %>
      <%= render "fund_ratios/bulk_actions" %>
      <button class="btn btn-outline-info d-inline-flex align-items-center" type="button"
              data-bs-toggle="collapse" data-bs-target="#fundRatioAnalytics"
              aria-expanded="false" aria-controls="fundRatioAnalytics">
        <i class="ti ti-chart-bar"></i> Analytics
      </button>
      <% if policy(fund).generate_fund_ratios? %>
        <%= button_to generate_fund_ratios_fund_path(fund),
                      method: :get,
                      class: "btn btn-outline-primary d-inline-flex align-items-center",
                      form_class: "deleteButton",
                      data: {
                        action: "click->confirm#popup",
                        turbo: false,
                        msg: "Ratios computations will take the last portfolio FMV and account entries for 'Cash in Hand' and 'Net Current Assets' prior to end date for the computations. Please check these are updated. Computation will take a few mins, please be patient. Proceed?",
                        method: :get
                      } do %>
          <i class="ti ti-analyze"></i> Compute Ratios
        <% end %>
      <% end %>
      <div class="btn-group">
        <div class="dropdown">
          <button class="btn btn-outline-success dropdown-toggle d-inline-flex align-items-center" type="button"
                  id="fund_ratios_actions"
                  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="ti ti-settings"></i> <%= t_common(:actions) %>
          </button>
          <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
            <%= link_to fund_ratios_path(fund_id: fund.id, q: ransack_query_params("owner_type", :eq, "Investor")),
                        class: "dropdown-item d-flex align-items-center" do %>
              <i class="ti ti-building-bank"></i> Filter: Portfolio Company
            <% end %>
            <%= link_to fund_ratios_path(fund_id: fund.id, q: ransack_query_params("owner_type", :eq, "CapitalCommitment")),
                        class: "dropdown-item d-flex align-items-center" do %>
              <i class="ti ti-users"></i> Filter: Folios
            <% end %>
            <%= link_to fund_ratios_path(fund_id: fund.id, q: ransack_query_params("owner_type", :eq, "AggregatePortfolioInvestment")),
                        class: "dropdown-item d-flex align-items-center" do %>
              <i class="ti ti-briefcase"></i> Filter: Instrument
            <% end %>
            <%= link_to fund_ratios_path(fund_id: fund.id, q: ransack_query_params("owner_type", :eq, "Fund")),
                        class: "dropdown-item d-flex align-items-center" do %>
              <i class="ti ti-circle-off"></i> Filter: Fund Only
            <% end %>
            <%= link_to fund_ratios_path(fund_id: fund.id, q: ransack_query_params("owner_type", :eq, "User")),
                        class: "dropdown-item d-flex align-items-center" do %>
              <i class="ti ti-arrows-join"></i> Filter: Cross-Portfolio Only
            <% end %>
            <div class="dropdown-divider"></div>
            <%= link_to new_import_upload_path(
                            "import_upload[owner_id]": fund.id,
                            "import_upload[owner_type]": "Fund",
                            "import_upload[import_type]": "FundRatio",
                            "sample_upload": "Fund_RATIO_SAMPLE"),
                        class: "dropdown-item d-flex align-items-center" do %>
              <i class="ti ti-upload"></i> <%= t_common(:upload) %>
            <% end %>
            <% xl_data_source = fund_ratios_path(params: params.to_unsafe_h, format: :json, all: true)%>
            <%= link_to download_xl_link(xl_data_source),
                        class: "dropdown-item d-flex align-items-center" do %>
              <i class="ti ti-download"></i> <%= t_common(:download) %>
            <% end %>
            <%= link_to fund_ratio_formulas_path(fund_id: fund.id), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: " View the rules set up for financial ratio computations for this fund"} do %>
              <i class="ti ti-math-function"></i>Ratio Formulas
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
