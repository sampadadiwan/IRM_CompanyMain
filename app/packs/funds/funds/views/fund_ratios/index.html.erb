<%= render "/layouts/filter", associations: [:fund, :portfolio_scenario], hidden_fields: {pivot: params[:pivot]} %>

<%= turbo_frame_tag with_frame("fund_ratios_frame"), target: "_top" do %>
    <% if params[:pivot].present? %>
        <%= render "/fund_ratios/pivot", fund_ratios: @fund_ratios, fund: @fund, pivot: @pivot %>
    <% elsif params[:scenarios].present? %>
        <%= render "/fund_ratios/index_scenarios", fund_ratios: @fund_ratios, fund: @fund %>
    <% elsif params[:timeseries].present? %>
        <%= render "/fund_ratios/index_timeseries", fund_ratios: @fund_ratios, fund: @fund %>
    <% elsif params[:condensed].present? %>
        <%= render "/fund_ratios/index_condensed", fund_ratios: @fund_ratios, q: @q, fund: @fund %>
    <% else %>
        <%= render "/fund_ratios/index", fund_ratios: @fund_ratios, q: @q, fund: @fund %>
    <% end %>

    <% if params[:chart].to_s == "true" && params[:scenarios].blank?%>
      <%= turbo_frame_tag with_frame("fund_ratios_index_chart_frame") do %>
        <div class="mb-3 d-flex justify-content-end">
          <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Chart type">
            <% current_type = params[:chart_type] || "line" %>
            <% [["Area", "area"], ["Bar", "bar"], ["Line", "line"]].each do |label, type| %>
              <%= link_to label, request.params.merge(chart_type: type),
                  class: "btn #{current_type == type ? 'btn-primary' : 'btn-outline-primary bg-white'}",
                  data: { turbo_frame: with_frame("fund_ratios_index_chart_frame") } %>
            <% end %>
          </div>
        </div>
        <%= fund_ratios_line_chart(nil, args: params.to_unsafe_h, fund_ratios: @fund_ratios, months: params[:months], chart_type: params[:chart_type]) %>
      <% end %>
    <% end %>
<% end %>
