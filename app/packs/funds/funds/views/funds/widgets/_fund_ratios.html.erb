<%
  args[:name] = args[:ratio_names].presence
  args_with_widget = args.merge(widget_id: widget.id)
  uri = URI(fund_ratios_path(**args_with_widget))
  owner_id = args[:owner_id] || @fund.id
  owner_type = args[:owner_type] || "Fund"
  fund = args[:fund].to_s == "false" ? nil : @fund
%>
<%= render(
      WidgetCardComponent.new(
        widget: widget,
        args: args,
        widget_size: widget.widget_size
      )
    ) do %>

    <% if args[:list].nil? || args[:list] == true %>
      <%= turbo_frame_tag "fund_ratios_frame_#{widget.id}", target: "_top", src: "#{uri.to_s}" do %>
      <% end %>
    <%end%>

    <% if args[:chart].nil? || args[:chart] == true %>
      <!-- This block becomes the `content` inside the component -->
      <%= turbo_frame_tag "fund_ratios_chart_frame_#{widget.id}" do %>
        <div class="mb-3 d-flex justify-content-end">
          <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Chart type">
            <% current_type = params[:chart_type] || "line" %>
            <% [["Area", "area"], ["Bar", "bar"], ["Line", "line"]].each do |label, type| %>
              <%= link_to label, request.params.merge(chart_type: type),
                  class: "btn #{current_type == type ? 'btn-primary' : 'btn-outline-primary bg-white'}",
                  data: { turbo_frame: "fund_ratios_chart_frame_#{widget.id}" } %>
            <% end %>
          </div>
        </div>
        <%= fund_ratios_line_chart(fund, args: args, owner_id: owner_id, owner_type: owner_type, ratio_names: args[:ratio_names], months: args[:months], chart_id: "fund_ratios_chart_#{widget.id}", chart_type: params[:chart_type]) %>
      <% end %>
    <% end %>

<% end %>
