<%
  # Parse to Date objects so date_field always gets a proper Date (not a raw string)
  start_date ||= params[:start_date].present? ? Date.local_parse(params[:start_date]) : Time.zone.today.beginning_of_quarter
  end_date   ||= params[:end_date].present?   ? Date.local_parse(params[:end_date])   : Time.zone.today.end_of_quarter
  run_allocations = params[:run_allocations] == "true"
  generate_soa = params[:generate_soa] == "true"
  title = run_allocations ? "Allocate Account Entries For : #{@fund.name}" : "Generate Investor Statements For : #{@fund.name}"
%>

<%
  # A running allocation run group that is using this fund, or has yet to reach it, blocks a manual run.
  group_busy = AllocationGroupRun.fund_busy?(@fund.id)
%>
<%= render NewCard.new do %>

  <% if group_busy %>
    <div class="alert alert-warning">
      <i class="ti ti-loader me-1"></i>
      An <strong>allocation run group</strong> is currently running on this fund. A manual run is refused until it finishes —
      <%= link_to "see its progress", allocation_run_templates_path(tab: "runs") %>.
    </div>
  <% end %>

  <div data-controller="rule-validation"
       data-rule-validation-target-model-value="AllocationRun"
       data-rule-validation-record-id-value=""
       data-rule-validation-evaluate-url-value="<%= evaluate_validation_rules_path %>">

  <%= render FormCard.new(title:, header_css_class: "fs-5") do %>

  <%= form_with(model: @fund, url: allocate_fund_path(@fund), method: :patch) do |form| %>

    <%= form.text_field :sample, class: "form-control", name: "sample", value: params[:sample], hidden: true %>
    <%# Included so the rule-validation Stimulus controller can pass fund_id to the evaluate endpoint %>
    <%= hidden_field_tag :fund_id, @fund.id %>

    <div class="form-group">
      <%= form.label :start_date %>
      <%= form.date_field :start_date, class: "form-control", name: "start_date", value: start_date %>
    </div>

    <div class="form-group">
      <%= form.label :end_date %>
      <%= form.date_field :end_date, class: "form-control", name: "end_date", value: end_date %>
    </div>

    <% if run_allocations %>
    <div class="form-group">
      <%= form.label :run_allocations, "Run Allocation Formulas" %>
      <%= form.check_box :run_allocations, class: "form-check-input", name: "run_allocations", value: true, checked: run_allocations %>
      <small class="text-muted">Check if you want to run all formulas</small>
    </div>

    <div class="form-group">
      <%= form.label :explain, "Explain Formulas" %>
      <%= form.check_box :explain, class: "form-check-input", name: "explain", value: true, checked: run_allocations %>
      <small class="text-muted">Check if you formulas to be explained</small>
    </div>

    <div class="form-group">
      <%= form.label :rule_for, "For" %>
      <% selected = params[:rule_for] || "Accounting" %>
      <%= form.select :rule_for, ["Accounting", "Reporting"],  {include_blank: "Both", selected: selected}, class: "form-control", name: "rule_for" %>
    </div>

    <% if @fund.entity.entity_setting.formula_tag_list.present? %>
      <% tag_list = @fund.entity.entity_setting.formula_tag_list.split(",").map(&:strip) %>
      <div class="form-group">
        <% selected = params[:tag_list]&.split(",") || [] %>
        <%= form.label :tag_list %>
        <%= form.select :tag_list, tag_list, {include_hidden: false, selected: selected}, class: "form-control select2", multiple: true, name: "tag_list[]" %>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :fund_ratios, "Generate Fund Ratios" %>
      <%= form.check_box :fund_ratios, class: "form-check-input", name: "fund_ratios", value: true %>
      <small class="text-muted">Check if the fund ratios should be generated post the allocation process</small>
    </div>
    <% end %>

    <div data-controller="conditional-visibility">
      <div class="form-group">
        <%= form.label :generate_soa, "Generate Investor Statements" %>
        <%= form.check_box :generate_soa, class: "form-check-input", name: "generate_soa", value: true, checked: generate_soa, "data-action": "conditional-visibility#toggle", "data-conditional-visibility-target": "source" %>
        <small class="text-muted">Check if the Investor Statement for each LP should be generated post the allocation process</small>
      </div>

      <div data-conditional-visibility-target="conditional">
        <div class="form-group">
          <%= form.label :statement_for %>
          <%= form.select :statement_for, ["Commitment", "Investing Entity"], {}, class: "form-control", name: "statement_for"  %>
        </div>

        <div class="form-group">
          <%= form.label :template_name, "Investor Statement Template" %>
          <%
            # This block renders unconditionally regardless of the generate_soa checkbox
            # (conditional-visibility only hides it with CSS/JS), so a fund with zero
            # capital commitments — a brand new fund, or a Cucumber fixture that only sets
            # up an allocation run — must not crash the whole page just to show this select.
            statement_document_options = @fund.capital_commitments.first&.templates(["SOA Template", "Investor Statement Template"])&.map { |d| [d.name, d.id] } || []
          %>
          <%= form.select :template_name, statement_document_options, {}, class: "form-control", name: "template_id"  %>
          <small class="text-muted">Select the template to be used for Investor Statement generation. </small>
        </div>
      </div>
    </div>

    <div class="form-group">
      <%= form.submit "Submit", {class: "btn btn-outline-primary", disabled: group_busy}%>
      <%= link_to allocation_run_templates_path, class: "btn btn-outline-secondary ms-2", data: { bs_toggle: "tooltip" },
                  title: "Save these settings once and run several funds in order with one action" do %>
        <i class="ti ti-template"></i> Allocation Run Templates
      <% end %>
    </div>
  <% end %>

  <% end %>

  </div><%# /rule-validation controller wrapper %>

<% end %>

<div class="associated_entity" data-controller="datatable tooltip">

  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Previous Runs</h1>
    <div>
      <%= link_to allocation_run_templates_path, class: "btn btn-sm btn-outline-secondary", data: { bs_toggle: "tooltip" },
                  title: "Save these settings once and run several funds in order with one action" do %>
        <i class="ti ti-template"></i> Allocation Run Templates
      <% end %>
      <% if policy(@fund).period_report? %>
        <%= form_with url: fund_report_account_entry_reports_path, method: :get, local: true, class: "d-inline-flex align-items-end gap-2" do |f| %>
          <%= f.hidden_field :fund_id, value: @fund.id, id: nil %>
          <%= f.date_field :start_date, value: start_date, class: "form-control form-control-sm", title: "Report start date" %>
          <%= f.date_field :end_date, value: end_date, class: "form-control form-control-sm", title: "Report end date" %>
          <%= f.submit "View Account Entries Report", class: "btn btn-sm btn-outline-success" %>
        <% end %>
      <% end %>
      <% if policy(AllocationRun).unlock_all? && @fund.present? %>
        <%= button_to "Unlock All", unlock_all_allocation_runs_path(fund_id: @fund.id), class: "btn btn-sm btn-outline-warning", method: :patch, form_class: "deleteButton", data: { action: "click->confirm#popup", method: :patch, msg: "Are you sure you want to unlock all AllocationRuns?" } %>
      <% end %>
    </div>
  </div>

  <table class="table table-bordered dataTable jqDataTable">
    <thead>
      <tr>
          <th>
            Start Date
          </th>
          <th>
            End Date
          </th>
          <th>
            Run Allocations
          </th>
          <th>
            Generate Fund Ratios
          </th>
          <th>
            Generate SOA
          </th>
          <th>
            Template
          </th>
          <th>
            On
          </th>
          <th>
            By
          </th>
          <th>
            For
          </th>
          <th>
            Status
          </th>
          <th>
            Locked
          </th>
          <th>

          </th>
      </tr>
    </thead>

    <tbody>
      <%
        # Loaded once and reused below for the "Save as template" modal loop (an in-memory
        # filter on this same array), and the create? policy is evaluated once — neither
        # depends on which row is being rendered, so per-row re-evaluation was pure waste.
        all_runs = @fund.allocation_runs.includes(:user, :fund).order(created_at: :desc).to_a
        can_save_template = policy(AllocationRunTemplate.new(entity_id: @fund.entity_id, fund: @fund)).create?
      %>
      <% all_runs.each do |runs|  %>
        <tr>
          <td>
            <%= l runs.start_date, format: :abbr_month_day_year %>
          </td>
          <td>
            <%= l runs.end_date, format: :abbr_month_day_year %>
          </td>
          <td>
            <%= display_boolean runs.run_allocations %>
          </td>
          <td>
            <%= display_boolean runs.fund_ratios %>
          </td>
          <td>
            <%= display_boolean runs.generate_soa %>
          </td>
          <td>
            <%= runs.template_name %>
          </td>
          <td>
            <%= l runs.created_at %>
          </td>
          <td>
            <%= runs.user.full_name %>
          </td>
          <td>
            <%= runs.rule_for.presence || "Both" %> <br>
            <%= runs.tag_list %>
          </td>
          <td>
            <%= runs.status %>
          </td>
          <td>
            <%= display_boolean runs.locked %>
          </td>
          <td>
            <div class="d-flex gap-1 flex-wrap">
              <% if runs.locked %>
                <%# data-bs-toggle="tooltip" would make tooltip_controller#initTooltips hand this
                    element to Bootstrap's Tooltip, which clears the title attribute on init (moving
                    it to data-bs-original-title) — Capybara's :button locator reads title, so that
                    would make this icon-only button unfindable by "Unlock". Native title tooltip only,
                    same workaround as "Save as template" below. %>
                <%= form_with model: false, url: unlock_allocation_run_path(runs), method: :patch, class: "d-inline" do %>
                  <%= button_tag class: "btn btn-sm btn-outline-warning", data: { confirm: "Are you sure you want to unlock this AllocationRun?" }, title: "Unlock" do %>
                    <i class="ti ti-lock-open"></i>
                  <% end %>
                <% end %>
              <% else %>
                <%= link_to allocate_form_fund_path(runs.attributes), class: "btn btn-sm btn-outline-primary", data: { bs_toggle: "tooltip" }, title: "Rerun" do %>
                  <i class="ti ti-refresh"></i>
                <% end %>
                <% if can_save_template %>
                  <%# data-bs-toggle is already claimed by the modal trigger here, so this uses the
                      browser's native title tooltip rather than data-bs-toggle="tooltip" — same
                      workaround used elsewhere in the app for modal-trigger buttons. Deliberately
                      NOT also given a plain data-toggle="tooltip": tooltip_controller#initTooltips
                      matches that attribute too, and Bootstrap's Tooltip clears an element's title
                      attribute on init (moving it to data-bs-original-title), which would make
                      Capybara's button locator — which reads the title attribute — find nothing.
                      The title has to start with the button's accessible name, "Save as template" —
                      Capybara's default :button locator matches on the title attribute (substring,
                      Capybara.exact = false in this suite), and this app doesn't enable aria-label
                      matching, so an icon-only button is only findable by its title text. %>
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#saveTemplateModal-<%= runs.id %>"
                          title="Save as template — copies this run's fund and options into a reusable allocation run template (the period is not saved)">
                    <i class="ti ti-template"></i>
                  </button>
                <% end %>
                <%# Same tooltip/title conflict as "Unlock" above — data-bs-toggle="tooltip" clears
                    the title attribute Capybara's :button locator relies on to find "Lock". %>
                <%= form_with model: false, url: lock_allocation_run_path(runs), method: :patch, class: "d-inline" do %>
                  <%= button_tag class: "btn btn-sm btn-outline-danger", data: { confirm: "Are you sure you want to lock this AllocationRun?" }, title: "Lock" do %>
                    <i class="ti ti-lock"></i>
                  <% end %>
                <% end %>
              <% end %>
              <% if runs.created_at > Date.local_parse("29/03/2025") %>
                <%= link_to account_entries_path(filter: true, fund_id: @fund.id, q: ransack_query_params_multiple([["allocation_run_id", :eq, runs.id], ["reporting_date", :eq, runs.end_date.to_fs(:db)]])), class: "btn btn-sm btn-outline-info", data: { bs_toggle: "tooltip" }, title: "Account Entries" do %>
                  <i class="ti ti-list-details"></i>
                <% end %>
              <% end %>
              <% if policy(@fund).period_report? %>
                <%= link_to fund_report_account_entry_reports_path(fund_id: @fund.id, start_date: runs.start_date, end_date: runs.end_date), class: "btn btn-sm btn-outline-success", data: { bs_toggle: "tooltip" }, title: "View Report" do %>
                  <i class="ti ti-report-analytics"></i>
                <% end %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# "Save as allocation run template" modals, one per unlocked run, rendered outside the table.
    Filters the already-loaded all_runs in memory instead of re-querying. %>
<% if can_save_template %>
  <% all_runs.reject(&:locked).each do |runs| %>
    <%= render "allocation_run_templates/save_as_template_modal", run: runs %>
  <% end %>
<% end %>
