<%= render "/funds/stats" if current_user.curr_role_employee? %>
<% if params[:card].present? %>
  <% title = link_to("Funds", funds_path) %>
  <% card_type = params[:card].to_s.presence_in(%w[card card2 card3 card4 card5]) || "card" %>
  <%= render ToggleCard.new(title:, css_class: "show_funds") do %>
    <%= render "entities/vc_dashboard_menus" if current_user.curr_role_investor? %>
    <% funds.includes([:capital_commitments, :entity, :evergreen_fund_setting]).each do |fund| %>
      <%# Evergreen funds show NAV figures on their card (open-ended-funds B2) %>
      <%= render fund.evergreen? ? "evergreen/funds/card" : "/funds/#{card_type}", fund: fund %>
    <% end %>
    <div class="d-flex justify-content-between align-items-center">
      <%= raw pagy_info(@pagy) %>
      <%= raw pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
<% else %>
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Funds</h1>
    <span>
      <% if policy(Fund.new(entity_id: current_user.entity_id)).new? %>
        <%= link_to "New Fund" , new_fund_path, {class: "btn btn-outline-primary ti ti-plus" } %>
        <%= link_to assistant_path('assistant', assistant_type: 'FundAssistant'), class: "btn btn-outline-success", data: {bs_toggle: "tooltip", bs_title: "Launch Fund Assistant to query across."} do %>
          <i class="ti ti-brand-github-copilot"></i> Fund Assistant
        <% end %>
      <% end %>
      <% anchor_fund = funds.first %>
      <% if anchor_fund && policy(anchor_fund).generate_fund_ratios? %>
        <%= link_to generate_fund_ratios_fund_path(anchor_fund, tab: "cross-fund-tab"),
              class: "btn btn-outline-secondary d-inline-flex align-items-center",
              data: { bs_toggle: "tooltip", bs_title: "Generate cross-fund ratios across multiple funds" } do %>
          <i class="ti ti-chart-dots me-1"></i> Cross-Fund Ratios
        <% end %>
      <% end %>
      <% unless current_user.curr_role_investor? %>
        <% if current_user.entity.support_agents.set?(:fund_stats_agent) %>
          <button type="button" class="btn btn-outline-info"
                  data-bs-toggle="modal" data-bs-target="#run-fund-stats-agent-modal">
            <i class="ti ti-robot"></i> Run Fund Stats Agent
          </button>
        <% else %>
          <!-- fund_stats_agent disabled: visible but non-functional -->
          <span data-bs-toggle="tooltip" title="Fund Stats Agent is disabled. Contact support to enable it">
            <button class="btn btn-outline-info" style="filter:grayscale(100%) opacity(0.7); pointer-events:none;">
              <i class="ti ti-robot"></i> Run Fund Stats Agent <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
            </button>
          </span>
        <% end %>
      <% end %>
      <% if current_user.curr_role == "employee" %>
        <a  class="p-8 bg-primary-subtle rounded-1 me-3 d-inline-flex align-middle align-items-center justify-content-center"
              href="<%=funds_path(card: :card5)%>" >
          <i class="ti ti-grid-dots text-primary fs-6"></i>
        </a>
      <% end %>
    </span>

    <% if current_user.entity.support_agents.set?(:fund_stats_agent) %>
      <%
        fund_stats_agent_record = SupportAgent.find_by(entity_id: current_user.entity_id, agent_type: "FundStatsAgent")
        fund_stats_desc = fund_stats_agent_record&.description || "Analyzes fund performance and generates consolidated fund statistics."
      %>
      <%= render "support_agents/agent_run_modal",
                 modal_id:         "run-fund-stats-agent-modal",
                 agent_type:       "FundStatsAgent",
                 target_id:        current_user.entity.id,
                 description:      fund_stats_desc,
                 long_description: FundStatsAgent::LONG_DESCRIPTION %>
    <% end %>
  </div>
  <%# D21 — the firm's chosen columns (or the list's own, Fund::LIST_COLUMNS), sorted, searched and paged in the page
      by jQuery DataTables: sortable: false (no Ransack sort links), pagy: nil (DataTables pages).
      openspec/changes/grid-columns-inline-settings — H19 %>
  <% list_columns = current_user.curr_role_investor? ? Fund::INVESTOR_LIST_COLUMNS : Fund::LIST_COLUMNS %>
  <% funds_table = RansackTable.new(Fund, q: @q, default_columns_map: list_columns, current_user: current_user, records: funds,
                                    report_id: params["report_id"], turbo_frame: "funds_frame", referrer: request.referrer,
                                    snapshot: params[:snapshot], pagy: nil, table_css_class: "jqDataTable", sortable: false) %>
  <%# Responsive details on (the ▶ expander): a firm's own columns may not all fit; folded ones stay reachable %>
  <div data-controller="datatable" data-datatable-responsive-details-value=true
       data-datatable-money-columns-value="<%= funds_table.money_column_indexes %>">
    <span id="funds-table-search-help" class="visually-hidden" aria-live="polite">
      Table content updates as you type in the search field.
    </span>
    <%= render funds_table %>
  </div>
<% end %>
