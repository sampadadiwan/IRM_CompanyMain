<%# Evergreen funds use the same page structure; each switch below renders the evergreen version
    only for evergreen funds, so closed-ended funds render exactly as before (open-ended-funds B2) %>
<%
commands = @fund.evergreen? ? [
    ["New Order", new_evergreen_order_path(@fund, kind: "subscription")],
    ["Draft / Upload NAV", evergreen_navs_path(@fund)],
    # Review fix 9: the fund's wording ("Transaction Dates" in US English), as the Actions menu and tab say
    [EvergreenLabels.t(:transaction_date, fund: @fund).titleize.pluralize, evergreen_dealing_dates_path(@fund)]
] : [
    ["New Commitment", new_capital_commitment_path("capital_commitment[fund_id]": @fund.id)],
    ["Upload Commitments", new_import_upload_path("import_upload[owner_id]": @fund.id, "import_upload[owner_type]": "Fund", "import_upload[import_type]": "CapitalCommitment")],
    ["Download Commitments", capital_commitments_path(all: true, fund_id: @fund.id, format: :xlsx)]
]

%>
<%= render "funds/hotkeys", commands:, model: @fund %>
<% if current_user.entity_id == @fund.entity_id || current_user.curr_role == "advisor" %>
  <%= render(@fund.evergreen? ? "evergreen/funds/stats" : "/funds/fund_stats", fund: @fund) %>
<% else %>
  <%= render(@fund.evergreen? ? "evergreen/funds/investor_stats" : "/funds/fund_investor_stats", fund: @fund) %>
<% end %>
<% if current_user.entity_id == @fund.entity_id || current_user.entity.child_ids.include?(@fund.entity_id) %>
  <div class="container-fluid p-3">
    <%= render "funds/show2", fund: @fund %>
    <% if @fund.tracking_currency_change_pending? && !@fund.snapshot %>
      <%= render "funds/tracking_currency_change_banner", fund: @fund %>
    <% end %>
    <%= render "funds/lp_portfolio_picks_notice", fund: @fund %>
    <!-- Snapshot cannot have details -->
    <% if @fund.evergreen? %>
      <%= render "evergreen/funds/actions", fund: @fund %>
    <% elsif !@fund.snapshot %>
      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <% if policy(@fund).update? %>
          <div class="btn-group">
            <div class="dropdown">
              <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                      data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="ti ti-file-report"></i>Reports
              </button>
              <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                <li class="dropdown-submenu dropend">
                  <a href="#" id="basic_reports" data-bs-toggle="dropdown" class="dropdown-item dropdown-toggle">
                    <i class="ti ti-report"></i>Basic Reports
                  </a>
                  <ul class="dropdown-menu">
                    <li>
                      <%= link_to documents_path(fund_id: @fund.id, q: ransack_query_params_multiple([[:capital_commitment_fund_id, :eq, @fund.id], [:owner_type, :eq, "CapitalCommitment"]]), template: "/e_signatures/e_signatures"), class: "dropdown-item" do %>
                        <i class="ti ti-signature"></i>eSignatures Report
                      <% end %>
                    </li>
                    <li>
                      <%= link_to export_fund_path(@fund), class: "dropdown-item" do %>
                        <i class="ti ti-database-export"></i>Fund Export
                      <% end %>
                    </li>
                    <li>
                      <%= link_to report_fund_path(@fund, report: "dashboard/foreign_remittances"), class: "dropdown-item" do %>
                        <i class="ti ti-currency-dollar"></i>Foreign Remittances
                      <% end %>
                    </li>
                    <li>
                      <%= link_to report_fund_path(@fund, report: "dashboard/chart"), class: "dropdown-item" do %>
                        <i class="ti ti-chart-bar"></i>Fund Numbers
                      <% end %>
                    </li>
                    <li>
                      <%= link_to dashboard_fund_path(@fund), class: "dropdown-item" do %>
                        <i class="ti ti-layout-dashboard"></i>Dashboard
                      <% end %>
                    </li>
                    <li>
                      <%= link_to report_fund_path(@fund, report: "dashboard/calls_report"), class: "dropdown-item" do %>
                        <i class="ti ti-phone-call"></i>Pending Remittances
                      <% end %>
                    </li>
                    <li>
                      <%= link_to report_fund_path(@fund, report: "dashboard/advisor_payouts"), class: "dropdown-item" do %>
                        <i class="ti ti-user-dollar"></i>Advisor Payouts
                      <% end %>
                    </li>
                    <li>
                      <%= link_to "Collected without Fund Units", capital_commitments_path(filter: true, fund_id: @fund.id, q: ransack_query_params("units_amount_minus_collected", :lt, 0)), class: "dropdown-item ti ti-x"%>
                    </li>
                  </ul>
                </li>
                <div class="dropdown-divider"></div>
                <%= link_to dashboard_fund_path(@fund), class: "dropdown-item" do %>
                  <i class="ti ti-layout-dashboard"></i>Dashboard
                <% end %>
                <%= link_to report_fund_path(@fund, report: "dashboard/sign_in_count"), class: "dropdown-item" do %>
                  <i class="ti ti-login"></i>Sign In Report
                <% end %>
                <%= link_to report_fund_path(@fund, report: "dashboard/onboarding_report", show_docs: true), class: "dropdown-item" do %>
                  <i class="ti ti-user-check"></i>Onboarding Report
                <% end %>
                <div class="dropdown-divider"></div>
                <%= link_to report_fund_path(@fund, report: "generate_reports"), class: "dropdown-item" do %>
                  <i class="ti ti-settings-cog"></i>Generate Reports
                <% end %>
              </div>
            </div>
          </div>
          <% if @fund.entity.entity_setting.regulatory_env == "SEBI" %>
            <div class="btn-group">
              <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <i class="ti ti-file-report"></i>Fund Reports
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                  <% if policy(FundReport.new(fund_id: @fund.id, entity_id: @fund.entity_id)).new? %>
                    <%= link_to new_fund_report_path(fund_id: @fund.id), class: "dropdown-item" do %>
                      <i class="ti ti-settings-cog"></i>Generate Reports
                    <% end %>
                  <% end %>
                  <%= link_to fund_reports_path(fund_id: @fund.id), class: "dropdown-item" do %>
                    <i class="ti ti-folder"></i>All Reports
                  <% end %>
                  <div class="dropdown-divider"></div>
                  <%= link_to fund_reports_path(fund_id: @fund.id, name: "CorpusDetails"), class: "dropdown-item" do %>
                    <i class="ti ti-building-bank"></i>Corpus Details
                  <% end %>
                  <%= link_to fund_reports_path(fund_id: @fund.id, name: "InformationOnInvestments"), class: "dropdown-item" do %>
                    <i class="ti ti-briefcase"></i>Information on Investments
                  <% end %>
                  <%= link_to fund_reports_path(fund_id: @fund.id, name: "InfoOnInvestors"), class: "dropdown-item" do %>
                    <i class="ti ti-users"></i>Info on Stakeholders
                  <% end %>
                  <%= link_to fund_report_path(fund_id: @fund.id, report: "sebi_report"), class: "dropdown-item" do %>
                    <i class="ti ti-file-download"></i> <%= t_common(:download) %> SEBI Report
                  <% end %>
                  <div class="dropdown-divider"></div>
                  <%= link_to fund_report_path(fund_id: @fund.id, report: "crisil_report"), class: "dropdown-item" do %>
                    <i class="ti ti-file-download"></i> <%= t_common(:download) %> CRISIL Report
                  <% end %>
                  <%= link_to portfolio_investments_report_all_investors_path(fund_id: @fund.id), class: "dropdown-item" do %>
                    <i class="ti ti-chart-pie"></i>Portfolio Investment Report
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
          <% if policy(@fund).update? %>
            <div class="btn-group">
              <div class="dropdown">
                <button class="btn btn-outline-primary dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <i class="ti ti-upload"></i>Import
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                  <% if @fund.entity.permissions.enable_account_entries? %>
                    <%= link_to new_import_upload_path(
                                  "import_upload[owner_id]": @fund.id,
                                  "import_upload[owner_type]": "Fund",
                                  "import_upload[import_type]": "AccountEntry",
                                  "sample_upload": "ACCOUNT_ENTRY_SAMPLE"),
                                class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Bulk upload fees, income, expenses etc in an excel file. These can be fund level or individual folio level across periods"} do %>
                      <i class="ti ti-file-text"></i>Import Account Entries
                    <% end %>
                  <% end %>
                  <%= link_to new_import_upload_path(
                                "import_upload[owner_id]": @fund.id,
                                "import_upload[owner_type]": "Fund",
                                "import_upload[import_type]": "FundDocs",
                                "sample_upload": "FUND_DOCS_SAMPLE"),
                              class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Bulk upload investor level documents like statements, call / distbution notice, agreements. \n Attach a zip file containing index for mapping the documents to investors. Sample upload zip is provided on the next screen."} do %>
                    <i class="ti ti-file-upload"></i>Import Documents
                  <% end %>
                  <%= link_to new_import_upload_path(
                                "import_upload[owner_id]": @fund.id,
                                "import_upload[owner_type]": "Fund",
                                "import_upload[import_type]": "InvestorAdvisor",
                                "sample_upload": "FUND_INVESTOR_ADVISORS_SAMPLE"),
                              class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Bulk upload investor advisors"} do %>
                    <i class="ti ti-user-plus"></i>Import Investor Advisors
                  <% end %>
                </div>
              </div>
            </div>
            <% if @fund.entity.support_agents.fund_assistant? %>
              <%= link_to assistant_path('assistant', assistant_type: 'SpecificFundAssistant', owner_id: @fund.id, owner_type: "Fund"), class: "btn btn-outline-success", data: {bs_toggle: "tooltip", bs_title: "Launch Fund Assistant to help you with fund details, capital calls, commitments, remittances, distributions, portfolio investments, and fund ratios."} do %>
                <i class="ti ti-brand-github-copilot"></i> Fund Assistant
              <% end %>
            <% else %>
              <!-- fund_assistant disabled: visible but non-functional -->
              <span data-bs-toggle="tooltip" title="Fund Assistant is disabled. Contact support to enable it">
                <button class="btn btn-outline-success" style="filter:grayscale(100%) opacity(0.7); pointer-events:none;">
                  <i class="ti ti-brand-github-copilot"></i> Fund Assistant <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
                </button>
              </span>
            <% end %>
          <% end %>
          <div class="btn-group">
            <div class="dropdown">
              <button class="btn btn-outline-primary dropdown-toggle" type="button"
                      data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="ti ti-settings"></i> <%= t_common(:actions) %>
              </button>
              <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                <%# Derivatives — only when the entity and the fund have the feature (fund-market-data, card ⑥) %>
                <% if @fund.feature_enabled?(:enable_derivatives) %>
                  <%= link_to fund_derivative_contracts_path(@fund), class: "dropdown-item" do %>
                    <i class="ti ti-chart-arrows"></i> Derivatives
                  <% end %>
                <% end %>
                <% if policy(@fund).update? %>
                  <%= link_to edit_fund_path(@fund), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Edit fund level setting such as defining unit types, linking Master Fund, Fund signatory email"} do %>
                    <i class="ti ti-edit"></i> <%= t_common(:edit) %> Fund
                  <% end %>
                  <% if policy(@fund).destroy? %>
                    <%= button_to @fund, method: :delete, class: "dropdown-item", form_class: "deleteButton",
                          data: {action: "click->confirm#popup", turbo: false} do %>
                      <i class="ti ti-trash"></i> <%= t_common(:delete) %> Fund
                    <% end %>
                  <% end %>
                  <%= link_to new_approval_path("approval[owner_id]": @fund.id, "approval[owner_type]": "Fund"), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Create a approval request for users with access to the fund"} do %>
                    <i class="ti ti-checkup-list"></i>Fund Approval
                  <% end %>
                  <% if policy(@fund).run_checks? %>
                    <div class="dropdown-divider"></div>
                    <%= link_to run_checks_ai_checks_path(parent_id: @fund.id, parent_type: "Fund", rule_type: "compliance"), class: "dropdown-item" do %>
                      <i class="ti ti-shield-check"></i>Run Compliance Check
                    <% end %>
                    <%= link_to ai_checks_path(q: ransack_query_params_multiple([[:ai_rule_rule_type, :eq, "compliance"], [:parent_id, :eq, @fund.id], [:parent_type, :eq, "Fund"]])), class: "dropdown-item" do %>
                      <i class="ti ti-eye"></i>View Compliance Check
                    <% end %>
                  <% end %>
                <% end %>
                <% if @fund.entity.permissions.enable_account_entries? %>
                  <div class="dropdown-divider"></div>
                  <li class="dropdown-submenu dropend">
                    <a href="#" id="basic_reports" data-bs-toggle="dropdown" class="dropdown-item dropdown-toggle">
                      <i class="ti ti-report-money"></i>Account Entries
                    </a>
                    <ul class="dropdown-menu">
                      <li>
                        <%= link_to account_entries_path(fund_id: @fund.id, fund_accounts_only: true), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "View / add fund / investor level  fees, income, expenses"} do %>
                          <i class="ti ti-article"></i>Fund Account Entries
                        <% end %>
                      </li>
                      <li>
                        <%= link_to fund_formulas_path(fund_id: @fund.id, all: true), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: " View the rules set up for allocations / computations for this fund"} do %>
                          <i class="ti ti-function"></i>Allocation Formulas
                        <% end %>
                      </li>
                      <li>
                        <%= link_to fund_ratio_formulas_path(fund_id: @fund.id), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: " View the rules set up for financial ratio computations for this fund"} do %>
                          <i class="ti ti-math-function"></i>Ratio Formulas
                        <% end %>
                      </li>
                      <% if policy(@fund).allocate? %>
                        <li>
                          <%= link_to allocate_form_fund_path(@fund, run_allocations: true), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Run allocation computations for this fund"} do %>
                            <i class="ti ti-calculator"></i>Allocate Account Entries
                          <% end %>
                        </li>
                      <% end %>
                      <li>
                        <%# Fund financial statements (Balance Sheet, P&L, ...) built from the account entries %>
                        <%= link_to financial_statements_path(fund_id: @fund.id), class: "dropdown-item", id: "fund_financial_statements_link", data: {bs_toggle: "tooltip", bs_title: "Balance Sheet, P&L and schedules built from this fund's account entries"} do %>
                          <i class="ti ti-file-spreadsheet"></i>Financial Statements
                        <% end %>
                      </li>
                    </ul>
                  </li>
                <% end %>
                <% if policy(@fund).update? %>
                  <%
                      document = Document.new(entity_id: @fund.entity_id , owner: @fund)
                      doc_attributes = document.attributes.delete_if { |k,v| !["entity_id", "owner_id", "owner_type"].include?(k) }
                    %>
                  <div class="d-none d-sm-block">
                    <li class="dropdown-submenu dropend">
                      <a href="#" id="misc_action_menu" data-bs-toggle="dropdown" class="dropdown-item dropdown-toggle">
                        <i class="ti ti-dots"></i>Misc
                      </a>
                      <ul class="dropdown-menu">
                        <li>
                          <%= link_to new_document_path(document: doc_attributes, "document[folder_id]": @fund.document_folder.id), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Add word templates for agreement, notices, statements"} do %>
                            <i class="ti ti-file-plus"></i>New Template
                          <% end %>
                        </li>
                        <li>
                          <%= link_to new_investor_notice_path("investor_notice[owner_id]": @fund.id, "investor_notice[owner_type]": "Fund"), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Add a new investor notice for this fund"} do %>
                            <i class="ti ti-bell-plus"></i>Add Investor Notice
                          <% end %>
                        </li>
                        <li>
                          <%= link_to "mailto:?bcc=#{@fund.get_lps_emails&.join(',')}&subject=#{@fund.name}:", class: "dropdown-item" do %>
                            <i class="ti ti-mail"></i>Send Email
                          <% end %>
                        </li>
                        <li>
                          <%= link_to check_access_rights_fund_path(@fund, create_missing: false), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Check whether all commitments for the fund have associated access rights"} do %>
                            <i class="ti ti-lock-access"></i>Check Access Rights
                          <% end %>
                        </li>
                        <li>
                          <%= link_to show_email_list_fund_path(@fund), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "View the details of all users with access to your fund "} do %>
                            <i class="ti ti-list-details"></i>Show Email List
                          <% end %>
                        </li>
                        <li>
                          <% if @fund.entity.support_agents.set?(:fund_stats_agent) %>
                            <button type="button" class="dropdown-item ti ti-chart-histogram"
                                    data-bs-toggle="modal" data-bs-target="#run-fund-stats-agent-modal">
                              Run Fund Stats
                            </button>
                          <% else %>
                            <span class="dropdown-item disabled text-muted ti ti-chart-histogram" style="opacity:0.65; pointer-events:auto; cursor:default;" data-bs-toggle="tooltip" data-bs-title="Fund Stats Agent is disabled. Contact support to enable it">
                              Run Fund Stats <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
                            </span>
                          <% end %>
                        </li>
                        <% if policy(@fund).update? %>
                          <li>
                            <% if @fund.entity.support_agents.set?(:rta_reconciliation_agent) %>
                              <button type="button" class="dropdown-item ti ti-file-check"
                                      data-bs-toggle="modal" data-bs-target="#run-rta-reconciliation-modal">
                                Run RTA Reconciliation
                              </button>
                            <% else %>
                              <span class="dropdown-item disabled text-muted ti ti-file-check" style="opacity:0.65; pointer-events:auto; cursor:default;" data-bs-toggle="tooltip" data-bs-title="RTA Reconciliation Agent is disabled. Contact support to enable it">
                                Run RTA Reconciliation <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
                              </span>
                            <% end %>
                          </li>
                        <% end %>
                        <li>
                          <%= button_to generate_tracking_numbers_fund_path(@fund), method: :post, class: "dropdown-item", form_class: "deleteButton", data: {bs_toggle: "tooltip", bs_title: "In case a second tracking currency (i.e. a reference currency amount converting all payments, account entries etc based on the exchange rates uploaded for the relevant dates) is set up for your fund, select this option to generate the numbers now. By default the numbers are generated every night"} do %>
                            <i class="ti ti-barcode"></i>Generate Tracking Numbers
                          <% end %>
                          <%# Support only (FundPolicy#force_generate_tracking_numbers?); was ?debug=true for anyone. %>
                          <% if policy(@fund).force_generate_tracking_numbers? %>
                            <%= button_to generate_tracking_numbers_fund_path(@fund, force: true), class: "dropdown-item", method: :post, form_class: "deleteButton", data: { bs_toggle: "tooltip", bs_title: "This will force regenerate tracking numbers for this fund even if the tracking numbers are already generated. Are you sure?"} do %>
                              <i class="ti ti-barcode"></i>Generate Tracking Numbers (Force Regeneration)
                            <% end %>
                          <% end %>
                        </li>
                        <% if policy(@fund).change_tracking_currency? %>
                          <li>
                            <%= link_to change_tracking_currency_fund_path(@fund), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Support only. Change or remove the fund's tracking currency and rebuild every tracking amount and fund ratio at historical exchange rates."} do %>
                              <i class="ti ti-currency-dollar"></i>Change Tracking Currency
                            <% end %>
                          </li>
                        <% end %>
                      </ul>
                    </li>
                  </div>

                <% end %>
                <% if @fund.entity.permissions.enable_units? %>
                  <div class="dropdown-divider"></div>
                  <%= link_to fund_unit_settings_path(fund_id: @fund.id), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "View / edit commercials (management fees, carry, etc) set up for different fund unit types"} do %>
                    <i class="ti ti-settings"></i>Fund Unit Settings
                  <% end %>
                  <%= link_to fund_units_path(fund_id: @fund.id, cols: :all), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "View, download or upload fund units allocated to investors of the fund"} do %>
                    <i class="ti ti-building-community"></i>Fund Units
                  <% end %>
                  <%# Evergreen Settings only for an open-ended fund: a fund's type is chosen on New Fund and
                      can't be changed, so a closed-ended fund has no make-evergreen item (evergreen-fund-on-create X4) %>
                  <% if @fund.evergreen? && policy(@fund).update? %>
                    <%= link_to evergreen_settings_path(@fund), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "Edit this open-ended fund's terms: dealing calendar, gates, classes, notifications"} do %>
                      <i class="ti ti-infinity"></i>Evergreen Settings
                    <% end %>
                  <% end %>
                  <% if current_user.enable_investors %>
                    <%= link_to investors_path(owner_id: @fund.id, owner_type: "Fund"), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "View list of investors of the fund"} do %>
                      <i class="ti ti-users-group"></i>View Stakeholders
                    <% end %>
                  <% end %>
                  <%= link_to excused_investors_path(fund_id: @fund.id), class: "dropdown-item", data: {bs_toggle: "tooltip", bs_title: "View all the excused investors specified for various portfolio investments for this fund"} do %>
                    <i class="ti ti-user-off"></i>Excused Investors
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <% if @fund.entity.support_agents.set?(:fund_stats_agent) %>
            <%
              fund_stats_agent_record = SupportAgent.find_by(entity_id: @fund.entity_id, agent_type: "FundStatsAgent")
              fund_stats_desc = fund_stats_agent_record&.description || "Analyzes fund performance and generates consolidated fund statistics."
            %>
            <%= render "support_agents/agent_run_modal",
                       modal_id:         "run-fund-stats-agent-modal",
                       agent_type:       "FundStatsAgent",
                       target_type:      "Fund",
                       target_id:        @fund.id,
                       description:      fund_stats_desc,
                       long_description: FundStatsAgent::LONG_DESCRIPTION %>
          <% end %>
          <% if @fund.entity.support_agents.set?(:rta_reconciliation_agent) && policy(@fund).update? %>
            <%= render "support_agents/rta_run_modal",
                       modal_id:         "run-rta-reconciliation-modal",
                       fund:             @fund,
                       description:      RtaReconciliationAgent::DESCRIPTION,
                       long_description: RtaReconciliationAgent::LONG_DESCRIPTION %>
          <% end %>
          <% if policy(@fund).delete_all? && params[:delete_all].present? %>
            <div class="btn-group">
              <div class="dropdown">
                <button class="btn btn-outline-danger dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  Delete All
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                  <%
                  delete_classes = ["AccessRight", "AccountEntry", "CapitalCommitment", "CapitalCall", "CapitalRemittance", "CapitalRemittancePayment", "CapitalDistribution", "CapitalDistributionPayment", "FundFormula", "PortfolioInvestment", "FundUnit", "FundUnitSetting", "AggregatePortfolioInvestment", "FundRatio", "RatioFormula"].sort

                  delete_classes.each do |class_name|
                  %>
                  <%= button_to class_name , delete_all_fund_path(@fund, type: class_name, authenticity_token: form_authenticity_token), {class: "dropdown-item", form_class: "deleteButton", data: {action: "click->confirm#popup" , turbo:false, msg: "Caution! Delete all #{class_name} for this fund? This is not reversible."} } %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div id="progress_panel_new" class="container-fluid px-3 pb-3"></div>

<% unless @fund.snapshot %>
  <%= render(@fund.evergreen? ? "evergreen/funds/fund_details" : "/funds/fund_details", fund: @fund) %>
<% end %>
