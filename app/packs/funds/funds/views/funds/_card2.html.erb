<%#
  Fund card variant A — "Compact ledger".
  Two cards per row. Deployment bar instead of a chart; headline IRR in the header;
  ratios as a linked row. Selected on the FM Landing Page Funds widget via
  metadata {card_type: 'card2'}.
%>
<%
  fund ||= @fund
  params[:force_units] = fund.default_currency_units

  called_pct = fund_called_pct(fund)

  # Latest default/latest ratios, keyed by name, in display order
  ratio_names = ["Gross Portfolio IRR", "XIRR", "TVPI", "Portfolio Value to Cost"]
  ratios      = get_latest_fund_ratios(fund, ratio_names)
  hero_ratio  = ratios["Gross Portfolio IRR"] || ratios["XIRR"] || ratios.values.first
  row_ratios  = ratios.values - [hero_ratio]
%>

<div class="col-lg-6 mb-3">
  <div class="fc2-card">

    <%# ── Header ──────────────────────────────────────────────────────── %>
    <div class="fc2-header">
      <div class="fc2-header-left">
        <div class="fc2-name">
          <%= link_to fund.name, fund %>
          <% if fund.category.present? %>
            <span class="fc2-pill"><%= fund.category.sub("Category ", "Cat ") %></span>
          <% end %>
        </div>
        <div class="fc2-meta">
          <% if fund.start_date.present? %><span>Vintage <%= fund.start_date.year %></span><% end %>
          <span><%= fund.currency %></span>
          <span><%= fund.capital_commitments_count %> folios</span>
        </div>
      </div>

      <div class="fc2-header-right">
        <% if hero_ratio %>
          <div class="fc2-hero-ratio">
            <span class="fc2-hero-val fc2-<%= fund_ratio_tone(hero_ratio) %>"><%= hero_ratio.display_value %></span>
            <span class="fc2-hero-lbl"><%= link_to fund_ratio_short_name(hero_ratio), hero_ratio %></span>
          </div>
        <% end %>
        <%= render "funds/card_actions_menu", fund:, style: :dots %>
      </div>
    </div>

    <%# ── Capital row ─────────────────────────────────────────────────── %>
    <div class="fc2-capital-row">
      <div class="fc2-kv">
        <span class="fc2-val"><%= money_to_currency(fund.committed_amount, params) %></span>
        <span class="fc2-lbl">Committed</span>
      </div>
      <div class="fc2-kv-divider"></div>
      <div class="fc2-kv">
        <span class="fc2-val"><%= money_to_currency(fund.call_amount, params) %></span>
        <span class="fc2-lbl">Called</span>
      </div>
      <div class="fc2-kv-divider"></div>
      <div class="fc2-kv">
        <span class="fc2-val"><%= money_to_currency(fund.distribution_amount.abs, params) %></span>
        <span class="fc2-lbl">Distributed</span>
      </div>
    </div>

    <%# ── Deployment bar ──────────────────────────────────────────────── %>
    <div class="fc2-progress-wrap">
      <div class="fc2-progress-track">
        <div class="fc2-progress-fill" style="width: <%= called_pct %>%"></div>
      </div>
      <span class="fc2-progress-label"><%= called_pct %>% called</span>
    </div>

    <%# ── Ratios row ──────────────────────────────────────────────────── %>
    <% if row_ratios.any? %>
      <div class="fc2-sep"></div>
      <div class="fc2-ratio-row">
        <% row_ratios.each_with_index do |ratio, i| %>
          <% unless i.zero? %><div class="fc2-kv-divider"></div><% end %>
          <div class="fc2-kv">
            <span class="fc2-ratio-val fc2-<%= fund_ratio_tone(ratio) %>"><%= ratio.display_value %></span>
            <span class="fc2-lbl"><%= link_to fund_ratio_short_name(ratio), ratio %></span>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</div>
<% params[:force_units] = nil %>
