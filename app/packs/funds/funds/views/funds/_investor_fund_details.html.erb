<%# Each section header: icon + title + one-line muted subtitle saying what it holds (en.yml
    funds.fund_details.subtitles), as the evergreen LP page does. %>
<%# Full width: the LP grids (remittances, distribution payments) have many money columns and
    scrolled sideways. The theme caps .container-fluid at 1200px; mw-100 lifts it, as the layout's
    <main> does %>
<div class="container-fluid mw-100 p-3" data-controller="tabs">

    <div class="accordion ultra-cool-accordion" id="investorFundDetailsAccordion" data-controller="accordion-scroll">

      <!-- Commitments -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="commitments-tab">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommitments" aria-expanded="true" aria-controls="collapseCommitments" aria-label="Expand commitments section">
            <span class="d-flex align-items-center gap-3">
              <i class="ti ti-file-certificate fs-5 text-primary" aria-hidden="true"></i>
              <span>
                <%= t('funds.fund_details.commitments') %>
                <small class="d-block text-muted"><%= t('funds.fund_details.subtitles.commitments') %></small>
              </span>
            </span>
          </button>
        </h2>
        <div id="collapseCommitments" class="accordion-collapse collapse show" aria-labelledby="commitments-tab" data-bs-parent="#investorFundDetailsAccordion">
          <div class="accordion-body">
            <div id="commitments" class="">
                <%= turbo_frame_tag "capital_commitments_frame", target: "_top", loading: :lazy, src: capital_commitments_path(fund_id: fund.id, card: true) do %>
                  <%= render "/layouts/loading" %>
                <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Calls -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="calls-tab">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCalls" aria-expanded="false" aria-controls="collapseCalls" aria-label="Expand calls section">
            <span class="d-flex align-items-center gap-3">
              <i class="ti ti-cash fs-5 text-primary" aria-hidden="true"></i>
              <span>
                <%= t('funds.fund_details.calls') %>
                <small class="d-block text-muted"><%= t('funds.fund_details.subtitles.calls') %></small>
              </span>
            </span>
          </button>
        </h2>
        <div id="collapseCalls" class="accordion-collapse collapse" aria-labelledby="calls-tab" data-bs-parent="#investorFundDetailsAccordion">
          <div class="accordion-body">
            <div id="capital-remittances" class="">
              <%= turbo_frame_tag "capital_remittances_frame", target: "_top", loading: :lazy, src: capital_remittances_path(fund_id: fund.id, card: false, status: "", verified: "") do %>
                <%= render "/layouts/loading" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Distributions -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="distributions-tab">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDistributions" aria-expanded="false" aria-controls="collapseDistributions" aria-label="Expand distributions section">
            <span class="d-flex align-items-center gap-3">
              <i class="ti ti-coins fs-5 text-primary" aria-hidden="true"></i>
              <span>
                <%= t('funds.fund_details.distributions') %>
                <small class="d-block text-muted"><%= t('funds.fund_details.subtitles.distributions') %></small>
              </span>
            </span>
          </button>
        </h2>
        <div id="collapseDistributions" class="accordion-collapse collapse" aria-labelledby="distributions-tab" data-bs-parent="#investorFundDetailsAccordion">
          <div class="accordion-body">
            <div id="capital-distribution-payments" class="">
              <%= turbo_frame_tag "capital_distribution_payments_frame", target: "_top", loading: :lazy, src: capital_distribution_payments_path(fund_id: fund.id, card: false) do %>
                <%= render "/layouts/loading" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Units -->
      <% if fund.features.show_fund_units? %>
        <div class="accordion-item">
          <h2 class="accordion-header" id="units-tab">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUnits" aria-expanded="false" aria-controls="collapseUnits" aria-label="Expand units section">
              <span class="d-flex align-items-center gap-3">
                <i class="ti ti-chart-pie fs-5 text-primary" aria-hidden="true"></i>
                <span>
                  <%= t('funds.fund_details.units') %>
                  <small class="d-block text-muted"><%= t('funds.fund_details.subtitles.units') %></small>
                </span>
              </span>
            </button>
          </h2>
          <div id="collapseUnits" class="accordion-collapse collapse" aria-labelledby="units-tab" data-bs-parent="#investorFundDetailsAccordion">
            <div class="accordion-body">
              <div id="fund_units" class="">
                <%= turbo_frame_tag "fund_units_frame", src: fund_units_path(fund_id: fund.id), loading: :lazy, target: "_top" do %>
                   <%= render "/layouts/loading" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Ratios -->
      <% if fund.features.show_fund_ratios? %>
        <div class="accordion-item">
          <h2 class="accordion-header" id="ratios-tab">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRatios" aria-expanded="false" aria-controls="collapseRatios" aria-label="Expand ratios section">
              <span class="d-flex align-items-center gap-3">
                <i class="ti ti-chart-line fs-5 text-primary" aria-hidden="true"></i>
                <span>
                  <%= t('funds.fund_details.ratios') %>
                  <small class="d-block text-muted"><%= t('funds.fund_details.subtitles.ratios') %></small>
                </span>
              </span>
            </button>
          </h2>
          <div id="collapseRatios" class="accordion-collapse collapse" aria-labelledby="ratios-tab" data-bs-parent="#investorFundDetailsAccordion">
            <div class="accordion-body">
              <%
                # For the portfolio and fund ratios, use the master_fund if its present as in the feeder fund we want to see the master_fund portfolio and ratios
                fund_id = fund.master_fund.present? ?  fund.master_fund_id : fund.id
              %>
              <div id="fund-ratios" class="">
                <%= turbo_frame_tag "fund_ratios_frame", target: "_top", loading: :lazy, src: fund_ratios_path(fund_id: fund_id, fund_ratios_only: true, owner_type: "Fund", scenario: "Default") do %>
                    <%= render "/layouts/loading" %>
                  <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Portfolio -->
      <% if fund.features.show_portfolios? %>
        <div class="accordion-item">
          <h2 class="accordion-header" id="portfolio-tab">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePortfolio" aria-expanded="false" aria-controls="collapsePortfolio" aria-label="Expand portfolio section">
              <span class="d-flex align-items-center gap-3">
                <i class="ti ti-briefcase fs-5 text-primary" aria-hidden="true"></i>
                <span>
                  <%= t('funds.fund_details.portfolio') %>
                  <small class="d-block text-muted"><%= t('funds.fund_details.subtitles.portfolio') %></small>
                </span>
              </span>
            </button>
          </h2>
          <div id="collapsePortfolio" class="accordion-collapse collapse" aria-labelledby="portfolio-tab" data-bs-parent="#investorFundDetailsAccordion">
            <div class="accordion-body">
              <div id="portfolio_investments" class="">
                <%= turbo_frame_tag "portfolio_dashboard_frame", target: "_top", loading: :lazy, src: dashboard_fund_path(fund, dashboard_name: "Portfolio Dashboard") do %>
                  <%= render "/layouts/loading" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Documents -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="docs-tab">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDocuments" aria-expanded="false" aria-controls="collapseDocuments" aria-label="Expand documents section">
            <span class="d-flex align-items-center gap-3">
              <i class="ti ti-folder fs-5 text-primary" aria-hidden="true"></i>
              <span>
                <%= t('funds.fund_details.documents') %>
                <small class="d-block text-muted"><%= t('funds.fund_details.subtitles.documents') %></small>
              </span>
            </span>
          </button>
        </h2>
        <div id="collapseDocuments" class="accordion-collapse collapse" aria-labelledby="docs-tab" data-bs-parent="#investorFundDetailsAccordion">
          <div class="accordion-body">
            <div id="docs" class="">
                <%= turbo_frame_tag "documents_tree_frame", src: folder_documents_path(entity_id: fund.entity_id, folder_id: fund.document_folder.id, show_root_docs: true, show_action_buttons: false, latest_first: true, doc_search: true), loading: :lazy, target: "_top" do %>
                  <div class="text-center">
                      <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                      </div>
                  </div>
                <% end %>
            </div>
          </div>
        </div>
      </div>

    </div>

</div>