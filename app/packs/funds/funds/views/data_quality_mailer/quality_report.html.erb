<%
  stale_val_days = @support_agent.json_fields["stale_valuation_days"]&.to_i || 90
  stale_fx_days  = @support_agent.json_fields["stale_fx_days"]&.to_i || 30
  sub            = @fund.entity.sub_domain

  active_checks  = @check_results.reject { |r| r[:status] == :skipped }
  passing_checks = active_checks.count { |r| r[:status] == :pass }
  score_tone     = @health_score == 100 ? :success : @health_score >= 50 ? :warning : :danger

  check_help = {
    "Commitment Overflows" => "LP collected amount exceeds their total commitment.",
    "Missing Valuations"   => "Portfolio companies with no valuation in the last #{stale_val_days} days.",
    "Stale FX Rates"       => "Exchange rates not refreshed in the last #{stale_fx_days} days."
  }

  failed_sections = [
    {
      name: "Commitment Overflows",
      key:  :commitment_issues,
      url:  capital_commitments_url(subdomain: sub),
      help: "Each of these LPs has had more capital collected than their committed amount. This is usually caused by a data entry error in a capital call or an incorrect commitment figure. Review the commitment record and adjust the called amount or the commitment ceiling."
    },
    {
      name: "Missing Valuations",
      key:  :valuation_issues,
      url:  valuations_url(subdomain: sub),
      help: "These portfolio companies have no valuation recorded within the last #{stale_val_days} days. Stale valuations affect NAV calculations, investor statements, and IRR reporting. Add a current valuation for each company below."
    },
    {
      name: "Stale FX Rates",
      key:  :fx_issues,
      url:  exchange_rates_url(subdomain: sub),
      help: "These currency pairs have not been updated in #{stale_fx_days}+ days. Outdated rates cause inaccuracies in multi-currency capital calls, distributions, and investor reports. Refresh the rates in CapHive."
    }
  ].select { |s| @issues[s[:key]].any? }
%>

<%= sa_intro("This is an automated data quality report from the nightly integrity check for <strong>#{h @fund.name}</strong>. Review and resolve any issues below to keep your fund data accurate and your investors informed.".html_safe) %>

<%= sa_banner(
  title:    "Health Score",
  label:    "#{@health_score}%",
  subtitle: "#{passing_checks} of #{active_checks.size} checks passing#{@health_score < 100 ? " &mdash; <strong>#{active_checks.size - passing_checks} require attention</strong>" : ''}",
  tone:     score_tone
) %>

<%= sa_section(title: "Check Summary", top_margin: false) %>

<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:32px">
  <%= sa_th("Check", "Status", ["Issues", {align: :right}], "What this checks") %>
  <tbody>
    <% @check_results.each do |result| %>
      <% tone = sa_tone_for(result[:status].to_s) %>
      <tr>
        <%= sa_td(result[:name].to_s, bold: true) %>
        <td style="padding:9px 12px;border:1px solid #e0e0e0">
          <%= sa_badge(label: result[:status].to_s.upcase, tone: tone) %>
        </td>
        <%= sa_td(result[:count]&.to_s || "&mdash;".html_safe, align: :right, bold: result[:status] == :fail, color: result[:status] == :fail ? SupportAgentEmailHelper::SA_COLORS[:danger][:text] : nil) %>
        <%= sa_td(check_help[result[:name]].to_s, color: "#666") %>
      </tr>
    <% end %>
  </tbody>
</table>

<% if failed_sections.any? %>

  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
    <tr>
      <td style="padding-bottom:4px;border-bottom:2px solid #{SupportAgentEmailHelper::SA_COLORS[:danger][:text]}">
        <span style="font-size:17px;font-weight:700;color:#{SupportAgentEmailHelper::SA_COLORS[:danger][:text]}">Fix-it List</span>
        <span style="font-size:12px;color:#666;margin-left:8px">Resolve these issues to improve your health score</span>
      </td>
    </tr>
  </table>

  <% failed_sections.each do |section| %>
    <%= sa_section(title: section[:name], link_text: "Fix in CapHive", link_url: section[:url]) %>

    <%= sa_callout(tone: :muted, body: section[:help].html_safe) %>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:8px">
      <%= sa_th("Name", "Issue") %>
      <tbody>
        <% @issues[section[:key]].each do |item| %>
          <tr>
            <%= sa_td(item["name"].to_s, bold: true) %>
            <%= sa_td(item["reason"].to_s, color: SupportAgentEmailHelper::SA_COLORS[:danger][:text]) %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <%= sa_cta(label: "Open CapHive to Fix Issues", url: capital_commitments_url(subdomain: sub)) %>

<% else %>

  <%= sa_callout(
    tone: :success,
    body: "<strong>All checks passed.</strong> No issues found for #{h @fund.name}. Great work keeping your data clean.".html_safe
  ) %>

<% end %>

<%= sa_footer("This report runs nightly for #{h @fund.name}. Valuation threshold: #{stale_val_days} days · FX rate threshold: #{stale_fx_days} days. To change these thresholds or disable individual checks, update the Data Quality Agent configuration in CapHive.") %>
