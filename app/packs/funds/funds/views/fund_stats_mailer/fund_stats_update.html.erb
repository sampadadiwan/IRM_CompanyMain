<%
  show_totals = @support_agent.json_fields["show_totals"] == "Yes"
  period = @ctx[:period]
  sub = @entity.sub_domain
%>

<%= sa_intro("Here are the latest fund statistics for <strong>#{h @entity.name}</strong> covering the period ending <strong>#{@ctx[:effective_date]}</strong>.".html_safe) %>

<%= sa_banner(
  title:    "Stakeholder Summary — #{period} Activity",
  label:    "#{@ctx[:stakeholder_summary][:period_stakeholders]} new stakeholder(s)",
  subtitle: "#{@ctx[:stakeholder_summary][:period_lps]} LP(s) &middot; #{@ctx[:stakeholder_summary][:period_portfolio_companies]} Portfolio Compan#{@ctx[:stakeholder_summary][:period_portfolio_companies] == 1 ? 'y' : 'ies'}".html_safe,
  tone:     :info
) %>

<% if show_totals %>
  <%= sa_kv_table(rows: [
    ["Total Stakeholders", @ctx[:stakeholder_summary][:total_stakeholders]],
    ["Total LPs", @ctx[:stakeholder_summary][:total_lps]],
    ["Total Portfolio Companies", @ctx[:stakeholder_summary][:total_portfolio_companies]]
  ]) %>
<% end %>

<%= sa_section(title: "KYC Summary", link_text: "View KYC Dashboard", link_url: investors_url(subdomain: sub, q: "kyc")) %>
<%
  kyc_rows = [["KYC Records (#{period})", @ctx[:kyc_summary][:period_count]]]
  kyc_rows << ["Total KYC Records", @ctx[:kyc_summary][:overall_count], { bold: true }] if show_totals
%>
<%= sa_kv_table(rows: kyc_rows) %>

<%= sa_section(title: "Generated Document Summary", link_text: "View Documents", link_url: documents_url(subdomain: sub)) %>
<%
  doc_rows = [["Documents Generated (#{period})", @ctx[:generated_document_summary][:period_count]]]
  doc_rows << ["Total Documents", @ctx[:generated_document_summary][:overall_count], { bold: true }] if show_totals
%>
<%= sa_kv_table(rows: doc_rows) %>

<% @ctx[:funds].each do |fund| %>
  <%= sa_section(
    title: "Fund: #{fund.name}",
    link_text: "View Fund",
    link_url: fund_url(fund, subdomain: sub)
  ) %>

  <%= sa_section(title: "Commitments", link_text: "View Commitments", link_url: capital_commitments_url(subdomain: sub, fund_id: fund.id)) %>
  <%
    comm_rows = [
      ["New Commitments (#{period})", @ctx[fund.id][:commitment_summary][:period_count]],
      ["Commitment Amount (#{period})", money_to_currency(@ctx[fund.id][:commitment_summary][:period_total_amount])]
    ]
    if show_totals
      comm_rows << ["Total Commitments", @ctx[fund.id][:commitment_summary][:overall_count], { bold: true }]
      comm_rows << ["Total Commitment Amount", money_to_currency(@ctx[fund.id][:commitment_summary][:overall_total_amount]), { bold: true }]
    end
  %>
  <%= sa_kv_table(rows: comm_rows) %>

  <%= sa_section(title: "Capital Calls", link_text: "View Calls", link_url: capital_calls_url(subdomain: sub, fund_id: fund.id)) %>
  <%
    call_rows = [
      ["New Calls (#{period})", @ctx[fund.id][:call_summary][:period_count]],
      ["Collected Amount (#{period})", money_to_currency(@ctx[fund.id][:call_summary][:period_collected_amount])]
    ]
    if show_totals
      call_rows << ["Total Calls", @ctx[fund.id][:call_summary][:overall_count], { bold: true }]
      call_rows << ["Total Collected Amount", money_to_currency(@ctx[fund.id][:call_summary][:overall_collected_amount]), { bold: true }]
    end
  %>
  <%= sa_kv_table(rows: call_rows) %>

  <%= sa_section(title: "Portfolio Investments", link_text: "View Investments", link_url: portfolio_investments_url(subdomain: sub, fund_id: fund.id)) %>
  <%
    inv_rows = [
      ["New Investments (#{period})", @ctx[fund.id][:investment_summary][:period_count]],
      ["Investment Amount (#{period})", money_to_currency(@ctx[fund.id][:investment_summary][:period_total_amount])],
      ["FMV Amount (#{period})", money_to_currency(@ctx[fund.id][:investment_summary][:period_fmv_amount])]
    ]
    if show_totals
      inv_rows << ["Total Investments", @ctx[fund.id][:investment_summary][:overall_count], { bold: true }]
      inv_rows << ["Total Investment Amount", money_to_currency(@ctx[fund.id][:investment_summary][:overall_total_amount]), { bold: true }]
      inv_rows << ["Total FMV Amount", money_to_currency(@ctx[fund.id][:investment_summary][:overall_fmv_amount]), { bold: true }]
    end
  %>
  <%= sa_kv_table(rows: inv_rows) %>
<% end %>

<%= sa_footer("This is an automated report from the Fund Stats Agent. Configure recipients and reporting period in the agent settings.") %>
