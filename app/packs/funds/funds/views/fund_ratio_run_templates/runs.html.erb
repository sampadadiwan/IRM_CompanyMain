<%= render NewCard.new(col_md: "col-md-12") do %>
  <%= render FormCard.new(title: "Runs for &ldquo;#{@template.name}&rdquo;".html_safe) do %>

    <p class="text-muted mb-3">
      Each row is a <strong>FundRatioRun</strong> produced when this template was triggered.
      All rows share the same filter fingerprint — only the end date differs.
    </p>

    <div class="table-responsive" data-controller="datatable">
      <table class="table table-bordered dataTable jqDataTable">
        <thead>
          <tr>
            <th class="date-col">End Date</th>
            <th class="text-col">Scope</th>
            <th class="text-col">Currency</th>
            <th class="date-col">Run at</th>
            <th class="action-col"></th>
          </tr>
        </thead>
        <tbody>
          <% @runs.each do |run| %>
            <tr>
              <td><%= l run.end_date %></td>
              <td class="text-muted small"><%= run %></td>
              <td><%= run.currency.presence || content_tag(:span, "Entity default", class: "fst-italic text-muted") %></td>
              <td><%= l run.created_at, format: :short %></td>
              <td>
                <%= link_to "View Inputs", fund_ratio_run_path(run),
                            class: "btn btn-sm btn-outline-secondary" %>
                <%= link_to "View Ratios",
                            fund_ratios_path(
                              filter: true,
                              q: ransack_query_params_multiple([
                                [:computation_context_id,   :eq, run.id],
                                [:computation_context_type, :eq, "FundRatioRun"],
                                [:end_date,                 :eq, run.end_date]
                              ])
                            ),
                            class: "btn btn-sm btn-outline-primary ms-1" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-3">
      <%= link_to "Back to Templates", fund_ratio_run_templates_path, class: "btn btn-outline-secondary btn-sm" %>
    </div>

  <% end %>
<% end %>
