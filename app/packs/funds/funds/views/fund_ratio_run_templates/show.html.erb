<%
  # Resolve stored IDs to names for display — not associations so we look them up here.
  source_funds     = Fund.where(id: @template.fund_ids).index_by(&:id)
  source_companies = Investor.where(id: @template.portfolio_company_ids).index_by(&:id)
  pc_tags          = @template.portfolio_companies_tags.to_s.split(",").map(&:strip).reject(&:blank?)
%>

<%= render NewCard.new(col_md: "col-md-12") do %>
  <%= render FormCard.new(title: "Template: #{@template.name}") do %>

    <div class="d-flex gap-2 mb-4">
      <% if policy(@template).update? %>
        <%= link_to "Edit", edit_fund_ratio_run_template_path(@template), class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
      <%= link_to "View Runs", runs_fund_ratio_run_template_path(@template), class: "btn btn-outline-primary btn-sm" %>
      <%= link_to "Back to Templates", fund_ratio_run_templates_path, class: "btn btn-outline-secondary btn-sm" %>
    </div>

    <table class="table table-bordered table-sm align-middle">

      <tr>
        <th class="w-25">Name</th>
        <td><%= @template.name %></td>
      </tr>

      <tr>
        <th>Run Type</th>
        <td><span class="badge bg-primary-subtle text-primary"><%= @template.run_type.humanize %></span></td>
      </tr>

      <tr>
        <th>Tags</th>
        <td>
          <% if @template.tags.any? %>
            <% @template.tags.each do |tag| %>
              <span class="badge bg-secondary me-1"><%= tag %></span>
            <% end %>
          <% else %>
            <span class="text-muted fst-italic">None</span>
          <% end %>
        </td>
      </tr>

      <tr>
        <th>Display Order</th>
        <td><%= @template.position || "—" %></td>
      </tr>

      <tr>
        <th>Anchor Fund</th>
        <td><%= @template.anchor_fund&.name || content_tag(:span, "None", class: "text-muted fst-italic") %></td>
      </tr>

      <%# ── Source Funds ──────────────────────────────────────────────────── %>
      <tr>
        <th>Source Funds</th>
        <td>
          <% if @template.fund_ids.any? %>
            <ul class="list-unstyled mb-0">
              <% @template.fund_ids.each do |fid| %>
                <li><%= source_funds[fid]&.name || "Fund ##{fid}" %></li>
              <% end %>
            </ul>
          <% else %>
            <span class="text-muted fst-italic">All entity funds</span>
          <% end %>
        </td>
      </tr>

      <%# ── Portfolio Companies ───────────────────────────────────────────── %>
      <tr>
        <th>Portfolio Companies</th>
        <td>
          <% if @template.portfolio_company_ids.any? %>
            <ul class="list-unstyled mb-0">
              <% @template.portfolio_company_ids.each do |pcid| %>
                <li><%= source_companies[pcid]&.investor_name || "Company ##{pcid}" %></li>
              <% end %>
            </ul>
          <% else %>
            <span class="text-muted fst-italic">None specified</span>
          <% end %>
        </td>
      </tr>

      <%# ── Portfolio Company Tags ────────────────────────────────────────── %>
      <tr>
        <th>Portfolio Company Tags</th>
        <td>
          <% if pc_tags.any? %>
            <% pc_tags.each do |tag| %>
              <span class="badge bg-secondary me-1"><%= tag %></span>
            <% end %>
          <% else %>
            <span class="text-muted fst-italic">None</span>
          <% end %>
        </td>
      </tr>

      <%# ── Sectors ───────────────────────────────────────────────────────── %>
      <tr>
        <th>Sectors</th>
        <td>
          <% if @template.sectors.any? %>
            <% @template.sectors.each do |s| %>
              <span class="badge bg-info-subtle text-info me-1"><%= s %></span>
            <% end %>
          <% else %>
            <span class="text-muted fst-italic">None</span>
          <% end %>
        </td>
      </tr>

      <tr>
        <th>Created by</th>
        <td><%= @template.user&.full_name %></td>
      </tr>

      <tr>
        <th>Created at</th>
        <td><%= l @template.created_at, format: :long %></td>
      </tr>

      <tr>
        <th>Last updated</th>
        <td><%= l @template.updated_at, format: :long %></td>
      </tr>

      <tr>
        <th>Runs</th>
        <td>
          <%= link_to "View #{@template.fund_ratio_runs.count} #{"run".pluralize(@template.fund_ratio_runs.count)} →",
                      runs_fund_ratio_run_template_path(@template),
                      class: "btn btn-sm btn-outline-primary" %>
        </td>
      </tr>

    </table>

  <% end %>
<% end %>
