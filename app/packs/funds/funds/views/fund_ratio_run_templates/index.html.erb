<%= render NewCard.new(col_md: "col-md-12") do %>
  <%# ── Toolbar ──────────────────────────────────────────────────────────── %>
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      Ratio Run Templates
    </h1>
    <div class="d-flex align-items-center gap-2">
      <%= user_guide_info_icon %>
      <%= user_guide_icon_for('fund_ratios', tooltip: 'Fund Ratios User Guide') %>
      <button class="btn btn-outline-success"
              type="button"
              data-bs-toggle="modal"
              data-bs-target="#runAllModal"
              title="Run every template for a chosen end date. Safe to re-run — identical inputs return the existing result without creating duplicates.">
        <i class="ti ti-player-play"></i> Run All
      </button>
      <% if @distinct_tags.any? %>
        <button class="btn btn-outline-primary"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#runByTagModal"
                title="Run only templates sharing a specific tag. Useful for triggering a named subset on demand.">
          <i class="ti ti-tag"></i> Run by Tag
        </button>
      <% end %>
      <%= link_to "View Runs", fund_ratio_runs_path, class: "btn btn-outline-info" %>
      <%= link_to "New Template", new_fund_ratio_run_template_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <%# ── Run All modal ─────────────────────────────────────────────────────── %>
  <div class="modal fade" id="runAllModal" tabindex="-1" aria-labelledby="runAllModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="runAllModalLabel">
            <i class="ti ti-player-play me-2"></i>Run All Templates
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div data-controller="rule-validation"
             data-rule-validation-target-model-value="FundRatioRunTemplate"
             data-rule-validation-record-id-value=""
             data-rule-validation-evaluate-url-value="<%= evaluate_validation_rules_path %>">
          <%= form_with url: trigger_all_fund_ratio_run_templates_path, method: :post do |f| %>
            <div class="modal-body">
              <div class="border-start border-4 border-success ps-3 py-1 mb-3">
                <div class="fw-bold text-dark small">What will happen</div>
                <div class="text-muted small">The following will occur for <strong>every template</strong> when you click <strong>Run All</strong>:</div>
              </div>
              <div class="d-flex flex-column gap-2 mb-3">
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#f0fdf4;">
                  <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:36px;height:36px;background:#dcfce7;">
                    <i class="ti ti-cpu fs-5" style="color:#16a34a;"></i>
                  </span>
                  <div>
                    <div class="fw-semibold text-dark lh-sm">Computation job queued per template</div>
                    <div class="text-muted small mt-1">Fund ratios are calculated as of the end date you select, using each template's configured scope (funds, companies, filters).</div>
                  </div>
                </div>
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#eff6ff;">
                  <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:36px;height:36px;background:#dbeafe;">
                    <i class="ti ti-fingerprint fs-5" style="color:#2563eb;"></i>
                  </span>
                  <div>
                    <div class="fw-semibold text-dark lh-sm">Safe to re-run — no duplicates created</div>
                    <div class="text-muted small mt-1">Each run is fingerprinted by its inputs. Re-running with the same end date and filters returns the existing run without creating a duplicate.</div>
                  </div>
                </div>
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fdf4ff;">
                  <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:36px;height:36px;background:#f3e8ff;">
                    <i class="ti ti-history fs-5" style="color:#9333ea;"></i>
                  </span>
                  <div>
                    <div class="fw-semibold text-dark lh-sm">Results available in View Runs</div>
                    <div class="text-muted small mt-1">Once complete, open <strong>View Runs</strong> to inspect generated ratios per run.</div>
                  </div>
                </div>
              </div>
              <hr class="my-3">
              <div class="mb-1">
                <%= f.label :end_date, "End Date", class: "form-label fw-semibold" %>
                <small class="text-muted d-block mb-2">Ratios will be computed as of this date for all templates.</small>
                <%= f.date_field :end_date, class: "form-control", required: true %>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
              <%= f.submit "Run All", class: "btn btn-outline-success" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# ── Run by Tag modal ──────────────────────────────────────────────────── %>
  <% if @distinct_tags.any? %>
  <div class="modal fade" id="runByTagModal" tabindex="-1" aria-labelledby="runByTagModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="runByTagModalLabel">
            <i class="ti ti-tag me-2"></i>Run by Tag
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div data-controller="rule-validation"
             data-rule-validation-target-model-value="FundRatioRunTemplate"
             data-rule-validation-record-id-value=""
             data-rule-validation-evaluate-url-value="<%= evaluate_validation_rules_path %>">
          <%= form_with url: trigger_by_tag_fund_ratio_run_templates_path, method: :post do |f| %>
            <div class="modal-body">
              <div class="border-start border-4 border-primary ps-3 py-1 mb-3">
                <div class="fw-bold text-dark small">What will happen</div>
                <div class="text-muted small">Only templates sharing the selected tag will be triggered — all others are unaffected:</div>
              </div>
              <div class="d-flex flex-column gap-2 mb-3">
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#f0fdf4;">
                  <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:36px;height:36px;background:#dcfce7;">
                    <i class="ti ti-cpu fs-5" style="color:#16a34a;"></i>
                  </span>
                  <div>
                    <div class="fw-semibold text-dark lh-sm">Computation jobs queued for matching templates only</div>
                    <div class="text-muted small mt-1">Only templates tagged with your selection will run — a precise way to trigger a named group without running everything.</div>
                  </div>
                </div>
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#eff6ff;">
                  <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:36px;height:36px;background:#dbeafe;">
                    <i class="ti ti-fingerprint fs-5" style="color:#2563eb;"></i>
                  </span>
                  <div>
                    <div class="fw-semibold text-dark lh-sm">Safe to re-run — no duplicates created</div>
                    <div class="text-muted small mt-1">Re-running the same tag and end date combination always returns the existing result. No duplicate runs are created.</div>
                  </div>
                </div>
              </div>
              <hr class="my-3">
              <div class="mb-3">
                <%= f.label :tag, "Tag", class: "form-label fw-semibold" %>
                <small class="text-muted d-block mb-2">All templates with this tag will be triggered.</small>
                <%= f.select :tag, @distinct_tags, { include_blank: "— select a tag —" },
                             class: "form-select", required: true %>
              </div>
              <div class="mb-1">
                <%= f.label :end_date, "End Date", class: "form-label fw-semibold" %>
                <small class="text-muted d-block mb-2">Ratios will be computed as of this date.</small>
                <%= f.date_field :end_date, class: "form-control", required: true %>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
              <%= f.submit "Run Tag", class: "btn btn-outline-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <% end %>

  <%# ── Templates table ───────────────────────────────────────────────────── %>
  <div class="table-responsive" style="overflow: visible" data-controller="datatable">
    <table class="table table-bordered dataTable jqDataTable">
      <thead>
        <tr>
          <th class="text-col">Name</th>
          <th class="text-col">Tags</th>
          <th class="text-col">Type</th>
          <th class="text-col">Anchor Fund</th>
          <th class="action-col"></th>
        </tr>
      </thead>
      <tbody>
        <% @templates.each do |tmpl| %>
          <tr>
            <td><%= tmpl.name %></td>
            <td>
              <% if tmpl.tags.any? %>
                <% tmpl.tags.each do |t| %>
                  <%= content_tag :span, t, class: "badge bg-secondary me-1" %>
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td><%= tmpl.run_type.humanize %></td>
            <td><%= tmpl.anchor_fund&.name || "—" %></td>
            <td class="text-end">
              <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle d-inline-flex align-items-center gap-1"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                  <i class="ti ti-settings"></i> Actions
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <button class="dropdown-item d-flex align-items-center gap-2"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#runModal-<%= tmpl.id %>">
                      <i class="ti ti-player-play"></i> Run
                    </button>
                  </li>
                  <li>
                    <%= link_to edit_fund_ratio_run_template_path(tmpl), class: "dropdown-item d-flex align-items-center gap-2" do %>
                      <i class="ti ti-pencil"></i> Edit
                    <% end %>
                  </li>
                  <li>
                    <%= button_to fund_ratio_run_template_path(tmpl), method: :delete,
                                  class: "dropdown-item d-flex align-items-center gap-2 text-danger",
                                  form_class: "deleteButton",
                                  data: { action: "click->confirm#popup", turbo: false } do %>
                      <i class="ti ti-trash"></i> Delete
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to runs_fund_ratio_run_template_path(tmpl), class: "dropdown-item d-flex align-items-center gap-2" do %>
                      <i class="ti ti-history"></i> View Runs
                    <% end %>
                  </li>
                </ul>
              </div>
            </td>
          </tr>

          <%# ── Per-template Run confirmation modal ─────────────────────── %>
          <div class="modal fade" id="runModal-<%= tmpl.id %>" tabindex="-1" aria-labelledby="runModalLabel-<%= tmpl.id %>" aria-hidden="true">
            <div class="modal-dialog" role="document">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="runModalLabel-<%= tmpl.id %>">
                    <i class="ti ti-player-play me-2"></i>Run: <strong><%= tmpl.name %></strong>
                  </h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div data-controller="rule-validation"
                     data-rule-validation-target-model-value="FundRatioRunTemplate"
                     data-rule-validation-record-id-value="<%= tmpl.id %>"
                     data-rule-validation-evaluate-url-value="<%= evaluate_validation_rules_path %>">
                  <%= form_with url: trigger_one_fund_ratio_run_template_path(tmpl), method: :post do |f| %>
                    <div class="modal-body">
                      <div class="border-start border-4 border-secondary ps-3 py-1 mb-3">
                        <div class="fw-bold text-dark small">What will happen</div>
                        <div class="text-muted small">The following will occur when you click <strong>Run</strong>:</div>
                      </div>
                      <div class="d-flex flex-column gap-2 mb-3">
                        <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#f0fdf4;">
                          <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:36px;height:36px;background:#dcfce7;">
                            <i class="ti ti-cpu fs-5" style="color:#16a34a;"></i>
                          </span>
                          <div>
                            <div class="fw-semibold text-dark lh-sm">Computation job queued</div>
                            <div class="text-muted small mt-1">
                              Fund ratios computed as of your chosen end date for
                              <% if Array(tmpl.fund_ids).any? %>
                                <%= pluralize(tmpl.fund_ids.count, 'source fund') %>.
                              <% else %>
                                all portfolio companies matching this template's filters.
                              <% end %>
                            </div>
                          </div>
                        </div>
                        <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#eff6ff;">
                          <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:36px;height:36px;background:#dbeafe;">
                            <i class="ti ti-fingerprint fs-5" style="color:#2563eb;"></i>
                          </span>
                          <div>
                            <div class="fw-semibold text-dark lh-sm">Safe to re-run — no duplicates created</div>
                            <div class="text-muted small mt-1">Re-running with the same end date returns the existing run. No duplicate runs are ever created.</div>
                          </div>
                        </div>
                        <% if Array(tmpl.tags).any? || Array(tmpl.sectors).any? %>
                          <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fffbeb;">
                            <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                  style="width:36px;height:36px;background:#fef3c7;">
                              <i class="ti ti-filter fs-5" style="color:#d97706;"></i>
                            </span>
                            <div>
                              <div class="fw-semibold text-dark lh-sm">Active company filters</div>
                              <div class="text-muted small mt-1">
                                <% if Array(tmpl.tags).any? && Array(tmpl.sectors).any? %>
                                  Companies matching <strong>both</strong> a portfolio tag <strong>and</strong> a sector (intersection — AND logic).
                                <% elsif Array(tmpl.tags).any? %>
                                  Companies with any of the configured portfolio tags.
                                <% else %>
                                  Companies in any of the configured sectors.
                                <% end %>
                              </div>
                            </div>
                          </div>
                        <% end %>
                        <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fdf4ff;">
                          <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:36px;height:36px;background:#f3e8ff;">
                            <i class="ti ti-history fs-5" style="color:#9333ea;"></i>
                          </span>
                          <div>
                            <div class="fw-semibold text-dark lh-sm">Results available in View Runs</div>
                            <div class="text-muted small mt-1">Open <strong>View Runs</strong> from the Actions menu after completion to inspect generated ratios.</div>
                          </div>
                        </div>
                      </div>
                      <hr class="my-3">
                      <div class="mb-1">
                        <%= f.label :end_date, "End Date", class: "form-label fw-semibold" %>
                        <small class="text-muted d-block mb-2">Ratios will be computed as of this date.</small>
                        <%= f.date_field :end_date, class: "form-control", required: true %>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
                      <%= f.submit "Run", class: "btn btn-outline-success" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </tbody>
    </table>
  </div>

<% end %>
