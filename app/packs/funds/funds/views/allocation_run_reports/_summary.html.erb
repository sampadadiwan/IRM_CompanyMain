<%#
  Report summary — rendered inside the allocation_run_report Turbo Frame (which wraps the whole
  tab block) and reloaded every few seconds by the auto-refresh controller while the checks are
  still running. The controller sits on this inner div so each reload re-reads the fresh
  "pending" value and the polling stops by itself once the report is finished.
  Locals: report, allocation_run
%>
<div data-controller="auto-refresh"
     data-auto-refresh-url-value="<%= allocation_run_report_path(report) %>"
     data-auto-refresh-active-value="<%= report.pending? %>"
     data-auto-refresh-interval-value="4000">

  <% if report.pending? %>
    <div class="alert alert-info d-flex align-items-center gap-2">
      <i class="ti ti-loader"></i>
      <div>Checking this allocation run. This page refreshes itself every few seconds.</div>
    </div>
  <% elsif report.errored? %>
    <div class="alert alert-danger d-flex align-items-center gap-2">
      <i class="ti ti-alert-triangle"></i>
      <div>The checks could not be completed: <%= report.message %></div>
    </div>
  <% else %>
    <%
      # The headline: what the report means, in the theme's own alert colours.
      verdict = if report.nothing_checked?
                  { css: "alert-secondary", icon: "ti ti-circle-minus", label: "Nothing to check",
                    text: "No check had anything to look at — the two tabs say why each one was skipped." }
                elsif report.passed?
                  { css: "alert-success", icon: "ti ti-circle-check", label: "Pass",
                    text: "Every check passed. Nothing here should stop you locking this run." }
                elsif report.warned?
                  { css: "alert-warning", icon: "ti ti-alert-triangle", label: "Warn",
                    text: "Everything adds up, but some checks want a look before you lock this run." }
                else
                  { css: "alert-danger", icon: "ti ti-alert-octagon", label: "Fail",
                    text: "At least one arithmetic check failed. Investigate before locking this run." }
                end
    %>
    <div class="alert <%= verdict[:css] %> d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <i class="<%= verdict[:icon] %>"></i>
        <div><strong><%= verdict[:label] %>.</strong> <%= verdict[:text] %></div>
      </div>
      <div>
        Checked <%= l report.checked_at, format: :abbr_date_time %><%= " in #{report.duration}" if report.duration %>
      </div>
    </div>

    <%# Same stat-card shape as the capital call reconciliation panel: count, icon, and a
        coloured top border + label. These don't navigate — the two tabs hold the detail. %>
    <% stat_cards = [
         { label: "Passed", count: report.count_at("pass"), color: "success", icon: "ti ti-check" },
         { label: "Warnings", count: report.count_at("warn"), color: "warning", icon: "ti ti-alert-triangle" },
         { label: "Failures", count: report.count_at("fail"), color: "danger", icon: "ti ti-x" },
         { label: "Not applicable", count: report.count_at("skipped"), color: "secondary", icon: "ti ti-minus" }
       ] %>
    <div class="row mb-3">
      <% stat_cards.each do |card| %>
        <div class="col">
          <div class="card border-top stat-card-accent border-<%= card[:color] %> shadow-sm">
            <div class="card-body">
              <div class="d-flex align-items-center">
                <div>
                  <div data-controller="counters" data-counters-value-value="<%= card[:count] %>">
                    <h3 class="fs-7" data-counters-target="output">0</h3>
                  </div>
                  <h6 class="card-subtitle mb-1 text-<%= card[:color] %>"><%= card[:label] %></h6>
                </div>
                <div class="ms-auto">
                  <span class="text-<%= card[:color] %> display-6 number-stats-icon"><i class="<%= card[:icon] %>"></i></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <table class="table table-bordered align-middle">
    <tr>
      <th class="w-25">Fund</th>
      <td><%= link_to allocation_run.fund.name, fund_path(allocation_run.fund), data: { turbo_frame: "_top" } %></td>
    </tr>
    <tr>
      <th>Period</th>
      <td><%= l allocation_run.start_date %> to <%= l allocation_run.end_date %></td>
    </tr>
    <tr>
      <th>Run status</th>
      <td><%= allocation_run.status.presence || "—" %></td>
    </tr>
    <tr>
      <th>Locked</th>
      <td><%= display_boolean allocation_run.locked %></td>
    </tr>
    <tr>
      <th>Run on</th>
      <td><%= l allocation_run.created_at, format: :abbr_date_time %> by <%= allocation_run.user.full_name %></td>
    </tr>
    <tr>
      <th>Checked by</th>
      <td><%= report.user.full_name %></td>
    </tr>
    <tr>
      <th>Account entries</th>
      <td>
        <%= link_to run_account_entries_path(allocation_run), class: "btn btn-sm btn-outline-info", data: { turbo_frame: "_top" } do %>
          <i class="ti ti-list-details"></i> Entries this run produced
        <% end %>
      </td>
    </tr>
  </table>

  <p class="text-muted mb-0">
    This report never locks or unlocks anything — locking stays your decision. Section 3 of the
    requirements (do the numbers look reasonable?) is not part of these checks.
  </p>
</div>
