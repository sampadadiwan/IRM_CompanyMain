<div class="p-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ratio Formulas for <%= @fund.name %></h1>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <%= user_guide_info_icon %>
      <%= link_to fund_ratio_formulas_path(@fund, format: :xlsx), class: "btn btn-outline-success" do %>
        <i class="ti ti-download"></i> Download
      <% end %>
      <% if policy(RatioFormula.new(fund: @fund)).import? %>
        <%= link_to new_import_upload_path(
              "import_upload[owner_id]": @fund.id,
              "import_upload[owner_type]": "Fund",
              "import_upload[entity_id]": @fund.entity_id,
              "import_upload[import_type]": "RatioFormula",
              "sample_upload": "RATIO_FORMULA_SAMPLE"),
            class: "btn btn-outline-primary" do %>
          <i class="ti ti-upload"></i> Import
        <% end %>
      <% end %>
      <% if policy(RatioFormula.new(fund: @fund)).create? %>
        <%= link_to new_fund_ratio_formula_path(@fund), class: "btn btn-primary" do %>
          <i class="ti ti-plus"></i> New Ratio Formula
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover table-sm align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="text-nowrap">Level</th>
            <th class="text-nowrap">Ratio</th>
            <th class="text-nowrap">Action</th>
            <th>Account Entry Names</th>
            <th class="text-nowrap">Entry Type</th>
            <th class="text-nowrap">Parent Type</th>
            <th class="text-nowrap">Cumulative</th>
            <th class="text-nowrap">Period</th>
            <th class="text-nowrap">Label</th>
            <th class="text-nowrap">Skip Portfolio FMV</th>
            <th class="text-nowrap">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @ratio_formulas.any? %>
            <% @ratio_formulas.each do |formula| %>
              <tr>
                <td><%= formula.level_text %></td>
                <td>
                  <span class="badge bg-info-subtle text-info"><%= formula.ratio %></span>
                </td>
                <td><%= formula.action_text %></td>
                <td>
                  <% Array(formula.account_entry_names).each do |name| %>
                    <span class="badge bg-secondary-subtle text-secondary"><%= name %></span>
                  <% end %>
                </td>
                <td>
                  <% if formula.entry_type.present? %>
                    <% formula.entry_type.split(",").each do |type| %>
                      <span class="badge bg-secondary-subtle text-secondary"><%= type %></span>
                    <% end %>
                  <% end %>
                </td>
                <td><%= formula.parent_type %></td>
                <td><%= display_boolean formula.cumulative %></td>
                <td><%= formula.period_text %></td>
                <td><%= formula.label %></td>
                <td><%= display_boolean formula.skip_portfolio_fmv %></td>
                <td>
                  <div class="d-flex gap-2">
                    <%= link_to fund_ratio_formula_path(@fund, formula), class: "btn btn-outline-info btn-sm", title: "View" do %>
                      <i class="ti ti-eye"></i>
                    <% end %>
                    <%= link_to edit_fund_ratio_formula_path(@fund, formula), class: "btn btn-outline-primary btn-sm", title: "Edit" do %>
                      <i class="ti ti-edit"></i>
                    <% end %>
                    <%= button_to fund_ratio_formula_path(@fund, formula), method: :delete, class: "btn btn-outline-danger btn-sm", form_class: "d-inline", data: { action: "click->confirm#popup", turbo: false }, title: "Delete" do %>
                      <i class="ti ti-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center py-4">No ratio formulas found for this fund.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
