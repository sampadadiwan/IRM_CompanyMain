<% title = (@ratio_formula.new_record? ? "New Ratio Formula" : "Edit Ratio Formula") %>
<%= render FormCard.new(title: title) do %>

  <%= form_with(model: [@fund, @ratio_formula], local: true) do |f| %>
    <% if @ratio_formula.errors.any? %>
      <div id="error_explanation" class="alert alert-danger">
        <h2><%= pluralize(@ratio_formula.errors.count, "error") %> prohibited this formula from being saved:</h2>
        <ul>
          <% @ratio_formula.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :level %>
      <%= f.select :level, RatioFormula.level.options, {}, class: "form-control" %>
    </div>

    <div class="form-group mt-3">
      <%= f.label :action %>
      <%= f.select :action, RatioFormula.action.options, {}, class: "form-control" %>
    </div>

    <div class="form-group mt-3">
      <%= f.label :ratio %>
      <%= f.select :ratio, ["XIRR", "DPI", "TVPI", "MOIC", "RVPI", "PIC", "Gross Portfolio IRR"], { include_blank: "Select Ratio" }, class: "form-control" %>
    </div>

    <div class='row'>
      <div class="form-group col mt-3">
        <%= f.label :account_entry_names %>
        <%= f.select :account_entry_names, @fund.account_entries.distinct.pluck(:name).sort, { selected: @ratio_formula.account_entry_names }, { multiple: true, class: "form-control select2", data: { placeholder: "Select Account Entry Names" } } %>
      </div>
      <div class="form-group col-auto d-flex align-items-end">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-controller="ratio-formulas" data-action="click->ratio-formulas#toggleAllDetails">
          <i class="ti ti-caret-down"></i>
        </button>
      </div>
    </div>

    <div class="collapse">
      <div class="form-group mt-3">
        <%= f.label :entry_type %>
        <%= f.text_field :entry_type, class: "form-control" %>
          <small class="text-muted">Type of account entry to include in the ratio calculation</small>
      </div>

      <div class="form-group mt-3">
        <%= f.label :parent_type %>
        <%= f.text_field :parent_type, class: "form-control" %>
        <small class="text-muted">Parent Type of account entry</small>
      </div>

      <div class="form-group mt-3">
        <%= f.label :cumulative %>
        <%= f.check_box :cumulative, class: "form-check-input" %>
        <small class="text-muted">Use Cumulative / Non Cumulative Account Entries</small>
      </div>

      <div class="form-group mt-3">
        <%= f.label :skip_portfolio_fmv %>
        <%= f.check_box :skip_portfolio_fmv, class: "form-check-input" %>
      </div>
    </div>

    <div class="form-group mt-3">
      <%= f.label :period %>
      <%= f.select :period, RatioFormula.period.options, {}, class: "form-control" %>
    </div>

    <div class="form-group mt-3">
      <%= f.label :label %>
      <%= f.text_field :label, class: "form-control"%>
      <small class="text-muted">Label for the generated ratio. If multiple ratio formulas have the same label, they will be grouped together.</small>
    </div>

    <div class="form-group mt-3">
      <%= f.submit t_common(:save), class: "btn btn-outline-primary" %>
      <%= link_to t_common(:cancel), fund_ratio_formulas_path(@fund), class: "btn btn-outline-secondary" %>
    </div>
  <% end %>

<% end %>
