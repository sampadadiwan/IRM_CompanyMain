<div class="container-fluid">
<%= render FormCard.new(title: "Ratio Formula Detail") do %>

<table class="table table-bordered dataTable">
  <tr>
    <td>
      Fund
    </td>
    <td>
      <%= @fund.name %>
    </td>
  </tr>
  <tr>
    <td>
      Level
    </td>
    <td>
      <%= @ratio_formula.level_text %>
    </td>
  </tr>
  <tr>
    <td>
      Action
    </td>
    <td>
      <%= @ratio_formula.action_text %>
    </td>
  </tr>
  <tr>
    <td>
      Ratio
    </td>
    <td>
      <span class="badge bg-info-subtle text-info"><%= @ratio_formula.ratio %></span>
    </td>
  </tr>
  <tr>
    <td>
      Account Entry Names
    </td>
    <td>
      <% Array(@ratio_formula.account_entry_names).each do |name| %>
        <span class="badge bg-secondary-subtle text-secondary"><%= name %></span>
      <% end %>
    </td>
  </tr>
  <tr>
    <td>
      Entry Type
    </td>
    <td>
      <%= @ratio_formula.entry_type %>
    </td>
  </tr>
  <tr>
    <td>
      Parent Type
    </td>
    <td>
      <%= @ratio_formula.parent_type %>
    </td>
  </tr>
  <tr>
    <td>
      Cumulative
    </td>
    <td>
      <%= display_boolean(@ratio_formula.cumulative) %>
    </td>
  </tr>
  <tr>
    <td>
      Period
    </td>
    <td>
      <%= @ratio_formula.period_text %>
    </td>
  </tr>
  <tr>
    <td>
      Label
    </td>
    <td>
      <%= @ratio_formula.label %>
    </td>
  </tr>
  <tr>
    <td>
      Skip Portfolio FMV
    </td>
    <td>
      <%= display_boolean(@ratio_formula.skip_portfolio_fmv) %>
    </td>
  </tr>
</table>

<div class="associated_entity">
  <%= link_to t_common(:edit), edit_fund_ratio_formula_path(@fund, @ratio_formula), {class: "btn btn-outline-primary"} if policy(@ratio_formula).update? %>
  <%= button_to t_common(:delete), fund_ratio_formula_path(@fund, @ratio_formula), method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton", data: {action: "click->confirm#popup", turbo:false} if policy(@ratio_formula).destroy? %>
  <%= link_to t_common(:back), fund_ratio_formulas_path(@fund), class: "btn btn-outline-secondary" %>
</div>

<% end %>

</div>
