<%= render FormCard.new(title: "Instrument : #{investment_instrument&.portfolio_company&.investor_name.presence || 'New'}") do %>

<%= form_with(model: investment_instrument, validate: true) do |form| %>
  <% if investment_instrument.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(investment_instrument.errors.count, "error") %> prohibited this investment_instrument from being saved:</h2>

      <ul>
        <% investment_instrument.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.text_field :entity_id, class: "form-control", hidden: true  %>

  <%
    # A portfolio_company_id already passed in (from the portfolio company's own instruments
    # tab, or an existing record being edited) locks the field to that company; only the
    # generic /investment_instruments/new page (no company in context) lets it be picked.
    portfolio_company_locked = investment_instrument.portfolio_company_id.present?
    portfolio_company_options = current_user.entity.investors.portfolio_companies.includes(:investor_entity)
                                            .sort_by { |investor| investor.investor_name }
                                            .map { |investor| [investor.investor_name, investor.id] }

    # Ensure the current portfolio company remains visible even if it is not in the default scoped options.
    if portfolio_company_locked && portfolio_company_options.none? { |(_label, value)| value.to_s == investment_instrument.portfolio_company_id.to_s }
      portfolio_company_options.unshift([investment_instrument.portfolio_company&.investor_name || investment_instrument.portfolio_company_id.to_s, investment_instrument.portfolio_company_id])
    end

    # Opened from a portfolio company's own tab, request.referer (that tab) is still the right
    # place to land back on. Opened from the generic list with no company pre-selected, there's
    # no single company page to return to - go back to the list itself instead.
    # format: :html forces the extension-based route (/investment_instruments.html) so the
    # redirect-following Turbo request can't be format-negotiated into index.turbo_stream.erb -
    # that template does `turbo_stream.update params[:target]`, meant for the AJAX instrument
    # picker on the portfolio investment form, and silently no-ops (updates nothing) without a
    # target param, which looked like "save didn't redirect".
    back_to_url = portfolio_company_locked ? request.referer : investment_instruments_path(format: :html)
  %>
  <%= form.text_field :back_to, class: "form-control", hidden: true, value: back_to_url, name: "back_to" %>

  <div class="form-group">
    <%= form.label :portfolio_company_id, "For" %>
    <%= form.select :portfolio_company_id,
          portfolio_company_options,
          { selected: investment_instrument.portfolio_company_id, include_blank: !portfolio_company_locked },
          class: "form-control",
          disabled: portfolio_company_locked %>
    <%= form.hidden_field :portfolio_company_id if portfolio_company_locked %>
  </div>

  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-control"  %>
  </div>

  <% disabled = investment_instrument.id.present? %>
  <div class="form-group">
    <%= form.label :currency %>
    <%= form.select :currency, investment_instrument.entity.currency_list, {}, class: "form-control", disabled:  %>
  </div>

  <div class="form-group">
    <%= form.label :investment_domicile %>
    <%= form.text_field :investment_domicile, class: "form-control"  %>
  </div>

  <%# Identifiers and pricing method — openspec fund-market-data, card ④ (H6, X11–X13, X35) %>
  <div class="row">
    <div class="col-md-4 form-group">
      <%= form.label :isin, "ISIN" %>
      <%= form.text_field :isin, class: "form-control", maxlength: 12 %>
    </div>
    <div class="col-md-4 form-group">
      <%= form.label :ticker %>
      <%= form.text_field :ticker, class: "form-control", maxlength: 30 %>
    </div>
    <div class="col-md-4 form-group">
      <%= form.label :exchange %>
      <%= form.text_field :exchange, class: "form-control", maxlength: 10, placeholder: "NSE, BSE, NASDAQ…" %>
    </div>
  </div>
  <div class="form-group">
    <%= form.label :pricing_method %>
    <%= form.select :pricing_method, InvestmentInstrument::PRICING_METHODS.map { |m| [m.capitalize, m] }, {}, class: "form-select" %>
    <small class="text-muted">Market: priced daily from the price feed. Manual, Model or Cost: priced from valuations you enter.</small>
  </div>

  <%= custom_form_fields(investment_instrument, form) %>

  <% regulatory_custom_fields = investment_instrument.form_type.present? ? investment_instrument.form_custom_fields.regulatory.includes(:rich_text_info) : [] %>

  <% if regulatory_custom_fields.present? %>
    <% reg_envs = regulatory_custom_fields.pluck(:reg_env).uniq
    reg_envs.each do |reg_env| %>

      <%= custom_form_fields(investment_instrument, form, custom_fields: regulatory_custom_fields.for_env(reg_env)) %>

      <% end %>
  <% end %>

  <div class="form-group">
    <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
  </div>
<% end %>

<% end %>
