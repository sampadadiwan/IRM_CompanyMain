

<%= render "/layouts/filter", associations: [:investment_instrument], include_template: "/portfolio_investments/group_filter" %>

<div class="associated_entity">
    <% if @adhoc_json.present? && false %>
        <div data-controller="datatable">
            <%= safe_json_table(@adhoc_json, JsonTable::TABLE_OPTIONS) %>
        </div>
    <% else %>
        <div data-controller="adhoc-ag">
            <div id="adhoc_grid" class="<%= get_ag_theme %>" data-ag-fixed-layout="true" data-grid-data='<%= @adhoc_json %>'></div>
        </div>
    <% end %>
</div>