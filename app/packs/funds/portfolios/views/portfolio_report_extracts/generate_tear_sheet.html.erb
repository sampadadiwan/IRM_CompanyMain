<% content_for :turbo_streams do %>
  <%= turbo_stream_from([@slides_user, "tear_sheet_slides", params[:id].to_s]) %>
<% end %>

<% if defined?(@slides_html) && @slides_html.present? %>
  <%= @slides_html.html_safe %>
<% else %>
  <section class="slide-premium" style="min-height: 100vh; width: 100%; display: flex; align-items: center; justify-content: center; background-color: var(--palette-bg);">
      <div style="text-align: center; margin: 0 auto;" class="max-w-4xl w-full text-center animate-soft-fade px-12">
        <%# Premium Spinner Container %>
        <div class="relative w-32 h-32 mx-auto mb-16">
          <%# Outer Glow/Pulse %>
          <div class="absolute inset-0 rounded-full bg-[var(--palette-accent)] opacity-10 animate-pulse scale-150"></div>
          <%# Outer Spinning Ring %>
          <div class="absolute inset-0 rounded-full border-t-2 border-l-2 border-[var(--palette-accent)] animate-spin-slow opacity-80"></div>
          <%# Inner Spinning Ring (Opposite) %>
          <div class="absolute inset-4 rounded-full border-r-2 border-b-2 border-[var(--palette-primary)] animate-spin-reverse opacity-60"></div>
          <%# Center Icon/Dot %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-3 h-3 rounded-full bg-[var(--palette-accent)] animate-ping"></div>
          </div>
        </div>

        <%# Content %>
        <h2 style="font-size: 5rem; font-weight: 800; line-height: 1; margin-bottom: 24px; color: var(--palette-primary); letter-spacing: -0.04em;">
          Curating Your Vision
        </h2>

        <p style="font-size: 2.25rem; font-weight: 300; color: var(--palette-text-muted); opacity: 0.8; margin-bottom: 48px; letter-spacing: -0.01em;">
          Designing with the <span style="font-weight: 600; color: var(--palette-accent);"><%= (@palette || 'serene_blue').titleize %></span> palette
        </p>

        <%# Progress Dots %>
        <div class="flex justify-center gap-4" style="display: flex; justify-content: center; align-items: center; gap: 16px;">
          <div class="w-3 h-3 rounded-full bg-[var(--palette-accent)] animate-bounce [animation-delay:-0.3s]"></div>
          <div class="w-3 h-3 rounded-full bg-[var(--palette-accent)] animate-bounce [animation-delay:-0.15s]"></div>
          <div class="w-3 h-3 rounded-full bg-[var(--palette-accent)] animate-bounce"></div>
        </div>
      </div>
  </section>

  <style>
    @keyframes spin-slow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes spin-reverse {
      from { transform: rotate(360deg); }
      to { transform: rotate(0deg); }
    }
    .animate-spin-slow {
      animation: spin-slow 3s linear infinite;
    }
    .animate-spin-reverse {
      animation: spin-reverse 2s linear infinite;
    }
  </style>
<% end %>
