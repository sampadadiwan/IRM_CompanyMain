<% content_for :turbo_streams do %>
  <%= turbo_stream_from([@slides_user, "tear_sheet_slides", params[:id].to_s]) %>
<% end %>

<% if defined?(@slides_html) && @slides_html.present? %>
  <%= @slides_html.html_safe %>
<% else %>
  <section class="slide-premium" style="height: 100%; width: 100%; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div style="width: 100%;" class="animate-soft-fade">
      <h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 20px; color: var(--palette-primary);">Creating Your Tear Sheet…</h2>
      <div style="width: 60px; height: 60px; border: 4px solid var(--palette-secondary); border-top-color: var(--palette-primary); border-radius: 50%; animation: spin 1s cubic-bezier(0.5, 0.1, 0.4, 0.9) infinite; margin: 0 auto 30px;"></div>
      <p style="font-size: 1.5rem; color: var(--palette-text); opacity: 0.6;">Designing with the <strong><%= (@palette || 'serene_blue').titleize %></strong> palette.</p>
    </div>
  </section>

  <style>
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
<% end %>
