
<tr id="<%= dom_id portfolio_report %>">
  <td>
    <%= portfolio_report.entity_id %>
  </td>
  <td>
    <%= portfolio_report.name %>
  </td>
  <td>
    <%= portfolio_report.tags %>
  </td>
  <td>
    <%= display_boolean portfolio_report.include_kpi %>
  </td>
  <td>
    <%= display_boolean portfolio_report.include_portfolio_investments %>
  </td>
  <td>
    <%
      has_templates = portfolio_report.portfolio_report_templates.any?
      setup_done    = has_templates
    %>
    <% if setup_done %>
      <span class="badge bg-success"><i class="ti ti-circle-check me-1"></i>Ready</span>
    <% else %>
      <span class="badge bg-warning text-dark" title="Add a template">
        <i class="ti ti-alert-circle me-1"></i>Incomplete
      </span>
    <% end %>
  </td>
  <td>
    <%= link_to t_common(:show), portfolio_report, class: "btn btn-outline-primary me-1" %>
    <%= button_to "Clone", clone_portfolio_report_path(portfolio_report),
                  method: :post, class: "btn btn-outline-secondary",
                  data: { turbo: false } %>
  </td>
</tr>
