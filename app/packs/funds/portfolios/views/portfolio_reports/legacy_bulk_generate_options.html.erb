<%
  # Each template carries its owning report id (data-report-id) so the report-template-filter
  # Stimulus controller can show only the templates belonging to the currently selected Report.
  template_options = @current_user.entity.documents.where(owner_type: "PortfolioReport").includes(:owner).map do |d|
    ["#{d.name} - #{d.owner}", d.id, { data: { report_id: d.owner_id } }]
  end
  start_date ||= params[:start_date] || (Date.today - 3.months).beginning_of_month
  end_date ||= params[:end_date] || Date.today.end_of_month
%>

<%= render NewCard.new(col_md: "col-md-10") do %>
  <%= render FormCard.new(header_css_class: "w-100", title: "<span class='d-flex align-items-center justify-content-between w-100 gap-2'>Bulk Generate Portfolio Reports (Legacy) — Options #{user_guide_icon_for('portfolio_report_legacy', tooltip: 'Portfolio Report (Legacy) User Guide')}</span>") do %>

    <div class="alert alert-secondary small mb-4">
      Generating for <strong><%= @portfolio_companies.size %></strong> portfolio
      <%= 'company'.pluralize(@portfolio_companies.size) %>:
      <%= @portfolio_companies.map(&:investor_name).join(', ') %>
    </div>

    <%# The rows' messages live here so the page is the one place they are written; report-parts shows them. %>
    <%= form_with url: legacy_bulk_generate_options_portfolio_reports_path, method: :post,
          data: { controller: "report-parts", action: "submit->report-parts#validate",
                  report_parts_template_missing_message_value: PortfolioReportsController::PARTS_MESSAGES[:template_missing],
                  report_parts_template_repeated_message_value: PortfolioReportsController::PARTS_MESSAGES[:template_repeated],
                  report_parts_extracts_only_message_value: PortfolioReportsController::PARTS_MESSAGES[:extracts_only] } do |form| %>
      <% @portfolio_companies.each do |pc| %>
        <%= hidden_field_tag "portfolio_company_ids[]", pc.id %>
      <% end %>
      <%= hidden_field_tag :back_to, params[:back_to] if params[:back_to].present? %>

      <%# The list of reports: the order of the rows is the order of the parts in the final document %>
      <div class="mb-2">
        <h6 class="mb-1">Reports in the document</h6>
        <small class="form-text text-muted">Each row is one part of the final document, in this order. A report marked (Consolidated) is built once for all the companies; any other report is built once per company. Each template can be used only once.</small>
      </div>
      <%# One border around the whole list; the rows inside it have none %>
      <div class="border rounded p-3 mb-3" data-report-parts-target="rows">
        <%= render "report_part_row", index: 0, portfolio_reports: @portfolio_reports, template_options: template_options %>
      </div>
      <template data-report-parts-target="blueprint">
        <%= render "report_part_row", index: "__INDEX__", portfolio_reports: @portfolio_reports, template_options: template_options %>
      </template>
      <div class="mb-3">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="report-parts#add"><i class="ti ti-plus"></i> Add report</button>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <%= form.label :start_date %>
            <%= form.date_field :start_date, class: "form-control", name: "start_date", value: start_date %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-group">
            <%= form.label :end_date %>
            <%= form.date_field :end_date, class: "form-control", name: "end_date", value: end_date %>
          </div>
        </div>
      </div>

      <%# Documents are chosen automatically from each company's latest documented KPI report,
          so there are no period/as-of/add-docs inputs here anymore. %>

      <hr class="my-4">

      <div class="row">
        <div class="col-md-6 border-end">
          <h6>Generate Extracts Only</h6>
          <div class="form-check mb-2">
            <%= check_box_tag :only_missing_extracts, true, false, class: "form-check-input" %>
            <%= label_tag :only_missing_extracts, "Only generate for companies missing an extract", class: "form-check-label" %>
          </div>
          <button type="submit" name="mode" value="extracts_only" class="btn btn-outline-primary" data-disable-with="Queuing…">
            Generate Extracts Only
          </button>
          <div class="invalid-feedback" data-report-parts-target="extractsMessage"></div>
        </div>
        <div class="col-md-6">
          <h6>Generate Report</h6>
          <div class="form-check mb-2">
            <%= check_box_tag :generate_missing_extracts, true, false, class: "form-check-input" %>
            <%= label_tag :generate_missing_extracts, "Generate missing report extracts", class: "form-check-label" %>
          </div>
          <button type="submit" name="mode" value="full_report" class="btn btn-primary" data-disable-with="Queuing…">
            Generate Report
          </button>
        </div>
      </div>
    <% end %>

  <% end %>
<% end %>
