<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Portfolio Reports</h1>
  <div class="d-flex align-items-center gap-2">
    <%= user_guide_info_icon %>
    <% if policy(PortfolioReport.new(entity_id: current_user.entity_id)).bulk_generate? %>
      <%= link_to bulk_generate_portfolio_reports_path, class: "btn btn-outline-secondary" do %>
        <i class="ti ti-copy me-1"></i>Bulk Generate Drafts
      <% end %>
      <%= link_to legacy_bulk_generate_portfolio_reports_path, class: "btn btn-outline-secondary" do %>
        <i class="ti ti-report me-1"></i>Bulk Generate (Legacy)
      <% end %>
    <% end %>
    <%= link_to "New Portfolio Report", new_portfolio_report_path, class: "btn btn-outline-primary" %>
  </div>
</div>

<div class="table-responsive" data-controller="datatable">

  <table id="portfolio_reports" class="table table-bordered dataTable">

    <thead>
      <tr>
        <th>
          Entity
        </th>
        <th>
          Name
        </th>
        <th>
          Tags
        </th>
        <th>
          Include Kpi
        </th>
        <th>
          Include Portfolio Investments
        </th>
        <th>
          Setup Complete
        </th>
        <th>
        </th>
      </tr>
    </thead>

    <tbody>
    <% @portfolio_reports.each do |portfolio_report| %>
      <%= render portfolio_report %>
    <% end %>
    </tbody>
  </table>

</div>