<%= render FormCard.new(title: "Portfolio Reports : #{portfolio_report.to_s || 'New'}") do %>
  <% if !portfolio_report.new_record? && policy(portfolio_report).suggest_sections? %>
    <div data-controller="suggest-sections"
         data-suggest-sections-url-value="<%= suggest_sections_portfolio_report_path(portfolio_report) %>">
      <div class="alert alert-info py-2 small d-flex align-items-center gap-3 mb-3">
        <i class="ti ti-wand fs-5 text-primary"></i>
        <div class="flex-grow-1">
          <strong>AI Section Suggestions</strong> — let the AI suggest section names and instructions based on this report's name.
          Existing sections won't be removed; new ones will be appended.
        </div>
        <button class="btn btn-sm btn-outline-primary flex-shrink-0"
                data-action="click->suggest-sections#suggest">
          <i class="ti ti-wand me-1"></i>Suggest Sections (AI)
        </button>
      </div>
    </div>
  <% end %>
  <%= form_with(model: portfolio_report, validate: true) do |form| %>
    <% if portfolio_report.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(portfolio_report.errors.count, "error") %> prohibited this portfolio_report from being saved:</h2>
        <ul>
          <% portfolio_report.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :entity_id, class: "form-control"  %>

    <div class="form-group">
      <%= form.label :name %>
      <%= form.text_field :name, class: "form-control"  %>
    </div>
    <div class="form-group">
      <%= form.label :tags %>
      <%= form.text_field :tags, class: "form-control" %>
      <span class="form-text text-muted">Comma separated list of tags</span>
    </div>

    <div class="form-group">
      <%= form.label :include_kpi %>
      <%= form.check_box :include_kpi, class: "form-check-input" %>
    </div>
    <div class="form-group">
      <%= form.label :include_portfolio_investments %>
      <%= form.check_box :include_portfolio_investments, class: "form-check-input" %>
    </div>

     <h5 class="h5 mb-0 text-gray-800">Sections</h5>
      <div id="sections">
        <%= form.fields_for :portfolio_report_sections do |section_form| %>
          <%= render 'portfolio_report_section_fields', f: section_form %>
        <% end %>
      </div>

    <div class="form-group">
      <%= link_to_add_association 'Add Section', form, :portfolio_report_sections, class: 'btn btn-primary' %>
      <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
    </div>
  <% end %>
<% end %>
