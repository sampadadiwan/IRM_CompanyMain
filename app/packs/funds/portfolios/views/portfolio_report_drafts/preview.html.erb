<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Preview — <%= @draft.portfolio_company %> — <%= @draft.portfolio_report_template.name %></title>
  <style>
    body {
      font-family: Calibri, "Segoe UI", Arial, sans-serif;
      font-size: 11pt;
      line-height: 1.6;
      color: #1a1a1a;
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 60px;
      background: #fff;
    }
    .doc-toolbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      background: #1A3C6E;
      color: #fff;
      padding: 10px 24px;
      display: flex;
      align-items: center;
      gap: 16px;
      z-index: 999;
      font-size: 13px;
    }
    .doc-toolbar a { color: #93c5fd; text-decoration: none; }
    .doc-toolbar a:hover { text-decoration: underline; }
    body { padding-top: 60px; }
    h1 { font-size: 22pt; color: #1A3C6E; margin-bottom: 4px; }
    h2 { font-size: 14pt; color: #1A3C6E; border-bottom: 2px solid #1A3C6E; padding-bottom: 4px; margin-top: 32px; }
    .meta { color: #666; font-size: 10pt; margin-bottom: 32px; }
    table { width: 100%; border-collapse: collapse; font-size: 10pt; margin: 16px 0 24px; }
    thead th { background: #1A3C6E; color: #fff; padding: 7px 10px; text-align: left; }
    thead th.num { text-align: right; }
    td { border: 1px solid #ddd; padding: 6px 10px; }
    td.num { text-align: right; }
    tr.cat td { background: #eef2f8; font-weight: 600; font-size: 9pt; text-transform: uppercase; color: #555; }
    .narrative p { margin: 4px 0; }
    .page-break { border: none; border-top: 2px dashed #ccc; margin: 40px 0; }
    .preview-badge {
      display: inline-block;
      background: #fef3c7;
      color: #92400e;
      font-size: 10px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 4px;
      letter-spacing: 0.05em;
    }
  </style>
</head>
<body>

  <div class="doc-toolbar">
    <span><strong>Preview</strong> — <%= @draft.portfolio_company %> / <%= @draft.portfolio_report_template.name %></span>
    <span class="preview-badge">PREVIEW — not the final Word document</span>
    <span style="margin-left:auto;">
      <a href="<%= portfolio_report_draft_path(@draft) %>">← Back to draft</a>
    </span>
  </div>

  <%# Cover %>
  <h1><%= @draft.portfolio_company %></h1>
  <div class="meta">
    <%= @draft.portfolio_report_template.name %> &nbsp;|&nbsp;
    <%= @draft.kpi_period_type %> <%= @draft.kpi_tag %> &nbsp;|&nbsp;
    <%= l(@draft.start_date, format: :month_year) %> – <%= l(@draft.end_date, format: :month_year) %>
    &nbsp;|&nbsp; <%= @draft.n_periods %> periods
    &nbsp;|&nbsp; Generated <%= l(@draft.updated_at.to_date, format: :abbr_month_day_year) %>
  </div>

  <%# KPI Table %>
  <% if @kpi_mappings.any? && @period_labels.any? %>
    <h2>KPI Data</h2>
    <table>
      <thead>
        <tr>
          <th>Metric</th>
          <% @period_labels.each do |label| %>
            <th class="num"><%= label %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @kpi_mappings.each do |category, mappings| %>
          <tr class="cat">
            <td colspan="<%= @period_labels.length + 1 %>"><%= category.presence || "Other" %></td>
          </tr>
          <% mappings.each do |ikm| %>
            <tr>
              <td>
                <%= ikm.reported_kpi_name %>
                <% if ikm.denomination.present? %>
                  <span style="color:#888;font-size:9pt;">(<%= ikm.denomination %>)</span>
                <% end %>
              </td>
              <% @period_labels.each do |lbl| %>
                <td class="num">
                  <%= @draft.effective_kpi_table.dig(ikm.id.to_s, lbl) || "—" %>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <%# Section narratives %>
  <% @section_list.each_with_index do |section, idx| %>
    <% narrative = @draft.narrative_for(section.id) %>
    <% next unless narrative.present? %>
    <% if idx > 0 %><hr class="page-break"><% end %>
    <h2>
      <% if section.icon.present? %>
        <i class="ti ti-<%= section.icon %>"></i>
      <% end %>
      <%= section.name %>
    </h2>
    <div class="narrative">
      <%= sanitize narrative, tags: %w[ul ol li p b i strong em br blockquote h1 h2 h3], attributes: %w[href] %>
    </div>
  <% end %>

</body>
</html>
