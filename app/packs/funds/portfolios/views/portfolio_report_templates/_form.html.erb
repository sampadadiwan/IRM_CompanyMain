<%# locals: (portfolio_report_template:, portfolio_report:) %>
<%= render FormCard.new(title: "#{portfolio_report_template.new_record? ? 'New' : 'Edit'} Output Template — #{portfolio_report.name}") do %>
  <%= form_with model: portfolio_report_template,
                url: portfolio_report_template.new_record? ?
                       portfolio_report_portfolio_report_templates_path(portfolio_report) :
                       portfolio_report_template_path(portfolio_report_template),
                multipart: true,
                validate: true do |f| %>

    <% if portfolio_report_template.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% portfolio_report_template.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# ── Identity ─────────────────────────────────────────────────────────── %>
    <div class="row mb-3">
      <div class="col-md-7">
        <%= f.label :name, "Template name" %>
        <%= f.text_field :name, class: "form-control", placeholder: "e.g. LP Quarterly — Word" %>
        <small class="text-muted">Used to identify this template in the generate report form.</small>
      </div>
      <div class="col-md-3">
        <%= f.label :output_format, "Output format" %>
        <%= f.select :output_format, PortfolioReportTemplate::OUTPUT_FORMATS.map { |f| [f.upcase, f] },
                     {}, class: "form-control" %>
      </div>
    </div>

    <%# ── Style reference file ─────────────────────────────────────────────── %>
    <div class="mb-4">
      <label class="form-label fw-semibold">Style file</label>

      <%# Current file badge %>
      <% if portfolio_report_template.style_document.present? %>
        <div class="mb-2">
          <i class="ti ti-file-check text-success me-1"></i>
          <span class="text-success fw-semibold"><%= portfolio_report_template.style_document.name %></span>
          <span class="text-muted ms-1">(current — upload a new file below to replace)</span>
        </div>
      <% end %>

      <%# Direct upload — creates + assigns a Document in one step %>
      <div class="mb-2">
        <%= f.label :style_file, "Upload .docx / .pptx", class: "form-label" %>
        <%= f.file_field :style_file, class: "form-control", accept: ".docx,.pptx" %>
      </div>

      <%# Fallback picker for previously uploaded files %>
      <% style_docs = portfolio_report_template.new_record? ? [] : portfolio_report_template.documents.order(:name) %>
      <% if style_docs.any? %>
        <details class="mt-1">
          <summary class="text-primary small" style="cursor:pointer;">
            Or pick a previously uploaded file
          </summary>
          <div class="mt-2">
            <%= f.select :style_document_id, style_docs.map { |d| [d.name, d.id] },
                         { include_blank: "— none —" },
                         class: "form-control" %>
          </div>
        </details>
      <% end %>

      <%# Mode badges %>
      <div class="mt-3 d-flex gap-2 flex-wrap">
        <span class="badge bg-light text-secondary border">
          <strong>Theme-only</strong> — no placeholders; styles, fonts &amp; margins carry over
        </span>
        <span class="badge bg-light text-secondary border">
          <strong>[[ markers ]]</strong> — Word/PPT placeholder mode
        </span>
        <span class="badge bg-light text-secondary border">
          <strong>«sablon»</strong> — full Sablon variable interpolation (Word only)
        </span>
      </div>

      <%# Placeholder reference — collapsed by default %>
      <details class="mt-2">
        <summary class="text-primary small" style="cursor:pointer;">
          Available placeholders &amp; Sablon variables <small class="text-muted">(click to expand)</small>
        </summary>
        <div class="mt-2 p-3 bg-light border rounded small">
          <p class="mb-2 fw-semibold">[[ marker ]] placeholders (Word &amp; PPT)</p>
          <table class="table table-sm table-bordered mb-3">
            <thead class="table-dark">
              <tr><th>Marker</th><th>What it produces</th></tr>
            </thead>
            <tbody>
              <tr><td><code>[[ company name ]]</code></td><td>Portfolio company name</td></tr>
              <tr><td><code>[[ fund name ]]</code></td><td>Portfolio report name</td></tr>
              <tr><td><code>[[ template name ]]</code></td><td>This template's name</td></tr>
              <tr><td><code>[[ period ]]</code></td><td>Date range, e.g. "Jan 2024 – Jun 2024"</td></tr>
              <tr><td><code>[[ prepared date ]]</code></td><td>Export date</td></tr>
              <tr><td><code>[[ kpi table ]]</code></td><td>Full KPI data table</td></tr>
              <tr><td><code>[[ all sections ]]</code></td><td>Every section as Heading 2 + bullets</td></tr>
              <% portfolio_report.portfolio_report_sections.order(:id).each do |section| %>
                <tr>
                  <td><code>[[ section: <%= section.name %> ]]</code></td>
                  <td>Bullets for "<%= section.name %>"</td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <p class="mb-2 fw-semibold mt-3">«=variable» Sablon variables (Word only)</p>
          <table class="table table-sm table-bordered mb-0">
            <thead class="table-dark">
              <tr><th>Variable</th><th>What it produces</th></tr>
            </thead>
            <tbody>
              <tr><td><code>«=portfolio_company.investor_name»</code></td><td>Company name</td></tr>
              <tr><td><code>«=report.name»</code></td><td>Portfolio report name</td></tr>
              <tr><td><code>«=template.name»</code></td><td>Template name</td></tr>
              <tr><td><code>«=period»</code></td><td>Date range string</td></tr>
              <tr><td><code>«=current_date»</code></td><td>Export date</td></tr>
              <tr><td><code>«=sections:each(section)»</code> … <code>«=sections:endEach»</code></td><td>Loop over sections</td></tr>
              <tr><td><code>«=section.name»</code></td><td>Section heading (inside loop)</td></tr>
              <tr><td><code>«=section.bullets:each(bullet)»</code> … <code>«=section.bullets:endEach»</code></td><td>Loop over bullet strings</td></tr>
              <tr><td><code>«=bullet»</code></td><td>One bullet string (inside loop)</td></tr>
              <tr><td><code>«=kpis:each(kpi)»</code> … <code>«=kpis:endEach»</code></td><td>Loop over KPI rows</td></tr>
              <tr><td><code>«=kpi.header»</code></td><td>KPI metric name (inside loop)</td></tr>
              <tr><td><code>«=report_data.field_name»</code></td><td>AI-extracted field from latest extract</td></tr>
            </tbody>
          </table>
        </div>
      </details>
    </div>

    <%# ── KPI layout ───────────────────────────────────────────────────────── %>
    <fieldset class="mb-4 border rounded p-3">
      <legend class="fw-semibold fs-6 px-2 mb-2">KPI layout</legend>

      <div class="row">
        <div class="col-md-5">
          <%= f.label :kpi_categories, "KPI categories to include" %>
          <%# stored as kpi_layout[:categories] — comma-separated for simplicity %>
          <input type="text" name="portfolio_report_template[kpi_layout][categories]"
                 class="form-control"
                 placeholder="Income Statement, Operational Metrics"
                 value="<%= Array(portfolio_report_template.kpi_config[:categories]).join(', ') %>">
          <small class="text-muted">Comma-separated. Leave blank to include all categories.</small>
        </div>

        <div class="col-md-3">
          <%= label_tag :kpi_tags, "KPI data tag(s)" %>
          <% KpiReport::TAG_LIST.each do |label, value| %>
            <div class="form-check">
              <input type="checkbox" class="form-check-input"
                     name="portfolio_report_template[kpi_layout][tags][]"
                     id="tag_<%= value %>"
                     value="<%= value %>"
                     <%= "checked" if Array(portfolio_report_template.kpi_config[:tags]).include?(value) %>>
              <label class="form-check-label" for="tag_<%= value %>"><%= label %></label>
            </div>
          <% end %>
        </div>

        <div class="col-md-2">
          <%= label_tag :n_periods, "Last N periods" %>
          <input type="number" name="portfolio_report_template[kpi_layout][n_periods]"
                 class="form-control" min="1" max="24"
                 value="<%= portfolio_report_template.kpi_config[:n_periods] %>">
        </div>

        <div class="col-md-2 d-flex align-items-end pb-2">
          <div class="form-check">
            <input type="checkbox" class="form-check-input"
                   name="portfolio_report_template[kpi_layout][side_by_side]"
                   id="side_by_side"
                   value="true"
                   <%= "checked" if portfolio_report_template.kpi_config[:side_by_side] %>>
            <label class="form-check-label" for="side_by_side">Side by side</label>
          </div>
        </div>
      </div>
    </fieldset>

    <%# ── Section order ────────────────────────────────────────────────────── %>
    <div class="mb-4">
      <%= label_tag :section_order, "Section order" %>
      <small class="d-block text-muted mb-2">
        Select sections and order them. Hold Ctrl/Cmd to multi-select.
      </small>
      <select name="portfolio_report_template[section_order][]"
              class="form-control" multiple size="6">
        <% ordered_ids = portfolio_report_template.ordered_section_ids %>
        <%# Show selected sections first in configured order, then unselected ones %>
        <% all_sections = portfolio_report.portfolio_report_sections.index_by(&:id) %>
        <% display_ids  = ordered_ids + (all_sections.keys - ordered_ids) %>
        <% display_ids.each do |id| %>
          <% section = all_sections[id] %>
          <% next unless section %>
          <option value="<%= section.id %>"
                  <%= "selected" if ordered_ids.include?(section.id) %>>
            <%= section.name %>
          </option>
        <% end %>
      </select>
    </div>

    <%# ── Auto-generation schedule ───────────────────────────────────────── %>
    <fieldset class="mb-4 border rounded p-3">
      <legend class="fw-semibold fs-6 px-2 mb-2">
        Auto-generation schedule
        <small class="text-muted fw-normal">(automatically queue drafts on a schedule)</small>
      </legend>

      <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="auto_generate_enabled"
               name="portfolio_report_template[auto_generate_enabled]"
               value="true"
               <%= "checked" if portfolio_report_template.auto_generate_enabled %>>
        <label class="form-check-label" for="auto_generate_enabled">Enable scheduled auto-generation</label>
        <div class="form-text text-muted">When enabled, the system will automatically queue a new draft for every portfolio company on the configured schedule.</div>
      </div>

      <div class="row">
        <div class="col-md-4">
          <%= label_tag :auto_generate_frequency, "Frequency" %>
          <select name="portfolio_report_template[auto_generate_frequency]" class="form-control">
            <option value="">— select —</option>
            <% PortfolioReportTemplate::AUTO_FREQUENCIES.each do |f| %>
              <option value="<%= f %>" <%= "selected" if portfolio_report_template.auto_generate_frequency == f %>>
                <%= f.capitalize %>
              </option>
            <% end %>
          </select>
        </div>
        <div class="col-md-3">
          <%= label_tag :auto_generate_day, "Day of month to run" %>
          <input type="number" class="form-control" min="1" max="28"
                 name="portfolio_report_template[auto_generate_day]"
                 value="<%= portfolio_report_template.auto_generate_day || 1 %>">
          <div class="form-text text-muted">1–28 (avoids month-length issues)</div>
        </div>
        <% if portfolio_report_template.auto_generate_last_run_at.present? %>
          <div class="col-md-5 d-flex align-items-end pb-2">
            <small class="text-muted">
              <i class="ti ti-clock me-1"></i>
              Last run: <%= l(portfolio_report_template.auto_generate_last_run_at.to_date, format: :abbr_month_day_year) %>
            </small>
          </div>
        <% end %>
      </div>
    </fieldset>

    <%# ── Branding fallbacks ───────────────────────────────────────────────── %>
    <fieldset class="mb-4 border rounded p-3">
      <legend class="fw-semibold fs-6 px-2 mb-2">Branding fallbacks <small class="text-muted fw-normal">(used if not set in the style file)</small></legend>
      <div class="row">
        <div class="col-md-3">
          <%= label_tag :primary_color, "Primary colour" %>
          <input type="color" name="portfolio_report_template[branding][primary_color]"
                 class="form-control form-control-color"
                 value="<%= (portfolio_report_template.branding || {})['primary_color'] || '#1A3C6E' %>">
        </div>
        <div class="col-md-4">
          <%= label_tag :font, "Font" %>
          <input type="text" name="portfolio_report_template[branding][font]"
                 class="form-control"
                 placeholder="Calibri"
                 value="<%= (portfolio_report_template.branding || {})['font'] %>">
        </div>
      </div>
    </fieldset>

    <div class="d-flex gap-2">
      <%= f.submit portfolio_report_template.new_record? ? "Create Template" : "Update Template",
                   class: "btn btn-primary" %>
      <%= link_to "Cancel", portfolio_report_path(portfolio_report), class: "btn btn-outline-secondary" %>
    </div>

  <% end %>
<% end %>
