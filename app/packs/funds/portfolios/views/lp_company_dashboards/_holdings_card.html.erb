<%#
  Holdings card: the LP's visible holdings of this company in the selected fund — the same figures today's
  preview card showed (quantity, average cost, FMV), one row per instrument, plus the LP's own share under an
  own-share view. Existing card + table styles.
  Worked examples H10, E57, E58 — openspec/changes/lp-folio-portfolio-dashboard/business-rules.md
%>
<div class="card mb-3" id="lp_holdings_card">
  <div class="card-header"><h5 class="card-title mb-0">Holdings (<%= fund.name %>)</h5></div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-bordered mb-0">
        <thead>
          <tr>
            <th class="text-col">Instrument</th>
            <th class="num-col">Quantity</th>
            <th class="num-col">Avg Cost / Share</th>
            <th class="num-col">Fund Cost</th>
            <th class="num-col">Fund FMV</th>
            <% if own_share %>
              <th class="num-col">Your Cost</th>
              <th class="num-col">Your FMV</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% holdings.each do |holding| %>
            <tr>
              <td class="text-col"><%= holding.investment_instrument&.name %></td>
              <td class="num-col"><%= number_with_delimiter(holding.quantity.to_d.round(2)) %></td>
              <td class="num-col"><%= money_to_currency(holding.avg_cost, params) %></td>
              <td class="num-col"><%= money_to_currency(holding.cost_of_remaining, params) %></td>
              <td class="num-col"><%= money_to_currency(holding.fmv, params) %></td>
              <% if own_share %>
                <td class="num-col"><%= holding.lp_your_cost.is_a?(Money) ? money_to_currency(holding.lp_your_cost, params) : holding.lp_your_cost %></td>
                <td class="num-col"><%= holding.lp_your_fmv.is_a?(Money) ? money_to_currency(holding.lp_your_fmv, params) : holding.lp_your_fmv %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
