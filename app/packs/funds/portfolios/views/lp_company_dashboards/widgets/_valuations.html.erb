<%#
  LP version of the Valuations widget: valuations of the instruments the selected fund holds in the company.
  Worked example E57 — openspec/changes/lp-folio-portfolio-dashboard/business-rules.md
%>
<% valuations = LpWidgetData.new(**lp_context).valuations %>
<%= render(WidgetCardComponent.new(widget:, args:, widget_size: widget.widget_size)) do %>
  <% if valuations.none? %>
    <div class="text-muted p-3">No valuations shared yet.</div>
  <% else %>
    <div class="table-responsive">
      <table class="table table-bordered mb-0 lp-valuations">
        <thead>
          <tr>
            <th class="text-col">Date</th>
            <th class="text-col">Instrument</th>
            <th class="num-col">Per Share</th>
          </tr>
        </thead>
        <tbody>
          <% valuations.each do |valuation| %>
            <tr>
              <td class="text-col"><%= l(valuation.valuation_date) %></td>
              <td class="text-col"><%= valuation.investment_instrument&.name %></td>
              <td class="num-col"><%= money_to_currency(valuation.per_share_value, params) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
