<%#
  LP version of the Portfolio Stats widget: the company's figures in the selected fund only, in the app's stat
  cards (NumberStatsComponent).
  Worked example E57 — openspec/changes/lp-folio-portfolio-dashboard/business-rules.md
%>
<% fund = lp_context[:fund] %>
<% currency_params = { force_units: fund.default_currency_units } %>
<%= render(WidgetCardComponent.new(widget:, args:, widget_size: widget.widget_size)) do %>
  <div class="row lp-portfolio-stats">
    <% LpWidgetData.new(**lp_context).stats.each_with_index do |(label, amount), index| %>
      <%= render(NumberStatsComponent.new(path: nil, amount: money_to_currency(amount, currency_params), subtitle: label,
                                          progress_bar_color: %w[success info warning][index], text_info: "currency-dollar")) %>
    <% end %>
  </div>
<% end %>
