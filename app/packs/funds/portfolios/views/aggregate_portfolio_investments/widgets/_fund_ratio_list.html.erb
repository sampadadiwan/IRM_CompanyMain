<% fund_ratios_by_owner ||= {} %>

<div class="fund-ratio-list w-100">
  <% if fund_ratios_by_owner.any? %>
    <table class="table datatable align-middle">
      <thead>
        <tr>
          <th class="">Portfolio Company</th>
          <th class=" text-end">IRR <i class="ti ti-info-circle" data-bs-toggle="tooltip" title="Annualised return on the fund's investment in this company"></i></th>
          <th class=" text-end">MOIC <i class="ti ti-info-circle" data-bs-toggle="tooltip" title="(Current value + sale proceeds) / amount the fund invested in this company"></i></th>
        </tr>
      </thead>
      <tbody>
        <% fund_ratios_by_owner.each do |owner_name, ratios| %>
          <tr class="border-top">
            <td class="py-2">
              <div class="">
                <%= owner_name %>
              </div>
            </td>
            <% irr = ratios.find { |r| r.name == "IRR" } %>
            <% moic = ratios.find { |r| r.name == "MOIC" } %>
            <td class="py-2 text-end fw-bold">
              <%= irr ? (irr.display_value.presence || number_with_precision(irr.value, precision: 2)) : "-" %>
            </td>
            <td class="py-2 text-end fw-bold">
              <%= moic ? (moic.display_value.presence || number_with_precision(moic.value, precision: 2)) : "-" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-muted small mb-0">No data available.</p>
  <% end %>
</div>
