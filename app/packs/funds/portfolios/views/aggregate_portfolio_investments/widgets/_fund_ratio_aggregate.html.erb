<%
  # ─────────────────────────────────────────────────────────────────────────────
  # _fund_ratio_aggregate.html.erb
  #
  # Supports four computation scenarios driven by `display_mode`:
  #
  #   Scenario 1 — funds only, display_mode:"aggregate"
  #     Aggregate ratios (XIRR/MOIC/RVPI/DPI/TVPI…) across all companies in
  #     those funds. owner_type = "Fund".
  #
  #   Scenario 2 — funds + companies, display_mode:"aggregate"
  #     Same aggregate ratios but scoped to the selected companies only.
  #     owner_type = "Fund".
  #
  #   Scenario 3 — funds + companies, display_mode:"per_company"
  #     Per-company IRR/MOIC/Value To Cost. owner_type = "Investor".
  #     Each company's value is independent of the other selected companies.
  #
  #   Scenario 4 — funds + companies, display_mode:"both" (default when companies present)
  #     Renders scenario 2 aggregate section first, then scenario 3 per-company
  #     section. Each section independently shows "Generate" if no run exists.
  #
  # Key args:
  #   display_mode          — "aggregate" | "per_company" | "both" (auto-detected)
  #   fund_ids              — overrides @selected_fund_ids / @funds
  #   investor_ids          — overrides @selected_investor_ids / @investors
  #   aggregate_ratio_names — ratio names for the aggregate section (Fund owner)
  #   company_ratio_names   — ratio names for the per-company section (Investor owner)
  #   ratio_names           — shorthand sets both when display_mode is single
  #   titles                — chart/card titles aligned to ratio_names
  #   decimals              — decimal places (default 2)
  #   show_chart / show_table / condensed / show_y_axis / hide_fund_name
  #   chart_colors / negative_colors
  #   end_date / scenario / scenarios — forwarded to ratio query
  #   latest                — default true
  # ─────────────────────────────────────────────────────────────────────────────

  args ||= {}

  # Display options
  show_chart     = args[:show_chart].nil? ? (args[:chart].nil? ? true : args[:chart].to_s != "false") : args[:show_chart].to_s != "false"
  show_table     = args[:show_table].nil? ? (args[:list].nil? ? true : args[:list].to_s != "false") : args[:show_table].to_s != "false"
  hide_fund_name = args[:hide_fund_name].to_s == "true"
  show_y_axis    = args[:show_y_axis].nil? ? true : args[:show_y_axis].to_s != "false"
  decimals       = (args[:decimals] || 2).to_i
  chart_colors   = args[:positive_colors] || ['#2ecc71', '#e67e22', '#3498db', '#9b59b6']
  negative_colors= args[:negative_colors] || ['orange', 'red']
  latest         = args[:latest].to_s == "false" ? false : true

  # Data sources
  fund_ids     = args[:fund_ids].presence || local_assigns[:fund_ids].presence ||
                 @selected_fund_ids.presence || []
  fund_ids_i     = Array(fund_ids).map(&:to_i).reject(&:zero?)
  investor_ids = args[:investor_ids].presence || @selected_investor_ids.presence ||
                 @investors&.pluck(:id).presence || []
  # Auto-detect display_mode:
  #   - companies selected → "both" (aggregate + per-company)
  #   - funds only         → "aggregate"
  #   - can be overridden explicitly via args[:display_mode]
  display_mode = args[:display_mode].presence ||
                 (investor_ids.present? ? "both" : "aggregate")

  # Ratio names per section — allow explicit override or fall back to sensible defaults
  # Args from widget metadata may arrive in various encoded forms:
  #   - JSON array string:        '["MOIC","IRR"]'       → ["MOIC", "IRR"]
  #   - Array of quoted strings:  ['"MOIC"', '"IRR"']    → ["MOIC", "IRR"]
  #   - Plain array:              ["MOIC", "IRR"]         → ["MOIC", "IRR"]
  parse_ratio_names = ->(val) {
    return nil if val.blank?
    arr = Array(val).flat_map do |v|
      if v.is_a?(String) && v.start_with?("[")
        begin; JSON.parse(v); rescue StandardError; [v]; end
      else
        [v]
      end
    end
    arr.map { |v| v.to_s.strip.gsub(/\A["']|["']\z/, '') }.reject(&:blank?).presence
  }

  aggregate_ratio_names = parse_ratio_names.call(args[:aggregate_ratio_names]) ||
                          parse_ratio_names.call(display_mode == "aggregate" ? args[:ratio_names] : nil) ||
                          ["Gross Portfolio IRR", "MOIC", "RVPI", "DPI", "TVPI",
                           "Portfolio Value to Cost", "Paid In to Committed Capital"]
  company_ratio_names   = parse_ratio_names.call(args[:company_ratio_names]) ||
                          parse_ratio_names.call(display_mode == "per_company" ? args[:ratio_names] : nil) ||
                          ["IRR", "MOIC", "Value To Cost"]

  #
  scenario_list    = nil
  show_legend      = args[:show_legend].nil? ? scenario_list.present? : args[:show_legend].to_s != "false"

  anchor_fund = @funds&.first || (fund_ids.first ? Fund.find_by(id: fund_ids.first) : nil)

  # Smart label for aggregate ratios: single fund → fund name; multiple → "Multi-Fund (N funds)"
  agg_owner_label = if fund_ids.size == 1
    anchor_fund&.name || fund_ids.first.to_s
  elsif fund_ids.size > 1
    "Multi-Fund (#{fund_ids.size} funds)"
  else
    "Portfolio"
  end

  # ── Helper: build ratios_by_name hash from an AR relation ──────────────────
  build_ratios_by_name = ->(ratios_rel, rnames, use_agg_label: false, fund_id_to_name: {}) do
    rnames.each_with_object({}) do |ratio_name, h|
      scoped = ratios_rel.where(name: ratio_name)
      h[ratio_name] = if scenario_list.present?
        scenario_list.map { |sc| [sc, scoped.where(scenario: sc).first&.value.to_f.round(decimals)] }
      elsif use_agg_label
        all_runs = scoped.includes(:fund_ratio_run).to_a
        all_runs.map do |fr|
          label = if fr.owner&.name.present?
            fr.owner.name
          elsif fr.fund_ratio_run
            run = fr.fund_ratio_run
            template_name = run.template&.name.to_s
            template_name.presence || agg_owner_label
          else
            agg_owner_label
          end
          [label, fr.value.to_f.round(decimals)]
        end
      else
        scoped.map { |fr| [hide_fund_name ? "" : fr.display_owner&.name.to_s, fr.value.to_f.round(decimals)] }
      end
    end
  end

  # Preload fund_id_to_name once for all sections to avoid N+1 queries
  all_fund_ids_for_agg = []
  fund_id_to_name = {}
  tag_list_csv = Array(uri_params[:tag_list]).join(",")

  # template_names — optional list of FundRatioRunTemplate names to restrict the
  # fallback query when no fund/sector/tag filters are active.
  # Names are resolved to IDs once here so the helper receives a simple id array.
  template_names = args[:template_names].present? ? args[:template_names].split(",").map(&:strip) : nil
  template_ids   = if template_names.present?
    FundRatioRunTemplate.where(entity_id: current_user.entity_id, name: template_names).pluck(:id)
  else
    []
  end

  # ── Helper: render a ratio section (chart + table cards) ───────────────────
  # Called below for aggregate and/or per-company sections.
  section_titles = args[:titles] || []

%>

<%# ═══════════════════════════════════════════════════════════════════════════
    AGGREGATE SECTION  (Scenarios 1 & 2 — owner_type "Fund")
    Shows fund-level aggregate ratios. When companies are also selected the
    calculation is scoped to those companies but the result is still one
    number per ratio (not per-company).
══════════════════════════════════════════════════════════════════════════════ %>
<% if display_mode.in?(["aggregate", "both"]) %>
  <%
    aggregate_ratios = multi_fund_cross_portfolio_ratios(
      fund_ids_i, [], uri_params[:sector], tag_list_csv,
      ratio_names: aggregate_ratio_names,
      scenario: nil,
      scenarios: nil,
      template_ids: template_ids
    )

    # Preload fund names for aggregate section to avoid N+1 queries
    if aggregate_ratios.present?
      all_fund_ids_for_agg = aggregate_ratios.flat_map { |fr| Array(fr.fund_ratio_run&.fund_ids) || [] }.uniq
      fund_id_to_name = Fund.where(id: all_fund_ids_for_agg).pluck(:id, :name).to_h
    end
  %>

  <% if aggregate_ratios.nil? || aggregate_ratios.empty? %>
    <div class="card shadow-sm mb-3">
      <div class="card-body text-center py-4">
        <p class="text-muted mb-1 fw-semibold">No aggregate ratio computations found.</p>
        <p class="text-muted small mb-3">
          <% if investor_ids.present? %>
            Run a <strong>cross-fund</strong> computation for the selected funds &amp; companies.
          <% else %>
            Run a <strong>cross-fund</strong> computation for the selected funds.
          <% end %>
        </p>
      </div>
    </div>
  <% else %>
    <%
      agg_ratios_by_name = build_ratios_by_name.call(aggregate_ratios, aggregate_ratio_names, use_agg_label: true, fund_id_to_name: fund_id_to_name)

      agg_titles = section_titles.presence || Array.new(aggregate_ratio_names.size) { |i| aggregate_ratio_names[i] }

    %>
    <% if display_mode == "both" %>
      <h5 class="text-muted text-uppercase fw-semibold small mb-2 mt-3">Fund Aggregate Ratios</h5>
    <% end %>
    <div class="row g-3 mb-3">
      <% agg_ratios_by_name.each_with_index do |(ratio_name, ratios_data), idx| %>
        <% next if ratios_data.blank? %>
        <%
          is_irr  = ratio_name.upcase.include?('IRR')
          suffix  = is_irr ? ' %' : ' x'
          col_class = agg_ratios_by_name.count { |_, d| d.present? } == 1 ? 'col-12' : 'col-12 col-lg-6'
        %>
        <div class="<%= col_class %>">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-3">
              <h3 class="h5 mb-0 text-gray-800"><%= agg_titles[idx] || ratio_name %></h3>
              <div class="irr-detail-block d-flex flex-column">
                <% if show_chart %>
                  <%= column_chart ratios_data, colors: [chart_colors[idx % chart_colors.size]], library: {
                    chart: { height: 260 },
                    plotOptions: {
                      column: {
                        dataLabels: {
                          enabled: true,
                          format: "{y:.#{decimals}f}#{suffix}"
                        },
                        negativeColor: negative_colors[idx % negative_colors.size],
                        color: chart_colors[idx % chart_colors.size]
                      }
                    },
                    legend: { enabled: show_legend },
                    **chart_theme_color
                  } %>
                <% end %>
                <% if show_table %>
                  <%
                    table_rows = aggregate_ratios.where(name: ratio_name)
                                                 .includes(:owner, :fund_ratio_run)
                    table_rows_grouped = table_rows.group_by do |fr|
                      if fr.owner&.name.present?
                        fr.owner.name
                      elsif fr.fund_ratio_run
                        run       = fr.fund_ratio_run
                        template_name = run.template&.name.to_s
                        template_name.presence || agg_owner_label
                      else
                        agg_owner_label
                      end
                    end
                  %>
                  <table class="table table-sm align-middle mb-0 mt-2">
                    <thead class="table-light">
                      <tr>
                        <th class="text-white" style="font-size: 14px">Template</th>
                        <th class="text-end text-white" style="font-size: 14px">Value</th>
                        <th class="text-end text-white" style="font-size: 14px">As on</th>
                        <th class="text-end text-white" style="font-size: 14px">Run</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% table_rows_grouped.each do |label, frs| %>
                        <% fr = frs.max_by { |r| r.end_date || Date.new(0) } %>
                        <tr>
                          <td class="small"><%= label %></td>
                          <td class="small text-end fw-bold"><%= fr.display_value.presence || "#{"%.#{decimals}f" % fr.value} #{ratio_name.upcase.include?('IRR') ? '%' : 'x'}" %></td>
                          <td class="small text-end text-muted"><%= fr.end_date&.strftime("%b %-d, %Y") %></td>
                          <td class="small text-end">
                            <% if fr.fund_ratio_run %>
                              <%= link_to "View", fund_ratio_run_path(fr.fund_ratio_run), target: "_blank", class: "text-decoration-none small" %>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# ═══════════════════════════════════════════════════════════════════════════
    PER-COMPANY SECTION  (Scenario 3 — owner_type "Investor")
    Shows one bar per portfolio company. Each company's value is independent
    of the other companies selected; only the fund scope affects the result.
    Only rendered when companies are explicitly selected (investor_ids present).
══════════════════════════════════════════════════════════════════════════════ %>
<% if display_mode.in?(["per_company", "both"]) && investor_ids.present? %>
  <%
    company_ratios = multi_fund_cross_portfolio_ratios(
      fund_ids_i, [], uri_params[:sector], tag_list_csv,
      owner_types: ["Investor"],
      ratio_names: company_ratio_names,
      template_ids: template_ids
    )
  %>

  <% if company_ratios.nil? || company_ratios.empty? %>
    <div class="card shadow-sm mb-3">
      <div class="card-body text-center py-4">
        <p class="text-muted mb-1 fw-semibold">No per-company ratio computations found.</p>
        <p class="text-muted small mb-3">
          Run a <strong>cross-portfolio</strong> computation for the selected funds &amp; companies.
        </p>
      </div>
    </div>
  <% else %>
    <%
      co_ratios_by_name = build_ratios_by_name.call(company_ratios, company_ratio_names)
      co_titles = Array.new(company_ratio_names.size) { |i| company_ratio_names[i] }
    %>
    <% if display_mode == "both" %>
      <h5 class="text-muted text-uppercase fw-semibold small mb-2 mt-3">Per-Company Ratios</h5>
    <% end %>
    <div class="row g-3 mb-3">
      <% co_ratios_by_name.each_with_index do |(ratio_name, ratios_data), idx| %>
        <% next if ratios_data.blank? %>
        <%
          is_irr    = ratio_name.upcase.include?('IRR')
          suffix    = is_irr ? ' %' : ' x'
          col_class = co_ratios_by_name.count { |_, d| d.present? } == 1 ? 'col-12' : 'col-12 col-lg-6'
        %>
        <div class="<%= col_class %>">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-3">
              <h3 class="h5 mb-0 text-gray-800"><%= co_titles[idx] || ratio_name %></h3>
              <div class="irr-detail-block d-flex flex-column">
                <% if show_chart %>
                  <%= column_chart ratios_data, colors: [chart_colors[idx % chart_colors.size]], library: {
                    chart: { height: 260 },
                    plotOptions: {
                      column: {
                        dataLabels: {
                          enabled: true,
                          format: "{y:.#{decimals}f}#{suffix}"
                        },
                        negativeColor: negative_colors[idx % negative_colors.size],
                        color: chart_colors[idx % chart_colors.size]
                      }
                    },
                    legend: { enabled: false },
                    **chart_theme_color
                  } %>
                <% end %>
                <% if show_table %>
                  <%
                    co_table_rows = company_ratios.where(name: ratio_name)
                                                  .includes(:owner, :fund_ratio_run)
                    co_table_rows_grouped = co_table_rows.group_by do |fr|
                      fr.owner&.name.presence || "—"
                    end
                  %>
                  <table class="table table-sm align-middle mb-0 mt-2">
                    <thead class="table-light">
                       <tr>
                        <th class="text-white" style="font-size: 14px">Company</th>
                        <th class="text-end text-white" style="font-size: 14px">Value</th>
                        <th class="text-end text-white" style="font-size: 14px">As on</th>
                        <th class="text-end text-white" style="font-size: 14px">Run</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% co_table_rows_grouped.each do |label, frs| %>
                        <% fr = frs.max_by { |r| r.end_date || Date.new(0) } %>
                        <tr>
                          <td class="small"><%= label %></td>
                          <td class="small text-end fw-bold"><%= fr.display_value.presence || "#{"%.#{decimals}f" % fr.value} #{ratio_name.upcase.include?('IRR') ? '%' : 'x'}" %></td>
                          <td class="small text-end text-muted"><%= fr.end_date&.strftime("%b %-d, %Y") %></td>
                          <td class="small text-end">
                            <% if fr.fund_ratio_run %>
                              <%= link_to "View", fund_ratio_run_path(fr.fund_ratio_run), target: "_blank", class: "text-decoration-none small" %>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
