<%
  args ||= {}
  show_chart = args[:show_chart].nil? ? (args[:chart].nil? ? true : args[:chart].to_s != "false") : args[:show_chart].to_s != "false"
  show_table = args[:show_table].nil? ? (args[:list].nil? ? true : args[:list].to_s != "false") : args[:show_table].to_s != "false"
  condensed = args[:condensed].to_s == "true"
  hide_fund_name = args[:hide_fund_name].to_s == "true"
  show_y_axis = args[:show_y_axis].nil? ? true : args[:show_y_axis].to_s != "false"
  ratio_names = args[:ratio_names] || ["IRR", "MOIC"]
  chart_colors = args[:chart_colors] || ['green', 'DarkOrange']
  negative_colors = args[:negative_colors] || ['orange', 'red']

  titles = args[:titles] || Array.new(ratio_names.size, tags ? tags.titleize : nil) || ["Gross Portfolio IRR", "Gross Portfolio MOIC"]
  decimals = (args[:decimals] || 2).to_i
  fund_ids ||= @selected_fund_ids.presence || @funds.pluck(:id).presence || []
  owner_types = args[:owner_type] || ["Fund"]
  owner_ids = args[:owner_id] || fund_ids
  latest = args[:latest].to_s == "false" ? false : true

  fund_ratios = fund_ratio_list(
    owner_ids, fund_ids,
    owner_types: owner_types,
    ratio_names: ratio_names,
    latest: latest,
    end_date: args[:end_date],
    scenario: args[:scenario],
    scenarios: args[:scenarios],
    months: args[:months]
  )

  scenario_list = args[:scenarios].present? ? args[:scenarios].split(",").map(&:strip) : nil
  show_legend = args[:show_legend].nil? ? scenario_list.present? : args[:show_legend].to_s != "false"

  ratios_by_name = {}
  ratio_names.each do |ratio_name|
    scoped = fund_ratios.where(name: ratio_name)
    ratios_by_name[ratio_name] = if scenario_list.present?
      scenario_list.map do |sc|
        { name: sc, data: scoped.where(scenario: sc).map { |fr| [hide_fund_name ? "" : fr.owner.name, fr.value.to_f.round(decimals)] } }
      end
    else
      scoped.map { |fr| [hide_fund_name ? "" : fr.owner.name, fr.value.to_f.round(decimals)] }
    end
  end
%>

<div class="row g-3 mb-3">
  <% ratios_by_name.each_with_index do |(ratio_name, ratios_data), idx| %>
    <% col_class = ratios_by_name.size == 1 ? 'col-12' : 'col-12 col-lg-6' %>
    <div class="<%= col_class %>">
      <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column gap-3<%= ' p-2' if condensed %>">
          <h3 class="<%= condensed ? 'h5' : 'h3' %> mb-0 text-gray-800"><%= titles[idx] || ratio_name %></h3>

          <div class="irr-detail-block d-flex flex-column">
            <% if show_chart %>
              <div>
                <%
                  suffix = ratio_name.upcase.include?('IRR') ? ' %' : ' x'
                %>
                <%= column_chart ratios_data, colors: [chart_colors[idx]], library: {
                  chart: { height: condensed ? 180 : 260 },
                  plotOptions: {
                    column: {
                      dataLabels: {
                        enabled: true,
                        format: "{y:.#{decimals}f}#{suffix}"
                      },
                      negativeColor: negative_colors[idx],
                      color: chart_colors[idx]
                    }
                  },
                  xAxis: { labels: { enabled: !hide_fund_name } },
                  yAxis: { visible: show_y_axis },
                  legend: { enabled: show_legend },
                  **chart_theme_color
                } %>
              </div>
            <% end %>
            <% if show_table %>
              <div>
                <%= render "fund_ratio_list", fund_ratios: fund_ratios.where(name: ratio_name), decimals: decimals %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
