<%

  args ||= {}


  portfolio_company_ids ||= investors.pluck(:id)
  tags ||= nil
  sectors_to_include = uri_params[:sector] || []
  fund_ids ||= @selected_fund_ids.presence || Array(params[:fund_ids]).presence || @funds.pluck(:id).presence || []
  allowed_plot_params = ["fmv", "bought_amount", "sold_amount"]
  plot_param ||= args[:plot].present? ? args[:plot] : "fmv"
  title = args[:title] || tags || "Portfolio Company Charts"
  attr_label = case plot_param
               when "fmv" then "FMV"
               when "sold_amount" then "Sold Amount"
               else "Bought Amount"
               end

  # Default behavior: show_portfolio_company_wise is true if no other parameter is set
  show_sector_wise = args[:show_sector_wise] == true
  show_portfolio_company_wise = args[:show_portfolio_company_wise] == true || (!show_sector_wise)
  show_table = args.key?(:show_table) ? args[:show_table] == true : true
  show_chart = args.key?(:show_chart) ? args[:show_chart] == true : true
  table_limit = args[:table_limit] || 10

  unique_id = args[:unique_id] || SecureRandom.hex(4)
  entity_currency = current_user.entity.currency
%>

<% valid_plot_param = allowed_plot_params.include?(plot_param.downcase) %>
<div data-controller="company-sector-toggle">
<% if valid_plot_param %>
    <% if show_sector_wise || show_portfolio_company_wise %>
      <div class="card shadow mb-4">
        <div class="p-4 pb-0">
          <h4 class="h4 mb-0 text-gray-800"><%= title %></h4>
        </div>
        <div class="card-body">
        <div class="row gx-4 gy-0" >
          <% if show_sector_wise %>
            <div class="<%= (show_sector_wise && show_portfolio_company_wise) ? 'col-12 col-lg-6' : 'col-12' %>">

              <%= investment_chart_by_sectors(current_user.entity, fund_ids, portfolio_company_ids, sectors_to_include, plot_param, limit: table_limit, id: "investment_chart_by_sectors_chart_#{current_user.entity.id}_#{unique_id}") if show_chart %>
              <% if show_table %>
                <% grouped = investment_grouped_data_by_sectors(current_user.entity, fund_ids, portfolio_company_ids, sectors_to_include, plot_param) rescue [] %>
                <% table_data = process_table_data(grouped, limit: table_limit) %>
                <% if table_data[:top].any? %>

                  <div style="min-height: 280.5px;">
                    <table class="table table-bordered dataTable mt-2 mb-0">
                      <thead>
                        <tr>
                          <th>Sector</th>
                          <th class="text-end"><%= attr_label %> (<%= entity_currency %>)</th>
                          <th class="text-end">%</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% table_data[:top].each do |name, value| %>
                          <tr>
                            <td><%= name %></td>
                            <td class="text-end"><%= number_to_currency(value, unit: "#{entity_currency} ", precision: 0) %></td>
                            <td class="text-end"><%= number_to_percentage((value.to_f / table_data[:total]) * 100.0, precision: 1) %></td>
                          </tr>
                        <% end %>
                        <% if table_data[:others].any? %>
                          <% other_sum = table_data[:others].sum { |_, v| v } %>
                          <tr data-role="sector-others-summary-row">
                            <td>
                              <button class="btn btn-link btn-sm p-0 me-2 align-baseline" type="button" data-role="sector-others-toggle" aria-expanded="false">
                                <span data-role="sector-others-toggle-icon" aria-hidden="true">▸</span>
                                <span class="visually-hidden">Toggle other sectors</span>
                              </button>
                              Other
                            </td>
                            <td class="text-end"><%= number_to_currency(other_sum, unit: "#{entity_currency} ", precision: 0) %></td>
                            <td class="text-end"><%= number_to_percentage((other_sum.to_f / table_data[:total]) * 100.0, precision: 1) %></td>
                          </tr>
                          <%# The companies / sectors folded into Other, one ordinary row each, shown when Other is expanded %>
                          <% table_data[:others].each do |name, value| %>
                            <tr class="d-none" data-role="sector-others-list-row">
                              <td class="ps-5"><%= name %></td>
                              <td class="text-end"><%= number_to_currency(value, unit: "#{entity_currency} ", precision: 0) %></td>
                              <td class="text-end"><%= number_to_percentage((value.to_f / table_data[:total]) * 100.0, precision: 1) %></td>
                            </tr>
                          <% end %>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% if show_portfolio_company_wise %>
            <div class="<%= (show_sector_wise && show_portfolio_company_wise) ? 'col-12 col-lg-6' : 'col-12' %>">

              <%= investment_chart_by_companies(current_user.entity, fund_ids, plot_param, portfolio_company_ids, limit: table_limit, id: "investment_chart_by_companies_chart_#{current_user.entity.id}_#{unique_id}") if show_chart %>
              <% if show_table %>
              <% grouped = investment_grouped_data_by_companies(current_user.entity, fund_ids, plot_param, portfolio_company_ids) rescue [] %>
              <% table_data = process_table_data(grouped, limit: table_limit) %>
              <% if table_data[:top].any? %>

                <div style="min-height: 280.5px;">
                  <table class="table table-bordered dataTable mt-2 mb-0">
                    <thead>
                      <tr>
                        <th>Company</th>
                        <th class="text-end"><%= attr_label %> (<%= entity_currency %>)</th>
                        <th class="text-end">%</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% table_data[:top].each do |name, value| %>
                        <tr>
                          <td><%= name %></td>
                          <td class="text-end"><%= number_to_currency(value, unit: "#{entity_currency} ", precision: 0) %></td>
                          <td class="text-end"><%= number_to_percentage((value.to_f / table_data[:total]) * 100.0, precision: 1) %></td>
                        </tr>
                      <% end %>

                      <% if table_data[:others].any? %>
                        <% other_sum = table_data[:others].sum { |_, v| v } %>
                        <tr data-role="company-others-summary-row">
                          <td class="align-middle">
                            <button class="btn btn-link btn-sm p-0 me-2 align-baseline" type="button" data-role="company-others-toggle" aria-expanded="false">
                              <span data-role="company-others-toggle-icon" aria-hidden="true">▸</span>
                              <span class="visually-hidden">Toggle other companies</span>
                            </button>
                            Other
                          </td>
                          <td class="text-end align-middle">
                            <%= number_to_currency(other_sum, unit: "#{entity_currency} ", precision: 0) %>
                          </td>
                          <td class="text-end align-middle">
                            <%= number_to_percentage((other_sum.to_f / table_data[:total]) * 100.0, precision: 1) %>
                          </td>
                        </tr>
                        <%# The companies / sectors folded into Other, one ordinary row each, shown when Other is expanded %>
                        <% table_data[:others].each do |name, value| %>
                          <tr class="d-none" data-role="company-others-list-row">
                            <td class="ps-5"><%= name %></td>
                            <td class="text-end"><%= number_to_currency(value, unit: "#{entity_currency} ", precision: 0) %></td>
                            <td class="text-end"><%= number_to_percentage((value.to_f / table_data[:total]) * 100.0, precision: 1) %></td>
                          </tr>
                        <% end %>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
        </div>
      </div>
    <% end %>

<% end %>
</div>
