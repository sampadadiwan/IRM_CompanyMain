<%
  args ||= {}

  show_chart = args[:show_chart].nil? ? true : args[:show_chart]
  show_table = args[:show_table].nil? ? true : args[:show_table]
  ratio_names = args[:ratio_names] || ["IRR", "MOIC"]
  chart_colors = args[:chart_colors] || ["green", "DarkOrange"]
  negative_colors = args[:negative_colors] || ['orange', 'red']
  titles = args[:titles] || Array.new(ratio_names.size, tags ? tags.titleize : nil) || ["Gross Portfolio IRR", "Gross Portfolio MOIC"]
  decimals = args[:decimals] || 2

  fund_ids ||= @selected_fund_ids.presence || @funds.pluck(:id).presence || []
  investor_ids= @investors.pluck(:id).presence || []

  # This is not the final way need to discuss the storage of Fund Ratios for multiple funds and portfolio companies
  ratios_by_name = {}

  fund_ratios = fund_ratio_list(investor_ids, fund_ids, owner_types: ["Investor"], ratio_names: ratio_names)
  ratio_names.each do |ratio_name|
    ratios_by_name[ratio_name] = fund_ratios.where(name: ratio_name).map do |fr|
      # For IRR, use fr.value with decimals precision
      # For MOIC, parse from display_value to get the correct value
      if ratio_name.upcase.include?('IRR')
        numeric_value = fr.value.to_f
        formatted_value = numeric_value.round(decimals)
      else
        # For MOIC, extract numeric value from display_value (e.g., "2.0 x" -> 2.0)
        numeric_value = fr.display_value.to_s.gsub(/[^\d.-]/, '').to_f
        formatted_value = numeric_value.round(1)
      end
      [fr.owner.name, formatted_value]
    end
  end
%>


<div class="row g-3">
  <% ratios_by_name.each_with_index do |(ratio_name, ratios_data), idx| %>
    <% col_class = ratios_by_name.size == 1 ? 'col-12' : 'col-12 col-lg-6' %>
    <div class="<%= col_class %>">
      <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column gap-3">
          <h3 class="h3 mb-0 text-gray-800"><%= titles[idx] || ratio_name %></h3>

          <div class="irr-detail-block d-flex flex-column">
            <% if show_chart %>
              <div>
                <%
                  # Extract numeric values - they're already formatted with decimals from ratios_by_name
                  chart_data = ratios_data

                  # Determine suffix and decimal places based on ratio name
                  is_irr = ratio_name.upcase.include?('IRR')
                  suffix = is_irr ? ' %' : (ratio_name.upcase.include?('MOIC') ? 'x' : '')
                  chart_decimals = is_irr ? decimals : 1
                %>
                <%= column_chart chart_data, colors: [chart_colors[idx]], library: {
                  chart: { height: 260 },
                  plotOptions: {
                    column: {
                      dataLabels: {
                        enabled: true,
                        format: "{y:.#{chart_decimals}f}#{suffix}"
                      },
                      negativeColor: negative_colors[idx],
                      color: chart_colors[idx]
                    }
                  },
                  legend: { enabled: false },
                  **chart_theme_color
                } %>
              </div>
            <% end %>
            <% if show_table %>
              <div>
                <%= render "fund_ratio_list", fund_ratios: fund_ratios.where(name: ratio_name) %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
