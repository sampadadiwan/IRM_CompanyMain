<%#
  LP holdings list under an Allocated LP portfolio view: names the folio(s) the list is narrowed to, or says
  nothing has been allocated yet. Existing alert-info pattern, no new styling.
  Worked examples H2, E23, E24 — openspec/changes/lp-folio-portfolio-dashboard/business-rules.md
%>
<% if fund && current_user.curr_role_investor? && fund.lp_folio_portfolio? %>
  <% visibility = LpPortfolioVisibility.for_user(current_user) %>
  <% folios = visibility.folio_labels(fund) %>
  <% if visibility.visible_api_ids(fund).blank? %>
    <%# E24 — no folio, or nothing allocated to it yet %>
    <div class="alert alert-info d-flex align-items-start gap-2" id="lp_folio_banner">
      <i class="ti ti-info-circle"></i> No investments have been allocated to your folio yet.
    </div>
  <% else %>
    <%# H2, E23 — the folio(s) the list is narrowed to %>
    <div class="alert alert-info d-flex align-items-start gap-2" id="lp_folio_banner">
      <i class="ti ti-info-circle"></i> Showing investments allocated to your folio (<%= folios.join(", ") %>)
    </div>
  <% end %>
<% end %>
