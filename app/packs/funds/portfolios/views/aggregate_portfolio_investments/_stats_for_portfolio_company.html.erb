<%# Cards come from NumberStatsComponent. Cache digests track partials, not component templates — reword this note when the card markup changes so the cached fragment below is rebuilt (last: border-top card style, 2026-10-15). %>

<% field_names ||= []%>
<%# Optional, used by the investor show page: card_paths links a card (by subtitle) to the tab it
    summarises, extra_cards are appended to the same row. Both default to the dashboard widget's
    unlinked cards %>
<% card_paths ||= {} %>
<% extra_cards ||= [] %>
<% fields ||= [] %>
<% if portfolio_company %>

  <%# fields, force_units, card_paths and extra_cards change the rendered cards, so they are part of the key —
      otherwise the dashboard widget and the show page would serve each other's fragment %>
  <% cache_if(current_user != nil, cache_key(["api_stats", portfolio_company, params[:display_currency], show_currency_filter, fields, force_units, card_paths.to_a, extra_cards.map { |c| [c[:subtitle], c[:stat].to_s, c[:path]] }]), expires_in: 5.day) do %>
    <%
      error = nil
      begin
        # How many decimals to show in the stats
        decimals ||= params[:decimals]&.to_i || 2

        # Determine target currency based on user selection or defaults
        selected_currency = params[:display_currency] || params[:currency]

        if selected_currency.present? && ['INR', 'USD'].include?(selected_currency.upcase)
          target_currency = selected_currency.upcase
        elsif tracking_currency.present? && portfolio_company.entity.tracking_currency.present?
          target_currency = portfolio_company.entity.tracking_currency
        else
          target_currency = portfolio_company.entity.currency
        end

        params[:force_units] = force_units
        fields ||= []

        as_of_date = Date.current
        entity_id = portfolio_company.entity.id
        debug_mode = params[:debug] == 'true'
        debug_rates = [] if debug_mode

        # Summed in SQL per (currency, date) and converted once per group; only the requested fields are worked out
        stats = PortfolioCompanyStats.new(portfolio_company, target_currency, debug: debug_mode)
        totals = stats.cents(fields)
        debug_rates = stats.debug_rates if debug_mode
        # Money card for a field, with "how it is worked out" as its tooltip
        money_card = lambda do |subtitle, color, icon, tooltip|
          { path: nil, stat: money_to_currency(Money.new(totals[subtitle], target_currency), params, decimals: decimals),
            subtitle: subtitle, progress_bar_color: color, text_info: icon, tooltip: tooltip }
        end

        all_cards_data = [
          ["Bought Amount", "success", "plus", "Sum of every buy of this company across all funds, converted from the fund's currency to #{target_currency} at the rate on the investment date."],
          ["Sold Amount", "danger", "minus", "Sum of every sell of this company across all funds, converted from the fund's currency to #{target_currency} at the rate on the investment date."],
          ["FMV", "info", "graph", "Fair market value of every holding, converted to #{target_currency} at the rate on its valuation date (the investment date if it has no valuation)."],
          ["Cost Of Remaining", "danger", "currency-dollar", "Cost of the shares still held, converted to #{target_currency} at the rate on the investment date."],
          ["Income", "success", "cash", "Sum of all portfolio income cashflows, converted from the instrument's currency to #{target_currency} at the rate on the payment date."],
          ["Sold + FMV", "warning", "coins", "Sold Amount plus FMV: what has been realised plus the value still held, in #{target_currency}."]
        ].select { |subtitle, *| totals.key?(subtitle) }.map { |args| money_card.call(*args) }
        cards_data = fields.blank? ? all_cards_data : fields.map { |f| all_cards_data.find { |card| card[:subtitle] == f } }.compact
        # Link cards to their tabs (show page only) and append the caller's extra cards to the same row
        cards_data = cards_data.map { |card| card.merge(path: card_paths[card[:subtitle]]) } + extra_cards

      rescue => e
        error = "Error fetching portfolio company stats: #{e.message}"
        ErrorReport.notify(e, source: "aggregate_portfolio_investments/_stats_for_portfolio_company", user: current_user, portfolio_company_id: portfolio_company.id, entity_id: portfolio_company.entity_id)
      end
    %>

    <% if error.present? %>
      <div class="alert alert-danger" role="alert">
        <%= error %>
      </div>
    <% else %>
      <div <%= "data-controller=\"portfolio-stats-currency\" data-portfolio-stats-currency-portfolio-company-id-value=\"#{portfolio_company.id}\" data-portfolio-stats-currency-current-path-value=\"#{request.fullpath}\"".html_safe if show_currency_filter %>>
        <% if show_currency_filter %>
          <div class="d-flex justify-content-end mb-3">
            <label for="currency_selector_<%= portfolio_company.id %>" class="me-2 align-self-center mb-0">Currency:</label>
            <select
              id="currency_selector_<%= portfolio_company.id %>"
              class="form-select form-select-sm"
              style="width: 120px;"
              data-portfolio-stats-currency-target="select"
              data-action="change->portfolio-stats-currency#changeCurrency">
              <%
                # Determine base currency (entity's tracking_currency or currency)
                base_currency = tracking_currency.present? && portfolio_company.entity.tracking_currency.present? ?
                                portfolio_company.entity.tracking_currency :
                                portfolio_company.entity.currency
              %>
              <option value="<%= base_currency %>" <%= 'selected' if target_currency == base_currency %>><%=base_currency %></option>
              <% if base_currency != 'INR' %>
                <option value="INR" <%= 'selected' if target_currency == 'INR' %>>INR</option>
              <% end %>
              <% if base_currency != 'USD' %>
                <option value="USD" <%= 'selected' if target_currency == 'USD' %>>USD</option>
              <% end %>
            </select>
          </div>
        <% end %>
        <%
          per_row ||= nil
          card_row_styles = cards_data.map { "" }
          if per_row.present? && per_row.to_i > 0
            # Chunk into rows of `per_row` and size each row's columns off its own
            # card count, so a trailing row with fewer cards than `per_row` stretches
            # to fill the full row width instead of leaving blank space.
            # Bootstrap's col-md-N classes only express widths that are exact
            # divisors of 12, so a `per_row` like 5 or 7 would leave each row's
            # columns short of summing to 100%; use a precise percentage via
            # the stat-card-col class's --stat-card-width custom property instead.
            per_row_i = [per_row.to_i, 12].min
            card_row_classes = []
            card_row_styles = []
            cards_data.each_slice(per_row_i) do |row_cards|
              width_percent = (100.0 / row_cards.length).round(4)
              row_cards.each do
                card_row_classes << "stat-card-col"
                card_row_styles << "--stat-card-width: #{width_percent}%;"
              end
            end
          else
            card_col_class = case cards_data.length
                             when 1 then "col-md-12"
                             when 2 then "col-md-6"
                             when 3 then "col-md-4"
                             when 4 then "col-md-6"
                             else ""
                             end
            card_row_classes = cards_data.map { card_col_class }
          end
        %>
        <div id="stats_cards_<%= portfolio_company.id %>" class="row gy-3 single-portfolio-stats-row" <%= 'data-portfolio-stats-currency-target="stats"'.html_safe if show_currency_filter %>>

          <% cards_data.each_with_index do |card_data, index| %>
            <% subtitle = card_data[:subtitle] %>
            <% subtitle = field_names[index] if field_names[index].present? %>
            <%= render(NumberStatsComponent.new(
                        path: card_data[:path],
                        amount: card_data[:stat],
                        subtitle: subtitle,
                        fs_size: "5 font-weight-bold",
                        progress_bar_color: card_data[:progress_bar_color],
                        text_info: card_data[:text_info],
                        tooltip: card_data[:tooltip],
                        css_class: card_row_classes[index],
                        css_style: card_row_styles[index]
            )) %>
          <% end %>
        </div>

        <% if debug_mode && debug_rates.present? %>
          <div class="mt-4">
            <h6 class="text-muted">Exchange Rate Debug (target: <%= target_currency %>)</h6>
            <table class="table table-sm table-bordered small">
              <thead class="table-light">
                <tr>
                  <th>Field</th>
                  <th>Rows</th>
                  <th>From</th>
                  <th>To</th>
                  <th>Date Used</th>
                  <th>Rate</th>
                  <th>Original (cents)</th>
                  <th>Converted (cents)</th>
                </tr>
              </thead>
              <tbody>
                <% debug_rates.each do |r| %>
                  <tr class="<%= 'table-warning' if r[:rate].nil? %>">
                    <td><%= r[:field] %></td>
                    <td><%= r[:rows] %></td>
                    <td><%= r[:from] %></td>
                    <td><%= r[:to] %></td>
                    <td><%= r[:date] %></td>
                    <td><%= r[:rate].present? ? r[:rate] : '<span class="text-danger">missing</span>'.html_safe %></td>
                    <td><%= r[:original_cents] %></td>
                    <td><%= r[:converted_cents] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    <% end %>

    <% params[:force_units] = nil %>
  <% end %>
<% end %>
