<%
  show_fund_name ||= false
  fund = params[:fund_id].present? ? Fund.find(params[:fund_id]) : nil
  investor = params[:investor_id].present? ? Investor.find(params[:investor_id]) : nil
%>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Aggregate Portfolio Investments</h1>
  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= user_guide_info_icon %>
    <% if fund && !current_user.curr_role_investor? %>
      <button class="btn btn-outline-info d-inline-flex align-items-center" type="button"
              data-bs-toggle="collapse" data-bs-target="#portfolioAnalytics"
              aria-expanded="false" aria-controls="portfolioAnalytics">
        <i class="ti ti-chart-bar"></i> Analytics
      </button>
    <% end %>
    <% if investor %>
      <button class="btn btn-outline-info d-inline-flex align-items-center" type="button"
              data-bs-toggle="collapse" data-bs-target="#investorPortfolioAnalytics"
              aria-expanded="false" aria-controls="investorPortfolioAnalytics">
        <i class="ti ti-chart-bar"></i> Analytics
      </button>
      <button class="btn btn-outline-secondary d-inline-flex align-items-center" type="button"
              data-bs-toggle="collapse" data-bs-target="#investorLpFlowAnalytics"
              aria-expanded="false" aria-controls="investorLpFlowAnalytics">
        <i class="ti ti-arrows-transfer-up"></i> LP Investor Flow
      </button>
    <% end %>
    <% if fund && policy(fund).update? %>
      <%= link_to new_portfolio_investment_path(
                    "portfolio_investment[entity_id]": current_user.entity_id,
                    "portfolio_investment[fund_id]": fund.id),
                  class: "btn btn-outline-primary d-inline-flex align-items-center",
                  data: { turbo: false } do %>
        <i class="ti ti-plus"></i> New Investment
      <% end %>
      <%= link_to portfolio_scenarios_path(fund_id: fund.id),
                  class: "btn btn-outline-success d-inline-flex align-items-center",
                  data: { turbo: false } do %>
        <i class="ti ti-sort-ascending-2"></i> Scenarios
      <% end %>
      <%= link_to stock_conversions_path(fund_id: fund.id),
                  class: "btn btn-outline-success d-inline-flex align-items-center",
                  data: { turbo: false } do %>
        <i class="ti ti-transform"></i> Conversions
      <% end %>
      <div class="btn-group">
        <div class="dropdown">
          <button class="btn btn-outline-success dropdown-toggle d-inline-flex align-items-center upload_download_btn" type="button"
                  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="ti ti-upload"></i> <%= t_common(:upload) %> / Download
          </button>
          <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
            <%= link_to aggregate_portfolio_investments_path(fund_id: fund.id, format: "xlsx", all: true),
                        class: "dropdown-item d-flex align-items-center",
                        data: { turbo: false } do %>
              <i class="ti ti-download"></i> <%= t_common(:export_all) %> Investments
            <% end %>
            <span>
              <button class="dropdown-item" data-controller="export-xl"
                data-action="click->export-xl#export"
                data-tableid="aggregate_portfolio_investments"
                data-filename="AggregatePortfolioInvestments">
                <i class="ti ti-table-export"></i> <%= t_common(:export_visible) %>
              </button>
            </span>
            <!--
            Future addition if needed:
            <%= link_to portfolio_investments_path(fund_id: params[:fund_id], format: "xlsx", all: true),
                        class: "dropdown-item d-flex align-items-center",
                        data: { turbo: false } do %>
              <i class="ti ti-download"></i> Individual Investments
            <% end %>
            -->
            <%= link_to portfolio_investments_report_all_investors_path(fund_id: fund.id),
                        class: "dropdown-item d-flex align-items-center",
                        data: { turbo: false } do %>
              <i class="ti ti-report"></i> Portfolio Investment Report
            <% end %>
            <div class="dropdown-divider"></div>
            <%= link_to new_import_upload_path(
                          "import_upload[owner_id]": fund.id,
                          "import_upload[owner_type]": "Fund",
                          "import_upload[import_type]": "PortfolioInvestment",
                          "sample_upload": "PORTFOLIO_SAMPLE"),
                        class: "dropdown-item d-flex align-items-center",
                        data: { turbo: false } do %>
              <i class="ti ti-upload"></i> <%= t_common(:upload) %>
            <% end %>
          </div>
        </div>
      </div>
      <% if current_user.entity.enable_snapshots %>
        <%= link_to aggregate_portfolio_investments_path(
                      fund_id: fund.id, snapshot: true, filter: true, time_series: true),
                    class: "btn btn-outline-primary d-inline-flex align-items-center",
                    data: { turbo: false } do %>
          <i class="ti ti-chart-line"></i> Time Series
        <% end %>
      <% end %>
    <% end %>
    <!-- Show Master Fund Portfolio link if fund is a sub-fund and master fund has portfolios and  master_fund.show_portfolios-->
    <% if fund && fund.master_fund_id.present? && fund.master_fund.features.show_portfolios? %>
      <%= link_to "Master Fund Portfolio", aggregate_portfolio_investments_path(fund_id: fund.master_fund_id), class: "btn btn-outline-secondary ti ti-home" %>
    <% end %>
  </div>
</div>
<%= render "aggregate_portfolio_investments/analytics", fund: fund, investor: investor %>
<%
  # The LP's folio banner and totals belong to their whole holdings list, not to one company's list (e.g. the
  # Portfolio Investments widget on an LP company page, which filters by company)
  lp_fund_summary = fund && current_user.curr_role_investor? && fund.lp_folio_portfolio? && params[:portfolio_company_id].blank?
%>
<%= render "aggregate_portfolio_investments/lp_folio_banner", fund: fund if lp_fund_summary || !current_user.curr_role_investor? %>
<%# Under an Allocated LP view the totals are the LP's visible holdings, shown in the widget grid too (H2) %>
<%= render "aggregate_portfolio_investments/stats",  aggregate_portfolio_investments:, fund: fund if params[:grid_only].blank? || lp_fund_summary %>
<!-- Table Header with our without fund -->
<%
  api_turbo_frame = "aggregate_portfolio_investments_frame"

  default_columns_map = if params[:fund_id].present?
    AggregatePortfolioInvestment::STANDARD_COLUMNS
  else
    if params.include? "investor_id"
      AggregatePortfolioInvestment::INVESTOR_TAB_STANDARD_COLUMNS
    else
      AggregatePortfolioInvestment::STANDARD_COLUMNS_WITH_FUND
    end
  end
  # H3 — the LP's own share columns, read from their folio entries
  # Placed right after the fund's FMV so they are on screen next to the figures they compare with
  default_columns_map = LpOwnShareSummary.insert_columns(default_columns_map) if @lp_own_share
  # E44 — the company cell links to the LP company page when the LP may open it
  default_columns_map = default_columns_map.transform_values { |v| v.sub("portfolio_company_name;", "lp_company_cell;") } if @lp_company_links
%>
<%=render SearchComponent.new(data_source: aggregate_portfolio_investments_path(params: params.to_unsafe_h), turbo_frame: api_turbo_frame) %>
<%= render RansackTable.new(AggregatePortfolioInvestment, q: @q, default_columns_map:, current_user: current_user, records: aggregate_portfolio_investments, report_id: params["report_id"], turbo_frame: api_turbo_frame, referrer: request.referrer, pagy: @pagy) %>
<%= render "aggregate_portfolio_investments/lp_own_share_note", summary: @lp_own_share if @lp_own_share && params[:portfolio_company_id].blank? %>
