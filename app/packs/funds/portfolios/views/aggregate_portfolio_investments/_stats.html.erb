<%
  # Under an Allocated LP portfolio view an LP's totals cover only the holdings allocated to their folio, never
  # the whole fund (H2: 25 + 15 = ₹40 Cr, not the fund's ₹60 Cr). Per-LP figures are not cached.
  # Worked examples H2, E43 — openspec/changes/lp-folio-portfolio-dashboard/business-rules.md
  lp_api_ids = (LpPortfolioVisibility.for_user(current_user).visible_api_ids(fund) if fund && current_user&.curr_role_investor?)
%>
<% if fund %>
  <% cache_if(current_user != nil && lp_api_ids.nil?, cache_key(["api_stats", fund]), expires_in: 5.day) do %>
    <% params[:force_units] = fund.default_currency_units %>
    <%
      apis = fund.aggregate_portfolio_investments
      pis = fund.portfolio_investments
      cashflows = fund.portfolio_cashflows
      if lp_api_ids
        apis = apis.where(id: lp_api_ids)
        pis = pis.where(aggregate_portfolio_investment_id: lp_api_ids)
        cashflows = cashflows.where(aggregate_portfolio_investment_id: lp_api_ids)
      end
    %>

    <% cards_data = [
      { path: nil, stat: money_to_currency(Money.new(pis.sum(:net_bought_amount_cents), fund.currency), params), subtitle: "Bought Amount", progress_bar_color: "success", text_info: "currency-dollar" },
      { path: nil, stat: money_to_currency(Money.new(apis.sum(:sold_amount_cents), fund.currency), params), subtitle: "Sold Amount", progress_bar_color: "danger", text_info: "cash" },
      { path: nil, stat: money_to_currency(Money.new(apis.sum(:fmv_cents), fund.currency), params), subtitle: "FMV", progress_bar_color: "info", text_info: "graph" },
      { path: nil, stat: money_to_currency(Money.new(apis.sum(:cost_of_remaining_cents), fund.currency), params), subtitle: "Cost Of Remaining", progress_bar_color: "warning", text_info: "currency-dollar" },
      { path: nil, stat: money_to_currency(Money.new(cashflows.sum(:amount_cents), fund.currency), params), subtitle: "Income", progress_bar_color: "success", text_info: "currency-dollar" },
    ] %>

    <div class="row">
      <% cards_data.each do |card_data| %>
        <%= render(NumberStatsComponent.new(
                    path: card_data[:path],
                    amount: card_data[:stat],
                    subtitle: card_data[:subtitle],
                    progress_bar_color: card_data[:progress_bar_color],
                    text_info: card_data[:text_info]
        )) %>
      <% end %>
    </div>

    <% params[:force_units] = nil %>
  <% end %>
<% end %>
