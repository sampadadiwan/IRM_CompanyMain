<%params[:force_units] = force_units || current_user.entity.default_currency_units %>
<%if @investors.blank? %>
  <div class="alert alert-info" role="alert">
    No investors selected to display aggregated stats.
  </div>
<% else %>

    <%
      error = nil
      show_currency_filter ||= false
      tracking_currency ||= nil
      begin
        # How many decimals to show in the stats
        decimals ||= 2
        fields ||= []
        field_names ||= []

        # Determine target currency
        selected_currency = params[:display_currency]

        if selected_currency.present?
          target_currency = selected_currency
        elsif show_currency_filter
          # When currency filter is shown, default to entity currency so it appears pre-selected in the dropdown
          target_currency = current_user.entity.currency
        elsif tracking_currency.present? && current_user.entity.tracking_currency.present?
          target_currency = current_user.entity.tracking_currency
        elsif currency.present? && current_user.entity.currency_list.include?(currency)
          target_currency = currency
        else
          target_currency = current_user.entity.currency
        end
        # Fetch relevant portfolio investments and cashflows for the selected investors
        investor_ids = @investors.map(&:id)
        portfolio_investments = Pundit.policy_scope(current_user, PortfolioInvestment)
                                      .where(portfolio_company_id: investor_ids)
                                      .includes(:fund, :investment_instrument, :valuation, portfolio_company: :entity)

        portfolio_cashflows = Pundit.policy_scope(current_user, PortfolioCashflow)
                                    .where(portfolio_company_id: investor_ids)
                                    .includes(:fund, :investment_instrument, portfolio_company: :entity)

        # Filter by selected funds if any
        if @selected_fund_ids.present?
          portfolio_investments = portfolio_investments.where(fund_id: @selected_fund_ids)
          portfolio_cashflows = portfolio_cashflows.where(fund_id: @selected_fund_ids)
        end

        # Load records into memory to avoid N+1 queries during aggregation
        portfolio_investments = portfolio_investments.to_a
        portfolio_cashflows = portfolio_cashflows.to_a

        # Pre-fetch exchange rates for all involved entities
        entity_ids = (portfolio_investments.map { |pi| pi.portfolio_company.entity_id } +
                      portfolio_cashflows.map { |pc| pc.portfolio_company.entity_id }).uniq

        all_rates = ExchangeRate.where(entity_id: entity_ids).order(as_of: :desc).to_a.group_by(&:entity_id)

        # Helper for in-memory currency conversion
        convert_in_memory = lambda do |from, to, amount, as_of, entity_id|
          return amount if from == to || amount.zero?
          rates = all_rates[entity_id]&.select { |r| r.from == from && r.to == to && r.as_of <= as_of }
          rate = rates&.first&.rate
          rate ? (amount * rate).to_i : 0
        end

        # Compute aggregated stats across all investors and funds
        total_bought_amount_cents = 0
        total_sold_amount_cents = 0
        total_cost_of_remaining_cents = 0
        total_fmv_cents = 0

        portfolio_investments.each do |pi|
          # Skip master_fund investments
          if pi.portfolio_company.json_fields["master_fund"] == "yes" && pi.fund.master_fund_id.present? && @selected_fund_ids.include?(pi.fund.master_fund_id)
            next
          end

          total_cost_of_remaining_cents += convert_in_memory.call(pi.investment_instrument.currency, target_currency, pi.cost_of_remaining_cents, pi.investment_date, pi.portfolio_company.entity_id)
          converted_amount = convert_in_memory.call(pi.investment_instrument.currency, target_currency, pi.amount_cents, pi.investment_date, pi.portfolio_company.entity_id)

          if pi.quantity.positive?
            total_bought_amount_cents += converted_amount
          elsif pi.quantity.negative?
            total_sold_amount_cents += converted_amount
          end

          conversion_date = pi.valuation.present? ? pi.valuation.valuation_date : pi.investment_date
          total_fmv_cents += convert_in_memory.call(pi.investment_instrument.currency, target_currency, pi.fmv_cents, conversion_date, pi.portfolio_company.entity_id)
        end

        total_sold_plus_fmv_cents = total_sold_amount_cents + total_fmv_cents

        total_income_cents = portfolio_cashflows.sum do |pc|
          if pc.portfolio_company.json_fields["master_fund"] == "yes" && pc.fund.master_fund_id.present? && @selected_fund_ids.include?(pc.fund.master_fund_id)
            next 0
          end
          convert_in_memory.call(pc.investment_instrument.currency, target_currency, pc.amount_cents, pc.payment_date, pc.portfolio_company.entity_id)
        end

        all_cards_data = [
          { path: nil, stat: money_to_currency(Money.new(total_bought_amount_cents, target_currency), params, decimals: decimals), subtitle: "Total Bought Amount", progress_bar_color: "success", text_info: "plus" },
          { path: nil, stat: money_to_currency(Money.new(total_sold_amount_cents, target_currency), params, decimals: decimals), subtitle: "Total Sold Amount", progress_bar_color: "danger", text_info: "minus" },
          { path: nil, stat: money_to_currency(Money.new(total_fmv_cents, target_currency), params, decimals: decimals), subtitle: "Total FMV", progress_bar_color: "info", text_info: "graph" },
          { path: nil, stat: money_to_currency(Money.new(total_cost_of_remaining_cents, target_currency), params, decimals: decimals), subtitle: "Total Cost Of Remaining", progress_bar_color: "danger", text_info: "currency-dollar" },
          { path: nil, stat: money_to_currency(Money.new(total_income_cents, target_currency), params, decimals: decimals), subtitle: "Total Income", progress_bar_color: "success", text_info: "cash" },
          { path: nil, stat: money_to_currency(Money.new(total_sold_plus_fmv_cents, target_currency), params, decimals: decimals), subtitle: "Sold + FMV", progress_bar_color: "warning", text_info: "coins" }
        ]

        cards_data = fields.blank? ? all_cards_data : all_cards_data.select { |card| fields.include?(card[:subtitle]) }
      rescue => e
        error = "Error fetching stats for multiple investors: #{e.message}"
        ExceptionNotifier.notify_exception(e, data: { portfolio_company_ids: @investors.map(&:id), user_id: current_user&.id })
      end
    %>

    <% if error.present? %>
      <div class="alert alert-danger" role="alert">
        <%= error %>
      </div>
    <% else %>
      <%
        per_row ||= nil
        if per_row.present? && per_row.to_i > 0
          card_col_class = "col-md-#{12 / per_row.to_i}"
        else
          card_col_class = case cards_data.length
                           when 1 then "col-md-12"
                           when 2 then "col-md-6"
                           when 3 then "col-md-4"
                           when 4 then "col-md-6"
                           else ""
                           end
        end

        investor_ids = @investors.map(&:id)
        stimulus_data = show_currency_filter ? {
          "data-controller" => "portfolio-stats-currency",
          "data-portfolio-stats-currency-investor-ids-value" => investor_ids.to_json,
          "data-portfolio-stats-currency-current-path-value" => request.fullpath,
          "data-portfolio-stats-currency-fields-value" => fields.join(","),
          "data-portfolio-stats-currency-decimals-value" => decimals.to_s,
          "data-portfolio-stats-currency-force-units-value" => (force_units || current_user.entity.default_currency_units).to_s,
          "data-portfolio-stats-currency-tracking-currency-value" => tracking_currency.to_s,
          "data-portfolio-stats-currency-currency-value" => currency.to_s,
          "data-portfolio-stats-currency-widget-size-value" => widget_size.to_s,
          "data-portfolio-stats-currency-widget-id-value" => widget_id.to_s
        } : {}
      %>
      <div <%= stimulus_data.map { |k, v| "#{k}=\"#{v}\"" }.join(" ").html_safe %>>
        <% if show_currency_filter %>
          <div class="d-flex justify-content-end mb-3">
            <label class="me-2 align-self-center mb-0">Currency:</label>
            <select
              class="form-select form-select-sm"
              style="width: 120px;"
              data-portfolio-stats-currency-target="select"
              data-action="change->portfolio-stats-currency#changeCurrency">
              <% current_user.entity.currency_list.each do |cur| %>
                <option value="<%= cur %>" <%= 'selected' if target_currency == cur %>><%= cur %></option>
              <% end %>
            </select>
          </div>
        <% end %>

        <div id="multi_portfolio_stats_cards_<%= widget_id %>" class="row" <%= 'data-portfolio-stats-currency-target="stats"'.html_safe if show_currency_filter %>>
          <% cards_data.each_with_index do |card_data, index| %>
            <% subtitle = card_data[:subtitle] %>
            <% subtitle = field_names[index] if field_names[index].present? %>
            <%= render(NumberStatsComponent.new(
                        path: card_data[:path],
                        amount: card_data[:stat],
                        subtitle: subtitle,
                        fs_size: "5 font-weight-bold",
                        progress_bar_color: card_data[:progress_bar_color],
                        text_info: card_data[:text_info],
                        css_class: card_col_class
            )) %>
          <% end %>
        </div>
      </div>
      <% params[:force_units] = nil %>
    <% end %>

<% end %>
