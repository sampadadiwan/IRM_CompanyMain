<% aggregate_portfolio_investment ||= nil %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Portfolio Income</h1>

  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= user_guide_info_icon %>
    <%= link_to "New Portfolio Income", new_portfolio_cashflow_path("portfolio_cashflow[aggregate_portfolio_investment_id]": aggregate_portfolio_investment.id), {class: "btn btn-outline-primary ti ti-plus"}  if aggregate_portfolio_investment %>

    <%= link_to "Upload",
          new_import_upload_path(
          "import_upload[import_type]": "PortfolioCashflow",
          "sample_upload": "PORTFOLIO_INCOME_SAMPLE"),
          { class: "btn btn-outline-primary ti ti-upload"}   %>


    <%= link_to "Download", portfolio_cashflows_path(params: params.to_unsafe_h, aggregate_portfolio_investment_id: aggregate_portfolio_investment&.id, format: :xlsx), { class: "btn btn-outline-primary ti ti-download"}   %>
  </div>

</div>
<%# D21 — the firm's chosen columns (or the list's own, PortfolioCashflow::LIST_COLUMNS), sorted, searched and paged
    in the page by jQuery DataTables (sortable: false, pagy: nil). openspec/changes/grid-columns-inline-settings %>
<% list_columns = params[:portfolio_company_id].present? ? PortfolioCashflow::WITH_FUND_LIST_COLUMNS : PortfolioCashflow::LIST_COLUMNS %>
<% cashflows_table = RansackTable.new(PortfolioCashflow, q: @q, default_columns_map: list_columns, current_user: current_user,
                                      records: portfolio_cashflows, report_id: params["report_id"], turbo_frame: "portfolio_cashflows_frame",
                                      referrer: request.referrer, pagy: nil, table_css_class: "jqDataTable", sortable: false) %>
<div data-controller="datatable" data-datatable-responsive-details-value=true
     data-datatable-money-columns-value="<%= cashflows_table.money_column_indexes %>">
  <%= render cashflows_table %>
</div>