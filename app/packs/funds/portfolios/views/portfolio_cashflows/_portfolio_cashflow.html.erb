<%# One cashflow in the Portfolio Income list: the chosen columns (RansackTableRow), then its actions — D21 %>
<tr id="<%= dom_id portfolio_cashflow %>">
  <%= render RansackTableRow.new(model: portfolio_cashflow, columns:) %>
  <td>
    <%= link_to  t_common(:show), portfolio_cashflow , {class: "btn btn-outline-primary ti ti-eye"}%>
    <%= link_to  t_common(:edit), edit_portfolio_cashflow_path(portfolio_cashflow), {class: "btn btn-outline-success ti ti-edit"}  if policy(portfolio_cashflow).update? %>
  </td>
</tr>
