<%# Obligation form — manual entry and counsel edits.
    Legal category drives the source picker: SLO → side letter dropdown,
    CP/CS → portfolio investment dropdown. The obligation-source Stimulus
    controller toggles visibility on change.
    Locals: obligation %>
<%= form_with model: obligation, url: obligation.persisted? ? side_letter_obligation_path(obligation) : side_letter_obligations_path do |f| %>
  <% if obligation.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% obligation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Determine current source mode from the obligation's existing associations %>
  <% is_portfolio = obligation.sourceable_type == "PortfolioInvestment" %>
  <% is_cp_cs = obligation.legal_condition_precedent? || obligation.legal_condition_subsequent? %>

  <div class="row g-3" data-controller="obligation-source">

    <%# Row 1: Legal category + conditional source picker + title %>
    <div class="col-md-2">
      <%# Legal classification drives which source picker appears below:
          CP/CS shows portfolio investments, SLO shows side letters %>
      <%= f.label :legal_category, "Legal category", class: "form-label" %>
      <%# CP/CS obligations only show CP and CS options (SLO excluded) %>
    <% form_category_opts = is_cp_cs ? legal_category_options.reject { |_, v| v == 2 } : legal_category_options %>
    <%= f.select :legal_category, form_category_opts, {},
                   class: "form-select",
                   data: { obligation_source_target: "category",
                           action: "change->obligation-source#toggle" } %>
    </div>

    <% if obligation.side_letter_id.present? && !is_cp_cs %>
      <%# Editing an existing commitment obligation — keep the side letter locked %>
      <%= f.hidden_field :side_letter_id %>
    <% else %>
      <%# Side letter picker — visible for SLO, hidden for CP/CS %>
      <div class="col-md-4" data-obligation-source-target="sideLetter"
           <%= "hidden" if is_cp_cs || is_portfolio %>>
        <%= f.label :side_letter_id, "Side letter", class: "form-label" %>
        <%= f.collection_select :side_letter_id,
                                SideLetter.where(entity_id: current_user.entity_id)
                                          .includes(:document, capital_commitment: %i[investor fund]),
                                :id, :to_s, { include_blank: "Select side letter" },
                                class: "form-select",
                                disabled: is_cp_cs || is_portfolio %>
      </div>

      <%# Portfolio investment picker — visible for CP/CS, hidden for SLO %>
      <div class="col-md-4" data-obligation-source-target="portfolioInvestment"
           <%= "hidden" unless is_cp_cs || is_portfolio %>>
        <%= f.label :sourceable_id, "Portfolio investment", class: "form-label" %>
        <% if obligation.new_record? %>
          <%= f.hidden_field :sourceable_type, value: "PortfolioInvestment" %>
          <%= f.select :sourceable_id,
                       options_from_collection_for_select(
                         PortfolioInvestment.where(entity_id: current_user.entity_id)
                                            .includes(:portfolio_company, :fund)
                                            .order(:portfolio_company_name),
                         :id, :to_s, obligation.sourceable_id),
                       { include_blank: "Select portfolio investment" },
                       class: "form-select",
                       disabled: !(is_cp_cs || is_portfolio) %>
        <% else %>
          <%# An obligation never moves to another source (read-only), so Edit shows it %>
          <%= text_field_tag :sourceable_name, obligation.sourceable&.to_s, class: "form-control", disabled: true %>
        <% end %>
      </div>
    <% end %>

    <div class="col-md-6">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-control", required: true %>
    </div>

    <%# Row 2: Obligation type + source clause %>
    <div class="col-md-3">
      <%= f.label :obligation_type, class: "form-label" %>
      <%= f.select :obligation_type, obligation_type_options, {}, class: "form-select" %>
    </div>
    <div class="col-md-3">
      <%= f.label :source_clause, "Source clause", class: "form-label" %>
      <%= f.text_field :source_clause, class: "form-control", placeholder: "e.g. Section 4.3(b)" %>
    </div>

    <%# Row 3: Description %>
    <div class="col-12">
      <%= f.label :description, class: "form-label" %>
      <%= f.text_area :description, class: "form-control", rows: 3 %>
    </div>

    <%# Row 4: Trigger details %>
    <div class="col-md-3">
      <%= f.label :trigger_type, "Trigger", class: "form-label" %>
      <%= f.select :trigger_type, trigger_type_options, {}, class: "form-select" %>
    </div>
    <div class="col-md-5">
      <%= f.label :trigger_description, "Trigger description", class: "form-label" %>
      <%= f.text_field :trigger_description, class: "form-control", placeholder: "e.g. Within 45 days of each quarter-end" %>
    </div>
    <div class="col-md-2">
      <%= f.label :frequency_rrule, "Recurrence (RRULE)", class: "form-label" %>
      <%= f.text_field :frequency_rrule, class: "form-control", placeholder: "FREQ=QUARTERLY;INTERVAL=1" %>
    </div>
    <div class="col-md-2">
      <%= f.label :next_due_date, "Next due date", class: "form-label" %>
      <%= f.date_field :next_due_date, class: "form-control" %>
    </div>

    <%# Row 5: Ownership and reminders %>
    <div class="col-md-4">
      <%= f.label :owner_user_id, "Owner (user)", class: "form-label" %>
      <%= f.select :owner_user_id,
                   options_from_collection_for_select(current_user.entity.employees.order(:first_name), :id, :name, obligation.owner_user_id),
                   { include_blank: "None" }, class: "form-select" %>
    </div>
    <div class="col-md-3">
      <%= f.label :owner_team, "Owner (team)", class: "form-label" %>
      <%= f.select :owner_team, owner_team_options, { include_blank: "None" }, class: "form-select" %>
    </div>
    <div class="col-md-3">
      <%= f.label :reminder_days_before, "Reminder lead time (days)", class: "form-label" %>
      <%= f.number_field :reminder_days_before, class: "form-control", min: 0 %>
    </div>
    <%# MFN is only relevant for side letter obligations, not CP/CS %>
    <% unless is_cp_cs %>
      <div class="col-md-2 form-check ms-2 align-self-end">
        <%= f.check_box :mfn_relevant, class: "form-check-input" %>
        <%= f.label :mfn_relevant, "MFN relevant", class: "form-check-label" %>
      </div>
    <% end %>
  </div>

  <div class="mt-3">
    <%= f.submit "Save obligation", class: "btn btn-primary" %>
    <%= link_to "Cancel", obligation.side_letter.present? ? side_letter_path(obligation.side_letter) : side_letter_obligations_path,
                class: "btn btn-outline-secondary" %>
  </div>
<% end %>
