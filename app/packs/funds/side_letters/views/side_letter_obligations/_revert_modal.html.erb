<%# Revert-waive confirmation popup (Request Updates pattern). Locals: obligation %>
<div class="modal fade" id="revert_obligation_modal_<%= obligation.id %>" tabindex="-1"
     aria-labelledby="revertObligationModalLabel_<%= obligation.id %>" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="revertObligationModalLabel_<%= obligation.id %>">
          Revert Waive — <%= obligation.title %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: revert_side_letter_obligation_path(obligation), method: :patch, data: { turbo: false } do |f| %>
        <div class="modal-body">
          <div class="border-start border-4 border-primary ps-3 py-1 mb-3">
            <div class="fw-bold text-dark small">Immediate Actions</div>
            <div class="text-muted small">The following will happen when you click <strong>Revert to Active</strong>:</div>
          </div>

          <div class="d-flex flex-column gap-2 mb-3">
            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#f0fdf4;">
              <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:36px;height:36px;background:#dcfce7;">
                <i class="ti ti-arrow-back-up fs-5" style="color:#16a34a;"></i>
              </span>
              <div>
                <div class="fw-semibold text-dark lh-sm">Obligation returns to <span class="badge bg-success">Active</span></div>
                <div class="text-muted small mt-1">The waive is undone — the obligation is tracked again as if it was never ended.</div>
              </div>
            </div>

            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#eff6ff;">
              <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:36px;height:36px;background:#dbeafe;">
                <i class="ti ti-checklist fs-5" style="color:#2563eb;"></i>
              </span>
              <div>
                <div class="fw-semibold text-dark lh-sm">Tasks are re-created</div>
                <div class="text-muted small mt-1">
                  Recurring obligations get a fresh schedule generating future occurrences;
                  dated obligations get their task back. Alerts resume with them.
                </div>
              </div>
            </div>

            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fffbeb;">
              <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:36px;height:36px;background:#fef3c7;">
                <i class="ti ti-file-check fs-5" style="color:#d97706;"></i>
              </span>
              <div>
                <div class="fw-semibold text-dark lh-sm">History unchanged</div>
                <div class="text-muted small mt-1">Past fulfillments and completed tasks were preserved by the waive and stay as they are.</div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Revert to Active", class: "btn btn-outline-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
