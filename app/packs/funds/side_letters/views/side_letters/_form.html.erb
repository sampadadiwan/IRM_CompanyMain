<%# Locals: side_letter. The document dropdown offers only the commitment's own
    documents — a side letter PDF must live on the commitment it governs. %>
<%= form_with model: side_letter do |f| %>
  <% if side_letter.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% side_letter.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-4">
      <%= f.label :capital_commitment_id, "Commitment", class: "form-label" %>
      <%= f.collection_select :capital_commitment_id,
                              CapitalCommitment.where(entity_id: current_user.entity_id).includes(:investor).order(:investor_name),
                              :id, :investor_name, { include_blank: "Select commitment" },
                              class: "form-select", required: true %>
    </div>
    <div class="col-md-4">
      <%= f.label :document_id, "Side letter document", class: "form-label" %>
      <%= f.collection_select :document_id,
                              side_letter.capital_commitment&.documents&.order(:name) || Document.none,
                              :id, :name, { include_blank: "Select document" },
                              class: "form-select", required: true %>
      <div class="form-text">Upload the PDF to the commitment first, then pick it here.</div>
    </div>
    <div class="col-md-4">
      <%= f.label :executed_at, "Executed on", class: "form-label" %>
      <%= f.date_field :executed_at, class: "form-control" %>
    </div>
    <div class="col-12">
      <%= f.label :notes, class: "form-label" %>
      <%= f.text_area :notes, class: "form-control", rows: 3 %>
    </div>
  </div>

  <div class="mt-3">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", side_letters_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
