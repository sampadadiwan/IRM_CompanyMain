<% capital_call ||= nil %>
<% if params[:q].present? || capital_call.present? %>
  <div class="btn-group">
    <% if capital_call.present? %>
      <% if capital_call.approved?%>
        <%= link_to bulk_verify_modal_capital_remittances_path(capital_call_id: capital_call.id),
                    id: "capital_remittances_bulk_verify_btn", class: "btn btn-outline-primary",
                    data: { turbo_frame: "remote_modal" } do %>
          <i class="ti ti-checks"></i> Verify Pending Remittances
        <% end %>
      <% end %>
    <% else %>
      <div class="dropdown">
        <button class="btn btn-outline-primary dropdown-toggle" type="button" id="doc_actions"
                  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          Bulk Actions
        </button>
        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
          <% msg = "This will verify each remittance in the search results (including results on other pages). Proceed?" %>
          <%= button_to "Toggle Verify",
              bulk_actions_capital_remittances_path("bulk_action": "Verify", params: params.to_unsafe_h),
              class: "dropdown-item",
              data: {msg:, action: "click->confirm#popup", method: :post} %>
          <%# Self-service reset of the Call Notice "Notification Sent" flag (user guide, Question 3).
              Two idempotent actions rather than a toggle so a mixed selection can't silently flip
              never-notified investors to "sent" and hide them from the next Send Notification. %>
          <% unsent_msg = "This will mark every remittance in the search results (including results on other pages) as NOT having received the Call Notice, so the next call-level Send Notification includes them again. Use this after a correction or a bounced email. Proceed?" %>
          <%= button_to "Mark Notification Unsent",
              bulk_actions_capital_remittances_path("bulk_action": "Mark Notification Unsent", params: params.to_unsafe_h),
              class: "dropdown-item",
              data: {msg: unsent_msg, action: "click->confirm#popup", method: :post}  %>
          <% sent_msg = "This will mark every remittance in the search results (including results on other pages) as having already received the Call Notice, so the call-level Send Notification skips them. Use this for investors notified outside the system. Proceed?" %>
          <%= button_to "Mark Notification Sent",
              bulk_actions_capital_remittances_path("bulk_action": "Mark Notification Sent", params: params.to_unsafe_h),
              class: "dropdown-item",
              data: {msg: sent_msg, action: "click->confirm#popup", method: :post}  %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Placed outside .btn-group — inside it, this empty frame was a sibling after the
      trigger link, so Bootstrap's :last-child button-group CSS squared off the link's
      right corner. Fetched fresh from the server on every click of the trigger above
      (see #bulk_verify_modal), so the modal always reflects the current
      unverified/eligible state instead of whatever was baked into the page at the last
      full load. %>
  <%= turbo_frame_tag "remote_modal" if capital_call.present? %>
<% end %>
