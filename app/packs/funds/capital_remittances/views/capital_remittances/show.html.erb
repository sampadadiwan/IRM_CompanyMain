
<div class="container-fluid p-3">
    <%= render "/capital_remittances/show", capital_remittance: @capital_remittance %>


    <div>
        <%= link_to  t_common(:edit), edit_capital_remittance_path(@capital_remittance), {class: "btn btn-outline-primary ti ti-edit" } if policy(@capital_remittance).update? %>

        <%= button_to t_common(:delete), @capital_remittance, method: :delete, class: "btn btn-outline-danger ti ti-trash", form_class: "deleteButton", data: {action: "click->confirm#popup", turbo:false} if policy(@capital_remittance).destroy?  %>

        <% unless current_user.curr_role_investor? %>
        <div class="btn-group">
            <div class="dropdown">
                <button class="btn btn-outline-success dropdown-toggle ti ti-settings" type="button"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Actions
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">

                    <%
                        # Verifying (not unverifying) is blocked once the call is unapproved and nothing has
                        # been collected yet — see CapitalRemittance#verified_requires_approval_or_collection.
                        verify_blocked = !@capital_remittance.verified && !@capital_remittance.capital_call.approved? && !@capital_remittance.collected_amount_cents.positive?
                        label = @capital_remittance.verified ? "Unverify" : "Verify"
                        verified_icon = @capital_remittance.verified ? "ti ti-x" : "ti ti-check"
                    %>
                    <% if policy(@capital_remittance).verify? && verify_blocked %>
                      <span class="dropdown-item disabled text-muted" aria-disabled="true"
                            data-bs-toggle="tooltip" data-bs-container="body"
                            data-bs-title="Cannot verify: the call is not approved and no amount has been collected for this remittance yet.">
                        <i class="<%= verified_icon %>"></i><%= label %>
                      </span>
                    <% elsif policy(@capital_remittance).verify? %>
                      <%
                        if @capital_remittance.verified
                          msg = "Mark as Unverified?"
                        else
                          payment_notification_reasons = @capital_remittance.payment_notification_blocked_reasons
                          notif_msg = if payment_notification_reasons.empty?
                            "This will confirm the payment amount as recorded and send a notification for the collected amount to the investor. Please preview the notification before sending it."
                          else
                            "This will confirm the payment amount as recorded but NOT send a notification to the investor because #{payment_notification_reasons.join(', ')}."
                          end
                          due = @capital_remittance.due_amount
                          amount_msg = if due.positive?
                            "The collected amount is less than the call amount. Are you sure you want to verify the remittance?"
                          elsif due.negative?
                            "The collected amount is more than the call amount. Are you sure you want to verify the remittance?"
                          end
                          # Only relevant when a notification will actually be attempted
                          sandbox_msg = if payment_notification_reasons.empty? && @capital_remittance.entity.entity_setting&.sandbox
                            "<span class=\"text-warning\"><i class=\"ti ti-alert-triangle\"></i> Sandbox is enabled, so the notification will go to the sandbox email IDs and NOT to the investor.</span>"
                          end
                          # DefaultUnitAllocationEngine only allocates units for verified remittances
                          unit_msg = "Once verified, this remittance becomes eligible for fund unit allocation." if @capital_remittance.capital_call.unit_prices.present?
                          msg = [notif_msg, amount_msg, unit_msg].compact.map { |m| "<p>#{m}</p>" }.join
                          msg += "<p>#{sandbox_msg}</p>" if sandbox_msg
                        end
                      %>
                      <%= button_to label, verify_capital_remittance_path(@capital_remittance), method: :patch,
                          class: "dropdown-item ti #{verified_icon}", form_class: "deleteButton",
                          data: {action: "click->confirm#popup", msg: msg, turbo:false, method: :patch} %>
                    <% end %>

                    <%= button_to "Allocate Fund Units" ,
                        allocate_units_capital_remittance_path(@capital_remittance),
                        method: :patch, class: "dropdown-item ti ti-box-multiple",
                        form_class: "deleteButton", data: {action: "click->confirm#popup", method: :post, msg: "This will allocate fund units for this remittance. Proceed?"} if policy(@capital_remittance).allocate_units? %>


                    <%= button_to "Generate Documents" ,
                        generate_docs_capital_remittance_path(@capital_remittance),
                        method: :patch, class: "dropdown-item ti ti-file-type-doc",
                        form_class: "deleteButton", data: {action: "click->confirm#popup", method: :patch, msg: "This will generate the drawdown notice for this remittance. Proceed?"} if policy(@capital_remittance).generate_docs? %>

                    <% if policy(@capital_remittance).send_notification? %>
                      <% label = @capital_remittance.notification_sent ? "Send Call Reminder" : "Send Call Notification" %>
                      <% blocked_reasons = @capital_remittance.notification_blocked_reasons %>

                      <% if blocked_reasons.any? %>
                        <span class="dropdown-item disabled text-muted" aria-disabled="true"
                              data-bs-toggle="tooltip" data-bs-container="body"
                              data-bs-title="Cannot send: <%= blocked_reasons.join(', ') %>.">
                          <i class="ti ti-mail"></i><%= label %>
                        </span>
                      <% else %>
                        <%# Hidden static confirm message shown below any validation rule messages %>
                        <div id="remittance_send_notification_confirm_msg" class="d-none">
                          <p style="font-size:0.875rem;margin-bottom:0.5rem">
                            This will send an email notification to the investor for this remittance.
                          </p>
                          <%= render "shared/sandbox_notice", entity: @capital_remittance.entity %>
                          <div class="d-flex gap-2 flex-wrap">
                            <%= link_to "Update Call", edit_capital_call_path(@capital_remittance.capital_call), class: "badge bg-primary-subtle text-primary", target: "_blank" %>
                          </div>
                        </div>

                        <%# Runs CapitalRemittance-scoped validation rules (notice generated/approved) before sending %>
                        <div data-controller="rule-validation"
                             data-rule-validation-target-model-value="CapitalRemittance"
                             data-rule-validation-record-id-value="<%= @capital_remittance.id %>"
                             data-rule-validation-evaluate-url-value="<%= evaluate_validation_rules_path %>"
                             data-rule-validation-confirm-message-selector-value="#remittance_send_notification_confirm_msg">
                          <%= button_to label, send_notification_capital_remittance_path(@capital_remittance), method: :patch,
                              class: "dropdown-item ti ti-mail", form_class: "deleteButton",
                              data: {turbo: false, method: :patch} %>
                        </div>
                      <% end %>
                    <% end %>


                    <% adjustment_params = {commitment_adjustment: {capital_commitment_id: @capital_remittance.capital_commitment_id, owner_id: @capital_remittance.id, owner_type: "CapitalRemittance", folio_amount: @capital_remittance.folio_due_amount, adjustment_type: "Arrear", reason: "Arreas from Remittance #{@capital_remittance.id}"}} %>
                    <%= link_to "Create Arrears Adjustment", new_commitment_adjustment_path(adjustment_params), class: "dropdown-item ti ti-edit" if policy(@capital_remittance).update? %>
                </div>
            </div>
        </div>
        <% end %>
    </div>
</div>


  <%= render "/capital_remittances/details", capital_remittance: @capital_remittance %>