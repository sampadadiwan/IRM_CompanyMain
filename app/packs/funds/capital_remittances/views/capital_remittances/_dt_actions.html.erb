<% if capital_remittance.entity_id == current_user.entity_id %>
  <div class="btn-group" data-controller="tooltip">
    <div class="dropdown">
      <button class="btn btn-outline-primary dropdown-toggle" type="button"
              data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <i class="ti ti-settings"></i> <%= t_common(:actions) %>
      </button>
      <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">

        <% details_label = "Show details for Capital Commitment #{capital_remittance.capital_commitment_id}" %>
        <%= link_to capital_remittance_path(capital_remittance), class: "dropdown-item", title: details_label, aria: { label: details_label }, data: { bs_toggle: "tooltip", bs_container: "body", bs_title: details_label } do %>
          <i class="ti ti-eye"></i> <%= t_common(:view) %>
        <% end %>

        <%= link_to new_capital_remittance_payment_path("capital_remittance_payment[capital_remittance_id]": capital_remittance.id),
                    class: "dropdown-item", data: {bs_toggle: "tooltip", bs_container: "body", bs_title: "Add payment(s) received"} do %>
          <i class="ti ti-cash"></i>New Payment
        <% end %>

        <% if policy(capital_remittance).verify? %>
          <%
            object = capital_remittance.respond_to?(:object) ? capital_remittance.object : capital_remittance
            label = object.verified ? "Unverify" : "Verify"
            # Verifying (not unverifying) requires the call to be approved —
            # see CapitalRemittance#verified_requires_approval.
            verify_blocked = !object.verified && !object.capital_call.approved?
            no_payment_blocked = !object.verified && !verify_blocked && object.no_payment_received?
            icon_class = object.verified ? "ti ti-user-x" : "ti ti-user-check"
          %>

          <% if verify_blocked %>
            <%# pointer-events: auto overrides Bootstrap's .disabled rule (pointer-events: none),
                which would otherwise silently block the hover that triggers the tooltip. %>
            <span class="dropdown-item disabled text-muted" aria-disabled="true" style="pointer-events: auto;"
                  data-bs-toggle="tooltip" data-bs-container="body"
                  data-bs-title="Cannot verify: the call is not approved.">
              <i class="<%= icon_class %>"></i><%= label %>
            </span>
          <% elsif no_payment_blocked %>
            <span class="dropdown-item disabled text-muted" aria-disabled="true" style="pointer-events: auto;"
                  data-bs-toggle="tooltip" data-bs-container="body"
                  data-bs-title="Cannot verify: no payment has been received.">
              <i class="<%= icon_class %>"></i><%= label %>
            </span>
          <% else %>
            <%
              if object.verified
                msg = "Mark as Unverified?"
              else
                payment_notification_reasons = object.payment_notification_blocked_reasons
                notif_msg = if payment_notification_reasons.empty?
                  "This will confirm the payment amount as recorded and send a notification for the collected amount to the investor. Please preview the notification before sending it."
                else
                  "This will confirm the payment amount as recorded but NOT send a notification to the investor because #{payment_notification_reasons.join(', ')}."
                end
                due = object.due_amount
                amount_msg = if due.positive?
                  "The collected amount is less than the call amount. Are you sure you want to verify the remittance?"
                elsif due.negative?
                  "The collected amount is more than the call amount. Are you sure you want to verify the remittance?"
                end
                # Only relevant when a notification will actually be attempted
                sandbox_msg = if payment_notification_reasons.empty? && object.entity.entity_setting&.sandbox
                  "<span class=\"text-warning\"><i class=\"ti ti-alert-triangle\"></i> Sandbox is enabled, so the notification will go to the sandbox email IDs and NOT to the investor.</span>"
                end
                # DefaultUnitAllocationEngine only allocates units for verified remittances
                unit_msg = "Once verified, this remittance becomes eligible for fund unit allocation." if object.capital_call.unit_prices.present?
                msg = [notif_msg, amount_msg, unit_msg].compact.map { |m| "<p>#{m}</p>" }.join
                msg += "<p>#{sandbox_msg}</p>" if sandbox_msg
              end
              bs_title = object.verified ? "Unverify the remittance." : "Confirms the payment amount recorded and send payment confirmations notification (if enabled)."
              notification = object.verified ? "no" : "yes"
            %>

            <%= button_to verify_capital_remittance_path(capital_remittance, for_commitment: params[:for_commitment]),
                          method: :patch, class: "dropdown-item", form_class: "deleteButton",
                          data: { action: "click->confirm#popup", msg:, notification:, bs_toggle: "tooltip", bs_container: "body", bs_title: , turbo: true, method: :patch } do %>
              <i class="<%= icon_class %>"></i><%= label %>
            <% end %>
          <% end %>
        <% end %>

        <% if policy(capital_remittance).preview? %>

          <div class="dropdown-divider"></div>

          <%= link_to "Preview Notification", preview_capital_remittance_path(capital_remittance.id, email_method: "notify_capital_remittance"), target: "_blank", class: "dropdown-item ti ti-mail" %>

          <%= link_to "Preview Reminder", preview_capital_remittance_path(capital_remittance.id, email_method: "reminder_capital_remittance"), target: "_blank", class: "dropdown-item ti ti-mail" %>

          <% if capital_remittance.capital_remittance_payments.any? %>
            <%= link_to "Preview Payment Notification", preview_capital_remittance_payment_path(capital_remittance.capital_remittance_payments.first, email_method: "notify_capital_remittance_payment"), target: "_blank", class: "dropdown-item ti ti-mail" %>
          <% end %>

        <% end %>
      </div>
    </div>

  </div>
<% else %>
  <% details_label = "Show details for Capital Commitment #{capital_remittance.capital_commitment_id}" %>
  <%= link_to capital_remittance_path(capital_remittance), class: "btn btn-outline-primary d-inline-flex align-items-center", title: details_label, aria: { label: details_label }, data: { bs_toggle: "tooltip", bs_container: "body", bs_title: details_label } do %>
    <i class="ti ti-eye"></i> <%= t_common(:view) %>
  <% end %>
<% end %>
