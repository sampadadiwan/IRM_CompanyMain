<div class="card shadow mb-4">
  <div class="card-header py-3">
      <h6 class="m-0 font-weight-bold text-primary">
          Remittance Payment : <%= capital_remittance_payment.capital_remittance&.investor&.investor_name %>
      </h6>
  </div>
  <div class="card-body">
    <%= form_with(model: capital_remittance_payment, validate: true) do |form| %>
      <% if capital_remittance_payment.errors.any? %>
        <div class="alert alert-danger">
          <h2><%= pluralize(capital_remittance_payment.errors.count, "error") %> prohibited this capital_remittance_payment from being saved:</h2>

          <ul>
            <% capital_remittance_payment.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form.text_field :fund_id, class: "form-control", hidden: true  %>
      <%= form.text_field :capital_remittance_id, class: "form-control", hidden: true  %>
      <%= form.text_field :entity_id, class: "form-control", hidden: true  %>

      <%# What the operator is expected to enter, in the same folio currency as the Amount field
          below. Without it the amount is typed blind off the bank advice and a wrong figure only
          surfaces later - at Verify, as the "collected amount is less/more than the call amount"
          warning, or silently as an Overpaid remittance (CapitalRemittance#set_status). %>
      <%
        remittance = capital_remittance_payment.capital_remittance
        folio_currency = remittance.capital_commitment.folio_currency
        # Total callable on this remittance, fees included - the first two terms of
        # CapitalRemittance#folio_due_amount.
        folio_called = remittance.folio_call_amount + remittance.folio_other_fee
        # folio_collected_amount is a counter_culture column, so on an edit it already includes
        # this payment's last SAVED value. Take that back out: "already received" means every
        # payment except the one being recorded here. _in_database (not folio_amount) so that a
        # re-render after a validation error shows the saved figure, not the rejected input.
        own_saved_cents = capital_remittance_payment.persisted? ? capital_remittance_payment.folio_amount_cents_in_database : 0
        folio_received = remittance.folio_collected_amount - Money.new(own_saved_cents, folio_currency)
        folio_to_receive = folio_called - folio_received
      %>
      <ul class="list-group list-group-flush border rounded mb-3">
        <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
          <span class="text-muted">Call Amount (incl. fees)</span>
          <span><%= money_to_currency folio_called, params %></span>
        </li>

        <%# Only worth a line when some other payment has already been recorded against this remittance %>
        <% unless folio_received.zero? %>
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span class="text-muted">Already Received</span>
            <span><%= money_to_currency folio_received, params %></span>
          </li>
        <% end %>

        <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
          <span class="text-muted">To Be Received</span>
          <span class="fw-bold"><%= money_to_currency folio_to_receive, params %></span>
        </li>
      </ul>

      <% disabled = !capital_remittance_payment.convert_to_fund_currency %>
      <div class="form-group" data-controller="currencyformat">
        <%= form.label :folio_amount, "Amount in #{capital_remittance_payment.capital_remittance.capital_commitment.folio_currency}" %> <span class="formatted_currency"></span>
        <%= form.number_field :folio_amount, class: "form-control", disabled: disabled, data: {action: "input->currencyformat#format"} %>
        <small class="text-muted"> Ensure this number is in <%= capital_remittance_payment.capital_remittance.capital_commitment.folio_currency %>. </small>
      </div>

      <div class="form-group">
        <%= form.label :payment_date %>
        <%= form.date_field :payment_date, class: "form-control"  %>
      </div>

      <%= custom_form_fields(capital_remittance_payment, form) %>

      <div class="form-group">

        <%= render "layouts/single_upload", form: form, field_label: "Upload payment proof",
                                for_model: "capital_remittance_payment", field_name: "payment_proof",
                                model: capital_remittance_payment %>
        <small class="text-muted"> Upload proof of payment as per the instructions. </small>
      </div>


      <div class="form-group">
        <%= form.label :reference_no %>
        <%= form.text_field :reference_no, class: "form-control"  %>
      </div>

      <div class="form-group">
        <%= form.label :payment_notification_sent %>
        <%= form.check_box :payment_notification_sent, class: "form-check-input" %>
        <small class="text-muted"> Check this box if the payment notification has already been sent to the investor.<br>Only unchecked ones will receive a notification. </small>
      </div>


      <div class="form-group">
        <%= form.label :notes %>
        <%= form.text_area :notes, class: "form-control"  %>
      </div>



      <div class="form-group">
        <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
      </div>
    <% end %>
  </div>
</div>
