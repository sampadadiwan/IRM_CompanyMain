<%# open-ended-funds § Notifications: order journey not finished a few days before the cut-off %>
<% if @custom_notification %>
  <%= render "/custom_notifications/mail" do %>
    <%= render "evergreen_mailer/custom_extras" %>
  <% end %>
<% else %>
  <p>Dear <%= @user&.first_name %>,</p>
  <p>Your request still needs: <strong><%= OrderJourneyStatus.waiting_on(@order) %></strong>.
    Please complete it by <strong><%= l(@order.dealing_date.cutoff_at.to_date) %></strong> so it is dealt on <%= l(@order.dealing_date.date) %>.
    Otherwise it <%= @setting.unready_handling == "cancel" ? "will be cancelled" : "will move to the next #{EvergreenLabels.lower(eg_t(@order.subscription? ? :subscription_date : :redemption_date))}" %>.</p>
  <%= render "evergreen_mailer/summary" %>
  <%= render "evergreen_mailer/request_link" %>
<% end %>
