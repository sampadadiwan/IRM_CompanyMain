<%# Portfolio › Corporate actions — openspec/changes/fund-market-data, design card ② (H10, E46) %>
<%= render ReportingComponent.new do %>
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Corporate actions</h1>
    <div>
      <% %w[pending confirmed dismissed].each do |st| %>
        <%= link_to st.capitalize, corporate_action_suggestions_path(status: st), class: "btn btn-sm #{@status == st ? 'btn-primary' : 'btn-outline-secondary'}" %>
      <% end %>
    </div>
  </div>
  <%= render "corporate_action_suggestions/table", suggestions: @suggestions, empty_text: "No #{@status} corporate actions." %>
<% end %>
