
<%= render "/capital_calls/capital_call_stats", capital_call: @capital_call %>

<div class="container-fluid p-3">
<%= render "/capital_calls/show", capital_call: @capital_call %>

<div id="capital_call_<%= @capital_call.id %>_actions"
     data-controller="workflow-gate"
     data-workflow-gate-labels-value="<%= (@workflow_gated_button_labels || []).to_json %>"
     data-workflow-gate-reason-value="<%= @workflow_gate_status_label.present? ? "Blocked — workflow is #{@workflow_gate_status_label}" : '' %>">

  <% if policy(@capital_call).update? %>
    <%= link_to edit_capital_call_path(@capital_call), id: "capital_call_edit_btn", class: "btn btn-outline-primary", data: { workflow_gate_label: "Edit" } do %>
      <i class="ti ti-edit"></i> <%= t_common(:edit) %>
    <% end %>

    <%= button_to @capital_call, id: "capital_call_delete_btn", method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton",
        data: {action: "click->confirm#popup", turbo: false, workflow_gate_label: "Delete"} do %>
      <i class="ti ti-trash"></i> <%= t_common(:delete) %>
    <% end %>
  <% end %>

  <div class="btn-group">
    <div class="dropdown">
      <button class="btn btn-outline-success dropdown-toggle" type="button"
              data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <i class="ti ti-settings"></i> <%= t_common(:actions) %>
      </button>
      <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">

        <% generated_docs_path = documents_path(no_folders: true, filter: true, q: ransack_query_params_multiple([[:capital_call_id, :eq, @capital_call.id], [:owner_tag, :cont, "Generated"]])) %>

        <% if policy(@capital_call).generate_docs? %>
          <%= button_to generate_docs_capital_call_path(@capital_call), id: "capital_call_generate_docs_btn", method: :patch, class: "dropdown-item ti ti-file-plus", form_class: "deleteButton",
              data: {action: "click->confirm#popup", method: :patch, notification: "no",  bs_toggle: "tooltip", bs_title: "This will generate the drawdown notices for all remittances in this call based on the call notice template.",
                     msg: "This will generate the drawdown notices for all remittances in this call. Proceed?", workflow_gate_label: "Generate Documents"} do %>
            Generate Documents
          <% end %>


          <%= link_to "View Generated Documents", generated_docs_path, id: "capital_call_view_generate_docs_btn", class: "dropdown-item ti ti-search", data: { bs_toggle: "tooltip", bs_title: "Review and approve the generated call notices for attaching to Call Notification" } %>

          <div class="dropdown-divider"></div>
        <% end %>


        <% if policy(@capital_call).approve? %>
          <%# Hidden element whose innerHTML the rule-validation controller reads as the confirm message.
              Shown in the modal when no rules fire (so the user still sees the confirmation context
              before proceeding) and above warning items when warnings fire. %>
          <div id="capital_call_approve_confirm_msg" class="d-none">
            <p style="font-size:0.875rem;margin-bottom:0.5rem">
              This will approve the capital call. No notification is sent to investors yet — use
              "Send Notification" afterwards once you're ready to notify them.
            </p>
            <div class="d-flex gap-2 flex-wrap">
              <%= link_to "View Generated Call Notices",
                    documents_path(no_folders: true, filter: true,
                      q: ransack_query_params_multiple([[:capital_call_id, :eq, @capital_call.id],
                                                        [:owner_tag, :cont, "Generated"]])),
                    class: "badge bg-primary-subtle text-primary", target: "_blank" %>

              <%= link_to "Update Call", edit_capital_call_path(@capital_call), class: "badge bg-primary-subtle text-primary", target: "_blank" %>
            </div>
          </div>

          <%# Wrap in rule-validation controller so the modal fires BEFORE the form reaches the server.
              confirmMessageSelector points at the hidden div above; its HTML appears in the modal
              whether rules fire (shown above warnings) or not (shown as the sole confirmation step). %>
          <div data-controller="rule-validation"
               data-rule-validation-target-model-value="CapitalCall"
               data-rule-validation-record-id-value="<%= @capital_call.id %>"
               data-rule-validation-evaluate-url-value="<%= evaluate_validation_rules_path %>"
               data-rule-validation-confirm-message-selector-value="#capital_call_approve_confirm_msg">
            <%= button_to approve_capital_call_path(@capital_call), id: "capital_call_approve_btn", method: :post, class: "dropdown-item ti ti-check", form_class: "deleteButton",
                data: {turbo: false, bs_toggle: "tooltip", bs_title: "Approve call. No notification would be sent to investors.", workflow_gate_label: "Approve"} do %>
              Approve
            <% end %>
          </div>

          <div class="dropdown-divider"></div>
        <% end %>

        <% if policy(@capital_call).unapprove? %>
          <%
            msg = "This will revert the capital call to unapproved. It can be approved again later."
            msg += " Note: some remittances have already been notified — reverting will not un-notify investors." if @capital_call.any_remittance_notified?
            msg += " Note: fund units have already been allocated for remittances under this call — reverting will not undo that allocation." if @capital_call.fund_units.exists?
          %>
          <%= button_to unapprove_capital_call_path(@capital_call), id: "capital_call_unapprove_btn", method: :patch, class: "dropdown-item ti ti-x", form_class: "deleteButton",
              data: {action: "click->confirm#popup", turbo: false, method: :patch, notification: "no", msg:,
                     bs_toggle: "tooltip", bs_container: "body", bs_title: "Revert this call to unapproved.", workflow_gate_label: "Unapprove"} do %>
            Unapprove
          <% end %>

          <div class="dropdown-divider"></div>
        <% end %>

        <% if policy(@capital_call).notify? %>
          <%# Hidden element whose innerHTML the rule-validation controller shows first,
              above rule warnings when they fire, at the top of the confirm body otherwise. %>
          <% unless @capital_call.send_call_notice_flag %>
            <div id="capital_call_notify_banner" class="d-none">
              <p class="text-danger" style="font-size:0.875rem;margin-bottom:0.5rem">
                This will NOT send any notification to your investors as the call is setup to not send notifications.
              </p>
            </div>
          <% end %>

          <%# Hidden element whose innerHTML the rule-validation controller reads as the confirm message. %>
          <div id="capital_call_notify_confirm_msg" class="d-none">
            <% if @capital_call.send_call_notice_flag %>
              <p style="font-size:0.875rem;margin-bottom:0.5rem">
                This will send a notification to your investors and attached Approved call notices.
                Investors already notified will not be emailed again.
              </p>
              <%
                # Mirrors CapitalCallJob#notify's per-remittance skip_doc_gen? gate — those
                # remittances are silently skipped by the job itself, so call it out here
                # rather than leaving the user to wonder why an investor was never emailed.
                skip_doc_gen_count = @capital_call.capital_remittances.includes(:capital_commitment).count { |cr| cr.capital_commitment&.skip_doc_gen? }
              %>
              <% if skip_doc_gen_count.positive? %>
                <p class="text-danger" style="font-size:0.875rem;margin-bottom:0.5rem">
                  <i class="ti ti-alert-triangle"></i>
                  <%= pluralize(skip_doc_gen_count, "remittance") %> will NOT be notified because its commitment has 'Skip Doc Gen' set to Yes.
                </p>
              <% end %>
            <% end %>
            <p class="text-danger" style="font-size:0.875rem;margin-bottom:0.5rem">
              <i class="ti ti-alert-triangle"></i>
              This notification will go to all the remittances that have not been sent a notification yet.
            </p>
            <%= render "shared/sandbox_notice", entity: @capital_call.entity, color_class: "text-danger" %>
            <div class="d-flex gap-2 flex-wrap">
              <% if @capital_call.send_call_notice_flag %>
                <%= link_to "View Who Gets Notified",
                      show_email_list_fund_path(@capital_call.fund, capital_call_id: @capital_call.id),
                      class: "badge bg-primary-subtle text-primary", target: "_blank" %>
              <% end %>
              <%= link_to "View Generated Call Notices",
                    documents_path(no_folders: true, filter: true,
                      q: ransack_query_params_multiple([[:capital_call_id, :eq, @capital_call.id],
                                                        [:owner_tag, :cont, "Generated"]])),
                    class: "badge bg-primary-subtle text-primary", target: "_blank" %>

              <%= link_to "Update Call", edit_capital_call_path(@capital_call), class: "badge bg-primary-subtle text-primary", target: "_blank" %>
            </div>
          </div>

          <div data-controller="rule-validation"
               data-rule-validation-target-model-value="CapitalCall"
               data-rule-validation-record-id-value="<%= @capital_call.id %>"
               data-rule-validation-evaluate-url-value="<%= evaluate_validation_rules_path %>"
               data-rule-validation-confirm-title-value="Confirm – Send Notification"
               data-rule-validation-confirm-message-selector-value="#capital_call_notify_confirm_msg"
               data-rule-validation-banner-message-selector-value="#capital_call_notify_banner">
            <%= button_to notify_capital_call_path(@capital_call), id: "capital_call_notify_btn", method: :post, class: "dropdown-item ti ti-mail", form_class: "deleteButton",
                disabled: !@capital_call.send_call_notice_flag,
                data: {turbo: false, bs_toggle: "tooltip", bs_title: "Send the call notification to investors.", workflow_gate_label: "Send Notification"} do %>
              Send Notification
            <% end %>
          </div>

          <div class="dropdown-divider"></div>
        <% end %>

        <% if policy(@capital_call).allocate_units? %>
          <%= button_to allocate_units_capital_call_path(@capital_call), id: "capital_call_allocate_units_btn", method: :patch, class: "dropdown-item ti ti-box-multiple", form_class: "deleteButton",
              data: {action: "click->confirm#popup", turbo: false, method: :patch, notification: "no",
                     msg: "This will compute the units to be allocated to each commitment in this fund.", workflow_gate_label: "Allocate Units"} do %>
            Allocate Units
          <% end %>
        <% end %>

        <% if policy(@capital_call).recompute_fees? %>
          <%= button_to recompute_fees_capital_call_path(@capital_call), id: "capital_call_recompute_fees_btn", method: :patch, class: "dropdown-item ti ti-calculator", form_class: "deleteButton",
              data: {action: "click->confirm#popup", turbo: false, method: :patch, notification: "no",
                     bs_toggle: "tooltip", bs_title: "Recomputes the Fees, Expenses to be added to the call amount, if applicable",
                     msg: "This will recompute the all remittances in this call. Proceed?", workflow_gate_label: "Recompute Call"} do %>
            Recompute Call
          <% end %>
        <% end %>

      </div>
    </div>
  </div>

</div>
</div>


<%= render "/capital_calls/details", capital_call: @capital_call %>
