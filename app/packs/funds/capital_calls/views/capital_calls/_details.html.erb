<%# Call Notice Agent — triggered from the Actions dropdown (show.html.erb); results are
    visible via the agent's own Execution History, so no panel is rendered here. %>

<%# Remittance Reconciliation Agent Panel %>
<% if capital_call.entity.support_agents.set?(:capital_remittance_reconciliation_agent) && policy(capital_call).run_agent? %>
  <% remit_support_agent = SupportAgent.find_by(agent_type: "RemittanceReconciliationAgent", entity_id: current_user.entity_id) %>
  <% if remit_support_agent.present? %>
    <% remit_report = SupportAgentReport.find_by(owner: capital_call, support_agent: remit_support_agent, latest: true) %>
    <%# Nothing to show before the first run — that status is already visible on the agent's
        own Execution History tab, so this section stays out of the way until there's a report
        with actual deposits to review/confirm/reassign. %>
    <% if remit_report.present? %>
      <%= render "capital_calls/capital_remittance_reconciliation_panel",
          capital_call: capital_call, support_agent: remit_support_agent, report: remit_report %>
    <% end %>
  <% end %>
<% end %>

<div class="associated_entity" data-controller="tabs tabdetails">


    <nav class="nav nav-pills nav-justified p-3 mb-3 rounded align-items-center card flex-row"  role="tablist">
      <a class="nav-link active" data-bs-toggle="pill" data-bs-toggle="tab" href="#remittances-tab">Remittances</a>

      <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#custom-notification-tab">
            Notification</a>

      <% if policy(capital_call).assign_workflow? %>
        <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#workflow-tab">Workflow</a>
      <% end %>
    </nav>

    <div class="tab-content" data-controller="datatable">

        <div id="remittances-tab" class="tab-pane fade show active">
          <div id="remittances" class="associated_entity">
            <%= turbo_frame_tag "capital_remittances_frame", target: "_top", loading: :lazy, src: capital_remittances_path(capital_call_id: capital_call.id, status: "", verified: "") do %>
              <%= render "/layouts/loading" %>
            <% end %>
          </div>
        </div>

        <div id="custom-notification-tab" class="tab-pane fade">
          <div id="custom_notifications" class="associated_entity">
              <%= render "custom_notifications/index", custom_notifications: capital_call.custom_notifications,owner: capital_call %>
          </div>
        </div>

        <%# Workflow tab — company_admin only %>
        <% if policy(capital_call).assign_workflow? %>
          <div id="workflow-tab" class="tab-pane fade">
            <%= render "workflow_templates/workflow_tab", workflowable: capital_call %>
          </div>
        <% end %>

    </div>

  </div>
