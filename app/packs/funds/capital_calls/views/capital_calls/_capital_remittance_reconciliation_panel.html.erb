<%# frozen_string_literal: true %>
<%#
  Reconciliation results for the latest RemittanceReconciliationAgent report on this call,
  rendered inside the capital call's Reconciliation tab (_details.html.erb) as ONE table —
  every deposit on the statement is a row, in statement order, tagged with its outcome and
  carrying its own actions (Confirm / Reassign / Undo). The run trigger lives in the Actions
  dropdown (show.html.erb).
  Required locals: capital_call, report
  support_agent is accepted but currently unused — kept so callers don't need to special-case this partial.
%>

<% deposits = report.json_fields["deposits"] || [] %>
<% tier_counts = report.json_fields["tier_counts"] || {} %>
<% last_run = report.json_fields["run_at"] %>
<% can_undo = policy(capital_call).undo_reconciliation_deposit? %>
<%# Matched (tier "exact") rows still awaiting confirmation — what "Confirm all Matched" will record. %>
<% pending_exact = deposits.select { |d| d["tier"] == "exact" && d["payment_status"].blank? && d["matched_remittance_id"].present? } %>
<% pending_partial_count = pending_exact.count { |d| d["amount_status"] == "partial" } %>
<%# Reassign choices: every remittance under THIS call, as [folio, investor] pairs. One cheap
    query (both are columns on capital_remittances — no joins), rendered ONCE as a shared
    <datalist> that every row's input points at, so a call with 200 remittances and 50 deposit
    rows costs 200 <option>s, not 10,000. The input is a native searchable dropdown: typing
    matches on folio or investor name and submits the folio, which the controller resolves. %>
<% reassign_choices = capital_call.capital_remittances.order(:investor_name).pluck(:folio_id, :investor_name) %>
<%# Folio per matched remittance, one query, so the investor cell can name the folio and link
    to the remittance (a matched deposit is only ever tied to a remittance of THIS call). %>
<% matched_folios = CapitalRemittance.where(id: deposits.filter_map { |d| d["matched_remittance_id"] }.uniq).pluck(:id, :folio_id).to_h %>

<%# Tag label, theme badge classes and a plain-language tooltip per json value — the same
    solid bg-* utilities every other badge in the app uses, so every tag is readable without a
    bespoke palette. The tooltip says what the tag means: "Exact" is about WHO paid (identity),
    the amount tags are about HOW MUCH — a row can legitimately be Exact and Partial at once.
    Anything unexpected falls back to the raw value on a neutral badge so a new status is
    never hidden. %>
<% tier_tags = {
     "exact" => ["Matched", "bg-success",
                 "Identity is certain: the sender's account number matches this investor's KYC bank account or assigned virtual account, and no other remittance on this call could be the one. Says nothing about how much arrived — see the amount tag."],
     "probable" => ["Likely match", "bg-warning text-dark",
                    "Identity by name only: the narration carries no sender account, so the match rests on name similarity. Proposed for you to confirm, never recorded automatically."],
     "needs_review" => ["Needs review", "bg-danger",
                        "Something contradicts or is ambiguous — a sender account that differs from the investor's KYC account, an overpayment, or more than one remittance the deposit could belong to. Read the reason under the tags before confirming."],
     "no_match" => ["No match", "bg-secondary",
                    "No remittance on this call matches the depositor. Use Reassign to pick the investor or folio it belongs to."],
     "internal" => ["Internal", "bg-light text-muted",
                    "The fund's own money moving (fixed deposit maturity, loan credit), not an investor payment. Excluded from matching."]
   } %>
<% amount_tags = {
     "partial" => ["Partial payment", "bg-warning text-dark",
                   "Less than the amount due arrived, by more than the tolerance. Confirming records exactly what was received; the remittance keeps the shortfall as still due."],
     "overpaid" => ["Overpayment", "bg-danger",
                    "More than the amount due arrived, by more than the tolerance. The surplus may belong to one of this investor's other calls — check before confirming."],
     "unknown" => ["Amount unreadable", "bg-secondary",
                   "The statement row had no readable amount, so it could not be compared with the amount due."]
   } %>
<% funds_tags = {
     "discrepancy" => ["Not from KYC account", "bg-danger",
                       "The sender's account number is not the account registered on this investor's KYC. Funds came from somewhere else — a joint or family account, a corporate treasury, or a genuine error. Verify the source of funds before confirming."],
     "confirmed" => ["From KYC account", "bg-success",
                     "The sender's account number is the one registered on this investor's KYC — the payment came from the investor's own account."]
   } %>
<% payment_tags = {
     "created" => ["Payment recorded", "bg-primary", "A payment has been recorded for this deposit on this call. Undo removes it."],
     "already_recorded" => ["Payment recorded", "bg-primary", "A payment for this bank reference was already on this call before this run. Undo removes it."],
     "recorded_elsewhere" => ["Recorded on another call", "bg-info text-dark",
                              "A payment with this bank reference already exists on a different call of this fund. Nothing can be recorded here; undo it there first if it belongs to this call."],
     "error" => ["Payment failed", "bg-danger", "Recording the payment failed — the reason is shown under the tags."]
   } %>
<% tag_for = ->(tags, key) { tags.fetch(key, [key.to_s.humanize, "bg-secondary", nil]) } %>

<div class="remittance-reconciliation-panel mb-3" data-controller="tooltip reconciliation-filter">
  <%# Same header shape as the index pages (e.g. capital_remittances/_index): h3 title on the
      left, the page's actions on the right. %>
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Remittance Reconciliation</h1>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <% if last_run.present? %>
        <span class="text-muted">Last run <%= l(Time.zone.parse(last_run)) %></span>
      <% end %>
      <% if pending_exact.any? %>
        <button type="button" id="confirm_all_exact_btn" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#confirm-all-exact-modal">
          <i class="ti ti-checks"></i> Confirm all Matched (<%= pending_exact.size %>)
        </button>
      <% end %>
      <%# Same modal the Actions dropdown opens (rendered by show.html.erb). %>
      <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#run-remittance-reconciliation-modal">
        <i class="ti ti-file-check"></i> Run Reconciliation
      </button>
    </div>
  </div>

  <%# Same stat-card shape as investor_kycs/_stats: a row of cards, count + icon, coloured
      top border + label, one per outcome tier. Unlike that partial these don't navigate — there's
      no separate index for a single call's deposits — they filter the table below in place
      via the reconciliation-filter Stimulus controller. %>
  <% stat_cards = [
       { filter: "exact", label: "Matched", count: tier_counts["exact"] || 0, color: "success", icon: "ti ti-check" },
       { filter: "probable", label: "Likely match", count: tier_counts["probable"] || 0, color: "warning", icon: "ti ti-help" },
       { filter: "needs_review", label: "Needs review", count: tier_counts["needs_review"] || 0, color: "danger", icon: "ti ti-alert-triangle" },
       { filter: "no_match", label: "No match", count: tier_counts["no_match"] || 0, color: "secondary", icon: "ti ti-ban" },
       { filter: "internal", label: "Internal", count: tier_counts["internal"] || 0, color: "info", icon: "ti ti-building-bank" },
       { filter: "discrepancy", label: "Not from KYC account", count: report.json_fields["discrepancy_count"].to_i, color: "danger", icon: "ti ti-shield-x" }
     ] %>
  <div class="row mb-3">
    <% stat_cards.each do |card| %>
      <div class="col">
        <div class="card reconciliation-stat-card border-top stat-card-accent border-<%= card[:color] %> shadow-sm" role="button" tabindex="0"
             data-reconciliation-filter-target="card" data-filter="<%= card[:filter] %>"
             data-action="click->reconciliation-filter#toggle keydown.enter->reconciliation-filter#toggle"
             data-bs-toggle="tooltip" data-bs-title="<%= (tier_tags[card[:filter]] || funds_tags[card[:filter]])&.last %>">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <div>
                <div data-controller="counters" data-counters-value-value="<%= card[:count] %>">
                  <h3 class="fs-7" data-counters-target="output">0</h3>
                </div>
                <h6 class="card-subtitle mb-1 text-<%= card[:color] %>"><%= card[:label] %></h6>
              </div>
              <div class="ms-auto">
                <span class="text-<%= card[:color] %> display-6 number-stats-icon"><i class="<%= card[:icon] %>"></i></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if deposits.empty? %>
    <p class="text-muted">The statement had no deposit rows.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-sm align-middle reconciliation-table">
        <thead>
          <tr>
            <th>Investor</th>
            <th>Narration</th>
            <th class="text-end">Amount</th>
            <th class="text-end">Due</th>
            <th>Outcome</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody data-reconciliation-filter-target="body">
          <%# each_with_index keeps the REAL index — two content-identical rows (e.g. repeat
              fixed-amount installments from the same payer) must submit Confirm/Reassign/Undo
              against their own entry, never a value-equality lookup. %>
          <% deposits.each_with_index do |deposit, idx| %>
            <% recorded_here = deposit["payment_id"].present? %>
            <% recorded_elsewhere = deposit["payment_status"] == "recorded_elsewhere" %>
            <% internal = deposit["tier"] == "internal" %>
            <% can_confirm = !recorded_here && !recorded_elsewhere && !internal && deposit["matched_remittance_id"].present? %>
            <% can_reassign = !recorded_here && !recorded_elsewhere && !internal %>
            <% reasoning = Array(deposit["reasoning"]) %>
            <%# The one line a reviewer needs inline: why the row needs attention — a KYC
                contradiction, an amount problem, or an ambiguous identity. Everything else
                stays in the tooltip on the outcome tag. %>
            <% attention = deposit["tier"] == "needs_review" ? reasoning.find { |l| l.match?(/contradicts|overpayment|no readable amount|folios of the same investor|different investors|within .* of each other/) } : nil %>
            <tr id="reconciliation_deposit_<%= idx %>" data-reconciliation-filter-target="row"
                data-filter="<%= deposit["tier"] %>" data-discrepancy="<%= (deposit["source_of_funds"] == "discrepancy").to_s %>">
              <td>
                <% remittance_id = deposit["matched_remittance_id"] %>
                <% if remittance_id.present? && matched_folios.key?(remittance_id) %>
                  <%# Matched / Likely match / manually reassigned: name links to the remittance, in a
                      new tab so the reviewer keeps their place in this table. %>
                  <%= link_to deposit["matched_investor_name"], capital_remittance_path(remittance_id),
                              target: "_blank", rel: "noopener", class: "fw-semibold",
                              data: { bs_toggle: "tooltip", bs_title: "Open the matched remittance (folio #{matched_folios[remittance_id]}) in a new tab" } %>
                  <div class="text-muted">Folio <%= matched_folios[remittance_id] %></div>
                <% else %>
                  <span class="fw-semibold"><%= deposit["matched_investor_name"] || deposit["name"] || "(unrecognized)" %></span>
                <% end %>
                <% if deposit["account_number"].present? %>
                  <div class="text-muted">a/c <%= deposit["account_number"] %></div>
                <% end %>
                <% if deposit["source_of_funds"] == "discrepancy" && deposit["kyc_account_number"].present? %>
                  <div class="text-muted">KYC a/c <%= deposit["kyc_account_number"] %></div>
                <% end %>
              </td>
              <td>
                <div class="reconciliation-narration"><%= deposit["raw_narration"] %></div>
                <div class="text-muted"><%= deposit["sheet"] %> · row <%= deposit["row"] %></div>
              </td>
              <td class="text-end text-nowrap"><%= number_to_currency(deposit["amount"], unit: "") %></td>
              <td class="text-end text-nowrap"><%= deposit["due_amount"] ? number_to_currency(deposit["due_amount"], unit: "") : "—" %></td>
              <td>
                <div class="d-flex flex-wrap gap-1">
                  <% label, css, help = tag_for.call(tier_tags, deposit["tier"]) %>
                  <span class="badge reconciliation-badge <%= css %>" data-bs-toggle="tooltip"
                        data-bs-title="<%= [help, *reasoning].compact.join(' — ') %>"><%= label %></span>
                  <% if amount_tags.key?(deposit["amount_status"]) %>
                    <% label, css, help = amount_tags[deposit["amount_status"]] %>
                    <span class="badge reconciliation-badge <%= css %>" data-bs-toggle="tooltip" data-bs-title="<%= help %>"><%= label %></span>
                  <% end %>
                  <% if !internal && funds_tags.key?(deposit["source_of_funds"]) %>
                    <% label, css, help = funds_tags[deposit["source_of_funds"]] %>
                    <span class="badge reconciliation-badge <%= css %>" data-bs-toggle="tooltip" data-bs-title="<%= help %>"><%= label %></span>
                  <% end %>
                  <% if deposit["identity_via"] == "manual_reassign" %>
                    <span class="badge reconciliation-badge bg-secondary" data-bs-toggle="tooltip"
                          data-bs-title="A reviewer assigned this deposit to the investor/folio by hand via Reassign.">Reassigned</span>
                  <% end %>
                  <% if deposit["payment_status"].present? %>
                    <% label, css, help = tag_for.call(payment_tags, deposit["payment_status"]) %>
                    <% if deposit["payment_id"].present? %>
                      <%# A payment on this call: the tag opens it in a new tab. %>
                      <%= link_to capital_remittance_payment_path(deposit["payment_id"]), target: "_blank", rel: "noopener",
                                  class: "badge reconciliation-badge #{css} text-decoration-none",
                                  data: { bs_toggle: "tooltip", bs_title: "#{help} Opens the payment in a new tab." } do %>
                        <%= label %> <i class="ti ti-external-link"></i>
                      <% end %>
                    <% else %>
                      <span class="badge reconciliation-badge <%= css %>" data-bs-toggle="tooltip" data-bs-title="<%= help %>"><%= label %></span>
                    <% end %>
                  <% end %>
                </div>
                <% if attention.present? %>
                  <div class="text-muted"><%= attention %></div>
                <% end %>
                <% if deposit["payment_error"].present? %>
                  <div class="text-danger"><%= deposit["payment_error"] %></div>
                <% end %>
              </td>
              <td class="reconciliation-actions">
                <% if recorded_here && can_undo %>
                  <%# Goes through the call-scoped undo action (not the generic payment destroy) so the
                      report's deposit entry is cleared and the redirect lands back on this page. The
                      global confirm modal (layouts/_confirm) intercepts the click and submits this form
                      on Proceed. %>
                  <%= button_to "Undo", undo_reconciliation_deposit_capital_call_path(capital_call),
                      params: { report_id: report.id, deposit_index: idx }, method: :post,
                      class: "btn btn-sm btn-outline-danger",
                      form_class: "d-inline",
                      data: { turbo: false, action: "click->confirm#popup", method: :post,
                              title: "Undo this payment?",
                              msg: "The payment will be deleted and the deposit returned to review. " \
                                   "If units have already been allocated against this payment, undo will be blocked." } %>
                <% end %>

                <% if can_confirm %>
                  <%# Tooltip says what Confirm does; the click goes through the global confirm modal
                      (layouts/_confirm) which spells out the exact payment before it submits. %>
                  <% amount_text = number_to_currency(deposit["amount"], unit: "") %>
                  <% confirm_msg =
                       case deposit["amount_status"]
                       when "partial"
                         "Record a payment of #{amount_text} for #{deposit['matched_investor_name']}? This is a partial payment — " \
                         "#{number_to_currency(deposit['due_amount'].to_f - deposit['amount'].to_f, unit: '')} will remain due on the remittance."
                       when "overpaid"
                         "Record a payment of #{amount_text} for #{deposit['matched_investor_name']}? This exceeds the amount due " \
                         "(#{number_to_currency(deposit['due_amount'], unit: '')}) — the remittance will show as overpaid."
                       else
                         "Record a payment of #{amount_text} for #{deposit['matched_investor_name']} against this call?"
                       end %>
                  <% confirm_msg += " The sender's account does not match this investor's KYC account — verify the source of funds first." if deposit["source_of_funds"] == "discrepancy" %>
                  <%= button_to "Confirm", confirm_reconciliation_deposit_capital_call_path(capital_call),
                      params: { report_id: report.id, deposit_index: idx }, method: :post,
                      class: "btn btn-sm btn-primary", form_class: "d-inline",
                      data: { turbo: false, action: "click->confirm#popup", method: :post,
                              title: "Confirm this payment?", msg: confirm_msg, reversible: "yes", notification: "no",
                              bs_toggle: "tooltip", bs_container: "body",
                              bs_title: "Records this deposit as a payment of #{amount_text} against #{deposit['matched_investor_name']}'s remittance. Nothing is verified; you can undo it afterwards." } %>
                <% end %>

                <% if can_reassign %>
                  <%# Pick the remittance (folio) this deposit belongs to. The value submitted is the
                      folio; the controller also still accepts a Virtual Bank Account typed here. %>
                  <%= form_with url: reassign_reconciliation_deposit_capital_call_path(capital_call), method: :post,
                                class: "input-group input-group-sm reconciliation-reassign-form", local: true do |f| %>
                    <%= f.hidden_field :report_id, value: report.id %>
                    <%= f.hidden_field :deposit_index, value: idx %>
                    <%= f.text_field :lookup, list: "reconciliation_folios", placeholder: "Pick investor / folio",
                                     autocomplete: "off", class: "form-control", required: true %>
                    <%= f.submit "Reassign", class: "btn btn-outline-secondary" %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <tr data-reconciliation-filter-target="emptyRow" class="d-none">
            <td colspan="6" class="text-muted text-center">No deposits match this filter.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <% if pending_exact.any? %>
      <%= render "capital_calls/confirm_all_exact_modal", modal_id: "confirm-all-exact-modal", capital_call: capital_call,
                 report: report, pending_exact: pending_exact, partial_count: pending_partial_count %>
    <% end %>

    <%# Shared by every Reassign input above (see reassign_choices). %>
    <datalist id="reconciliation_folios">
      <% reassign_choices.each do |folio_id, investor_name| %>
        <option value="<%= folio_id %>"><%= investor_name %></option>
      <% end %>
    </datalist>
  <% end %>
</div>
