<div>
  <%= render "account_entry_reports/filter_form",
        url: folio_report_account_entry_reports_path,
        fund: @fund,
        heading: "#{@capital_commitment.investor_name.titleize} \u2014 Folio #{@capital_commitment.folio_id}",
        header_link: link_to("\u2190 View Fund Report",
                             fund_report_account_entry_reports_path(fund_id: @fund.id, start_date: @start_date, end_date: @end_date, allocation_run_id: @allocation_run_id),
                             class: "btn btn-sm btn-outline-secondary"),
        start_date: @start_date, end_date: @end_date,
        commitment_options: @commitment_options, commitment_ids: @commitment_ids,
        available_entry_names: @available_entry_names, entry_names: @entry_names,
        available_entry_types: @available_entry_types, entry_types: @entry_types,
        range_clamped: @range_clamped, requested_start_date: @requested_start_date,
        allocation_run_id: @allocation_run_id %>

  <%= render "account_entry_reports/summary_kpis", report: @report, fund: @fund %>
  <%= render "account_entry_reports/commentary", insight: @insights["summary_kpis"], fund: @fund, capital_commitment: @capital_commitment, section_key: "summary_kpis", start_date: @start_date, end_date: @end_date %>

  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card shadow mb-4 border-bottom-primary">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Breakdown by Entry Name</h6>
        </div>
        <div class="card-body">
          <div class="chart-area">
            <%= render "account_entry_reports/breakdown_chart", report: @report, fund: @fund %>
          </div>
          <%= render "account_entry_reports/commentary", insight: @insights["breakdown"], fund: @fund, capital_commitment: @capital_commitment, section_key: "breakdown", start_date: @start_date, end_date: @end_date %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow mb-4 border-bottom-primary">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Trailing-Period Trend</h6>
        </div>
        <div class="card-body">
          <div class="chart-area">
            <%= render "account_entry_reports/trend_chart", report: @report, fund: @fund %>
          </div>
          <%= render "account_entry_reports/commentary", insight: @insights["trend"], fund: @fund, capital_commitment: @capital_commitment, section_key: "trend", start_date: @start_date, end_date: @end_date %>
        </div>
      </div>
    </div>
  </div>

  <h4>Detail</h4>
  <%= render "account_entry_reports/entries_table", entries: @entries %>
</div>
