<%
    params[:force_units] = capital_commitment.fund.default_currency_units
    if params[:force_units] == "Crores" && capital_commitment.committed_amount.to_d < 100_00000
        # If committed_amount is less than a crore, then show in lakhs
        params[:force_units] = "Lakhs"
    end
%>
<%
    # Distributed = what has actually been paid out on this folio, net (completed payments' Net Payable) -
    # the same figure as the fund page's top Distributed and the Distributions section's Received card.
    # (The commitment counter sums gross payable, which counts unpaid distributions and is 0 on older ones.)
    folio_payments = CapitalDistributionPayment.where(id: policy_scope(CapitalDistributionPayment).where(capital_commitment_id: capital_commitment.id).select(:id))
    distributed = Money.new(CapitalDistributionPayment.lp_totals(folio_payments)[:received], capital_commitment.fund.currency)
%>
<div class="row">
    <div class="col-lg-8 d-flex align-items-strech">
    <div class="card w-100">
        <div class="card-body">
        <div class="d-sm-flex d-block align-items-center justify-content-between mb-9">
            <div class="mb-3 mb-sm-0">
                <div class="row">
                    <% if capital_commitment.entity.logo %>
                    <%= image_tag(
                            capital_commitment.entity.logo.url(expires_in: 60 * 60 * 24 * 7),
                            alt: "#{capital_commitment.entity.name} logo",
                            class: "col cc-card-logo"
                        ) %>
                    <% end %>

                    <span class="col">
                    <h3 class="card-title fw-semibold">
                        <%= link_to "#{capital_commitment.fund.name}: #{capital_commitment.entity.name}", capital_commitment.fund %>
                    </h3>

                    <span class="fs3 mb-1">
                        <%= capital_commitment.investor_kyc&.full_name if capital_commitment.investor_kyc %>
                        Folio: <%= capital_commitment.folio_id %>
                        <i class="ti ti-info-circle text-muted" data-bs-toggle="tooltip" title="The folio (account) number of this commitment. Calls, distributions and documents are issued per folio"></i>
                    </span>

                </div>

            </div>

        </div>
        <div class="row align-items-center">
            <div class="col-md-7">
                <%= column_chart [["Committed", capital_commitment.committed_amount.to_f], ["Called", capital_commitment.call_amount.to_f], ["Collected", capital_commitment.collected_amount.to_f], ["Distributed", distributed.to_f] ], id: "capital_commitment_#{capital_commitment.id}",
                 library: {
                   plotOptions: {
                        column: {
                            pointWidth: 40,
                            dataLabels: {
                                enabled: false,
                                format: "{point.y:,.2f}"
                            }
                        }
                    },
                    **chart_theme_color
                 } %>
                <%# Say what the bars compare - Collected is verified payments only, like Due Amount %>
                <small class="text-muted d-block text-center">On this folio: committed, called (before fees), collected (verified payments) and distributed (paid out, net)</small>
            </div>
            <div class="col-md-5">
                <div class="hstack mb-4 pb-1">
                    <div class="p-8 bg-primary-subtle rounded-1 me-3 d-flex align-items-center justify-content-center">
                        <i class="ti ti-file-certificate text-primary fs-6"></i>
                        </div>
                        <div>
                        <span class="mb-0 fs-7"><%= money_to_currency(capital_commitment.committed_amount, params) %></span>
                        <p class="fs-3 mb-0">Committed <i class="ti ti-info-circle text-muted" data-bs-toggle="tooltip" title="The amount committed to this fund on this folio"></i></p>
                    </div>
                </div>

                <div class="hstack mb-4 pb-1">
                    <div class="p-8 bg-primary-subtle rounded-1 me-3 d-flex align-items-center justify-content-center">
                        <i class="ti ti-file-invoice text-primary fs-6"></i>
                        </div>
                        <div>
                        <span class="mb-0 fs-7"><%= money_to_currency(capital_commitment.call_amount, params) %></span>
                        <p class="fs-3 mb-0">Called <i class="ti ti-info-circle text-muted" data-bs-toggle="tooltip" title="What the capital calls on this folio have asked for so far, before fees. Fees are listed separately in the Calls section"></i></p>
                    </div>
                </div>

                <div class="hstack mb-4 pb-1">
                    <div class="p-8 bg-primary-subtle rounded-1 me-3 d-flex align-items-center justify-content-center">
                        <i class="ti ti-coins text-primary fs-6"></i>
                        </div>
                        <div>
                        <span class="mb-0 fs-7"><%= money_to_currency(distributed, params) %></span>
                        <p class="fs-3 mb-0">Distributed <i class="ti ti-info-circle text-muted" data-bs-toggle="tooltip" title="What has actually been paid out on this folio, net of tax and deductions. Announced but unpaid distributions are not included - they show as Pending Payout in the Distributions section"></i></p>
                    </div>
                </div>

                <div>

                    <div class="text-center">
                        <div class="row">

                            <div class="col-6">
                                <a href="<%= fund_path(capital_commitment.fund, tab: "commitments-tab") %>" class="btn btn-outline-primary w-100">
                                    <i class="ti ti-building-bank me-1"></i>Fund Details
                                </a>

                            </div>
                            <div class="col-6">

                                <a href="<%= fund_path(capital_commitment.fund, tab: "docs-tab") %>" class="btn btn-outline-primary w-100">
                                    <i class="ti ti-folder me-1"></i>Fund Documents
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </div>
    </div>
    <div class="col-lg-4">
    <div class="row">
        <div class="col-lg-12 col-md-6">
            <% if capital_commitment.fund.features.show_fund_ratios? %>
                <div class="card">
                    <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <%# "See all" opens the fund page's Ratios section (same show_fund_ratios? gate as this card) %>
                            <div class="d-flex justify-content-between align-items-center mb-9">
                                <h5 class="card-title mb-0 fw-semibold">
                                    Fund Ratios
                                    <i class="ti ti-info-circle text-muted fs-4" data-bs-toggle="tooltip" title="The fund's latest reported performance ratios. Hover a ratio for what it measures"></i>
                                </h5>
                                <%= link_to fund_path(capital_commitment.fund, tab: "ratios-tab"), class: "small text-decoration-none", id: "fund_ratios_see_all_#{capital_commitment.id}" do %>
                                    See all &rarr;
                                <% end %>
                            </div>
                            <table class="table">
                                <%# Plain-language meaning of each ratio (FundRatio.help_for), as a tooltip on its name %>
                                <%# The same ratios as the fund page's Ratios section headline cards, so the two never differ:
                                    the LP's ratios fund (a feeder shows its master's - Fund#lp_ratios_fund_id), fund-level,
                                    Default scenario, each ratio's latest row (FundRatio.headline_ratios); the first three here %>
                                <% card_ratios = policy_scope(FundRatio).where(fund_id: capital_commitment.fund.lp_ratios_fund_id, capital_commitment_id: nil, scenario: "Default") %>
                                <%# A feeder with no ratios of its own shows its master's - say so %>
                                <% if capital_commitment.fund.lp_ratios_from_master? %>
                                    <caption class="caption-top small text-muted" id="fund_ratios_from_master_<%= capital_commitment.id %>">
                                        <%= capital_commitment.fund.name %> has no ratios of its own yet. These are its master fund <%= capital_commitment.fund.master_fund.name %>'s ratios.
                                    </caption>
                                <% end %>
                                <% FundRatio.headline_ratios(card_ratios).first(3).each do |fund_ratio| %>
                                    <tr>
                                        <td>
                                            <%= link_to fund_ratio.name, fund_ratio %>
                                            <% if (ratio_help = FundRatio.help_for(fund_ratio.name)) %>
                                                <i class="ti ti-info-circle text-muted" data-bs-toggle="tooltip" title="<%= ratio_help %>"></i>
                                            <% end %>
                                        </td>
                                        <td><%= fund_ratio.display_value %></td>
                                    </tr>
                                <% end %>
                            </table>
                        </div>
                    </div>
                    </div>
                </div>
            <% end %>
                <div class="card">
                    <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <%# "See all" opens the fund page's Documents section (latest docs + search) %>
                            <div class="d-flex justify-content-between align-items-center mb-9">
                                <h5 class="card-title mb-0 fw-semibold">
                                    Recent Documents
                                    <i class="ti ti-info-circle text-muted fs-4" data-bs-toggle="tooltip" title="The latest documents for this folio, and from the fund's data room"></i>
                                </h5>
                                <%= link_to fund_path(capital_commitment.fund, tab: "docs-tab"), class: "small text-decoration-none", id: "recent_documents_see_all_#{capital_commitment.id}" do %>
                                    See all &rarr;
                                <% end %>
                            </div>
                            <table class="table">
                                <% capital_commitment.docs_for_investor.limit(2).order(id: :desc).each do |doc| %>
                                    <tr role="presentation">
                                        <td><%= link_to doc.name, doc %></td>
                                        <td><%= l doc.created_at.to_date %></td>
                                    </tr>
                                <% end %>
                                <% capital_commitment.fund.data_room_folder.documents.limit(2).order(id: :desc).each do |doc| %>
                                    <tr role="presentation">
                                        <td><%= link_to doc.name, doc %></td>
                                        <td><%= l doc.created_at.to_date %></td>
                                    </tr>
                                <% end %>
                            </table>
                        </div>
                    </div>
                    </div>
                </div>

        </div>

        <!-- div class="col-lg-12 col-md-6">
        <div class="card">
            <div class="card-body">
            <div class="row align-items-start">
                <div class="col">
                    <h5 class="card-title mb-9 fw-semibold">
                        Uncalled Capital
                    </h5>
                    <span class="fs-5 fw-semibold mb-0">
                        <%= money_to_currency(capital_commitment.commitment_pending, params) %>
                    </span>
                </div>
            </div>
            </div>
        </div>
        </div -->

        <div class="col-lg-12 col-md-6">
        <div class="card">
            <div class="card-body">
            <div class="row align-items-start">
                <div class="col">
                    <%# "See all" opens the fund page's Calls section, which lists the LP's remittances (what is due) %>
                    <div class="d-flex justify-content-between align-items-center mb-9">
                        <h5 class="card-title mb-0 fw-semibold">
                            Due Amount
                            <i class="ti ti-info-circle text-muted fs-4" data-bs-toggle="tooltip" title="Still owed on this folio: Called + Fees - payments the fund has verified. A payment recorded but not yet verified still counts as due. Matches the Due card in the Calls section"></i>
                        </h5>
                        <%= link_to fund_path(capital_commitment.fund, tab: "calls-tab"), class: "small text-decoration-none", id: "due_amount_see_all_#{capital_commitment.id}" do %>
                            See all &rarr;
                        <% end %>
                    </div>
                    <span class="fs-5 mb-0">
                        <%# Same verified-basis total as the Calls section's Due card and grid (CapitalRemittance.lp_totals),
                            over the remittances of this folio the user can see %>
                        <% folio_remittances = CapitalRemittance.where(id: policy_scope(CapitalRemittance).where(capital_commitment_id: capital_commitment.id).select(:id)) %>
                        <%= money_to_currency(Money.new(CapitalRemittance.lp_totals(folio_remittances)[:due], capital_commitment.fund.currency), {}) %>
                    </span>
                </div>
            </div>
            </div>
        </div>
        </div>
    </div>
    </div>
</div>

<% params[:force_units] = nil %>
