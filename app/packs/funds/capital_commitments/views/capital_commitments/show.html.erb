<%# Capital commitment show page. Displays commitment stats, action buttons
    (edit, delete, AI assistant, SLO agent), commitment details, and the
    SLO agent run modal + progress wrapper when the agent is enabled. %>
<div class="container-fluid p-3">

  <%= render "/capital_commitments/capital_commitment_stats", capital_commitment: @capital_commitment %>

  <% if current_user.entity_id == @capital_commitment.entity_id %>
    <%= render "capital_commitments/show", capital_commitment: @capital_commitment %>
  <% end %>

  <div>

    <% if policy(@capital_commitment).update? %>
      <%= link_to edit_capital_commitment_path(@capital_commitment), id: "capital_commitment_edit_btn", class: "btn btn-outline-primary" do %>
        <i class="ti ti-edit"></i> <%= t_common(:edit) %>
      <% end %>

      <%= button_to @capital_commitment, id: "capital_commitment_delete_btn", method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton",
                  data: {action: "click->confirm#popup", turbo: false} do %>
        <i class="ti ti-trash"></i> <%= t_common(:delete) %>
      <% end %>
    <% end %>

    <% if @capital_commitment.entity.support_agents.set?(:folio_assistant) %>
      <%= link_to assistant_path('assistant', assistant_type: 'CapitalCommitmentAssistant', owner_id: @capital_commitment.id, owner_type: "CapitalCommitment"),
                  class: "btn btn-outline-secondary",
                  data: { turbo: false } do %>
        <i class="ti ti-brand-github-copilot"></i> AI Assistant
      <% end %>
    <% else %>
      <!-- folio_assistant disabled: visible but non-functional -->
      <span data-bs-toggle="tooltip" title="Folio Assistant is disabled. Contact support to enable it">
        <button class="btn btn-outline-secondary" style="filter:grayscale(100%) opacity(0.7); pointer-events:none;">
          <i class="ti ti-brand-github-copilot"></i> AI Assistant <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
        </button>
      </span>
    <% end %>

    <%# Run SLO Agent for this specific capital commitment %>
    <% if current_user.entity&.support_agents&.set?(:side_letter_obligation_agent) %>
      <button type="button" class="btn btn-outline-info"
              data-bs-toggle="modal" data-bs-target="#run-slo-agent-commitment-modal">
        <i class="ti ti-robot"></i> Run SLO Agent
      </button>
    <% end %>

    <% if policy(@capital_commitment).update? %>
      <div class="btn-group">
        <div class="dropdown">
          <button class="btn btn-outline-success dropdown-toggle" type="button" id="commitment_actions"
                  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="ti ti-settings"></i> <%= t_common(:actions) %>
          </button>
          <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">

            <%= link_to report_capital_commitment_path(@capital_commitment, report: "lp_statement"), id: "capital_commitment_lp_statement_report_btn", class: "dropdown-item" do %>
              <i class="ti ti-file-description"></i>LP Account Statement
            <% end %>

            <% report = Report.where(entity_id: current_user.entity_id, name: "Folio Account Entries").first %>
            <% if report %>
              <%= link_to dynamic_report_path(report, fund_id: @capital_commitment.fund_id, folio_id: @capital_commitment.folio_id, reporting_date: Date.today - 12.months), id: "capital_commitment_folio_account_entries_report_btn", class: "dropdown-item" do %>
                <i class="ti ti-file-search"></i>Folio Account Entries
              <% end %>
            <% end %>

            <div class="dropdown-divider"></div>

            <%= link_to new_for_investor_investor_advisors_path(investor_id: @capital_commitment.investor_id, fund_id: @capital_commitment.fund_id, back_to: capital_commitment_path(@capital_commitment)), id: "capital_commitment_new_investor_advisor_btn", class: "dropdown-item" do %>
              <i class="ti ti-user-plus"></i>Add Investor Advisor
            <% end %>

            <div class="dropdown-divider"></div>

            <% if policy(@capital_commitment).generate_documentation? %>
              <%= button_to generate_documentation_capital_commitment_path(@capital_commitment), id: "capital_commitment_generate_all_documents_btn",
                  method: :patch, class: "dropdown-item", form_class: "deleteButton",
                  data: {action: "click->confirm#popup", method: :patch,
                        msg: "Generate Documents for this capital commitment from kyc and fund info. This will delete any previously generated documentation for this capital commitment. Proceed?"} do %>
                <i class="ti ti-files"></i>Generate All Documents
              <% end %>

              <div class="dropdown-divider"></div>

              <% @capital_commitment.templates("Commitment Template").each do |template| %>
                <%= button_to generate_documentation_capital_commitment_path(@capital_commitment, template_id: template.id), id: "capital_commitment_generate_#{template.name.parameterize}_btn",
                    method: :patch, class: "dropdown-item", form_class: "deleteButton",
                    data: {action: "click->confirm#popup", method: :patch,
                          msg: "Generate #{template.name} for this capital commitment from kyc and fund info. This will delete any previously generated documentation for this capital commitment. Proceed?"} do %>
                  <i class="ti ti-file-text"></i>Generate <%= template.name %>
                <% end %>
              <% end %>
            <% end %>

            <% if policy(@capital_commitment).generate_soa? %>
              <%= link_to generate_soa_form_capital_commitment_path(@capital_commitment), id: "capital_commitment_generate_soa_btn", class: "dropdown-item" do %>
                <i class="ti ti-file-invoice"></i>Generate Investor Statement
              <% end %>
            <% end %>

            <% if policy(@capital_commitment).preview? %>
              <% adhoc_notifications = @capital_commitment.fund.custom_notifications.enabled.where(email_method: "adhoc_fund_notification") %>
              <% if adhoc_notifications.any? %>
                <div class="dropdown-divider"></div>

                <% preview_target = Rails.env.test? ? "_top" : "_blank" %> <!-- Playwright requires the same window to check details -->
                <% adhoc_notifications.each_with_index do |adhoc_notification, i| %>
                  <% label = adhoc_notification.tag.presence || adhoc_notification.subject %>
                  <%= link_to preview_capital_commitment_path(@capital_commitment, email_method: "adhoc_fund_notification", custom_notification_id: adhoc_notification.id),
                              id: "capital_commitment_preview_adhoc_notification_#{i}_btn", class: "dropdown-item", data: { turbo: false }, target: preview_target do %>
                    <i class="ti ti-mail"></i>Preview Adhoc Fund Notification (<%= label %>)
                  <% end %>
                <% end %>
              <% end %>
            <% end %>

          </div>
        </div>
      </div>
    <% end %>

  </div>

</div>

<%# SLO Agent progress panel — placed between buttons and details so the
    user sees progress without scrolling after clicking "Run SLO Agent". %>
<% if current_user.entity&.support_agents&.set?(:side_letter_obligation_agent) %>
  <div id="slo_progress_wrapper" class="container-fluid px-3 pb-3">
    <% slo_agent = SupportAgent.find_by(entity_id: current_user.entity_id, agent_type: "SideLetterObligationAgent") %>
    <% existing_report = SupportAgentReport.find_by(owner: @capital_commitment, support_agent: slo_agent) if slo_agent %>
    <% if existing_report %>
      <%= render "support_agents/progress_panel",
                 report: existing_report,
                 support_agent: slo_agent,
                 target: @capital_commitment %>
    <% end %>
  </div>
<% end %>

<%= render "capital_commitments/details", capital_commitment: @capital_commitment %>

<%# SLO Agent run modal — rendered outside the container to avoid
    container-type: inline-size breaking Bootstrap modal positioning. %>
<% if current_user.entity&.support_agents&.set?(:side_letter_obligation_agent) %>
  <%= render "support_agents/agent_run_modal",
             modal_id:         "run-slo-agent-commitment-modal",
             agent_type:       "SideLetterObligationAgent",
             target_type:      "CapitalCommitment",
             target_id:        @capital_commitment.id,
             description:      SideLetterObligationAgent::DESCRIPTION,
             long_description: SideLetterObligationAgent::SINGLE_LONG_DESCRIPTION %>
<% end %>
