<% frame_id = params[:widget_id].present? ? "documents_tree_frame_#{params[:widget_id]}" : "documents_tree_frame" %>

<%= render ReportingComponent.new do %>
    <%= turbo_frame_tag frame_id, target: "_top" do %>
        <%= render "/documents/tree_view",
            documents: @documents,
            entity: @entity,
            show_steps: false,
            folder_url_method: :documents_capital_commitments_path,
            use_entity_name_for_root: true,
            virtual_root: "Commitment Documents"
        %>
    <% end %>
<% end %>
