<%
  metrics = card2_metrics(capital_commitment)
  activities = card2_recent_activity(capital_commitment)
  attention_items = card2_attention_items(capital_commitment)
%>

<div class="card w-100 mb-5 border-0 shadow-sm rounded-4 overflow-hidden">
  <!-- Header with subtle background -->
  <div class="card-header bg-card border-0 p-4 pb-0">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-4">
        <% if capital_commitment.entity.logo %>
          <div class="bg-light-subtle rounded-4 p-2 d-flex align-items-center justify-content-center shadow-sm border border-opacity-10" style="width: 64px; height: 64px;">
            <%= image_tag capital_commitment.entity.logo.url(expires_in: 60*60*24*7), class: "img-fluid rounded-2" %>
          </div>
        <% end %>
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bolder text-dark-emphasis mb-0"><%= link_to capital_commitment.fund.name, capital_commitment.fund, class: "text-inherit text-decoration-none" %></h3>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3">Folio <%= capital_commitment.folio_id %></span>
          </div>
          <p class="fs-3 mb-0 text-muted d-flex align-items-center gap-2">
            <i class="ti ti-user-circle fs-5"></i> <%= capital_commitment.investor_kyc&.full_name %>
          </p>
        </div>
      </div>
      <div class="dropdown">
        <button class="btn btn-icon btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
          <i class="ti ti-dots-vertical fs-5"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
          <li><%= link_to "View Fund", fund_path(capital_commitment.fund), class: "dropdown-item py-2" %></li>
          <li><%= link_to "Fund Documents", fund_path(capital_commitment.fund, tab: "docs-tab"), class: "dropdown-item py-2" %></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="card-body p-4">
    <!-- Performance Summary Bar -->
    <div class="bg-primary-subtle rounded-4 p-4 mb-5 border border-primary border-opacity-10 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <div class="round-48 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow">
          <i class="ti ti-trending-up fs-6"></i>
        </div>
        <div>
          <h5 class="fw-bold mb-1 text-primary-emphasis">Investment performing strongly</h5>
          <p class="fs-3 mb-0 text-dark-emphasis opacity-75">
            Your NAV is up <strong class="text-primary"><%= metrics[:nav_change_pct] %>%</strong> since the last reporting period.
          </p>
        </div>
      </div>
      <% if attention_items.any? %>
        <div class="d-none d-md-flex align-items-center gap-2 bg-card rounded-pill px-4 py-2 shadow-sm border border-warning border-opacity-25">
          <i class="ti ti-alert-circle text-warning fs-5"></i>
          <span class="fw-semibold text-dark-emphasis fs-2"><%= pluralize(attention_items.count, 'Task') %> Pending</span>
        </div>
      <% end %>
    </div>

    <!-- Metrics Ribbon -->
    <!-- Metrics Ribbon -->
    <div class="row g-4 mb-5">
      <% [
        { label: "Committed", value: money_to_currency(metrics[:committed], { units: metrics[:currency_units] }), icon: "ti-anchor", color: "primary" },
        { label: "Invested", value: money_to_currency(metrics[:invested], { units: metrics[:currency_units] }), icon: "ti-arrow-up-right", color: "info", sub: "#{metrics[:invested_pct]}%" },
        { label: "Current NAV", value: money_to_currency(metrics[:nav], { units: metrics[:currency_units] }), icon: "ti-chart-line", color: "success", sub: "#{metrics[:nav_change_pct]}%" },
        { label: "Distributed", value: money_to_currency(metrics[:distributed], { units: metrics[:currency_units] }), icon: "ti-arrow-down-left", color: "secondary" },
        { label: "TVPI", value: "#{metrics[:tvpi]}x", icon: "ti-multiplier-1-5x", color: "warning" },
        { label: "IRR", value: "#{metrics[:irr]}%", icon: "ti-percentage", color: "danger" }
      ].each do |m| %>
        <div class="col-lg-2 col-md-4 col-6">
          <div class="text-center p-3 rounded-4 bg-<%= m[:color] %>-subtle border border-<%= m[:color] %> border-opacity-10 h-100 transition-all hover-shadow">
            <div class="text-<%= m[:color] %>-emphasis mb-2">
              <i class="ti <%= m[:icon] %> fs-7"></i>
            </div>
            <h4 class="fw-bolder mb-1 fs-5 text-<%= m[:color] %>-emphasis"><%= m[:value] %></h4>
            <div class="d-flex align-items-center justify-content-center gap-1">
              <span class="text-<%= m[:color] %>-emphasis opacity-75 fs-2 fw-semibold text-uppercase ls-1"><%= m[:label] %></span>
              <% if m[:sub] %>
                <span class="badge bg-<%= m[:color] %> text-white rounded-pill fs-1 fw-bold border-0"><%= m[:sub] %></span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    </div>

    <div class="row g-4">
      <!-- Performance Section -->
      <div class="col-lg-7" data-controller="chart-period">
        <div class="card border-0 shadow-none bg-light-subtle rounded-4 h-100 overflow-hidden">
          <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <div>
                <h5 class="fw-bolder text-dark-emphasis mb-1 d-flex align-items-center gap-2">
                  <i class="ti ti-presentation-analytics text-primary"></i> Performance Overview
                </h5>
                <p class="fs-2 text-muted mb-0">Analysis of capital and valuation growth</p>
              </div>
              <div class="bg-card p-1 rounded-3 shadow-sm border border-opacity-10">
                <div class="btn-group btn-group-sm">
                  <button class="btn btn-link text-muted text-decoration-none px-3" data-action="chart-period#change" data-period="3M">3M</button>
                  <button class="btn btn-link text-muted text-decoration-none px-3" data-action="chart-period#change" data-period="6M">6M</button>
                  <button class="btn btn-primary rounded-2 shadow-sm px-3 active" data-action="chart-period#change" data-period="YTD">YTD</button>
                  <button class="btn btn-link text-muted text-decoration-none px-3" data-action="chart-period#change" data-period="MAX">MAX</button>
                </div>
              </div>
            </div>
            <div id="performance_chart_container_<%= capital_commitment.id %>" class="rounded-3 overflow-hidden">
              <%= card2_performance_chart(capital_commitment) %>
            </div>
            <%= hidden_field_tag :chart_url, capital_commitment_path(capital_commitment), data: { chart_period_target: "url" } %>
          </div>
        </div>
      </div>

      <!-- Action Required Section -->
      <div class="col-lg-5">
        <div class="card border-0 shadow-none bg-light-subtle rounded-4 h-100">
          <div class="card-body p-4">
            <h5 class="fw-bolder text-dark-emphasis mb-4 d-flex align-items-center gap-2">
               <i class="ti ti-layout-list text-primary"></i> Action Items
               <% if attention_items.any? %>
                 <span class="badge bg-danger rounded-circle p-1 ms-1" style="width: 8px; height: 8px;"></span>
               <% end %>
            </h5>
            
            <div class="vstack gap-3">
              <% if attention_items.any? %>
                <% attention_items.each do |item| %>
                  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card">
                    <div class="card-body p-3">
                      <div class="d-flex align-items-start gap-3">
                        <div class="<%= item[:color] %> rounded-3 p-2 fs-6">
                          <i class="ti <%= item[:icon] %>"></i>
                        </div>
                        <div class="flex-grow-1">
                          <h6 class="fw-bolder text-dark-emphasis mb-1"><%= item[:title] %></h6>
                          <p class="fs-2 text-muted mb-3"><%= item[:description] %></p>
                          <%= link_to item[:action_text], item[:action_url], class: "btn btn-primary btn-sm rounded-pill px-4" %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center py-5">
                  <div class="round-64 bg-card rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow-sm border border-opacity-10">
                    <i class="ti ti-check text-success fs-7"></i>
                  </div>
                  <h6 class="fw-bold mb-1">All caught up!</h6>
                  <p class="fs-2 text-muted mb-0">No pending actions required.</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Section: Docs & Trends -->
    <div class="row g-4 mt-1">
      <div class="col-lg-7">
        <div class="card border-0 shadow-none bg-light-subtle rounded-4 h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <div>
                <h5 class="fw-bolder text-dark-emphasis mb-1 d-flex align-items-center gap-2">
                  <i class="ti ti-folders text-primary"></i> Latest Documents
                </h5>
                <p class="fs-2 text-muted mb-0">Most recent reporting and compliance files</p>
              </div>
              <%= link_to fund_path(capital_commitment.fund, tab: "docs-tab"), class: "btn btn-white btn-sm border shadow-sm rounded-pill px-3 d-flex align-items-center gap-2" do %>
                <i class="ti ti-arrow-up-right fs-4"></i> Library
              <% end %>
            </div>
            
            <div class="row g-3">
              <% capital_commitment.docs_for_investor.limit(3).order(id: :desc).each do |doc| %>
                <div class="col-12">
                  <div class="card border-0 shadow-sm rounded-4 hover-translate-y transition-all bg-card">
                    <div class="card-body p-3">
                      <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                          <div class="bg-light-danger text-danger rounded-3 p-2 fs-5">
                            <i class="ti ti-file-description"></i>
                          </div>
                          <div>
                            <h6 class="fw-bold text-dark-emphasis mb-0 text-truncate" style="max-width: 250px;"><%= doc.name %></h6>
                            <p class="fs-1 text-muted mb-0 text-uppercase fw-semibold d-flex align-items-center gap-1">
                              <i class="ti ti-calendar-event fs-2"></i> <%= l doc.created_at.to_date, format: "%b %d, %Y" %>
                            </p>
                          </div>
                        </div>
                        <%= link_to doc, class: "btn btn-light-subtle btn-sm rounded-pill px-3 d-flex align-items-center gap-2" do %>
                          <i class="ti ti-download fs-4"></i> Download
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="card border-0 shadow-none bg-light-subtle rounded-4 h-100">
          <div class="card-body p-4">
            <div class="mb-4">
              <h5 class="fw-bolder text-dark-emphasis mb-1 d-flex align-items-center gap-2">
                <i class="ti ti-chart-arrows text-primary"></i> Benchmark Trends
              </h5>
              <p class="fs-2 text-muted mb-0">Historical fund-level performance ratios</p>
            </div>
            <div class="mt-2">
              <%= fund_ratios_line_chart(capital_commitment.fund, ratio_names: ["TVPI", "DPI", "RVPI", "XIRR"], owner: capital_commitment.fund, chart_id: "fund_ratios_chart_#{capital_commitment.id}", months: 24, hide_fund_name: true) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  [data-bs-theme="dark"] .bg-primary-subtle { background-color: rgba(var(--bs-primary-rgb), 0.25) !important; }
  [data-bs-theme="dark"] .bg-info-subtle { background-color: rgba(var(--bs-info-rgb), 0.25) !important; }
  [data-bs-theme="dark"] .bg-success-subtle { background-color: rgba(var(--bs-success-rgb), 0.25) !important; }
  [data-bs-theme="dark"] .bg-warning-subtle { background-color: rgba(var(--bs-warning-rgb), 0.25) !important; }
  [data-bs-theme="dark"] .bg-danger-subtle { background-color: rgba(var(--bs-danger-rgb), 0.25) !important; }
  [data-bs-theme="dark"] .bg-secondary-subtle { background-color: rgba(var(--bs-secondary-rgb), 0.25) !important; }

  .hover-shadow:hover { box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; border-color: transparent!important; }
  .hover-translate-y:hover { transform: translateY(-3px); }
  .transition-all { transition: all 0.3s ease; }
  .ls-1 { letter-spacing: 0.5px; }
  .round-48 { width: 48px; height: 48px; }
  .round-64 { width: 64px; height: 64px; }
  .fs-7 { font-size: 1.5rem; }
  .bg-light-primary { background-color: #ecf2ff; }
  .bg-light-info { background-color: #e8f7ff; }
  .bg-light-success { background-color: #e6fffa; }
  .bg-light-secondary { background-color: #f6f9fc; }
  .bg-light-warning { background-color: #fef5e5; }
  .bg-light-danger { background-color: #fdede8; }
</style>
