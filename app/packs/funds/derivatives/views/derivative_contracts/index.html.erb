<%# Fund › Derivatives — openspec/changes/fund-market-data, design card ⑥ %>
<%= render ReportingComponent.new do %>
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Derivatives — <%= @fund.name %></h1>
    <div>
      <% %w[open closed all].each do |st| %>
        <%= link_to st.capitalize, fund_derivative_contracts_path(@fund, status: st), class: "btn btn-sm #{@status == st ? 'btn-primary' : 'btn-outline-secondary'}" %>
      <% end %>
      <% if policy(DerivativeContract.new(fund: @fund, entity_id: @fund.entity_id)).create? %>
        <%= link_to "Upload valuations", new_import_upload_path("import_upload[import_type]": "DerivativeEvent", "import_upload[owner_type]": "Fund", "import_upload[owner_id]": @fund.id), class: "btn btn-outline-primary ti ti-upload" %>
        <%= link_to "New contract", new_fund_derivative_contract_path(@fund), class: "btn btn-outline-primary ti ti-plus" %>
      <% end %>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table table-bordered" id="derivative_contracts">
      <thead>
        <tr>
          <th class="text-col">Contract</th>
          <th class="text-col">Type</th>
          <th class="text-col">Side</th>
          <th class="text-col">Notional / lots</th>
          <th class="date-col">Expiry</th>
          <th class="num-col">Value</th>
          <th class="text-col">Source</th>
          <th class="action-col"></th>
        </tr>
      </thead>
      <tbody>
        <% @contracts.each do |c| %>
          <% last_val = c.derivative_events.where(event_type: "valuation").reorder(event_date: :desc, id: :desc).first %>
          <tr id="<%= dom_id c %>">
            <td class="text-col"><%= link_to c.name, derivative_contract_path(c) %><%= " · Hedges: #{c.hedge_of&.investment_instrument&.name || c.hedge_unit_type}" if c.hedge_of || c.hedge_unit_type.present? %></td>
            <td class="text-col"><%= c.type_label %></td>
            <td class="text-col"><%= c.side.capitalize %></td>
            <td class="text-col"><%= c.notional_cents ? "#{c.underlying_name.to_s.split('/').first} #{number_with_delimiter((c.notional_cents.to_d / 100).round(2))}" : "#{c.open_lots.to_d.to_i} × #{c.lot_size.to_d.to_i}" %></td>
            <td class="date-col"><%= l c.expiry_date %></td>
            <td class="num-col"><%= last_val ? money_to_currency(Money.new(last_val.value_cents, c.currency), params) : "—" %></td>
            <td class="text-col"><%= last_val ? [last_val.source.capitalize, last_val.provider].compact_blank.join(" · ") : "—" %></td>
            <td class="action-col"><%= link_to t_common(:show), derivative_contract_path(c), class: "btn btn-sm btn-outline-primary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @contracts.none? %><p class="text-muted">No <%= @status == "all" ? "" : @status %> contracts.</p><% end %>
  </div>
<% end %>
