

  <% if params[:view] != "row" %>

    <%= render ToggleCard.new(title: "Investment Opportunities", css_class: "show_opp") do %>

      <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Investment Opportunities</h1>
        <%= link_to "New Investment Opportunity", new_investment_opportunity_path(),
            {class: "btn btn-outline-primary"} if policy(InvestmentOpportunity.new(entity_id: params[:entity_id] || current_user.entity_id)).new?  %>
      </div>
      <% investment_opportunities.each do |investment_opportunity| %>
        <% if params[:card_style] == "compact" %>
          <%= render "investment_opportunities/card", investment_opportunity: investment_opportunity, show_tags: true %>
        <% else %>
          <%= render "investment_opportunities/card_long", investment_opportunity: investment_opportunity, show_tags: true %>
        <% end %>
      <% end %>
      <%= raw pagy_bootstrap_nav(@pagy) %>
    <% end %>

  <% else %>

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
      <h1 class="h3 mb-0 text-gray-800">Investment Opportunities</h1>
      <%= link_to "New Investment Opportunity", new_investment_opportunity_path(),
          {class: "btn btn-outline-primary"} if policy(InvestmentOpportunity.new(entity_id: params[:entity_id] || current_user.entity_id)).new?  %>
    </div>
    <%# D21 — the firm's chosen columns (or the list's own, InvestmentOpportunity::LIST_COLUMNS); paged by pagy
        below as before, so no jqDataTable class. openspec/changes/grid-columns-inline-settings %>
    <% io_table = RansackTable.new(InvestmentOpportunity, q: @q, default_columns_map: InvestmentOpportunity::LIST_COLUMNS,
                                   current_user: current_user, records: investment_opportunities, report_id: params["report_id"],
                                   turbo_frame: "investment_opportunities_frame", referrer: request.referrer, pagy: nil,
                                   sortable: false) %>
    <div data-controller="datatable" data-datatable-money-columns-value="<%= io_table.money_column_indexes %>">
      <%= render io_table %>
    </div>

    <%= raw pagy_bootstrap_nav(@pagy) %>

  <% end %>