<div class="row">
  <div class="col-lg-3 col-md-6">
    <div class="card border-top stat-card-accent border-success shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div>
            <h6 class="card-subtitle mb-1 text-success">Fund Raise Amount</h6>
            <h3 class="fs-5"><%= money_to_currency investment_opportunity.fund_raise_amount, params %></h3>
          </div>
          <div class="ms-auto">
            <span class="text-success display-6 number-stats-icon"><i class="ti ti-currency-dollar"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-3 col-md-6">
    <div class="card border-top stat-card-accent border-info shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div>
            <h6 class="card-subtitle mb-1 text-info">Approved EOI Amount</h6>
            <h3 class="fs-5"><%= money_to_currency investment_opportunity.eoi_amount, params %></h3>
          </div>
          <div class="ms-auto">
            <span class="text-info display-6 number-stats-icon"><i class="ti ti-clipboard-list"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-3 col-md-6">
    <div class="card border-top stat-card-accent border-danger shadow-sm">
      <div class="card-body">
        <div class="row">
          <div class="col-12">
            <div class="d-flex align-items-center">
              <div>
                <h6 class="card-subtitle mb-1 text-danger">Valuation</h6>
                <h3 class="fs-5"><%= money_to_currency investment_opportunity.valuation, params %></h3>
              </div>
              <div class="ms-auto">
                <span class="text-danger display-6 number-stats-icon"><i class="ti ti-chart-line"></i></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-3 col-md-6">
    <div class="card border-top stat-card-accent border-warning shadow-sm">
      <div class="card-body">
        <div class="row">
          <div class="col-12">
            <div class="d-flex align-items-center">
              <div>
                <h6 class="card-subtitle mb-1 text-warning">Min Ticket Size</h6>
                <h3 class="fs-5"><%= money_to_currency investment_opportunity.min_ticket_size, params %></h3>
              </div>
              <div class="ms-auto">
                <span class="text-warning display-6 number-stats-icon"><i class="ti ti-ticket"></i></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
