
<% if params[:preview].present? || !policy(@investment_opportunity).update? %>
    <%# M10 — preview_template is the allowlisted ?template= value (InvestmentOpportunitiesController::PREVIEW_TEMPLATES) or nil %>
    <% if preview_template %>
        <%= render "/investment_opportunities/templates/#{preview_template}/index", investment_opportunity: @investment_opportunity %>
    <% else %>
        <%= render "/investment_opportunities/preview", investment_opportunity: @investment_opportunity %>
    <% end %>
<% else %>
    <%= render "/investment_opportunities/show", investment_opportunity: @investment_opportunity %>
<% end %>