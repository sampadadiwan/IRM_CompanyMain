  <%= render "/expression_of_interests/stats", expression_of_interests: @expression_of_interests %>

  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Expression Of Interests</h1>
    <span>
      <%= link_to "New Interest",
          new_expression_of_interest_path("expression_of_interest[investment_opportunity_id]":
              params[:investment_opportunity_id] ), {class: "btn btn-outline-primary ti ti-plus"} if params[:investment_opportunity_id]  %>

      <%= link_to "Download",
          expression_of_interests_path(format: :xlsx, "investment_opportunity_id":
              params[:investment_opportunity_id] ), {class: "btn btn-outline-success ti ti-download"} if params[:investment_opportunity_id]  %>
    </span>
  </div>

  <%# D21 — the firm's chosen columns (or the list's own, ExpressionOfInterest::LIST_COLUMNS), sorted, searched and
      paged in the page by jQuery DataTables (sortable: false, pagy: nil). openspec/changes/grid-columns-inline-settings %>
  <% eoi_table = RansackTable.new(ExpressionOfInterest, q: @q, default_columns_map: ExpressionOfInterest::LIST_COLUMNS,
                                  current_user: current_user, records: expression_of_interests, report_id: params["report_id"],
                                  turbo_frame: "expression_of_interests_frame", referrer: request.referrer, pagy: nil,
                                  table_css_class: "jqDataTable", sortable: false) %>
  <div data-controller="datatable" data-datatable-money-columns-value="<%= eoi_table.money_column_indexes %>">
    <%= render eoi_table %>
  </div>