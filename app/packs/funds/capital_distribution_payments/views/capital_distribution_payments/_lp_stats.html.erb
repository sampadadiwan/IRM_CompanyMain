<%# Stats cards above the LP fund page's distribution payments list (Distributions section).
    scope: every payment the LP can see in this fund (CapitalDistributionPaymentsController#lp_fund_stats_scope). %>
<%
  totals = CapitalDistributionPayment.lp_totals(scope)
  # Amounts are stored in the fund currency
  money = ->(cents) { money_to_currency(Money.new(cents, fund.currency), params) }
  # Every card is a total of the grid's Net Payable / Completed / Payment Date columns
  cards_data = [
    { stat: money.call(totals[:total]), subtitle: "Total Distributions", progress_bar_color: "primary" },
    { stat: money.call(totals[:received]), subtitle: "Received", progress_bar_color: "success" }
  ]
  # Pending only when there is something to say - a zero card is noise
  cards_data << { stat: money.call(totals[:pending]), subtitle: "Pending Payout", progress_bar_color: "warning" } if totals[:pending].to_d.positive?
  if totals[:last_date]
    cards_data << { stat: money.call(totals[:last_amount]), subtitle: "Last Distribution (#{l(totals[:last_date])})", progress_bar_color: "info" }
  end
%>

<div class="row mb-3" id="lp_distribution_stats">
  <% cards_data.each do |card_data| %>
    <%= render(NumberStatsComponent.new(
      path: nil,
      amount: card_data[:stat],
      subtitle: card_data[:subtitle],
      progress_bar_color: card_data[:progress_bar_color],
      fs_size: 4
    )) %>
  <% end %>
</div>
