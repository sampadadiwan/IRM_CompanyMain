<tr id="<%= dom_id capital_distribution %>">
  <td class="text-col">
    <%= link_to capital_distribution.title, capital_distribution %>
  </td>
  <td class="date-col">
    <%= l capital_distribution.distribution_date if capital_distribution.distribution_date %>
  </td>
  <td class="num-col">
    <%= money_to_currency capital_distribution.gross_amount, params %>
  </td>
  <td class="text-col">
    <%= display_boolean capital_distribution.approved %>
  </td>
  <td class="action-col">
    <div class="btn-group">
      <div class="dropdown">
        <button class="btn btn-outline-primary dropdown-toggle" type="button"
                data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <i class="ti ti-settings"></i> <%= t_common(:actions) %>
        </button>
        <div class="dropdown-menu dropdown-menu-end">
          <%= link_to capital_distribution_path(capital_distribution), class: "dropdown-item" do %>
            <i class="ti ti-eye"></i> <%= t_common(:show) %>
          <% end %>

          <% if policy(capital_distribution).update? %>
            <%= link_to edit_capital_distribution_path(capital_distribution), class: "dropdown-item" do %>
              <i class="ti ti-edit"></i> <%= t_common(:edit) %>
            <% end %>
          <% end %>

          <% if policy(capital_distribution).clone? %>
            <div class="dropdown-divider"></div>

            <%= link_to new_capital_distribution_path("capital_distribution[fund_id]": capital_distribution.fund_id, clone_from_id: capital_distribution.id, clone_mode: "full"),
                  class: "dropdown-item", data: { turbo: false, bs_toggle: "tooltip", bs_container: "body", bs_title: "Start a new distribution pre-filled with this one's title, amounts, unit prices and fee rows" } do %>
              <i class="ti ti-copy"></i>Clone
            <% end %>

            <%= link_to new_capital_distribution_path("capital_distribution[fund_id]": capital_distribution.fund_id, clone_from_id: capital_distribution.id, clone_mode: "fees"),
                  class: "dropdown-item", data: { turbo: false, bs_toggle: "tooltip", bs_container: "body", bs_title: "Start a blank new distribution with just this one's fee rows copied in" } do %>
              <i class="ti ti-copy"></i>Create With Fees
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </td>
</tr>
