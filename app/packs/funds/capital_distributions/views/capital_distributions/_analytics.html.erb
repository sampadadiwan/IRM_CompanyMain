<% if fund %>
  <div class="collapse mb-4" id="distributionAnalytics">
    <div class="card shadow-sm">
      <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Capital Distribution Analytics</h5>
        <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#distributionAnalytics" aria-label="Close"></button>
      </div>
      <div class="card-body">
        <%= turbo_frame_tag "distribution_analytics_frame", src: analytics_fund_path(fund, type: "CapitalDistribution"), loading: "lazy" do %>
          <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
