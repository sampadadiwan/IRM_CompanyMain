  <% owner = params[:fund_id].present? ? Fund.find(params[:fund_id]) : current_user.entity %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Distributions</h1>
  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= user_guide_info_icon %>
    <% if params[:fund_id].present? %>
      <button class="btn btn-outline-info d-inline-flex align-items-center" type="button" 
              data-bs-toggle="collapse" data-bs-target="#distributionAnalytics" 
              aria-expanded="false" aria-controls="distributionAnalytics">
        <i class="ti ti-chart-bar"></i> Analytics
      </button>
    <% end %>
    <%# New Distribution button (only if fund_id present) %>
    <% if params[:fund_id].present? %>
      <%= link_to new_capital_distribution_path("capital_distribution[fund_id]": params[:fund_id]),
                    class: "btn btn-outline-primary d-inline-flex align-items-center",
                    data: { turbo: false } do %>
        <i class="ti ti-plus"></i> New Distribution
      <% end %>
    <% end %>
    <%# Upload button (always shown) %>
    <%= link_to new_import_upload_path(
                    "import_upload[owner_id]": owner.id,
                    "import_upload[owner_type]": owner.class.name,
                    "import_upload[import_type]": "CapitalDistribution",
                    "sample_upload": "CAPITAL_DISTRIBUTION_SAMPLE"),
                  class: "btn btn-outline-primary d-inline-flex align-items-center",
                  data: { turbo: false } do %>
      <i class="ti ti-upload"></i> <%= t_common(:upload) %>
    <% end %>
    <%# Download button (only if fund_id present) %>
    <% if params[:fund_id].present? %>
      <%= link_to capital_distributions_path(fund_id: params[:fund_id], format: "xlsx"),
                    class: "btn btn-outline-success d-inline-flex align-items-center",
                    data: { turbo: false } do %>
        <i class="ti ti-download"></i> <%= t_common(:download) %>
      <% end %>
    <% end %>
  </div>
</div>
<%# Stats cards under the heading, above the table: the fund's Distributions tab (@stats_scope / @stats_fund from the controller) %>
<%= render "/capital_distributions/grid_stats", scope: @stats_scope, fund: @stats_fund if @stats_scope %>
<%= render "/capital_distributions/analytics", fund: (params[:fund_id].present? ? Fund.find(params[:fund_id]) : nil) %>
<%# D21 — the firm's chosen columns (or the list's own, CapitalDistribution::LIST_COLUMNS), sorted, searched and
    paged in the page by jQuery DataTables (sortable: false, pagy: nil). openspec/changes/grid-columns-inline-settings — H20, E28 %>
<% distributions_table = RansackTable.new(CapitalDistribution, q: @q, default_columns_map: CapitalDistribution::LIST_COLUMNS,
                                          current_user: current_user, records: capital_distributions, report_id: params["report_id"],
                                          turbo_frame: "capital_distributions_frame", referrer: request.referrer, pagy: nil,
                                          table_css_class: "jqDataTable", sortable: false) %>
<div data-controller="datatable tooltip" data-datatable-responsive-details-value=true
     data-datatable-money-columns-value="<%= distributions_table.money_column_indexes %>">
  <%= render distributions_table %>
</div>
