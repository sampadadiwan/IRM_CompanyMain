<%# Rule library: CapHive packs (published ones for customers) and the firm's own entity packs %>
<% frame = with_frame("compliance_packs_frame") %>
<%= render "/layouts/filter", associations: [], url: compliance_packs_path, form_html: { data: { turbo_frame: frame } } %>

<%= render ReportingComponent.new do %>
  <%= turbo_frame_tag frame, target: "_top" do %>
    <%= render "compliance_packs/index", packs: @packs %>
  <% end %>
<% end %>
