<%# One document's facts with quote and page (H40); confirm or correct (E66, E67); retry or enter by hand
    (X45, X46). Confirm answers by Turbo stream and replaces the facts card (confirm.turbo_stream.erb). %>
<div class="container-fluid mw-100 p-3">
  <%= render layout: "compliance_shared/header", locals: { title: "Facts — #{@reading.document.name}", icon: :fact } do %>
    <%= link_to document_readings_path, class: "btn btn-outline-primary d-inline-flex align-items-center" do %><%= cmp_icon(:fact) %>All facts to confirm<% end %>
  <% end %>
  <%= render "document_facts/reading", reading: @reading, input: @input %>

  <%# Actions row (capital_calls/show). Confirm facts is the button under the facts table %>
  <% editor = policy(@reading).confirm? %>
  <div class="d-flex flex-wrap gap-2" id="reading_actions">
    <div class="btn-group">
      <div class="dropdown">
        <button id="reading_actions_btn" class="btn btn-outline-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="ti ti-settings"></i> Actions
        </button>
        <div class="dropdown-menu" aria-labelledby="reading_actions_btn">
          <% if editor %>
            <%= button_to read_now_document_readings_path(document_id: @reading.document_id, input_key: @reading.input_key), class: "dropdown-item ti ti-scan",
                          id: "reading_read_now_btn", form_class: "d-inline",
                          data: { action: "click->confirm#popup", title: "Read this document again?",
                                  msg: "The AI reads the document again and counts against this month's reading cap. Facts already confirmed for unchanged values are kept." } do %> Read again<% end %>
            <%= link_to " Enter facts by hand", new_document_reading_path(document_id: @reading.document_id, input_key: @reading.input_key),
                        class: "dropdown-item ti ti-edit", id: "reading_manual_btn", title: "Type the facts yourself — nothing is sent to AI" %>
          <% end %>
          <% if policy(@reading.document).show? %>
            <%= link_to " View document", document_path(@reading.document), class: "dropdown-item ti ti-file-text", id: "reading_document_btn",
                        title: "Open the document itself" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
