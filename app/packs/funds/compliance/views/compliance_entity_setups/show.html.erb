<%# Setup: inputs (✓/✗), per-fund figures, reference lists with dates, owner and monitoring %>
<%= render FormCard.new(title: "Compliance setup") do %>
  <% if flash[:alert] %><div class="alert alert-danger" id="setup_error"><%= flash[:alert] %></div><% end %>
  <table class="table table-bordered" id="setup_inputs">
    <thead><tr><th>Input</th><th>Used by</th><th>Status</th></tr></thead>
    <tbody>
      <% @inputs.each do |inp| %>
        <tr id="input_<%= inp.key %>"><td><%= inp.label %></td><td><%= inp.packs.join(", ") %></td>
          <td><%= inp.missing? ? "✗ #{inp.missing_funds.any? ? "missing for #{inp.missing_funds.join(', ')}" : 'not mapped'}" : "✓" %></td></tr>
      <% end %>
    </tbody>
  </table>
  <p>Monitoring: <strong id="monitoring_state"><%= @setup.monitoring_enabled ? "on" : "off" %></strong>
    · Owner: <%= @setup.owner&.full_name || "—" %></p>
  <% if policy(@setup).update? %>
    <%= form_with model: @setup, url: compliance_entity_setup_path, method: :patch do |f| %>
      <%= hidden_field_tag "compliance_entity_setup[monitoring_enabled]", @setup.monitoring_enabled ? "0" : "1" %>
      <%= f.submit(@setup.monitoring_enabled ? "Turn monitoring off" : "Turn monitoring on", class: "btn btn-primary") %>
    <% end %>
  <% end %>
  <p class="mt-3">Describe in words (AI drafting of checks): <strong id="ai_drafting_state"><%= @setup.ai_drafting_enabled? ? "on" : "off" %></strong></p>
  <% if policy(@setup).update? %>
    <%= form_with model: @setup, url: compliance_entity_setup_path, method: :patch do |f| %>
      <%= hidden_field_tag "compliance_entity_setup[ai_drafting]", @setup.ai_drafting_enabled? ? "0" : "1" %>
      <%= f.submit(@setup.ai_drafting_enabled? ? "Turn Describe in words off" : "Turn Describe in words on", class: "btn btn-outline-primary") %>
    <% end %>
  <% end %>
  <%# Phase 3: AI document reading — off until turned on per document input; monthly cap (E74, E75) %>
  <% doc_inputs = ComplianceDocumentInputs.for(@setup.entity) %>
  <% if doc_inputs.any? %>
    <h6 class="mt-3">AI document reading</h6>
    <p class="text-muted">AI reads each document once when it is uploaded or replaced; a person confirms the facts before they count.
      Monthly cap: <strong id="reading_cap"><%= DocumentReadingQueue.cap(@setup) %></strong> documents
      (<%= DocumentReading.sent_in_month(@setup.entity_id, Time.current).count %> read this month).</p>
    <table class="table table-bordered align-middle" id="ai_reading">
      <thead><tr><th>Document</th><th>Facts read</th><th>Reading</th><th></th></tr></thead>
      <tbody>
        <% doc_inputs.each_value do |inp| %>
          <% on = DocumentReadingQueue.enabled?(@setup, inp.key) %>
          <tr id="reading_<%= inp.key %>">
            <td><%= inp.label %></td>
            <td><%= inp.facts.map { |f| f["label"].presence || f["key"].humanize }.join(", ").presence || "Notes only" %></td>
            <td><span class="badge bg-<%= on ? 'success' : 'secondary' %>-subtle text-<%= on ? 'success' : 'secondary' %>"><%= on ? "On" : "Off" %></span></td>
            <td>
              <% if policy(@setup).update? %>
                <%= form_with model: @setup, url: compliance_entity_setup_path, method: :patch do |f| %>
                  <%= hidden_field_tag "compliance_entity_setup[ai_reading][#{inp.key}]", on ? "0" : "1" %>
                  <%= f.submit(on ? "Turn reading off" : "Turn reading on", class: "btn btn-sm btn-outline-primary") %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
