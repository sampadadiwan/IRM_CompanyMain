<%# The Home pane of the Compliance hub: every visible fund, its packs and open items. Funds with no pack are
    "Not monitored" (E10). The hub draws the section bar, so this header has none. %>
<%# R175: the standard grid filter over the funds (Fund's own ransack allowlist), opened by the Filter button %>
<%= render "/layouts/filter", associations: [], url: compliance_home_path, hidden_fields: { tab: ComplianceHub.pane_id(:home) },
           form_html: { data: { turbo_frame: "_top" } } %>
<%= render layout: "compliance_shared/header", locals: { intro: :home, title: "Compliance", icon: :compliance, no_section_bar: true } do %>
  <%= link_to compliance_home_path(filter: true, q: params[:q]&.to_unsafe_h.presence, tab: ComplianceHub.pane_id(:home)),
              class: "btn btn-outline-primary d-inline-flex align-items-center", id: "funds_filter_btn",
              data: { bs_toggle: "tooltip", bs_title: "Filter the funds by name, category, currency or dates" } do %>
    <%= cmp_icon(:filter) %>Filter
  <% end %>
  <% if ComplianceAccess.editor?(current_user) %>
    <%# Attach without a fund chosen; each row's Attach button chooses its fund (E203) %>
    <%= link_to new_fund_compliance_pack_path, class: "btn btn-outline-primary d-inline-flex align-items-center", id: "attach_pack_btn",
                data: { turbo_frame: "remote_modal" } do %>
      <%= cmp_icon(:new) %>Attach pack
    <% end %>
  <% end %>
  <%# Register, Duties and Facts are on the section bar above (H89) — only Manage stays here %>
  <div class="dropdown">
    <button class="btn btn-outline-success dropdown-toggle d-inline-flex align-items-center" type="button" id="compliance_manage_btn"
            data-bs-toggle="dropdown" aria-expanded="false">
      <%= cmp_icon(:setup) %>Manage
    </button>
    <div class="dropdown-menu" aria-labelledby="compliance_manage_btn">
      <%= link_to compliance_packs_path, class: "dropdown-item" do %><%= cmp_icon(:pack) %>Rule library<% end %>
      <%= link_to compliance_entity_setup_path, class: "dropdown-item" do %><%= cmp_icon(:setup) %>Setup<% end %>
    </div>
  </div>
<% end %>

<%# ⑩ H86 / E184 / E185: which run these results come from, and when the next one is %>
<%= cmp_timing_banner(@setup, last_success: @last_success, failed_since: @failed_since) %>
<%# ⑩ H80–H83: the 8 setup steps, folded to one line once complete %>
<%= render "compliance_shared/getting_started" %>

<%# R175 / E203: the one funds grid — fund × attached packs, open items, Attach / View on every row %>
<%= render "compliance_shared/funds_grid", grid: @grid %>
