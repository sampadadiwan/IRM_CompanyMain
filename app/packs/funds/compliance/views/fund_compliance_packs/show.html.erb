<%# The fund's compliance dashboard (also its Compliance tab on the fund page) %>
<% fp = @fund_pack %>
<% editor = ComplianceAccess.editor?(current_user) %>
<% upcoming = @dashboard.upcoming_versions.select { |f, _v| f.id == fp.id }.map(&:last) %>
<div class="container-fluid mw-100 p-3">
  <%= render layout: "compliance_shared/header", locals: { title: "#{@dashboard.fund.name} — Compliance", icon: :compliance } do %>
    <%= cmp_header_link "Register", compliance_register_items_path(fund_id: @dashboard.fund.id), icon: :register %>
    <%= cmp_header_link "Fund page", fund_path(@dashboard.fund, tab: "compliance-tab"), icon: :fund %>
  <% end %>
  <%= cmp_intro(:fund_pack, anchor: "fund-packs") %>
  <%# ⑩ H86: this fund's last run and the next one %>
  <%= cmp_runs_timing_banner(fund: @dashboard.fund) %>
  <%= render "fund_compliance_packs/dashboard", dashboard: @dashboard, preview: @preview %>

  <%# Actions row for this fund pack (capital_calls/show): Run now is on the dashboard; the rest are
      maker–checker requests or previews, each gated by role %>
  <div class="d-flex flex-wrap gap-2" id="fund_pack_actions">
    <div class="btn-group">
      <div class="dropdown">
        <button id="fund_pack_actions_btn" class="btn btn-outline-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="ti ti-settings"></i> Actions — <%= fp.pack_name %>
        </button>
        <div class="dropdown-menu" aria-labelledby="fund_pack_actions_btn">
          <% upcoming.each do |v| %>
            <%= link_to " Preview #{v.label}", preview_fund_compliance_pack_path(fp, version_id: v.id), class: "dropdown-item ti ti-eye",
                        id: "fund_pack_preview_#{v.id}_btn", title: "How this fund would score under #{v.label} today — nothing is stored" %>
          <% end %>
          <% if editor && fp.active? %>
            <a href="#" class="dropdown-item ti ti-tag" id="fund_pack_classification_btn" data-bs-toggle="modal" data-bs-target="#classificationModal"
               title="Ask an approver to change which part of the pack applies"> Change classification</a>
            <% if upcoming.any?(&:allows_early_adoption) %>
              <a href="#" class="dropdown-item ti ti-fast-forward" id="fund_pack_early_btn" data-bs-toggle="modal" data-bs-target="#earlyAdoptionModal"
                 title="Ask an approver to move this fund to the next version before its effective date"> Adopt next version early</a>
            <% end %>
            <a href="#" class="dropdown-item ti ti-unlink" id="fund_pack_detach_btn" data-bs-toggle="modal" data-bs-target="#detachModal"
               title="Ask an approver to remove this pack from the fund; open items close, history stays"> Detach pack</a>
          <% end %>
          <%= link_to " Pack in the Rule library", compliance_pack_path(fp.compliance_pack), class: "dropdown-item ti ti-book", id: "fund_pack_library_btn",
                      title: "The pack's versions, checks and duties" %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if editor && fp.active? %>
  <% early = upcoming.detect(&:allows_early_adoption) %>
  <% modals = { "classification" => ["classificationModal", "Change classification", "ti-tag", [:classification],
                                     "Maker–checker: an approver other than you must approve. The new classification applies from the next run."],
                "detach" => ["detachModal", "Detach pack", "ti-unlink", [],
                             "Maker–checker: once approved, this pack stops running for the fund and its open items close as Pack detached. History stays."] } %>
  <% if early %>
    <% modals["early_adoption"] = ["earlyAdoptionModal", "Adopt #{early.label} early", "ti-fast-forward", [],
                                   "Maker–checker: once approved, the fund moves to #{early.label} at the next run. It cannot move back."] %>
  <% end %>
  <% modals.each do |kind, (modal_id, title, icon, fields, help)| %>
    <div class="modal fade" id="<%= modal_id %>" tabindex="-1" aria-labelledby="<%= modal_id %>Label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="<%= modal_id %>Label"><i class="ti <%= icon %> me-1"></i><%= title %> — <%= fp.pack_name %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <%= cmp_explainer(help) %>
            <%= render "compliance_shared/request_form", target: fp, kind:, label: "Send for approval", fields:,
                       hidden_payload: kind == "early_adoption" ? { version_id: early.id } : {} %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
