<%# Setup › Funds: which packs each fund carries, and attaching one (classification per pack). A fund ×
    pack matrix has one column per pack, so it is the standard table rather than a RansackTable (R111). %>
<%= render layout: "compliance_shared/header", locals: { title: "Fund packs", icon: :fund_pack } do %>
  <% if ComplianceAccess.editor?(current_user) %>
    <button type="button" class="btn btn-outline-primary d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#attachPackModal" id="attach_pack_btn">
      <%= cmp_icon(:new) %>Attach pack
    </button>
  <% end %>
  <%= cmp_header_link "Rule library", compliance_packs_path, icon: :pack %>
<% end %>

<%= cmp_intro(:fund_packs, anchor: "fund-packs") %>

<%
  all_fps = @fund_packs.values.flatten
  active_fps = all_fps.select(&:active?)
  monitored = @funds.count { |f| (@fund_packs[f.id] || []).any?(&:active?) }
  unclassified = active_fps.count { |fp| fp.classification.blank? }
  cards = [
    { stat: monitored, subtitle: "Funds monitored", colour: "success", icon: :compliance, tooltip: "Funds with at least one active pack attached" },
    { stat: @funds.size - monitored, subtitle: "Not monitored", colour: "secondary", icon: :warning,
      tooltip: "Funds with no pack: nothing is checked, and they are never shown as compliant" },
    { stat: active_fps.size, subtitle: "Packs attached", colour: "info", icon: :fund_pack, tooltip: "Active fund–pack attachments across your funds" }
  ]
  if unclassified.positive?
    cards << { stat: unclassified, subtitle: "Need a classification", colour: "danger", icon: :warning,
               tooltip: "Attachments with no classification run no checks until one is set" }
  end
%>
<%= cmp_stats(cards, id: "fund_packs_stats") %>

<% if @funds.empty? || @packs.empty? %>
  <div class="alert alert-secondary d-flex align-items-start gap-2"><%= cmp_icon(:fund_pack, "fs-5 flex-shrink-0") %>
    <div><%= @packs.empty? ? "No packs you can attach yet — create an entity pack in the Rule library." : "No funds you can see yet." %>
      <%= link_to "Rule library", compliance_packs_path, class: "btn btn-sm btn-outline-primary ms-2" if @packs.empty? %></div></div>
<% else %>
  <div class="table-responsive">
    <table class="table table-bordered dataTable action_table hover" id="fund_pack_grid">
      <thead>
        <tr>
          <th class="text-col">Fund</th>
          <% @packs.each do |p| %>
            <th class="text-col"><%= p.name %> <%= cmp_tip("The classification this fund has under #{p.name}. — means not attached") %></th>
          <% end %>
          <th class="action-col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @funds.each do |fund| %>
          <tr id="grid_fund_<%= fund.id %>">
            <td class="text-col"><%= cmp_icon(:fund) %><%= fund.name %></td>
            <% @packs.each do |p| %>
              <% fp = (@fund_packs[fund.id] || []).detect { |x| x.compliance_pack_id == p.id } %>
              <td class="text-col">
                <% if fp.nil? %>
                  —
                <% elsif !fp.active? %>
                  <%= cmp_badge("#{fp.classification.presence || 'No classification'} (detached)", "secondary") %>
                <% elsif fp.classification.blank? %>
                  <%= cmp_badge("Choose a classification", "danger", :warning) %>
                <% else %>
                  <%= link_to fund_compliance_pack_path(fp) do %><%= cmp_badge(fp.classification, "success", :pass) %><% end %>
                <% end %>
              </td>
            <% end %>
            <td class="action-col">
              <% first = (@fund_packs[fund.id] || []).detect(&:active?) %>
              <% if first %>
                <%= link_to t_common(:view), fund_compliance_pack_path(first), class: "btn btn-outline-primary ti ti-eye",
                            data: { bs_toggle: "tooltip", bs_title: "Open #{fund.name}'s compliance dashboard" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if ComplianceAccess.editor?(current_user) %>
  <div class="modal fade" id="attachPackModal" tabindex="-1" aria-labelledby="attachPackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <%= form_with url: fund_compliance_packs_path, scope: :fund_compliance_pack, method: :post, id: "attach_pack_form" do |f| %>
          <div class="modal-header">
            <h5 class="modal-title" id="attachPackModalLabel"><%= cmp_icon(:fund_pack) %>Attach a pack to a fund</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <%= f.label :fund_id, class: "form-label" do %>Fund <%= cmp_tip("The fund whose data the pack's checks will read every night") %><% end %>
              <%= f.select :fund_id, @funds.map { |x| [x.name, x.id] }, {}, class: "form-select" %>
            </div>
            <div class="mb-3">
              <%= f.label :compliance_pack_id, class: "form-label" do %>Pack <%= cmp_tip("A CapHive regulator pack (locked) or one of your own entity packs") %><% end %>
              <%= f.select :compliance_pack_id, @packs.select(&:attachable?).map { |x| [x.name, x.id] }, {}, class: "form-select" %>
            </div>
            <div class="mb-3">
              <%= f.label :classification, class: "form-label" do %>Classification <%= cmp_tip("Which part of the pack applies, e.g. Category II. Changing it later needs an approver") %><% end %>
              <%= f.text_field :classification, class: "form-control" %>
              <small class="form-text text-muted d-block">Leave blank to use the fund's Category when the pack has it.</small>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
            <%= f.button type: "submit", class: "btn btn-outline-primary" do %><%= cmp_icon(:fund_pack) %>Attach pack<% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
