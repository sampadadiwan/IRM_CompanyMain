<%# The fund's compliance dashboard: run health, stats cards, version banners and the latest result per
    check, one tab per attached pack. Shared by the fund-pack page and the fund page's Compliance tab. %>
<% d = dashboard %>
<% preview = local_assigns[:preview] %>
<% c = d.counts %>
<% last = d.last_success %>
<% if d.fund_packs.empty? %>
  <div class="alert alert-secondary d-flex align-items-start gap-2" id="no_packs_attached">
    <%= cmp_icon(:fund_pack, "fs-5 flex-shrink-0") %>
    <div>No packs attached — nothing is checked for <%= d.fund.name %>, so it shows as Not monitored (never as compliant).
      <% if ComplianceAccess.editor?(current_user) %>
        <%# E203: the attach modal with this fund chosen; its own remote_modal frame (the fund page has none) %>
        <%= link_to new_fund_compliance_pack_path(fund_id: d.fund.id), class: "btn btn-sm btn-outline-primary ms-2", id: "dashboard_attach_btn",
                    data: { turbo_frame: "remote_modal" } do %><%= cmp_icon(:fund_pack) %>Attach a pack<% end %>
      <% end %></div>
  </div>
  <%= render "compliance_shared/remote_modal" if ComplianceAccess.editor?(current_user) %>
<% else %>
  <%
    cards = [
      { stat: c["breach"], subtitle: "Breach", colour: "danger", icon: :breach, tooltip: "Checks whose latest result is outside the limit — each has an open register item" },
      { stat: c["needs_review"], subtitle: "Needs review", colour: "info", icon: :needs_review, tooltip: "Checks a person must look at; they are never counted as a pass" },
      { stat: c["pass"], subtitle: "Pass", colour: "success", icon: :pass, tooltip: "Checks within their limit on the latest run" }
    ]
    if c["could_not_check"].positive?
      cards << { stat: c["could_not_check"], subtitle: "Could not check", colour: "secondary", icon: :could_not_check,
                 tooltip: "Something was missing (an input, a rate, a date) — the result names it. Never a pass" }
    end
    if c["warning"].positive?
      cards << { stat: c["warning"], subtitle: "In transition", colour: "info", icon: :warning,
                 tooltip: "Fails a new version's rule during its transition period — shown as a warning, no register item" }
    end
    cards << { stat: last ? l(last.finished_at, format: :abbr_date_time) : "—", subtitle: d.stale? ? "Last run — stale" : "Last run",
               colour: d.stale? ? "danger" : "secondary", icon: :run,
               tooltip: "When the last successful nightly run finished. Older than 26 hours means results may be out of date" }
  %>
  <%= cmp_stats(cards, id: "fund_compliance_stats") %>

  <div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="run_health">
    <% if last.nil? %>
      <%= cmp_badge("No successful run yet", "secondary", :run) %>
    <% elsif d.stale? %>
      <%= cmp_badge("Last successful run #{l(last.finished_at, format: :abbr_date_time)} — results may be out of date", "danger", :run) %>
    <% else %>
      <%= cmp_badge("Last successful run #{l(last.finished_at, format: :abbr_date_time)}", "success", :run) %>
    <% end %>
    <span class="text-muted small"><%= c["breach"] %> breaches · <%= c["needs_review"] %> needs review · <%= c["could_not_check"] %> could not check · <%= c["pass"] %> pass</span>
    <% if policy(d.fund_packs.first).run_now? %>
      <%= button_to run_now_fund_compliance_pack_path(d.fund_packs.first), class: "btn btn-outline-primary", form_class: "d-inline ms-auto",
                    id: "run_now_btn", data: { bs_toggle: "tooltip", bs_title: "Run every check of this fund now. Results update when the run finishes" } do %>
        <%= cmp_icon(:run) %>Run now
      <% end %>
    <% end %>
  </div>

  <% d.unclassified.each do |fp| %>
    <div class="alert alert-danger d-flex align-items-start gap-2"><%= cmp_icon(:warning, "fs-5 flex-shrink-0") %>
      <div><%= fp.pack_name %>: no classification — no checks run. Ask an approver to set it.</div></div>
  <% end %>
  <% d.upcoming_versions.each do |fp, v| %>
    <div class="alert alert-info d-flex align-items-start gap-2" id="upcoming_<%= v.id %>">
      <%= cmp_icon(:version, "fs-5 flex-shrink-0") %>
      <div><%= fp.pack_name %> <%= v.label %> coming into effect <%= l(v.effective_from) %> ·
        <%= link_to preview_fund_compliance_pack_path(fp, version_id: v.id), class: "btn btn-sm btn-outline-primary ms-1", data: { turbo_frame: "_top" } do %><%= cmp_icon(:view) %>Preview<% end %></div>
    </div>
  <% end %>

  <% if preview %>
    <div class="card shadow-sm border-0 mb-4" id="version_preview">
      <div class="card-header border-bottom py-3">
        <h5 class="mb-0 fw-bold"><%= cmp_icon(:view, "me-2 text-info") %>Under <%= preview.version.label %> (preview — nothing is logged)
          <%= cmp_tip("How this fund would score under the new version today. Nothing is stored and no register item opens") %></h5>
      </div>
      <div class="card-body">
        <% if preview.not_applicable %>
          <p class="mb-0">This version will not apply to this fund</p>
        <% else %>
          <table class="table table-bordered dataTable action_table hover mb-0">
            <thead><tr><th class="text-col">Check</th><th class="text-col">Would show</th><th class="text-col">Result</th></tr></thead>
            <tbody>
              <% preview.rows.each do |row| %>
                <tr><td class="text-col"><%= row.name %>
                    <% if row.working.present? %>
                      <details class="mt-1"><summary class="text-muted small">How we checked</summary>
                        <%= render "compliance_shared/working", working: row.working, outcome: row.outcome, fund: d.fund %>
                      </details>
                    <% end %></td>
                  <td class="text-col"><%= row.working&.dig("verdict").presence || row.message || row.outcome.humanize %></td>
                  <td class="text-col"><%= cmp_outcome_badge(row.outcome) %></td></tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# One lazy pill per attached pack (funds/_owner_fund_details pattern): each pane loads that pack's
      latest results into its own frame %>
  <div class="associated_entity" data-controller="tabs">
    <nav class="nav nav-pills nav-justified p-3 mb-3 rounded align-items-center card flex-row" role="tablist" id="fund_pack_tabs">
      <% d.fund_packs.each_with_index do |fp, i| %>
        <a class="nav-link <%= 'active' if i.zero? %>" data-bs-toggle="pill" href="#pack-<%= fp.id %>-tab" id="pack_tab_<%= fp.id %>">
          <%= cmp_icon(:pack) %><%= fp.pack_name %> <%= fp.compliance_pack_version&.label %><%= " · #{fp.classification}" if fp.classification.present? %>
        </a>
      <% end %>
    </nav>
    <div class="tab-content">
      <% d.fund_packs.each_with_index do |fp, i| %>
        <div id="pack-<%= fp.id %>-tab" class="tab-pane fade in <%= 'show active' if i.zero? %>">
          <%= turbo_frame_tag "pack_#{fp.id}_results", src: fund_compliance_pack_path(fp, pane: "results"), loading: :lazy, target: "_top" do %>
            <%= render "/layouts/loading" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
