<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Helvetica, Arial, sans-serif; font-size: 11px; color: #222; }
    h1 { font-size: 16px; margin: 0; } h2 { font-size: 14px; margin: 18px 0 6px; }
    .meta { color: #666; margin-bottom: 8px; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: right; border-bottom: 1px solid #999; padding: 3px 4px; } th:first-child { text-align: left; }
    td { padding: 2px 4px; } td.num { text-align: right; white-space: nowrap; }
    tr.heading td { font-weight: bold; background: #f3f3f3; } tr.total td { font-weight: bold; border-top: 1px solid #999; }
    td.indent { padding-left: 18px; } .note { font-weight: normal; color: #777; font-size: 9px; }
    .section { page-break-after: always; } .section:last-child { page-break-after: auto; }
    /* DRAFT watermark repeated on every page (Chrome repeats fixed elements on each printed page) */
    .watermark { position: fixed; top: 40%; left: 10%; font-size: 120px; color: rgba(200, 0, 0, 0.12); transform: rotate(-30deg); z-index: 0; }
  </style>
</head>
<body>
  <% unless @financial_statement.locked? %><div class="watermark">DRAFT</div><% end %>
  <% @financial_statement.statements.each do |statement_data| %>
    <div class="section">
      <h1><%= @fund.name %></h1>
      <h2><%= statement_data["name"] %><%= " — DRAFT" unless @financial_statement.locked? %></h2>
      <div class="meta"><%= @financial_statement.period_label %> · <%= @fund.currency %>
        <% if @financial_statement.locked? %> · Locked on <%= l(@financial_statement.locked_at.to_date) %><% end %></div>
      <table>
        <tr>
          <th></th>
          <% statement_data["columns"].each do |column| %>
            <th><%= column["label"] %><% if column["note"].present? %><br><span class="note"><%= column["note"] %></span><% end %></th>
          <% end %>
        </tr>
        <% statement_data["rows"].each do |row| %>
          <% type = row["row_type"] %>
          <tr class="<%= 'heading' if type == 'heading' %> <%= 'total' if %w[subtotal net_result opening closing].include?(type) %>">
            <td class="<%= 'indent' if type == 'account' %>"><%= row["label"] %></td>
            <% statement_data["columns"].each do |column| %>
              <td class="num"><%= fs_amount(row["values"][column["key"]], @fund) unless type == "heading" %></td>
            <% end %>
          </tr>
        <% end %>
        <% if statement_data["balance_line"] %>
          <tr class="total">
            <td>Assets = Liabilities + Partners' capital</td>
            <% statement_data["columns"].each do |column| %>
              <% line = statement_data["balance_line"][column["key"]] %>
              <td class="num"><%= fs_amount(line["assets"], @fund) %> = <%= fs_amount(line["liabilities"], @fund) %> + <%= fs_amount(line["capital"], @fund) %><%= line["balanced"] ? " ✓" : " ✗" %></td>
            <% end %>
          </tr>
        <% end %>
      </table>
    </div>
  <% end %>
  <div class="section">
    <h2>Checks</h2>
    <table>
      <% @financial_statement.checks_list.each do |check| %>
        <tr><td><%= fs_check_label(check) %></td><td><%= check["status"].capitalize %></td>
          <td class="num"><%= fs_amount(check["diff"], @fund, decimals: 2) if check["diff"] %></td><td><%= check["note"] %></td></tr>
      <% end %>
    </table>
  </div>
</body>
</html>
