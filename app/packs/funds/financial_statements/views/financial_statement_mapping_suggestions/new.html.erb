<%# Suggest from statements (journey step A3, route 1): upload last year's statements for an AI draft. %>
<%= render "financial_statements/tabs", fund: @fund, active: "mapping" %>
<div class="row">
  <div class="col-lg-6 mb-4">
    <%= render FormCard.new(title: "Suggest the mapping from existing statements") do %>
      <%= form_with(model: @suggestion, id: "fs_suggestion_form", multipart: true) do |form| %>
        <%= render "financial_statement_accounts/errors", record: @suggestion %>
        <%= form.hidden_field :fund_id %>
        <p class="small text-muted">Upload any of the fund's financial statements (e.g. last year's). The AI reads which statements and lines it
          has, and proposes which of the fund's account entries make up each line. Any period is fine — amounts aren't compared, only the
          mapping is proposed. <strong>Nothing is saved until you approve the draft.</strong></p>
        <div class="form-group mb-3">
          <%= form.label :file, "Statements (PDF or Excel, up to 20 MB)" %>
          <%= form.file_field :file, class: "form-control", accept: ".pdf,.xlsx,.xls" %>
        </div>
        <%= form.submit "Read the statements", class: "btn btn-outline-primary", data: { disable_with: "Uploading…" } %>
      <% end %>
    <% end %>
  </div>
  <div class="col-lg-6 mb-4">
    <div class="card shadow-sm">
      <div class="card-header bg-white"><h6 class="mb-0">What happens next</h6></div>
      <div class="card-body small">
        <ol class="ps-3 mb-0">
          <li>CapHive reads the file's text and lists the fund's account entries.</li>
          <li>The AI proposes each printed line, its type and which entries make it up. It can only use entries the fund has.</li>
          <li>You check the mapping: add entries to lines that have none, decide where unused entries go.</li>
          <li><strong>Approve</strong> saves the accounts, layout and mapping; <strong>Discard</strong> throws the draft away.</li>
        </ol>
        <p class="mt-2 mb-0 text-muted">The AI sees only the file and the fund's entry types, names and totals — no investor data.</p>
      </div>
    </div>
  </div>
</div>
