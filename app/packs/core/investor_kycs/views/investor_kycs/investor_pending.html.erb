<div class="container-fluid">
  <h2>Pending KYC Requests</h2>
  <p class="text-muted">KYC forms requested by funds that are awaiting your submission.</p>

  <% if @investor_kycs.empty? %>
    <div class="alert alert-success">No pending KYC requests. All submissions are up to date.</div>
  <% else %>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Fund</th>
          <th>Investor</th>
          <th>KYC Type</th>
          <th>Status</th>
          <th>Link Sent</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @investor_kycs.each do |kyc| %>
          <%
            badge_class = case kyc.submission_status
                          when "draft_saved" then "bg-warning text-dark"
                          when "link_sent"   then "bg-info text-dark"
                          else "bg-secondary"
                          end
          %>
          <tr>
            <td><%= kyc.entity.name %></td>
            <td><%= kyc.investor&.investor_name %></td>
            <td><%= kyc.kyc_type.to_s.humanize %></td>
            <td><span class="badge <%= badge_class %>"><%= kyc.submission_status.humanize %></span></td>
            <td><%= kyc.link_sent_at.present? ? I18n.l(kyc.link_sent_at, format: :short) : '—' %></td>
            <td><%= link_to "Fill in KYC", edit_investor_kyc_path(kyc), class: "btn btn-sm btn-outline-primary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
