
<%
  ckyc_enabled = @investor_kyc.entity.permissions.enable_ckyc?
  ckyc_data = ckyc_enabled ? @investor_kyc.ckyc_data : nil
  kra_enabled = @investor_kyc.entity.permissions.enable_kra?
  kra_data = kra_enabled ? @investor_kyc.kra_data : nil
  show_onboarding_agent = @investor_kyc.entity.support_agents.set?(:kyc_onboarding_agent) && @investor_kyc.support_agent_report.present?
  investor_facing = params[:signed_id].present? || current_user&.curr_role_investor?
  kyc_locked = @investor_kyc.submission_completed? || @investor_kyc.submission_verified?
%>

<!-- Show the KYC Onboarding Agent details if set -->
<%= render "/investor_kycs/kyc_onboarding_agent", investor_kyc: @investor_kyc if show_onboarding_agent %>

<div class="container-fluid p-3">
  <%# KYC journey (step bar + what's needed now) for fund users; nothing renders without one or for investors.
      Worked examples H2, X1 — openspec/changes/investor-kyc-journey/design.md#worked-examples %>
  <% if @journey.present? %>
    <%= render "/investor_kycs/journey", record: @investor_kyc, journey: @journey, instance: nil %>
    <%# Real-time: an evaluation that changes this KYC's journey reloads the panel above in place (E15) %>
    <%= turbo_stream_from @investor_kyc, :journey %>
  <% end %>
  <!-- Show the main KYC details -->
  <%= render "investor_kycs/show", investor_kyc: @investor_kyc, ckyc_data: ckyc_data, kra_data: kra_data %>

  <div data-controller="workflow-gate"
       data-workflow-gate-labels-value="<%= (@workflow_gated_button_labels || []).to_json %>"
       data-workflow-gate-reason-value="<%= @workflow_gate_status_label.present? ? "Blocked — workflow is #{@workflow_gate_status_label}" : '' %>">

    <% if policy(@investor_kyc).send_notification? %>
      <%= button_to send_notification_investor_kyc_path(
                      @investor_kyc,
                      message: "Investor #{@investor_kyc.investor} has requested updates/changes for KYC: #{@investor_kyc.full_name}"),
                  id: "investor_kyc_send_notification_btn", method: :put, class: "btn btn-outline-secondary", form_class: "deleteButton",
                  data: {
                    action: "click->confirm#popup",
                    method: :patch,
                    msg: "This will generate a notification to #{@investor_kyc.entity.name}, requesting for changes to be made to the KYC #{@investor_kyc.full_name}. Proceed?",
                    workflow_gate_label: "Updates Required"
                  } do %>
        <i class="ti ti-message-2"></i>Updates Required
      <% end %>
    <% end %>

  <div>
    <%# show edit button only if the user can actually edit it %>
    <% if policy(@investor_kyc).update? && !(investor_facing && kyc_locked) %>
      <%= link_to edit_investor_kyc_path(@investor_kyc), id: "investor_kyc_edit_btn", class: "btn btn-outline-primary", data: { workflow_gate_label: "Edit" } do %>
        <i class="ti ti-edit"></i> <%= t_common(:edit) %>
      <% end %>
    <% end %>

  <% unless investor_facing %>


    <% if policy(@investor_kyc).destroy? %>
      <%= button_to @investor_kyc, id: "investor_kyc_destroy_btn", method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton",
          data: { action: "click->confirm#popup", turbo: false, workflow_gate_label: "Delete" } do %>
        <i class="ti ti-trash"></i> <%= t_common(:delete) %>
      <% end %>
    <% end %>

    <% label = @investor_kyc.verified ? "UnVerify" : "Verify" %>
    <% label_class = @investor_kyc.verified ? "btn btn-outline-warning" : "btn btn-outline-success" %>
    <% label_icon = @investor_kyc.verified ? "ti ti-user-x" : "ti ti-user-check" %>
    <% if policy(@investor_kyc).toggle_verified? %>
      <%= button_to toggle_verified_investor_kyc_path(@investor_kyc), id: "investor_kyc_toggle_verified_btn", method: :put, class: label_class, form_class: "deleteButton",
          data: { workflow_gate_label: label } do %>
        <i class="<%= label_icon %>"></i><%= label %>
      <% end %>
    <% end %>

    <% if policy(@investor_kyc).request_updates? %>
      <button type="button" class="btn btn-outline-warning" data-workflow-gate-label="Request Updates"
              data-bs-toggle="modal" data-bs-target="#requestUpdatesModal">
        <i class="ti ti-refresh"></i> Request Updates
      </button>

      <%= render "investor_kycs/request_updates_modal", investor_kyc: @investor_kyc %>
    <% end %>

    <% if current_user.curr_role != "investor" %>
      <div class="btn-group">
        <div class="dropdown">
          <button class="btn btn-outline-success dropdown-toggle" type="button" id="kyc_actions"
                  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="ti ti-settings"></i>KYC Actions
          </button>
          <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">

            <%= render "/investor_kycs/send_notifications", investor_kyc: @investor_kyc %>

            <% if policy(@investor_kyc).generate_docs? %>
              <%= link_to generate_docs_investor_kyc_path(@investor_kyc), id: "investor_kyc_generate_docs_btn", class: "dropdown-item", data: { workflow_gate_label: "Generate Docs" } do %>
                <i class="ti ti-file-plus"></i>Generate Docs
              <% end %>
            <% end %>

            <%# Document Checks: the id stays — it is the journey's "Check documents" action target %>
            <% if policy(@investor_kyc).validate_docs_with_ai? && DocChecks::Kyc.can_edit?(current_user, @investor_kyc) %>
              <%= button_to doc_check_runs_path(record_type: "InvestorKyc", record_id: @investor_kyc.id),
                  id: "investor_kyc_validate_docs_with_ai_btn", method: :post, class: "dropdown-item", form_class: "deleteButton",
                  data: { turbo: false, workflow_gate_label: "Check documents" }.merge(doc_check_run_confirm_data(@investor_kyc)) do %>
                <i class="ti ti-file-search"></i><%= t("doc_checks.panel.check_documents") %>
              <% end %>
            <% end %>

            <% if policy(@investor_kyc).toggle_verified? %>
              <%= link_to investor_kyc_path(@investor_kyc, audit_trail: true, tab: "audit-trail-tab"), id: "investor_kyc_audit_trail_btn", class: "dropdown-item" do %>
                <i class="ti ti-history"></i>Audit Trail
              <% end %>
            <% end %>

            <% if ckyc_enabled %>
              <% if ckyc_data.present? %>
                <%= link_to kyc_data_path(id: ckyc_data.id), class: "dropdown-item" do %>
                <i class="ti ti-eye"></i> View CKYC Data
                <% end %>
              <% else %>
                <%= link_to new_kyc_data_path("kyc_data[investor_kyc_id]": @investor_kyc.id, "kyc_data[PAN]": @investor_kyc.PAN, "kyc_data[birth_date]": @investor_kyc.birth_date, "kyc_data[source]": "ckyc"), class: "dropdown-item" do %>
                  <i class="ti ti-file-text"></i> Fetch CKYC Data
                <% end %>
              <% end %>
            <% end %>

            <% if kra_enabled %>
              <% if kra_data.present? %>
                <%= link_to kyc_data_path(id: kra_data.id), class: "dropdown-item" do %>
                <i class="ti ti-eye"></i> View KRA Data
                <% end %>
              <% else %>
                <%= link_to new_kyc_data_path("kyc_data[investor_kyc_id]": @investor_kyc.id, "kyc_data[PAN]": @investor_kyc.PAN, "kyc_data[birth_date]": @investor_kyc.birth_date, "kyc_data[source]": "kra"), class: "dropdown-item" do%>
                  <i class="ti ti-file-text"></i> Fetch KRA Data
                <% end %>
              <% end %>
            <% end %>

            <% if ckyc_enabled && kra_enabled %>
              <%= link_to compare_ckyc_kra_kyc_datas_path(investor_kyc_id: @investor_kyc.id), class: "dropdown-item" do%>
              <i class="ti ti-file-text"></i> Assign CKYC/KRA Data
              <% end %>
            <% end %>


            <% if policy(@investor_kyc).generate_new_aml_report? %>
              <%= button_to generate_new_aml_report_investor_kyc_path(@investor_kyc), id: "investor_kyc_generate_new_aml_report_btn", method: :put, class: "dropdown-item", data: { workflow_gate_label: "Generate AML Report" } do %>
                <i class="ti ti-shield-lock"></i>Generate AML Report
              <% end %>
            <% end %>

            <% if @investor_kyc.aml_reports.present? %>
              <%= link_to aml_reports_path(investor_kyc_id: @investor_kyc.id), id: "investor_kyc_view_aml_reports_btn", class: "dropdown-item" do %>
                <i class="ti ti-list-search"></i>View AML Reports
              <% end %>
            <% end %>

            <% if @investor_kyc.entity.support_agents.set?(:kyc_onboarding_agent) %>
              <button type="button" class="dropdown-item"
                      data-bs-toggle="modal" data-bs-target="#run-kyc-onboarding-agent-modal">
                <i class="ti ti-robot"></i> Run Kyc Onboarding Agent
              </button>
            <% else %>
              <!-- kyc_onboarding_agent disabled: show greyed-out item so users know the feature exists -->
              <span class="dropdown-item disabled text-muted" style="opacity:0.65; pointer-events:auto; cursor:default;" data-bs-toggle="tooltip" data-bs-title="KYC Onboarding Agent is disabled. Contact support to enable it">
                <i class="ti ti-robot"></i> Run Kyc Onboarding Agent
                <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
              </span>
            <% end %>

        </div>
      </div>
    </div>

    <% if @investor_kyc.entity.support_agents.set?(:kyc_onboarding_agent) %>
      <%= render "support_agents/agent_run_modal",
                 modal_id:         "run-kyc-onboarding-agent-modal",
                 agent_type:       "KycOnboardingAgent",
                 target_id:        @investor_kyc.id,
                 description:      KycOnboardingAgent::DESCRIPTION,
                 long_description: KycOnboardingAgent::SINGLE_LONG_DESCRIPTION,
                 btn_text:         "Run Kyc Onboarding Agent" %>
    <% end %>

    <% if policy(@investor_kyc).preview? %>
      <div class="btn-group">
        <div class="dropdown">
          <button class="btn btn-outline-primary dropdown-toggle" type="button"
                  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="ti ti-settings"></i> Preview Notifications
          </button>
          <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">

            <%= render "/investor_kycs/preview_notifications", investor_kyc: @investor_kyc %>

          </div>
        </div>
      </div>
    <% end %>

    <% else %>

      <div class="btn-group">
        <div class="dropdown">
          <button class="btn btn-outline-success dropdown-toggle" type="button" id="kyc_actions"
                  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="ti ti-settings"></i>KYC Actions
          </button>
          <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">

            <% if ckyc_enabled %>
              <% if ckyc_data.present? %>
                <%= link_to kyc_data_path(id: ckyc_data.id), class: "dropdown-item" do %>
                <i class="ti ti-eye"></i> View CKYC Data
                <% end %>
              <% else %>
                <%= link_to new_kyc_data_path("kyc_data[investor_kyc_id]": @investor_kyc.id, "kyc_data[PAN]": @investor_kyc.PAN, "kyc_data[birth_date]": @investor_kyc.birth_date, "kyc_data[source]": "ckyc"), class: "dropdown-item" do %>
                  <i class="ti ti-file-text"></i> Fetch CKYC Data
                <% end %>
              <% end %>
            <% end %>

            <% if kra_enabled %>
              <% if kra_data.present? %>
                <%= link_to kyc_data_path(id: kra_data.id), class: "dropdown-item" do %>
                <i class="ti ti-eye"></i> View KRA Data
                <% end %>
              <% else %>
                <%= link_to new_kyc_data_path("kyc_data[investor_kyc_id]": @investor_kyc.id, "kyc_data[PAN]": @investor_kyc.PAN, "kyc_data[birth_date]": @investor_kyc.birth_date, "kyc_data[source]": "kra"), class: "dropdown-item" do%>
                  <i class="ti ti-file-text"></i> Fetch KRA Data
                <% end %>
              <% end %>
            <% end %>

          </div>
        </div>
      </div>
    <% end %>

  <% end %>
  </div>

</div>

<%= render "investor_kycs/details", investor_kyc: @investor_kyc %>
