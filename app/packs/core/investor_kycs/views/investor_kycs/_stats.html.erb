<%
  records ||= @all_investor_kycs || @investor_kycs || policy_scope(current_user.entity.investor_kycs)
%>
<% cache_if(current_user != nil && params[:q].blank? && params[:support_agent_report].blank?, cache_key(["kyc_stats", records.cache_key_with_version]), expires_in: 5.day) do %>
  <%
    kyc_types = {
      verified: { path: investor_kycs_path(q: ransack_query_params("verified", :eq, true)), subtitle: "Verified", progress_bar_color: "success", icon: "check" },
      unverified: { path: investor_kycs_path(q: ransack_query_params("verified", :eq, false)), subtitle: "Unverified", progress_bar_color: "warning", icon: "question-mark" },
      completed: { path: investor_kycs_path(q: ransack_query_params("completed_by_investor", :eq, true)), subtitle: "Completed", progress_bar_color: "info", icon: "circle-dashed-check" },
      expired: { path: investor_kycs_path(q: ransack_query_params("expiry_date", :lt, Date.today)), subtitle: "Expired", progress_bar_color: "danger", icon: "x" },
      individual: { path: investor_kycs_path(q: ransack_query_params("kyc_type", :eq, "Individual")), subtitle: "Individual", progress_bar_color: "primary", icon: "user" },
      non_individual: { path: investor_kycs_path(q: ransack_query_params("kyc_type", :eq, "Non Individual")), subtitle: "Non Individual", progress_bar_color: "secondary", icon: "building" }
    }
  %>
  <%# Same border-top stat cards as every other list page (NumberStatsComponent): the colour
      drives the top border, label and icon; raw_amount keeps the count-up animation %>
  <div class="row">
    <% kyc_types.each do |type, data| %>
      <% count = records.send(type).count %>
      <%= render(NumberStatsComponent.new(
                  path: data[:path],
                  amount: count,
                  raw_amount: count,
                  subtitle: data[:subtitle],
                  progress_bar_color: data[:progress_bar_color],
                  text_info: data[:icon],
                  css_class: "col",
                  fs_size: 7
      )) %>
    <% end %>
  </div>
<% end %>
