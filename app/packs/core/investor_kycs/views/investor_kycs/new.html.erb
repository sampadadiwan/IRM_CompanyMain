<% form = "form" %>
<% form = "initial_form" if policy(@investor_kyc).ckyc_or_kra_enabled? %>

<% doc_first = @investor_kyc.entity.entity_setting.kyc_doc_first_wizard? &&
               @investor_kyc.entity.support_agents.kyc_doc_extractor_agent? &&
               !params[:skip_doc_first] %>

<% if doc_first %>
  <%= render 'doc_first_upload', investor_kyc: @investor_kyc %>
<% else %>
  <%= render form, investor_kyc: @investor_kyc %>
<% end %>
