<div class="wizard_container" data-controller="wizard interim-save">
  <div class="row justify-content-md-center">
    <div class="stepwizard hidden col-md-6">
        <div class="stepwizard-row setup-panel">
            <div class="stepwizard-step">
                <a href="#step-1" type="button" class="btn btn-outline-primary btn-outline-primary btn-outline-circle">1</a>
                <p>Step 1</p>
            </div>
            <div class="stepwizard-step">
                <a href="#step-2" type="button" class="btn disabled btn-outline-primary btn-outline-circle">2</a>
                <p>Step 2</p>
            </div>
            <div class="stepwizard-step">
                <a href="#step-3" type="button" class="btn disabled btn-outline-primarybtn-outline-circle">3</a>
                <p>Step 3</p>
            </div>
            <% regulatory_custom_fields = investor_kyc.form_type.present? ? investor_kyc.form_custom_fields.regulatory.includes(:rich_text_info) : [] %>
            <% show_step_4_for_regulatory_fields = regulatory_custom_fields.present? && !(current_user&.curr_role_investor? || params[:signed_id].present?) %>
            <% if show_step_4_for_regulatory_fields %>
            <div class="stepwizard-step">
                <a href="#step-4" type="button" class="btn disabled btn-outline-primarybtn-outline-circle">4</a>
                <p>Step 4</p>
            </div>
            <% end %>
        </div>
    </div>
  </div>

<%
  is_investor        = current_user&.curr_role == "investor"
  via_signed_id      = params[:signed_id].present?
  kyc_locked         = investor_kyc.submission_completed? || investor_kyc.submission_verified?
  investor_facing    = is_investor || via_signed_id
  show_investor_btns = investor_facing && !kyc_locked
%>

<% if kyc_locked && via_signed_id %>
  <div class="col-md-6 mx-auto mb-3">
    <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
      <i class="bi bi-check-circle-fill"></i>
      <div>
        <strong>KYC Already Submitted</strong> — your KYC has been received. The fund team will review it shortly.
        <% if investor_kyc.submitted_at.present? %>
          <br><small class="text-muted">Submitted on <%= investor_kyc.submitted_at.strftime('%B %-d, %Y') %></small>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% if !kyc_locked &&
      investor_kyc.persisted? &&
      investor_kyc.entity.entity_setting.kyc_doc_first_wizard? &&
      investor_kyc.entity.agents.exists?(agent_type: "KycDocExtractorAgent", enabled: true) %>
  <div class="col-12 mb-2">
    <div class="col-md-6 mx-auto text-end">
      <%= button_to "Extract from Documents",
            extract_docs_data_investor_kyc_path(investor_kyc, signed_id: params[:signed_id].presence),
            method: :post,
            class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </div>
<% end %>

<%= form_with(model: investor_kyc, validate: is_investor, class: "wizard_form row justify-content-md-center") do |form| %>
  <% if via_signed_id %>
    <input type="hidden" name="signed_id" value="<%= params[:signed_id] %>">
  <% end %>
  <% if investor_kyc.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(investor_kyc.errors.count, "error") %> prohibited this investor_kyc from being saved:</h2>

      <ul>
        <% investor_kyc.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <%# Banner shown after doc-first extraction ran — spans full row width then centres content %>
  <% if params[:doc_first_done].present? %>
    <div class="col-12 mb-3">
      <div class="col-md-6 mx-auto">
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
          <i class="ti ti-check fs-5"></i>
          <div>
            <strong>Fields pre-filled from your documents.</strong>
            Please review each field, correct anything that looks wrong, and complete any remaining fields before submitting.
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="col-md-6 setup-content" id="step-1">
    <div class="">
      <div class="card">
        <div class="card-header"> 1. KYC Details </div>
        <div class="card-body">

            <%= form.text_field :entity_id, class: "form-control", hidden: true  %>
            <!-- Sometimes we want to create a kyc and associate it with a commitment or EOI, this is the owner, see InvestorKycCreate.associate_with_owner -->
            <%= form.text_field :owner_id, class: "form-control", hidden: true, value: params[:owner_id], name: :owner_id  %>
            <%= form.text_field :owner_type, class: "form-control", hidden: true, value: params[:owner_type], name: :owner_type  %>

            <div data-controller="investor-kycs">

              <% if investor_kyc.investor_id.present? %>
                <%= form.text_field :investor_id, class: "form-control", hidden: true  %>
              <% else %>
                <div class="form-group">
                  <%= form.label :investor_id, "Stakeholder" %>
                  <%= form.select :investor_id, investor_kyc.entity.investors.map { |i| [i.investor_name, i.id] }, { include_blank: true }, class: "form-control select2",
                        data: {
                          investor_kycs_target: "select",
                          action: "change->investor-kycs#investor_selected"
                        }
                  %>
                </div>
              <% end %>

              <div class="form-group">
                <%= form.label :kyc_type %>
                <!-- Even though this is not a custom field, its class is set to custom_field to enable other custom_fields to be dependent on this -->
                <%= form.select :kyc_type, InvestorKyc.kyc_types.invert, {}, class: "form-control custom_field", id: "kyc_type", data: { action: "change->investor-kycs#kyc_type_changed" }  %>
              </div>

            </div>

            <div class="form-group">
              <%= form.label :full_name %>
              <%= form.text_field :full_name, class: "form-control", maxlength: 255  %>
              <small class="form-text text-muted">Please enter full name as per the Identity Proof being attached</small>
              <% if investor_kyc.kyc_type  == "individual" %>
              <p>
              <small class="form-text text-muted">In case of joint account, please enter only first holders name</small>
              </p>
              <% end %>
            </div>

            <% if investor_kyc.entity.entity_type == "Angel Fund" && investor_kyc.entity_id == current_user&.entity_id %>
              <div class="form-group">
                <%= form.label :agreement_committed_amount %>
                <%= form.text_field :agreement_committed_amount, class: "form-control"  %>
                <small class="form-text text-muted">Please enter the commitment amount. As per SEBI requirements, the minimum commitment is INR 2,500,000</small>
              </div>
              <div class="form-group">
                <%= form.label :agreement_unit_type, "Unit Type" %>
                <%= form.text_field :agreement_unit_type, class: "form-control", maxlength: 20  %>
                <small class="form-text text-muted">Please enter the unit type for the investor</small>
              </div>
            <% end %>

            <div class="form-group">
              <% label = investor_kyc.kyc_type == "individual" ? "Date Of Birth" : "Date Of Incorporation" %>
              <%= form.label :date_of_birth, label %>
              <%= form.date_field :birth_date, class: "form-control" %>
            </div>

            <% pan_label = sys_t('investor_kyc.tax_id') %>
            <div class="form-group">
              <%= form.label :pan, pan_label %>
              <%= form.text_field :PAN, class: "form-control", maxlength: 15  %>
            </div>


            <div class="form-group">
              <%= file_fields("Upload #{pan_label}", investor_kyc, form, required: is_investor, meta_data: "PAN") %>
              <small class="form-text text-muted">Please upload a clear image of your <%=pan_label%></small>
            </div>

            <% if current_user&.entity_id == investor_kyc.entity_id %>
              <div class="form-group">
                <%= form.label :pan_verified, "#{pan_label} Verified" %>
                <%= form.check_box :pan_verified, class: "form-check-input"  %>
              </div>
            <% end %>

            <%= custom_form_fields(investor_kyc, form, step: :one, required: is_investor) %>

            <div class="d-flex gap-2 flex-wrap mt-2">
              <button class="btn btn-outline-primary nextBtn btn-lg pull-right" type="button"><%= t_common(:next) %></button>
              <% if show_investor_btns %>
                <%= form.button "Save Draft",
                  type: "button",
                  class: "btn btn-outline-secondary btn-lg",
                  data: { action: "click->interim-save#interim" } %>
                <%= form.button "Submit KYC",
                  type: "button",
                  class: "btn btn-primary btn-lg",
                  data: { action: "click->interim-save#final" } %>
              <% end %>
            </div>

        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 setup-content" id="step-2">
    <div class="">
      <div class="card">
        <div class="card-header"> 2. KYC Details </div>
        <div class="card-body">


          <div data-controller="address-sync">
            <div class="form-group">
              <%= form.label :permanent_address, "Permanent Address" %>
              <%= form.text_area :address, class: "form-control",
                    data: { address_sync_target: "address", action: "input->address-sync#copyIfUnchanged" } %>
              <small class="form-text text-muted">Address as per the address proof attached</small>
            </div>


            <% kyc_type_key = investor_kyc.kyc_type || "Individual" %>
            <div class="form-group">
                <%= file_fields("Upload Address Proof", investor_kyc, form, required: is_investor) %>
                <% address_proof_label = sys_t("investor_kyc.#{kyc_type_key.downcase}_address_proof_docs") %>
                <small class="form-text text-muted"> <%=address_proof_label%></small>
            </div>

          <div class="form-group">
              <%= form.label :correspondence_address %>
              <%= form.text_area :corr_address, class: "form-control",
                    data: { address_sync_target: "corrAddress", action: "input->address-sync#markAsChanged" } %>
              <small class="form-text text-muted">Please edit Correspondence Address if it is different from Permanent Address.</small>
            </div>
          </div>


          <div class="form-group">
              <%= file_fields("Upload Correspondence Address Proof", investor_kyc, form, required: false) %>
              <small class="form-text text-muted"> In case Correspondence Address is different from Permanent Address, please attach a valid government issued address proof.</small>
          </div>

          <div class="form-group">
            <%= form.label :bank_name, "Bank Name" %>
            <%= form.text_field :bank_name, class: "form-control", maxlength: 100  %>
            <small class="form-text text-muted">  <%= sys_t('investor_kyc.bank_instructions') %></small>
          </div>

          <div class="form-group">
            <%= form.label :bank_branch, "Branch Name" %>
            <%= form.text_field :bank_branch, class: "form-control", maxlength: 255  %>
          </div>

          <%
            account_types = ["Savings Account", "Current Account ", "Non-Resident Ordinary (NRO) Account", "Non-Resident External (NRE) Account", "Foreign Bank Account", "Other"]

            account_types = @investor_kyc.entity.entity_setting.kyc_bank_account_types.split(",").map(&:strip) if @investor_kyc.entity.entity_setting.kyc_bank_account_types.present?
          %>

          <div class="form-group">
            <%= form.label :bank_account_type, "Account Type" %>
            <%= form.select :bank_account_type, account_types, {}, class: "form-control", maxlength: 40  %>
          </div>

          <div class="form-group">
            <%= form.label :bank_account_number %>
            <%= form.text_field :bank_account_number, class: "form-control", maxlength: 40  %>
          </div>

          <% ifsc_label = sys_t('investor_kyc.bank_routing_number') %>
          <div class="form-group">
            <%= form.label :ifsc_code, ifsc_label %>
            <%= form.text_field :ifsc_code, class: "form-control", maxlength: 20 %>
          </div>


          <%= custom_form_fields(investor_kyc, form, step: :two, required: is_investor) %>

          <% if current_user&.entity_id == investor_kyc.entity_id  %>
            <div class="form-group">
              <%= form.label :bank_verified %>
              <%= form.check_box :bank_verified, class: "form-check-input"  %>
            </div>
          <% end %>

          <div class="form-group">
            <button class="btn btn-outline-primary nextBtn btn-lg pull-right" type="button"><%= t_common(:next) %></button>
            <%= form.button "Save Draft",
              type: "button",
              class: "btn btn-outline-secondary btn-lg",
              data: { action: "click->interim-save#interim" } if show_investor_btns %>
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class="col-md-6 setup-content" id="step-3">
    <div class="">
      <div class="card">
        <div class="card-header"> 3. KYC Details </div>
        <div class="card-body">

          <% if investor_kyc.entity_id == current_user&.entity_id %>
          <div class="form-group" data-controller="investor-kycs">
            <%= form.label :esign_emails, "Investor Signatory Emails" %>
            <%= form.text_field :esign_emails,
                  class: "form-control", id: "esign_emails",
                  pattern: "[^@\\s]+@[^@\\s]+\\.[^@\\s]+(,\\s*[^@\\s]+@[^@\\s]+\\.[^@\\s]+)*",
                  placeholder: "user1@example.com, user2@example.com",
                  data: {
                    investor_kycs_target: "esign_emails",
                    action: "input->investor-kycs#checkValidEmails"
                  }
            %>

            <small class="text-muted">Comma separated list of investor emails to send the esignature request to</small>
          </div>
          <% end %>


          <%= custom_form_fields(investor_kyc, form, required: is_investor) %>

          <% unless current_user&.curr_role == "investor" || params[:signed_id].present? %>
            <div class="form-group">
              <%= form.label :expiry_date %>
              <%= form.date_field :expiry_date, class: "form-control"  %>
            </div>
          <% end %>

          <div class="form-group">
            <%= form.label :comments %>
            <%= form.text_area :comments, class: "form-control"  %>
          </div>

          <% if false && !is_investor %>
            <div class="form-group">
              <%= form.label :send_kyc_form_to_user, "Send Notification to User to Update KYC"%>
              <%= form.check_box :send_kyc_form_to_user, class: "form-check-input"  %>
            </div>
          <% end %>

          <div class="form-group">
            <%= form.label :completed_by_investor, "I confirm the all details provided are complete to the best of my knowledge."%>
            <%= form.check_box :completed_by_investor, class: "form-check-input"  %>
          </div>


          <div class="form-group d-flex gap-2 flex-wrap">
            <% if show_step_4_for_regulatory_fields %>
              <button class="btn btn-outline-primary nextBtn btn-lg pull-right" type="button"><%= t_common(:next) %></button>
            <% elsif show_investor_btns %>
              <%= form.button "Save Draft",
                type: "button",
                class: "btn btn-outline-secondary btn-lg",
                data: { action: "click->interim-save#interim" } %>
              <%= form.button "Submit KYC",
                type: "button",
                class: "btn btn-primary btn-lg",
                data: { action: "click->interim-save#final" } %>
            <% else %>
              <%= form.button t_common(:save), type: "button", class: "btn btn-outline-primary btn-lg", data: { action: "click->interim-save#submit" } %>
            <% end %>
          </div>

        </div>
      </div>
    </div>
  </div>

  <% if show_step_4_for_regulatory_fields %>
  <div class="col-md-6 setup-content" id="step-4">
    <div class="">
      <div class="card">
        <div class="card-header"> 4. Reporting Fields </div>
        <div class="card-body">

          <% if regulatory_custom_fields.present? %>
            <% reg_envs = regulatory_custom_fields.pluck(:reg_env).uniq
            reg_envs.each do |reg_env| %>

              <%= custom_form_fields(investor_kyc, form, custom_fields: regulatory_custom_fields.for_env(reg_env)) %>

              <% end %>
          <% end %>

          <div class="form-group d-flex gap-2 flex-wrap">
            <% if show_investor_btns %>
              <%= form.button "Save Draft",
                type: "button",
                class: "btn btn-outline-secondary btn-lg",
                data: { action: "click->interim-save#interim" } %>
              <%= form.button "Submit KYC",
                type: "button",
                class: "btn btn-primary btn-lg",
                data: { action: "click->interim-save#final" } %>
            <% else %>
              <%= form.button t_common(:save), type: "button", class: "btn btn-outline-primary btn-lg", data: { action: "click->interim-save#submit" } %>
            <% end %>
          </div>

        </div>
      </div>
    </div>
  </div>
  <% end %>

<% end %>

<%# Submit KYC confirmation modal — outside the form to avoid Bootstrap backdrop stacking issues %>
<div class="modal fade" id="submitKycConfirmModal" tabindex="-1" aria-labelledby="submitKycConfirmModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="submitKycConfirmModalLabel">
          <i class="ti ti-send me-2 text-primary"></i>Submit KYC?
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-2">
        <p class="text-muted mb-3">Please confirm before submitting. Here's what happens next:</p>
        <div class="d-flex flex-column gap-2">
          <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#eff6ff;">
            <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                  style="width:34px;height:34px;background:#dbeafe;">
              <i class="ti ti-lock fs-5" style="color:#2563eb;"></i>
            </span>
            <div>
              <div class="fw-semibold text-dark lh-sm">Your KYC will be locked</div>
              <div class="text-muted small mt-1">You will not be able to edit it after submission.</div>
            </div>
          </div>
          <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#f0fdf4;">
            <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                  style="width:34px;height:34px;background:#dcfce7;">
              <i class="ti ti-bell-check fs-5" style="color:#16a34a;"></i>
            </span>
            <div>
              <div class="fw-semibold text-dark lh-sm">The fund team will be notified</div>
              <div class="text-muted small mt-1">They will review your submission and get back to you.</div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer border-0 pt-1">
        <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary"
                data-action="click->interim-save#confirmFinal">
          <i class="ti ti-send me-1"></i>Yes, Submit KYC
        </button>
      </div>
    </div>
  </div>
</div>

</div>
