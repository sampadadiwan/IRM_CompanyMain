<% if @custom_notification %>

    <%= render "/custom_notifications/mail" %>

<% else %>

    <p>Dear <%= @investor_kyc.full_name.present? ? @investor_kyc.full_name : "Investor" %>,</p>

    <p>
        <% if @message.present? %>
            <%= @message %>
        <% else %>
            <%= @investor_kyc.entity.name %> requires some updates to your KYC details before they can be finalised.
        <% end %>
    </p>

    <p>Please click the button below to open your KYC form, make the necessary changes, and resubmit. The process takes just a few minutes.</p>

    <p><strong>What to expect after you resubmit:</strong> our team will review your updated details and confirm approval by email.</p>

<% end %>

<% if @signed_id.present? %>
    <p><small>This secure link is valid until <%= I18n.l(@link_expiry, format: :long) %>. Do not share it with anyone.</small></p>
    <p class="btn btn-outline-primary"><%= link_to "Update Your KYC", edit_investor_kyc_url(id: :shared, signed_id: @signed_id, subdomain: @investor_kyc.entity.sub_domain) %></p>
<% else %>
    <p class="btn btn-outline-primary"><%= link_to "Update Your KYC", edit_investor_kyc_url(@investor_kyc, subdomain: @investor_kyc.entity.sub_domain) %></p>
<% end %>
