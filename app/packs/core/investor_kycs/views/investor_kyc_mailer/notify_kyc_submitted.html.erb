<% if @custom_notification %>

    <%= render "/custom_notifications/mail" %>

<% else %>

    <%# Always the formatted default body, regardless of @message/msg: - msg: is still passed so the in-app notification (which shares #message with this email) has a body of its own. %>
    <p>
        The investor <strong><%= @investor_kyc.full_name %></strong> has submitted their KYC for review.
        <% if @investor_kyc.submitted_at.present? %>
          <br>Submitted on <%= I18n.l(@investor_kyc.submitted_at.to_date, format: :long) %>.
        <% end %>
    </p>

<% end %>

<p class="btn btn-outline-primary"><%= link_to "View KYC", investor_kyc_url(@investor_kyc, subdomain: @investor_kyc.entity.sub_domain) %></p>
