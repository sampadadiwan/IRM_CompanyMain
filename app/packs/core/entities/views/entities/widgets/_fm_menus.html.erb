<%
  args ||= {}
  card_type = args[:card_type] || 'card'
%>

<% if current_user.enable_funds %>

<% if card_type == 'card2' %>

<div class="row g-3 mb-1">
  <div class="col-sm-6 col-lg-3">
    <%= link_to reports_path, class: "text-decoration-none d-block h-100" do %>
      <div class="card fm-menu-card fm-menu-card--success h-100">
        <div class="card-body d-flex align-items-center justify-content-between py-3 px-4">
          <div class="d-flex align-items-center gap-3">
            <div class="fm-menu-icon bg-success-subtle text-success">
              <i class="ti ti-credit-card fs-5"></i>
            </div>
            <div>
              <div class="fw-semibold"><%= t('entities.fm_dashboard_menus.reports') %></div>
              <small class="text-muted">View Reports</small>
            </div>
          </div>
          <i class="ti ti-chevron-right text-muted fs-5"></i>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-sm-6 col-lg-3">
    <%= link_to investors_path(multi_portfolio_dashboard: true), class: "text-decoration-none d-block h-100" do %>
      <div class="card fm-menu-card fm-menu-card--info h-100">
        <div class="card-body d-flex align-items-center justify-content-between py-3 px-4">
          <div class="d-flex align-items-center gap-3">
            <div class="fm-menu-icon bg-info-subtle text-info">
              <i class="ti ti-layout-dashboard fs-5"></i>
            </div>
            <div>
              <div class="fw-semibold"><%= t('entities.fm_dashboard_menus.portfolio_dashboard') %></div>
              <small class="text-muted">Analyze Portfolio</small>
            </div>
          </div>
          <i class="ti ti-chevron-right text-muted fs-5"></i>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-sm-6 col-lg-3">
    <%= link_to quick_links_path(tags: "Fund"), class: "text-decoration-none d-block h-100" do %>
      <div class="card fm-menu-card fm-menu-card--primary h-100">
        <div class="card-body d-flex align-items-center justify-content-between py-3 px-4">
          <div class="d-flex align-items-center gap-3">
            <div class="fm-menu-icon bg-primary-subtle text-primary">
              <i class="ti ti-grid-dots fs-5"></i>
            </div>
            <div>
              <div class="fw-semibold"><%= t('entities.fm_dashboard_menus.quick_links') %></div>
              <small class="text-muted">Quick Guides</small>
            </div>
          </div>
          <i class="ti ti-chevron-right text-muted fs-5"></i>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-sm-6 col-lg-3">
    <%= link_to investor_kycs_path, class: "text-decoration-none d-block h-100" do %>
      <div class="card fm-menu-card fm-menu-card--warning h-100">
        <div class="card-body d-flex align-items-center justify-content-between py-3 px-4">
          <div class="d-flex align-items-center gap-3">
            <div class="fm-menu-icon bg-warning-subtle text-warning">
              <i class="ti ti-file-check fs-5"></i>
            </div>
            <div>
              <div class="fw-semibold"><%= t('entities.fm_dashboard_menus.kycs') %></div>
              <small class="text-muted">Your KYC Info</small>
            </div>
          </div>
          <i class="ti ti-chevron-right text-muted fs-5"></i>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% else %>

<div class="row">
  <div class="col-md">
    <div class="card">
      <div class="card-body">
        <a href="<%= reports_path %>">
          <div class="d-flex flex-row align-items-center">
            <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-success">
              <i class="ti ti-credit-card fs-6"></i>
            </div>
            <div class="ms-3 align-self-center">
              <h3 class="mb-0 fs-6"><%= t('entities.fm_dashboard_menus.reports') %></h3>
              <span class="text-muted">View Reports</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div class="col-md">
    <div class="card">
      <div class="card-body">
        <a href="<%= investors_path(multi_portfolio_dashboard: true) %>">
          <div class="d-flex flex-row align-items-center">
            <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-info">
              <i class="ti ti-layout-dashboard fs-6"></i>
            </div>
            <div class="ms-3 align-self-center">
              <h3 class="mb-0 fs-6"><%= t('entities.fm_dashboard_menus.portfolio_dashboard') %></h3>
              <span class="text-muted">Analyze Portfolio</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div class="col-md">
    <div class="card">
      <div class="card-body">
        <a href="<%= quick_links_path(tags: "Fund") %>">
          <div class="d-flex flex-row align-items-center">
            <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-primary">
              <i class="ti ti-grid-dots fs-6"></i>
            </div>
            <div class="ms-3 align-self-center">
              <h3 class="mb-0 fs-6"><%= t('entities.fm_dashboard_menus.quick_links') %></h3>
              <span class="text-muted">Quick Guides</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div class="col-md">
    <div class="card">
      <div class="card-body">
        <a href="<%= investor_kycs_path %>">
          <div class="d-flex flex-row align-items-center">
            <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-warning">
              <i class="ti ti-file-check fs-6"></i>
            </div>
            <div class="ms-3 align-self-center">
              <h3 class="mb-0 fs-6"><%= t('entities.fm_dashboard_menus.kycs') %></h3>
              <span class="text-muted">Your KYC Info</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

<% end %>
<% end %>
