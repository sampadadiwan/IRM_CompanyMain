<%
  args ||= {}
  card_type = args[:card_type] || 'card'
%>

<% if card_type == 'card2' %>

<div class="row g-3">
  <div class="col-lg-3 col-md-6">
    <%= link_to funds_path, class: "text-decoration-none d-block h-100" do %>
      <div class="card fm-stat-card fm-stat-card--success h-100">
        <div class="card-body d-flex align-items-center justify-content-between py-3 px-4">
          <div class="d-flex align-items-center gap-3">
            <div class="fm-stat-icon bg-success-subtle text-success">
              <i class="ti ti-currency-dollar fs-4"></i>
            </div>
            <div>
              <div data-controller="counters" data-counters-value-value="<%= policy_scope(current_user.entity.funds).count %>">
                <span class="fs-2 fw-bold lh-1 text-body" data-counters-target="output"></span>
              </div>
              <div class="text-muted small mt-1"><%= t('entities.fm_dashboard_stats.funds') %></div>
            </div>
          </div>
          <i class="ti ti-chevron-right text-muted fs-4"></i>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-lg-3 col-md-6">
    <%= link_to investors_path(category: "LP"), class: "text-decoration-none d-block h-100" do %>
      <div class="card fm-stat-card fm-stat-card--info h-100">
        <div class="card-body d-flex align-items-center justify-content-between py-3 px-4">
          <div class="d-flex align-items-center gap-3">
            <div class="fm-stat-icon bg-info-subtle text-info">
              <i class="ti ti-users fs-4"></i>
            </div>
            <div>
              <div data-controller="counters" data-counters-value-value="<%= policy_scope(current_user.entity.investors.lps).count %>">
                <span class="fs-2 fw-bold lh-1 text-body" data-counters-target="output"></span>
              </div>
              <div class="text-muted small mt-1"><%= t('entities.fm_dashboard_stats.lps') %></div>
            </div>
          </div>
          <i class="ti ti-chevron-right text-muted fs-4"></i>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-lg-3 col-md-6">
    <%= link_to investors_path(q: ransack_query_params(:category, :eq, "Portfolio Company")), class: "text-decoration-none d-block h-100" do %>
      <div class="card fm-stat-card fm-stat-card--warning h-100">
        <div class="card-body d-flex align-items-center justify-content-between py-3 px-4">
          <div class="d-flex align-items-center gap-3">
            <div class="fm-stat-icon bg-warning-subtle text-warning">
              <i class="ti ti-chart-bar fs-4"></i>
            </div>
            <div>
              <div data-controller="counters" data-counters-value-value="<%= policy_scope(current_user.entity.investors.portfolio_companies).count %>">
                <span class="fs-2 fw-bold lh-1 text-body" data-counters-target="output"></span>
              </div>
              <div class="text-muted small mt-1"><%= t('entities.fm_dashboard_stats.portfolio_companies') %></div>
            </div>
          </div>
          <i class="ti ti-chevron-right text-muted fs-4"></i>
        </div>
      </div>
    <% end %>
  </div>


  <div class="col-lg-3 col-md-6">
    <a href="#opportunities-section"
       onclick="document.querySelector('#opportunities-section')?.scrollIntoView({ behavior: 'smooth' }); return false;"
       class="text-decoration-none d-block h-100">
      <div class="card fm-stat-card fm-stat-card--danger h-100">
        <div class="card-body d-flex align-items-center justify-content-between py-3 px-4">
          <div class="d-flex align-items-center gap-3">
            <div class="fm-stat-icon bg-danger-subtle text-danger">
              <i class="ti ti-filter fs-4"></i>
            </div>
            <div>
              <div data-controller="counters" data-counters-value-value="<%= policy_scope(current_user.entity.investment_opportunities).count %>">
                <span class="fs-2 fw-bold lh-1 text-body" data-counters-target="output"></span>
              </div>
              <div class="text-muted small mt-1"><%= t('entities.fm_dashboard_stats.opportunities') %></div>
            </div>
          </div>
          <i class="ti ti-chevron-right text-muted fs-4"></i>
        </div>
      </div>
    </a>
  </div>

</div>

<% else %>

<div class="row">
  <div class="col-lg-3 col-md-6">
    <a href="<%=funds_path %>">
    <div class="card cursor-pointer">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div>
            <div data-controller="counters" data-counters-value-value="<%= policy_scope(current_user.entity.funds).count %>">
              <h3 class="fs-8" data-counters-target="output"></h3>
            </div>
            <h6 class="card-subtitle mb-1 text-muted"><%= t('entities.fm_dashboard_stats.funds') %> </h6>
          </div>
          <div class="ms-auto">
            <span class="text-success display-6"><i class="ti ti-currency-dollar"></i></span>
          </div>
        </div>
          <div class="progress-bar text-bg-success" role="progressbar" style="width: 100%; height: 6px;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
      </div>
    </div>
    </a>
  </div>
  <div class="col-lg-3 col-md-6">
    <a href="<%=investors_path(category: "LP")%>">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div>
            <div data-controller="counters" data-counters-value-value="<%= policy_scope(current_user.entity.investors.lps).count %>">
              <h3 class="fs-8" data-counters-target="output"></h3>
            </div>
            <h6 class="card-subtitle mb-1 text-muted"><%= t('entities.fm_dashboard_stats.lps') %> </h6>
          </div>
          <div class="ms-auto">
            <span class="text-info display-6"><i class="ti ti-users"></i></span>
          </div>
        </div>
          <div class="progress-bar text-bg-info" role="progressbar" style="width: 100%; height: 6px;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
      </div>
    </div>
    </a>
  </div>
  <div class="col-lg-3 col-md-6">
    <a href="<%=investors_path(q: ransack_query_params(:category, :eq, "Portfolio Company"))%>">
    <div class="card">
      <div class="card-body">
        <div class="row">
          <div class="col-12">
            <div class="d-flex align-items-center mb-3">
              <div>
                <div data-controller="counters" data-counters-value-value="<%= policy_scope(current_user.entity.investors.portfolio_companies).count %>">
                  <h3 class="fs-8" data-counters-target="output"></h3>
                </div>
                <h6 class="card-subtitle mb-1 text-muted"><%= t('entities.fm_dashboard_stats.portfolio_companies') %> </h6>
              </div>
              <div class="ms-auto">
                <span class="text-warning display-6"><i class="ti ti-chart-bar"></i></span>
              </div>
            </div>
          </div>
          <div class="col-12">
              <div class="progress-bar text-bg-warning" role="progressbar" style="width: 100%; height: 6px;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
        </div>
      </div>
    </div>
    </a>
  </div>
  <div class="col-lg-3 col-md-6">
    <a href="#opportunities-section" onclick="document.querySelector('#opportunities-section').scrollIntoView({ behavior: 'smooth' }); return false;">
    <div class="card cursor-pointer">
      <div class="card-body">
        <div class="row">
          <div class="col-12">
            <div class="d-flex align-items-center mb-3">
              <div>
                <div data-controller="counters" data-counters-value-value="<%= policy_scope(current_user.entity.investment_opportunities).count %>">
                  <h3 class="fs-8" data-counters-target="output"></h3>
                </div>
                <h6 class="card-subtitle mb-1 text-muted"><%= t('entities.fm_dashboard_stats.opportunities') %> </h6>
              </div>
              <div class="ms-auto">
                <span class="text-danger display-6"><i class="ti ti-filter"></i></span>
              </div>
            </div>
          </div>
          <div class="col-12">
              <div class="progress-bar text-bg-danger" role="progressbar" style="width: 100%; height: 6px;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
        </div>
      </div>
    </div>
    </a>
  </div>
</div>

<% end %>
