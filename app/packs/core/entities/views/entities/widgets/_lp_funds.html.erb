<%
    entity_id ||= current_user.entity_id

    capital_commitments = policy_scope(CapitalCommitment).includes(:entity, :investor, :investor_kyc, :fund_ratios, fund: [:data_room_folder, :entity, :evergreen_fund_setting])
    if entity_id != current_user.entity_id
        capital_commitments = capital_commitments.where(entity_id: entity_id)
    end

    card_type = args[:card_type] || "card"
%>

<% if current_user.enable_funds %>
    <%= render ToggleCard.new(title: "Funds", css_class: "show_funds") do %>
        <%# Nav cards (Data Rooms, Commitments, KYCs, Statements) appear whenever the LP has
            funds enabled, regardless of whether they have any capital commitments yet. %>
        <%= render "entities/vc_dashboard_menus" %>
        <% capital_commitments.each do |cc| %>
            <%# Evergreen folios get the evergreen landing card (open-ended-funds B2) %>
            <%= render cc.fund.evergreen? ? "evergreen/funds/lp_card" : "/capital_commitments/#{card_type}", capital_commitment: cc %>
        <% end %>
    <% end %>
<% end %>
