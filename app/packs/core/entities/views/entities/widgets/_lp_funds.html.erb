<%
    entity_id ||= current_user.entity_id

    capital_commitments = policy_scope(CapitalCommitment).includes(:entity, :investor, :investor_kyc, :fund_ratios, fund: :data_room_folder)
    if entity_id != current_user.entity_id
        capital_commitments = capital_commitments.where(entity_id: entity_id)
    end

    card_type = args[:card_type] || "card"
%>

<% if current_user.enable_funds && capital_commitments.any? %>
    <%= render ToggleCard.new(title: "Funds", css_class: "show_funds") do %>
        <%= render "entities/vc_dashboard_menus" %>
        <% capital_commitments.each do |cc| %>
            <%= render "/capital_commitments/#{card_type}", capital_commitment: cc %>
        <% end %>
    <% end %>
<% end %>
