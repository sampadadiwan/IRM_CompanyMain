<% if current_user.enable_funds %>
    <div id="funds-section">
        <% title = link_to(t('entities.fm_dashboard2.funds'), funds_path) %>
        <%= render ToggleCard.new(title:, css_class: "show_funds") do %>
            <% @pagy, funds = pagy(policy_scope(Fund)) %>

            <% funds.includes(:fund_ratios).each do |fund| %>
                <%= render "/funds/card", fund: %>
            <% end %>

            <div class="d-flex justify-content-between align-items-center">
                <%= raw pagy_info(@pagy) %>
                <%= raw pagy_bootstrap_nav(@pagy) %>
            </div>
        <% end %>
    </div>
<% end %>
