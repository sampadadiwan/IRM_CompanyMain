<%#
  FM Landing Page "Funds" widget.

  Metadata:
    card_type - which fund card partial to render (default 'card'):
      card  - classic card (column chart + icon metric rows)
      card2 - A "Compact ledger": two per row, deployment bar, headline IRR
      card3 - B "Refined current": full width, stacked capital bar + tile grid
      card4 - C "Stat strip": one dense row per fund
      card5 - D "Chart-forward": CSS donut + ratio tiles
%>
<%
  args ||= {}
  card_types   = %w[card card2 card3 card4 card5]
  card_type    = args[:card_type].to_s.presence_in(card_types) || 'card'
  card_partial = "/funds/#{card_type}"
%>

<% if current_user.enable_funds %>
  <div id="funds-section" class="mt-3">
    <% title = link_to(t('entities.fm_dashboard2.funds'), funds_path) %>
    <%= render ToggleCard.new(title:, css_class: "show_funds") do %>

      <% if card_type == 'card2' %>
        <%
          funds_scope = policy_scope(Fund)
          total_committed_cents = funds_scope.sum(:committed_amount_cents).to_f
          total_called_cents    = funds_scope.sum(:call_amount_cents).to_f
          total_dist_cents      = funds_scope.sum(:distribution_amount_cents).to_f.abs
          funds_count           = funds_scope.count
          sample_fund           = funds_scope.first
          agg_currency          = sample_fund&.currency || "INR"
          agg_divisor           = agg_currency == "INR" ? 10_000_000.0 : 1_000_000.0
          agg_suffix            = agg_currency == "INR" ? "Cr" : "M"
        %>
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-3">
            <div class="card border-0 bg-primary-subtle text-center py-3 px-2">
              <div class="fs-4 fw-bold text-primary"><%= number_with_precision(total_committed_cents / 100.0 / agg_divisor, precision: 1) %> <%= agg_suffix %></div>
              <div class="text-muted small mt-1">Total Committed</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card border-0 bg-warning-subtle text-center py-3 px-2">
              <div class="fs-4 fw-bold text-warning"><%= number_with_precision(total_called_cents / 100.0 / agg_divisor, precision: 1) %> <%= agg_suffix %></div>
              <div class="text-muted small mt-1">Total Called</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card border-0 bg-success-subtle text-center py-3 px-2">
              <div class="fs-4 fw-bold text-success"><%= number_with_precision(total_dist_cents / 100.0 / agg_divisor, precision: 1) %> <%= agg_suffix %></div>
              <div class="text-muted small mt-1">Total Distributed</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card border-0 bg-info-subtle text-center py-3 px-2">
              <div class="fs-4 fw-bold text-info"><%= funds_count %></div>
              <div class="text-muted small mt-1">Active Funds</div>
            </div>
          </div>
        </div>
      <% end %>

      <% @pagy, funds = pagy(policy_scope(Fund)) %>
      <%# Every card partial emits a .col-* wrapper, so lay them out in a row
          (card2 is col-lg-6 and needs it to sit two-up; the rest are col-lg-12). %>
      <div class="row">
        <% funds.ordered.includes(:fund_ratios).each do |fund| %>
          <%= render card_partial, fund: %>
        <% end %>
      </div>

      <div class="d-flex justify-content-between align-items-center">
        <%= raw pagy_info(@pagy) %>
        <%= raw pagy_bootstrap_nav(@pagy) %>
      </div>
    <% end %>
  </div>
<% end %>
