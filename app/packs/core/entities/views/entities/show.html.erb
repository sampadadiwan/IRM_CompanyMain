<div class="card shadow mb-4">
  <div class="card-header py-3">
    <h6 class="m-0 font-weight-bold text-primary"><%= link_to @entity.name, @entity %></h6>
  </div>
  <div class="card-body">
    <table class="table table-bordered dataTable ">
      <tr>
        <td>
          Logo
        </td>
        <td>
          <% if @entity.logo.present? %>
            <img class="entity_logo" src="<%= (@entity.logo.url) %>">
          <% end %>
        </td>
      </tr>
      <%# Tax id and primary email only for users related to this company (B1, EntityPolicy#full_details?) %>
      <% if policy(@entity).full_details? %>
      <tr>
        <td>
          TaxId
        </td>
        <td>
          <%= @entity.pan %>
        </td>
      </tr>
      <tr>
        <td>
          Primary Email
        </td>
        <td>
          <%= @entity.primary_email %>
        </td>
      </tr>
      <% end %>
      <tr>
        <td>
          Type
        </td>
        <td>
          <%= @entity.entity_type %>
        </td>
      </tr>
      <%# Support needs to see the off-boarding state — the Deactivate button hides once it is off %>
      <%# Same check as EntityPolicy#deactivate? — deliberately not user.support?, which is also true
          for a support user impersonating a client user %>
      <% if current_user&.has_cached_role?(:support) %>
        <tr>
          <td>
            Status
          </td>
          <td>
            <% if @entity.active? %>
              <span class="badge bg-success">Active</span>
            <% else %>
              <span class="badge bg-danger">Deactivated</span>
              <span class="text-muted ms-2">Employee logins and investor access have been revoked.</span>
            <% end %>
          </td>
        </tr>
      <% end %>
      <tr>
        <td>
          Url
        </td>
        <td>
          <%= @entity.url if @entity.url.present? %>
        </td>
      </tr>
      <tr>
        <td>
          Category
        </td>
        <td>
          <%= @entity.category %>
        </td>
      </tr>
      <tr>
        <td>
          Details
        </td>
        <td>
          <%= @entity.details %>
        </td>
      </tr>
      <% if current_user && current_user.entity_id == @entity.id  %>

        <% if current_user.curr_role != "investor" %>
          <tr>
            <td>
              Currency
            </td>
            <td>
              <%= @entity.currency %>
            </td>
          </tr>
          <% if @entity.tracking_currency.present? %>
            <tr>
              <td>
                Tracking Currency
              </td>
              <td>
                <%= @entity.tracking_currency %>
              </td>
            </tr>
          <% end %>
          <tr>
            <td>
              Sub Domain
            </td>
            <td>
              <%= @entity.sub_domain %>
            </td>
          </tr>
          <tr>
            <td>
              Mailbox
            </td>
            <td>
              <%= @entity.mailbox %>
            </td>
          </tr>
          <% if @entity.permissions.enable_kycs? %>
            <tr>
              <td>
                KYC Document List (Individual)
              </td>
              <td>
                <%= @entity.entity_setting.individual_kyc_doc_list %>
              </td>
            </tr>
            <tr>
              <td>
                KYC Document List (Non Individual)
              </td>
              <td>
                <%= @entity.entity_setting.non_individual_kyc_doc_list %>
              </td>
            </tr>
            <tr>
              <td>
                KYC Documents Note
              </td>
              <td>
                <%= @entity.entity_setting.kyc_docs_note&.html_safe %>
              </td>
            </tr>
          <% end %>
          <% if @entity.permissions.enable_kpis? %>
            <tr>
              <td>
                KPI Document List
              </td>
              <td>
                <%= @entity.entity_setting.kpi_doc_list %>
              </td>
            </tr>
          <% end %>
          <tr>
            <td>
              Sandbox
            </td>
            <td>
              <%= display_boolean @entity.entity_setting.sandbox %><br>
              <small class="text-muted">When sandbox is enabled, all notifications will be directed to sandbox email ids / phone numbers</small>
            </td>
          </tr>
          <tr>
            <td>
              Sandbox Emails
            </td>
            <td>
              <%= @entity.entity_setting.sandbox_emails %>
            </td>
          </tr>
          <tr>
            <td>
              cc Emails
            </td>
            <td>
              <%= @entity.entity_setting.cc %>
            </td>
          </tr>
          <tr>
            <td>
              Sandbox Numbers
            </td>
            <td>
              <%= @entity.entity_setting.sandbox_numbers %>
            </td>
          </tr>
          <tr>
            <td>
              Support Enabled
            </td>
            <td>
              <%= display_boolean @entity.permissions.enable_support? %>
            </td>
          </tr>

          <% if @entity.entity_setting.document_colors.present? %>
            <tr>
              <td>
                Document Colors
              </td>
              <td>
                <%= @entity.entity_setting.document_colors %>
              </td>
            </tr>
          <% end %>

        <% end %>

        <tr>
          <td>
            Access Enabled
          </td>
          <td>
            <%= "Documents," if @entity.permissions.enable_documents? %>
            <%= "Deals," if @entity.permissions.enable_deals? %>
            <%= "Funds," if @entity.permissions.enable_funds? %>
            <%= "Investment Opportunities," if @entity.permissions.enable_inv_opportunities? %>
            <%= "Investments," if @entity.permissions.enable_investments? %>
            <%= "Secondary Sale," if @entity.permissions.enable_secondary_sale? %>
            <%= "KPIs," if @entity.permissions.enable_kpis? %>
            <%= "KYCs," if @entity.permissions.enable_kycs? %>
            <%= "Fund Portfolios," if @entity.permissions.enable_fund_portfolios? %>
            <%= "Units," if @entity.permissions.enable_units? %>
            <%= "Account Entries," if @entity.permissions.enable_account_entries? %>
            <%= "Stakeholders," if @entity.permissions.enable_investors? %>
            <%= "Cap Table," if @entity.permissions.enable_captable? %>
          </td>
        </tr>

        <tr>
          <td>AI Client Integration</td>
          <td>
            <%= display_boolean @entity.entity_setting.mcp_enabled %>
          </td>
        </tr>
        <% if @entity.entity_setting.mcp_enabled? %>
          <tr>
            <td>MCP Allowed Roles</td>
            <td>
              <%= @entity.entity_setting.mcp_allowed_roles_list.map { |r|
                r == "employee" ? "Fund Managers" : r == "investor" ? "Investors (LPs)" : r.titleize
              }.join(", ") %>
            </td>
          </tr>
          <% if @entity.entity_setting.mcp_allowed_clients_list.present? %>
            <tr>
              <td>Allowed AI Clients</td>
              <td>
                <%= @entity.entity_setting.mcp_allowed_clients_list.join(", ") %>
              </td>
            </tr>
          <% else %>
            <tr>
              <td>Allowed AI Clients</td>
              <td>All</td>
            </tr>
          <% end %>
        <% end %>
        <tr>
  <td>CS Agent Judge</td>
  <td>
    <%= display_boolean @entity.entity_setting.cs_judge_enabled %>
    <% if @entity.entity_setting.cs_judge_enabled? %>
      <small class="text-muted d-block">Model: <%= @entity.entity_setting.cs_judge_model.presence || "Default (#{@entity.entity_setting.cs_judge_model_name})" %></small>
    <% end %>
  </td>
</tr>



      <% end %>
    </table>
    <div>
      <% if policy(@entity).edit? %>
        <%= link_to  t_common(:edit), edit_entity_path(@entity), {class: "btn btn-outline-primary"} %>
        <%= link_to "View Payments", payments_path, {class: "btn btn-outline-success"} if @entity.entity_type == "Company" %>
      <% end %>
      <%# Validation rule overrides: visible to company_admin and super/support %>
      <% if current_user.has_cached_role?(:company_admin) || current_user.has_cached_role?(:super) || current_user.has_cached_role?(:support) %>
        <%= link_to "Validation Rules", validation_rule_overrides_path, class: "btn btn-outline-secondary" %>
      <% end %>
      <% if policy(@entity).db_dump? %>
        <%= button_to "Generate DB Dump", db_dump_entity_path(@entity),
                      class: "btn btn-outline-info", data: {
                        action: "click->confirm#popup", turbo: false,
                        bs_toggle: "tooltip", bs_container: "body", bs_title: "Generate a database dump now",
                        msg: "Are you sure you want to generate a database dump now?", method: "post"
                      } %>
      <% end %>
      <% if policy(@entity).deactivate? %>
        <%# Opens the deactivate modal, which is rendered outside this div (see below) %>
        <button type="button" class="btn btn-outline-danger" id="entity_deactivate_btn"
                data-bs-toggle="modal" data-bs-target="#deactivateEntityModal">
          <i class="ti ti-ban"></i> Deactivate
        </button>
      <% end %>
    </div>
  </div>
</div>

<%# Kept outside the card and the button div: Bootstrap moves focus and adds a backdrop when the
    modal opens, and nesting it inside the button row makes the buttons flicker as it does so. %>
<% if policy(@entity).deactivate? %>
  <%= render "entities/deactivate_modal", entity: @entity %>
<% end %>
