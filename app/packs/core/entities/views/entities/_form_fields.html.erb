<% if entity.errors.any? %>
  <div class="alert alert-danger">
    <h2><%= pluralize(entity.errors.count, "error") %> prohibited this entity from being saved:</h2>
    <ul>
      <% entity.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<div class="form-group">
  <%= form.label :name %>
  <%= form.text_field :name, class: "form-control", disabled: true  %>
</div>
<div class="form-group">
  <%= form.label :pan %>
  <%= form.text_field :pan, class: "form-control" %>
</div>
<div class="form-group">
  <%= form.label :primary_email %>
  <%= form.text_field :primary_email, class: "form-control", disabled: true %>
</div>
<div class="form-group">
  <%= form.label :industry %>
  <%= form.text_field :category, class: "form-control"  %>
</div>
<%= form.fields_for :entity_setting do |entity_setting_subform| %>
  <div class="form-group">
    <%= entity_setting_subform.label :mailbox %>
    <%= entity_setting_subform.text_field :mailbox, class: "form-control"  %>
    <small>Email address for incoming email</small>
  </div>
  <% if entity.permissions.enable_kycs? %>
    <div class="form-group">
      <%= entity_setting_subform.label :individual_kyc_doc_list %>
      <%= entity_setting_subform.text_field :individual_kyc_doc_list, class: "form-control"  %>
      <small>Comma separated list of documents to be uploaded for Individual KYC</small>
    </div>
    <div class="form-group">
      <%= entity_setting_subform.label :non_individual_kyc_doc_list %>
      <%= entity_setting_subform.text_field :non_individual_kyc_doc_list, class: "form-control"  %>
      <small>Comma separated list of documents to be uploaded for Non Individual KYC</small>
    </div>
    <div class="form-group">
      <%= entity_setting_subform.label :kyc_docs_note %>
      <%= entity_setting_subform.rich_text_area :kyc_docs_note, class: "form-control"  %>
      <small>Instructions to users to upload the KYC documents.</small>
    </div>
    <div class="form-group form-check">
      <%= entity_setting_subform.check_box :kyc_doc_first_wizard, class: "form-check-input" %>
      <%= entity_setting_subform.label :kyc_doc_first_wizard, "Enable Document-First KYC Wizard", class: "form-check-label" %>
      <small class="d-block text-muted">Shows an "Extract from Documents" button on the KYC form. Requires a KycDocExtractorAgent to be configured and enabled.</small>
    </div>
  <% end %>
  <% if entity.permissions.enable_kpis? %>
    <div class="form-group">
      <%= entity_setting_subform.label :kpi_doc_list %>
      <%= entity_setting_subform.select :kpi_doc_list, ENV["KPI_DOCS"].split(","), {include_blank: false, include_hidden: false}, class: "form-control select2", multiple: true %>
      <small>Comma separated list of documents to be uploaded for KPIs</small>
    </div>
  <% end %>
<% end %>
<div class="form-group">
  <%= form.label :url %>
  <%= form.text_field :url, class: "form-control"  %>
</div>
<% if entity.entity_type == "Company" %>
  <div class="form-group">
    <%= form.label :currency %>
    <%= form.select :currency, ENV["CURRENCY"].split(","), {}, class: "form-control"  %>
  </div>
<% end %>
<div class="form-group">
  <%= render "layouts/single_upload", form: form, field_label: "Upload Company Logo",
                            for_model: "entity", field_name: "logo",
                            model: entity %>
</div>
<div class="form-group">
  <%= form.label :details %>
  <%= form.rich_text_area :details, class: "form-control trix-content"  %>
</div>
<% if ["Company", "Investment Fund", "Angel Fund"].include? entity.entity_type %>
  <div class="form-group">
    <%= form.label :investor_categories %>
    <%= form.text_field :investor_categories, class: "form-control",
        placeholder: "Comma separated list of investor categories e.x #{Investor.INVESTOR_CATEGORIES(entity).join(",")}"  %>
    <small class="text-muted">Leave this blank to use defaults.</small>
  </div>
<% end %>


  <%= form.fields_for :entity_setting do |entity_setting_subform| %>
    <%= entity_setting_subform.text_field :id, hidden: true %>

    <div class="form-group">
      <%= entity_setting_subform.label :sandbox, "Sandbox" %>
      <%= entity_setting_subform.check_box :sandbox, class: "form-check-input"  %>
      <small class="text-muted">When sandbox is enabled, all notifications will be directed to sandbox email ids / phone numbers</small>
    </div>

    <div class="form-group">
      <%= entity_setting_subform.label :sandbox_emails %>
      <%= entity_setting_subform.text_field :sandbox_emails, class: "form-control"  %>
    </div>

    <div class="form-group">
      <%= entity_setting_subform.label :cc, "cc" %>
      <%= entity_setting_subform.text_field :cc, class: "form-control"  %>
    </div>

    <div class="form-group">
      <%= entity_setting_subform.label :sandbox_numbers %>
      <%= entity_setting_subform.text_field :sandbox_numbers, class: "form-control"  %>
    </div>

    <div class="form-group">
      <%= entity_setting_subform.label :document_colors %>
      <% colors_json = entity_setting_subform.object.document_colors.is_a?(Hash) ? JSON.pretty_generate(entity_setting_subform.object.document_colors) : entity_setting_subform.object.document_colors.to_s %>
      <%= entity_setting_subform.text_area :document_colors, class: "form-control", value: colors_json  %>
      <small class="text-muted">e.g - {"match": {"Sep 2025.Pdf": "green", "Captable.xlsx": "yellow"}, "contain": {"PAN": "indigo", "SOA": "#32a83a", "FATCA": "red"}}</small>

    </div>
    <hr class="my-4">
    <h5>CS Agent — Response Quality Judge</h5>
    <small class="text-muted d-block mb-3">Automatically score every Customer Support Agent response using an LLM judge (Completeness, Grounding, Actionability).</small>

    <div class="form-group">
      <%= entity_setting_subform.label :cs_judge_enabled, "Enable LLM-as-Judge" %>
      <%= entity_setting_subform.check_box :cs_judge_enabled, class: "form-check-input" %>
      <small class="text-muted">When enabled, every CS agent response is auto-scored. Disable to save LLM costs.</small>
    </div>

    <div class="form-group">
      <%= entity_setting_subform.label :cs_judge_model, "Judge Model" %>
      <%= entity_setting_subform.select :cs_judge_model,
          options_for_select(
            entity_setting_subform.object.available_llm_models.flat_map { |label, models| models.map { |m| [m[0], m[1]] } },
            entity_setting_subform.object.cs_judge_model
          ),
          { include_blank: "Default (#{entity_setting_subform.object.cs_judge_model_name})" },
          class: "form-control" %>
      <small class="text-muted">Choose the model for scoring. Leave blank to use the default (<%= entity_setting_subform.object.cs_judge_model_name %>).</small>
    </div>

    <hr class="my-4">
    <%# MCP configuration section — only visible when CapHive admin has enabled enable_mcp permission for this entity.
        Entity admins (company_admin role) can then configure mcp_enabled, allowed roles, and allowed AI clients. %>
    <% if entity.permissions.enable_mcp? %>

    <h5>AI Client Integration (MCP)</h5>
    <small class="text-muted d-block mb-3">Allow external AI clients (Claude, ChatGPT, Gemini) to query fund and portfolio data.</small>

    <div class="form-group">
      <%= entity_setting_subform.label :mcp_enabled, "Enable AI Client Integration" %>
      <%= entity_setting_subform.check_box :mcp_enabled, class: "form-check-input" %>
      <small class="text-muted">When enabled, authorized users can connect AI clients to access data based on their role and permissions.</small>
    </div>

    <div class="form-group">
      <label>Allow access for</label>
      <div class="form-check">
        <%= check_box_tag "entity[entity_setting_attributes][mcp_allowed_roles_list][]", "employee",
            entity_setting_subform.object.mcp_allowed_roles_list.include?("employee"),
            class: "form-check-input", id: "mcp_role_employee" %>
        <%= label_tag "mcp_role_employee", "Fund Managers", class: "form-check-label" %>
      </div>
      <div class="form-check">
        <%= check_box_tag "entity[entity_setting_attributes][mcp_allowed_roles_list][]", "investor",
            entity_setting_subform.object.mcp_allowed_roles_list.include?("investor"),
            class: "form-check-input", id: "mcp_role_investor" %>
        <%= label_tag "mcp_role_investor", "Investors (LPs)", class: "form-check-label" %>
      </div>
    </div>

    <div class="form-group">
      <label>Allowed AI Clients</label>
      <small class="text-muted d-block mb-2">Leave all unchecked to allow all registered AI clients.</small>
      <% Doorkeeper::Application.all.each do |app| %>
        <div class="form-check">
          <%= check_box_tag "entity[entity_setting_attributes][mcp_allowed_clients_list][]", app.name,
              entity_setting_subform.object.mcp_allowed_clients_list.include?(app.name),
              class: "form-check-input", id: "mcp_client_#{app.id}" %>
          <%= label_tag "mcp_client_#{app.id}", app.name, class: "form-check-label" %>
        </div>
      <% end %>
    </div>

    <% end %>
<% end %>
<div class="form-group">
  <%= form.label :enable_support %>
  <%= form.check_box :enable_support, class: "form-check-input"  %>
</div>
<%= form.text_field :id, class: "form-control", hidden: true   %>
<div data-controller="entityform"></div>
