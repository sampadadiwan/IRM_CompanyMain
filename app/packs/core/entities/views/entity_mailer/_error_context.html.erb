<%#
  Diagnostic header for the error emails — who triggered the work, what triggered it, which
  job, and with what arguments. Built by ErrorReportContext; nil/empty renders nothing, so
  callers that don't pass a context are unaffected.
%>
<% context = local_assigns[:context] %>
<% if context.present? %>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0"
           style="width: 100%; margin-bottom: 15px; background-color: #f9f9f9; border: 1px solid #eeeeee;">
        <% context.each do |label, value| %>
            <tr>
                <td style="padding: 4px 8px; width: 35%; color: #666666; font-size: 12px; vertical-align: top;">
                    <%= label %>
                </td>
                <td style="padding: 4px 8px; font-size: 12px; vertical-align: top; word-break: break-word;">
                    <%= value %>
                </td>
            </tr>
        <% end %>
    </table>
<% end %>
