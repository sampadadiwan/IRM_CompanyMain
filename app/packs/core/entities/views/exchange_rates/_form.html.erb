<%= render FormCard.new(title: "Exchange Rate") do %>

  <%= form_with(model: exchange_rate, validate: true) do |form| %>
    <% if exchange_rate.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(exchange_rate.errors.count, "error") %> prohibited this exchange_rate from being saved:</h2>

        <ul>
          <% exchange_rate.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

      <%= form.text_field :entity_id, class: "form-control", hidden: true  %>

    <div class="form-group">
      <%= form.label :from %>
      <%= form.text_field :from, class: "form-control"  %>
    </div>

    <div class="form-group">
      <%= form.label :to %>
      <%= form.text_field :to, class: "form-control"  %>
    </div>

    <div class="form-group">
      <%= form.label :rate %>
      <%= form.text_field :rate, class: "form-control"  %>
    </div>

    <div class="form-group">
      <%= form.label :as_of %>
      <%= form.date_field :as_of, class: "form-control"  %>
    </div>

    <div class="form-group">
      <%= form.label :rate_type %>
      <%= form.select :rate_type, ExchangeRate::RATE_TYPES.map { |t| [t.capitalize, t] }, {}, class: "form-select" %>
    </div>

    <%# Fund-specific rate: only funds with "Use fund-specific FX rates" (H21) %>
    <% own_rate_funds = Fund.where(entity_id: exchange_rate.entity_id).where_features(:use_own_fx_rates).order(:name) %>
    <% if own_rate_funds.exists? %>
      <div class="form-group">
        <%= form.label :owner_id, "Fund (leave blank for all funds)" %>
        <%= form.select :owner_id, own_rate_funds.map { |f| [f.name, f.id] }, { include_blank: "All funds" }, class: "form-select" %>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :notes %>
      <%= form.text_area :notes, class: "form-control"  %>
    </div>

    <div class="form-group">
      <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
    </div>
  <% end %>

<% end %>
