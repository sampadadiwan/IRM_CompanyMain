<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Exchange Rates</h1>
  <span>
    <%= link_to "Import",
                      new_import_upload_path("import_upload[import_type]": "ExchangeRate",
                      "sample_upload": "EXCHANGE_RATE"),
                      { class: "btn btn-outline-success"} %>
    <%= link_to "New Exchange Rate", new_exchange_rate_path, {class: "btn btn-outline-primary"}  %>
    <%= link_to "Show All", exchange_rates_path(all: true), {class: "btn btn-outline-success"}  %>
  </span>
</div>
<%# Source filter — openspec fund-market-data, card ③ %>
<div class="mb-3">
  <span class="me-2">Source:</span>
  <% [["All", nil], ["Manual", "manual"], ["Market", "market"], ["Derived", "derived"]].each do |label, src| %>
    <%= link_to label, exchange_rates_path(all: params[:all], source: src), class: "btn btn-sm #{params[:source] == src ? 'btn-primary' : 'btn-outline-secondary'}" %>
  <% end %>
</div>
<div class="table-responsive" data-controller="datatable">
  <table id="exchange_rates" class="table table-bordered dataTable jqDataTable">
    <thead>
      <tr>
        <th class="text-col">
          From
        </th>
        <th class="text-col">
          To
        </th>
        <th class="num-col">
          Rate
        </th>
        <th class="date-col">
          As Of
        </th>
        <th class="text-col">
          Latest
        </th>
        <th class="text-col">
          Source
        </th>
        <th class="text-col">
          Rate Type
        </th>
        <th class="text-col">
          Fund
        </th>
        <th class="action-col">
        </th>
      </tr>
    </thead>
    <tbody>
      <% exchange_rates.each do |exchange_rate| %>
        <%= render exchange_rate %>
      <% end %>
    </tbody>
  </table>
</div>
