<%# One user: the chosen columns (RansackTableRow), then the actions.
    openspec/changes/grid-columns-inline-settings — D21 %>
<tr id="user_<%= user.id %>">
  <%= render RansackTableRow.new(model: user, columns:) %>
  <td class="action-col">
    <%= link_to  t_common(:show), user, {class: "btn btn-outline-primary ti ti-eye" } if policy(user).show? %>
    <%= link_to  t_common(:edit), edit_user_path(user), {class: "btn btn-outline-success ti ti-pencil" } if policy(user).edit? %>
  </td>
</tr>
