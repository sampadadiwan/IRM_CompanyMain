<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Users</h1>
  <%= link_to "New User" , new_user_path(entity_id: current_user.entity_id),
      {class: "btn btn-outline-primary" } if policy(User).new? %>
</div>
<table id="users" class="table table-bordered  dataTable jqDataTable">
  <thead>
    <tr>
      <th class="text-col">
        First name
      </th>
      <th class="text-col">
        Last name
      </th>
      <th class="text-col">
        Roles
      </th>
      <th class="text-col">
        Tags
      </th>
      <th class="text-col">
        Entity
      </th>
      <th class="action-col">
      </th>
    </tr>
  </thead>
  <tbody>
    <% users.each do |user| %>
      <%= render partial: "users/user", locals: {user: user} %>
    <% end %>
  </tbody>
</table>
