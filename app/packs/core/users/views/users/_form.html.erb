<%= render FormCard.new(title: "User") do %>

  <%= form_with(model: user, data: {"turbo": "false"}, validate: true) do |form| %>
    <% if user.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>

        <ul>
          <% user.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :first_name %>
      <%= form.text_field :first_name, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :last_name %>
      <%= form.text_field :last_name, class: "form-control" %>
    </div>

    <% disabled = !user.new_record?  %>
    <div class="form-group">
      <%= form.label :email %>
      <%= form.text_field :email, class: "form-control", autocomplete: "nope", disabled:  %>
    </div>

    <div class="row">
      <div class="form-group col-5">
        <%= form.label "Country Code" %>
        <%= form.number_field :call_code, class: "form-control", placeholder: "e.g. 1, 44, 91" %>
        <small class="form-text text-muted">Numeric dialing code, no "+" (e.g. 1 for US, 91 for India).</small>
      </div>
      <div class="form-group col-7">
        <%= form.label :phone %>
        <%= form.number_field :phone, class: "form-control"  %>
        <small class="form-text text-muted">Mobile number without the country code. Used for WhatsApp and SMS sign-in codes.</small>
      </div>
    </div>


    <% unless user.curr_role_investor? %>
      <div class="form-group">
        <%= form.label :dept, "Department" %>
        <%= form.text_field :dept, class: "form-control" %>
      </div>
    <% end %>


    <% if !user.id.present? %>
      <div class="form-group">
        <%= form.label :password %>
        <%= form.password_field :password, class: "form-control", autocomplete: "new-password", required: true %>
      </div>

      <div class="form-group">
        <%= form.label :password_confirmation %>
        <%= form.password_field :password_confirmation, class: "form-control", autocomplete: "new-password", required: true %>
      </div>
    <% end %>

    <% if current_user.has_cached_role?(:company_admin) %>

      <% if user.id.present? %>
      <div class="form-group">
        <%= form.label :roles %>
        <%= form.select :roles, ["company_admin"], {selected: user.roles.collect(&:name), include_hidden: false}, class: "form-control select2", multiple: true, name: "user[role_name][]" %>
      </div>
      <% end %>

      <div class="form-group">
        <%= form.label :tag_list, "Tags" %>
        <i class="ti ti-info-circle ms-1" data-bs-toggle="tooltip" title="Tags help group users for sending notifications"></i>
        <%= form.text_field :tag_list, class: "form-control", list: "user_tag_list_suggestions" %>
        <datalist id="user_tag_list_suggestions">
          <% User::NOTIFICATION_TAGS.each do |tag| %>
            <option value="<%= tag %>">
          <% end %>
        </datalist>
        <small class="form-text text-muted">Comma separated list of tags</small>
      </div>


      <% hide_extended_permissions = user.curr_role_investor? && params[:debug].blank? %>
      <% if !user.has_cached_role?(:company_admin) && !hide_extended_permissions %>
        <div class="row g-2">
        <%= hidden_field_tag "user[extended_permissions][]", "" %>
        <% User.extended_permissions.pairs.each do |key, val| %>
          <div class="col-md-6">
            <div class="toggle-row">
              <%= form.label :extended_permissions, key.titleize, class: "toggle-row-label", for: "extended_permissions#{val}" %>
              <label class="ios-toggle">
                <%= form.check_box :extended_permissions, {name: "user[extended_permissions][]",
                    val: val, id: "extended_permissions#{val}", class: "ios-toggle-input"}, val, nil   %>
                <span class="ios-toggle-slider"></span>
              </label>
            </div>
          </div>
        <% end %>
        </div>
      <% end %>

    <% end %>

    <div class="toggle-row">
      <div>
        <%= form.label :whatsapp_enabled, class: "toggle-row-label" %>
        <small class="form-text text-muted d-block">
          Check only if the phone number above is registered with WhatsApp. Enables WhatsApp delivery for notifications and, if chosen, sign-in verification codes.
        </small>
      </div>
      <label class="ios-toggle">
        <%= form.check_box :whatsapp_enabled, class: "ios-toggle-input" %>
        <span class="ios-toggle-slider"></span>
      </label>
    </div>

    <div class="toggle-row">
      <div>
        <%= form.label :enable_support, class: "toggle-row-label" %>
        <small class="form-text text-muted d-block">Gives the CapHive support team access to assist this user's account.</small>
      </div>
      <label class="ios-toggle">
        <%= form.check_box :enable_support, class: "ios-toggle-input" %>
        <span class="ios-toggle-slider"></span>
      </label>
    </div>

    <% if user.id.present? && current_user == user %>
      <div class="toggle-row">
        <div>
          <%= form.label :two_factor_enabled, "Enable Two-Factor Authentication", class: "toggle-row-label" %>
          <small class="form-text text-muted d-block">
            Require a verification code when signing in. You can choose between SMS, WhatsApp, or an authenticator app on your next login.
            <%= link_to "Learn more", public_guide_path("two_factor_authentication_user_guide"), target: "_blank", rel: "noopener", class: "badge bg-primary-subtle text-primary text-decoration-none" %>
          </small>
        </div>
        <label class="ios-toggle">
          <%= form.check_box :two_factor_enabled, class: "ios-toggle-input" %>
          <span class="ios-toggle-slider"></span>
        </label>
      </div>
    <% end %>

    <%= custom_form_fields(user, form) %>


    <%= form.text_field :entity_id, class: "form-control", hidden: true %>

    <% hide_permissions_for_investor = user.curr_role_investor? && params[:debug].blank? %>
    <% if current_user.has_cached_role?(:company_admin) && !hide_permissions_for_investor %>

      <div class="row g-2">
        <%= hidden_field_tag "user[permissions][]", "" %>
        <% User.permissions.pairs.each do |key, val| %>
          <% if user.entity.permissions.send("#{val}?") %>
            <div class="col-md-6">
              <div class="toggle-row">
                <%= form.label :permissions, key.titleize, class: "toggle-row-label", for: "permissions_#{val}" %>
                <label class="ios-toggle">
                  <%= form.check_box :permissions, {name: "user[permissions][]",
                      val: val, id: "permissions_#{val}", class: "ios-toggle-input"}, val, nil   %>
                  <span class="ios-toggle-slider"></span>
                </label>
              </div>
            </div>
            <% end %>
        <% end %>
      </div>

    <% end %>

    <% if user.id.present? && user.preferences&.dig("dashboard").present? %>
      <hr>
      <h6 class="mb-3">Dashboard Preferences</h6>
      <% user.preferences["dashboard"].each do |dashboard_type, config| %>
        <div class="form-group">
          <%= label_tag "user_preferences_dashboard_#{dashboard_type.parameterize}_sequence",
                "#{dashboard_type} – Order" %>
          <%= text_field_tag "user[preferences][dashboard][#{dashboard_type}][sequence]",
                config["sequence"],
                class: "form-control",
                id: "user_preferences_dashboard_#{dashboard_type.parameterize}_sequence",
                placeholder: "e.g. Default,Budget,Compliance" %>
          <small class="form-text text-muted">Comma-separated names. First becomes the default view.</small>
        </div>
      <% end %>
      <hr>
    <% end %>

    <div class="form-group">
      <%= form.submit t_common(:save), {class: "btn btn-outline-primary"} %>
    </div>
  <% end %>

<% end %>
