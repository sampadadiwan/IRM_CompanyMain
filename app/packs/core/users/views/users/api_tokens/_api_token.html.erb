<tr id="<%= dom_id(api_token) %>">
  <td><i class="ti ti-key me-1"></i> <%= api_token.name %></td>
  <td><%= l(api_token.created_at.to_date) %></td>
  <td><%= api_token.last_used_at ? l(api_token.last_used_at, format: :abbr_date_time) : "—" %></td>
  <td>
    <% if api_token.live? %>
      <span class="badge bg-success-subtle text-success"><i class="ti ti-circle-check"></i> Live until <%= l(api_token.expires_at.to_date) %></span>
    <% elsif api_token.revoked_at %>
      <span class="badge bg-secondary-subtle text-secondary"><i class="ti ti-ban"></i> Revoked <%= l(api_token.revoked_at.to_date) %></span>
    <% else %>
      <span class="badge bg-secondary-subtle text-secondary"><i class="ti ti-clock"></i> Expired</span>
    <% end %>
  </td>
  <td>
    <% if api_token.live? %>
      <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
              data-bs-target="#revokeApiTokenModal<%= api_token.id %>" id="revoke_api_token_<%= api_token.id %>">
        <i class="ti ti-ban"></i> Revoke
      </button>
    <% end %>
  </td>
</tr>
