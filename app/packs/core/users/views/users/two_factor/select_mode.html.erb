<%# Two-factor mode selection: WhatsApp (simple) or Authenticator (secure) %>
<div id="two_factor_select_mode_page" data-controller="two-factor-mode">
  <div class="login-container">
    <div class="login-header">
      <h2 class="h3 mb-2 fw-normal">Set Up Two-Factor Authentication</h2>
      <p class="text-muted">Choose how you'd like to receive your verification codes</p>
    </div>

    <div class="login-body">
      <%- flash.each do |name, msg| -%>
        <%= content_tag :div, msg, id: "flash_#{name}", class: "alert alert-info text-center" if msg.is_a?(String) %>
      <%- end -%>

      <%= form_tag select_mode_two_factor_path, method: :post, data: { turbo: false } do %>
        <div class="d-flex flex-column gap-3 mb-4">

          <label class="mfa-option <%= 'mfa-option--disabled' unless @user.whatsapp_enabled? %>">
            <%= radio_button_tag :two_factor_mode, "whatsapp", false,
                  disabled: !@user.whatsapp_enabled?,
                  data: { two_factor_mode_target: "radio", action: "change->two-factor-mode#toggle" } %>
            <div class="mfa-option__body">
              <div class="mfa-option__title">
                <i class="fab fa-whatsapp text-success"></i> WhatsApp
                <span class="mfa-option__badge">Easiest</span>
              </div>
              <% if @user.whatsapp_enabled? %>
                <div class="mfa-option__desc">
                  A code is sent to <strong><%= @user.masked_phone_with_call_code %></strong> each time you log in.
                  Nothing to install — but you'll need mobile signal.
                </div>
              <% else %>
                <div class="mfa-option__desc">
                  A code is sent to your WhatsApp each time you log in.
                  <span class="mfa-option__warning">Not enabled for your account — contact your administrator.</span>
                </div>
              <% end %>
            </div>
          </label>

          <%# SMS is offered only when the entity has it switched on AND we hold a number
              we can actually text. There is no per-user opt-in column — a valid mobile
              number is itself the entitlement. See SmsDeliverable. %>
          <% if @user.sms_otp_enabled? %>
            <label class="mfa-option">
              <%= radio_button_tag :two_factor_mode, "sms", false,
                    data: { two_factor_mode_target: "radio", action: "change->two-factor-mode#toggle" } %>
              <div class="mfa-option__body">
                <div class="mfa-option__title">
                  <i class="fas fa-comment-dots text-info"></i> Text message (SMS)
                </div>
                <div class="mfa-option__desc">
                  A code is texted to <strong><%= @user.masked_phone_with_call_code %></strong> each time you log in.
                  Nothing to install — but you'll need mobile signal, and codes can take a few seconds to arrive.
                </div>
              </div>
            </label>
          <% end %>

          <label class="mfa-option">
            <%= radio_button_tag :two_factor_mode, "authenticator", !@user.whatsapp_enabled?,
                  data: { two_factor_mode_target: "radio", action: "change->two-factor-mode#toggle" } %>
            <div class="mfa-option__body">
              <div class="mfa-option__title">
                <i class="fas fa-shield-alt text-primary"></i> Authenticator App
                <span class="mfa-option__badge">Most secure</span>
              </div>
              <div class="mfa-option__desc">
                A free app on your phone shows a 6-digit code that changes every 30 seconds.
                Works with no signal at all — on a plane, abroad, or underground.
              </div>
            </div>
          </label>

        </div>

        <button type="submit" class="glow-edge btn btn-primary w-100" data-disable-with="Continuing...">
          <span>Continue</span>
          <i class="fas fa-arrow-right"></i>
        </button>
      <% end %>

      <%# ── Help section ─────────────────────────────────────────────────
          Deliberately after the Continue button and visually separated: someone who
          already knows what an authenticator app is should reach the button without
          reading past a wall of onboarding material.

          The authenticator block inside is hidden unless that mode is selected — it
          is the tallest thing on the page and means nothing to a WhatsApp user. It
          ships hidden and Stimulus reveals it, so the pre-JS state is already right
          for the WhatsApp-enabled case (where nothing is preselected). %>
      <section class="mfa-help-section" aria-labelledby="mfa-help-heading">
        <h3 class="mfa-help-section__heading" id="mfa-help-heading">
          <i class="fas fa-question-circle"></i> New to this?
        </h3>

        <%# The always-present line sits directly under the heading rather than below the
            toggled block. When a mode other than Authenticator is selected the block is
            hidden, and with the old order that left the heading stranded above a single
            centred orphan line. %>
        <p class="mfa-help-section__intro">
          Not sure which to pick?
          <%= link_to "Compare the options",
                      public_guide_path("two_factor_authentication_user_guide"),
                      target: "_blank", rel: "noopener" %>
        </p>

        <div class="mfa-help-section__detail"
             data-two-factor-mode-target="authenticatorHelp"
             <%= "hidden" if @user.whatsapp_enabled? %>>
          <%= render "users/two_factor/guide_link" %>

          <div class="mt-3">
            <%= render "users/two_factor/authenticator_apps" %>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
