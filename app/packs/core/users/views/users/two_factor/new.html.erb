<%# Two-factor verification at login — behaviour differs by mode %>
<div id="two_factor_page" data-controller="two-factor">
  <div class="login-container">
    <div class="login-header">
      <h2 class="h3 mb-2 fw-normal">Two-Factor Authentication</h2>
      <% if @user.whatsapp_mode? %>
        <p class="text-muted">Enter the 6-digit code sent to your WhatsApp</p>
      <% elsif @user.sms_mode? %>
        <p class="text-muted">Enter the 6-digit code we texted you</p>
      <% else %>
        <p class="text-muted">Enter the 6-digit code from your authenticator app</p>
      <% end %>
    </div>

    <div class="login-body">
      <%- flash.each do |name, msg| -%>
        <%= content_tag :div, msg, id: "flash_#{name}", class: "alert alert-info text-center" if msg.is_a?(String) %>
      <%- end -%>

      <% if @user.whatsapp_mode? %>
        <div class="alert alert-success text-center mb-3">
          <i class="fab fa-whatsapp"></i>
          Code sent to <strong><%= @user.masked_phone_with_call_code %></strong>
        </div>
      <% elsif @user.sms_mode? %>
        <div class="alert alert-info text-center mb-3">
          <i class="fas fa-comment-dots"></i>
          Code texted to <strong><%= @user.masked_phone_with_call_code %></strong>
        </div>
      <% end %>

      <%= form_tag two_factor_path, data: { turbo: false } do %>
        <div class="form-group">
          <%= text_field_tag :otp_code, nil,
                class: "form-control-modern",
                placeholder: "000000",
                inputmode: "numeric",
                autocomplete: "one-time-code",
                required: true,
                autofocus: true,
                style: "text-align: center; font-size: 1.5rem; letter-spacing: 8px; font-weight: 600;" %>
        </div>

        <button type="submit" name="verify" class="glow-edge btn btn-primary w-100" data-disable-with="Verifying...">
          <span>Verify</span>
          <i class="fas fa-check"></i>
        </button>
      <% end %>

      <%# Fallbacks for authenticator-mode users who cannot reach their app — a lost or
          flat phone, typically. Getting in this way does not burn a backup code.
          Note the trade-off this makes deliberately: it caps an authenticator user's
          effective security at the strength of whichever fallback they have. %>
      <% if @user.authenticator_mode? && (@user.whatsapp_enabled? || @user.sms_otp_enabled?) %>
        <div class="divider w-100"><span>OR</span></div>

        <% if @user.whatsapp_enabled? %>
          <button type="button" id="send-whatsapp-btn" class="btn btn-secondary w-100" data-action="click->two-factor#sendWhatsapp">
            <i class="fab fa-whatsapp"></i> Send code via WhatsApp
          </button>
        <% end %>

        <% if @user.sms_otp_enabled? %>
          <button type="button" id="send-sms-btn" class="btn btn-secondary w-100 mt-2" data-action="click->two-factor#sendSms">
            <i class="fas fa-comment-dots"></i> Text me a code
          </button>
        <% end %>
      <% end %>

      <%# WhatsApp-mode users can request a resend %>
      <% if @user.whatsapp_mode? %>
        <div class="text-center mt-3">
          <button type="button" id="send-whatsapp-btn" class="btn btn-link" data-action="click->two-factor#sendWhatsapp">
            Resend code via WhatsApp
          </button>
        </div>
      <% end %>

      <%# SMS-mode resend. More prominent wording than the WhatsApp equivalent because
          it does more work here: a text can arrive after the code has already rolled,
          and resending is how the user gets a live one. %>
      <% if @user.sms_mode? %>
        <div class="text-center mt-3">
          <button type="button" id="send-sms-btn" class="btn btn-link" data-action="click->two-factor#sendSms">
            Didn't get it? Send another code
          </button>
        </div>
      <% end %>

      <div id="whatsapp-status" class="text-center mt-2" style="display: none;"></div>
      <div id="sms-status" class="text-center mt-2" style="display: none;"></div>

      <div class="login-footer text-center mt-3">
        <% if @user.sms_mode? %>
          Codes can take a few seconds to arrive. If one is rejected, request another rather than retyping it.
        <% elsif @user.authenticator_mode? %>
          Having trouble?
          <%= link_to "Troubleshoot authenticator codes",
                      public_guide_path("authenticator_app_setup_user_guide") + "#troubleshooting",
                      target: "_blank", rel: "noopener" %>
          or contact your administrator.
        <% else %>
          Having trouble?
          <%= link_to "Read the two-factor guide",
                      public_guide_path("two_factor_authentication_user_guide"),
                      target: "_blank", rel: "noopener" %>
          or contact your administrator.
        <% end %>
      </div>
    </div>
  </div>
</div>
