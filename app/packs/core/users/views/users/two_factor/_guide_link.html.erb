<%# Help callout on the two-factor screens.
    Points at PublicGuidesController, not /user_guides — at this point in the flow the
    visitor is signed out, so the normal guide route would bounce them to the login page
    and lose the half-finished enrollment.

    Locals (both optional):
      guide_id — which published guide to link (default: the authenticator setup guide)
      text     — the sentence before the link %>
<div class="mfa-help">
  <i class="fas fa-question-circle"></i>
  <div>
    <%= local_assigns.fetch(:text, "New to authenticator apps?") %>
    <%= link_to "Read the setup guide",
                public_guide_path(local_assigns.fetch(:guide_id, "authenticator_app_setup_user_guide")),
                target: "_blank", rel: "noopener" %>
    — it opens in a new tab, so you won't lose your place here.
  </div>
</div>
