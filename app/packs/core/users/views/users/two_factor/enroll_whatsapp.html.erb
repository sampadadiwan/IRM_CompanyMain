<%# WhatsApp-mode enrollment: user confirms a code sent to their WhatsApp %>
<div id="two_factor_enroll_whatsapp_page" data-controller="two-factor">
  <div class="login-container">
    <div class="login-header">
      <h2 class="h3 mb-2 fw-normal">Confirm Your WhatsApp</h2>
      <p class="text-muted">We've sent a 6-digit code to your WhatsApp</p>
    </div>

    <div class="login-body">
      <%- flash.each do |name, msg| -%>
        <%= content_tag :div, msg, id: "flash_#{name}", class: "alert alert-info text-center" if msg.is_a?(String) %>
      <%- end -%>

      <div class="alert alert-success text-center mb-3">
        <i class="fab fa-whatsapp"></i>
        Code sent to <strong><%= @user.masked_phone_with_call_code %></strong>
      </div>

      <%= form_tag verify_whatsapp_enrollment_two_factor_path, data: { turbo: false } do %>
        <div class="form-group">
          <%= text_field_tag :otp_code, nil,
                class: "form-control-modern w-100",
                placeholder: "000000",
                inputmode: "numeric",
                autocomplete: "one-time-code",
                autofocus: true,
                required: true,
                style: "text-align: center; font-size: 1.5rem; letter-spacing: 8px; font-weight: 600;" %>
        </div>

        <button type="submit" class="glow-edge btn btn-primary w-100" data-disable-with="Verifying...">
          <span>Confirm & Enable 2FA</span>
          <i class="fas fa-shield-alt"></i>
        </button>
      <% end %>

      <%# Resend, same control as the SMS enrollment page and the login verification
          screen. Hits send_whatsapp (30 s session cooldown server-side); the code is
          TOTP so a resend always ships whatever is currently valid. %>
      <div class="text-center mt-3">
        <button type="button" id="send-whatsapp-btn" class="btn btn-link"
                data-action="click->two-factor#sendWhatsapp">
          Didn't get it? Resend code via WhatsApp
        </button>
      </div>

      <div id="whatsapp-status" class="text-center mt-2" style="display: none;"></div>

      <div class="login-footer text-center mt-3">
        Wrong number? Contact your administrator — for security you can't change it here.
        <%= link_to "Read the two-factor guide",
                    public_guide_path("two_factor_authentication_user_guide"),
                    target: "_blank", rel: "noopener" %>
      </div>
    </div>
  </div>
</div>
