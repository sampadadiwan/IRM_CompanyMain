

  <div class="card shadow mb-4">

    <div class="card-header py-3">
      <h1 class="user-show-heading m-0 font-weight-bold text-primary">
        <%= link_to @user.name, @user %>
      </h1>
    </div>

    <div class="card-body">

      <table id="users" class="table table-bordered dataTable users-show-table">

        <tr>
          <td>
            First name
          </td>
          <td>
            <%=@user.first_name%>
          </td>
        </tr>
        <tr>
          <td>
            Last name
          </td>
          <td>
            <%=@user.last_name%>
          </td>
        </tr>
        <tr>
          <td>
            Email
          </td>
          <td>
            <%=@user.email%>
          </td>
        </tr>
        <tr>
          <td>
            Mobile Phone
          </td>
          <td>
            <%= "(#{@user.call_code})#{@user.phone}"%>
          </td>
        </tr>

        <tr>
          <td>
            Department
          </td>
          <td>
            <%=@user.dept %>
          </td>
        </tr>

        <tr>
          <td>
            Permissions
          </td>
          <td>
            <ul class="a11y-inline-list" aria-label="Permissions">
              <% @user.permissions.map { |p| p.to_s.titleize }.each do |permission| %>
                <li><span class="badge bg-success"><%= permission %></span></li>
              <% end %>
            </ul>
          </td>
        </tr>

        <% unless @user.has_cached_role?(:company_admin) %>
        <tr>
          <td>
            Extended Permissions
          </td>
          <td>
            <ul class="a11y-inline-list" aria-label="Extended Permissions">
              <% @user.extended_permissions.map { |p| p.to_s.titleize }.each do |permission| %>
                <li><span class="badge bg-success"><%= permission %></span></li>
              <% end %>
            </ul>
          </td>
        </tr>
        <% end %>

        <tr>
          <td>
            WhatsApp Enabled
          </td>
          <td>
            <%= display_boolean @user.whatsapp_enabled %>
          </td>
        </tr>

        <tr>
          <td>
            Support Enabled
          </td>
          <td>
            <%= display_boolean @user.enable_support %>
          </td>
        </tr>

        <%# Visible to the user themselves and to admins of their entity (UserPolicy#view_two_factor?),
            so an administrator can see which method someone is on before resetting it. %>
        <% if policy(@user).view_two_factor? %>
          <tr>
            <td>
              Two-Factor Authentication
              <%# 2FA's guide is served via the public/login-less route (PublicGuidesController),
                  not user_guide_icon_for, because that helper hides the icon for investor role —
                  this guide applies to every role and is on the public allowlist for exactly
                  that reason. %>
              <%= link_to public_guide_path("two_factor_authentication_user_guide"), target: "_blank",
                          'data-bs-toggle': 'tooltip', title: 'Two-Factor Authentication Guide',
                          class: 'btn btn-info p-0 rounded-circle d-inline-flex align-items-center justify-content-center',
                          style: 'width: 35px; height: 35px;', rel: 'noopener' do %>
                <i class="ti ti-info-circle fs-5" style="margin: 0 !important;"></i>
              <% end %>
            </td>
            <td>
              <%= display_boolean @user.two_factor_enabled %>
              <% if @user.two_factor_enabled && @user.two_factor_mode.present? %>
                <span class="badge bg-secondary ms-1" id="two_factor_mode_badge"><%= @user.two_factor_mode.titleize %></span>
              <% elsif @user.two_factor_enabled %>
                <span class="badge bg-warning text-dark ms-1" id="two_factor_mode_badge">Method not chosen yet</span>
              <% end %>
              <%# Only the trigger lives here; the modal itself is rendered after the table
                  (Bootstrap modals must sit outside cards/tables). %>
              <% if policy(@user).reset_two_factor? %>
                <button type="button" class="btn btn-sm btn-outline-warning ms-2"
                        id="reset_two_factor_button"
                        data-bs-toggle="modal" data-bs-target="#resetTwoFactorModal">
                  <i class="ti ti-shield-x"></i>
                  <%= @user == current_user ? "Change 2FA Method" : "Reset 2FA Method" %>
                </button>
              <% end %>
            </td>
          </tr>
        <% end %>

        <tr>
          <td>
            Entity
          </td>
          <td>
            <%=@user.entity.name if @user.entity_id %>
          </td>
        </tr>

        <tr>
          <td>
            Roles
          </td>
          <td>
            <ul class="a11y-stacked-list" aria-label="Roles">
              <li>Role Enabled: <%= @user.roles.collect(&:name) %></li>
              <li>Current Role: <%= @user.curr_role %></li>
            </ul>
          </td>
        </tr>

        <tr>
          <td>
            Tags
          </td>
          <td>
            <%= @user.tag_list %>
          </td>
        </tr>

        <%= display_custom_fields(@user) %>

        <% if @user.preferences&.dig("dashboard").present? %>
          <tr>
            <td colspan="2" class="fw-semibold pt-3">Dashboard Preferences</td>
          </tr>
          <tr>
            <td colspan="2" class="p-0">
              <table class="table table-sm table-bordered mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Dashboard</th>
                    <th>Order</th>
                    <th>Default</th>
                  </tr>
                </thead>
                <tbody>
                  <% @user.preferences["dashboard"].each do |dashboard_type, config| %>
                    <% sequence = config["sequence"].to_s.split(",").map(&:strip).compact_blank %>
                    <tr>
                      <td><%= dashboard_type %></td>
                      <td>
                        <% sequence.each_with_index do |name, i| %>
                          <span class="badge bg-secondary me-1"><%= "#{i + 1}. #{name}" %></span>
                        <% end %>
                      </td>
                      <td><span class="badge bg-primary"><%= sequence.first %></span></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </td>
          </tr>
        <% end %>

        <tr>
          <td>
            Regions
          </td>
          <td>
            <%= @user.regions %>
          </td>
        </tr>

        <tr>
          <td>
            Primary Region
          </td>
          <td>
            <%= @user.primary_region %>
          </td>
        </tr>

      </table>

      <div>
        <%= link_to  t_common(:edit) , edit_user_path(@user), {class: "btn btn-outline-primary ti ti-pencil" } if policy(@user).update? %>

        <%# Phones signed in to the LP mobile app (lp-mobile-app design card ③) — own profile only %>
        <% if @user == current_user && @user.mobile_devices.exists? %>
          <%= link_to users_mobile_devices_path, class: "btn btn-outline-primary", id: "mobile_devices_link" do %>
            <i class="ti ti-device-mobile"></i> Mobile Devices
          <% end %>
        <% end %>

        <%# Named tokens for scripts and integrations (funds-json-api-hardening card ①) — own profile only %>
        <% if @user == current_user %>
          <%= link_to users_api_tokens_path, class: "btn btn-outline-primary", id: "api_tokens_link" do %>
            <i class="ti ti-key"></i> API tokens
          <% end %>
        <% end %>

        <%= link_to root_path, class: "btn btn-outline-secondary ti ti-arrow-left" do %>
          Back to Dashboard
        <% end %>
      </div>

    </div>
  </div>

  <%# Advisor health check - support staff only, and only for accounts that are actually set up
      as an investor advisor. Answers "why can this advisor not switch companies?" without a
      console session. %>
  <% if current_user.support? && @user.investor_advisor_account? %>
    <%= render "users/investor_advisor_check", user: @user %>
  <% end %>

  <%# Reset-2FA confirmation popup (trigger button is in the Two-Factor row above). Rendered
      outside the card so the modal is not trapped in the card's stacking context. %>
  <% if policy(@user).reset_two_factor? %>
    <%= render "users/reset_two_factor_modal", user: @user, self_reset: (@user == current_user) %>
  <% end %>
