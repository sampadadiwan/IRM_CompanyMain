

  <div class="card shadow mb-4">

    <div class="card-header py-3">
      <h1 class="user-show-heading m-0 font-weight-bold text-primary">
        <%= link_to @user.name, @user %>
      </h1>
    </div>

    <div class="card-body">

      <table id="users" class="table table-bordered dataTable users-show-table">

        <tr>
          <td>
            First name
          </td>
          <td>
            <%=@user.first_name%>
          </td>
        </tr>
        <tr>
          <td>
            Last name
          </td>
          <td>
            <%=@user.last_name%>
          </td>
        </tr>
        <tr>
          <td>
            Email
          </td>
          <td>
            <%=@user.email%>
          </td>
        </tr>
        <tr>
          <td>
            Phone
          </td>
          <td>
            <%= "(#{@user.call_code})#{@user.phone}"%>
          </td>
        </tr>

        <tr>
          <td>
            Department
          </td>
          <td>
            <%=@user.dept %>
          </td>
        </tr>

        <tr>
          <td>
            Permissions
          </td>
          <td>
            <ul class="a11y-inline-list" aria-label="Permissions">
              <% @user.permissions.map { |p| p.to_s.titleize }.each do |permission| %>
                <li><span class="badge bg-success"><%= permission %></span></li>
              <% end %>
            </ul>
          </td>
        </tr>

        <% unless @user.has_cached_role?(:company_admin) %>
        <tr>
          <td>
            Extended Permissions
          </td>
          <td>
            <ul class="a11y-inline-list" aria-label="Extended Permissions">
              <% @user.extended_permissions.map { |p| p.to_s.titleize }.each do |permission| %>
                <li><span class="badge bg-success"><%= permission %></span></li>
              <% end %>
            </ul>
          </td>
        </tr>
        <% end %>

        <tr>
          <td>
            WhatsApp Enabled
          </td>
          <td>
            <%= display_boolean @user.whatsapp_enabled %>
          </td>
        </tr>

        <tr>
          <td>
            Support Enabled
          </td>
          <td>
            <%= display_boolean @user.enable_support %>
          </td>
        </tr>

        <% if @user == current_user %>
          <tr>
            <td>
              Two-Factor Authentication
              <%= user_guide_icon_for('two_factor', tooltip: 'Two-Factor Authentication Guide') %>
            </td>
            <td>
              <%= display_boolean @user.two_factor_enabled %>
              <% if @user.two_factor_enabled && @user.two_factor_mode.present? %>
                <span class="badge bg-secondary ms-1"><%= @user.two_factor_mode.titleize %></span>
              <% end %>
            </td>
          </tr>
        <% end %>

        <tr>
          <td>
            Entity
          </td>
          <td>
            <%=@user.entity.name if @user.entity_id %>
          </td>
        </tr>

        <tr>
          <td>
            Roles
          </td>
          <td>
            <ul class="a11y-stacked-list" aria-label="Roles">
              <li>Role Enabled: <%= @user.roles.collect(&:name) %></li>
              <li>Current Role: <%= @user.curr_role %></li>
            </ul>
          </td>
        </tr>

        <tr>
          <td>
            Tags
          </td>
          <td>
            <%= @user.tag_list %>
          </td>
        </tr>

        <%= display_custom_fields(@user) %>

        <% if @user.preferences&.dig("dashboard").present? %>
          <tr>
            <td colspan="2" class="fw-semibold pt-3">Dashboard Preferences</td>
          </tr>
          <tr>
            <td colspan="2" class="p-0">
              <table class="table table-sm table-bordered mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Dashboard</th>
                    <th>Order</th>
                    <th>Default</th>
                  </tr>
                </thead>
                <tbody>
                  <% @user.preferences["dashboard"].each do |dashboard_type, config| %>
                    <% sequence = config["sequence"].to_s.split(",").map(&:strip).compact_blank %>
                    <tr>
                      <td><%= dashboard_type %></td>
                      <td>
                        <% sequence.each_with_index do |name, i| %>
                          <span class="badge bg-secondary me-1"><%= "#{i + 1}. #{name}" %></span>
                        <% end %>
                      </td>
                      <td><span class="badge bg-primary"><%= sequence.first %></span></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </td>
          </tr>
        <% end %>

        <tr>
          <td>
            Regions
          </td>
          <td>
            <%= @user.regions %>
          </td>
        </tr>

        <tr>
          <td>
            Primary Region
          </td>
          <td>
            <%= @user.primary_region %>
          </td>
        </tr>

      </table>

      <div>
        <%= link_to  t_common(:edit) , edit_user_path(@user), {class: "btn btn-outline-primary ti ti-pencil" } if policy(@user).update? %>
      </div>


    </div>
  </div>
