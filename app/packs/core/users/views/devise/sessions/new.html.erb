<%
    @current_entity ||= nil
    @no_password_login = @current_entity&.entity_setting&.custom_flags&.no_password_login?
%>
<div id="login_page_x" data-controller="login" data-action="focusout->login#handleFocusOut">

  <div class="login-container">
    <div class="login-header">
       <h2 class="h3 mb-2 fw-normal">Welcome Back</h2>
       <p class="text-muted">Sign in to your account to continue</p>
    </div>

    <div class="login-body">
        <%= render "/layouts/display_status" if (notice || alert) && params[:display_status].present? %>

        <%# A failed region switch lands here; the banner is a Hash flash, so the loop below skips it. %>
        <%= render "devise/sessions/cross_region_alert" %>

        <%- flash.each do |name, msg| -%>
            <%= content_tag :div, msg, :id => "flash_#{name}", class: "alert alert-info text-center" if msg.is_a?(String) %>
        <%- end -%>

        <% unless @no_password_login  %>
            <%# Collapses away the moment the visitor puts focus in the magic-link form. %>
            <div class="login-section" data-login-target="passwordSection">
                <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "user-login-form", data: { turbo: false, action: "focusin->login#usePassword" } }) do |f| %>
                    <div class="form-group">
                        <div class="field-wrapper has-leading-icon">
                            <i class="ti ti-mail leading-icon"></i>
                            <input type="email" class="form-control-modern"
                                id="user_email"
                                required="required"
                                data-login-target="passwordEmail"
                                name="user[email]" value="<%=params[:email]%>"
                                placeholder="Email Address">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="field-wrapper has-leading-icon password-wrapper">
                            <i class="ti ti-lock leading-icon"></i>
                            <input type="password" class="form-control-modern"
                            name="user[password]" required="required"
                            id="user_password" placeholder="Password">
                            <i class="far fa-eye toggle-password" id="togglePassword"></i>
                        </div>
                    </div>

                    <div class="remember-me">
                         <input type="checkbox" id="user_remember_me" name="user[remember_me]">
                         <label for="user_remember_me">Remember Me</label>
                    </div>

                    <button type="submit" name="login" class="glow-edge btn btn-primary w-100" data-disable-with="Logging in...">
                        <span>Log In</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>

                <% end %>
            </div>

            <div class="login-section" data-login-target="dividerSection">
                <div class="divider"><span>OR</span></div>
            </div>
        <% end %>

        <%# The mirror image: focusing here collapses the password form above.
            Whatever address is already typed is carried across by the controller. %>
        <div class="login-section" data-login-target="magicSection">
            <%# turbo: false, matching the password form above and every 2FA form: this POST's
                redirect carries a one-time flash notice ("If that address is registered…").
                Left Turbo-driven, Turbo fetches that redirect, Rails reads and clears the
                flash rendering it, then the devise layout's turbo-visit-control meta tag
                (see devise.html.erb) makes Turbo discard that response and issue a SECOND,
                fresh request to the same URL — which arrives with the flash already swept. %>
            <%= form_for(resource, as: resource_name, url: "/users/magic_link", html: {id: "new_user_wo_pass", class: "magic-link-form", data: { turbo: false, action: "focusin->login#useMagic" }}) do |f| %>
                <input type="hidden" name="current_entity_id" value="<%= @current_entity&.id %>" />
                <input type="hidden" name="redirect_to" value="<%= session[:user_return_to] %>" />

                <div class="form-group">
                    <div class="field-wrapper has-leading-icon">
                        <i class="ti ti-send leading-icon"></i>
                        <input type="email" class="form-control-modern"
                            id="user_email_wo_pass"
                            required="required"
                            data-login-target="magicEmail"
                            name="user[email]" value="<%=params[:email]%>"
                            placeholder="Email Address for Magic Link">
                    </div>
                </div>

                <button type="submit" name="login_wo_pw" class="btn btn-secondary w-100" data-disable-with="Sending Link...">
                    Log In Via Email Link
                    <i class="fas fa-envelope"></i>
                </button>
            <% end %>
        </div>

        <% unless @no_password_login %>
            <%# Appears once a method is in focus, so there is always a way back to the other one. %>
            <button type="button" class="login-mode-switch d-none"
                    data-login-target="modeSwitch"
                    data-action="login#toggleMode"
                    data-password-label="Log in with an email link instead"
                    data-magic-label="Use your password instead"></button>
        <% end %>

        <div class="login-footer">
            <%= render "devise/shared/links" %>
        </div>
    </div>
  </div>

</div>
