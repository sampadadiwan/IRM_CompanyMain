<% content_for :title, "Invalid Link" %>
<div class="container py-4 py-md-5" style="max-width: 520px;">
  <%= render FormCard.new(title: "<i class='ti ti-link-off text-danger me-1'></i>Invalid or expired link", controller: "none") do %>
    <div class="text-center py-2">
      <i class="ti ti-link-off text-danger" style="font-size:3rem; opacity:0.7;"></i>
      <p class="mt-3 mb-0 text-muted">
        This link is no longer valid — it may have been tampered with, or the workflow may have been
        archived. Please contact your administrator if you believe this is an error.
      </p>
    </div>
  <% end %>
</div>
