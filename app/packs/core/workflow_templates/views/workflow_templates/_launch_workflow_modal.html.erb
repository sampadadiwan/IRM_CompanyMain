<%# Launch Workflow modal, opened by any button with data-bs-target="#launchWorkflowModal".
    Rendered by the Workflow tab and the investor page; the caller decides when it applies
    (admin, a launchable template, nothing running). Locals: workflowable, available_templates. %>
<div class="modal fade" id="launchWorkflowModal" tabindex="-1"
     aria-labelledby="launchWorkflowModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="launchWorkflowModalLabel">
          <i class="ti ti-player-play me-1 text-primary"></i>Launch Review Workflow
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%# POST to standalone /workflow_instances; workflowable identified by type+id params %>
      <%= form_with url: workflow_instances_path, method: :post, local: true do |f| %>
        <%= f.hidden_field :workflowable_type, value: workflowable.workflowable_type_name %>
        <%= f.hidden_field :workflowable_id,   value: workflowable.id %>
        <div class="modal-body">

          <div class="mb-4">
            <label class="form-label fw-semibold" for="launch_workflow_template_id">
              Select Review Template
            </label>
            <%= f.select :workflow_template_id,
                  available_templates.map { |wt|
                    ["#{wt.name} (#{wt.workflow_steps.size} step(s))", wt.id]
                  },
                  { include_blank: "— Choose a template —",
                    selected: workflowable.workflow_assignment&.workflow_template_id },
                  class: "form-select",
                  id: "launch_workflow_template_id",
                  required: true %>
            <div class="form-text">
              <%= link_to "Manage templates", workflow_templates_path, target: "_blank" %>
            </div>
          </div>

          <div class="border-start border-4 border-primary ps-3 py-1 mb-3">
            <div class="fw-bold text-dark small">What happens next</div>
            <div class="text-muted small">The following will happen immediately on launch:</div>
          </div>

          <div class="d-flex flex-column gap-2">
            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#eff6ff;">
              <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:36px;height:36px;background:#dbeafe;">
                <i class="ti ti-mail fs-5" style="color:#2563eb;"></i>
              </span>
              <div>
                <div class="fw-semibold text-dark lh-sm">Step 1 actors notified by email</div>
                <div class="text-muted small mt-1">
                  Each actor assigned to step 1 receives an email with a personalised magic link
                  so they can review and respond without logging in.
                </div>
              </div>
            </div>

            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#f0fdf4;">
              <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:36px;height:36px;background:#dcfce7;">
                <i class="ti ti-list-check fs-5" style="color:#16a34a;"></i>
              </span>
              <div>
                <div class="fw-semibold text-dark lh-sm">Progress tracked on this page</div>
                <div class="text-muted small mt-1">
                  Monitor step responses, send reminders, and advance or reset the workflow
                  from the timeline view.
                </div>
              </div>
            </div>

            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fffbeb;">
              <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:36px;height:36px;background:#fef3c7;">
                <i class="ti ti-copy fs-5" style="color:#d97706;"></i>
              </span>
              <div>
                <div class="fw-semibold text-dark lh-sm">Template snapshot taken</div>
                <div class="text-muted small mt-1">
                  The template is snapshotted at launch — future edits won't affect this
                  running workflow.
                </div>
              </div>
            </div>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Launch Workflow", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
