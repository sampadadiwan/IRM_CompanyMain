<%# The running workflow on a record: template, current step, Reset / Archive and a link to the full
    timeline. Rendered inside the Workflow tab and at the top of the investor page.
    Locals: workflowable (the record), active_instance (its active WorkflowInstance). %>
<div class="d-flex align-items-center justify-content-between mb-2">
  <h6 class="fw-bold mb-0">Active Workflow</h6>
</div>
<div class="card border mb-3">
  <div class="card-body p-3">
    <div class="d-flex justify-content-between align-items-start gap-2">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <i class="ti ti-workflow text-primary"></i>
          <span class="fw-semibold"><%= active_instance.template_name %></span>
          <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
        </div>
        <div class="text-muted small">
          Step <%= active_instance.current_step_position %>:
          <strong><%= active_instance.current_step_data&.dig(:name) %></strong>
          &nbsp;&middot;&nbsp;
          Launched <%= time_ago_in_words(active_instance.created_at) %> ago
          by <%= active_instance.launched_by&.full_name %>
        </div>
      </div>
      <% if policy(workflowable).assign_workflow? %>
        <div class="d-flex gap-2 flex-shrink-0">
          <%# Standalone workflow instance paths — no owning-object id param needed %>
          <%= button_to "Reset to Step 1",
                reset_workflow_instance_path(active_instance),
                method: :post,
                data: { confirm: "Reset the workflow to step 1? All current responses will be archived." },
                class: "btn btn-sm btn-outline-warning" %>
          <%= button_to "Archive",
                archive_workflow_instance_path(active_instance),
                method: :post,
                data: { confirm: "Archive this workflow? This cannot be undone." },
                class: "btn btn-sm btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<%= link_to workflow_instance_path(active_instance),
      class: "btn btn-outline-primary btn-sm mb-3", data: { turbo: false } do %>
  <i class="ti ti-chart-gantt me-1"></i>View Full Workflow Timeline
<% end %>
