<%# ── Shared flow diagram (vertical spine or wrapping graph) — used by both   %>
<%#    workflow_templates/show (template definition, editable) and             %>
<%#    workflow_instances/show (a live run, read-only, with instance status    %>
<%#    overlaid onto the same visual structure).                               %>
<%#    A List | Graph switch (workflow_flow_view_controller) restyles the same  %>
<%#    markup as a wrapping left-to-right graph via the `wffd-graph` modifier.   %>
<%#    Locals: steps (Array<WorkflowStepDiagramPresenter>), workflow_template     %>
<%#    (nil in instance mode), editable (bool).                                  %>

<% if steps.empty? %>
  <div class="text-center py-5 text-muted">
    <i class="ti ti-layout-list" style="font-size:2.5rem; opacity:0.3;"></i>
    <p class="mt-2 mb-0">No steps defined yet.</p>
  </div>
<% else %>
  <div data-controller="workflow-flow-view">
  <%# ── List / Graph switch — same markup, the graph is the `wffd-graph` modifier ── %>
  <div class="d-flex justify-content-end mb-2">
    <div class="btn-group btn-group-sm" role="group" aria-label="Diagram layout">
      <button type="button" class="btn btn-outline-primary active" aria-pressed="true"
              data-view="list" data-workflow-flow-view-target="button"
              data-action="workflow-flow-view#switch" title="Vertical list">
        <i class="ti ti-list me-1"></i>List
      </button>
      <button type="button" class="btn btn-outline-primary" aria-pressed="false"
              data-view="graph" data-workflow-flow-view-target="button"
              data-action="workflow-flow-view#switch" title="Wrapping graph — whole flow on one screen">
        <i class="ti ti-hierarchy-3 me-1"></i>Graph
      </button>
    </div>
  </div>

  <div class="wffd" data-workflow-flow-view-target="diagram">

    <%# ════════════════════════════════════════════════════════════════════ %>
    <%#  START terminus                                                     %>
    <div class="wffd-terminus">
      <div class="wffd-spine-dot wffd-dot-start">
        <i class="ti ti-player-play"></i>
      </div>
      <span class="wffd-terminus-label">Start</span>
    </div>

    <%# ════════════════════════════════════════════════════════════════════ %>
    <%#  Each step                                                          %>
    <% steps.each do |step| %>
      <%# ── Helpers ── %>
      <%
        q_class = case step.quorum_rule
                   when "any_one"  then "wf-rule-success"
                   when "majority" then "wf-rule-warning"
                   when "all"      then "wf-rule-info"
                   end
        q_icon = case step.quorum_rule
                  when "any_one"  then "ti-user-check"
                  when "majority" then "ti-user-star"
                  when "all"      then "ti-users"
                  end
        q_label = step.quorum_rule == "any_one" ? "Any one" : step.quorum_rule.humanize

        r_color = case step.on_reject_rule
                   when "stop"          then "danger"
                   when "restart"       then "warning"
                   when "previous_step" then "info"
                   when "go_to_step_n"  then "info"
                   else "secondary"
                   end
        r_icon = case step.on_reject_rule
                  when "stop"          then "ti-ban"
                  when "restart"       then "ti-rotate"
                  when "previous_step" then "ti-arrow-back"
                  when "go_to_step_n"  then "ti-arrow-badge-right"
                  else "ti-question-mark"
                  end
        r_label = case step.on_reject_rule
                   when "stop"          then "Stop workflow"
                   when "restart"       then "Restart from step 1"
                   when "previous_step" then "Return to previous step"
                   when "go_to_step_n"  then "Go to step #{step.on_reject_target_step}"
                   else step.on_reject_rule.humanize
                   end

        dot_status_class = if step.instance_mode?
                             step.done? ? "wffd-step-dot-done" : step.current? ? "wffd-step-dot-current" : "wffd-step-dot-pending"
                           end
        card_status_class = if step.instance_mode?
                              step.done? ? "wffd-card-done" : step.current? ? "wffd-card-current" : "wffd-card-pending"
                            end
      %>

      <div class="wffd-step-wrap">

        <%# ── Spine dot ── %>
        <div class="wffd-step-dot <%= dot_status_class %>">
          <% if step.instance_mode? && step.done? %>
            <i class="ti ti-check"></i>
          <% else %>
            <%= step.position %>
          <% end %>
        </div>

        <%# ── Horizontal connector (spine dot → card) ── %>
        <div class="wffd-card-connector"></div>

        <%# ── Step card ── %>
        <div class="wffd-card <%= card_status_class %>">
          <div class="wffd-card-header">
            <div class="wffd-card-title"><%= step.name %></div>
            <% if editable %>
              <div class="wffd-card-actions">
                <%= link_to edit_workflow_template_workflow_step_path(workflow_template, step.workflow_step),
                      class: "btn btn-sm btn-light d-flex align-items-center gap-1",
                      title: "Edit step" do %>
                  <i class="ti ti-edit" style="font-size:0.8rem;"></i>
                <% end %>
                <%= button_to workflow_template_workflow_step_path(workflow_template, step.workflow_step),
                      method: :delete,
                      class: "btn btn-sm btn-light text-danger d-flex align-items-center",
                      form_class: "d-inline deleteButton",
                      title: "Delete step",
                      data: { action: "click->confirm#popup", turbo: false } do %>
                  <i class="ti ti-trash" style="font-size:0.8rem;"></i>
                <% end %>
              </div>
            <% end %>
          </div>

          <% if step.description.present? %>
            <div class="wffd-card-desc"><%= step.description %></div>
          <% end %>

          <div class="d-flex flex-wrap gap-1 mb-2">
            <% step.state_list.each_with_index do |state, si| %>
              <%
                pill = case state.downcase
                       when /approv/   then "wf-state-approved"
                       when /reject/   then "wf-state-rejected"
                       when /tentative/ then "wf-state-tentative"
                       else "wf-state-default"
                       end
              %>
              <span class="wf-state-pill <%= pill %>">
                <%= state %><% if si == 0 %><span class="wffd-default-tag"> default</span><% end %>
              </span>
            <% end %>
          </div>

          <% if step.instance_mode? %>
            <%# ── Instance overlay: resolved / in-progress / pending status ── %>
            <% if step.resolved? %>
              <%
                rs = step.resolved_state_change.to_state.downcase
                pill = case rs
                       # "passed" is what evaluated (system-checked) steps resolve to
                       when /approv|pass/ then "wf-state-approved"
                       when /reject/    then "wf-state-rejected"
                       when /tentative/ then "wf-state-tentative"
                       else "wf-state-default"
                       end
              %>
              <div>
                <span class="wf-state-pill <%= pill %>">
                  <i class="ti ti-check me-1"></i><%= step.resolved_state_change.to_state %>
                </span>
                <span class="text-muted ms-1" style="font-size:0.7rem;">
                  <i class="ti ti-clock me-1"></i><%= l(step.resolved_state_change.created_at.to_date, format: :short) %>, <%= l(step.resolved_state_change.created_at, format: :time_only) %>
                </span>
              </div>
            <% elsif step.current? %>
              <span class="wf-rule-badge wf-rule-info wffd-step-rule">
                <i class="ti ti-loader"></i> In progress
              </span>
            <% else %>
              <span class="wf-rule-badge wf-rule-warning wffd-step-rule">
                <i class="ti ti-clock"></i> Pending
              </span>
            <% end %>
          <% elsif step.template_mode? %>
            <% if step.reminder_active %>
              <div>
                <% if step.reminder_interval_days.to_i.zero? %>
                  <span class="wf-rule-badge wf-rule-danger wffd-step-rule">
                    <i class="ti ti-bell-off"></i> Reminder disabled
                  </span>
                <% else %>
                  <span class="wf-rule-badge wf-rule-info wffd-step-rule">
                    <i class="ti ti-clock"></i> Every <%= pluralize(step.reminder_interval_days, "day") %>
                  </span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>

        <%# ── Quorum connector (dashed line) ── %>
        <div class="wffd-quorum-line-col"></div>

        <%# ── Sidebar (quorum badge + actor chips) ── %>
        <div class="wffd-sidebar">
          <% if step.evaluated? %>
            <%# ── Journey step (system / acknowledge): nobody votes, so quorum, actors and the     %>
            <%#    activation email don't apply. Show what completes it and who is reminded.      %>
            <div class="wffd-quorum-row">
              <% if step.kind.to_s == "acknowledge" %>
                <span class="wf-rule-badge wf-rule-warning wffd-quorum-badge" data-bs-toggle="tooltip"
                      data-bs-title="Someone with edit rights on the record clicks Mark reviewed">
                  <i class="ti ti-eye-check"></i>Needs review
                </span>
              <% else %>
                <span class="wf-rule-badge wf-rule-info wffd-quorum-badge" data-bs-toggle="tooltip"
                      data-bs-title="Passes by itself once the record's data meets the check">
                  <i class="ti ti-settings-automation"></i>Checked automatically
                </span>
              <% end %>
            </div>

            <div class="wffd-actors">
              <% if step.owner_user %>
                <div class="wf-actor-chip" data-bs-toggle="tooltip"
                     data-bs-title="Owner — reminded when this step stalls<%= "; emailed when it needs review" if step.kind.to_s == "acknowledge" %>">
                  <span class="wf-actor-avatar">
                    <%= step.owner_user.first_name.to_s.first.upcase %><%= step.owner_user.last_name.to_s.first.upcase %>
                  </span>
                  <span class="wf-actor-name"><%= step.owner_user.full_name %></span>
                </div>
              <% elsif step.template_mode? %>
                <%# No owner on the template: the reminder job falls back to the record's creator %>
                <span class="text-muted small d-flex align-items-center gap-1" data-bs-toggle="tooltip"
                      data-bs-title="No owner set — reminders go to whoever created the record">
                  <i class="ti ti-user"></i>Record creator (default)
                </span>
              <% else %>
                <%# Live run and nobody resolves: no one is being reminded, the template needs fixing %>
                <span class="text-danger small d-flex align-items-center gap-1" data-bs-toggle="tooltip"
                      data-bs-title="Nobody is being reminded about this step — set an owner on the journey template">
                  <i class="ti ti-user-off"></i>Owner unavailable
                </span>
              <% end %>
            </div>
          <% else %>
          <div class="wffd-quorum-row">
            <span class="wf-rule-badge <%= q_class %> wffd-quorum-badge">
              <i class="ti <%= q_icon %>"></i><%= q_label %>
            </span>
            <span class="wffd-notify-icon <%= step.notify_on_activation ? "wffd-notify-on" : "wffd-notify-off" %>"
                  data-bs-toggle="tooltip"
                  data-bs-title="<%= step.notify_on_activation ? "Emails actors when this step becomes active" : "Silent step — no email is sent when this step becomes active" %>">
              <i class="ti <%= step.notify_on_activation ? "ti-mail" : "ti-mail-off" %>"></i>
            </span>
          </div>

          <div class="wffd-actors">
            <% if step.actor_users.any? %>
              <div class="wffd-actors-inner">
                <% step.actor_users.each do |u| %>
                  <div class="wffd-actor-row <%= "wffd-actor-row-instance" if step.instance_mode? %>">
                    <div class="wf-actor-chip" title="<%= u.full_name %>">
                      <span class="wf-actor-avatar">
                        <%= u.first_name.to_s.first.upcase %><%= u.last_name.to_s.first.upcase %>
                      </span>
                      <span class="wf-actor-name"><%= u.full_name %></span>
                    </div>
                    <% if step.instance_mode? %>
                      <%
                        resp = step.response_for(u)
                      %>
                      <% if resp %>
                        <%
                          rs2 = resp.state.downcase
                          resp_key = case rs2
                                     when /approv/    then "approved"
                                     when /reject/    then "rejected"
                                     when /tentative/ then "tentative"
                                     else "default"
                                     end
                          ch_label = case resp.channel
                                     when "email_magic_link" then "Magic Link"
                                     when "auto_reminder"    then "Reminder"
                                     else "Manual"
                                     end
                          tooltip = "#{ch_label} · #{l(resp.responded_at.to_date, format: :short)}, #{l(resp.responded_at, format: :time_only)}"
                          tooltip += " — “#{resp.note}”" if resp.note.present?
                        %>
                        <span class="wffd-actor-connector wffd-actor-connector-<%= resp_key %>"></span>
                        <span class="wf-state-pill wf-state-<%= resp_key %>"
                              data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="<%= tooltip %>">
                          <%= resp.state %>
                        </span>
                      <% elsif step.current? %>
                        <span class="wffd-actor-connector wffd-actor-connector-pending"></span>
                        <span class="wf-state-pill wf-state-default">Pending</span>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% else %>
              <span class="text-danger small d-flex align-items-center gap-1">
                <i class="ti ti-alert-circle"></i>None assigned
              </span>
            <% end %>
          </div>
          <% end %>
        </div>

        <%# ── Reject rule (spans below the card) — only votes can reject, so not on journey steps ── %>
        <% unless step.evaluated? %>
          <div class="wffd-reject-rule">
            <span class="wffd-reject-label">If rejected</span>
            <span class="wf-rule-badge wf-rule-<%= r_color %>">
              <i class="ti <%= r_icon %>"></i><%= r_label %>
            </span>
          </div>
        <% end %>

      </div>
    <% end %>

    <%# ════════════════════════════════════════════════════════════════════ %>
    <%#  DONE terminus                                                      %>
    <div class="wffd-terminus">
      <div class="wffd-spine-dot wffd-dot-done">
        <i class="ti ti-circle-check"></i>
      </div>
      <span class="wffd-terminus-label wffd-terminus-done">Complete</span>
    </div>

  </div>
  </div>
<% end %>
