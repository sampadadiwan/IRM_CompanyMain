<tr id="<%= dom_id workflow_template %>">
  <td><%= link_to workflow_template.name, workflow_template_path(workflow_template) %></td>
  <td>
    <% if workflow_template.workflowable_type.present? %>
      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
        <%= workflow_template.workflowable_type.underscore.humanize %>
      </span>
    <% else %>
      <span class="text-muted">Any</span>
    <% end %>
  </td>
  <td>
    <% if workflow_template.workflow_steps.any? %>
      <ol class="mb-0 ps-3 d-flex flex-column gap-1">
        <% workflow_template.workflow_steps.each do |step| %>
          <li><%= step.name %></li>
        <% end %>
      </ol>
    <% else %>
      <span class="text-muted">None</span>
    <% end %>
  </td>
  <td><%= workflow_template.workflow_auto_assignment_rules.size %></td>
  <td><%= display_boolean workflow_template.attach_document_in_email %></td>
  <td>
    <% if policy(workflow_template).edit? %>
      <%= link_to edit_workflow_template_path(workflow_template), class: "btn btn-sm btn-outline-secondary" do %>
        <i class="ti ti-edit"></i>
      <% end %>
      <%= button_to workflow_template_path(workflow_template), method: :delete,
            class: "btn btn-sm btn-outline-danger", form_class: "d-inline deleteButton",
            data: { action: "click->confirm#popup", turbo: false } do %>
        <i class="ti ti-trash"></i>
      <% end %>
    <% end %>
  </td>
</tr>
