<%# ── Breadcrumb rendered globally via _breadcrumbs.html.erb ──────────── %>
<%# ── The page content (title + description + edit/delete + meta + diagram) ── %>
<%#    is wrapped in a single FormCard. The description becomes the note.     %>

<%= render FormCard.new(
      title: "<span class='d-inline-flex align-items-center gap-2'>" \
             "<i class='ti ti-route'></i>#{h @workflow_template.name}</span>".html_safe,
      note: @workflow_template.description,
      header_css_class: "fs-5",
      controller: "none"
    ) do %>

  <%# ── Disabled banner — the one thing to know before reading anything else on the page ── %>
  <% unless @workflow_template.enabled %>
    <div class="alert alert-warning d-flex align-items-start gap-2" id="template_disabled_banner">
      <i class="ti ti-player-pause mt-1"></i>
      <div>
        <strong>This template is disabled.</strong>
        It is not auto-assigned, does not appear in the Launch Workflow picker and cannot be launched,
        so records created from now on get nothing from it<%= " — including its journey" if @workflow_template.journey? %>.
        Workflows already running on it carry on unchanged.
      </div>
    </div>
  <% end %>

  <%# ── Meta tiles ───────────────────────────────────────────────────────── %>
  <div class="d-flex flex-wrap gap-3 mb-4">
    <div class="wf-meta-tile">
      <div class="wf-meta-icon <%= @workflow_template.enabled ? 'bg-success bg-opacity-10 text-success' : 'bg-secondary bg-opacity-10 text-secondary' %>">
        <i class="ti <%= @workflow_template.enabled ? 'ti-player-play' : 'ti-player-pause' %>"></i>
      </div>
      <div>
        <div class="wf-meta-label">Status</div>
        <div class="wf-meta-value"><%= @workflow_template.enabled ? "Enabled" : "Disabled" %></div>
      </div>
    </div>
    <% if @workflow_template.workflowable_type.present? %>
      <div class="wf-meta-tile">
        <div class="wf-meta-icon bg-secondary bg-opacity-10 text-secondary">
          <i class="ti ti-tag"></i>
        </div>
        <div>
          <div class="wf-meta-label">Applies to</div>
          <div class="wf-meta-value"><%= @workflow_template.workflowable_type.underscore.humanize %></div>
        </div>
      </div>
    <% end %>
    <div class="wf-meta-tile">
      <div class="wf-meta-icon bg-primary bg-opacity-10 text-primary">
        <i class="ti ti-list-check"></i>
      </div>
      <div>
        <div class="wf-meta-label">Steps</div>
        <div class="wf-meta-value"><%= @workflow_template.workflow_steps.count %></div>
      </div>
    </div>
    <div class="wf-meta-tile">
      <div class="wf-meta-icon bg-info bg-opacity-10 text-info">
        <i class="ti ti-clock"></i>
      </div>
      <div>
        <div class="wf-meta-label">Reminder</div>
        <div class="wf-meta-value">
          <% if @workflow_template.reminder_interval_days.present? %>
            Every <%= pluralize(@workflow_template.reminder_interval_days, "day") %>
          <% else %>
            <span class="text-muted fw-normal">Off</span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="wf-meta-tile">
      <div class="wf-meta-icon bg-success bg-opacity-10 text-success">
        <i class="ti ti-layout-kanban"></i>
      </div>
      <div>
        <div class="wf-meta-label">Assigned to</div>
        <div class="wf-meta-value"><%= pluralize(@workflow_template.active_workflowable_count, "object") %></div>
      </div>
    </div>
    <% if @workflow_template.attach_document_in_email %>
      <div class="wf-meta-tile">
        <div class="wf-meta-icon bg-warning bg-opacity-10 text-warning">
          <i class="ti ti-paperclip"></i>
        </div>
        <div>
          <div class="wf-meta-label">Email</div>
          <div class="wf-meta-value">Docs attached</div>
        </div>
      </div>
    <% end %>
    <% if @workflow_template.gated_button_labels.present? %>
      <div class="wf-meta-tile">
        <div class="wf-meta-icon bg-danger bg-opacity-10 text-danger">
          <i class="ti ti-lock"></i>
        </div>
        <div>
          <div class="wf-meta-label">Locked buttons</div>
          <div class="wf-meta-value"><%= @workflow_template.gated_button_labels %></div>
        </div>
      </div>
    <% end %>
  </div>

  <%# ── Flow diagram ─────────────────────────────────────────────────────── %>
  <%
    steps = @workflow_template.workflow_steps.includes(:workflow_step_actors => :user)
    step_presenters = steps.map { |s| WorkflowStepDiagramPresenter.for_template_step(s) }
  %>

  <%= render "workflow_templates/flow_diagram",
        steps: step_presenters,
        workflow_template: @workflow_template,
        editable: policy(@workflow_template).edit? %>

  <%# ── Add step button ──────────────────────────────────────────────────── %>
  <% if policy(@workflow_template).edit? %>
    <div class="mt-3">
      <%= link_to new_workflow_template_workflow_step_path(@workflow_template),
            class: "wf-add-step" do %>
        <i class="ti ti-plus me-2"></i> Add Step
      <% end %>
    </div>
  <% end %>

  <%# ── Action buttons (Edit / Delete) — bottom of card, per convention ── %>
  <% if policy(@workflow_template).edit? %>
    <div class="associated_entity">
      <%= user_guide_info_icon %>
      <%= link_to edit_workflow_template_path(@workflow_template),
            class: "btn btn-outline-primary" do %>
        <i class="ti ti-edit me-1"></i> Edit Template
      <% end %>
      <%# Retire / bring back — the alternative to Delete for a template that has history.
          data-method is needed as well as the form's own method: the shared confirm modal copies
          it into its hidden form, which otherwise defaults to DELETE (a verb this route rejects). %>
      <%= button_to toggle_enabled_workflow_template_path(@workflow_template), method: :patch,
            id: "toggle_enabled_btn",
            class: "btn btn-outline-secondary",
            form_class: "d-inline deleteButton",
            data: { action: "click->confirm#popup", turbo: false, method: :patch,
                    title: "#{@workflow_template.enabled ? 'Disable' : 'Enable'} #{@workflow_template.name}",
                    msg: workflow_template_toggle_message(@workflow_template) } do %>
        <i class="ti <%= @workflow_template.enabled ? 'ti-player-pause' : 'ti-player-play' %> me-1"></i>
        <%= @workflow_template.enabled ? "Disable" : "Enable" %>
      <% end %>
      <%# Copy with all steps, e.g. to give one KYC form type its own journey (investor-kyc-journey E26) %>
      <% if policy(@workflow_template).duplicate? %>
        <%= button_to duplicate_workflow_template_path(@workflow_template), method: :post,
              class: "btn btn-outline-secondary", id: "workflow_template_duplicate_btn", form_class: "d-inline" do %>
          <i class="ti ti-copy me-1"></i> Duplicate
        <% end %>
      <% end %>
      <%= button_to workflow_template_path(@workflow_template), method: :delete,
            class: "btn btn-outline-danger",
            form_class: "deleteButton",
            data: { action: "click->confirm#popup", turbo: false } do %>
        <i class="ti ti-trash me-1"></i> Delete
      <% end %>
    </div>
  <% end %>

<% end %>

<%# ── Tabs: Auto Assignment Rules + Instances ──────────────────────────── %>
<div class="associated_entity mt-4" data-controller="tabs">

  <nav class="nav nav-pills nav-justified p-3 mb-3 rounded align-items-center card flex-row" role="tablist">
    <a class="nav-link active" data-bs-toggle="pill" href="#auto-assignment-rules-tab">
      <i class="ti ti-robot me-1"></i>Auto Assignment Rules
    </a>
    <a class="nav-link" data-bs-toggle="pill" href="#instances-tab">
      <i class="ti ti-workflow me-1"></i>Instances
    </a>
  </nav>

  <div class="tab-content">

    <%# ── Auto Assignment Rules tab ──────────────────────────────────────── %>
    <div id="auto-assignment-rules-tab" class="tab-pane fade in show active">
      <div class="associated_entity">
        <% if policy(WorkflowAutoAssignmentRule).index? %>
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-bold mb-0">
              <i class="ti ti-robot me-1 text-primary"></i>Auto-assignment Rules
            </h6>
            <% if policy(@workflow_template).edit? %>
              <%= link_to new_workflow_template_workflow_auto_assignment_rule_path(@workflow_template),
                    class: "btn btn-sm btn-outline-primary" do %>
                <i class="ti ti-plus me-1"></i>Add Rule
              <% end %>
            <% end %>
          </div>

          <% rules = @workflow_template.workflow_auto_assignment_rules.order(:priority, :id) %>
          <%# The chain each rule sits in, across every template for the same record type — what decides
              whether a rule can ever win. Without it a shadowed rule looks as live as any other.
              Keyed by type because nothing stops a template's rules covering more than one. %>
          <% chains = WorkflowRuleChain.for_template(@workflow_template).index_by(&:workflowable_type) %>
          <%# One field list per record type, shared by every rule row (not one per rule) %>
          <% rule_describer = Hash.new { |h, type| h[type] = WorkflowRuleFields.for(type, @workflow_template.entity) } %>
          <%# A disabled template's rules are dormant, not dead: they stand aside and resume on enable.
              Said here because the rows below otherwise look live. %>
          <% if rules.any? && !@workflow_template.enabled %>
            <p class="text-muted small" id="rules_inert_note">
              <i class="ti ti-info-circle me-1"></i>
              These rules are dormant while the template is disabled: they are skipped, so the next matching
              rule for this type applies instead, and they resume exactly as they are when you enable it.
            </p>
          <% end %>
          <% if rules.any? %>
            <table class="table table-sm table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Conditions</th>
                  <th>Auto-launch?</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% rules.each do |rule| %>
                  <tr>
                    <td class="align-middle"><%= rule.priority %></td>
                    <td class="align-middle">
                      <%= workflow_rule_status_badge(chains[rule.workflowable_type]&.finding_for(rule)) %>
                    </td>
                    <td class="align-middle">
                      <% if Array(rule.conditions).empty? %>
                        <span class="text-muted">Always (catch-all)</span>
                      <% else %>
                        <%# In words, from the same field list the rule form uses
                            (workflow-rule-condition-builder card 8) %>
                        <span class="rule-conditions-text" id="rule_conditions_<%= rule.id %>">
                          <%= Array(rule.conditions).map { |c| rule_describer[rule.workflowable_type].describe(c) }.join(" and ") %>
                        </span>
                      <% end %>
                    </td>
                    <td class="align-middle">
                      <% if rule.auto_launch %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Yes</span>
                      <% else %>
                        <span class="text-muted">No</span>
                      <% end %>
                    </td>
                    <td class="align-middle text-end">
                      <% if policy(@workflow_template).edit? %>
                        <%= link_to edit_workflow_template_workflow_auto_assignment_rule_path(@workflow_template, rule),
                              class: "btn btn-sm btn-light me-1" do %>
                          <i class="ti ti-edit"></i>
                        <% end %>
                        <%= button_to workflow_template_workflow_auto_assignment_rule_path(@workflow_template, rule),
                              method: :delete,
                              class: "btn btn-sm btn-light text-danger",
                              form_class: "d-inline deleteButton",
                              data: { action: "click->confirm#popup", turbo: false } do %>
                          <i class="ti ti-trash"></i>
                        <% end %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted small mb-0">
              No rules configured. Add a rule to automatically assign this template to newly created objects.
            </p>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# ── Instances tab — lazy-loaded via turbo frame ─────────────────────── %>
    <div id="instances-tab" class="tab-pane fade in">
      <div class="associated_entity">
        <%= turbo_frame_tag "workflow_instances_frame", target: "_top", loading: :lazy,
              src: workflow_instances_path(workflow_template_id: @workflow_template.id) do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>

  </div>
</div>
