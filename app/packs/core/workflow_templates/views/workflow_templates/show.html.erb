<%# ── Breadcrumb rendered globally via _breadcrumbs.html.erb ──────────── %>
<%# ── The page content (title + description + edit/delete + meta + diagram) ── %>
<%#    is wrapped in a single FormCard. The description becomes the note.     %>

<%= render FormCard.new(
      title: "<span class='d-inline-flex align-items-center gap-2'>" \
             "<i class='ti ti-route'></i>#{h @workflow_template.name}</span>".html_safe,
      note: @workflow_template.description,
      header_css_class: "fs-5",
      controller: "none"
    ) do %>

  <%# ── Meta tiles ───────────────────────────────────────────────────────── %>
  <div class="d-flex flex-wrap gap-3 mb-4">
    <div class="wf-meta-tile">
      <div class="wf-meta-icon bg-primary bg-opacity-10 text-primary">
        <i class="ti ti-list-check"></i>
      </div>
      <div>
        <div class="wf-meta-label">Steps</div>
        <div class="wf-meta-value"><%= @workflow_template.workflow_steps.count %></div>
      </div>
    </div>
    <div class="wf-meta-tile">
      <div class="wf-meta-icon bg-info bg-opacity-10 text-info">
        <i class="ti ti-clock"></i>
      </div>
      <div>
        <div class="wf-meta-label">Reminder</div>
        <div class="wf-meta-value">
          <% if @workflow_template.reminder_interval_days.present? %>
            Every <%= pluralize(@workflow_template.reminder_interval_days, "day") %>
          <% else %>
            <span class="text-muted fw-normal">Off</span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="wf-meta-tile">
      <div class="wf-meta-icon bg-success bg-opacity-10 text-success">
        <i class="ti ti-folder"></i>
      </div>
      <div>
        <div class="wf-meta-label">Used by</div>
        <div class="wf-meta-value"><%= pluralize(@workflow_template.active_folder_count, "folder") %></div>
      </div>
    </div>
    <% if @workflow_template.attach_document_in_email %>
      <div class="wf-meta-tile">
        <div class="wf-meta-icon bg-warning bg-opacity-10 text-warning">
          <i class="ti ti-paperclip"></i>
        </div>
        <div>
          <div class="wf-meta-label">Email</div>
          <div class="wf-meta-value">Docs attached</div>
        </div>
      </div>
    <% end %>
  </div>

  <%# ── Flow diagram ─────────────────────────────────────────────────────── %>
  <%
    steps = @workflow_template.workflow_steps.includes(:workflow_step_actors => :user)
  %>

  <% if steps.empty? %>
    <div class="text-center py-5 text-muted">
      <i class="ti ti-layout-list" style="font-size:2.5rem; opacity:0.3;"></i>
      <p class="mt-2 mb-0">No steps defined yet.</p>
    </div>
  <% else %>
    <div class="wffd">

      <%# ════════════════════════════════════════════════════════════════════ %>
      <%#  START terminus                                                     %>
      <div class="wffd-terminus">
        <div class="wffd-spine-dot wffd-dot-start">
          <i class="ti ti-player-play"></i>
        </div>
        <span class="wffd-terminus-label">Start</span>
      </div>

      <%# ════════════════════════════════════════════════════════════════════ %>
      <%#  Each step                                                          %>
      <% steps.each_with_index do |step, idx| %>
        <%# ── Helpers ── %>
        <%
          q_class = case step.quorum_rule
                     when "any_one"  then "wf-rule-success"
                     when "majority" then "wf-rule-warning"
                     when "all"      then "wf-rule-info"
                     end
          q_icon = case step.quorum_rule
                    when "any_one"  then "ti-user-check"
                    when "majority" then "ti-user-star"
                    when "all"      then "ti-users"
                    end
          q_label = step.quorum_rule == "any_one" ? "Any one" : step.quorum_rule.humanize

          r_color = case step.on_reject_rule
                     when "stop"          then "danger"
                     when "restart"       then "warning"
                     when "previous_step" then "info"
                     when "go_to_step_n"  then "info"
                     else "secondary"
                     end
          r_icon = case step.on_reject_rule
                    when "stop"          then "ti-ban"
                    when "restart"       then "ti-rotate"
                    when "previous_step" then "ti-arrow-back"
                    when "go_to_step_n"  then "ti-arrow-badge-right"
                    else "ti-question-mark"
                    end
          r_label = case step.on_reject_rule
                     when "stop"          then "Stop workflow"
                     when "restart"       then "Restart from step 1"
                     when "previous_step" then "Return to previous step"
                     when "go_to_step_n"  then "Go to step #{step.on_reject_target_step}"
                     else step.on_reject_rule.humanize
                     end
        %>

        <div class="wffd-step-wrap">

          <%# ── Spine dot ── %>
          <div class="wffd-step-dot"><%= step.position %></div>

          <%# ── Horizontal connector (spine dot → card) ── %>
          <div class="wffd-card-connector"></div>

          <%# ── Step card ── %>
          <div class="wffd-card">
            <div class="wffd-card-header">
              <div class="wffd-card-title"><%= step.name %></div>
              <% if policy(@workflow_template).edit? %>
                <div class="wffd-card-actions">
                  <%= link_to edit_workflow_template_workflow_step_path(@workflow_template, step),
                        class: "btn btn-sm btn-light d-flex align-items-center gap-1",
                        title: "Edit step" do %>
                    <i class="ti ti-edit" style="font-size:0.8rem;"></i>
                  <% end %>
                  <%= button_to workflow_template_workflow_step_path(@workflow_template, step),
                        method: :delete,
                        class: "btn btn-sm btn-light text-danger d-flex align-items-center",
                        form_class: "d-inline deleteButton",
                        title: "Delete step",
                        data: { action: "click->confirm#popup", turbo: false } do %>
                    <i class="ti ti-trash" style="font-size:0.8rem;"></i>
                  <% end %>
                </div>
              <% end %>
            </div>

            <% if step.description.present? %>
              <div class="wffd-card-desc"><%= step.description %></div>
            <% end %>

            <div class="d-flex flex-wrap gap-1 mb-2">
              <% step.state_list.each_with_index do |state, si| %>
                <%
                  pill = case state.downcase
                         when /approv/   then "wf-state-approved"
                         when /reject/   then "wf-state-rejected"
                         when /tentative/ then "wf-state-tentative"
                         else "wf-state-default"
                         end
                %>
                <span class="wf-state-pill <%= pill %>">
                  <%= state %><% if si == 0 %><span class="wffd-default-tag"> default</span><% end %>
                </span>
              <% end %>
            </div>

            <% if step.reminder_interval_days_before_type_cast.present? %>
              <div>
                <% if step.reminder_interval_days.to_i.zero? %>
                  <span class="wf-rule-badge wf-rule-danger wffd-step-rule">
                    <i class="ti ti-bell-off"></i> Reminder disabled
                  </span>
                <% else %>
                  <span class="wf-rule-badge wf-rule-info wffd-step-rule">
                    <i class="ti ti-clock"></i> Every <%= pluralize(step.reminder_interval_days, "day") %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>

          <%# ── Quorum connector (dashed line) ── %>
          <div class="wffd-quorum-line-col"></div>

          <%# ── Sidebar (quorum badge + actor chips) ── %>
          <div class="wffd-sidebar">
            <div class="wffd-quorum-row">
              <span class="wf-rule-badge <%= q_class %> wffd-quorum-badge">
                <i class="ti <%= q_icon %>"></i><%= q_label %>
              </span>
            </div>

            <div class="wffd-actors">
              <% if step.actor_users.any? %>
                <div class="wffd-actors-inner">
                  <% step.actor_users.each do |u| %>
                    <div class="wf-actor-chip">
                      <span class="wf-actor-avatar">
                        <%= u.first_name.to_s.first.upcase %><%= u.last_name.to_s.first.upcase %>
                      </span>
                      <%= u.full_name %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <span class="text-danger small d-flex align-items-center gap-1">
                  <i class="ti ti-alert-circle"></i>None assigned
                </span>
              <% end %>
            </div>
          </div>

          <%# ── Reject rule (spans below the card) ── %>
          <div class="wffd-reject-rule">
            <span class="wffd-reject-label">If rejected</span>
            <span class="wf-rule-badge wf-rule-<%= r_color %>">
              <i class="ti <%= r_icon %>"></i><%= r_label %>
            </span>
          </div>

        </div>
      <% end %>

      <%# ════════════════════════════════════════════════════════════════════ %>
      <%#  DONE terminus                                                      %>
      <div class="wffd-terminus">
        <div class="wffd-spine-dot wffd-dot-done">
          <i class="ti ti-circle-check"></i>
        </div>
        <span class="wffd-terminus-label wffd-terminus-done">Complete</span>
      </div>

    </div>
  <% end %>

  <%# ── Add step button ──────────────────────────────────────────────────── %>
  <% if policy(@workflow_template).edit? %>
    <div class="mt-3">
      <%= link_to new_workflow_template_workflow_step_path(@workflow_template),
            class: "wf-add-step" do %>
        <i class="ti ti-plus me-2"></i> Add Step
      <% end %>
    </div>
  <% end %>

  <%# ── Action buttons (Edit / Delete) — bottom of card, per convention ── %>
  <% if policy(@workflow_template).edit? %>
    <div class="associated_entity">
      <%= link_to edit_workflow_template_path(@workflow_template),
            class: "btn btn-outline-primary" do %>
        <i class="ti ti-edit me-1"></i> Edit Template
      <% end %>
      <%= button_to workflow_template_path(@workflow_template), method: :delete,
            class: "btn btn-outline-danger",
            form_class: "deleteButton",
            data: { action: "click->confirm#popup", turbo: false } do %>
        <i class="ti ti-trash me-1"></i> Delete
      <% end %>
    </div>
  <% end %>

<% end %>
