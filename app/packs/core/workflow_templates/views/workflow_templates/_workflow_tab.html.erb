<%# Workflow tab panel — usable inside any Workflowable object's details view.
    Requires a `workflowable:` local (the object itself, e.g. a Folder, InvestorKyc,
    CapitalCommitment, CapitalCall, CapitalDistribution or Approval). Investors show the same
    pieces at the top of their page instead (investors/_workflow_summary). %>
<% active_instance = workflowable.workflow_instances.instance_active.first %>
<%# Enabled templates for this type that are eligible_for? this exact record (Workflowable#launchable_workflow_templates) %>
<% available_templates = workflowable.launchable_workflow_templates %>
<% past_instances = workflowable.workflow_instances.where.not(status: :active).order(created_at: :desc).limit(5) %>
<div class="p-3">

  <%# ── Active Workflow — only shown when one is running ───────────────────── %>
  <% if active_instance %>
    <%= render "workflow_templates/active_workflow_card", workflowable:, active_instance: %>
    <hr>
  <% end %>

  <%# ── Past Workflows header with Launch button on the right ──────────────── %>
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0 text-gray-800">Past Workflows</h1>
    <% if policy(workflowable).assign_workflow? && available_templates.any? && active_instance.nil? %>
      <div class="d-flex align-items-center gap-2">
        <%= user_guide_icon_for('workflow_templates', tooltip: 'Workflow Templates Guide') %>
        <button type="button" class="btn btn-primary"
                data-bs-toggle="modal" data-bs-target="#launchWorkflowModal">
          <i class="ti ti-player-play me-1"></i>Launch Workflow
        </button>
      </div>
    <% end %>
  </div>

  <% if past_instances.any? %>
    <table class="table table-sm table-hover">
      <thead class="table-light">
        <tr>
          <th>Template</th>
          <th>Status</th>
          <th>Launched</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% past_instances.each do |inst| %>
          <%
            st_color = case inst.status
                       when "complete"  then "success"
                       when "rejected"  then "danger"
                       when "archived"  then "secondary"
                       else "secondary"
                       end
          %>
          <tr>
            <td class="align-middle"><%= inst.template_name %></td>
            <td class="align-middle">
              <span class="badge bg-<%= st_color %>-subtle text-<%= st_color %> border border-<%= st_color %>-subtle">
                <%= inst.status.humanize %>
              </span>
            </td>
            <td class="align-middle text-muted small"><%= l(inst.created_at.to_date, format: :abbr_month_day_year) %></td>
            <td class="align-middle">
              <%= link_to "View", workflow_instance_path(inst),
                    class: "btn btn-sm btn-outline-secondary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% elsif active_instance.nil? %>
    <p class="text-muted small mb-0">
      <% if available_templates.any? %>
        No workflows have been run for this object yet. Click <strong>Launch Workflow</strong> to start one.
      <% elsif WorkflowTemplate.for_workflowable_type(workflowable.workflowable_type_name).where(entity_id: workflowable.entity_id).exists? %>
        <%# Templates exist for this type but every one of them is disabled (or scoped to another
            sub-audience) — don't tell the admin to create one they already have %>
        No template is available for this object.
        <%= link_to "Review your templates", workflow_templates_path %> — the ones that apply here may be disabled.
      <% else %>
        No review templates exist yet.
        <%= link_to "Create a template", new_workflow_template_path %> to enable workflows for this object.
      <% end %>
    </p>
  <% end %>

</div>

<%# ── Launch Workflow modal ───────────────────────────────────────────────── %>
<% if policy(workflowable).assign_workflow? && available_templates.any? && active_instance.nil? %>
  <%= render "workflow_templates/launch_workflow_modal", workflowable:, available_templates: %>
<% end %>
