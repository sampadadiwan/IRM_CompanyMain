<%# All workflow instances visible to the current entity — across all workflowable types %>
<%# Wrapping in turbo_frame allows this view to be lazy-loaded into the template show page instances tab %>
<%= turbo_frame_tag "workflow_instances_frame" do %>
<div class="d-flex align-items-center justify-content-between mb-4">
  <h4 class="fw-bold mb-0">
    <i class="ti ti-workflow me-2 text-primary"></i>Workflow Instances
  </h4>
  <%= user_guide_info_icon %>
</div>

<% if @instances.any? %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="font-size:0.78rem;">Object</th>
            <th style="font-size:0.78rem;">Type</th>
            <th style="font-size:0.78rem;">Template</th>
            <th style="font-size:0.78rem;">Status</th>
            <th style="font-size:0.78rem;">Step</th>
            <th style="font-size:0.78rem;">Launched</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @instances.each do |inst| %>
            <%
              st_color = { "active" => "primary", "complete" => "success",
                           "rejected" => "danger",  "archived" => "secondary" }
                           .fetch(inst.status, "secondary")
              st_icon  = { "active" => "ti-player-play", "complete" => "ti-circle-check",
                           "rejected" => "ti-circle-x",  "archived" => "ti-archive" }
                           .fetch(inst.status, "ti-help-circle")
            %>
            <tr>
              <td class="ps-3">
                <% if inst.workflowable.respond_to?(:workflow_display_name) %>
                  <span class="fw-semibold"><%= inst.workflowable.workflow_display_name %></span>
                <% else %>
                  <span class="text-muted fst-italic">Unknown</span>
                <% end %>
              </td>
              <td>
                <span class="badge bg-light text-dark border" style="font-size:0.72rem;">
                  <%= inst.workflowable_type&.humanize %>
                </span>
              </td>
              <td style="font-size:0.85rem;"><%= inst.template_name %></td>
              <td>
                <span class="badge bg-<%= st_color %>-subtle text-<%= st_color %> border border-<%= st_color %>-subtle d-flex align-items-center gap-1"
                      style="width:fit-content;">
                  <i class="ti <%= st_icon %>"></i><%= inst.status.humanize %>
                </span>
              </td>
              <td class="text-muted" style="font-size:0.85rem;">
                Step <%= inst.current_step_position %>
              </td>
              <td class="text-muted" style="font-size:0.82rem;">
                <%= time_ago_in_words(inst.created_at) %> ago
              </td>
              <td class="text-end pe-3">
                <%= link_to "View", workflow_instance_path(inst),
                      class: "btn btn-outline-secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="text-center text-muted py-5">
    <i class="ti ti-workflow" style="font-size:3rem; opacity:0.25;"></i>
    <p class="mt-3 mb-0">No workflow instances found.</p>
  </div>
<% end %>
<% end %>
