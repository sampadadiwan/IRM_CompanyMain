<%# Admin tiebreaker / manual advance form — no folder param needed (standalone route) %>
<%= form_with(url: advance_workflow_instance_path(instance), method: :post,
              class: "d-flex align-items-end gap-2 mt-2") do |form| %>

  <%= select_tag :state,
        options_for_select(step[:states].to_s.split(",").map(&:strip)),
        class: "form-control", style: "max-width:200px" %>

  <%= text_field_tag :note, nil, class: "form-control", style: "max-width:300px",
        placeholder: "Admin note (optional)" %>

  <%= submit_tag "Set State", class: "btn btn-warning btn-sm" %>
<% end %>
