<%# Precompute per-step resolved state from history (last non-reminder change per step) %>
<%
  resolved_per_step = @state_changes
    .reject { |sc| sc.channel == "auto_reminder" || sc.to_state == "reminder_sent" }
    .group_by(&:step_position)
    .transform_values(&:last)

  status_color = { "active" => "primary", "complete" => "success",
                   "rejected" => "danger",  "archived" => "secondary" }
                   .fetch(@instance.status, "secondary")
  status_icon  = { "active" => "ti-player-play", "complete" => "ti-circle-check",
                   "rejected" => "ti-circle-x",  "archived" => "ti-archive" }
                   .fetch(@instance.status, "ti-help-circle")
%>

<%# ── Breadcrumb ──────────────────────────────────────────────────────────── %>
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Folders", folders_path %></li>
    <li class="breadcrumb-item"><%= link_to @folder.name, folder_path(@folder) %></li>
    <li class="breadcrumb-item active">Workflow</li>
  </ol>
</nav>

<%# ── Header ───────────────────────────────────────────────────────────────── %>
<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <span class="text-muted small"><%= @instance.template_name %></span>
      <span class="text-muted small">·</span>
      <span class="text-muted small"><%= l(@instance.created_at.to_date, format: :abbr_month_day_year) %></span>
    </div>
    <h5 class="fw-bold mb-0"><%= @folder.name %></h5>
  </div>
  <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
    <span class="badge bg-<%= status_color %> d-flex align-items-center gap-1">
      <i class="ti <%= status_icon %>"></i><%= @instance.status.humanize %>
    </span>
    <% if policy(@instance).advance? && @instance.instance_active? %>
      <%= link_to send_reminder_folder_workflow_instance_path(@folder, @instance),
            method: :post, data: { confirm: "Send reminder to all pending actors?" },
            class: "btn btn-sm btn-outline-info d-flex align-items-center gap-1" do %>
        <i class="ti ti-bell"></i> Remind
      <% end %>
      <%= link_to reset_folder_workflow_instance_path(@folder, @instance),
            method: :post, data: { confirm: "Reset to step 1? Current responses will be archived." },
            class: "btn btn-sm btn-outline-warning d-flex align-items-center gap-1" do %>
        <i class="ti ti-rotate"></i> Reset
      <% end %>
      <%= link_to archive_folder_workflow_instance_path(@folder, @instance),
            method: :post, data: { confirm: "Archive this workflow?" },
            class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" do %>
        <i class="ti ti-archive"></i> Archive
      <% end %>
    <% end %>
  </div>
</div>

<%# ── Step pipeline ────────────────────────────────────────────────────────── %>
<div class="mb-4">
  <h6 class="fw-bold text-muted text-uppercase mb-3" style="font-size:0.72rem; letter-spacing:0.07em;">
    <i class="ti ti-list-check me-1"></i>Workflow Steps
  </h6>
  <div class="d-flex align-items-stretch gap-0">
    <% @instance.snapshot_steps.each_with_index do |step, idx| %>
      <% pos        = step[:position].to_i %>
      <% is_current = pos == @instance.current_step_position && @instance.instance_active? %>
      <% is_done    = pos < @instance.current_step_position || @instance.instance_complete? ||
                      (@instance.instance_rejected? && pos <= @instance.current_step_position) %>
      <% resolved   = resolved_per_step[pos] %>

      <%# connector line between steps %>
      <% if idx > 0 %>
        <div class="d-flex align-items-center px-1" style="color:#cbd5e1;">
          <i class="ti ti-chevron-right" style="font-size:1.1rem;"></i>
        </div>
      <% end %>

      <div class="card flex-fill border <%= is_current ? 'border-primary shadow-sm' : 'border-light' %>"
           style="min-width:0; <%= is_done && !is_current ? 'opacity:0.85;' : '' %>">
        <div class="card-body p-3">
          <%# Step number + name row %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <% if is_done %>
              <span class="rounded-circle bg-success d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:28px;height:28px;">
                <i class="ti ti-check text-white" style="font-size:0.85rem;"></i>
              </span>
            <% elsif is_current %>
              <span class="rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:28px;height:28px;">
                <span class="text-white fw-bold" style="font-size:0.75rem;"><%= pos %></span>
              </span>
            <% else %>
              <span class="rounded-circle bg-light border d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:28px;height:28px;">
                <span class="text-muted fw-bold" style="font-size:0.75rem;"><%= pos %></span>
              </span>
            <% end %>
            <span class="fw-semibold text-truncate" style="font-size:0.85rem;"><%= step[:name] %></span>
          </div>

          <%# Resolved state badge + all actor responses for completed steps %>
          <% if resolved %>
            <%
              rs = resolved.to_state.downcase
              rc = rs =~ /approv/ ? "success" : rs =~ /reject/ ? "danger" : rs =~ /tentative/ ? "warning" : "secondary"
              step_responses = (@all_responses_by_step[pos] || [])
            %>
            <div class="mb-2">
              <span class="badge bg-<%= rc %>-subtle text-<%= rc %> border border-<%= rc %>-subtle px-2">
                <%= resolved.to_state %>
              </span>
              <span class="text-muted ms-1" style="font-size:0.7rem;">
                <i class="ti ti-clock me-1"></i><%= l(resolved.created_at.to_date, format: :short) %>, <%= l(resolved.created_at, format: :time_only) %>
              </span>
            </div>
            <%# Show every actor's individual response %>
            <% if step_responses.any? %>
              <% step_responses.each do |r| %>
                <%
                  rs2 = r.state.downcase
                  rc2 = rs2 =~ /approv/ ? "success" : rs2 =~ /reject/ ? "danger" : rs2 =~ /tentative/ ? "warning" : "secondary"
                %>
                <div class="d-flex align-items-center gap-1 mb-1" style="font-size:0.72rem;">
                  <span class="rounded-circle bg-<%= rc2 %> bg-opacity-10 text-<%= rc2 %> d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:18px;height:18px;font-size:0.55rem;font-weight:700;">
                    <%= r.actor&.first_name.to_s.first.upcase %><%= r.actor&.last_name.to_s.first.upcase %>
                  </span>
                  <span class="text-muted text-truncate"><%= r.actor&.full_name %></span>
                  <span class="badge bg-<%= rc2 %>-subtle text-<%= rc2 %> border border-<%= rc2 %>-subtle ms-auto flex-shrink-0"
                        style="font-size:0.65rem; padding:1px 6px;">
                    <%= r.state %>
                  </span>
                </div>
              <% end %>
            <% elsif resolved.actor %>
              <div class="text-muted" style="font-size:0.72rem;">
                <i class="ti ti-user me-1"></i><%= resolved.actor.full_name %>
              </div>
            <% end %>
          <% elsif is_current %>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2" style="font-size:0.7rem;">
              <i class="ti ti-loader me-1"></i>In progress
            </span>
          <% else %>
            <span class="text-muted" style="font-size:0.75rem;">Pending</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# ── Current step actor responses (active instances only) ────────────────── %>
<% if @instance.instance_active? && @current_step %>
  <div class="card shadow-sm mb-4">
    <div class="card-header d-flex align-items-center justify-content-between py-2">
      <span class="fw-semibold">
        <i class="ti ti-users me-1 text-primary"></i>
        Step <%= @instance.current_step_position %>: <%= @current_step[:name] %> — Actor Responses
      </span>
      <span class="badge bg-light text-muted border" style="font-size:0.72rem;">
        Quorum: <%= @current_step[:quorum_rule].to_s.humanize %>
      </span>
    </div>
    <% if @current_step[:description].present? %>
      <div class="card-body pb-0 pt-2 border-start border-4 border-primary ps-3">
        <p class="text-muted small mb-2"><%= @current_step[:description] %></p>
      </div>
    <% end %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="font-size:0.78rem;">Actor</th>
            <th style="font-size:0.78rem;">Response</th>
            <th style="font-size:0.78rem;">When</th>
            <th style="font-size:0.78rem;">Note</th>
          </tr>
        </thead>
        <tbody>
          <% @actor_ids.each do |actor_id| %>
            <% actor = @actor_users[actor_id] %>
            <% resp  = @responses.find { |r| r.actor_id == actor_id } %>
            <tr>
              <td class="ps-3">
                <div class="d-flex align-items-center gap-2">
                  <span class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:28px;height:28px;font-size:0.65rem;font-weight:700;">
                    <%= actor&.first_name.to_s.first.upcase %><%= actor&.last_name.to_s.first.upcase %>
                  </span>
                  <span style="font-size:0.85rem;"><%= actor&.full_name %></span>
                </div>
              </td>
              <td>
                <% if resp %>
                  <%
                    s = resp.state.downcase
                    c = s =~ /approv/ ? "success" : s =~ /reject/ ? "danger" : s =~ /tentative/ ? "warning" : "info"
                  %>
                  <span class="badge bg-<%= c %>-subtle text-<%= c %> border border-<%= c %>-subtle px-2">
                    <%= resp.state %>
                  </span>
                <% else %>
                  <span class="badge bg-light text-muted border">
                    <i class="ti ti-clock me-1"></i>Pending
                  </span>
                <% end %>
              </td>
              <td class="text-muted" style="font-size:0.82rem;">
                <%= resp ? time_ago_in_words(resp.responded_at) + " ago" : "—" %>
              </td>
              <td class="text-muted fst-italic" style="font-size:0.82rem;">
                <%= resp&.note.presence || "" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# Tiebreaker panel %>
  <% if @resolution&.dig(:tiebreaker) && policy(@instance).advance? %>
    <div class="alert alert-warning d-flex gap-3 align-items-start mb-4">
      <i class="ti ti-alert-triangle fs-4 flex-shrink-0"></i>
      <div>
        <strong>Tiebreaker needed</strong>
        <p class="mb-2 small">Actors submitted conflicting responses. As an admin, set the final state to unblock the workflow.</p>
        <%= render "workflow_instances/advance_form",
              instance: @instance, folder: @folder, step: @current_step %>
      </div>
    </div>
  <% end %>

  <%# Actor in-app response form %>
  <% if @is_actor %>
    <% my_response = @responses.find { |r| r.actor_id == current_user.id } %>
    <%= render FormCard.new(title: "<i class='ti ti-pencil me-1'></i>Your Response") do %>
      <% if my_response %>
        <div class="d-flex align-items-center gap-2">
          <i class="ti ti-circle-check text-success fs-5"></i>
          <span>
            You responded
            <span class="badge bg-success-subtle text-success border border-success-subtle ms-1"><%= my_response.state %></span>
            <%= time_ago_in_words(my_response.responded_at) %> ago.
          </span>
        </div>
        <% if my_response.note.present? %>
          <blockquote class="blockquote-footer mt-2 small">"<%= my_response.note %>"</blockquote>
        <% end %>
      <% else %>
        <%= render "workflow_instances/response_form",
              instance: @instance, folder: @folder, step: @current_step %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%# ── Audit Trail ─────────────────────────────────────────────────────────── %>
<div class="card shadow-sm">
  <div class="card-header d-flex align-items-center justify-content-between py-2">
    <span class="fw-semibold">
      <i class="ti ti-history me-1 text-muted"></i>Audit Trail
    </span>
    <% if policy(@instance).export_audit_trail? %>
      <%= link_to export_audit_trail_folder_workflow_instance_path(@folder, @instance, format: :csv),
            class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" do %>
        <i class="ti ti-download"></i> Export CSV
      <% end %>
    <% end %>
  </div>

  <% if @history.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="font-size:0.78rem; white-space:nowrap;">When</th>
            <th style="font-size:0.78rem;">Step</th>
            <th style="font-size:0.78rem;">Actor</th>
            <th style="font-size:0.78rem;">State</th>
            <th style="font-size:0.78rem;">Channel</th>
            <th style="font-size:0.78rem;">Note</th>
          </tr>
        </thead>
        <tbody>
          <% @history.each do |e| %>
            <%
              s           = e[:state].to_s.downcase
              state_color = s =~ /approv/ ? "success" : s =~ /reject/ ? "danger" :
                            s =~ /tentative/ ? "warning" : "info"
              ch_icon = e[:channel].to_s == "email_magic_link" ? "ti-mail" :
                        e[:channel].to_s == "auto_reminder"    ? "ti-bell" : "ti-layout-dashboard"
            %>
            <tr class="<%= e[:archived] ? 'opacity-50' : '' %>">
              <td class="ps-3 text-muted" style="font-size:0.8rem; white-space:nowrap;">
                <%= l(e[:at].to_date, format: :short) %>, <%= l(e[:at], format: :time_only) %>
                <% if e[:archived] %>
                  <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size:0.62rem;">archived</span>
                <% end %>
              </td>
              <td>
                <span class="badge bg-light text-dark border" style="font-size:0.75rem;">
                  Step <%= e[:step] %>
                </span>
              </td>
              <td style="font-size:0.82rem;">
                <% if e[:actor] %>
                  <div class="d-flex align-items-center gap-1">
                    <span class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center flex-shrink-0"
                          style="width:22px;height:22px;font-size:0.58rem;font-weight:700;">
                      <%= e[:actor].first_name.to_s.first.upcase %><%= e[:actor].last_name.to_s.first.upcase %>
                    </span>
                    <%= e[:actor].full_name %>
                  </div>
                <% else %>
                  <span class="text-muted">System</span>
                <% end %>
              </td>
              <td>
                <span class="badge bg-<%= state_color %>-subtle text-<%= state_color %> border border-<%= state_color %>-subtle px-2"
                      style="font-size:0.75rem;">
                  <%= e[:state] %>
                </span>
              </td>
              <td>
                <span class="text-muted d-flex align-items-center gap-1" style="font-size:0.78rem;">
                  <i class="ti <%= ch_icon %>"></i>
                  <%= e[:channel].to_s.humanize %>
                </span>
              </td>
              <td class="text-muted fst-italic" style="font-size:0.8rem; max-width:180px;">
                <%= e[:note].presence || "" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="card-body text-center text-muted py-4">
      <i class="ti ti-history" style="font-size:2rem; opacity:0.3;"></i>
      <p class="mt-2 mb-0 small">No state changes recorded yet.</p>
    </div>
  <% end %>
</div>
