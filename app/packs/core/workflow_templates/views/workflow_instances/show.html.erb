<%
  status_color = { "active" => "primary", "complete" => "success",
                   "rejected" => "danger",  "archived" => "secondary" }
                   .fetch(@instance.status, "secondary")
  status_icon  = { "active" => "ti-player-play", "complete" => "ti-circle-check",
                   "rejected" => "ti-circle-x",  "archived" => "ti-archive" }
                   .fetch(@instance.status, "ti-help-circle")
%>

<%# ── Breadcrumb ──────────────────────────────────────────────────────────── %>
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item">
      <%# Link back to the workflowable object's own page (folder, kyc, etc.) %>
      <%= link_to @workflowable.workflow_display_name,
            @workflowable.workflow_url rescue root_path %>
    </li>
    <li class="breadcrumb-item active">Workflow</li>
  </ol>
</nav>

<%# ── Header card ──────────────────────────────────────────────────────────── %>
<div class="card shadow-sm mb-4">
  <div class="card-header d-flex align-items-center justify-content-between py-2">
    <div>
      <%# Template name + launched date in the header %>
      <%= link_to workflow_template_path(@instance.workflow_template),
          class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 me-2" do %>
        <i class="ti ti-route"></i><%= @instance.template_name %>
      <% end %>
      <span class="text-muted" style="font-size:0.82rem;">
        <i class="ti ti-calendar me-1"></i><%= l(@instance.created_at.to_date, format: :abbr_month_day_year) %>
      </span>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-<%= status_color %> d-flex align-items-center gap-1">
        <i class="ti <%= status_icon %>"></i><%= @instance.status.humanize %>
      </span>
      <%= user_guide_info_icon %>
    </div>
  </div>
  <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3 py-3">
    <%# Workflowable object name — linked to its own page %>
    <h5 class="fw-bold mb-0">
      <%= link_to @workflowable.workflow_display_name,
            (@workflowable.workflow_url rescue root_path),
            class: "text-decoration-none text-dark" %>
    </h5>
    <% if policy(@instance).advance? && @instance.instance_active? %>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <%= button_to send_reminder_workflow_instance_path(@instance), method: :post,
              form_class: "d-inline",
              data: { confirm: "Send reminder to all pending actors?", turbo: false },
              class: "btn btn-sm btn-outline-info d-flex align-items-center gap-1" do %>
          <i class="ti ti-bell"></i> Remind
        <% end %>
        <%= button_to reset_workflow_instance_path(@instance), method: :post,
              form_class: "d-inline",
              data: { confirm: "Reset to step 1? Current responses will be archived.", turbo: false },
              class: "btn btn-sm btn-outline-warning d-flex align-items-center gap-1" do %>
          <i class="ti ti-rotate"></i> Reset
        <% end %>
        <%= button_to archive_workflow_instance_path(@instance), method: :post,
              form_class: "d-inline",
              data: { confirm: "Archive this workflow?", turbo: false },
              class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" do %>
          <i class="ti ti-archive"></i> Archive
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# ── Step pipeline ────────────────────────────────────────────────────────── %>
<div class="card shadow-sm mb-4">
  <div class="card-header py-2">
    <span class="fw-semibold">
      <i class="ti ti-list-check me-1 text-muted"></i>Workflow Steps
    </span>
  </div>
  <div class="card-body">
    <%= render "workflow_templates/flow_diagram",
          steps: @step_presenters,
          workflow_template: nil,
          editable: false %>
  </div>
</div>

<%# ── Tiebreaker + response form (active instances only) ───────────────────── %>
<%# Actor / Response / When / Note for the current step are already shown per-actor  %>
<%#    in the flow diagram's response trail above — no separate table needed here.  %>
<% if @instance.instance_active? && @current_step %>
  <%# Tiebreaker panel %>
  <% if @resolution&.dig(:tiebreaker) && policy(@instance).advance? %>
    <div class="alert alert-warning d-flex gap-3 align-items-start mb-4">
      <i class="ti ti-alert-triangle fs-4 flex-shrink-0"></i>
      <div>
        <strong>Tiebreaker needed</strong>
        <p class="mb-2 small">Actors submitted conflicting responses. As an admin, set the final state to unblock the workflow.</p>
        <%= render "workflow_instances/advance_form",
              instance: @instance, step: @current_step %>
      </div>
    </div>
  <% end %>

  <%# Actor in-app response form %>
  <% if @is_actor %>
    <% my_response = @responses.find { |r| r.actor_id == current_user.id } %>
    <%= render FormCard.new(title: "<i class='ti ti-pencil me-1'></i>Your Response") do %>
      <% if my_response %>
        <div class="d-flex align-items-center gap-2">
          <i class="ti ti-circle-check text-success fs-5"></i>
          <span>
            You responded
            <span class="badge bg-success-subtle text-success border border-success-subtle ms-1"><%= my_response.state %></span>
            <%= time_ago_in_words(my_response.responded_at) %> ago.
          </span>
        </div>
        <% if my_response.note.present? %>
          <blockquote class="blockquote-footer mt-2 small">"<%= my_response.note %>"</blockquote>
        <% end %>
      <% else %>
        <%= render "workflow_instances/response_form",
              instance: @instance, step: @current_step %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%# ── Journey history (evaluated workflows only) ─────────────────────────────
    Steps passing, moving back, sign-offs reset and reminders — written by WorkflowEvaluator. %>
<% if @instance.evaluated %>
  <% journey_events = @state_changes.select { |c| c.to_state.in?(%w[passed skipped regressed invalidated reopened owner_reminded recomputed rejected_step]) } %>
  <div class="card shadow-sm mb-4" id="journey_history">
    <div class="card-header py-2">
      <i class="ti ti-route me-1 text-muted"></i>Journey History
    </div>
    <% if journey_events.any? %>
      <ul class="list-group list-group-flush">
        <% journey_steps = @instance.snapshot_steps.index_by { |st| st[:position].to_i } %>
        <% journey_events.reverse_each do |event| %>
          <li class="list-group-item small">
            <span class="text-muted"><%= l(event.created_at, format: :abbr_date_time) %></span>
            · <strong><%= journey_steps[event.step_position]&.dig(:name) || "Step #{event.step_position}" %></strong>
            · <%= event.to_state.humanize %>
            <% if event.actor %> · <%= event.actor.full_name %><% end %>
            <% if event.note.present? %> · <%= event.note %><% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="card-body text-muted small">Nothing has happened on this journey yet.</div>
    <% end %>
  </div>
<% end %>

<%# ── Audit Trail ─────────────────────────────────────────────────────────── %>
<div class="card shadow-sm">
  <div class="card-header d-flex align-items-center justify-content-between py-2">
    <span class="fw-semibold">
      <i class="ti ti-history me-1 text-muted"></i>Audit Trail
    </span>
    <% if policy(@instance).export_audit_trail? %>
      <%= link_to export_audit_trail_workflow_instance_path(@instance, format: :csv),
            class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" do %>
        <i class="ti ti-download"></i> Export CSV
      <% end %>
    <% end %>
  </div>

  <% if @history.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="font-size:0.78rem; white-space:nowrap;">When</th>
            <th style="font-size:0.78rem;">Step</th>
            <th style="font-size:0.78rem;">Actor</th>
            <th style="font-size:0.78rem;">State</th>
            <th style="font-size:0.78rem;">Channel</th>
            <th style="font-size:0.78rem;">Note</th>
          </tr>
        </thead>
        <tbody>
          <% @history.each do |e| %>
            <%
              s           = e[:state].to_s.downcase
              state_color = s =~ /approv/ ? "success" : s =~ /reject/ ? "danger" :
                            s =~ /tentative/ ? "warning" : "info"
              ch_icon = e[:channel].to_s == "email_magic_link" ? "ti-mail" :
                        e[:channel].to_s == "auto_reminder"    ? "ti-bell" : "ti-layout-dashboard"
            %>
            <tr class="<%= e[:archived] ? 'opacity-50' : '' %>">
              <td class="ps-3 text-muted" style="font-size:0.8rem; white-space:nowrap;">
                <%= l(e[:at].to_date, format: :short) %>, <%= l(e[:at], format: :time_only) %>
                <% if e[:archived] %>
                  <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size:0.62rem;">archived</span>
                <% end %>
              </td>
              <td>
                <span class="badge bg-light text-dark border" style="font-size:0.75rem;">
                  Step <%= e[:step] %>
                </span>
              </td>
              <td style="font-size:0.82rem;">
                <% if e[:actor] %>
                  <div class="d-flex align-items-center gap-1">
                    <span class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center flex-shrink-0"
                          style="width:22px;height:22px;font-size:0.58rem;font-weight:700;">
                      <%= e[:actor].first_name.to_s.first.upcase %><%= e[:actor].last_name.to_s.first.upcase %>
                    </span>
                    <%= e[:actor].full_name %>
                  </div>
                <% else %>
                  <span class="text-muted">System</span>
                <% end %>
              </td>
              <td>
                <span class="badge bg-<%= state_color %>-subtle text-<%= state_color %> border border-<%= state_color %>-subtle px-2"
                      style="font-size:0.75rem;">
                  <%= e[:state] %>
                </span>
              </td>
              <td>
                <span class="text-muted d-flex align-items-center gap-1" style="font-size:0.78rem;">
                  <i class="ti <%= ch_icon %>"></i>
                  <%= e[:channel].to_s.humanize %>
                </span>
              </td>
              <td class="text-muted fst-italic" style="font-size:0.8rem; max-width:180px;">
                <%= e[:note].presence || "" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="card-body text-center text-muted py-4">
      <i class="ti ti-history" style="font-size:2rem; opacity:0.3;"></i>
      <p class="mt-2 mb-0 small">No state changes recorded yet.</p>
    </div>
  <% end %>
</div>
