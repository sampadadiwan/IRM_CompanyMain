<%# Form for creating or editing a WorkflowAutoAssignmentRule %>
<%= render FormCard.new(title: rule.persisted? ? "Edit Auto-Assignment Rule" : "New Auto-Assignment Rule") do %>
  <%= form_with(model: [workflow_template, rule]) do |f| %>
    <% if rule.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% rule.errors.each do |e| %>
            <li><%= e.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# The workflowable_type is inherited from the template; show it read-only %>
    <div class="form-group">
      <label class="form-label">Applies to</label>
      <input class="form-control" type="text"
             value="<%= rule.workflowable_type.presence || 'Any (inherited from template)' %>"
             readonly disabled>
      <%= f.hidden_field :workflowable_type %>
    </div>

    <div class="form-group">
      <%= f.label :priority, "Priority (lower number runs first)" %>
      <%= f.number_field :priority, class: "form-control", min: 0,
            placeholder: "0 = highest priority" %>
      <small class="text-muted">
        When multiple rules match, the one with the lowest priority number wins.
      </small>
    </div>

    <div class="form-group form-check">
      <%= f.check_box :auto_launch, class: "form-check-input" %>
      <%= f.label :auto_launch, "Automatically launch a workflow instance after assigning the template" %>
    </div>

    <%# Conditions — a row builder over WorkflowRuleFields (fields, operators and values this record
        type and company allow). The textarea is what is submitted: the builder writes the rows into it,
        "View as JSON" shows it, and without JS it is simply visible.
        Design: openspec/changes/workflow-rule-condition-builder/design.md#-rule-form %>
    <% fields = rule_fields %>
    <%# A refused submission is shown back as submitted: unparseable text as-is, any other shape as JSON %>
    <% conditions_text = case rule.conditions
                         when String then rule.conditions
                         when Array, nil then JSON.pretty_generate(Array(rule.conditions))
                         else JSON.pretty_generate(rule.conditions)
                         end %>
    <div class="form-group" id="rule_conditions"
         <% if fields %>
           data-controller="workflow-rule-conditions"
           data-workflow-rule-conditions-fields-value="<%= fields.to_builder_json.to_json %>"
         <% end %>>
      <label class="form-label">
        Conditions — a new <%= fields&.type_label || "record" %> gets this template when ALL of these match
      </label>

      <% if fields %>
        <div data-workflow-rule-conditions-target="rowsPanel" class="d-none">
          <div data-workflow-rule-conditions-target="rows"></div>
          <button type="button" class="btn btn-sm btn-outline-primary" id="add_rule_condition"
                  data-action="click->workflow-rule-conditions#add">
            <i class="ti ti-plus"></i> Add condition
          </button>
        </div>
        <%# One locale date input, cloned by the builder for date conditions (never submitted itself) %>
        <template data-workflow-rule-conditions-target="dateTemplate">
          <%= date_field_tag "rule_condition_date", nil, class: "form-control" %>
        </template>
      <% end %>

      <div data-workflow-rule-conditions-target="jsonPanel">
        <div class="alert alert-danger py-1 px-2 d-none" data-workflow-rule-conditions-target="jsonError">
          <%= WorkflowRuleFields::INVALID_SHAPE %>
        </div>
        <%= f.text_area :conditions_json, value: conditions_text,
              class: "form-control font-monospace", rows: 6,
              data: { "workflow-rule-conditions-target": "json" },
              placeholder: '[{"attribute":"kyc_type","operator":"eq","value":"individual"}]' %>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-2">
        <small class="text-muted">
          No conditions = applies to every new <%= fields&.type_label || "record" %> (catch-all).
        </small>
        <% if fields %>
          <a href="#" id="toggle_rule_conditions_json" data-workflow-rule-conditions-target="toggle"
             data-action="click->workflow-rule-conditions#toggle">View as JSON</a>
        <% end %>
      </div>
    </div>

    <div class="form-group mt-3">
      <%= f.submit t_common(:save), class: "btn btn-outline-primary" %>
      <%= link_to "Cancel", workflow_template_path(workflow_template), class: "btn btn-outline-secondary ms-2" %>
    </div>
  <% end %>
<% end %>
