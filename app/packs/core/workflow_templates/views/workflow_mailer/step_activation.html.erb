<h3>Hello <%= @user.full_name %>,</h3>

<p>
  Your input is required for the
  <strong><%= @instance.template_name %></strong> workflow on
  <% if @workflowable_url %>
    <strong><%= link_to @workflowable_name, @workflowable_url %></strong>.
  <% else %>
    <strong><%= @workflowable_name %></strong>.
  <% end %>
</p>

<p>
  <strong>Step:</strong> <%= @step[:name] %>
  <% if @step[:description].present? %>
    &mdash; <%= @step[:description] %>
  <% end %>
</p>

<p>
  Please click the button below to record your response.
  The link is personalised and does not require you to log in.
</p>

<p>
  <%= link_to "Review & Respond", @magic_link,
        style: "display:inline-block;padding:10px 20px;background:#0d6efd;color:#fff;text-decoration:none;border-radius:4px" %>
</p>

<% if @attachments_skipped %>
  <p style="color:#888;font-size:0.85em;">
    <em>Note: one or more files associated with this item exceed the email attachment size limit.
    <% if @workflowable_url %>
      <%= link_to "Open the item directly", @workflowable_url %> to review them.
    <% else %>
      Please log in to review them.
    <% end %>
    </em>
  </p>
<% end %>

<p style="color:#888;font-size:0.85em;">
  You can also view the full workflow timeline here:
  <%= link_to "View workflow", @instance_url %>
</p>

<p style="color:#888;font-size:0.85em;">
  This link is unique to you. Please do not share it.
  If the step has already progressed when you open the link, no action is needed.
</p>
