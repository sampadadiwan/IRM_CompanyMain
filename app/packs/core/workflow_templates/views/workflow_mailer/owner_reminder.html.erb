<h3>Hello <%= @user.full_name %>,</h3>

<p>
  A step you own on
  <% if @workflowable_url %>
    <strong><%= link_to @workflowable_name, @workflowable_url %></strong>
  <% else %>
    <strong><%= @workflowable_name %></strong>
  <% end %>
  is waiting.
</p>

<p>
  <strong>Step:</strong> <%= @step[:name] %><br>
  <% if @message.present? %>
    <strong>Status:</strong> <%= @message %><br>
  <% end %>
  <% if @instance.current_step_since %>
    <strong>Waiting since:</strong> <%= l(@instance.current_step_since.to_date) %>
  <% end %>
</p>

<% if @workflowable_url %>
  <p>
    <%= link_to "Open #{@workflowable_name}", @workflowable_url,
          style: "display:inline-block;padding:10px 20px;background:#0d6efd;color:#fff;text-decoration:none;border-radius:4px" %>
  </p>
<% end %>

<p style="color:#888;font-size:0.85em;">
  You are receiving this because you own this step in the <%= @instance.template_name %> journey.
  <%= link_to "View the journey history", @instance_url %>
</p>
