<%# Inline step row used inside the nested template form %>
<div class="step-row border rounded p-3 mb-3" data-controller="workflow-step">
  <%= step_form.hidden_field :_destroy, class: "step-destroy-flag" %>
  <%= step_form.hidden_field :position, class: "step-position" %>

  <div class="d-flex justify-content-between align-items-center mb-2">
    <span class="drag-handle text-muted me-2" style="cursor:grab;" title="Drag to reorder">
      <i class="ti ti-grip-vertical"></i>
    </span>
    <strong class="flex-grow-1">Step</strong>
    <%= link_to "#", class: "btn btn-sm btn-outline-danger",
          data: { action: "nested-form#remove" } do %>
      <i class="ti ti-trash"></i>
    <% end %>
  </div>

  <div class="row">
    <div class="col-md-6 form-group">
      <%= step_form.label :name, "Step name" %>
      <%= step_form.text_field :name, class: "form-control", placeholder: "e.g. Legal Review" %>
    </div>

    <div class="col-md-6 form-group">
      <%= step_form.label :states, "Allowable states (comma-separated)" %>
      <%= step_form.text_field :states, class: "form-control",
            placeholder: "Approved,Rejected,Needs Info" %>
      <small class="text-muted">First value is the displayed default.</small>
    </div>
  </div>

  <div class="form-group">
    <%= step_form.label :description %>
    <%= step_form.text_area :description, class: "form-control", rows: 1,
          placeholder: "Optional context shown to actors" %>
  </div>

  <div class="row">
    <div class="col-md-4 form-group">
      <%= step_form.label :quorum_rule, "Quorum" %>
      <%= step_form.select :quorum_rule, WorkflowStep.quorum_rules.keys.map { |k|
            [k.humanize, k] }, {}, class: "form-control" %>
    </div>

    <div class="col-md-4 form-group">
      <%= step_form.label :on_reject_rule, "On reject" %>
      <%= step_form.select :on_reject_rule, WorkflowStep.on_reject_rules.keys.map { |k|
            [k.humanize, k] }, {}, class: "form-control",
            data: { action: "change->workflow-step#toggleGoToStep" } %>
    </div>

    <div class="col-md-4 form-group" data-workflow-step-target="goToStepField">
      <%= step_form.label :on_reject_target_step, "Go to step #" %>
      <%= step_form.number_field :on_reject_target_step, class: "form-control", min: 1 %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 form-group">
      <%= step_form.label :reminder_interval_days, "Reminder interval override (days)" %>
      <%= step_form.number_field :reminder_interval_days, class: "form-control", min: 0,
            placeholder: "Leave blank to inherit template default" %>
      <small class="text-muted">Set 0 to disable reminders on this step.</small>
    </div>
  </div>

  <div class="form-group form-check">
    <%= step_form.check_box :notify_on_activation, class: "form-check-input" %>
    <%= step_form.label :notify_on_activation, "Email actors when this step becomes active",
          class: "form-check-label" %>
    <small class="text-muted d-block">
      Turn this off for steps that fire in bulk (e.g. an auto-assignment rule on import) so
      actors aren't slammed with emails. Reminders and other steps are unaffected.
    </small>
  </div>

  <div class="form-group">
    <%= step_form.label :actor_user_ids, "Actors (entity employees)" %>
    <%= step_form.select :actor_user_ids,
          entity_users.map { |u| [u.full_name, u.id] },
          { include_blank: false },
          { multiple: true, class: "form-control select2",
            data: { placeholder: "Select actors..." } } %>
    <small class="text-muted">Only employees of this organisation can be actors.</small>
  </div>
</div>
