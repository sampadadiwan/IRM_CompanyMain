<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Doc Questions</h1>
  <span>
    <%= link_to "New Question", new_doc_question_path("doc_question[entity_id]": current_user.entity_id), {class: "btn btn-outline-primary"}  %>
    <%# import_upload_id is threaded through so the Download beside an import upload's
        table exports that upload's rows, not the entity's whole question set %>
    <%= link_to "Download", doc_questions_path(format: :xlsx, import_upload_id: params[:import_upload_id]), {class: "btn btn-outline-success"}  %>
    <% if policy(DocQuestion.new(entity_id: current_user.entity_id)).import? %>
      <%= link_to "Upload", new_import_upload_path(
                            "import_upload[import_type]": "DocQuestion",
                            "sample_upload": "DOC_QUESTION_SAMPLE"),
                          class: "btn btn-outline-success ti ti-upload",
                          data: { turbo: false }  %>
    <% end %>
  </span>
</div>
<div class="table-responsive" data-controller="datatable">
  <table id="doc_questions" class="table table-bordered dataTable jqDataTable">
    <thead>
      <tr>
        <th class="text-col">
          Tags
        </th>
        <th class="text-col">
          Question
        </th>
        <th class="text-col">
          For
        </th>
        <th class="text-col">
          Document Name
        </th>
        <th class="text-col">
          Type
        </th>
        <th class="action-col">
        </th>
      </tr>
    </thead>
    <tbody>
      <% @doc_questions.each do |doc_question| %>
        <%= render doc_question %>
      <% end %>
    </tbody>
  </table>
</div>
