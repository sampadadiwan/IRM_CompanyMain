<%# Zoho eSign panel on the company page (design card ⑦). Locals: entity, connection (or nil),
    form (a connection carrying field errors, or nil), result (last action's outcome, or nil) and
    secret (the webhook secret, only on the response that reveals or regenerates it). %>
<% form ||= nil
   result ||= nil
   secret ||= nil
   regions = ZohoSignClient::REGIONS.map { |key, region| ["#{region.name} (#{region.sign_host})", key] } %>
<div class="card shadow mb-4" id="zoho_sign_connection_panel">
  <div class="card-header py-3 d-flex justify-content-between align-items-center">
    <h6 class="m-0 font-weight-bold text-primary">Zoho eSign</h6>
    <% if connection.nil? %>
      <span class="badge bg-secondary">Using CapHive's</span>
    <% elsif connection.needs_reauth? %>
      <span class="badge bg-danger">Needs reconnect</span>
    <% else %>
      <span class="badge bg-success">Connected</span>
    <% end %>
  </div>
  <div class="card-body">
    <% if result&.message.present? %>
      <div class="alert <%= result.success? ? 'alert-success' : 'alert-danger' %>" role="alert"><%= result.message %></div>
    <% end %>

    <% if connection.nil? %>
      <p>Documents are sent through CapHive's Zoho account. Connect your company's own Zoho Sign account to send through it instead.</p>
    <% else %>
      <table class="table table-bordered">
        <tr>
          <td>Account</td>
          <td><%= entity.name %>'s own Zoho account</td>
        </tr>
        <tr>
          <td>Region</td>
          <td><%= connection.region_name %> (<%= ZohoSignClient::REGIONS[connection.region]&.sign_host %>)</td>
        </tr>
        <tr>
          <td>Connected on</td>
          <td><%= l(connection.connected_at) %> <small class="text-muted">(documents sent from this moment use this account)</small></td>
        </tr>
        <% if connection.last_verified_at %>
          <tr>
            <td>Last verified</td>
            <td><%= l(connection.last_verified_at) %></td>
          </tr>
        <% end %>
        <tr>
          <td>Last update</td>
          <td><%= connection.last_webhook_at ? l(connection.last_webhook_at) : "No update received from Zoho yet" %></td>
        </tr>
        <% if connection.needs_reauth? %>
          <tr>
            <td>Problem</td>
            <td class="text-danger">Zoho rejected the stored credentials<%= " (#{connection.last_error})" if connection.last_error.present? %>. Reconnect with a new grant code.</td>
          </tr>
        <% end %>
        <tr>
          <td>Webhook address</td>
          <td><code id="zoho_sign_webhook_address"><%= zoho_sign_webhook_url(connection.webhook_token) %></code></td>
        </tr>
        <tr>
          <td>Webhook secret</td>
          <td>
            <% if secret %>
              <code id="zoho_sign_webhook_secret"><%= secret %></code>
              <div><small class="text-muted">Copy it into your Zoho webhook now - it will not be shown again.</small></div>
            <% else %>
              <span>********************</span>
              <% if connection.webhook_secret_revealed_at.nil? %>
                <%= button_to "Show webhook secret", reveal_webhook_secret_entity_zoho_sign_connection_path(entity), class: "btn btn-sm btn-outline-secondary ms-2", form_class: "d-inline" %>
              <% end %>
            <% end %>
            <%= button_to "Regenerate webhook secret", regenerate_webhook_secret_entity_zoho_sign_connection_path(entity), class: "btn btn-sm btn-outline-warning ms-2", form_class: "d-inline",
                          form: { data: { turbo_confirm: "Updates signed with the current secret will be refused until you paste the new one into your Zoho webhook. Continue?" } } %>
          </td>
        </tr>
      </table>

      <div class="d-flex gap-2 mb-3">
        <%= button_to "Verify connection", verify_entity_zoho_sign_connection_path(entity), class: "btn btn-outline-primary" %>
        <%= button_to "Disconnect", entity_zoho_sign_connection_path(entity), method: :delete, class: "btn btn-outline-danger",
                      form: { data: { turbo_confirm: "Disconnect #{entity.name}'s Zoho account? Documents sent from now on will use CapHive's account." } } %>
      </div>

      <details <%= "open" if form %>>
        <summary class="btn btn-outline-primary">Reconnect</summary>
        <div class="mt-3">
    <% end %>

    <%# Connect when there is no connection, Reconnect (blank fields keep the stored values) when there is %>
    <% record = form || connection || ZohoSignConnection.new(entity:) %>
    <%= form_with model: record, scope: :zoho_sign_connection, url: entity_zoho_sign_connection_path(entity), method: connection ? :patch : :post,
                  id: "zoho_sign_connection_form" do |f| %>
      <% if record.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% record.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="row">
        <div class="form-group col-md-6">
          <%= f.label :region, "Region" %>
          <%= f.select :region, regions, { include_blank: "Pick the region of your Zoho account" }, class: "form-select" %>
          <small class="text-muted">The address of your Zoho account decides it (sign.zoho.com = United States).</small>
        </div>
        <div class="form-group col-md-6">
          <%= f.label :client_id, "Client ID" %>
          <%= f.text_field :client_id, class: "form-control", autocomplete: "off" %>
        </div>
        <div class="form-group col-md-6">
          <%= f.label :client_secret, "Client Secret" %>
          <%= f.password_field :client_secret, value: nil, class: "form-control", autocomplete: "new-password" %>
          <% if connection %><small class="text-muted">Leave blank to keep the stored secret.</small><% end %>
        </div>
        <div class="form-group col-md-6">
          <%= f.label :grant_code, "Grant code" %>
          <%= f.password_field :grant_code, value: nil, class: "form-control", autocomplete: "off" %>
          <small class="text-muted">From your Zoho Self Client › Generate Code. Single use, valid about 10 minutes.</small>
        </div>
      </div>
      <%= f.submit connection ? "Reconnect" : "Connect", class: "btn btn-outline-primary mt-2" %>
    <% end %>

    <% if connection %>
        </div>
      </details>
    <% end %>
  </div>
</div>
