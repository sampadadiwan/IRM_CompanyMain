<%  no_folders ||= false
    # The folder page (folders/_folder_details): its header already names the folder, so no card
    # header (Index / All Documents) and no path heading here
    folder_page ||= false
    widget_id ||= nil
    tree_view_id = widget_id.present? ? "tree_view_#{widget_id}" : "tree_view"
    documents_frame_id = widget_id.present? ? "documents_frame_#{widget_id}" : "documents_frame"
    show_action_buttons = params[:show_action_buttons].to_s != "false" # default to true
    # show_action_buttons = false if current_user.curr_role_investor?
    folder_url_method ||= :folder_documents_path
    use_entity_name_for_root ||= false
    virtual_root ||= nil
    # Fund/deal pages ask for the search box via ?doc_search; the Documents page passes it as a local
    doc_search ||= params[:doc_search].present?
    # Documents page: search the same list the page shows (DocumentsController#index), so clearing
    # the box brings that list back. Fund/deal pages: search their folder tree (#folder).
    search_all_docs = action_name == "index"
%>

<%# No "Step 1/2/3" strip here any more: it repeated the Actions menu and pushed the folders and
    documents down the page. Guidance now sits next to what it explains (tooltips + empty state). %>
<%# With folders shown, the tree and the list are resizable: drag the divider between them (split_pane_controller,
    custom/split_pane.scss). The width is remembered per browser; below lg the panes stack as before. %>
<% if no_folders %>
<div class="row">
<% else %>
<div class="row split-pane" data-controller="split-pane" data-split-pane-storage-key-value="documents-tree-width"
     data-action="resize@window->split-pane#refit">
<% end %>
    <!-- Show hide the folder view based on action -->
    <% doc_index_class = (no_folders) ? "col-lg-12 mb-4" : "col-lg-8 mb-4 split-pane-right" %>

    <% unless no_folders %>
    <div class="col-lg-4 mb-4 split-pane-left" data-split-pane-target="left">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <%# Where access rights live, since the old "Setup Access Rights" step no longer says it %>
                <span class="m-0 font-weight-bold text-primary"><i class="ti ti-folder"></i> Folders</span>
                <i class="ti ti-info-circle text-muted ms-1" id="folders_help" tabindex="0"
                   aria-label="About folders"
                   data-bs-title="Click a folder to list its documents. To control who can see a folder, click its name in the folder path above the list and open the Access Rights tab."></i>
            </div>
            <div class="card-body">
                <%# selected_folder_id highlights + expands a folder in the tree without scoping the tree to it %>
                <div id="<%= tree_view_id %>" class="tree_view" data-controller="treeview" data-treeview-documents-frame-id-value="<%= documents_frame_id %>" data-treeview-selected-folder-id-value="<%= (params[:selected_folder_id] || params[:folder_id]).to_s %>">
                    <% if params[:page].blank? %>
                        <% folders = get_tree_view_folders(params, current_user, @entity, @documents) %>
                        <%= render "folders/tree_view", folders: folders, widget_id: widget_id, documents_as_tags: params[:documents_as_tags], show_action_buttons: show_action_buttons, folder_url_method: folder_url_method, use_entity_name_for_root: use_entity_name_for_root, virtual_root: virtual_root %>
                    <% end %>
                </div>
            </div>
        </div>
    </div>

    <%# Divider between the panes: drag, ←/→ when focused, double-click to reset. Hidden below lg. %>
    <div class="split-pane-divider d-none d-lg-block" data-split-pane-target="divider"
         role="separator" aria-orientation="vertical" aria-label="Resize the folders and documents panes" tabindex="0"
         data-bs-title="Drag to resize the folders pane. Double-click to reset."
         data-action="pointerdown->split-pane#startDrag keydown->split-pane#nudge dblclick->split-pane#reset"></div>
    <% end %>

    <div class="<%= doc_index_class %>">
        <div class="card shadow mb-4">
            <% if show_action_buttons && !folder_page %>
                <div class="card-header">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                        <span class="m-0 font-weight-bold text-primary"><i class="ti ti-files"></i> Documents</span>
                        <div class="d-flex flex-column flex-sm-row gap-2 mt-2 mt-sm-0">
                            <%= link_to documents_path(entity_id: params[:entity_id], all: true, format: :xlsx), class: "btn btn-outline-primary",
                                        data: { bs_title: "Download an Excel list of all documents" } do %>
                                <i class="ti ti-database-export"></i>Index
                            <% end %>

                            <%# This tree view can be rendered inside a nested turbo-frame (e.g. the deal
                                investor's Documents tab in the list view offcanvas sidepanel), where
                                without an explicit target this link would try to swap content into that
                                small nested frame instead of navigating the full page. %>
                            <%= link_to documents_path(entity_id: params[:entity_id]),
                                        class: "btn btn-outline-primary",
                                        data: { turbo_frame: "_top", bs_title: "Clear the folder selection and list documents from every folder" } do %>
                                <i class="ti ti-files"></i>All Documents
                            <% end %>
                        </div>
                    </div>
                </div>
            <% end %>

            <%# add some space if buttons are not shown to keep view proper %>
            <div class="card-body">
                <% if doc_search %>
                    <%# Search the whole tree (folder_id is its root) as the user types; results replace the panel below.
                        Outside the frame so the box survives each reload of the results. %>
                    <%= form_with url: (search_all_docs ? documents_path : folder_documents_path), method: :get, id: "documents_search",
                                  class: "mb-3", data: { turbo_frame: documents_frame_id, controller: "documents-search" } do |f| %>
                        <%= hidden_field_tag :folder_id, params[:folder_id] %>
                        <%= hidden_field_tag :entity_id, params[:entity_id] %>
                        <%= hidden_field_tag :no_folders, true %>
                        <%= hidden_field_tag :show_action_buttons, params[:show_action_buttons] if params[:show_action_buttons].present? %>
                        <%= hidden_field_tag :widget_id, widget_id if widget_id.present? %>
                        <%# LP: clearing the box goes back to the latest documents %>
                        <%= hidden_field_tag :latest_first, true if params[:latest_first].present? %>
                        <div class="input-group">
                            <span class="input-group-text"><i class="ti ti-search"></i></span>
                            <%# Plain text input, not type=search: Chrome would add its own second clear (x) next to ours %>
                            <%= text_field_tag :search, nil, class: "form-control", placeholder: "Search documents by name or tag",
                                                 autocomplete: "off", "aria-label": "Search documents",
                                                 data: { documents_search_target: "input", action: "input->documents-search#queue" } %>
                            <button type="button" class="btn btn-outline-secondary" aria-label="Clear search"
                                    data-action="documents-search#clear"><i class="ti ti-x"></i></button>
                        </div>
                        <div class="form-text">
                            Searches document names and tags across <%= search_all_docs ? "all your folders" : "all of this fund's folders" %>. Words can be in any order.
                        </div>
                    <% end %>
                <% end %>
                <%= turbo_frame_tag documents_frame_id, target: "_top" do %>
                    <%
                        # LP latest list already spans the whole tree; otherwise show the selected folder's own docs
                        # When selected_folder_id is used, the controller already scoped to the subtree — skip view-level filtering
                        documents = documents.where(folder_id: params[:folder_id]) if params[:folder_id].present? && params[:selected_folder_id].blank? && params[:latest_first].blank?
                        @pagy, documents = pagy(documents) if params[:all].blank?
                    %>

                    <%= render "documents/index", documents: documents, entity: entity, owner: @owner, folder_page: %>
                    <%= raw pagy_bootstrap_nav(@pagy, anchor_string: %(data-turbo-frame="#{documents_frame_id}" data-remote="true")) if @pagy %>
                <% end %>
            </div>
        </div>
    </div>
</div>
