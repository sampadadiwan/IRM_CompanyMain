<%  no_folders ||= false; show_steps = true if show_steps.nil?
    widget_id ||= nil
    tree_view_id = widget_id.present? ? "tree_view_#{widget_id}" : "tree_view"
    documents_frame_id = widget_id.present? ? "documents_frame_#{widget_id}" : "documents_frame"
    show_action_buttons = params[:show_action_buttons].to_s != "false" # default to true
    folder_url_method ||= :folder_documents_path
    use_entity_name_for_root ||= false
    virtual_root ||= nil
%>

<%= render "/layouts/steps", steps: ["Create Folders", "Upload Docs", "Setup Access Rights"].freeze if show_steps %>

<div class="row">
    <!-- Show hide the folder view based on action -->
    <% doc_index_class = (no_folders) ? "col-lg-12 mb-4" : "col-lg-8 mb-4" %>

    <% unless no_folders %>
    <div class="col-lg-4 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <span class="m-0 font-weight-bold text-primary">Folders</span>
            </div>
            <div class="card-body">
                <div id="<%= tree_view_id %>" class="tree_view" data-controller="treeview" data-treeview-documents-frame-id-value="<%= documents_frame_id %>" data-treeview-selected-folder-id-value="<%= params[:folder_id].to_s if params[:folder_id].present? %>">
                    <% if params[:page].blank? %>
                        <% folders = get_tree_view_folders(params, current_user, @entity, @documents) %>
                        <%= render "folders/tree_view", folders: folders, widget_id: widget_id, documents_as_tags: params[:documents_as_tags], show_action_buttons: show_action_buttons, folder_url_method: folder_url_method, use_entity_name_for_root: use_entity_name_for_root, virtual_root: virtual_root %>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
    <% end %>

    <div class="<%= doc_index_class %>">
        <div class="card shadow mb-4">
            <% if show_action_buttons %>
                <div class="card-header">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                        <span class="m-0 font-weight-bold text-primary">Documents</span>
                        <div class="d-flex flex-column flex-sm-row gap-2 mt-2 mt-sm-0">
                            <%= link_to documents_path(entity_id: params[:entity_id], all: true, format: :xlsx), class: "btn btn-outline-primary" do %>
                            <i class="ti ti-database-export"></i>Index
                            <% end %>

                            <%= link_to documents_path(entity_id: params[:entity_id]), class: "btn btn-outline-primary" do %>
                                <i class="ti ti-files"></i>All Documents
                            <% end %>

                        </div>
                    </div>
                </div>
            <% end %>

            <%# add some space if buttons are not shown to keep view proper %>
            <div class="card-body">
                <%= turbo_frame_tag documents_frame_id, target: "_top" do %>
                    <%
                        documents = documents.where(folder_id: params[:folder_id]) if params[:folder_id].present?
                        @pagy, documents = pagy(documents) if params[:all].blank?
                    %>

                    <%= render "documents/index", documents: documents, entity: entity, owner: @owner %>
                    <%= raw pagy_bootstrap_nav(@pagy, anchor_string: %(data-turbo-frame="#{documents_frame_id}" data-remote="true")) if @pagy %>
                <% end %>
            </div>
        </div>
    </div>
</div>
