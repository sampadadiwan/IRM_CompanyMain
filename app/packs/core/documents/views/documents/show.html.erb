<%
   own_document = @document.entity_id == current_user&.entity_id
   # Download link: the file as stored, when there is no in-page viewer or originals are allowed
   show_download = @document.orignal || ENV['PDF_TRON'] == 'false'
%>
<div class="container-fluid mb-0">

   <%= render "documents/embedded_sign_banner", document: @document %>

   <%# Header: what this document is, its state, and everything you can do with it - above the viewer,
       so the actions are not at the bottom of a long PDF %>
   <div class="card shadow-sm border-0 mb-3" id="document_header">
      <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
         <div>
            <h5 class="mb-1 fw-bold"><%= document_file_icon(@document) %> <%= @document.name %></h5>
            <%= document_status_badges(@document) %>
            <% if @document.template %>
               <span class="badge bg-info-subtle text-info" data-bs-title="Used to generate documents (e.g. notices) from your data">
                  <i class="ti ti-template"></i> Template
               </span>
            <% end %>
         </div>

         <div class="d-flex flex-wrap align-items-center gap-2" id="document_actions">
            <% if current_user %>
               <% if policy(@document).update? %>
                  <%= link_to edit_document_path(@document), class: "btn btn-outline-primary" do %>
                     <i class="ti ti-edit"></i> <%= t_common(:edit) %>
                  <% end %>
               <% end %>

               <%= button_to "Approve", document_path(@document, "document[approved]": true, "document[approved_by_id]": current_user.id, redirect_to: document_path(@document)),
                     {class: "btn btn-outline-success ti ti-check", method: :patch,
                      data: document_approval_confirm_data(@document, approve: true)} if policy(@document).approve? %>

               <%= button_to "UnApprove", document_path(@document, "document[approved]": false, "document[approved_by_id]": current_user.id, redirect_to: document_path(@document)),
                     {class: "btn btn-outline-success ti ti-x", method: :patch,
                      data: document_approval_confirm_data(@document, approve: false)} if policy(@document).unapprove? %>

               <% unless current_user.curr_role == "investor" %>
                  <div class="dropdown">
                     <button class="btn btn-outline-primary dropdown-toggle" type="button" id="sendDocumentDropdown" data-bs-toggle="dropdown" aria-expanded="false"
                             data-bs-title="Email this document to the people who can see it, using one of your Send Document notifications">
                        <i class="ti ti-send"></i> Send Document
                     </button>
                     <div class="dropdown-menu" aria-labelledby="sendDocumentDropdown">
                        <% query_params = ransack_query_params_multiple([
                                                                        ['for_type', :eq, "Send Document"]
                                                                     ])
                        %>
                        <% send_notifications = current_user.entity.custom_notifications.enabled.where(for_type: "Send Document") %>
                        <% send_notifications.each do |cust_not| %>
                           <%
                           msg = "This will send an email to the recipients who have access to this document using custom notification
                           <br><strong>#{link_to cust_not.subject, custom_notification_path(cust_not), target: '_blank'}</strong><br>Proceed?<br>
                           #{link_to 'View Who Gets Notified', show_email_list_document_path(@document), class: 'mb-1 badge bg-primary-subtle text-primary', target: '_blank'}
                           #{link_to 'View Custom Notifications', custom_notifications_path(entity_id: @document.entity_id, filter: true, q: query_params), class: 'mb-1 badge bg-primary-subtle text-primary', target: '_blank'}
                           #{attachment_size_caution(send_document_attachments(@document, cust_not))}"
                           %>
                           <%= button_to "Send #{cust_not.subject}",
                           send_document_notification_document_path(@document, custom_notification_id: cust_not.id),
                           method: :patch,
                           form_class: "deleteButton d-inline",
                           data: {
                              action: "click->confirm#popup",
                              msg: msg,
                              method: :patch,
                              turbo: false
                           },
                           class: "dropdown-item flex-grow-1 text-start"
                           %>
                        <% end %>
                        <%# Say why the menu is empty instead of opening an empty box %>
                        <% if send_notifications.none? %>
                           <span class="dropdown-item-text text-muted small">
                              No Send Document notification is set up yet. Add one under
                              <%= link_to "Custom Notifications", custom_notifications_path(entity_id: @document.entity_id, filter: true, q: query_params) %>.
                           </span>
                        <% end %>
                     </div>
                  </div>
               <% end %>
            <% end %>

            <% if show_download %>
               <%= link_to @document.file.url(response_content_disposition: @document.inline_disposition), class: "btn btn-outline-primary", target: "_blank",
                           data: { bs_title: "Download the file" } do %>
                  <i class="ti ti-download"></i> Download
               <% end %>
            <% end %>

            <% if current_user %>
               <%= button_to "Check Accessibility", verify_accessibility_document_path(@document), method: :get, class: "btn btn-outline-primary ti ti-check" if params[:debug].present? && policy(@document).verify_accessibility? %>

               <%# Fix Me's button sits with the other actions, but its modal and result panel are rendered
                   below this card (#document_fix_me): inside it the modal would be trapped under the
                   backdrop by the card's own stacking context %>
               <% if policy(@document).run_fix? %>
                  <button type="button" class="btn btn-outline-primary ti ti-wand" data-bs-toggle="modal" data-bs-target="#fixMeModal">
                     Fix Me
                  </button>
               <% end %>

               <% if policy(@document).destroy? %>
                  <%= button_to @document, method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton",
                                data: {action: "click->confirm#popup", turbo: false} do %>
                     <i class="ti ti-trash"></i> <%= t_common(:delete) %>
                  <% end %>
               <% end %>
            <% end %>
         </div>
      </div>
   </div>

   <% if current_user && policy(@document).run_fix? %>
      <div id="document_fix_me"><%= render "documents/fix_me", document: @document, show_button: false %></div>
   <% end %>

   <%# A plain block, not a .row: a .row's negative side margins (with no column inside) made the
       viewer card wider than the header card above and the details cards below %>
   <div class="mb-4" id="document_viewer">
      <% if @document.video? %>
      <%= render "layouts/video", url: @document.file_url %>
      <% elsif @document.embed %>
      <%= render "documents/embed", document: @document %>
      <% elsif ENV['PDF_TRON'] == 'true' && @document.file.present? && !@document.orignal %>
         <%= render "documents/pdf" %>
      <% end %>
   </div>

   <%# Cards under the viewer. The left column (details + description) only when there is something
       for it, so an investor without details does not get an empty half page. %>
   <% show_details = own_document || @document.text.present? %>
   <% show_side = own_document || @document.signature_enabled %>
   <% if show_details || show_side %>
   <div class="row">
      <% if show_details %>
      <div class="<%= show_side ? "col-lg-8" : "col-lg-12" %>">
         <% if own_document %>
         <%# Details: label-over-value grid, the same layout as the capital call details card %>
         <div class="card shadow-sm border-0 mb-4" id="document_details_card">
            <div class="card-header border-bottom py-3">
               <h5 class="mb-0 fw-bold"><i class="ti ti-file-info me-2 text-primary"></i>Details</h5>
            </div>
            <div class="card-body">
               <div class="row g-4">
                  <div class="col-md-6">
                     <label class="text-muted text-uppercase fw-bold fs-1 mb-1">Folder</label>
                     <div class="fs-4 fw-medium"><%= @document.folder&.full_path %></div>
                     <% if @document.folder_id %>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                           <%= link_to folder_documents_path(folder_id: @document.folder_id), class: "btn btn-sm btn-outline-primary",
                                       data: { bs_title: "List the documents in this folder" } do %>
                              <i class="ti ti-files"></i> View Docs
                           <% end %>
                           <%= link_to folder_path(id: @document.folder_id), class: "btn btn-sm btn-outline-primary",
                                       data: { bs_title: "Open the folder - its access rights, NDA and settings" } do %>
                              <i class="ti ti-folder"></i> View Folder
                           <% end %>
                        </div>
                     <% end %>
                  </div>

                  <div class="col-md-6">
                     <label class="text-muted text-uppercase fw-bold fs-1 mb-1">Tags</label>
                     <div class="fs-4 fw-medium">
                        <%# Each tag searches for other documents with it %>
                        <% @document.tag_list.to_s.split(",").map(&:strip).compact_blank.each do |tag| %>
                           <%= link_to tag, search_documents_path(query: tag), class: "badge bg-primary-subtle text-primary" %>
                        <% end %>
                        <% if @document.owner_tag.present? %>
                           <span class="badge bg-secondary-subtle text-secondary"><%= @document.owner_tag %></span>
                        <% end %>
                     </div>
                  </div>

                  <div class="col-md-6">
                     <label class="text-muted text-uppercase fw-bold fs-1 mb-1">Belongs To</label>
                     <div class="fs-4 fw-medium"><%= link_to @document.owner_type, [@document.owner, tab: "docs-tab"] if @document.owner %></div>
                  </div>

                  <% if @document.from_template %>
                     <div class="col-md-6">
                        <label class="text-muted text-uppercase fw-bold fs-1 mb-1">Created From Template</label>
                        <div class="fs-4 fw-medium"><%= link_to @document.from_template.name, @document.from_template %></div>
                     </div>
                  <% end %>

                  <% if @document.as_of.present? %>
                     <div class="col-md-6">
                        <label class="text-muted text-uppercase fw-bold fs-1 mb-1">
                           As Of
                           <i class="ti ti-info-circle" data-bs-title="The date the document applies to. Shown in the document list instead of the upload date."></i>
                        </label>
                        <div class="fs-4 fw-medium"><%= l @document.as_of %></div>
                     </div>
                  <% end %>

                  <div class="col-md-6">
                     <label class="text-muted text-uppercase fw-bold fs-1 mb-1">File</label>
                     <div class="fs-4 fw-medium"><%= document_file_summary(@document) %></div>
                  </div>

                  <div class="col-md-6">
                     <label class="text-muted text-uppercase fw-bold fs-1 mb-1">Uploaded By</label>
                     <div class="fs-4 fw-medium"><%= @document.user.full_name %> | <%= @document.user.email %></div>
                  </div>

                  <div class="col-md-6">
                     <label class="text-muted text-uppercase fw-bold fs-1 mb-1">Uploaded On</label>
                     <div class="fs-4 fw-medium"><%= l @document.created_at %></div>
                  </div>

                  <% if @document.template && @document.pdf_conversion_engine != "libreoffice" %>
                     <div class="col-md-6">
                        <label class="text-muted text-uppercase fw-bold fs-1 mb-1">PDF Conversion Engine</label>
                        <div class="fs-4 fw-medium"><%= @document.pdf_conversion_engine.titleize %></div>
                     </div>
                  <% end %>

                  <% if @document.template_docs_to_append.present? %>
                     <div class="col-md-6">
                        <label class="text-muted text-uppercase fw-bold fs-1 mb-1">
                           Documents to Append
                           <i class="ti ti-info-circle" data-bs-title="Added to the end of each document generated from this template"></i>
                        </label>
                        <div class="fs-4 fw-medium"><%= @document.template_docs_to_append %></div>
                     </div>
                  <% end %>
               </div>

               <%# Custom fields render as table rows (form_types/_display_custom_fields) %>
               <% custom_rows = current_user ? display_custom_fields(@document) : nil %>
               <% if custom_rows.present? %>
                  <table class="table table-bordered mt-4 mb-0">
                     <%= custom_rows %>
                  </table>
               <% end %>
            </div>
         </div>
         <% end %>

         <% if @document.text.present? %>
            <div class="card shadow-sm border-0 mb-4" id="document_description_card">
               <div class="card-header border-bottom py-3">
                  <h5 class="mb-0 fw-bold"><i class="ti ti-align-left me-2 text-primary"></i>Description</h5>
               </div>
               <div class="card-body"><%= @document.text %></div>
            </div>
         <% end %>
      </div>
      <% end %>

      <% if show_side %>
      <div class="<%= show_details ? "col-lg-4" : "col-lg-12" %>">
         <% if own_document %>
         <%# One row per setting, with what it means for an investor - replaces the single "Allow" line %>
         <% investor_settings = [
               ["Download", @document.download, "Users with access can download a PDF copy"],
               ["Print", @document.printing, "Users can print it from the viewer"],
               ["Original format", @document.orignal, "The file exactly as uploaded - no PDF conversion or watermark"],
               ["Embedded viewer", @document.embed, "Shown in Microsoft's online viewer (the file is sent to Microsoft)"],
               ["Public", @document.public_visibility, "Anyone with the link can view it - no access rights needed"],
               ["Email on upload", @document.send_email, "Users who can view it are emailed when it is uploaded"]
            ] %>
         <div class="card shadow-sm border-0 mb-4" id="document_permissions_card">
            <div class="card-header border-bottom py-3">
               <h5 class="mb-0 fw-bold"><i class="ti ti-shield-check me-2 text-primary"></i>What users can do</h5>
            </div>
            <ul class="list-group list-group-flush">
               <% investor_settings.each do |label, on, help| %>
                  <li class="list-group-item d-flex justify-content-between align-items-center px-4">
                     <span><%= label %> <i class="ti ti-info-circle text-muted" data-bs-title="<%= help %>"></i></span>
                     <% if on %>
                        <span class="badge bg-success-subtle text-success">Yes</span>
                     <% else %>
                        <span class="badge bg-secondary-subtle text-secondary">No</span>
                     <% end %>
                  </li>
               <% end %>
            </ul>
         </div>
         <% end %>

         <% if @document.signature_enabled %>
         <div class="card shadow-sm border-0 mb-4" id="document_esign_card">
            <div class="card-header border-bottom py-3">
               <h5 class="mb-0 fw-bold"><i class="ti ti-signature me-2 text-primary"></i>eSignature</h5>
            </div>
            <ul class="list-group list-group-flush">
               <% unless @document.template %>
                  <li class="list-group-item d-flex justify-content-between align-items-center px-4">
                     <span class="text-muted">eSignature Status</span>
                     <span class="badge bg-<%= @document.esign_status_badge %>-subtle text-<%= @document.esign_status_badge %>"><%= @document.esign_status.presence&.titleize || "Not sent" %></span>
                  </li>
               <% end %>

               <% if @document.entity.entity_setting.esign_supports?(:expiry_settings) && @document.sent_for_esign %>
                  <li class="list-group-item d-flex justify-content-between align-items-center px-4">
                     <span class="text-muted">eSignature Expires On</span>
                     <span><%= l(@document.esign_expires_at.to_date) if @document.esign_expires_at %></span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between align-items-center px-4">
                     <span class="text-muted">eSignature Reminders</span>
                     <span>
                        <% if @document.esign_email_reminders %>
                           Every <%= @document.esign_reminder_period.presence || ZohoEsignHelper::DEFAULT_REMINDER_PERIOD_DAYS %> day(s)
                        <% else %>
                           Disabled
                        <% end %>
                     </span>
                  </li>
               <% end %>

               <li class="list-group-item d-flex justify-content-between align-items-center px-4">
                  <span class="text-muted">eSignature On Page</span>
                  <span><%= @document.display_on_page&.titleize %></span>
               </li>
               <li class="list-group-item d-flex justify-content-between align-items-center px-4">
                  <span class="text-muted">eSignatures Order <i class="ti ti-info-circle" data-bs-title="Yes: each signer gets the document only after the previous one signs"></i></span>
                  <span><%= display_boolean @document.force_esign_order %></span>
               </li>

               <% if params[:debug].present? %>
                  <li class="list-group-item d-flex justify-content-between align-items-center px-4">
                     <span class="text-muted">eSign Provider ID</span>
                     <span><%= @document.provider_doc_id %></span>
                  </li>
               <% end %>
            </ul>
         </div>
         <% end %>
      </div>
      <% end %>
   </div>
   <% end %>

</div>

<% if current_user %>
   <%= render "documents/document_details", document: @document if policy(@document).update? %>
<% end %>
