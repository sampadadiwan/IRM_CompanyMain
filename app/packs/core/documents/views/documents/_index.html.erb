<%
  @entity ||= nil
  # Tree-wide lists (search / LP latest) set their own title and show no single folder in it
  title ||= @docs_title || "Documents"

  # sometimes we render the partial directly instead of going through the controller
  # the controller does sorting but when the partial is rendered we sort the documents here
  documents = documents.order(created_at: :desc) if documents && documents.respond_to?(:arel) && documents.arel.orders.blank?

  owner ||= nil
  entity_id ||= owner&.entity_id
  entity_id ||= @entity&.id
  entity_id ||= current_user.entity_id

  document = Document.new(entity_id: , owner: owner)
  doc_attributes = document.attributes.delete_if{|k,v| !["entity_id", "owner_id", "owner_type"].include?(k)}

  @folder ||= nil
  folder_id = @folder&.id || owner&.document_folder_id || params[:folder_id]
  @folder ||= Folder.find(folder_id) if folder_id.present?
  show_action_buttons = params[:show_action_buttons].to_s != "false" # default to true
  #show_action_buttons = false if current_user.curr_role_investor?
%>

<div class="d-sm-flex align-items-center justify-content-between mb-4" id="docs_index">
  <% if folder_id.present? && @docs_title.blank? %>
    <%
        # Get the folder
        @folder = Folder.find(folder_id)
        # link for users or just path for investors
        link = (@folder.entity_id == current_user.entity_id) ? link_to(@folder.name, @folder) : @folder.name
      %>
    <h4 class="mb-0 text-gray-800 d-none d-sm-block">
      <%= title %>: <%= link %>
    </h4>
  <% else %>
    <div class="d-none d-sm-block">
      <h4 class="mb-0 text-gray-800">
        <%= title %>
      </h4>
      <%# Say what a tree-wide list holds, so an LP knows they are not looking at one folder %>
      <% if params[:search].present? %>
        <% if action_name == "index" %>
          <small class="text-muted">Matches across all your folders. Clear the search to see all documents.</small>
        <% else %>
          <small class="text-muted">Matches across all of this fund's folders. Clear the search to see the latest documents.</small>
        <% end %>
      <% elsif params[:latest_first].present? %>
        <small class="text-muted">Everything shared with you, newest first. Pick a folder on the left to browse it.</small>
      <% end %>
    </div>
  <% end %>

  <% if show_action_buttons %>
    <input type="text" id="selected_folder_id" value="<%=folder_id%>" hidden>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <div class="btn-group">
        <div class="dropdown">
          <button class="btn btn-outline-primary dropdown-toggle d-inline-flex align-items-center" type="button"
                  id="doc_actions" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="ti ti-settings"></i> <%= t_common(:actions) %>
          </button>
          <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
            <% if folder_id.present? %>
              <% if policy(document).create? %>
                <%= link_to new_document_path(document: doc_attributes, "document[folder_id]": folder_id, format: :html, turbo: false),
                            class: "dropdown-item d-flex align-items-center" do %>
                  <i class="ti ti-file-plus"></i> New Document
                <% end %>
              <% end %>
              <% if policy(@folder).create? %>
                <%= link_to new_folder_path("folder[entity_id]": current_user.entity_id, "folder[parent_id]": @folder.id),
                            class: "dropdown-item d-flex align-items-center" do %>
                  <i class="ti ti-folder-plus"></i> New Folder
                <% end %>
              <% end %>
              <% if policy(@folder).update? %>
                <%= link_to new_import_upload_path(
                              "import_upload[owner_id]": folder_id,
                              "import_upload[owner_type]": "Folder",
                              "import_upload[import_type]": "Documents",
                              "sample_upload": "DOCS_SAMPLE"),
                            class: "dropdown-item d-flex align-items-center d-none d-sm-block" do %>
                  <i class="ti ti-upload"></i> Bulk Upload
                <% end %>
              <% end %>
              <%# Show "Create AI Portfolio Report" for Portfolio Company folders; disable with a tooltip if the entity doesn't have the agent enabled %>
              <% if @folder && @folder.owner.is_a?(Investor) && @folder.owner.category == 'Portfolio Company' %>
                <% if current_user.entity&.support_agents&.portfolio_company_agent? %>
                  <% if @folder.documents.any? %>
                    <%= button_to create_from_folder_ai_portfolio_reports_path(folder_id: folder_id),
                      method: :post,
                      class: "dropdown-item d-flex align-items-center",
                      data: { msg: "This will generate an AI portfolio report from the #{@folder.documents.count} document(s) in this folder. Proceed?", action: "click->confirm#popup", method: :post } do %>
                      <i class="ti ti-robot"></i> Create AI Portfolio Report (<%= @folder.documents.count %> docs)
                    <% end %>
                  <% else %>
                    <span class="dropdown-item text-muted disabled">
                      <i class="ti ti-robot"></i> Upload documents first to generate AI Report
                    </span>
                  <% end %>
                <% else %>
                  <span class="dropdown-item disabled text-muted" style="opacity:0.65; pointer-events:auto; cursor:default;" data-bs-toggle="tooltip" data-bs-title="Portfolio Company Agent is disabled. Contact support to enable it">
                    <i class="ti ti-robot"></i> Create AI Portfolio Report <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
                  </span>
                <% end %>
              <% end %>
              <%# CP/CS Agent per-document run buttons are on each document row instead
                  of here — avoids the staleness issue of running all documents at once. %>
              <div class="dropdown-divider"></div>
              <% if params[:q].present? %>
                <%= render "documents/bulk_actions", folder_id: folder_id %>
              <% else %>
                <%= link_to documents_path(folder_id: folder_id, filter: true, no_folders: true),
                            class: "dropdown-item d-flex align-items-center" do %>
                  <i class="ti ti-filter"></i> Filter Documents
                <% end %>
              <% end %>
              <div class="dropdown-divider"></div>
              <% if params[:q].present? %>
                <%= button_to download_documents_path(q: params.to_unsafe_h[:q], back_to: request.original_url, folder_id: folder_id),
                              method: :post,
                              class: "dropdown-item d-flex align-items-center",
                              data: { msg: "This will create a zipfile of the documents and email you a link to download the zipfile. This will take a few minutes, please be patient. Proceed?", action: "click->confirm#popup", method: :post } do %>
                  <i class="ti ti-download"></i> <%= t_common(:download) %> ZIP
                <% end %>
              <% else %>
                <% if policy(@folder).download? %>
                  <%= button_to download_folder_path(id: folder_id, back_to: request.original_url),
                                method: :get,
                                class: "dropdown-item d-flex align-items-center d-none d-sm-block",
                                data: { action: "click->confirm#popup", msg: "This will create a zipfile of the documents and email you a link to download the zipfile. This will take a few minutes, please be patient. Proceed?", method: :get } do %>
                    <i class="ti ti-download"></i> <%= t_common(:download) %> Folder
                  <% end %>
                <% end %>
              <% end %>
              <%# Changed: Hide NDA Settings on Data Room root folder — NDA is configured on sub-folders only.
                  Why: The root is just a container gated by enable_data_rooms permission; showing
                  NDA Settings on it would be confusing. NDA belongs on folders inside the Data Room
                  (e.g. Financials, Legal). data_room_root? checks name == "Data Room" && parent.system?. %>
              <% if @folder&.in_data_room? && !@folder&.data_room_root? && current_user.curr_role_employee? %>
                <div class="dropdown-divider"></div>
                <%
                  nda_config = @folder.nda_config
                  nda_path = nda_config.present? ? edit_folder_nda_config_path(@folder) : new_folder_nda_config_path(@folder)
                %>
                <%= link_to nda_path, class: "dropdown-item d-flex align-items-center",
                    data: { turbo_frame: "nda_settings_modal" } do %>
                  <i class="ti ti-shield-lock"></i> NDA Settings
                <% end %>
              <% end %>
              <!-- Future (Send for eSignatures) link is disabled for now -->
            <% else %>
              <% if document && policy(document).create? %>
                <%= link_to new_document_path(document: doc_attributes),
                            class: "dropdown-item d-flex align-items-center" do %>
                  <i class="ti ti-file-plus"></i> New Document
                <% end %>
              <% end %>
              <%= render "documents/bulk_actions" %>
            <% end %>
          </div>
        </div>
      </div>
      <% owner ||= nil %>
      <% @deal ||= nil %>
      <% if owner && ["Deal", "DealInvestor"].include?(owner.class.name) %>
        <% @deal = owner.is_a?(Deal) ? owner : owner.deal %>
      <% end %>
      <% if @deal %>
        <%= link_to folder_documents_path(entity_id: @deal.entity_id, folder_id: @deal.data_room_folder_id, parent_folder_id: @deal.document_folder.id),
                    class: "btn btn-outline-primary d-inline-flex align-items-center",
                    data: { turbo: false } do %>
          <i class="ti ti-database"></i> Data Room
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<% if params[:documents_as_tags].present? %>
  <% custom_colors = current_user.entity.entity_setting.get_document_colors || {} %>

  <div class="d-flex flex-wrap gap-2 mb-3">
    <% documents.each do |document| %>

      <% color = resolve_doc_color(document.name, custom_colors)%>

      <% style =
          if color.present?
            "background-color: color-mix(in srgb, #{color} 10%, white) !important; color: #{color} !important;"
          else
            ""
          end
      %>

      <h2>
        <%= link_to document.name, document_path(document),
          class: "badge bg-secondary fs-4",
          style: style %>
      </h2>
    <% end %>
  </div>
<% else %>
  <% lp_view = current_user.curr_role == "investor" %>
  <div class="table-responsive">
    <table id="documents" class="table table-bordered  dataTable jqDataTable">
      <thead>
        <tr>
          <th class="text-col">
            Name
          </th>
          <% unless lp_view %>
            <th class="text-col">
              Tags
            </th>
          <% end %>
          <th class="date-col">
            Date
          </th>
          <% unless lp_view %>
            <th class="action-col">
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% documents.each do |document| %>
          <%= render partial: "documents/document", locals: {document: document, lp_view: lp_view, show_folder: @show_doc_folder} %>
        <% end %>
      </tbody>
    </table>
  </div>
  <%# Say why the list is empty, so an LP doesn't read an empty search as "this fund has no documents" %>
  <% if documents.respond_to?(:none?) && documents.none? %>
    <% if params[:search].present? %>
      <p class="text-muted text-center mb-0" id="documents_empty">
        No documents match "<%= params[:search] %>". Try fewer or shorter words, or clear the search.
      </p>
    <% elsif params[:latest_first].present? %>
      <p class="text-muted text-center mb-0" id="documents_empty">No documents have been shared with you yet.</p>
    <% end %>
  <% end %>
<% end %>
<%
msg ||= nil
if false && msg.present?
%>
  <div class="text-center">
    <span class="alert alert-info"><%= msg %></span>
  </div>
<% end %>

<%# Changed: Added empty Turbo Frame placeholder for the NDA Settings modal.
    Why: The "NDA Settings" link above targets this frame — clicking it loads the modal
    content from NdaConfigsController#new/edit into this frame without full page reload. %>
<%= turbo_frame_tag "nda_settings_modal" %>

<%# CP/CS Agent run modal and progress panel — rendered outside the main content
    so Bootstrap modal positioning is not affected by any parent container-type CSS.
    Runs per PI — each document row's onclick sets target_id to its owner PI before
    opening this shared modal. The default target_id is a placeholder overwritten
    by the per-row button.
    The progress_panel_new div is the Turbo Stream target for step-by-step progress. %>
<% if current_user.entity&.support_agents&.set?(:cp_cs_extraction_agent) %>
  <%= render "support_agents/agent_run_modal",
             modal_id:         "run-cp-cs-agent-from-docs-modal",
             agent_type:       "CpCsExtractionAgent",
             target_type:      "PortfolioInvestment",
             target_id:        0,
             description:      CpCsExtractionAgent::DESCRIPTION,
             long_description: CpCsExtractionAgent::SINGLE_LONG_DESCRIPTION,
             show_closing_date: true %>
  <div id="progress_panel_new" class="container-fluid px-3 pb-3"></div>
<% end %>
