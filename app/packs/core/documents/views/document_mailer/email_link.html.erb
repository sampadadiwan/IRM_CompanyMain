Dear User

<% if @custom_notification %>
    <%= render "/custom_notifications/mail" %>
<% else %>
    <p>
        The zipfile of the documents you requested is available at the link below. Note this link will expire in <%= @link_ttl == 1.hour ? "1 hour" : "7 days" %>.
    </p>
<% end %>

<p class="btn btn-outline-primary"><%= link_to 'Download Zip', @link %></p>

<% if @msg.present? %>
    <div>
        <%= @msg.html_safe %>
    </div>
<% end %>

<p>
    If the link has expired, please use this <%= link_to 'Download Link', document_url(@document, subdomain: @document.entity.sub_domain) %>
</p>

