<%# One check row. What to do swaps the inputs in place (doc-check-card controller): Fill in shows the
    field and "Replace existing values"; Compare the field; Yes-no question an expected answer. Errors show
    on the row. locals: row (DocCheck), fields (registry fields), key (unique per row: "r<id>", "n<index>",
    or "__KEY__" in the template, replaced by the controller with a fresh key).
    openspec/changes/document-checks/design.md (card ① Setup). Worked examples H2, E3, E16, X4. %>
<% question = row.question?
   gone = row.persisted? && !question && row.field_name.present? && fields.none? { |f| f.name == row.field_name }
   field_error = row.errors[:field_name].first
   look_for_error = row.errors[:look_for].first || row.errors[:tip].first %>
<tr data-doc-check-card-target="row" class="<%= 'table-warning' if gone || field_error || look_for_error %>"
    <%= 'id=doc_check_field_gone' if gone %>>
  <td>
    <%= hidden_field_tag "rows[#{key}][id]", row.id, id: nil %>
    <%= select_tag "rows[#{key}][action]", options_for_select(doc_check_action_options, row.action), id: nil,
          class: "form-select form-select-sm", data: { action: "doc-check-card#actionChanged", role: "action" } %>
  </td>
  <td>
    <div data-role="field-cell" class="<%= 'd-none' if question %>">
      <%= select_tag "rows[#{key}][field_name]",
            options_for_select([["", ""]] + doc_check_field_options(fields), row.field_name), id: nil,
            class: "form-select form-select-sm #{'is-invalid' if field_error || gone}",
            data: { action: "doc-check-card#fieldChanged", role: "field" }, disabled: question %>
      <% if gone %><div class="invalid-feedback d-block"><%= t("doc_checks.setup.field_gone") %></div><% end %>
      <% if field_error %><div class="invalid-feedback d-block"><%= field_error %></div><% end %>
      <div class="form-check mt-1 <%= 'd-none' unless row.fill_in? %>" data-role="replace">
        <%= hidden_field_tag "rows[#{key}][replace_existing]", "0", id: nil %>
        <label class="form-check-label small">
          <%= check_box_tag "rows[#{key}][replace_existing]", "1", row.replace_existing, id: nil, class: "form-check-input" %>
          <%= t("doc_checks.setup.replace_existing") %>
        </label>
      </div>
    </div>
    <div data-role="expected-cell" class="<%= 'd-none' unless question %>">
      <label class="small text-muted"><%= t("doc_checks.setup.columns.expected") %></label>
      <%= select_tag "rows[#{key}][expected_answer]", options_for_select([%w[Yes yes], %w[No no]], row.expected_answer), id: nil,
            class: "form-select form-select-sm d-inline-block w-auto" %>
    </div>
  </td>
  <td>
    <%= text_field_tag "rows[#{key}][look_for]", row.look_for, id: nil, maxlength: 100,
          class: "form-control form-control-sm #{'is-invalid' if look_for_error}",
          placeholder: question ? t("doc_checks.setup.columns.question") : t("doc_checks.setup.columns.look_for"),
          data: { role: "look-for" } %>
    <% if look_for_error %><div class="invalid-feedback d-block"><%= look_for_error %></div><% end %>
  </td>
  <td>
    <%= text_field_tag "rows[#{key}][tip]", row.tip, id: nil, maxlength: 255, class: "form-control form-control-sm" %>
  </td>
  <td class="text-end">
    <button type="button" class="btn btn-sm btn-link text-danger" data-action="doc-check-card#removeRow" aria-label="Remove">
      <i class="ti ti-x"></i>
    </button>
  </td>
</tr>
