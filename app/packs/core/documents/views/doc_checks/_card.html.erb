<%# One document card: its checks as rows, saved together. Presets post the card's current rows to
    /doc_checks/preset and come back as unsaved rows. locals: card (DocChecks::CardForm), not_added, dirty.
    openspec/changes/document-checks/design.md (card ① Setup). Worked examples H1, H2, E3, E4, E5, E16. %>
<% not_added ||= []
   dirty ||= false
   fields = DocChecks::Registry.for(card.record_type).fields_for(card.entity)
   preset = DocChecks::Presets.key_for(card.document_name)
   dom_id = doc_check_card_dom_id(card.document_name) %>
<div class="card mb-3" id="<%= dom_id %>" data-controller="doc-check-card"
     data-doc-check-card-dirty-value="<%= dirty %>" data-document-name="<%= card.document_name %>">
  <%= form_with url: card_doc_checks_path(record_type: card.record_type), method: :patch,
                data: { action: "input->doc-check-card#changed change->doc-check-card#changed submit->doc-check-card#submitting" } do %>
    <%= hidden_field_tag :document_name, card.document_name %>
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
      <strong>
        <%= card.document_name %> ·
        <span class="text-muted fw-normal doc-check-card-count">
          <%= card.rows.any? ? t("doc_checks.setup.checks_count", count: card.rows.size) : t("doc_checks.setup.no_checks_yet") %>
        </span>
      </strong>
      <span class="d-flex gap-2">
        <% if preset %>
          <%= button_tag t("doc_checks.setup.use_preset", name: DocChecks::Presets.name_for(preset)), type: :submit,
                formaction: preset_doc_checks_path(record_type: card.record_type), formmethod: :post,
                class: "btn btn-sm btn-outline-secondary", name: nil %>
        <% end %>
        <button type="button" class="btn btn-sm btn-outline-primary" data-action="doc-check-card#addRow">
          <i class="ti ti-plus"></i> <%= t("doc_checks.setup.add_check") %>
        </button>
      </span>
    </div>

    <div class="card-body p-0">
      <% if not_added.any? %>
        <div class="alert alert-warning rounded-0 mb-0 doc-check-not-added">
          <%= t("doc_checks.setup.not_added", labels: not_added.to_sentence(two_words_connector: ", ", last_word_connector: ", ")) %>
        </div>
      <% end %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="<%= 'd-none' if card.rows.empty? %>" data-doc-check-card-target="head">
            <tr>
              <th style="width: 11rem"><%= t("doc_checks.setup.columns.action") %></th>
              <th style="width: 15rem"><%= t("doc_checks.setup.columns.field") %></th>
              <th><%= t("doc_checks.setup.columns.look_for") %></th>
              <th><%= t("doc_checks.setup.columns.tip") %></th>
              <th style="width: 2.5rem"></th>
            </tr>
          </thead>
          <tbody data-doc-check-card-target="rows">
            <% card.rows.each_with_index do |row, index| %>
              <%= render "doc_checks/row", row:, fields:, key: row.persisted? ? "r#{row.id}" : "n#{index}" %>
            <% end %>
          </tbody>
        </table>
      </div>
      <template data-doc-check-card-target="template">
        <%= render "doc_checks/row", row: DocCheck.new(action: "fill_in"), fields:, key: "__KEY__" %>
      </template>
    </div>

    <div class="card-footer d-flex justify-content-end align-items-center gap-2 <%= 'd-none' unless dirty %>" data-doc-check-card-target="footer">
      <span class="text-warning small me-auto"><%= t("doc_checks.setup.unsaved") %></span>
      <%= link_to t("doc_checks.panel.cancel"), doc_checks_path(record_type: card.record_type), class: "btn btn-sm btn-link", data: { turbo: false } %>
      <%= submit_tag t("doc_checks.panel.save"), class: "btn btn-sm btn-primary", name: nil %>
    </div>
  <% end %>
</div>
