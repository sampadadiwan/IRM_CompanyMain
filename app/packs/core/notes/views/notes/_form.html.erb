<% return_to ||= nil %>
<%= render FormCard.new(title: "Note") do %>

<%= form_with(model: note, validate: true) do |form| %>
  <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <%= hidden_field_tag :embedded_note_context, params[:embedded_note_context] %>
  <%= hidden_field_tag :embedded_owner_id, params[:owner_id].presence || params.dig(:note, :owner_id) %>
  <% if note.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(note.errors.count, "error") %> prohibited this note from being saved:</h2>

      <ul>
        <% note.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <%
    edit_mode = note.persisted?
    note_context = params[:embedded_note_context].presence
    note_context ||= "deal_investor_tab" if params[:from] == "deal_details"
    restricted_embedded_context = note_context.in?(%w[deal_tab deal_investor_tab])

    effective_owner_type = note.owner_type.presence
    effective_owner_type ||= "User" if note_context.blank?
    note.owner_type = effective_owner_type

    investor_owner_options = current_user.entity.investors.includes(:investor_entity).sort_by { |investor| investor.investor_name }.map { |investor| [investor.investor_name, investor.id] }
    owner_options = nil
    if effective_owner_type == "DealInvestor"
      owner_options = current_user.entity.deal_investors.includes(:investor).sort_by { |d| d.investor_name }.map { |d| [d.investor_name, d.id] }
    elsif note_context.blank?
      owner_options = investor_owner_options
    elsif effective_owner_type == "Investor"
      owner_options = investor_owner_options
    end

    # Ensure current owner remains visible even if it is not in the default scoped options.
    if edit_mode && owner_options.present? && note.owner_id.present? && owner_options.none? { |(_label, value)| value.to_s == note.owner_id.to_s }
      owner_label = case effective_owner_type
                    when "DealInvestor", "Investor"
                      note.owner&.respond_to?(:investor_name) ? note.owner.investor_name : note.owner_id.to_s
                    else
                      note.owner_id.to_s
                    end
      owner_options.unshift([owner_label, note.owner_id])
    end

    owner_type_disabled = restricted_embedded_context || edit_mode
    owner_type_options = if note_context.blank?
      [["User", "User"], ["Investor", "Investor"]]
    elsif effective_owner_type == "Investor"
      [["Investor", "Investor"]]
    else
      [["Deal Investor", "DealInvestor"]]
    end

    # In edit mode, owner type is display-only and must reflect the current persisted owner type.
    owner_type_options = [[effective_owner_type == "DealInvestor" ? "Deal Investor" : effective_owner_type, effective_owner_type]] if edit_mode

    owner_locked = edit_mode || (effective_owner_type == "DealInvestor" && note.owner_id.present? && note_context == "deal_investor_tab")
    show_for_field = effective_owner_type != "User"
    show_name_field = effective_owner_type == "User"
    owner_name_value = if edit_mode && effective_owner_type == "User"
      note.owner&.respond_to?(:full_name) ? note.owner.full_name : note.owner&.to_s
    else
      current_user.full_name
    end
  %>

  <div data-controller="note-owner">
    <div class="form-group">
      <%= form.label :owner_type, "Owner Type" %>
      <%= form.select :owner_type,
        owner_type_options,
        { selected: effective_owner_type, include_blank: false },
        class: "form-control",
        disabled: owner_type_disabled,
        data: {
          "note-owner-target": "ownerType",
          action: "change->note-owner#ownerTypeChanged"
        } %>
      <%= form.hidden_field :owner_type if owner_type_disabled %>
      <%= form.hidden_field :entity_id if owner_type_disabled %>
    </div>

    <% if owner_options.present? %>
      <div class="form-group <%= show_for_field ? '' : 'd-none' %>" data-note-owner-target="ownerForGroup">
        <%= form.label :owner_id, "For" %>
        <%= form.select :owner_id,
          owner_options,
          { selected: note.owner_id, include_blank: !owner_locked },
          class: "form-control",
          disabled: owner_locked,
          data: {
            "note-owner-target": "ownerForSelect",
            locked: owner_locked
          } %>
        <%= form.hidden_field :owner_id if owner_locked %>
      </div>
    <% else %>
      <%= form.hidden_field :owner_id %>
    <% end %>

    <div class="form-group <%= show_name_field ? '' : 'd-none' %>" data-note-owner-target="ownerNameGroup">
      <%= form.label :owner_name, "Name" %>
      <%= text_field_tag :owner_name, owner_name_value, class: "form-control", disabled: true %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :on %>
    <%= form.date_field :on, class: "form-control"  %>
    <small>The date as of which the information in this note is applicable.</small>
  </div>

  <div class="form-group">
    <%= form.label :details %>
    <%= form.rich_text_area :details, class: "form-control trix-content"  %>
  </div>

  <div class="form-group">
    <%= form.label :tags %>
    <%= form.text_field :tags, class: "form-control"  %>
    <span class="text-muted">Comma separated tags</span>
  </div>

  <%= form.fields_for :reminder do |reminder_subform| %>

      <div class="form-group">
        <%= reminder_subform.label :email, "Reminder Emails" %>
        <%= reminder_subform.text_field :email, class: "form-control"  %>
        <small class="text-muted">Comma separated emails to send reminder to.</small>
      </div>

      <div class="form-group">
        <%= reminder_subform.label :due_date, "Reminder Date" %>
        <%= reminder_subform.date_field :due_date, class: "form-control"  %>
      </div>

  <% end %>

  <div class="form-group">
    <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
  </div>
<% end %>

  </div>
</div>

<% end %>
