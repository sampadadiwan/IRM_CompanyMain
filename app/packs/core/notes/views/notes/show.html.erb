<% owner_name = @note.to_s %>
<%= render ToggleCard.new(title: "Note: #{owner_name}", css_class: "show_note") do %>
  <table class="table table-bordered dataTable ">
    <tr>
      <td>
        For
      </td>
      <td>
        <% if @note.owner.present? %>
          <%= link_to owner_name, polymorphic_path(@note.owner) %>
        <% end %>
      </td>
    </tr>
    <tr>
      <td>
        Details
      </td>
      <td>
        <%= @note.details %>
      </td>
    </tr>
    <%# LP CRM: the person at the LP this note was with, if recorded %>
    <% if @note.touch_point %>
      <tr>
        <td>
          With
        </td>
        <td>
          <%= @note.touch_point.full_name %>
        </td>
      </tr>
    <% end %>
    <tr>
      <td>
        On
      </td>
      <td>
        <%= l @note.on if @note.on%>
      </td>
    </tr>
    <tr>
      <td>
        Tags
      </td>
      <td>
        <%= @note.tags %>
      </td>
    </tr>
    <% if @note.reminder %>
      <tr>
        <td>
          Reminder Emails
        </td>
        <td>
          <%= @note.reminder.email %>
        </td>
      </tr>
      <tr>
        <td>
          Reminder Date
        </td>
        <td>
          <%= l @note.reminder.due_date %>
        </td>
      </tr>
      <tr>
        <td>
          Reminder Sent
        </td>
        <td>
          <%= display_boolean @note.reminder.sent %>
        </td>
      </tr>
    <% end %>
    <tr>
      <td>
        Created At
      </td>
      <td>
        <%= l @note.created_at %>
      </td>
    </tr>
  </table>
<% end %>
<div>
  <%= link_to  t_common(:edit), edit_note_path(@note), {class: "btn btn-outline-primary ti ti-edit"} if policy(@note).update? %>
  <%= button_to t_common(:delete), @note, method: :delete, class: "btn btn-outline-danger ti ti-trash", form_class: "deleteButton", data: {action: "click->confirm#popup", turbo:false} %>
</div>
