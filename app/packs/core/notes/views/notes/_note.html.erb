<tr id="note_<%= note.id %>">

<% unless params[:condensed].present? %>
<td>
    <% owner_name = note.to_s %>
    <%= link_to owner_name, polymorphic_path(note.owner) if note.owner.present? %>
</td>
<td>
    <%= link_to note.user_full_name, notes_path(user_id: note.user_id) %>
</td>
<% end %>

<td>
    <% if note.on.present? %>
        <%= note.on.is_a?(Date) ? l(note.on) : l(Date.local_parse(note.on)) %>
    <% end %>
</td>
<td>
    <%= note.tags %>
</td>
<td>
    <%= note.details %>
</td>

<td>
  <%= link_to  t_common(:show), note_path(note.id) , {class: "btn btn-outline-primary ti ti-eye"}%>
</td>
</tr>
