<% owner_id = params[:owner_id].presence
  owner_type = params[:owner_type].presence
  title ||= params[:title] || "Notes"
  from_source = params[:from].presence
  embedded_note_context = params[:embedded_note_context].presence
  # Hide the "Summarise Notes" button if the notes are being displayed in the context of a deal investor tab, as summarization may not be relevant in that context.
  # But still show in normal notes view for the user
  hide_summarize_btn = embedded_note_context == "deal_investor_tab"
%>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800"><%= title %></h1>
  <div class="d-flex gap-2">
    <%# The enclosing notes_frame is target: "_top", so without an explicit
        data-turbo-frame this link navigates the whole page away from the list.
        Pointing it at new_note loads the form inline instead. %>
    <%# LP CRM: when this list is filtered to a touch point (contact show page tabs),
        carry it into the form so the new note is pre-linked to that person —
        NotesController#new builds the note from these note[...] params. %>
    <%= link_to "New Note", new_note_path("note[owner_id]": owner_id, "note[owner_type]": owner_type, "note[entity_id]": current_user.entity_id, "note[touch_point_id]": params[:touch_point_id].presence, return_to: params[:return_to], from: from_source, embedded_note_context: embedded_note_context, condensed: params[:condensed]), {class: "btn btn-outline-primary ti ti-plus", data: { turbo_frame: "new_note" }} %>
    <% if owner_id.present? && !hide_summarize_btn %>
      <% if current_user.entity.support_agents.set?(:note_summarization_agent) %>
      <button type="button" class="btn btn-outline-secondary"
              data-bs-toggle="modal" data-bs-target="#run-note-summarizer-agent-modal">
        <i class="ti ti-brain"></i> Summarise Notes
      </button>

      <%= render "support_agents/agent_run_modal",
                 modal_id:         "run-note-summarizer-agent-modal",
                 agent_type:       "NoteSummarizerAgent",
                 target_type:      owner_type,
                 target_id:        owner_id,
                 description:      NoteSummarizerAgent::DESCRIPTION,
                 long_description: NoteSummarizerAgent::SINGLE_LONG_DESCRIPTION,
                 btn_text:         "Run Summariser",
                 modal_title:      "Summarise Investor Notes" %>
      <% else %>
        <!-- note_summarization_agent disabled: show greyed-out button -->
        <span data-bs-toggle="tooltip" title="Note Summarisation Agent is disabled. Contact support to enable it">
          <button type="button" class="btn btn-outline-secondary"
                  style="filter:grayscale(100%) opacity(0.7); pointer-events:none;">
            <i class="ti ti-brain"></i> Summarise Notes <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
          </button>
        </span>
      <% end %>
    <% end %>
  </div>
</div>

<%= render "notes/blank" %>
<%=render SearchComponent.new(data_source: notes_path(params: params.to_unsafe_h), turbo_frame: "notes_frame") %>

<div class="table-responsive">
  <table id="notes" class="table table-bordered dataTable ">
    <thead>
      <tr>
        <% unless params[:condensed].present? %>
        <th>
          <%= sort_link @q, :owner_name, "For" %>
        </th>
        <th>
          <%= sort_link @q, :user_first_name, "User" %>
        </th>
        <%# LP CRM: the person at the LP this note was with (Note#touch_point).
            Kept out of the condensed (dashboard widget) column set. %>
        <th>
          With
        </th>
        <% end %>
        <th>
          <%= sort_link @q, :on, "On" %>
        </th>
        <th>
          <%= sort_link @q, :tags %>
        </th>
        <th>
          Details
        </th>
        <th>
        </th>
      </tr>
    </thead>

    <tbody id="notes_table_body">
      <% notes.each do |note| %>
        <%= render partial: "/notes/note", locals: {note: note} %>
      <% end %>
    </tbody>

  </table>
  <% if notes.present? %>
     <div class="d-flex justify-content-between align-items-center">
            <%= raw pagy_info(@pagy) %>
            <%= raw pagy_bootstrap_nav(@pagy, anchor_string: %(data-turbo-frame="notes_frame" data-remote="true")) %>
      </div>
  <% end %>

</div>

