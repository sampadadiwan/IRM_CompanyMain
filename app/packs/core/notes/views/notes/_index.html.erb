<% investor_id = params[:investor_id] || params[:owner_id]
  title ||= params[:title] || "Notes"
%>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800"><%= title %></h1>
  <div class="d-flex gap-2">
    <%= link_to "New Note", new_note_path("note[investor_id]": investor_id, "note[entity_id]": current_user.entity_id, return_to: params[:return_to]), {class: "btn btn-outline-primary ti ti-plus"} %>
    <% if investor_id.present? %>
      <% if current_user.entity.support_agents.set?(:note_summarization_agent) %>
      <button type="button" class="btn btn-outline-secondary"
              data-bs-toggle="modal" data-bs-target="#run-note-summarizer-agent-modal">
        <i class="ti ti-brain"></i> Summarise Notes
      </button>

      <%= render "support_agents/agent_run_modal",
                 modal_id:         "run-note-summarizer-agent-modal",
                 agent_type:       "NoteSummarizerAgent",
                 target_type:      "Investor",
                 target_id:        investor_id,
                 description:      NoteSummarizerAgent::DESCRIPTION,
                 long_description: NoteSummarizerAgent::SINGLE_LONG_DESCRIPTION,
                 btn_text:         "Run Summariser",
                 modal_title:      "Summarise Investor Notes" %>
      <% else %>
        <!-- note_summarization_agent disabled: show greyed-out button -->
        <span data-bs-toggle="tooltip" title="Note Summarisation Agent is disabled. Contact support to enable it">
          <button type="button" class="btn btn-outline-secondary"
                  style="filter:grayscale(100%) opacity(0.7); pointer-events:none;">
            <i class="ti ti-brain"></i> Summarise Notes <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
          </button>
        </span>
      <% end %>
    <% end %>
  </div>
</div>

<%=render SearchComponent.new(data_source: notes_path(params: params.to_unsafe_h), turbo_frame: "notes_frame") %>

<div class="table-responsive">

  <table id="notes" class="table table-bordered dataTable ">
    <thead>
      <tr>
        <% unless params[:condensed].present? %>
        <th>
          <%= sort_link @q, :investor_investor_name, "Stakeholder" %>
        </th>
        <th>
          <%= sort_link @q, :user_first_name, "User" %>
        </th>
        <% end %>
        <th>
          <%= sort_link @q, :on, "On" %>
        </th>
        <th>
          <%= sort_link @q, :tags %>
        </th>
        <th>
          Details
        </th>
        <th>
        </th>
      </tr>
    </thead>

    <tbody>
      <% notes.each do |note| %>
        <%= render partial: "/notes/note", locals: {note: note} %>
      <% end %>
    </tbody>

  </table>
  <% if notes.present? %>
     <div class="d-flex justify-content-between align-items-center">
            <%= raw pagy_info(@pagy) %>
            <%= raw pagy_bootstrap_nav(@pagy, anchor_string: %(data-turbo-frame="notes_frame" data-remote="true")) %>
      </div>
  <% end %>

</div>

