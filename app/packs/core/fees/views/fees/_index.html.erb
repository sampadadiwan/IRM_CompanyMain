<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Fees</h1>
  <%= link_to "New Fee" , new_fee_path("fee[owner_id]": owner.id, "fee[owner_type]": owner.class.name), {class: "btn btn-outline-primary" } if owner %>
</div>
<div class="table-responsive">
  <table id="fees" class="table table-bordered dataTable jqDataTable">
    <thead>
      <tr>
        <th class="text-col">
          Advisor Name
        </th>
        <th class="num-col">
          Amount
        </th>
        <th class="text-col">
          Amount Label
        </th>
        <th class="text-col">
          Owner
        </th>
        <th class="action-col">
        </th>
      </tr>
    </thead>
    <tbody>
      <% fees.each do |fee| %>
        <%= render fee %>
      <% end %>
    </tbody>
  </table>
</div>
