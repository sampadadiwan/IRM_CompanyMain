<%# LP notification: NDA has been updated to a new version, re-acceptance required. %>
<%# Sent to all InvestorAccess users of investors with stale acceptances. %>

<p>Dear <%= @investor_name %>,</p>

<p><%= @entity_name %> has updated the version of the Non-Disclosure Agreement for the folder below. You are required to review and accept the new version to continue accessing its documents.</p>

<table style="border-collapse:collapse;width:100%">
  <% if @updated_at.present? %>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Updated On</td>
    <td style="padding:6px 12px"><%= l(@updated_at) %></td>
  </tr>
  <% end %>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Folder</td>
    <td style="padding:6px 12px"><%= @folder_name %></td>
  </tr>
</table>

<p style="margin-top:16px">Please review and accept the updated agreement to regain or retain access to the folder.</p>

<% if @contact_email.present? %>
  <p>For any queries or clarifications, please contact <a href="mailto:<%= @contact_email %>" style="color:#1a73e8;text-decoration:none"><%= @contact_email %></a>.</p>
<% end %>

<% if @folder_link.present? %>
  <p class="btn btn-outline-warning"><%= link_to "Review & Accept Non Disclosure Agreement", @folder_link %></p>
<% end %>
