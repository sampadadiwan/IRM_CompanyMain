<%# LP notification: reminder to accept a pending NDA on a folder. %>
<%# Sent to NDA signatories of pending investors via NdaReminderNotifier. %>

<p>You have a pending NDA that requires your attention.</p>

<table style="border-collapse:collapse;width:100%">
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Folder</td>
    <td style="padding:6px 12px"><%= @folder_name %></td>
  </tr>
</table>

<p style="margin-top:16px">Please review and accept the NDA to access the Data Room folder.</p>

<% if @folder_link.present? %>
  <p>
    <a href="<%= @folder_link %>" style="color:#1a73e8;text-decoration:none">Review NDA →</a>
  </p>
<% end %>

<% if @contact_email.present? %>
  <p>If you have questions, please contact <a href="mailto:<%= @contact_email %>" style="color:#1a73e8;text-decoration:none"><%= @contact_email %></a>.</p>
<% end %>
