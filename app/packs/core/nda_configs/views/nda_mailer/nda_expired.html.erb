<%# GP + LP notification: NDA acceptance has expired. %>
<%# Sent to notification_emails (GP, direct) and NDA signatories (LP, via Noticed). %>

<p>Dear <%= @investor_name %>,</p>

<p>This is to notify you that your Non-Disclosure Agreement with <%= @entity_name %> has expired.</p>

<table style="border-collapse:collapse;width:100%">
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Expired On</td>
    <td style="padding:6px 12px"><%= l(@expiry_date) %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Folder</td>
    <td style="padding:6px 12px"><%= @folder_name %></td>
  </tr>
</table>

<p style="margin-top:16px">Access to the documents within this folder is now restricted. Please complete the required renewal or re-acceptance to restore access.</p>

<% if @contact_email.present? %>
  <p>For any queries or clarifications, please contact <a href="mailto:<%= @contact_email %>" style="color:#1a73e8;text-decoration:none"><%= @contact_email %></a>.</p>
<% end %>

<% if @folder_link.present? %>
  <p class="btn btn-outline-warning"><%= link_to "Re-accept Non Disclosure Agreement", @folder_link %></p>
<% end %>
