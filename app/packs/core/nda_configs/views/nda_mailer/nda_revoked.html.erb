<%# LP notification: GP revoked the investor's NDA acceptance. %>
<%# Sent to all InvestorAccess users of the revoked investor. %>

<p>Dear <%= @investor_name %>,</p>

<p>This is to notify you that your previously accepted Non-Disclosure Agreement with <%= @entity_name %> has been revoked.</p>

<table style="border-collapse:collapse;width:100%">
  <% if @revoked_at.present? %>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Revoked On</td>
    <td style="padding:6px 12px"><%= l(@revoked_at) %></td>
  </tr>
  <% end %>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Folder</td>
    <td style="padding:6px 12px"><%= @folder_name %></td>
  </tr>
</table>

<p style="margin-top:16px">You are required to re-accept the Non-Disclosure Agreement to access the documents within this folder.</p>

<% if @contact_email.present? %>
  <p>For any queries or clarifications, please contact <a href="mailto:<%= @contact_email %>" style="color:#1a73e8;text-decoration:none"><%= @contact_email %></a>.</p>
<% end %>

<% if @folder_link.present? %>
  <p class="btn btn-outline-warning"><%= link_to "Re-Accept Non Disclosure Agreement", @folder_link %></p>
<% end %>
