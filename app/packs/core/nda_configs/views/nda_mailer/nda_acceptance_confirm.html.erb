<%# LP notification: a colleague accepted the NDA — you now have folder access. %>
<%# Sent to all InvestorAccess users of the investor, excluding the signer. %>

<p>The NDA for your Data Room folder has been accepted. You now have access.</p>

<table style="border-collapse:collapse;width:100%">
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Folder</td>
    <td style="padding:6px 12px"><%= @folder_name %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Signed By</td>
    <td style="padding:6px 12px"><%= @signed_by %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Date</td>
    <td style="padding:6px 12px"><%= l(@signed_at) %></td>
  </tr>
</table>

<% if @folder_link.present? %>
  <p style="margin-top:16px">
    <a href="<%= @folder_link %>" style="color:#1a73e8;text-decoration:none">Open Data Room Folder →</a>
  </p>
<% end %>
