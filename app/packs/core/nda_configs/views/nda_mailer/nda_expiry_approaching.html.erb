<%# GP + LP notification: NDA acceptance expiring within 7 days. %>
<%# Sent to notification_emails (GP, direct) and NDA signatories (LP, via Noticed). %>

<p>An NDA acceptance on your Data Room folder is expiring soon.</p>

<table style="border-collapse:collapse;width:100%">
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Investor</td>
    <td style="padding:6px 12px"><%= @investor_name %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Folder</td>
    <td style="padding:6px 12px"><%= @folder_name %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Expiry Date</td>
    <td style="padding:6px 12px"><%= l(@expiry_date) %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Days Remaining</td>
    <td style="padding:6px 12px"><%= @days_until_expiry %></td>
  </tr>
</table>

<p style="margin-top:16px">Please re-accept the NDA before it expires to maintain folder access.</p>

<% if @folder_link.present? %>
  <p>
    <a href="<%= @folder_link %>" style="color:#1a73e8;text-decoration:none">Re-accept NDA →</a>
  </p>
<% end %>
