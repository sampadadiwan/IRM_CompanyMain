<%# GP notification: an LP investor declined the NDA on a folder. %>
<%# Sent to each address in NdaConfig.notification_emails via direct delivery. %>

<p>An investor has declined the NDA on your Data Room folder.</p>

<table style="border-collapse:collapse;width:100%">
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Investor</td>
    <td style="padding:6px 12px"><%= @investor_name %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Folder</td>
    <td style="padding:6px 12px"><%= @folder_name %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">NDA Version</td>
    <td style="padding:6px 12px"><%= @nda_version %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Declined By</td>
    <td style="padding:6px 12px"><%= @declined_by %></td>
  </tr>
  <tr>
    <td style="padding:6px 12px;font-weight:bold">Date</td>
    <td style="padding:6px 12px"><%= l(@declined_at) %></td>
  </tr>
</table>
