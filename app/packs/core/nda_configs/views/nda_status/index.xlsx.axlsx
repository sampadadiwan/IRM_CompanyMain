# NDA Status XLSX export — flat rows with one row per user across all investors.
# Columns: Investor Name, User Name, Email, Status, Expiry Reason, Signed By, Signed Date, Exemption Reason.
# Changed: Module 4 — added Expiry Reason column for version mismatch / period expired.
# Why: GPs need to see why an investor's acceptance is expired in the exported compliance record.

wb = xlsx_package.workbook

wb.add_worksheet(name: "NDA Status") do |sheet|
  sheet.add_row([
    "Investor Name",
    "User Name",
    "Email",
    "Investor Status",
    "Expiry Reason",
    "User Status",
    "NDA Tagged",
    "Signed By",
    "Signed Date",
    "Exemption Reason"
  ])

  @status_data[:investor_rows].each do |row|
    row[:users].each do |user_row|
      exemption_reason = if user_row[:exempt]
                           NdaExemption.find_by(nda_config_id: @nda_config.id, user_id: user_row[:user].id)&.reason
                         end

      expiry_label = case row[:expiry_reason]
                     when "version" then "Version mismatch"
                     when "period" then "Period expired"
                     else ""
                     end

      sheet.add_row [
        row[:investor].investor_name,
        user_row[:user].full_name,
        user_row[:user].email,
        row[:status],
        expiry_label,
        user_row[:status],
        user_row[:nda_tagged] ? "Yes" : "No",
        row[:signed_by]&.full_name || "—",
        row[:signed_at] ? I18n.l(row[:signed_at], format: :short) : "—",
        exemption_reason || ""
      ]
    end
  end
end
