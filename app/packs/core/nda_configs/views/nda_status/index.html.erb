<%# NDA Status dedicated dashboard page — server-rendered HTML table with investor-level rows.
     Provides status filtering, search, XLSX export, and user-level exemption management.
     Changed: Module 8 — added Revoked counter/filter/badge, Revoke button on Accepted rows,
       and Send Reminders button in page header.
     Why: GPs need to revoke accepted NDAs, see revoked investors, and bulk-remind pending ones.
     Changed: Module 9 — added first-creation banner, zero-signatory ⚠ warnings, and
       first_creation Stimulus value for auto-expanding investor rows on first NDA creation.
     Why: After first NDA creation, GP is redirected here to tag signatories. Banner prompts
       tagging, rows auto-expand, and ⚠ icons flag investors with no signatories. %>
<%
  status_data = @status_data
  nda_config = @nda_config
  folder = @folder
  investor_rows = status_data[:investor_rows]
  counters = status_data[:counters]
%>

<div class="container-fluid py-4" data-controller="nda-status"
     data-nda-status-nda-config-id-value="<%= nda_config.id %>"
     data-nda-status-folder-id-value="<%= folder.id %>"
     data-nda-status-first-creation-value="<%= params[:first_creation].present? %>">

  <%# Page header with Send Reminders + Export buttons %>
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="h3 mb-0 text-gray-800">
        <i class="ti ti-shield-lock me-1"></i> NDA Status &mdash; <%= folder.name %>
      </h1>
      <p class="text-muted mb-0 mt-1">
        <%= nda_config.acceptance_method.titleize %> &middot; <%= nda_config.validity_type.titleize %>
      </p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <%# Changed: Module 8 — Send Reminders button for bulk NDA reminders to pending investors.
           Why: GP clicks to email all pending investors' signatories. Confirmation dialog shows count. %>
      <button class="btn btn-outline-warning"
              data-action="click->nda-status#sendReminders"
              data-bs-toggle="tooltip"
              data-bs-title="Send NDA reminders to all pending investors' signatories">
        <i class="ti ti-bell-ringing me-1"></i> Send Reminders
      </button>
      <%= link_to nda_status_path(nda_config_id: nda_config.id, folder_id: folder.id, format: :xlsx),
          class: "btn btn-outline-primary ti ti-download", data: { turbo: false, bs_toggle: "tooltip", bs_title: "Download NDA status as Excel" } do %>
        Export
      <% end %>
    </div>
  </div>

  <%# Module 9: First-creation banner — shown when GP is redirected here after first NDA save.
       Why: Prompts GP to tag signatories immediately. Hidden by default; Stimulus controller
         removes d-none when firstCreation value is true. Dismissible via Bootstrap close button. %>
  <div class="alert alert-success alert-dismissible d-none mb-4" data-nda-status-target="firstCreationBanner">
    <i class="ti ti-check me-1"></i>
    NDA settings saved. Tag designated signatories for each investor below.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>

  <%# Status counters — Changed: Module 8 — added Revoked counter badge.
       Why: GPs need to see how many investors have been revoked. %>
  <div class="d-flex gap-3 mb-3">
    <span class="badge bg-success-subtle text-success px-3 py-2 fs-6">
      Accepted: <%= counters[:accepted] %>
    </span>
    <span class="badge bg-warning-subtle text-warning px-3 py-2 fs-6">
      Pending: <%= counters[:pending] %>
    </span>
    <span class="badge bg-danger-subtle text-danger px-3 py-2 fs-6">
      Declined: <%= counters[:declined] %>
    </span>
    <span class="badge px-3 py-2 fs-6" style="background-color: #e8daef; color: #6c3483;">
      Revoked: <%= counters[:revoked] %>
    </span>
    <span class="badge bg-secondary-subtle text-secondary px-3 py-2 fs-6">
      Expired: <%= counters[:expired] %>
    </span>
    <span class="badge bg-info-subtle text-info px-3 py-2 fs-6">
      Exempt: <%= counters[:exempt] %>
    </span>
  </div>

  <%# Toolbar: filter and search — Changed: Module 8 — added Revoked filter option.
       Why: GPs need to filter the dashboard to show only revoked investors. %>
  <div class="nested-fields">
    <div class="search-form d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-2">
        <select class="form-control" style="width: auto;"
                data-action="change->nda-status#filterByStatus"
                data-nda-status-target="statusFilter">
          <option value="">All Statuses</option>
          <option value="Accepted">Accepted</option>
          <option value="Pending">Pending</option>
          <option value="Declined">Declined</option>
          <option value="Revoked">Revoked</option>
          <option value="Expired">Expired</option>
          <option value="Exempt">Exempt</option>
        </select>
      </div>
      <div class="search-form-input">
        <input type="text" class="form-control" placeholder="Search..."
               data-action="input->nda-status#search"
               data-nda-status-target="searchInput">
      </div>
    </div>
  </div>

  <%# Standard HTML table matching Ransack table CSS classes %>
  <div class="table-responsive">
    <table class="table table-bordered dataTable action_table hover">
      <thead>
        <tr>
          <th>Investor Name</th>
          <th>Category</th>
          <th>Status</th>
          <th>Signed By</th>
          <th>Signed Date</th>
          <th class="action-col">Actions</th>
        </tr>
      </thead>
      <tbody data-nda-status-target="tableBody">
        <% investor_rows.each do |row| %>
          <tr data-nda-status-target="row"
              data-status="<%= row[:status] %>"
              data-investor-name="<%= row[:investor].investor_name.downcase %>"
              data-investor-id="<%= row[:investor].id %>">
            <td><%= row[:investor].investor_name %></td>
            <td><%= row[:investor].category %></td>
            <td>
              <%# Changed: Module 8 — added Revoked status badge (purple, inline-styled).
                   Why: Distinct from Pending (they had access, it was taken away).
                   Purple chosen because all Bootstrap contextual colors are already used. %>
              <% if row[:status] == "Revoked" %>
                <span class="badge" style="background-color: #e8daef; color: #6c3483;">
                  <%= row[:status] %>
                </span>
              <% else %>
                <% status_class = case row[:status]
                                  when "Accepted" then "success"
                                  when "Pending" then "warning"
                                  when "Declined" then "danger"
                                  when "Expired" then "secondary"
                                  when "Exempt" then "info"
                                  end %>
                <span class="badge bg-<%= status_class %>-subtle text-<%= status_class %>"
                      <% if row[:status] == "Expired" && row[:expiry_reason] %>
                        title="<%= row[:expiry_reason] == 'version' ? 'Version mismatch' : 'Period expired' %>"
                        data-bs-toggle="tooltip"
                      <% end %>>
                  <%= row[:status] %>
                </span>
              <% end %>
              <%# Module 9: Zero-signatory warning — shown when a non-exempt investor has no
                   tagged signatories. Why: No one can accept the NDA for this investor until
                   the GP tags at least one signatory. %>
              <% if row[:status] != "Exempt" && row[:users].present? && row[:users].none? { |u| u[:nda_tagged] } %>
                <i class="ti ti-alert-triangle text-warning ms-1"
                   data-bs-toggle="tooltip"
                   data-bs-title="No signatories tagged — no one can accept the NDA for this investor"></i>
              <% end %>
            </td>
            <td><%= row[:signed_by]&.full_name || "—" %></td>
            <td><%= row[:signed_at] ? l(row[:signed_at], format: :short) : "—" %></td>
            <td>
              <%# Expandable user detail — shows users under this investor %>
              <% if row[:users].present? %>
                <button class="btn btn-outline-secondary btn-sm"
                        data-bs-toggle="collapse"
                        data-bs-target="#investor_users_<%= row[:investor].id %>"
                        aria-expanded="false">
                  <i class="ti ti-users me-1"></i> <%= row[:users].size %> users
                </button>
              <% end %>
              <%# Changed: Module 8 — Revoke button on Accepted investor rows.
                   Why: GP can revoke an accepted NDA. Shows confirmation dialog with optional reason. %>
              <% if row[:status] == "Accepted" %>
                <button class="btn btn-outline-danger btn-sm ms-1"
                        data-action="click->nda-status#revokeAcceptance"
                        data-investor-id="<%= row[:investor].id %>"
                        data-investor-name="<%= row[:investor].investor_name %>"
                        data-bs-toggle="tooltip"
                        data-bs-title="Revoke this investor's NDA acceptance">
                  <i class="ti ti-shield-x me-1"></i> Revoke
                </button>
              <% end %>
            </td>
          </tr>
          <%# Collapsible user detail rows %>
          <% if row[:users].present? %>
            <tr class="collapse" id="investor_users_<%= row[:investor].id %>">
              <%# Changed: Added bg-light background and left accent border to nested user table.
                   Why: Without visual separation the user rows blended into investor rows. %>
              <td colspan="6" class="p-0 bg-light" style="border-left: 3px solid #f0ad4e;">
                <table class="table table-sm mb-0 ms-4 bg-light" style="width: calc(100% - 2rem);">
                  <thead class="table-light">
                    <tr>
                      <th>User Name</th>
                      <th>Email</th>
                      <th>User Status</th>
                      <th>Signatory</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% row[:users].each do |user_row| %>
                      <tr data-user-id="<%= user_row[:user].id %>">
                        <td><%= user_row[:user].full_name %></td>
                        <td><%= user_row[:user].email %></td>
                        <td>
                          <% if user_row[:status] == "Signer" %>
                            <span class="badge bg-primary-subtle text-primary"><%= user_row[:status] %></span>
                          <% else %>
                            <%= user_row[:status] %>
                          <% end %>
                        </td>
                        <%# Changed: Signatory badge with Tag/Untag button.
                             Why: Per-NDA signatory designation (nda_signatories table). %>
                        <td>
                          <% if user_row[:nda_tagged] %>
                            <span class="badge bg-secondary-subtle text-secondary me-1">Signatory</span>
                            <% signatory = NdaSignatory.find_by(nda_config_id: nda_config.id, user_id: user_row[:user].id) %>
                            <button class="btn btn-outline-secondary btn-sm"
                                    data-action="click->nda-status#untagSignatory"
                                    data-signatory-id="<%= signatory&.id %>"
                                    data-user-name="<%= user_row[:user].full_name %>">
                              <i class="ti ti-tag-off me-1"></i> Untag
                            </button>
                          <% else %>
                            <button class="btn btn-outline-secondary btn-sm"
                                    data-action="click->nda-status#tagSignatory"
                                    data-user-id="<%= user_row[:user].id %>"
                                    data-user-name="<%= user_row[:user].full_name %>">
                              <i class="ti ti-tag me-1"></i> Tag
                            </button>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
