<%# NDA Blocked Page (Module 9) — shown to non-signatory LP users when the NDA has not %>
<%# yet been accepted for their investor. Only designated signatories can accept/decline. %>
<%# No PDF iframe, no accept/decline buttons — dead-end page with a message and contact info. %>
<%# Wrapped in documents_frame turbo-frame so it renders inside the right pane %>
<%# when navigated via the folder tree (Turbo Frame request). %>

<%= turbo_frame_tag "documents_frame" do %>
<div class="px-3">

    <%# ① Logo and ② Back to Data Rooms %>
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <% logo = @nda_config.entity&.logo&.url || "/img/logo_big.png" %>
        <%= image_tag(logo, class: "img-fluid", style: "max-height: 48px;", alt: @nda_config.entity&.name) %>
      </div>
      <%= link_to "Back to Data Rooms", data_rooms_folders_path, class: "btn btn-outline-secondary btn-sm" %>
    </div>

    <%# ③ Title %>
    <h3 class="mb-2">Non-Disclosure Agreement</h3>

    <%# ④ Entity and folder context %>
    <p class="text-muted mb-4">
      <strong><%= @nda_config.entity&.name %></strong>
      <% if @folder %>
        &nbsp;|&nbsp; Folder: <strong><%= @folder.name %></strong>
      <% end %>
    </p>

    <%# ⑤ Signatory-gating blocked message %>
    <div class="alert alert-info mb-4">
      <i class="ti ti-lock me-1"></i>
      NDA acceptance is pending. A designated signatory for your organisation must accept the NDA before you can access this folder.
    </div>

    <%# ⑥ Contact email %>
    <% if @nda_config.contact_email.present? %>
      <p class="text-muted">
        Questions? Contact: <%= mail_to @nda_config.contact_email %>
      </p>
    <% end %>

    <%# ⑦ Back to Data Rooms %>
    <div class="mt-4">
      <%= link_to "Back to Data Rooms", data_rooms_folders_path, class: "btn btn-outline-secondary" %>
    </div>

</div>
<% end %>
