<%
  own_folder = belongs_to_entity_id?(current_user, @folder.entity_id)
  # Ancestors in path order (ancestry doesn't return them ordered); the firm's "/" shows the firm name
  ancestors = @folder.ancestors.index_by(&:id).values_at(*@folder.ancestor_ids).compact
  firm_root_name = ->(f) { f.root? && f.name == "/" ? @folder.entity.name : f.name }
%>
<div class="container-fluid mb-0">

  <%# Header: the folder, where it sits, its state, and what you can do with it %>
  <div class="card shadow-sm border-0 mb-3" id="folder_header">
    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h5 class="mb-1 fw-bold"><i class="ti ti-folder text-primary me-1"></i><%= firm_root_name.call(@folder) %></h5>
        <%# Each folder above this one opens its own page; this replaces the Parent / Full Path rows %>
        <% if ancestors.any? %>
          <div class="small text-muted mb-1" id="folder_path">
            <i class="ti ti-folders"></i>
            <% ancestors.each do |part| %>
              <%= link_to firm_root_name.call(part), folder_path(part) %> &rsaquo;
            <% end %>
            <%= firm_root_name.call(@folder) %>
          </div>
        <% end %>
        <% if @folder.private %>
          <span class="badge bg-warning-subtle text-warning"
                data-bs-title="Documents here are not shown to people who only have access to the record this folder belongs to - only to company admins and those given access to the folder or document">
            <i class="ti ti-lock"></i> Private
          </span>
        <% end %>
        <% if @folder.in_data_room? && @folder.nda_required? %>
          <span class="badge bg-info-subtle text-info" data-bs-title="Users must accept the NDA before opening documents here">
            <i class="ti ti-shield-lock"></i> NDA required
          </span>
        <% end %>
        <% if @folder.knowledge_base && @folder.entity.enable_ai_chat %>
          <span class="badge bg-info-subtle text-info" data-bs-title="Users can chat with the documents in this folder">
            <i class="ti ti-message-chatbot"></i> Knowledge base
          </span>
        <% end %>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2" id="folder_actions">
        <%# The firm's top folder is not edited (level 0), as before %>
        <% if @folder.level != 0 && policy(@folder).update? %>
          <%= link_to edit_folder_path(@folder), class: "btn btn-outline-primary",
                      data: { bs_title: "Rename it, change the defaults below, or upload documents into it" } do %>
            <i class="ti ti-edit"></i> Edit
          <% end %>
        <% end %>

        <% if policy(Folder.new(entity_id: current_user.entity_id, parent: @folder)).create? %>
          <%= link_to new_folder_path("folder[entity_id]": current_user.entity_id, "folder[parent_id]": @folder.id),
                      class: "btn btn-outline-primary" do %>
            <i class="ti ti-folder-plus"></i> New Sub Folder
          <% end %>
        <% end %>

        <% if policy(@folder).download? %>
          <%= button_to download_folder_path(id: @folder.id, back_to: request.original_url), method: :get,
                        class: "btn btn-outline-primary", form_class: "deleteButton",
                        data: { action: "click->confirm#popup", method: :get,
                                msg: "This will create a zipfile of the documents and email you a link to download the zipfile. This will take a few minutes, please be patient. Proceed?",
                                bs_title: "Emails you a link to a ZIP of this folder's documents" } do %>
            <i class="ti ti-download"></i> Download Folder
          <% end %>
        <% end %>

        <% if policy(@folder).destroy? %>
          <%= button_to @folder, method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton",
                        data: { action: "click->confirm#popup", turbo: false } do %>
            <i class="ti ti-trash"></i> <%= t_common(:delete) %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="row">
    <%# Details: label-over-value, as on the document page %>
    <div class="<%= own_folder ? "col-lg-8" : "col-lg-12" %>">
      <div class="card shadow-sm border-0 mb-4" id="folder_details_card">
        <div class="card-header border-bottom py-3">
          <h5 class="mb-0 fw-bold"><i class="ti ti-info-circle me-2 text-primary"></i>Details</h5>
        </div>
        <div class="card-body">
          <div class="row g-4">
            <% if @folder.owner %>
              <div class="col-md-6">
                <label class="text-muted text-uppercase fw-bold fs-1 mb-1">Belongs To</label>
                <div class="fs-4 fw-medium"><%= link_to "#{@folder.owner_type.titleize} - #{@folder.owner}", @folder.owner %></div>
              </div>
            <% end %>

            <div class="col-md-6">
              <label class="text-muted text-uppercase fw-bold fs-1 mb-1">Sub-folders</label>
              <div class="fs-4 fw-medium">
                <%# One COUNT on folders (ancestry), not a load %>
                <%= @folder.children.count %>
                <%= link_to documents_path(selected_folder_id: @folder.id), class: "btn btn-sm btn-outline-primary ms-2",
                            data: { bs_title: "Open the documents page with this folder picked and expanded" } do %>
                  <i class="ti ti-files"></i> Open in documents
                <% end %>
              </div>
            </div>

            <div class="col-md-6">
              <label class="text-muted text-uppercase fw-bold fs-1 mb-1">Created</label>
              <div class="fs-4 fw-medium"><%= l @folder.created_at.to_date %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% if own_folder %>
    <%# The folder's defaults, saying what they are for: Document#setup_folder_defaults copies them into
        each new document uploaded here %>
    <div class="col-lg-4">
      <% defaults = [
            ["Download", @folder.download, "Users with access can download a PDF copy"],
            ["Print", @folder.printing, "Users can print it from the viewer"],
            ["Original format", @folder.orignal, "The file exactly as uploaded - no PDF conversion or watermark"]
          ]
          defaults << ["Knowledge base", @folder.knowledge_base, "Users can chat with the documents in this folder"] if @folder.entity.enable_ai_chat %>
      <div class="card shadow-sm border-0 mb-4" id="folder_defaults_card">
        <div class="card-header border-bottom py-3">
          <h5 class="mb-0 fw-bold"><i class="ti ti-adjustments me-2 text-primary"></i>New documents start with</h5>
        </div>
        <p class="text-muted small px-4 pt-3 mb-0">Copied into each document uploaded here; change them per document afterwards.</p>
        <ul class="list-group list-group-flush">
          <% defaults.each do |label, on, help| %>
            <li class="list-group-item d-flex justify-content-between align-items-center px-4">
              <span><%= label %> <i class="ti ti-info-circle text-muted" data-bs-title="<%= help %>"></i></span>
              <% if on %>
                <span class="badge bg-success-subtle text-success">Yes</span>
              <% else %>
                <span class="badge bg-secondary-subtle text-secondary">No</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <% end %>
  </div>
</div>

<%= render "folders/folder_details" , folder: @folder %>
