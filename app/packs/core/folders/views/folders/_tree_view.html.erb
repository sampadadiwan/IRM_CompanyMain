<%  ul_class ||= ""
        widget_id ||= nil
        documents_as_tags ||= nil
        show_action_buttons = if show_action_buttons.present?
                                show_action_buttons
                            elsif params[:show_action_buttons].present?
                                params[:show_action_buttons].to_s != "false" # default to true if not present
                            else
                                true # default to true if not present in params
                            end
    %>
    <% folders.each do |folder, children| %>
        <ul id="<%=folder.id%>" class="<%= ul_class %>">

        <li id="folder_<%=folder.id%>" >
            <span class="caret">
                <%= link_to folder.name, folder_documents_path(folder_id: folder.id, entity_id: params[:entity_id], parent_folder_id: params[:parent_folder_id], no_folders: true, widget_id: widget_id, documents_as_tags: documents_as_tags, show_action_buttons: show_action_buttons),
                      class: ["truncate", (folder.id.to_s == params[:folder_id].to_s ? "selected" : nil)].compact.join(" "),
                      data: { folder_id: folder.id } %>
            </span>
            <%= render "/folders/tree_view", folders: children, ul_class: "nested", widget_id: widget_id, documents_as_tags: documents_as_tags, show_action_buttons: show_action_buttons if children.present? %>
        </li>

        </ul>
    <% end %>



