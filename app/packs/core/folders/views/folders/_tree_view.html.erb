    <%
        ul_class ||= ""
        widget_id ||= nil
        documents_as_tags ||= nil
        show_action_buttons = if show_action_buttons.present?
                                show_action_buttons
                            elsif params[:show_action_buttons].present?
                                params[:show_action_buttons].to_s != "false" # default to true if not present
                            else
                                true # default to true if not present in params
                            end
        # If virtual_root is provided, wrap the folders under it
        virtual_root ||= nil
        folder_url_method ||= :folder_documents_path
        use_entity_name_for_root ||= false
    %>
    <% if virtual_root %>
        <ul class="<%= ul_class %>">
            <li>
                <span class="caret">
                    <a href="#" class="truncate"><%= virtual_root %></a>
                </span>
                <ul class="nested active">
                    <% folders.each do |folder, children| %>
                        <%= render "/folders/tree_view", 
                                   folders: { folder => children }, 
                                   ul_class: "", 
                                   widget_id: widget_id, 
                                   documents_as_tags: documents_as_tags, 
                                   show_action_buttons: show_action_buttons, 
                                   folder_url_method: folder_url_method, 
                                   use_entity_name_for_root: use_entity_name_for_root,
                                   virtual_root: nil %>
                    <% end %>
                </ul>
            </li>
        </ul>
    <% else %>
        <% folders.each do |folder, children| %>
            <ul id="<%=folder.id%>" class="<%= ul_class %>">

            <li id="folder_<%=folder.id%>" >
                <span class="caret" id="folder_caret_<%=folder.id%>">
                    <%
                        folder_name = folder.name
                        folder_name = folder.entity.name if use_entity_name_for_root && folder.root?
                    %>
                    <%= link_to folder_name, send(folder_url_method, folder_id: folder.id, entity_id: params[:entity_id], parent_folder_id: params[:parent_folder_id], no_folders: true, widget_id: widget_id, documents_as_tags: documents_as_tags, show_action_buttons: show_action_buttons),
                          class: ["truncate", (folder.id.to_s == params[:folder_id].to_s ? "selected" : nil)].compact.join(" "),
                          data: { folder_id: folder.id } %>
                    <%# Changed: Added NDA lock icon + id="folder_caret_{id}" on the caret span above.
                        Why: GP employees need a visual indicator for NDA-protected folders. The id
                        enables Turbo Stream to replace just the caret when NDA config changes,
                        without re-rendering the full tree (preserves expand/collapse state). %>
                    <% if folder.nda_required? && current_user.curr_role_employee? %>
                      <i class="ti ti-lock text-warning ms-1" style="font-size: 0.75rem;"
                         data-bs-toggle="tooltip" title="NDA required"></i>
                    <% end %>
                </span>
                <%= render "/folders/tree_view", folders: children, ul_class: "nested", widget_id: widget_id, documents_as_tags: documents_as_tags, show_action_buttons: show_action_buttons, folder_url_method: folder_url_method, use_entity_name_for_root: use_entity_name_for_root, virtual_root: nil if children.present? %>
            </li>

            </ul>
        <% end %>
    <% end %>



