<div class="form_card card shadow mb-4 <%=@css_class%>" data-controller=<%=@controller%>>
  <div class="card-header py-3">
      <h6 class="m-0 font-weight-bold text-primary <%=@header_css_class%>">
          <%= @title.html_safe %>
      </h6>
      <% if @note.present? %>
        <small class="text-muted d-block mt-1"><%= @note.html_safe %></small>
      <% end %>
  </div>
  <div class="card-body">
    <%= content %>
  </div>
</div>
