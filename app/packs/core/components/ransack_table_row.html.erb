<% @columns.each do |column_name, attribute| %>
    <% attribute, css_class = attribute.split(";").map(&:strip) %>
    <%# A column whose data type is Boolean carries the boolean-col marker (GridViewPreference#key_with_alignment) %>
    <% boolean_column = css_class.to_s.split.include?(GridViewPreference::BOOLEAN_CSS) %>
    <td class="<%= css_class %>">
      <% value = if attribute.start_with?("custom_fields.")
                   @model.json_fields[attribute.gsub("custom_fields.", "")]
                 else
                   # C4 (OWASP 2026-11): the key is stored by users, so read it as an attribute path, never send
                   SafeAttributePath.read(@model, attribute, context: "grid column")
                 end %>
      <% bool = boolean_value(value) if boolean_column %>
      <%# Boolean columns (marked Boolean, or real true/false values) show a Yes/No badge, not true/false %>
      <% if !bool.nil? || value == true || value == false %>
        <%= render DisplayBooleanComponent.new(bool: bool.nil? ? value : bool) %>
      <% elsif attribute.start_with?("custom_fields.") %>
        <%= value %>
      <% elsif value.is_a?(Date) %>
        <%= l(value) %>
      <% elsif value.is_a?(Money) %>
        <%= money_to_currency value, params %>
      <% else %>
        <%= value %>
      <% end %>
    </td>
<% end %>
