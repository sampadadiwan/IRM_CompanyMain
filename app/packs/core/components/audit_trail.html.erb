<% if @graphical %>
  <%= render "/layouts/graphical_timeline", model: @model, only_keys: @only_keys %>
<% else %>
  <% dom_uid = SecureRandom.hex(4) %>
  <div class="card shadow mb-4" data-controller="tooltip">
    <div class="card-header py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <h6 class="m-0 font-weight-bold text-primary"><%= @title ? @title : "Audit Trail" %></h6>
        <%= helpers.user_guide_icon_for('audits', tooltip: 'Audit Trail Guide') %>
      </div>
      <% if @allow_toggle %>
        <a class="btn btn-outline-primary show_details_link" data-bs-toggle="collapse" href=".<%=@css_class%>" title="Show/hide this record's audit trail"><i class="fa-solid fa-caret-down"></i></a>
      <% end %>
    </div>
    <div class="card-body collapse <%=@state%> <%=@css_class%> p-0">
      <%= render "layouts/audit_tabs_nav", dom_uid: dom_uid %>

      <%
        timeline_rows = own_and_associated_audits.filter_map do |audit|
          # Some associations may not have a path, so we need to check if the path is available
          linkable = nil
          linkable = Rails.application.routes.url_helpers.respond_to?("#{audit.auditable.model_name.singular_route_key}_path") if audit.associated && audit.auditable

          # Only filter own changes if only_keys is present
          audited_changes = filtered_changes(audit)

          if audit.associated && linkable
            # Just a link to the association that was changed; we do not capture the fields
            { audit: audit, changes: {} }
          elsif audited_changes.present?
            { audit: audit, changes: audited_changes }
          end
        end
      %>

      <div class="tab-content">
        <%= render "layouts/audit_timeline_tab",
                   rows: timeline_rows, pagy: nil, download_path: nil,
                   container_id: "audit-timeline-#{dom_uid}", container_classes: "tab-pane fade show active" %>
        <%= render "layouts/audit_field_history_tab",
                   field_history: field_history,
                   container_id: "audit-field-history-#{dom_uid}", container_classes: "tab-pane fade p-3" %>
      </div>
    </div>
  </div>
<% end %>
