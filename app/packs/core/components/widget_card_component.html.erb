<!-- app/components/widget_card_component.html.erb -->
<%
  wrapper_options = (@html_options || {}).dup
  wrapper_options[:class] = "col d-flex align-items-stretch dashboard-widget #{wrapper_options[:class]}"

  # Always add the visibility controller
  wrapper_options[:data] ||= {}
  wrapper_options[:data][:controller] = "#{wrapper_options[:data][:controller]} turbo-frame-visibility".strip
  wrapper_options[:data][:action] = "#{wrapper_options[:data][:action]} turbo:frame-load->turbo-frame-visibility#markAsLoaded".strip
  wrapper_options[:data][:widget_id] = @widget.id
%>
<div <%= tag.attributes(wrapper_options) %>>
  <div class="card w-100">
    <% if @widget.display_name || @widget.display_tag %>
    <div class="card-header">
      <h5 class="card-title"><%= @widget.widget_name if @widget.display_name %> <%= @widget.tags if @widget.display_tag %></h5>
    </div>
    <% end %>
    <div class="card-body">
      <!-- `content` is whatever the caller provides as a block -->
      <%= content %>
    </div>
  </div>
</div>
