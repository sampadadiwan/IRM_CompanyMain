<!-- app/components/fund_card_component/fund_card_component.html.erb -->
<%# d-flex + flex-fill: every card in a row stretches to the tallest one, so a value that wraps
    doesn't leave its neighbours shorter; the colour bar is pushed to the bottom (mt-auto) %>
<div class="<%= @css_class.present? ? @css_class : 'col-sm col-md' %> d-flex" <%= "style=\"#{@css_style}\"".html_safe if @css_style.present? %>>
  <% if @path %>
    <a href="<%= @path %>" class="d-flex flex-fill">
  <% end %>
    <div class="card p-2 m-2 border shadow-sm rounded-3 flex-fill">
      <div class="card-body p-3 d-flex flex-column">
        <div class="d-flex align-items-center mb-3">
          <div>
            <% if @raw_amount %>
              <div data-controller="counters"
                   data-counters-value-value="<%= @raw_amount %>"
                   data-counters-formatted-value-value="<%= @amount %>">
                <h3 class="fs-<%=@fs_size%>" data-counters-target="output">0</h3>
              </div>
            <% else %>
              <h2 class="fs-<%=@fs_size%>"><%= @amount %></h2>
            <% end %>
            <span class="card-subtitle mb-1 text-muted"><%= @subtitle %></span>
          </div>
          <% if @text_info.present? %>
            <div class="ms-auto">
              <span class="text-<%= @progress_bar_color %> display-6"><i class="ti ti-<%= @text_info %>"></i></span>
            </div>
          <% end %>
        </div>
        <div class="progress-bar text-bg-<%= @progress_bar_color %> mt-auto" role="progressbar" style="width: 100%; height: 6px;"></div>
      </div>
    </div>
  <% if @path %>
    </a>
  <% end %>
</div>
