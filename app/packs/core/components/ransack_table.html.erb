<%# ① The columns icon floats on the table's corner (openspec/changes/grid-columns-inline-settings — D1) %>
<div class="grid-columns-host" data-controller="grid-columns">
<%= render partial: "grid_columns/button", locals: { header: @ransack_table_header } %>
<div class="table-responsive">
    <table id="<%= @model.model_name.plural %>" class="table table-bordered dataTable action_table hover <%= @table_css_class %>">
    <%= render @ransack_table_header %>

    <tbody>
        <% @records.each do |record| %>
        <%= render "#{@partial_base_path}/#{@partial_name}",
                    "#{@model.model_name.element}": record.decorate,
                    columns: @ransack_table_header.columns, actions_column: @ransack_table_header.actions_column %>
        <% end %>
    </tbody>
    </table>

    <% if @records.present? && @pagy %>
        <% if @pagy.is_a?(Pagy::Countless)  %>
            <div class="d-flex justify-content-between align-items-center">
                <span>Page <%= @pagy.page %></span>  <%# optional current page label %>
                <%= raw pagy_bootstrap_nav(@pagy, size: 0, anchor_string: %(data-turbo-frame="#{@turbo_frame}" data-remote="true")) %>
            </div>
        <% else %>
            <div class="d-flex justify-content-between align-items-center">
                <%= raw pagy_info(@pagy) %>
                <%= raw pagy_bootstrap_nav(@pagy, anchor_string: %(data-turbo-frame="#{@turbo_frame}" data-remote="true")) %>
            </div>
        <% end %>
    <% end %>
</div>
</div>
