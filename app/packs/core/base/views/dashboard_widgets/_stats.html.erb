<% cache_if(current_user != nil, cache_key("dashboard_widget_stats"), expires_in: 5.day) do %>
  <% dashboard_name_stats = {
      fm_landing_page: { path: dashboard_widgets_path(q: ransack_query_params("dashboard_name", :eq, DashboardWidget::FM_LANDING_PAGE)), subtitle: DashboardWidget::FM_LANDING_PAGE, progress_bar_color: "info", icon: "ti ti-home-2" },
      lp_landing_page: { path: dashboard_widgets_path(q: ransack_query_params("dashboard_name", :eq, DashboardWidget::LP_LANDING_PAGE)), subtitle: DashboardWidget::LP_LANDING_PAGE, progress_bar_color: "primary", icon: "ti ti-users" },
      ops_landing_page: { path: dashboard_widgets_path(q: ransack_query_params("dashboard_name", :eq, DashboardWidget::OPS_LANDING_PAGE)), subtitle: DashboardWidget::OPS_LANDING_PAGE, progress_bar_color: "success", icon: "ti ti-briefcase" },
      fund_dashboard: { path: dashboard_widgets_path(q: ransack_query_params("dashboard_name", :eq, DashboardWidget::FUND_DASHBOARD)), subtitle: DashboardWidget::FUND_DASHBOARD, progress_bar_color: "info", icon: "ti ti-building-bank" },
      ops_dashboard: { path: dashboard_widgets_path(q: ransack_query_params("dashboard_name", :eq, DashboardWidget::OPS_DASHBOARD)), subtitle: DashboardWidget::OPS_DASHBOARD, progress_bar_color: "primary", icon: "ti ti-settings" },
      investor_dashboard: { path: dashboard_widgets_path(q: ransack_query_params("dashboard_name", :eq, DashboardWidget::INVESTOR_DASHBOARD)), subtitle: DashboardWidget::INVESTOR_DASHBOARD, progress_bar_color: "secondary", icon: "ti ti-user-circle" },
      portfolio_company_dashboard: { path: dashboard_widgets_path(q: ransack_query_params("dashboard_name", :eq, DashboardWidget::PORTFOLIO_COMPANY_DASHBOARD)), subtitle: DashboardWidget::PORTFOLIO_COMPANY_DASHBOARD, progress_bar_color: "danger", icon: "ti ti-building" },
      portfolio_dashboard: { path: dashboard_widgets_path(q: ransack_query_params("dashboard_name", :eq, DashboardWidget::PORTFOLIO_DASHBOARD)), subtitle: DashboardWidget::PORTFOLIO_DASHBOARD, progress_bar_color: "success", icon: "ti ti-chart-pie" },
      aggregated_portfolio_dashboard: { path: dashboard_widgets_path(q: ransack_query_params("dashboard_name", :eq, DashboardWidget::AGGREGATED_PORTFOLIO_DASHBOARD)), subtitle: DashboardWidget::AGGREGATED_PORTFOLIO_DASHBOARD, progress_bar_color: "warning", icon: "ti ti-device-analytics" }
    }
  %>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 row-cols-xl-5 g-2 justify-content-center">
    <% dashboard_name_stats.each do |type, data| %>
      <div class="col">
        <a href="<%= data[:path] %>" class="text-decoration-none">
          <div class="card overflow-hidden h-100 shadow-none border mb-0">
            <div class="d-flex flex-row h-100">
              <div class="p-2 bg-<%= data[:progress_bar_color] %>-subtle d-flex align-items-center">
                <h3 class="text-<%= data[:progress_bar_color] %> mb-0 fs-6">
                  <i class="<%= data[:icon] %>"></i>
                </h3>
              </div>
              <div class="p-2 text-truncate">
                <h3 class="text-<%= data[:progress_bar_color] %> mb-0 fs-4">
                  <%= policy_scope(DashboardWidget.for_dashboard(data[:subtitle]).all).count %>
                </h3>
                <span class="text-muted small text-truncate d-block" style="font-size: 0.75rem;" title="<%= data[:subtitle] %>">
                  <%= data[:subtitle] %>
                </span>
              </div>
            </div>
          </div>
        </a>
      </div>
    <% end %>
  </div>
<% end %>
