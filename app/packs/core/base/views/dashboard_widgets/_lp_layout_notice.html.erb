<%#
  Widget settings: invite the fund team to set up an LP layout, or — when an LP layout is open — say which shared
  companies see it, and offer the next actions. Existing alert-info pattern and outline buttons.
  Worked examples H8, E75, E76, E88 — openspec/changes/lp-folio-portfolio-dashboard/business-rules.md
%>
<% entity_id = current_user.entity_id %>
<% lp_layouts = DashboardWidget.lp_layout_names_for(entity_id) %>
<% open_layout = params.dig(:q, :name_eq) %>
<%# E96 — only for fund managers with the fund-portfolios module %>
<% if policy(DashboardWidget.new(entity_id:)).manage_lp_layouts? %>
  <% if lp_layouts.empty? %>
    <%# E75 — no LP layout yet %>
    <div class="alert alert-info d-flex align-items-start gap-2" id="lp_layout_notice">
      <i class="ti ti-info-circle"></i>
      <div class="flex-grow-1">
        Want to share company pages with LPs? Create an LP layout. It's what LPs see, and your internal layouts stay as they are.
        Add "LP, &lt;tag&gt;" layouts later for companies with that tag.
      </div>
      <%= button_to "Set up LP layout", setup_lp_layout_dashboard_widgets_path, class: "btn btn-outline-primary btn-sm" %>
    </div>
  <% elsif DashboardWidget.lp_layout_name?(open_layout) %>
    <%# E76 — the open LP layout: who sees it today %>
    <% shared = Investor.where(entity_id:, category: "Portfolio Company", show_to_lps: true).to_a %>
    <% users = shared.select { |company| LpLayoutResolver.for(company)&.name == open_layout } %>
    <% tags = DashboardWidget.lp_layout_tags(open_layout) %>
    <div class="alert alert-info d-flex align-items-start gap-2" id="lp_layout_notice">
      <i class="ti ti-info-circle"></i>
      <div class="flex-grow-1">
        <% if tags.any? %>
          LPs see this layout for shared companies tagged <%= tags.map(&:titleize).join(", ") %>
          (<%= users.size %> today<%= ": #{users.map(&:investor_name).join(', ')}" if users.any? %>). Other companies use "LP".
        <% else %>
          LPs see this layout for shared companies that no tag-specific LP layout matches (<%= users.size %> today).
        <% end %>
        Only LP-safe widgets can be added. Check it with Preview as LP on any company.
      </div>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "Add widget", new_dashboard_widget_path(dashboard_widget: { dashboard_name: DashboardWidget::PORTFOLIO_COMPANY_DASHBOARD, name: open_layout }),
                    class: "btn btn-outline-primary btn-sm", data: { turbo: false } %>
        <%# E88 — a layout for a company tag, starting as a copy of "LP" %>
        <%= form_with url: new_lp_layout_dashboard_widgets_path, method: :post, class: "d-flex gap-1" do |f| %>
          <%= f.text_field :tag, class: "form-control form-control-sm", placeholder: "Company tag, e.g. FinTech", required: true %>
          <%= f.submit "New LP layout for a tag", class: "btn btn-outline-success btn-sm" %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
