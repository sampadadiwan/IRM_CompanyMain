<%
    uri_params ||= {}
    name ||= "Default"
    show_nav = local_assigns.fetch(:show_nav, true)
    entity_id ||= current_user.entity_id
    dashboard_names ||= []

    admin_settings = JSON.parse(cookies[:adminSettings]) rescue {}
    theme = admin_settings["Theme"] == "dark" ? "bg-dark" : "bg-light"
    owner ||= uri_params[:owner_type].constantize.find(uri_params[:owner_id]) if uri_params[:owner_id].present? && uri_params[:owner_type].present?
    logo ||= nil
    title ||= nil
    header_label ||= nil
    header_value ||= nil
    # LP Company Dashboard: the chosen LP layout, LP widget versions, no Reports menu or layout selector (E54a)
    lp_context ||= nil
    lp = lp_context.present?

    # One lookup serves the page and the menu (H1, H17, H18, E1, E2): the menu is the page's widgets that have Show Menu.
    page_widgets = dashboard_widgets(dashboard_name, entity_id, name:, owner:, lp:)
    menu_widgets = dashboard_menu_widgets(page_widgets).to_a
    # H18, E4 — with no Show Menu widget there is no menu row (so no Reports drop-down or layout selector either);
    # the logo/title heading still shows when a logo is set
    show_menu_row = menu_widgets.any?
%>

<% unless !show_nav || dashboard_name == "Portfolio Dashboard" || !(logo.present? || show_menu_row) %>
<nav class="dashboard-nav sticky-top <%= theme %> shadow-sm d-none d-md-block" style="top:70px; z-index: 1000;">

    <!-- Header row: logo + name on left, label/value on right -->
    <%# Currently only shows if logo is present as otherwise it doesnt look good %>
    <% if logo.present? %>
        <div class="d-flex align-items-center justify-content-between px-3 py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="dashboard-nav-logo rounded-circle overflow-hidden d-flex align-items-center justify-content-center" style="width:70px; height:70px; flex-shrink:0; border: 2px solid var(--bs-primary);">
                    <%= image_tag logo.url, style: "width:100%; height:100%; object-fit:contain;" %>
                </div>
                <% if title.present? %>
                    <span class="fw-semibold fs-8"><%= title %></span>
                <% end %>
            </div>

            <% if header_label.present? && header_value.present? %>
                <div class="text-start">
                    <% if header_label.present? %>
                        <div class=""> <%= header_label %></div>
                    <% end %>
                    <% if header_value.present? %>
                        <div class="text-primary fs-5"><%= header_value %></div>
                    <% end %>
                </div>
            <% end %>
        </div>
    <% end %>

    <!-- Nav pills row -->
    <% if show_menu_row %>
    <ul class="nav nav-pills flex-nowrap align-items-center <%= theme %> mb-4" data-controller="nav-overflow" data-nav-overflow-target="nav">
        <!-- Add a link to the dashboard widgets -->
        <% menu_widgets.each_with_index do |(name, dashboard_widget), index| %>
            <li class="nav-item" data-nav-overflow-target="item">
                <% label = dashboard_widget.tags.presence || dashboard_widget.widget_name %>
                <a class="nav-link py-2 text-center" href="#<%= "#{dashboard_widget.widget_name.parameterize.underscore}_#{dashboard_widget.position}" %>" data-turbo=false title="<%= label %>">
                    <%= label %>
                </a>
            </li>
        <% end %>

        <li class="nav-item dropdown d-none" data-nav-overflow-target="more">
            <a class="nav-link py-2 dropdown-toggle text-center" href="#" id="moreWidgetsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"">
                More
            </a>
            <ul class="dropdown-menu shadow" aria-labelledby="moreWidgetsDropdown" data-nav-overflow-target="moreDropdown">
                <% menu_widgets.each_with_index do |(name, dashboard_widget), index| %>
                    <li data-index="<%= index %>">
                        <a class="dropdown-item" href="#<%= "#{dashboard_widget.widget_name.parameterize.underscore}_#{dashboard_widget.position}" %>" data-turbo=false>
                            <% label = dashboard_widget.tags.presence || dashboard_widget.widget_name %>
                            <%= label %>
                        </a>
                    </li>
                <% end %>

                <!-- Move Reports dropdown items here if overflow exists -->
                <% reports = lp ? Report.none : Report.where("tag_list LIKE ?", "%#{dashboard_name}%") %>
                <% if reports.any? %>
                    <li class="d-none" data-nav-overflow-target="moreReportsDivider"><hr class="dropdown-divider"></li>
                    <li class="dropdown-header d-none" data-nav-overflow-target="moreReportsHeader">Reports</li>
                    <% reports.each do |report| %>
                        <li class="report-item d-none"><%= link_to report.name, report_url(dashboard_name, report), class: "dropdown-item" %></li>
                    <% end %>
                <% end %>
            </ul>
        </li>

        <!-- Standalone dropdown for reports if no overflow exists -->
        <% reports = lp ? Report.none : Report.where("tag_list LIKE ?", "%#{dashboard_name}%") %>
        <% if reports.any? %>
            <li class="nav-item dropdown" data-nav-overflow-target="reportsDropdown">
                <a class="nav-link px-3 py-2  dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Reports
                </a>
                <ul class="dropdown-menu shadow" aria-labelledby="navbarDropdown">
                    <% reports.each do |report| %>
                        <li><%= link_to report.name, report_url(dashboard_name, report), class: "dropdown-item" %></li>
                    <% end %>
                </ul>
            </li>
        <% end %>

        <%# E54a — LPs never get the layout selector %>
        <% unless lp %>
        <%= render "/dashboard_widgets/dashboard_selector",
              dashboard_names: dashboard_names,
              current_name: name,
              dashboard_name: dashboard_name,
              frame_id: "#{dashboard_name.parameterize(separator: '_')}_frame" %>
        <% end %>
    </ul>
    <% end %>
</nav>
<% end %>

<%
    # Widget settings in place (openspec/changes/dashboard-widget-inline-settings): the layout name is captured
    # here because the loop below reuses `name` for each widget's key
    layout_name = name
    settings_allowed = widget_settings_allowed?(dashboard_name, layout_name, entity_id:, lp:)
%>
<div class="row mt-4" <%= 'data-controller=widget-settings' if settings_allowed %>>

    <%# ② One settings popup per page %>
    <%= render "dashboard_widgets/settings_modal" if settings_allowed %>

    <% page_widgets.each do |name, dashboard_widget| %>
        <% widget_key = widget_frame_key(dashboard_widget) %>
        <%# ⑥ One-widget reload (D4): with ?only_widget=<key> only that widget is drawn, into its frame %>
        <% next if params[:only_widget].present? && params[:only_widget] != widget_key %>
        <div id="<%= widget_key %>" class="dashboard-widget-container position-relative <%= dashboard_widget.widget_size %>">
            <%# target _top: links and forms inside a widget still open full pages %>
            <%= turbo_frame_tag "dashboard_widget_#{widget_key}", target: "_top", class: "dashboard-widget-frame" do %>
                <%= render (lp ? lp_widget_partial(dashboard_widget) : dashboard_widget.path), widget: dashboard_widget, name: dashboard_widget.widget_name, dashboard_widget:, widget_size: dashboard_widget.widget_size, args: dashboard_widget.metadata_args, uri_params:, owner:, entity_id:, lp_context:  %>
            <% end %>
            <%# ① The widget's settings icon %>
            <%= render "dashboard_widgets/settings_button", widget: dashboard_widget, dashboard_name:, layout: layout_name if settings_allowed %>
        </div>
    <% end %>

    <% if params[:debug].present? %>
        <%= dashboard_name %>
        <%= entity_id %>
        <%= name %>
    <% end %>

</div>
