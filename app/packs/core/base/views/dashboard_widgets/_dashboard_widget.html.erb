
<tr id="<%= dom_id dashboard_widget %>">
  <td>
    <%= dashboard_widget.dashboard_name %>
  </td>
  <td>
    <%= dashboard_widget.name %>
  </td>
  <td>
    <%= dashboard_widget.owner %>
  </td>
  <td>
    <%= dashboard_widget.widget_name %>
  </td>
  <td>
    <%= dashboard_widget.tags %>
  </td>
  <td>
    <%= dashboard_widget.size %>
  </td>
  <td>
    <%= dashboard_widget.position %>
  </td>
  <td>
    <% dashboard_widget.metadata_args.each do |key, value| %>
      <div class="mb-1">
        <span class="badge bg-light text-dark border">
          <span class="text-muted"><%= key %>:</span>
          <span class="fw-bold"><%= value.is_a?(Array) ? value.join(", ") : value %></span>
        </span>
      </div>
    <% end %>
  </td>
  <td>
    <%= display_boolean dashboard_widget.enabled %>
  </td>
  <td>
    <%= link_to  t_common(:show), dashboard_widget , {class: "btn btn-outline-primary"}%>
    <%= link_to  t_common(:edit), edit_dashboard_widget_path(dashboard_widget), {class: "btn btn-outline-success"}%>
  </td>
</tr>
