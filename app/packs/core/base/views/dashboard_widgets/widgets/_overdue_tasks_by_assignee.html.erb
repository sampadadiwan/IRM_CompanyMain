<%# Overdue Tasks by Assignee — open overdue tasks per person (H22, E59, E60, X11).
    openspec/changes/dashboard-insight-widgets/business-rules.md#7. Chart styling copied from
    capital_calls/helpers/capital_call_dashboard_helper.rb (chartkick + chart_theme_color). %>
<% return unless insight_widget_visible? %>
<%
  args ||= {}
  # People to show before the rest are grouped as Others (E59 — default 10)
  top_n = insight_int_arg(args, :top_n, 10)
  rows = overdue_tasks_by_assignee(top_n)
%>
<%= render(WidgetCardComponent.new(widget: widget, args: args, widget_size: widget.widget_size)) do %>
  <div data-insight-widget="overdue-tasks-by-assignee">
    <% if rows.empty? %>
      <%# E60 — nothing overdue %>
      <%= insight_empty_state("No overdue tasks.") %>
    <% else %>
      <%= insight_help_line("Open tasks past their due date, per person, most first. People beyond the top #{top_n} are grouped as Others.") %>
      <%= bar_chart rows, id: "overdue_tasks_by_assignee_#{widget.id || widget.position}", height: "#{[rows.size * 36, 160].max}px",
                    library: { plotOptions: { bar: { dataLabels: { enabled: true } } }, **chart_theme_color } %>
      <div class="table-responsive">
      <table class="table table-bordered dataTable mb-0">
        <thead>
          <tr>
            <%= insight_th("Assignee", "Who the task is assigned to; Unassigned when nobody is") %>
            <%= insight_th("Overdue tasks", "Open tasks whose due date was before today", right: true) %>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |label, count| %>
            <tr data-insight-row="<%= label %>">
              <td><%= label %></td>
              <td class="text-end" data-insight-value><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
      <div class="mt-2">
        <%= link_to "View overdue tasks", overdue_tasks_path, class: "btn btn-sm btn-outline-primary", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  </div>
<% end %>
