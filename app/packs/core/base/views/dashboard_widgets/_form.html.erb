<%= render FormCard.new(title: "Dashboard Widgets : #{dashboard_widget.presence || 'New'}") do %>
  <%= form_with(model: dashboard_widget, validate: true) do |form| %>

    <% if dashboard_widget.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(dashboard_widget.errors.count, "error") %> prohibited this dashboard_widget from being saved:</h2>
        <ul>
          <% dashboard_widget.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group mb-3">
          <%= form.label :dashboard_name, class: "form-label fw-bold" %>
          <%= form.select :dashboard_name, DashboardWidget.dashboard_names, {}, class: "form-select", id: "dashboard_name"  %>
        </div>

        <div class="form-group mb-3">
          <%= form.label :name, "Instance Name", class: "form-label fw-bold" %>
          <%= form.text_field :name, class: "form-control", placeholder: "e.g. Q3 Performance Summary"  %>
          <%# E52 — Portfolio Company Dashboard layouts whose name includes the tag LP are shown to LPs %>
          <small class="form-text text-muted">On the Portfolio Company Dashboard, a layout whose name includes the tag "LP" (e.g. "LP" or "LP, FinTech") is what LPs see on shared company pages.</small>
          <% if dashboard_widget.lp_layout? %>
            <small class="form-text text-info d-block" id="lp_layout_type_help">LP layout: only widgets that are safe to show LPs are listed.</small>
          <% end %>
        </div>

        <div class="form-group mb-3"
              data-controller="dashboard-widgets"
              data-dashboard-widgets-url-value="<%= metadata_help_dashboard_widgets_path %>"
              data-dashboard-widgets-param-value="widget_name">
          <%= form.label :widget_name, "Widget Type", class: "form-label fw-bold" %>
          <%= form.select :widget_name, {}, {prompt: 'Select Widget Type'}, class: "form-select", id: :widget_name  %>
          <% if dashboard_widget.lp_layout? %>
            <%# E77 — how Embed Document picks the company's document on LP pages %>
            <small class="form-text text-muted d-block" id="lp_embed_document_help">Embed Document: shows the company's latest document with this exact name, e.g. "Founder Video". Upload it to each company you share.</small>
          <% end %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group mb-3">
          <%= form.label :size, class: "form-label fw-bold" %>
          <%= form.select :size, ["XL", "Large", "Medium", "Small", "XS"], {}, class: "form-select"  %>
        </div>

        <div class="form-group mb-3">
          <%= form.label :position, class: "form-label fw-bold" %>
          <%= form.number_field :position, class: "form-control"  %>
        </div>

        <div class="form-group mb-3">
          <%= form.label :tag_list, "Tag List", class: "form-label fw-bold" %>
          <%= form.text_field :tag_list, class: "form-control", placeholder: "Comma separated..."  %>
          <% if dashboard_widget.lp_layout? %>
            <%# E94 — in an LP layout the tags narrow a widget to companies with those tags %>
            <small class="form-text text-muted" id="lp_layout_tags_help">Optional. Show this widget only for companies with one of these tags. Leave empty for every company using this layout.</small>
          <% else %>
            <small class="form-text text-muted">Comma-separated tags to filter this widget. If set, the widget only appears if the dashboard owner (e.g. Fund, Investor) has matching tags. Leave blank to always show.</small>
          <% end %>
        </div>

        <div class="form-group mb-3">
          <%= form.label :tags, "Tags", class: "form-label fw-bold" %>
          <%= form.text_field :tags, class: "form-control", placeholder: "Comma separated..."  %>
          <small class="form-text text-muted">Display label or suffix for this widget instance. Used to distinguish multiple widgets of the same type. (Required)</small>
        </div>

      </div>
    </div>

    <%= form.hidden_field :owner_id %>
    <%= form.hidden_field :owner_type %>

    <!-- This is a hidden field to store the widget options in JSON format -->
    <%# E52 — an LP layout offers only the LP-safe widget types %>
    <%= hidden_field_tag "widget_options_json", DashboardWidget.widget_select_for(dashboard_widget.name, current_user.entity).to_json, id: "widget_options_json" %>
    <!-- This is a hidden field to store the selected widget name, used in dashboard_widgets_controller.js -->
    <%= hidden_field_tag "selected_widget_name", dashboard_widget.widget_name, id: "selected_widget_name" %>

    <div data-controller="metadata-form" class="mt-4 pt-4 border-top">
      <div class="d-flex align-items-center mb-3">
        <h5 class="mb-0 text-primary"><i class="fas fa-sliders-h me-2"></i>Widget Configuration</h5>
        <hr class="flex-grow-1 ms-3 opacity-25">
      </div>

      <div id="dynamic_metadata_fields" class="mb-4">
        <% if dashboard_widget.widget_name.present? %>
          <%= render "dashboard_widgets/metadata_fields", dashboard_widget: dashboard_widget %>
        <% else %>
          <div class="text-center text-muted py-3 small bg-light rounded">Please select a Widget Type above to configure parameters.</div>
        <% end %>
      </div>

      <div class="mb-4">
        <a class="text-muted small text-decoration-none" data-bs-toggle="collapse" href="#rawMetadataCollapse" role="button" aria-expanded="false" aria-controls="rawMetadataCollapse">
          <i class="fas fa-code me-1"></i> Advanced: Raw Metadata
        </a>
        <div class="collapse mt-2" id="rawMetadataCollapse">
          <%= form.text_field :metadata, class: "form-control form-control-sm bg-light font-monospace", data: { metadata_form_target: "metadataInput" }, readonly: true  %>
        </div>
      </div>
    </div>

    <div class="border-top pt-4">
      <h5 class="mb-3"><i class="fas fa-eye me-2"></i>Display Settings</h5>
      <div class="row">
        <div class="col-md-3">
          <div class="form-check">
            <%= form.check_box :enabled, class: "form-check-input"  %>
            <%= form.label :enabled, class: "form-check-label" %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-check">
            <%= form.check_box :display_name, class: "form-check-input"  %>
            <%= form.label :display_name, "Show Title", class: "form-check-label" %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-check">
            <%= form.check_box :display_tag, class: "form-check-input"  %>
            <%= form.label :display_tag, "Show Tags", class: "form-check-label" %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-check">
            <%= form.check_box :show_menu, class: "form-check-input"  %>
            <%= form.label :show_menu, "Show Menu", class: "form-check-label" %>
          </div>
        </div>
      </div>
    </div>

    <div class="form-group mt-5 text-end border-top pt-3">
      <%= link_to "Cancel", dashboard_widgets_path, class: "btn btn-link text-muted me-2" %>
      <%= form.submit t_common(:save), {class: "btn btn-primary px-4"}%>
    </div>

  <% end %>
<% end %>