<div class="card">
  <div class="card-body p-4">
    <div class="ai-md" data-controller="mermaid" id="guide-content">
      <%= @html_content %>
    </div>
  </div>
</div>

<script>
(function() {
  function scrollToHash(hash) {
    if (!hash || hash === '#') return;
    var el = document.getElementById(hash.replace(/^#/, ''));
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Intercept same-page anchor clicks inside the rendered guide so Turbo never
  // sees them — the browser would do this natively but Turbo can swallow it.
  var content = document.getElementById('guide-content');
  if (content) {
    content.addEventListener('click', function(e) {
      var a = e.target.closest('a[href^="#"]');
      if (!a) return;
      e.preventDefault();
      var href = a.getAttribute('href');
      history.pushState(null, '', href);
      scrollToHash(href);
    });
  }

  // Scroll to hash when Turbo finishes a page visit (e.g. navigating here
  // via a link that already includes a fragment).
  document.addEventListener('turbo:load', function() {
    scrollToHash(window.location.hash);
  });
})();
</script>
