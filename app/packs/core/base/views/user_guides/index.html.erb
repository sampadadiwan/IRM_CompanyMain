<header class="page-hero hero-tinted tint-cream" style="padding-bottom:64px">
  <div class="wrap-wide">
    <div class="hero-panel">
      <nav class="crumbs" aria-label="Breadcrumb">
        <%= link_to "Home", root_path %><span>/</span><%= t('top_menus.user_guides') %>
      </nav>
      <span class="chip-label"><%= t('top_menus.user_guides') %></span>
      <h1>Everything you need to <em>run CapHive.</em></h1>
      <p class="lede"><%= @guides.count %> guides, grouped by area — search to jump straight to one.
        Looking for a quick answer? <%= link_to "Browse all FAQs", faqs_path %>.</p>
    </div>
  </div>
</header>

<div data-controller="list-filter">
  <div class="wrap-wide">
    <div class="hero-panel" style="padding:0">
      <div class="guide-search">
        <div class="guide-search-box">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M11.5 11.5L15 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input type="text" class="guide-search-input" placeholder="Search guides…"
                 data-action="input->list-filter#filter" data-list-filter-target="input">
          <button type="button" class="guide-search-clear is-hidden"
                  data-action="click->list-filter#clear" data-list-filter-target="clearButton" aria-label="Clear search">&times;</button>
        </div>
      </div>
    </div>
  </div>

  <div class="section-sm" style="padding-top:40px">
    <div class="wrap-wide">
      <div data-list-filter-target="noResults" class="guide-empty is-hidden">
        No user guides found matching your search.
      </div>

      <% @grouped_guides.each do |group, guides| %>
        <div class="guide-group">
          <span class="tile-kicker"><%= group.presence || "General" %></span>
          <div class="articles guide-articles">
            <% guides.each do |guide| %>
              <%= link_to user_guide_path(id: guide[:id]), class: "article guide-article", data: { list_filter_target: "item" } do %>
                <h3><%= guide[:title] %></h3>
                <p><%= guide[:description] %></p>
                <span class="go"><svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
