<%= render "layouts/filter", associations: [] %>

<%
  dom_uid = SecureRandom.hex(4)
  download_path = audits_path(params: params.to_unsafe_h, format: :xlsx)
  timeline_rows = @audits.map { |audit| { audit: audit, changes: (audit.audited_changes || {}) } }
  events_count = @pagy&.count || @audits.size
%>
<div class="card" data-controller="tooltip">
  <div class="card-header bg-white py-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <div class="d-flex align-items-center gap-2">
          <h5 class="card-title mb-0">Audit Trail</h5>
          <%= user_guide_info_icon %>
        </div>
        <span class="text-muted"><%= pluralize(events_count, "event") %> found</span>
        <div class="text-muted small mt-1">
          Every create, update, and delete across your organisation — who did it, when, and what changed.
        </div>
      </div>
    </div>
  </div>

  <div class="card-body p-0">
    <% if @field_history %>
      <%# Scoped to exactly one record (auditable_type + auditable_id) — safe to
          also offer the Field History pivot, same as the embedded AuditTrail widget. %>
      <%= render "layouts/audit_tabs_nav", dom_uid: dom_uid %>
      <div class="tab-content">
        <%= render "layouts/audit_timeline_tab",
                   rows: timeline_rows, pagy: @pagy, download_path: download_path,
                   container_id: "audit-timeline-#{dom_uid}", container_classes: "tab-pane fade show active" %>
        <%= render "layouts/audit_field_history_tab",
                   field_history: @field_history,
                   container_id: "audit-field-history-#{dom_uid}", container_classes: "tab-pane fade p-3" %>
      </div>
    <% else %>
      <%= render "layouts/audit_timeline_tab",
                 rows: timeline_rows, pagy: @pagy, download_path: download_path,
                 container_id: nil, container_classes: "" %>
    <% end %>
  </div>
</div>
