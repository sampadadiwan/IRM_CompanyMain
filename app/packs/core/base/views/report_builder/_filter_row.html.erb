<%# One filter row, drawn on the server so each field gets its own input (date picker, Yes/No, fund or value
    list, number, text) and plain-word operators. Choosing another field re-fetches the row; any change saves
    the filters after a short pause. H7, H8, E7, E8, E9, E10.
    locals: scope ("root" | "child"), relation, field, op, value, columns %>
<%
  field_info = field.present? ? ReportBuilderFilterField.new(config: @config, key: field, entity: current_user.entity, relation: relation) : nil
  operators  = field_info&.operators || []
  op         = operators.any? { |_, o| o == op } ? op : operators.first&.last
  no_value   = ReportBuilderFilterField::NO_VALUE_OPS.include?(op.to_s)
  values     = Array(value).map(&:to_s)
%>
<div class="filter-row border rounded p-2 mb-2" data-scope="<%= scope %>" data-relation="<%= relation %>"
     data-kind="<%= field_info&.kind %>"
     data-action="change->report-builder#filterChanged input->report-builder#filterChanged">
  <div class="d-flex gap-1 align-items-start">
    <select class="form-select form-select-sm filter-field" aria-label="Field"
            data-action="change->report-builder#filterFieldChanged">
      <option value="">— field —</option>
      <% columns.each do |c| %>
        <option value="<%= c[:key] %>" <%= 'selected' if c[:key] == field %>><%= c[:label] %></option>
      <% end %>
    </select>
    <button type="button" class="btn btn-sm btn-outline-danger flex-shrink-0" title="Remove filter" aria-label="Remove filter"
            data-action="click->report-builder#removeFilterRow">
      <i class="ti ti-trash"></i>
    </button>
  </div>

  <% if field_info %>
    <div class="d-flex gap-1 mt-1">
      <select class="form-select form-select-sm filter-op" aria-label="Operator" data-action="change->report-builder#filterOpChanged">
        <% operators.each do |label, o| %>
          <option value="<%= o %>" <%= 'selected' if o == op %>><%= label %></option>
        <% end %>
      </select>

      <div class="filter-value flex-grow-1 <%= 'd-none' if no_value %>">
        <%= render "report_builder/filter_value_input", field_info: field_info, op: op, values: values %>
      </div>
    </div>
    <%# E9, E10 — filled in by the builder when the row can't be saved yet %>
    <div class="filter-error small text-danger mt-1 d-none" role="status"></div>
  <% end %>
</div>
