<% content_for :title, "Report View – #{@report.name}" %>

<div class="container-fluid mw-100 px-4 py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="ti ti-layout-grid me-2 text-primary"></i><%= @report.name %>
      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fs-1 ms-2">
        Custom View
      </span>
    </h1>
    <div class="d-flex gap-2">
      <%= link_to edit_report_builder_path(@report), class: "btn btn-outline-primary d-flex align-items-center gap-2" do %>
        <i class="ti ti-edit"></i> Edit Builder
      <% end %>
      <%# The same report for another fund: copy, then change the fund (report-builder-starting-points H9) %>
      <% if policy(@report).update? %>
        <%= button_to duplicate_report_builder_path(@report), method: :post,
              class: "btn btn-outline-primary d-flex align-items-center gap-2", form: { class: "d-inline" } do %>
          <i class="ti ti-copy"></i> Duplicate
        <% end %>
      <% end %>
      <%= render "report_builder/export_button", report: @report %>
    </div>
  </div>

  <%# Headline totals, then the report's filters and Narrow down (report-builder-delivery H9–H11) %>
  <%= render "report_builder/headline_totals" %>
  <%= render "report_builder/view_filters" %>

  <%# A chart chosen in Describe it, from this page's rows (report-builder-assistant H7) %>
  <% chart = report_chart_for(@report, config: @config, columns: @columns, rows: @rows) %>
  <%= render "report_builder/report_chart", report: @report, chart: chart if chart %>

  <div class="card shadow-sm border">
    <div class="card-body p-0">
      <%= render ReportBuilderTable.new(report: @report, columns: @columns, rows: @rows, q: @q, formatter: @formatter,
                                        totals: @totals, sort: @sort, sort_capped: @sort_capped) %>
    </div>
    <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="text-muted small">
        Showing <%= @rows.size %> of <%= @total %> record<%= @total == 1 ? "" : "s" %>.
      </div>
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  </div>

  <%= render "report_builder/recent_exports", report: @report, user: current_user %>
</div>
