<% content_for :title, "New Report Builder" %>

<div class="row justify-content-center mt-4">
  <div class="col-md-6">
    <div class="card shadow">
      <div class="card-header">
        <h5 class="mb-0"><i class="ti ti-table me-2"></i>New Report Builder</h5>
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          Choose a root model. You can join other models and pick columns after the report is created.
        </p>

        <%= form_tag report_builder_create_path, method: :post do %>
          <div class="mb-3">
            <label class="form-label fw-semibold">Report Name</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Investor Commitment Summary" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Root Model</label>
            <select name="root_model" class="form-select" required>
              <option value="">— Select a model —</option>
              <% @root_models.sort_by(&:first).each do |pack, models| %>
                <optgroup label="<%= pack %>">
                  <% models.each do |m| %>
                    <option value="<%= m.name %>"><%= wizard_model_label(m.name) %></option>
                  <% end %>
                </optgroup>
              <% end %>
            </select>
          </div>

          <div class="d-flex gap-2">
            <%= link_to reports_path, class: "btn btn-outline-secondary" do %>
              <i class="ti ti-arrow-left me-1"></i>Cancel
            <% end %>
            <button type="submit" class="btn btn-primary">
              <i class="ti ti-arrow-right me-1"></i>Create & Configure
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
