<%# Describe it — one draft: what the assistant understood, its questions, the preview, the chart and saving.
    Everything below lives in the rb_draft_<id> frame, which ReportDraftJob reloads when a draft is ready.
    Worked examples H2–H9, E1–E12, X1–X3 — openspec/changes/report-builder-assistant/business-rules.md %>
<% content_for :title, "Describe your report – draft" %>

<div class="container-fluid py-3">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
      <h5 class="mb-1">Describe your report <span class="badge bg-warning-subtle text-warning ms-1"><i class="ti ti-sparkles"></i> Draft</span></h5>
      <p class="text-muted small mb-0">Only you can see this draft until you save it.</p>
    </div>
    <%= link_to report_builder_describe_path, class: "btn btn-sm btn-outline-secondary" do %>
      <i class="ti ti-arrow-left"></i> Describe another
    <% end %>
  </div>

  <%= render "report_builder/draft_state" %>
</div>
