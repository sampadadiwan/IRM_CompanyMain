<% content_for :title, "Report Builder – #{@report.name}" %>

<%# Helper for filter rows %>
<%
  @filter_ops = [["=", "eq"], ["contains", "cont"], ["any of", "in"], ["≠", "not_eq"],
                 ["≥", "gteq"], ["≤", "lteq"], ["is nil", "null"], ["is not nil", "not_null"]]
  @no_value_ops = %w[null not_null].to_set
  @known_op_suffixes = %w[eq not_eq cont not_cont in not_in gteq lteq gt lt null not_null]

  def parse_filter_pred(pred_key)
    op = @known_op_suffixes.find { |s| pred_key.to_s.end_with?("_#{s}") }
    op ? { field: pred_key.to_s[0..-(op.length + 2)], op: op } : { field: pred_key.to_s, op: "eq" }
  end

  def render_filter_row(scope:, relation: nil, pred_key:, val:, columns:)
    parsed      = parse_filter_pred(pred_key)
    no_value    = @no_value_ops.include?(parsed[:op])
    display_val = no_value ? "" : Array(val).join(", ")
    placeholder = parsed[:op] == "in" ? "val1, val2, …" : "value"
    relation_attr = relation ? "data-relation=\"#{relation}\"" : ""
    val_style   = no_value ? "display:none; flex:1; min-width:60px" : "flex:1; min-width:60px"

    field_opts = columns.map { |c|
      sel = parsed[:field] == c[:key] ? " selected" : ""
      "<option value=\"#{ERB::Util.html_escape(c[:key])}\"#{sel}>#{ERB::Util.html_escape(c[:label])}</option>"
    }.join

    op_opts = @filter_ops.map { |lbl, op|
      sel = parsed[:op] == op ? " selected" : ""
      "<option value=\"#{op}\"#{sel}>#{lbl}</option>"
    }.join

    <<~HTML.html_safe
      <div class="d-flex gap-1 align-items-center mb-2 filter-row p-1" data-scope="#{scope}" #{relation_attr}>
        <select class="form-select form-select-sm filter-field border-0 bg-light" style="width:36%">
          <option value="">— field —</option>#{field_opts}
        </select>
        <select class="form-select form-select-sm filter-op border-0 bg-light" style="width:26%"
                data-action="change->report-builder#filterOpChanged">#{op_opts}</select>
        <input type="text" class="form-control form-control-sm filter-val border-0 bg-light"
               value="#{ERB::Util.html_escape(display_val)}"
               placeholder="#{placeholder}" style="#{val_style}">
        <button type="button" class="btn btn-link text-danger p-0 opacity-50 hover-opacity-100 flex-shrink-0"
                data-action="click->report-builder#removeFilterRow">
          <i class="ti ti-trash" style="font-size:.9rem"></i>
        </button>
      </div>
    HTML
  end
%>

<div data-controller="report-builder command-palette tooltip"
     data-report-builder-aggregate-url-value="<%= update_report_builder_aggregate_path(@report) %>"
     data-report-builder-sort-url-value="<%= update_report_builder_sort_path(@report) %>"
     data-report-builder-name-url-value="<%= update_report_builder_name_path(@report) %>"
     data-report-builder-template-url-value="<%= update_report_builder_template_path(@report) %>"
     data-report-builder-preview-url-value="<%= preview_report_builder_path(@report) %>"
     data-report-builder-validate-formula-url-value="<%= validate_report_builder_formula_path(@report) %>"
     data-report-builder-view-settings-url-value="<%= update_report_builder_view_settings_path(@report) %>"
     data-report-builder-schedule-url-value="<%= update_report_builder_schedule_path(@report) %>"
     data-report-builder-csrf-value="<%= form_authenticity_token %>"
     class="report-builder-container px-0">

  <%# ── Header ────────────────────────────────────────────────────────── %>
  <div class="card shadow-none border-bottom mb-3 rounded-0 bg-light bg-opacity-50 mx-0">
    <div class="card-body py-3 px-4">
      <div class="d-flex align-items-center gap-3">
        <%= link_to reports_path, class: "btn btn-link text-muted p-0", title: "Back to Reports" do %>
          <i class="ti ti-arrow-left fs-5"></i>
        <% end %>

        <div class="vr mx-1"></div>

        <div class="flex-grow-1 min-width-0">
          <div class="d-flex align-items-center gap-2 mb-1">
            <h4 class="mb-0 fw-bolder text-truncate">
              <span data-report-builder-target="nameDisplay"
                    class="editable-name"
                    data-action="click->report-builder#startRename"><%= @report.name %></span>
              <input type="text"
                     data-report-builder-target="nameInput"
                     class="form-control form-control-lg d-none py-1"
                     style="max-width: 400px"
                     value="<%= @report.name %>"
                     data-action="blur->report-builder#commitRename keydown.enter->report-builder#commitRename keydown.escape->report-builder#cancelRename">
            </h4>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">
              <i class="ti ti-database me-1"></i><%= @config.root_model %>
            </span>
          </div>
          <div class="text-muted small">
            Created by <%= @report.user&.full_name %> • Last updated <%= time_ago_in_words(@report.updated_at) %> ago
          </div>
        </div>

        <div class="d-flex gap-2">
          <%# Counterpart to the wizard's own "Advanced Builder" button — lets
              someone editing an existing report drop into the guided,
              step-by-step flow for the same report instead of hunting for a
              URL. Always starts on the columns step; the wizard's own
              progress bar lets them jump to any step from there. %>
          <%= link_to wizard_report_builder_step_path(@report, step: "columns"),
                class: "btn btn-outline-primary d-flex align-items-center gap-2 shadow-sm" do %>
            <i class="ti ti-wand fs-5"></i> Guided Wizard
          <% end %>

          <div class="btn-group shadow-sm" role="group">
            <input type="radio" class="btn-check" name="builder_mode" id="buildMode" autocomplete="off" checked data-action="change->report-builder#switchMode" value="build">
            <label class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" for="buildMode"><i class="ti ti-tools"></i> Build</label>
            
            <input type="radio" class="btn-check" name="builder_mode" id="viewMode" autocomplete="off" data-action="change->report-builder#switchMode" value="view">
            <label class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" for="viewMode"><i class="ti ti-eye"></i> View</label>
          </div>

          <button class="btn btn-outline-secondary d-flex align-items-center gap-2 shadow-sm"
                  data-bs-toggle="modal" data-bs-target="#templateModal">
            <i class="ti ti-template fs-5"></i> Templates
          </button>

          <%= link_to download_report_builder_path(@report),
                class: "btn btn-success d-flex align-items-center gap-2 shadow-sm",
                data: {
                  "report-builder-target": "exportBtn",
                  action: "click->report-builder#startExport"
                } do %>
            <i class="ti ti-file-spreadsheet fs-5"></i> Export XLSX
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% unless @root_class %>
    <div class="container-fluid mw-100 px-4">
      <div class="alert alert-danger shadow-sm d-flex align-items-center gap-3">
        <i class="ti ti-alert-circle fs-6"></i>
        <div>Root model <strong><%= @config.root_model %></strong> could not be loaded. Please check if the model exists and is properly configured.</div>
      </div>
    </div>
  <% else %>

  <div class="container-fluid mw-100 px-2 px-lg-3 pb-5">
    <%= turbo_frame_tag "report_builder_setup" do %>
    <div class="row g-3 mx-0" id="report_builder_setup_row">

      <%# ── Left: Column Palette ────────────────────────────────────────── %>
      <div class="col-xxl-2 col-xl-3 col-lg-3">
        <div class="card border shadow-sm sticky-top" style="top: 1rem; z-index: 10">
          <div class="card-header bg-white py-3 border-bottom-0">
            <h6 class="card-title mb-3 d-flex align-items-center gap-2">
              <i class="ti ti-columns text-primary"></i> Available
            </h6>
            <div class="input-group input-group-sm shadow-sm border rounded">
              <span class="input-group-text bg-white border-0"><i class="ti ti-search text-muted"></i></span>
              <input type="text"
                     class="form-control border-0 ps-0"
                     placeholder="Search..."
                     data-report-builder-target="paletteSearch"
                     data-action="input->report-builder#filterPalette">
            </div>
          </div>
          <div class="card-body p-0 palette-scroll" style="max-height: calc(100vh - 250px); overflow-y: auto;">

            <%# Root model columns %>
            <details class="palette-group" open>
              <summary class="cursor-pointer d-flex align-items-center justify-content-between bg-light py-2 px-3 text-uppercase fs-1 fw-bold text-muted border-bottom">
                <span><i class="ti ti-table me-1"></i> <%= @root_class.name %></span>
                <i class="ti ti-chevron-down toggle-icon"></i>
              </summary>
              <div class="palette-items-container list-group list-group-flush">
                <% selected_keys = @report.grid_view_preferences.pluck(:key).map { |k| k.split(";").first.strip } %>
                <% @root_columns.each do |col| %>
                  <% already = selected_keys.include?(col[:key]) %>
                  <div class="list-group-item list-group-item-action border-0 py-2 ps-4 pe-3 d-flex align-items-center justify-content-between <%= already ? 'opacity-50 bg-light' : '' %>"
                       data-report-builder-target="paletteRow"
                       data-search-text="<%= col[:label].downcase %>">
                    <span class="text-truncate small" title="<%= col[:label] %>"><%= col[:label] %></span>
                    <% unless already %>
                      <%= button_to add_report_builder_column_path(@report),
                            method: :post,
                            params: { key: col[:raw_key], name: col[:label], label: col[:label] },
                            class: "btn btn-link p-0 text-primary" do %>
                        <i class="ti ti-circle-plus fs-5"></i>
                      <% end %>
                    <% else %>
                      <i class="ti ti-check text-success fs-5"></i>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </details>

            <%# Joined relation columns %>
            <% @joined_columns.each do |relation, cols| %>
              <details class="palette-group border-top">
                <summary class="cursor-pointer d-flex align-items-center justify-content-between bg-light py-2 px-3 text-uppercase fs-1 fw-bold text-muted border-bottom">
                  <span><i class="ti ti-link me-1"></i> <%= relation.humanize %></span>
                  <i class="ti ti-chevron-down toggle-icon"></i>
                </summary>
                <div class="palette-items-container list-group list-group-flush">
                  <% cols.each do |col| %>
                    <% already = selected_keys.include?("#{relation}.#{col[:key]}") %>
                    <div class="list-group-item list-group-item-action border-0 py-2 ps-4 pe-3 d-flex align-items-center justify-content-between <%= already ? 'opacity-50 bg-light' : '' %>"
                         data-report-builder-target="paletteRow"
                         data-search-text="<%= relation.downcase %> <%= col[:label].downcase %>">
                      <span class="text-truncate small" title="<%= col[:label] %>"><%= col[:label] %></span>
                      <% unless already %>
                        <%= button_to add_report_builder_column_path(@report),
                              method: :post,
                              params: { key: "#{relation}.#{col[:raw_key]}", name: col[:label], label: col[:label] },
                              class: "btn btn-link p-0 text-primary" do %>
                          <i class="ti ti-circle-plus fs-5"></i>
                        <% end %>
                      <% else %>
                        <i class="ti ti-check text-success fs-5"></i>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </details>
            <% end %>
          </div>
        </div>
      </div>

      <%# ── Center: Selected Columns ────────────────────────────────────── %>
      <div class="col-xxl-7 col-xl-5 col-lg-5">
        <div class="card border shadow-sm h-100">
          <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
            <h6 class="card-title mb-0 d-flex align-items-center gap-2">
              <i class="ti ti-list-check text-primary"></i> Selected Columns
            </h6>
            <span class="badge bg-primary rounded-pill"><%= @report.grid_view_preferences.count %></span>
          </div>
          <div class="card-body p-0">
            <% gvps = @report.grid_view_preferences.reorder(:sequence, :id).to_a %>
            <% if gvps.empty? %>
              <div class="text-center py-5 px-4">
                <div class="mb-3">
                  <i class="ti ti-layout-board text-light" style="font-size: 4rem"></i>
                </div>
                <h5 class="text-dark">Your report is empty</h5>
                <p class="text-muted small">Start by adding columns from the left panel to build your report structure.</p>
              </div>
            <% else %>
              <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm align-middle mb-0" 
                       data-controller="draggable-row"
                       data-owner-type="Report"
                       data-owner-id="<%= @report.id %>">
                  <thead class="table-dark">
                    <tr>
                      <th style="width: 40px"></th>
                      <th class="text-nowrap">Column</th>
                      <th class="text-nowrap" style="width: 140px">Aggregate</th>
                      <th style="width: 50px"></th>
                    </tr>
                  </thead>

                  <tbody>
                    <% gvps.each do |gvp| %>
                      <% clean_key = gvp.key.split(";").first.strip %>
                      <% is_child = clean_key.include?(".") %>
                      <% current_agg = @config.aggregate_for(clean_key) %>
                      <tr class="column column_<%= gvp.id %>"
                          data-draggable-row-target="column"
                          draggable="true"
                          data-key="<%= gvp.key %>"
                          data-row-id="<%= gvp.id %>">
                        <td class="text-center">
                          <i class="ti ti-grip-vertical text-muted cursor-grab"></i>
                        </td>
                        <td>
                          <div class="fw-semibold text-dark"><%= gvp.label.presence || gvp.name %></div>
                          <% if is_child %>
                            <span class="badge bg-light text-muted border fw-normal py-0 px-2" style="font-size: 0.65rem">
                              <i class="ti ti-link me-1"></i><%= clean_key.split(".",2).first %>
                            </span>
                          <% end %>
                        </td>
                        <td>
                          <% if is_child %>
                            <select class="form-select form-select-sm border-0 bg-light"
                                    data-action="change->report-builder#aggregateChanged"
                                    data-key="<%= clean_key %>">
                              <option value="">— none —</option>
                              <% %w[sum count avg min max latest list].each do |agg| %>
                                <option value="<%= agg %>" <%= current_agg == agg ? 'selected' : '' %>><%= agg %></option>
                              <% end %>
                            </select>
                          <% else %>
                            <div class="text-center"><i class="ti ti-minus text-muted opacity-25"></i></div>
                          <% end %>
                        </td>
                        <td class="text-end pe-3">
                          <%= button_to remove_report_builder_column_path(@report, gvp_id: gvp.id),
                                method: :delete,
                                class: "btn btn-link text-danger p-0 opacity-50 hover-opacity-100" do %>
                            <i class="ti ti-trash fs-5"></i>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# ── Right: Configuration ────────────────────────────────────────── %>
      <div class="col-xxl-3 col-xl-4 col-lg-4">

        <%# Joins Card %>
        <div class="card border shadow-sm mb-4">
          <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
            <h6 class="card-title mb-0 d-flex align-items-center gap-2">
              <i class="ti ti-git-merge text-primary"></i> Relations & Joins
              <i class="ti ti-info-circle text-muted" data-bs-toggle="tooltip" data-bs-placement="top" title="Each card below is an association joined onto the root model. By default a join contributes aggregate columns (sum, count, avg, latest…). Use Pivot Configuration inside a card to instead spread that join's rows into one column per category."></i>
            </h6>
            <button class="btn btn-link btn-xs p-0" type="button" data-bs-toggle="collapse" data-bs-target="#joinMapCollapse">
              <i class="ti ti-sitemap"></i> Map
            </button>
          </div>
          <div class="collapse" id="joinMapCollapse">
            <div class="card-body bg-light border-bottom p-3">
              <div class="join-tree small">
                <div class="fw-bold mb-1"><i class="ti ti-table me-1"></i><%= @root_class.name %></div>
                <% @config.joins.each do |join| %>
                  <% parts = join[:relation].to_s.split(".") %>
                  <div class="ms-3 border-start ps-2 py-1">
                    <% parts.each_with_index do |part, i| %>
                      <div style="margin-left: <%= i * 10 %>px">
                        <i class="ti ti-corner-down-right opacity-50"></i>
                        <span class="badge bg-white text-dark border rounded-pill"><%= part %></span>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
          <div class="card-body p-3">
            <% if @config.joins.empty? %>
              <div class="text-center py-3 bg-light rounded border border-dashed">
                <p class="text-muted small mb-0">No joined relations yet.</p>
              </div>
            <% else %>
              <div class="d-flex flex-column gap-3">
                <% @config.joins.each do |join| %>
                  <% pivot    = (join[:pivot] || {}).with_indifferent_access %>
                  <% join_rel = join[:relation].to_s %>
                  <% join_cols = @joined_columns[join_rel] || [] %>
                  <div class="join-item p-3 border rounded bg-white shadow-sm"
                       data-report-builder-relation="<%= join_rel %>"
                       data-report-builder-model="<%= join[:model] %>"
                       data-report-builder-fk="<%= join[:fk] %>"
                       data-report-builder-pivot="<%= pivot.to_h.to_json %>">

                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill"><%= join_rel %></span>
                        <small class="text-muted fw-medium"><%= join[:model] %></small>
                      </div>
                      <%= button_to remove_report_builder_join_path(@report),
                            method: :delete,
                            params: { relation: join_rel },
                            class: "btn btn-link text-danger p-0",
                            data: { msg: "Remove join '#{join_rel}'? This will also remove its columns.", action: "click->confirm#popup" } do %>
                        <i class="ti ti-x fs-5"></i>
                      <% end %>
                    </div>

                    <div class="pivot-section mt-2 pt-2 border-top">
                      <% pivot_active = Array(pivot[:group_bys] || pivot[:group_by]).any?(&:present?) && pivot[:value_col].present? %>
                      <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-bold text-secondary text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em">
                          <i class="ti ti-layout-columns me-1"></i>Pivot Configuration
                          <i class="ti ti-info-circle" data-bs-toggle="tooltip" data-bs-placement="top" title="Optional. Turns this join into dynamic columns: one output column per distinct value of 'Categories', filled with 'Value' aggregated by 'Aggregate'. Leave unset to keep this join as plain aggregate columns instead."></i>
                        </span>
                        <% if pivot_active %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fs-1">Active</span>
                        <% end %>
                      </div>

                      <%= form_tag update_report_builder_pivot_path(@report), method: :patch do %>
                        <input type="hidden" name="relation" value="<%= join_rel %>">
                        <div class="row g-2">
                          <div class="col-12">
                            <label class="form-label mb-1 fs-2 fw-bold text-muted">Categories (Multi-select)</label>
                            <select name="group_bys[]" class="form-select form-select-sm select2" multiple>
                              <% join_cols.each do |col| %>
                                <option value="<%= col[:key] %>" <%= Array(pivot[:group_bys] || pivot[:group_by]).include?(col[:key].to_s) ? 'selected' : '' %>><%= col[:label] %></option>
                              <% end %>
                            </select>
                          </div>
                          <div class="col-6">
                            <label class="form-label mb-1 fs-2 fw-bold text-muted">Value</label>
                            <select name="value_col" class="form-select form-select-sm bg-light border-0" required>
                              <option value="">— select —</option>
                              <% join_cols.each do |col| %>
                                <option value="<%= col[:key] %>" <%= pivot[:value_col] == col[:key] ? 'selected' : '' %>><%= col[:label] %></option>
                              <% end %>
                            </select>
                          </div>
                          <div class="col-6">
                            <label class="form-label mb-1 fs-2 fw-bold text-muted">Aggregate</label>
                            <select name="aggregate" class="form-select form-select-sm bg-light border-0">
                              <% %w[sum count avg min max latest list].each do |agg| %>
                                <option value="<%= agg %>" <%= (pivot[:aggregate] || 'sum') == agg ? 'selected' : '' %>><%= agg %></option>
                              <% end %>
                            </select>
                          </div>
                          <div class="col-6 d-flex align-items-end gap-1">
                            <button type="submit" class="btn btn-primary btn-sm flex-grow-1 py-1">Apply</button>
                            <% if pivot_active %>
                              <%= button_to update_report_builder_pivot_path(@report),
                                    method: :patch,
                                    params: { relation: join_rel, clear: "1" },
                                    class: "btn btn-outline-secondary btn-sm py-1 px-2" do %>
                                <i class="ti ti-rotate"></i>
                              <% end %>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <div class="mt-3">
              <% available_joins = @associations.reject { |a| @config.joins.any? { |j| j[:relation].to_s == a[:name] } } %>
              <% if available_joins.any? %>
                <%= form_tag add_report_builder_join_path(@report), method: :post do %>
                  <div class="d-flex align-items-center">
                    <div class="input-group input-group-sm shadow-sm border rounded overflow-hidden flex-grow-1">
                      <select name="relation_json" class="form-select border-0 bg-white"
                              data-action="change->report-builder#joinSelectChanged"
                              title="Attach another association from the root model as a new join card above.">
                        <option value="">+ Add new relation…</option>
                        <% available_joins.each do |assoc| %>
                          <option value="<%= assoc.to_json %>">
                            <%= assoc[:label] %> (<%= assoc[:macro] %>)<%= assoc[:has_children] ? " ›" : "" %>
                          </option>
                        <% end %>
                      </select>
                      <input type="hidden" name="relation">
                      <input type="hidden" name="model">
                      <input type="hidden" name="fk">
                      <button type="submit" class="btn btn-primary border-0 px-3">Add</button>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <%# Filters Card %>
        <div class="card border shadow-sm mb-4">
          <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
            <h6 class="card-title mb-0 d-flex align-items-center gap-2">
              <i class="ti ti-filter text-primary"></i> Filters
            </h6>
            <% total_filters = @config.root_filters.size + @config.joins.sum { |j| (j[:child_filters] || {}).size } %>
            <% if total_filters > 0 %>
              <span class="badge bg-warning text-dark rounded-pill"><%= total_filters %></span>
            <% end %>
          </div>
          <div class="card-body p-3" data-report-builder-target="filtersPanel">

            <%# Root Filters %>
            <div class="filter-group mb-3">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-bold text-secondary text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em">Root: <%= @root_class.name %></span>
                <button type="button" class="btn btn-link btn-xs p-0 text-primary fw-bold"
                        data-action="click->report-builder#addFilterRow"
                        data-scope="root">
                  <i class="ti ti-plus me-1"></i>Add
                </button>
              </div>
              <div data-report-builder-target="rootFilterRows"
                   data-columns="<%= @root_columns.map { |c| {key: c[:key], label: c[:label]} }.to_json %>">
                <% @config.root_filters.each do |pred_key, val| %>
                  <%= render_filter_row(scope: "root", pred_key: pred_key, val: val, columns: @root_columns) %>
                <% end %>
              </div>
            </div>

            <%# Child Filters %>
            <% @config.joins.each do |join| %>
              <% jrel = join[:relation].to_s %>
              <% jcols = @joined_columns[jrel] || [] %>
              <div class="filter-group mb-3 pt-2 border-top">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="small fw-bold text-secondary text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em">Relation: <%= jrel.humanize %></span>
                  <button type="button" class="btn btn-link btn-xs p-0 text-primary fw-bold"
                          data-action="click->report-builder#addFilterRow"
                          data-scope="child"
                          data-relation="<%= jrel %>">
                    <i class="ti ti-plus me-1"></i>Add
                  </button>
                </div>
                <div data-report-builder-target="childFilterRows" data-relation="<%= jrel %>"
                     data-columns="<%= jcols.map { |c| {key: c[:key], label: c[:label]} }.to_json %>">
                  <% (join[:child_filters] || {}).each do |pred_key, val| %>
                    <%= render_filter_row(scope: "child", relation: jrel, pred_key: pred_key, val: val, columns: jcols) %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="mt-3 pt-3 border-top">
              <button type="button" class="btn btn-primary w-100 shadow-sm"
                      data-action="click->report-builder#saveFilters">
                <i class="ti ti-device-floppy me-2"></i>Save All Filters
              </button>
              <div class="text-center mt-2">
                <small class="text-muted fs-1">
                  <i class="ti ti-info-circle me-1"></i>Use <strong>any of</strong> with commas for multiple values.
                </small>
              </div>
            </div>
          </div>
        </div>

        <%# Sort & Grouping Card %>
        <div class="card border shadow-sm">
          <div class="card-header bg-white py-3 border-bottom">
            <h6 class="card-title mb-0 d-flex align-items-center gap-2">
              <i class="ti ti-arrows-sort text-primary"></i> Sorting & Grouping
            </h6>
          </div>
          <div class="card-body p-3">
            <div class="mb-3">
              <label class="form-label small fw-bold">Default Sort</label>
              <div class="row g-2">
                <div class="col-8">
                  <select class="form-select form-select-sm bg-light border-0"
                          data-action="change->report-builder#sortChanged"
                          data-report-builder-target="sortKey">
                    <option value="">— none —</option>
                    <% gvps_for_sort = @report.grid_view_preferences.order(:sequence).to_a %>
                    <%# Joined/aggregate columns (dotted keys) used to be hidden here because
                        the query engine could only sort SQL-side, on plain root-model columns,
                        and would silently ignore a dotted key. ReportBuilderQueryEngine now
                        sorts those in memory after merging (capped for safety on huge roots),
                        so they're real, working options too. %>
                    <% gvps_for_sort.each do |gvp| %>
                      <% ck = gvp.key.split(";").first.strip %>
                      <option value="<%= ck %>" <%= @config.sort[:key].to_s.split(";").first&.strip == ck ? "selected" : "" %>>
                        <%= gvp.label.presence || gvp.name %>
                      </option>
                    <% end %>
                  </select>
                </div>
                <div class="col-4">
                  <select class="form-select form-select-sm bg-light border-0"
                          data-action="change->report-builder#sortChanged"
                          data-report-builder-target="sortDir">
                    <option value="asc"  <%= @config.sort[:dir] != "desc" ? "selected" : "" %>>↑ ASC</option>
                    <option value="desc" <%= @config.sort[:dir] == "desc" ? "selected" : "" %>>↓ DESC</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-bold">Row Grouping (Excel)</label>
              <select class="form-select form-select-sm bg-light border-0"
                      data-action="change->report-builder#groupingChanged"
                      data-report-builder-target="groupRowsBy">
                <option value="">— none —</option>
                <% gvps_for_sort.each do |gvp| %>
                  <% ck = gvp.key.split(";").first.strip %>
                  <option value="<%= ck %>" <%= @config.group_rows_by == ck ? "selected" : "" %>>
                    <%= gvp.label.presence || gvp.name %>
                  </option>
                <% end %>
              </select>
              <div class="form-text small" style="font-size: 0.65rem">Creates collapsible groups in Excel export.</div>
            </div>

            <div class="mb-0">
              <label class="form-label small fw-bold">Display Currency</label>
              <select class="form-select form-select-sm bg-light border-0"
                      data-action="change->report-builder#currencyChanged"
                      data-report-builder-target="currency">
                <option value="">— none —</option>
                <% Money::Currency.table.values.sort_by { |c| c[:iso_code] }.each do |c| %>
                  <option value="<%= c[:iso_code] %>" <%= @config.currency.to_s.upcase == c[:iso_code] ? "selected" : "" %>>
                    <%= c[:iso_code] %> (<%= c[:symbol] %>) — <%= c[:name] %>
                  </option>
                <% end %>
              </select>
              <%# Display only — no conversion. Just labels monetized (Money) columns
                  with this symbol in the view, preview, and Excel export. Funds/entities
                  can hold different currencies, so this never converts amounts — picking
                  one here is an explicit choice by whoever built the report. %>
              <div class="form-text small" style="font-size: 0.65rem">Labels monetary columns with this symbol. Display only — amounts are not converted.</div>
            </div>
          </div>
        </div>

        <%# Formulas Card %>
        <div class="card border shadow-sm mt-4">
          <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
            <h6 class="card-title mb-0 d-flex align-items-center gap-2">
              <i class="ti ti-math-function text-primary"></i> Formulas
            </h6>
          </div>
          <div class="card-body p-3">
            <% if @config.formulas.empty? %>
              <div class="text-center py-3 bg-light rounded border border-dashed mb-3">
                <p class="text-muted small mb-0">No formulas yet.</p>
              </div>
            <% else %>
              <div class="d-flex flex-column gap-2 mb-3">
                <% @config.formulas.each do |formula| %>
                  <div class="p-2 border rounded bg-white d-flex align-items-center justify-content-between shadow-sm">
                    <div class="min-width-0">
                      <div class="fw-bold small text-truncate"><%= formula[:label] %></div>
                      <code class="text-muted text-truncate d-block" style="font-size: 0.7rem"><%= formula[:expression] %></code>
                    </div>
                    <%= button_to remove_report_builder_formula_path(@report, key: formula[:key]),
                          method: :delete,
                          class: "btn btn-link text-danger p-0 ms-2",
                          data: { msg: "Remove formula '#{formula[:label]}'?", action: "click->confirm#popup" } do %>
                      <i class="ti ti-trash"></i>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>

            <button type="button" class="btn btn-outline-primary btn-sm w-100"
                    data-bs-toggle="modal" data-bs-target="#formulaModal">
              <i class="ti ti-plus me-1"></i> Add Formula
            </button>
          </div>
        </div>

        <%# Schedule Card %>
        <div class="card border shadow-sm mt-4">
          <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
            <h6 class="card-title mb-0 d-flex align-items-center gap-2">
              <i class="ti ti-calendar-event text-primary"></i> Automated Delivery
            </h6>
          </div>
          <div class="card-body p-3">
            <% schedule = @report.report_schedule || ReportSchedule.new %>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" id="scheduleEnabledToggle"
                     <%= schedule.enabled ? 'checked' : '' %>
                     data-action="change->report-builder#toggleSchedule">
              <label class="form-check-label fw-bold" for="scheduleEnabledToggle">Enable Scheduling</label>
            </div>

            <div id="scheduleSettings" class="<%= schedule.enabled ? '' : 'd-none' %>">
              <div class="mb-3">
                <label class="form-label small fw-bold">Frequency</label>
                <select class="form-select form-select-sm" data-action="change->report-builder#updateSchedule" data-report-builder-target="scheduleFrequency">
                  <option value="daily" <%= schedule.frequency == 'daily' ? 'selected' : '' %>>Daily (9 AM)</option>
                  <option value="weekly" <%= schedule.frequency == 'weekly' ? 'selected' : '' %>>Weekly (Mon 9 AM)</option>
                  <option value="monthly" <%= schedule.frequency == 'monthly' ? 'selected' : '' %>>Monthly (1st 9 AM)</option>
                </select>
              </div>

              <div class="mb-0">
                <label class="form-label small fw-bold">Recipients</label>
                <textarea class="form-control form-control-sm" rows="2" 
                          placeholder="emails separated by commas"
                          data-action="blur->report-builder#updateSchedule"
                          data-report-builder-target="scheduleRecipients"><%= Array(schedule.recipients).join(", ") %></textarea>
                <div class="form-text small" style="font-size: 0.65rem">Separate multiple emails with commas.</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
    <% end %>

    <%# ── Preview Section ──────────────────────────────────────────────── %>
    <div class="row mt-4" id="report_builder_preview_row">
      <div class="col-12">
        <div class="card border shadow-sm">
          <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
            <div>
              <h6 class="card-title mb-0 d-flex align-items-center gap-2">
                <i class="ti ti-table-export text-primary"></i> Data Preview
                <span class="badge bg-warning text-dark fw-normal" style="font-size:.7rem">PREVIEW</span>
              </h6>
              <p class="text-muted small mb-0 mt-1">
                Showing up to <strong>50 rows</strong> — a quick sample to check your setup.
                <i class="ti ti-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="Previewing is fast because it only fetches a tiny slice. Running the full report (especially with joins, pivots, or many rows) takes more time and database work — use Download to get all your data."></i>
                To get all your data, use <strong>Download as Excel</strong>.
              </p>
            </div>
            <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2"
                    data-action="click->report-builder#loadPreview">
              <i class="ti ti-refresh"></i> Refresh Preview
            </button>
          </div>
          <div class="card-body p-0">
            <%= turbo_frame_tag "report_builder_preview",
                  src: nil,
                  data: { "report-builder-target": "previewFrame" } do %>
              <div class="text-center py-5">
                <div class="mb-3">
                  <i class="ti ti-search text-light" style="font-size: 4rem"></i>
                </div>
                <h5 class="text-dark">No preview loaded</h5>
                <p class="text-muted small">Click <strong>Refresh Preview</strong> to see a sample of up to 50 rows.</p>
                <p class="text-muted small">This is just a preview — use <strong>Download as Excel</strong> for the full dataset.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

<!-- Command Palette Modal -->
<div class="modal fade" id="commandPaletteModal" tabindex="-1" aria-hidden="true" data-command-palette-target="modal">
  <div class="modal-dialog modal-lg">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-body p-0">
        <div class="input-group input-group-lg border-bottom">
          <span class="input-group-text bg-white border-0"><i class="ti ti-search text-muted"></i></span>
          <input type="text" class="form-control border-0 shadow-none" 
                 placeholder="Search columns or actions... (Cmd+K)" 
                 data-command-palette-target="input"
                 data-action="input->command-palette#search">
        </div>
        <div class="list-group list-group-flush overflow-auto" style="max-height: 400px" data-command-palette-target="results">
          <!-- Results will be injected here -->
        </div>
      </div>
      <div class="modal-footer bg-light py-2 px-3 justify-content-start">
        <div class="d-flex gap-3 small text-muted">
          <span><kbd class="bg-white text-dark border shadow-sm">↑↓</kbd> to navigate</span>
          <span><kbd class="bg-white text-dark border shadow-sm">Enter</kbd> to select</span>
          <span><kbd class="bg-white text-dark border shadow-sm">Esc</kbd> to close</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Template Modal -->
<div class="modal fade" id="templateModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Quick Start Gallery</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <% report_templates.each do |key, config| %>
            <div class="col-md-6">
              <div class="card h-100 border shadow-sm hover-shadow transition-all">
                <div class="card-body">
                  <h6 class="fw-bold text-primary"><%= config[:name] %></h6>
                  <p class="small text-muted mb-3"><%= config[:description] %></p>
                  <%= button_to apply_report_builder_template_path(@report, template_key: key),
                        method: :post,
                        class: "btn btn-sm btn-outline-primary w-100",
                        data: { confirm: "This will clear your current configuration. Continue?" } do %>
                    Apply Template
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Formula Modal -->
<div class="modal fade" id="formulaModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Formula Playground</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_tag add_report_builder_formula_path(@report), method: :post do %>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-bold">Label</label>
            <input type="text" name="label" class="form-control" placeholder="e.g. Call %" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Expression</label>
            <textarea name="expression" class="form-control font-monospace" rows="3" 
                      placeholder="e.g. ([capital_commitments.called_amount] / [capital_commitments.amount]) * 100"
                      data-report-builder-target="formulaInput"
                      data-action="input->report-builder#validateFormula"></textarea>
            <div class="form-text small">
              Use <code>[column.key]</code> to reference columns. Supports <code>+ - * / ( ) IF AND OR ROUND</code> etc.
            </div>
          </div>
          
          <div class="p-3 bg-light rounded border">
            <h6 class="fs-2 fw-bold text-uppercase text-muted mb-2">Live Preview</h6>
            <div data-report-builder-target="formulaPreview" class="small text-dark">
              Enter an expression to see preview...
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" data-report-builder-target="formulaSubmit" disabled>Add Formula</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

  <% end %> <%# unless @root_class %>
</div> <%# main div %>
