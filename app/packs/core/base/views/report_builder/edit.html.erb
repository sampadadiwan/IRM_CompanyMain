<% content_for :title, "Report Builder – #{@report.name}" %>

<%# The builder: settings tabs on the left, the live preview on the right. Every change re-renders the
    settings panel, the preview and the health badge together (ReportBuilder::BuilderUpdates). H1, H17. %>
<div data-controller="report-builder command-palette tooltip"
     data-report-builder-aggregate-url-value="<%= update_report_builder_aggregate_path(@report) %>"
     data-report-builder-sort-url-value="<%= update_report_builder_sort_path(@report) %>"
     data-report-builder-name-url-value="<%= update_report_builder_name_path(@report) %>"
     data-report-builder-template-url-value="<%= update_report_builder_template_path(@report) %>"
     data-report-builder-preview-url-value="<%= preview_report_builder_path(@report, builder: 1) %>"
     data-report-builder-validate-formula-url-value="<%= validate_report_builder_formula_path(@report) %>"
     data-report-builder-join-settings-url-value="<%= update_report_builder_join_settings_path(@report) %>"
     data-report-builder-csrf-value="<%= form_authenticity_token %>"
     class="report-builder-container">

  <%= render "report_builder/builder_header" %>

  <% unless @root_class %>
    <div class="alert alert-danger d-flex align-items-center gap-2">
      <i class="ti ti-alert-circle"></i>
      <div>The table <strong><%= @config.root_model %></strong> could not be loaded, so this report can't be edited.</div>
    </div>
  <% else %>
    <div class="row g-3">
      <div class="col-xl-4">
        <%= render "report_builder/settings_panel" %>
      </div>

      <div class="col-xl-8">
        <div class="card border shadow-none">
          <div class="card-header bg-white d-flex align-items-center justify-content-between">
            <div>
              <h2 class="h6 mb-0"><i class="ti ti-table me-1"></i>Preview</h2>
              <div class="text-muted small">Up to <%= ReportBuilderController::PREVIEW_LIMIT %> rows — use Export XLSX for all of them.</div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="click->report-builder#loadPreview"
                    title="Refresh preview" aria-label="Refresh preview">
              <i class="ti ti-refresh"></i> Refresh
            </button>
          </div>
          <div class="card-body p-0">
            <%# Loads by itself after the page paints (H1); errors stay inside this frame (E19) %>
            <%= turbo_frame_tag "report_builder_preview", src: preview_report_builder_path(@report, builder: 1),
                  data: { "report-builder-target": "previewFrame" } do %>
              <div class="text-center text-muted py-5">
                <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div> Loading the preview…
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= render "report_builder/builder_modals" %>
  <% end %>

  <div id="report_builder_toasts" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
</div>
