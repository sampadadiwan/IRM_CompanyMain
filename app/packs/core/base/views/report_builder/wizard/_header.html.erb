<%# Top of wizard steps 2–5: the report and a way out to the builder %>
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
  <div>
    <div class="text-muted small"><i class="ti ti-wand me-1"></i>Guided setup</div>
    <h5 class="mb-0"><%= @report.name %>
      <span class="badge bg-secondary-subtle text-secondary ms-1">
        <i class="ti <%= wizard_icon_for(@root_class.name) %>"></i> <%= wizard_model_label(@root_class.name).pluralize %>
      </span>
    </h5>
  </div>
  <div class="d-flex gap-2">
    <%= link_to edit_report_builder_path(@report), class: "btn btn-sm btn-outline-secondary" do %>
      <i class="ti ti-tools"></i> Open in builder
    <% end %>
    <%= link_to "Exit", reports_path, class: "btn btn-sm btn-outline-secondary" %>
  </div>
</div>
<%= render "report_builder/wizard/steps", current: @step, report: @report %>
