<%# Wizard step 2 — What to show: tick the row's own and related columns together (related data is added
    for you), and pick each related column's total right here. H20, H21, H22, E21. %>
<% content_for :title, "Guided setup – What to show" %>
<% sources = [{ title: "About the #{wizard_model_label(@root_class.name).downcase}", relation: nil }] +
             @associations.map { |a| { title: "From #{a[:label].to_s.downcase}", relation: a[:name].to_s } } %>

<div class="container-fluid py-3">
  <%= render "report_builder/wizard/header" %>

  <div class="row g-3">
    <div class="col-xl-5">
      <div class="card mb-3">
        <div class="card-header fw-semibold">Which columns should the report show?</div>
        <div class="card-body">
          <%= render "report_builder/column_groups", sources: sources, frame: nil, wizard_step: "show" %>
        </div>
      </div>

      <div class="card">
        <div class="card-header fw-semibold">In the report</div>
        <div class="card-body">
          <% columns = @gvps.reject { |g| g.key.start_with?("formula:", "pivot:") } %>
          <% if columns.empty? %>
            <p class="text-muted small mb-0">Nothing yet — tick columns above, then Add selected.</p>
          <% else %>
            <table class="table table-sm align-middle mb-0 rb-wizard-columns">
              <thead><tr><th>Column</th><th>Total over related rows</th><th></th></tr></thead>
              <tbody>
                <% columns.each do |gvp| %>
                  <% key = gvp.key.split(";").first.strip %>
                  <% default = @config.column_type.default_aggregate(key) %>
                  <tr data-key="<%= key %>">
                    <td><%= gvp.label.presence || gvp.name %></td>
                    <td>
                      <% if default %>
                        <%# H21 — saved as soon as it changes %>
                        <%= form_tag update_report_builder_aggregate_path(@report), method: :patch do %>
                          <%= hidden_field_tag :key, gvp.key %>
                          <%= hidden_field_tag :wizard_step, "show" %>
                          <select name="aggregate" class="form-select form-select-sm" aria-label="Total for <%= gvp.label.presence || gvp.name %>"
                                  onchange="this.form.requestSubmit()">
                            <% ReportBuilderColumnType::AGGREGATES.each do |agg| %>
                              <option value="<%= agg %>" <%= 'selected' if @config.effective_aggregate(gvp.key) == agg %>><%= ReportBuilderColumnType.aggregate_label(agg) %></option>
                            <% end %>
                          </select>
                        <% end %>
                      <% else %>
                        <span class="text-muted small">One per row</span>
                      <% end %>
                    </td>
                    <td class="text-end">
                      <%= button_to remove_report_builder_column_path(@report, gvp_id: gvp.id), method: :delete, params: { wizard_step: "show" },
                            class: "btn btn-sm btn-outline-danger", title: "Remove #{gvp.label.presence || gvp.name}",
                            "aria-label": "Remove #{gvp.label.presence || gvp.name}" do %>
                        <i class="ti ti-trash"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-xl-7">
      <%= render "report_builder/wizard/sample" %>
    </div>
  </div>

  <%= render "report_builder/wizard/footer_nav", next_step: "fund_filters" %>
</div>
