<%# Wizard step 4 — Order and calculations: the default sort, and calculations suggested for the columns
    the report has (Called %, Unpaid, Uncalled, DPI), each added with one click. H25, H26, E24. %>
<% content_for :title, "Guided setup – Order and calculations" %>
<% sortable = @gvps.reject { |g| g.key.start_with?("formula:", "pivot:") }.map { |g| [g.label.presence || g.name, g.key.split(";").first.strip] } +
              (@config.formulas || []).map { |f| [f["label"], f["key"]] } %>

<div class="container-fluid py-3">
  <%= render "report_builder/wizard/header" %>

  <div class="row g-3">
    <div class="col-xl-5">
      <div class="card mb-3">
        <div class="card-header fw-semibold">In what order?</div>
        <div class="card-body">
          <%= form_tag update_report_builder_sort_path(@report), method: :patch, class: "d-flex gap-2" do %>
            <%= hidden_field_tag :wizard_step, "order" %>
            <select name="sort_key" class="form-select form-select-sm" aria-label="Sort by">
              <option value="">— as stored —</option>
              <% sortable.each do |label, key| %>
                <option value="<%= key %>" <%= 'selected' if @config.sort[:key].to_s == key %>><%= label %></option>
              <% end %>
            </select>
            <select name="sort_dir" class="form-select form-select-sm w-auto" aria-label="Direction">
              <option value="asc" <%= 'selected' unless @config.sort[:dir] == 'desc' %>>Smallest / A first</option>
              <option value="desc" <%= 'selected' if @config.sort[:dir] == 'desc' %>>Largest / Z first</option>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
          <% end %>
        </div>
      </div>

      <div class="card">
        <div class="card-header fw-semibold">Suggested calculations</div>
        <div class="card-body">
          <% if @suggestions.empty? %>
            <p class="text-muted small mb-0">No suggestions for these columns. You can write your own formula in the builder.</p>
          <% else %>
            <ul class="list-unstyled mb-0 rb-wizard-suggestions">
              <% @suggestions.each do |suggestion| %>
                <li class="d-flex align-items-center justify-content-between gap-2 py-2 border-bottom" data-name="<%= suggestion[:name] %>">
                  <div>
                    <div class="fw-semibold small"><%= suggestion[:name] %></div>
                    <div class="text-muted small"><%= suggestion[:in_words] %></div>
                  </div>
                  <% if suggestion[:added] %>
                    <span class="badge bg-success-subtle text-success"><i class="ti ti-check"></i> Added</span>
                  <% else %>
                    <%= button_to add_report_builder_formula_path(@report), method: :post,
                          params: { label: suggestion[:name], expression: suggestion[:expression], wizard_step: "order" },
                          class: "btn btn-sm btn-outline-primary", "aria-label": "Add #{suggestion[:name]}" do %>
                      <i class="ti ti-plus"></i> Add
                    <% end %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-xl-7">
      <%= render "report_builder/wizard/sample" %>
    </div>
  </div>

  <%= render "report_builder/wizard/footer_nav", back_step: "fund_filters", next_step: "check" %>
</div>
