<%# Wizard step 1 — Each row: a card per table with an example question; choosing one creates the report and
    opens step 2. The name is suggested at the end. H18, H19, X4. %>
<% content_for :title, "Guided setup" %>

<div class="container-fluid py-3" data-controller="report-builder-select">
  <%= render "report_builder/wizard/steps", current: "rows", report: nil %>

  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
      <h5 class="mb-1">What should each row of the report be?</h5>
      <p class="text-muted small mb-0">Pick the table closest to your question. You choose columns, a fund and filters next.</p>
    </div>
    <div class="input-group input-group-sm w-auto">
      <span class="input-group-text"><i class="ti ti-search"></i></span>
      <input type="text" class="form-control" placeholder="Search tables" aria-label="Search tables"
             data-action="input->report-builder-select#filter">
    </div>
  </div>

  <% @root_models.sort_by(&:first).each do |pack, models| %>
    <div class="text-muted small mb-2"><%= pack %></div>
    <div class="row g-3 mb-4">
      <% models.sort_by { |m| wizard_model_label(m.name) }.each do |model| %>
        <div class="col-sm-6 col-lg-4 col-xxl-3" data-report-builder-select-target="row"
             data-search-text="<%= [wizard_model_label(model.name), wizard_example_for(model.name)].join(' ').downcase %>">
          <%= button_to wizard_report_builder_create_path, params: { root_model: model.name },
                class: "card h-100 w-100 text-start border rb-wizard-table", form: { class: "h-100" },
                "aria-label": "Report on #{wizard_model_label(model.name).pluralize.downcase}" do %>
            <div class="card-body d-flex gap-3 align-items-start">
              <span class="badge bg-primary-subtle text-primary fs-5"><i class="ti <%= wizard_icon_for(model.name) %>"></i></span>
              <div>
                <div class="fw-semibold"><%= wizard_model_label(model.name).pluralize %></div>
                <div class="text-muted small"><%= wizard_example_for(model.name) %></div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="text-muted small">
    Prefer to set everything yourself? <%= link_to "Open the builder instead", new_report_builder_path %>
  </div>
</div>
