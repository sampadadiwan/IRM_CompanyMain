<%# The first 5 rows beside wizard steps 2–5, loaded by itself (the builder's preview, H22) %>
<div class="card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <span class="fw-semibold">Sample — first 5 rows</span>
  </div>
  <div class="card-body p-0">
    <%= turbo_frame_tag "report_builder_preview", src: preview_report_builder_path(@report, limit: 5), loading: :eager do %>
      <div class="text-muted small p-3">Loading the sample…</div>
    <% end %>
  </div>
</div>
