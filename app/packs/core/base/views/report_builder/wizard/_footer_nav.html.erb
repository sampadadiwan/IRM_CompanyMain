<%# Back / Continue between wizard steps. locals: back_step (step key, or "rows" for step 1), next_step %>
<div class="d-flex align-items-center justify-content-between mt-4 pt-3 border-top">
  <% if local_assigns[:back_step] == "rows" %>
    <%= link_to wizard_report_builder_path, class: "btn btn-outline-secondary", data: { turbo_frame: "_top" } do %>
      <i class="ti ti-arrow-left"></i> Back
    <% end %>
  <% elsif local_assigns[:back_step] %>
    <%= link_to wizard_report_builder_step_path(@report, step: back_step), class: "btn btn-outline-secondary", data: { turbo_frame: "_top" } do %>
      <i class="ti ti-arrow-left"></i> Back
    <% end %>
  <% else %>
    <span></span>
  <% end %>
  <% if local_assigns[:next_step] %>
    <%= link_to wizard_report_builder_step_path(@report, step: next_step), class: "btn btn-primary", data: { turbo_frame: "_top" } do %>
      Continue <i class="ti ti-arrow-right"></i>
    <% end %>
  <% end %>
</div>
