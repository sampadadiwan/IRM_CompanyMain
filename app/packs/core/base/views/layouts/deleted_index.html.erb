<div class="card">
  <div class="card-header bg-white py-3">
    <div class="d-flex align-items-center justify-content-between">
      <h5 class="card-title mb-0">Deleted <%= controller_name.humanize %></h5>
      <span class="badge bg-danger rounded-pill"><%= @records.count %> Records Found</span>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">ID</th>
            <th>Name / Details</th>
            <th>Deleted At</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @records.any? %>
            <% @records.each do |record| %>
              <tr>
                <td class="ps-4">
                  <span class="text-muted fw-medium">#<%= record.id %></span>
                </td>
                <td>
                  <div class="fw-bold text-dark">
                    <%= record.try(:name) || record.try(:investor_name) || record.try(:title) || record.to_s %>
                  </div>
                </td>
                <td>
                  <span class="text-muted">
                    <%= record.deleted_at ? l(record.deleted_at, format: :long_date_time) : "" %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <%
                    deleted_folder = nil
                    %w[document_folder_id data_room_folder_id].each do |folder_attr|
                      if record.respond_to?(folder_attr) && record.send(folder_attr).present?
                        deleted_folder = Folder.only_deleted.find_by(id: record.send(folder_attr))
                        break if deleted_folder
                      end
                    end
                  %>

                  <% if record.is_a?(Document) && Folder.with_deleted.where(id: record.folder_id).first&.deleted? %>
                    <% folder = Folder.with_deleted.find_by(id: record.folder_id) %>
                    <%= button_to polymorphic_path([:restore_deleted, folder]),
                                  method: :put,
                                  form_class: "deleteButton",
                                  data: { action: "click->confirm#popup", turbo: false, method: :put, notification: "no", msg: "The folder '#{folder.name}' is also deleted. Restoring it will restore all its documents. Proceed?" },
                                  class: "btn btn-sm btn-outline-danger rounded-pill px-3" do %>
                      <i class="ti ti-folder-share me-1"></i> Restore Folder & All Docs
                    <% end %>
                  <% elsif deleted_folder %>
                    <%= button_to polymorphic_path([:restore_deleted, record]),
                                  method: :put,
                                  form_class: "deleteButton",
                                  data: { action: "click->confirm#popup", turbo: false, method: :put, notification: "no",
                                         msg: "Restoring this #{record.class.model_name.human} will also restore its associated folder '#{deleted_folder.name}' as it is currently deleted. Proceed?" },
                                  class: "btn btn-sm btn-outline-warning rounded-pill px-3" do %>
                      <i class="ti ti-restore me-1"></i> Restore Record & Folder
                    <% end %>
                  <% else %>
                    <%= button_to polymorphic_path([:restore_deleted, record]),
                                method: :put,
                                form_class: "deleteButton",
                                data: { action: "click->confirm#popup", turbo: false, method: :put, notification: "no", msg: "Are you sure you want to restore this #{record.class.model_name.human}?" },
                                class: "btn btn-sm btn-outline-primary rounded-pill px-3" do %>
                      <i class="ti ti-restore me-1"></i> Restore
                    <% end %>
                  <% end %>
                  <%= link_to audits_path(auditable_type: record.class.name, auditable_id: record.id),
                              class: "btn btn-sm btn-outline-secondary rounded-pill px-3 ms-1" do %>
                    <i class="ti ti-history me-1"></i> Audit Trail
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center py-5 text-muted">
                <i class="ti ti-trash-off fs-1 d-block mb-2"></i>
                No deleted records found.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy.pages > 1 %>
    <div class="card-footer bg-white border-top-0 py-3">
      <div class="d-flex justify-content-center">
        <%== pagy_bootstrap_nav(@pagy) %>
      </div>
    </div>
  <% end %>
</div>
