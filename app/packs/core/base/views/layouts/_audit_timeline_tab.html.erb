<%# locals: rows: [{audit:, changes:}], pagy:, download_path:, container_id:, container_classes: %>
<div id="<%= container_id %>" class="<%= container_classes %>" role="<%= 'tabpanel' if container_id %>" data-controller="audit-search">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3 border-bottom">
    <%= render "layouts/audit_search_bar" %>
    <% if download_path %>
      <%= link_to download_path, class: "btn btn-outline-primary" do %>
        <i class="ti ti-download me-1"></i> Download
      <% end %>
    <% end %>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th class="ps-4" style="width: 40px;"></th>
          <th>Action</th>
          <th>Record</th>
          <th>User</th>
          <th>When</th>
          <th class="text-end pe-4">Changes</th>
        </tr>
      </thead>
      <tbody>
        <% if rows.empty? %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="ti ti-history-off fs-1 d-block mb-2"></i>
              No audit records found.
            </td>
          </tr>
        <% end %>
        <% rows.each do |row| %>
          <%= render "layouts/audit_event_row", audit: row[:audit], changes: row[:changes] %>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if pagy && pagy.pages > 1 %>
    <div class="p-3 border-top d-flex justify-content-center">
      <%== pagy_bootstrap_nav(pagy) %>
    </div>
  <% end %>
</div>
