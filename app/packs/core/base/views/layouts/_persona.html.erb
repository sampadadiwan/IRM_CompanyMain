<% model ||= current_user %>
<%# L7 — POST (with the CSRF token form_with adds), never GET: see UsersController#set_persona.
    turbo: false keeps the full-page reload the GET form used to get, so the new persona's menus render. %>
<%= form_with(model: , method: :post, url: set_persona_users_path, id: "persona_form", data: { turbo: false }) do |form| %>
  <%

    personas = []

    if current_user.has_cached_role?(:employee)
      personas << ["My Company", :employee]
    end

    if current_user.has_cached_role?(:investor)
      personas << ["My Investments",:investor]
    end

  %>
  <div class="form-group" data-controller="persona">
    <% selected = params[:persona].present? ? params[:persona] : current_user.curr_role&.to_sym %>
    <%= form.select :persona, personas, {selected: selected},
        { id: "persona", class: "form-control", aria: {
          label: "Choose persona"
        },
        data: { action: "change->persona#setPersona", toggle: "tooltip", title: "Choose Persona" } } %>
  </div>


  <%= form.submit "Submit", {hidden: true, id: "submit"}%>


<% end %>