<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CapHive Filing</title>

    <!-- Office.js must load before the add-in script, which calls Office.onReady. -->
    <script type="text/javascript" src="https://appsforoffice.microsoft.com/lib/1/hosted/office.js"></script>

    <%# Served through Sprockets so the URL is fingerprinted. The previous build shipped a
        static file from public/assets/, which Outlook's embedded WebView cached
        indefinitely — a shipped fix would never have reached installed users. %>
    <%= stylesheet_link_tag "mail_addin" %>

    <%# Enables the browser simulator when Office.js reports no Outlook host. Opt-in only
        (see OutlookAddinController#simulator_enabled?), so a deployed task pane opened in
        a plain browser still refuses. %>
    <% if simulator_enabled? %>
      <script type="text/javascript">window.CAPHIVE_SIMULATOR = true;</script>
    <% end %>

    <%= javascript_include_tag "custom/outlook_addin", defer: true %>
</head>
<body class="mail-addin">
    <%# The logo is the wordmark — it already reads "CapHive", so the <strong>CapHive</strong>
        that used to sit beside it printed the name twice in a 320px pane. %>
    <%# Served straight from public/img — this logo is not in the Sprockets load path, so
        image_tag would raise at precompile time. %>
    <div class="mail-addin__header">
        <img src="/img/logo-without-tagline.jpg" alt="CapHive">
    </div>

    <div class="mail-addin__container">
        <%= yield %>
    </div>
</body>
</html>
