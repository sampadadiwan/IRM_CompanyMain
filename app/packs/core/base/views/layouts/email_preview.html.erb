<% if @html_body %>
  <table role="presentation" class="main">
    <tr>
      <td class="wrapper">
        <table role="presentation" border="0" cellpadding="0" cellspacing="0">
          <tr>
            <td class="content-block">
              <p><strong>To:</strong> <%= @investor_access.email %></p>
              <p><strong>Subject:</strong> <%= @subject %></p>
            </td>
          </tr>
          <tr>
            <td class="content-block">
              <%= raw @html_body %>
            </td>
          </tr>
          <%# An oversized document is REFUSED at attach time, so it is simply missing from the
              list below - indistinguishable from an attachment_names pattern that matched
              nothing. Saying so here is the whole point of previewing before a send. %>
          <% if @oversized_attachments.present? %>
            <tr>
              <td class="content-block">
                <div class="alert alert-danger" style="margin:0;">
                  <strong>Not attached &mdash; over the <%= number_to_human_size(NotificationAttachmentPreflight::MAX_ATTACHMENT_BYTES) %> limit</strong>
                  <ul style="margin:6px 0 0;">
                    <% @oversized_attachments.each do |problem| %>
                      <li><%= problem %></li>
                    <% end %>
                  </ul>
                  <div style="margin-top:6px;">
                    Sending this notification will be stopped for every recipient, not just this one.
                    Reduce the file size, or share it from the portal instead of attaching it.
                  </div>
                </div>
              </td>
            </tr>
          <% end %>

          <% if @attachments.any? %>
            <tr>
              <td class="content-block">
                <h6>Attachments:</h6>
                <ul>
                  <% @attachments.each_with_index do |attachment, index| %>
                    <li>
                      <%= attachment.filename %>
                    </li>
                  <% end %>
                </ul>
              </td>
            </tr>
          <% end %>
        </table>
      </td>
    </tr>
  </table>
<% else %>
  <div class="alert alert-warning">
    <%= @error_message %>
  </div>
<% end %>
