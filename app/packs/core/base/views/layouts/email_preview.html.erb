<% if @html_body %>
  <%# Rendered with layout: false (the preview opens in its own tab), so NOTHING from the
      application stylesheet is available here - a Bootstrap `alert alert-danger` renders as
      plain black text, which is how the oversize warning below came to be invisible. Every
      rule the preview chrome needs is therefore defined here.

      Class selectors on purpose: the email body inlined further down carries the mailer
      layout's own <style> block (`table { width: 100% }`, `h6 { color: grey }`, `p, ul, ol
      { ... }`), and a class beats an element selector whichever order they arrive in. %>
  <style>
    .email-preview {
      background: #f6f6f6;
      box-sizing: border-box;
      font-family: sans-serif;
      margin: 0 auto;
      max-width: 700px;
      padding: 16px;
    }
    .email-preview__panel {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      margin-bottom: 12px;
      overflow: hidden;
    }
    .email-preview__badge {
      background: #eef2f7;
      border-bottom: 1px solid #e5e7eb;
      color: #4b5563;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: .06em;
      padding: 7px 14px;
      text-transform: uppercase;
    }
    .email-preview__meta {
      margin: 0;
      padding: 12px 14px;
    }
    .email-preview__row {
      display: flex;
      font-size: 14px;
      gap: 8px;
      padding: 3px 0;
    }
    .email-preview__label {
      color: #6b7280;
      flex: 0 0 68px;
      font-weight: bold;
    }
    .email-preview__value {
      color: #111827;
      word-break: break-word;
    }
    .email-preview__body {
      padding: 0;
    }

    /* The oversize warning. Red because the document the admin came here to check is NOT
       going to be attached, and the attachment list below cannot show its absence. */
    .email-preview__alert {
      background: #fdecee;
      border: 1px solid #f0a5ad;
      border-left: 4px solid #c22032;
      border-radius: 6px;
      color: #7d1420;
      margin-bottom: 12px;
      padding: 12px 14px;
    }
    .email-preview__alert-title {
      color: #a31624;
      font-size: 14px;
      font-weight: bold;
      margin: 0 0 8px;
    }
    .email-preview__alert-list {
      margin: 0 0 8px;
      padding-left: 20px;
    }
    .email-preview__alert-list li {
      font-size: 14px;
      list-style: disc;
      margin: 0 0 4px;
      padding: 0;
    }
    /* Red, not the usual blue: inside a red panel a blue link reads as belonging to something
       else. Bold because it is the actionable thing in the alert. */
    .email-preview__alert-link {
      color: #7d1420;
      font-weight: bold;
      text-decoration: underline;
    }
    .email-preview__alert-link:hover {
      color: #4d0b13;
    }
    .email-preview__alert-note {
      color: #7d1420;
      font-size: 13px;
      margin: 0;
    }

    .email-preview__attachments {
      padding: 12px 14px;
    }
    .email-preview__attachments h6 {
      color: #374151;
      font-size: 12px;
      letter-spacing: .04em;
      margin: 0 0 8px;
      text-transform: uppercase;
    }
    .email-preview__attachments ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .email-preview__attachments li {
      border-top: 1px solid #f1f2f4;
      color: #111827;
      font-size: 14px;
      list-style: none;
      margin: 0;
      padding: 6px 0;
      word-break: break-word;
    }
    .email-preview__attachments li:first-child {
      border-top: 0;
    }
    .email-preview__file {
      color: #1b62c9;
      text-decoration: underline;
    }
    .email-preview__file:hover {
      color: #0f4795;
    }
    .email-preview__empty {
      color: #6b7280;
      font-size: 13px;
      margin: 0;
    }
  </style>

  <div class="email-preview">
    <div class="email-preview__panel">
      <div class="email-preview__badge">Preview &mdash; this email has not been sent</div>
      <div class="email-preview__meta">
        <div class="email-preview__row">
          <span class="email-preview__label">To</span>
          <span class="email-preview__value"><%= @investor_access.email %></span>
        </div>
        <div class="email-preview__row">
          <span class="email-preview__label">Subject</span>
          <span class="email-preview__value"><%= @subject %></span>
        </div>
      </div>
    </div>

    <%# Above the body, not below it: an oversized document is REFUSED at attach time, so it is
        simply missing from the list further down - indistinguishable from an attachment_names
        pattern that matched nothing. Saying so, in red, before the admin starts reading the body
        is the whole point of previewing before a send. %>
    <% if @oversized_attachments.present? %>
      <div class="email-preview__alert" role="alert">
        <p class="email-preview__alert-title">
          Not attached &mdash; over the <%= number_to_human_size(NotificationAttachmentPreflight::MAX_ATTACHMENT_BYTES) %> limit
        </p>
        <ul class="email-preview__alert-list">
          <% @oversized_attachments.each do |problem| %>
            <%# The document name links to the file: this is the one document in the preview the
                attachment list cannot reach, since it was refused at attach time. The sentence
                reads identically either way - only the name becomes a link. %>
            <% url = problem[:document] && document_file_url(problem[:document]) %>
            <li>
              <% if url %>
                <%= link_to problem[:name], url, target: "_blank", rel: "noopener",
                            class: "email-preview__alert-link" %><%= problem[:rest] %>
              <% else %>
                <%= problem[:message] %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <p class="email-preview__alert-note">
          Sending this notification will be stopped for every recipient, not just this one.
          Reduce the file size, or share it from the portal instead of attaching it.
        </p>
      </div>
    <% end %>

    <div class="email-preview__panel">
      <div class="email-preview__body">
        <%= raw @html_body %>
      </div>
    </div>

    <%# The heading text and the <h6> + sibling <ul><li> shape are asserted by the @attachment
        scenarios in features/fund/fund_commitment_adhoc_notification.feature - the absence of
        the heading is what "no attachments listed" means there. %>
    <% if @attachments.any? %>
      <div class="email-preview__panel">
        <div class="email-preview__attachments">
          <h6>Attachments: <%= @attachments.count %></h6>
          <ul>
            <% @attachments.each do |attachment| %>
              <%# Linked so the admin can open what would actually be sent. Unlinked - plain
                  text - when no Document of that filename could be resolved (a generated part,
                  or a file the current user may not open), because a dead link would be worse
                  than a name. %>
              <% document = @attachment_documents[attachment.filename.to_s] %>
              <% url = document && document_file_url(document) %>
              <li>
                <% if url %>
                  <%= link_to attachment.filename, url, target: "_blank", rel: "noopener",
                              class: "email-preview__file" %>
                <% else %>
                  <%= attachment.filename %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% elsif @oversized_attachments.blank? %>
      <div class="email-preview__panel">
        <div class="email-preview__attachments">
          <p class="email-preview__empty">No attachments.</p>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-warning">
    <%= @error_message %>
  </div>
<% end %>
