<!DOCTYPE html>

<html lang="en" dir="ltr" data-bs-theme="" data-color-theme="Blue_Theme">

<head>
  <!-- Required meta tags -->
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= render "/layouts/locale_date_meta" %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "highcharts_dashboards", media: "all" %>
  <%= javascript_importmap_tags %>


  <!-- Favicon icon-->
  <link rel="shortcut icon" type="image/png" href="/favicon.png" />

  <!-- Core Css -->
  <link rel="stylesheet" href="/modernize/css/styles.css" />


  <% if (@current_entity && @current_entity.custom_css.present?) || params[:custom_css].present? %>
    <link rel="stylesheet" href="/css/<%= params[:custom_css] || @current_entity&.custom_css %>" />
  <% end %>


  <!-- In application layout or Markdown partial -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.2.0/github-markdown-light.min.css">



    <script src="/modernize/libs/jquery/dist/jquery.min.js"></script>

    <script src="https://code.jquery.com/ui/1.14.2/jquery-ui.min.js" integrity="sha384-tBcEcHGtNy7/Mx08+YxuvQ6v6s0N2jgehtFiT+bLtGwTj/txXtB/L5GqXfggm5sS" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.2/themes/base/jquery-ui.css">

    <!-- For playing videos in docs -->
    <link href="https://vjs.zencdn.net/7.17.0/video-js.css" rel="stylesheet" />

    <!-- Datatables -->
    <script type="text/javascript" src="https://cdn.datatables.net/2.0.2/js/dataTables.min.js" integrity="sha384-A0y8TjgNQF/hT5LZnO7Nj/yjeiCAvMxCuPkPeQIEPz+Fu2Zv0lvusugdMUB/OJ9w" crossorigin="anonymous"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/2.0.2/js/dataTables.bootstrap5.min.js" integrity="sha384-T9HUgnI3kVztnb7aunhe+/yYerXqJuXA0D8m1XOKGW32fUfy4cKFy43DgpPdiHm7" crossorigin="anonymous"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.2/css/dataTables.bootstrap5.min.css">
    <script type="text/javascript" src="https://cdn.datatables.net/plug-ins/2.0.2/sorting/formatted-numbers.js" integrity="sha384-D6a/twmKwcHEmPpFzpRXRTLcJROiYRxkZBVj1OfurGyPdTeEMC/7/YnJ2wsm/FKO" crossorigin="anonymous"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/responsive/3.0.0/js/dataTables.responsive.min.js" integrity="sha384-3QJ3oFKjwRGe43JjxPcveBt9DFAHQzlmLNT9weJqvssSjIUWJ8CTdsqXPLS70wpH" crossorigin="anonymous"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/3.0.0/css/responsive.dataTables.min.css">

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js" integrity="sha384-O/ymMhrYXP5tgvTj27eAjKZODlpm7nIVeAkhRL7i9mdenmlJGAjstxMy/bKdklFZ" crossorigin="anonymous"></script>
    <%# Chart.js and chartjs-plugin-datalabels are loaded once via the importmap (4.5.1 / 2.2.0);
        charts_handler.js exposes window.Chart and window.ChartDataLabels for inline view scripts %>


    <!-- PDFTron -->
    <script src='/lib/webviewer.min.js'></script>
    <script src='/lib/core/webviewer-core.min.js'></script>
    <script src='/lib/core/pdf/PDFNet.js'></script>

    <script src="/js/uppy.min.js"></script>


    <!-- x-spreadsheet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/x-data-spreadsheet@1.1.9/dist/xspreadsheet.css" />

    <!-- x-spreadsheet JS -->
    <script src="https://unpkg.com/x-data-spreadsheet@1.1.9/dist/xspreadsheet.js" integrity="sha384-JCkvYwhpxJNPUlVfdLGiX2ukj3j3jsQUSmzb1LihEGHGA1weF6xaDc43WLXavjWD" crossorigin="anonymous"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/shim.min.js" integrity="sha384-tIsPSMlIpUI7LPMRgRBXh/b/qbUWyK7nMWHqGiu9gwZP9fPDTNhXwRtGOmTJSLMK" crossorigin="anonymous"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js" integrity="sha384-EnyY0/GSHQGSxSgMwaIPzSESbqoOLSexfnSMN2AP+39Ckmn92stwABZynq1JyzdT" crossorigin="anonymous"></script>
    <script src="/vendor/sheetjs/xlsxspread.min.js"></script>


     <!-- Include the JS for AG Grid -->
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-enterprise@30.2.1/dist/ag-grid-enterprise.min.js" integrity="sha384-k75LVrr0bZJipEZUFDoFGdK1Kwwl8pWSlkbh1lPAXzZom4nM4Qvl2ZxF7NNhYUKj" crossorigin="anonymous"></script>

    <!-- Include the core CSS, this is needed by the grid.
         CSS is pinned to 32.3.9, NOT 30.2.1: ag-theme-quartz.css does not exist in v30 (404) and
         v33+ removed the legacy theme CSS entirely. 32.3.9 is the last release shipping the legacy
         quartz theme, and its legacy CSS is compatible with the v30 enterprise JS above. -->
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/ag-grid-community@32.3.9/styles/ag-grid.css"/>
    <!-- Include the theme CSS, only need to import the theme you are going to use -->
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/ag-grid-community@32.3.9/styles/ag-theme-quartz.css"/>

    <%# Trix CSS version must match the trix JS served by the action_text-trix gem (see Gemfile.lock) %>
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/trix@2.1.19/dist/trix.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" type="text/css">

    <script src="https://cdn.jsdelivr.net/npm/command-pal@0.2.11" integrity="sha384-cQE6pCyPxbm5psju9y4xlDGbhevcJ5EDwrgkB1KXSAfjweWj4f/Rj8tBOmRYglHA" crossorigin="anonymous"></script>

  <title>CapHive</title>
</head>

<body data-controller="confirm tooltip" data-turbo-prefetch="false" data-density="">


  <!-- Preloader -->
  <div class="preloader">
    <img src="/img/loading.gif" alt="loader" class="lds-ripple img-fluid" />
  </div>
  <div id="main-wrapper">

    <%= render "/layouts/modernize/sidebar_main" %>

    <div class="page-wrapper" data-controller="commandpal">

      <%= render "/layouts/modernize/topbar" %>
      <%#= render "/layouts/modernize/sidebar_horizontal" %>

      <div class="body-wrapper">
        <main class="container-fluid mw-100">

          <%= turbo_stream_from "user_alert_#{current_user.id}" if current_user %>
          <div id="user_alert"></div>

          <%= render "/users/reset_password" if (current_user && current_user.reset_password?) %>
          <%# M8 — required two-factor banner (support / super without a verified method); renders nothing for anyone else %>
          <%= render "/users/two_factor_required_banner" if current_user %>
          <%= render "/layouts/accept_terms" if (current_user && !current_user.accept_terms) %>

          <span id="alert"></span>

          <%= render "/layouts/alerts" %>
          <%= render "/layouts/breadcrumbs" %>
          <%= render HelpSlideOut.new(class_name: "#{controller_path.classify}", action: controller.action_name, id: params[:id], current_user: current_user) %>

          <% if params[:audit_trail].present? && params[:id].present? %>
            <!-- Audit Trail of the record with id -->
            <%= render "/layouts/audit" %>
          <% elsif params[:ai_checks].present? && params[:id].present? %>
            <!-- Audit Trail of the record with id -->
            <%= render "/ai_checks/show_checks" %>
          <% else %>
            <!-- Page Content -->
            <%= yield %>
          <% end %>

        </main>
      </div>

      <%= render "/layouts/modernize/theme_chooser" %>

    </div>

    <%= render "/layouts/modernize/searchbar" %>
    <%#= render "/layouts/modernize/sidebar_offcanvas" %>

    <%= render "/layouts/logout_modal" %>
    <%= render "/layouts/confirm" %>
    <%= render "/layouts/frame_error" %>
    <%= render "/layouts/terms" if (current_user && !current_user.accept_terms) %>

  </div>
  <div class="dark-transparent sidebartoggler"></div>
  <!-- Import Js Files -->
  <script src="/modernize/js/theme.js"></script>
  <script src="/modernize/js/app.min.js"></script>
  <script src="/modernize/js/app.init.js"></script>
  <script src="/modernize/libs/simplebar/dist/simplebar.min.js"></script>
  <script src="/modernize/js/sidebarmenu.js"></script>
  <script src="/modernize/js/widget/ui-card-init.js"></script>

  <%# Microsoft Clarity session recording was removed deliberately. It recorded
      authenticated sessions inside the platform and tagged them with the client
      fund's name, entity id and user role, which is not something we are willing
      to tell a prospect's GC we do. The public cookie policy also states that the
      signed-in application runs no analytics or marketing cookies; this block
      contradicted that. Do not reintroduce it without a privacy review and a
      corresponding change to the cookie policy. The CLARITY_CODE environment
      variable is now unused. %>

</body>

</html>
