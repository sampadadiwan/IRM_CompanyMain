<!DOCTYPE html>
<html lang="en" dir="ltr" data-bs-theme="light" data-color-theme="Blue_Theme">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="shortcut icon" type="image/png" href="/favicon.png" />

  <%# Modernize core CSS carries the Bootstrap variables the .ai-md guide styling reads. %>
  <link rel="stylesheet" href="/modernize/css/styles.css" />

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <title><%= [@title, "CapHive"].compact.join(" — ") %></title>
</head>

<body class="public-guide">
  <header class="public-guide__header">
    <div class="public-guide__bar">
      <a href="https://caphive.com/" class="public-guide__brand">
        <%= image_tag("/img/logo_big.png", alt: "CapHive", class: "public-guide__logo") %>
      </a>
      <%= link_to "Sign in", new_user_session_path, class: "btn btn-primary btn-sm" %>
    </div>
  </header>

  <main class="public-guide__main">
    <%- flash.each do |name, msg| -%>
      <%= content_tag :div, msg, id: "flash_#{name}", class: "alert alert-info" if msg.is_a?(String) %>
    <%- end -%>

    <%= yield %>
  </main>

  <footer class="public-guide__footer">
    <p class="mb-0">
      Still stuck? Contact your CapHive administrator, or
      <%= link_to "return to sign in", new_user_session_path %>.
    </p>
  </footer>

  <script src="/modernize/libs/jquery/dist/jquery.min.js"></script>
  <script src="/modernize/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
