<!DOCTYPE html>
<html class="reveal-presentation">
  <head>
    <%# Explicit, so ₹ and × survive a saved or printed deck (the HTTP header is not always there). %>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? yield(:title) : "Presentation" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "/layouts/locale_date_meta" %>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Play CDN for isolation and rapid development) -->
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
            },
          },
        },
      }
    </script>

    <!-- Reveal.js Core Styles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/reveal.min.css">
    <!-- Base Reveal.js Theme (we'll override much with Tailwind) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/theme/white.min.css" id="theme">

    <!-- Tabler Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.50.0/dist/tabler-icons.min.css">

    <style>
      :root {
        /* Default: Corporate Navy (Clean, Professional) */
        --palette-bg: #ffffff;
        --palette-surface: #f8fafc;
        --palette-primary: #0f172a; /* Navy 900 */
        --palette-secondary: #334155; /* Blue 700 */
        --palette-accent: #3b82f6; /* Blue 500 - Highlight */
        --palette-text: #0f172a;
        --palette-text-muted: #64748b;
        --palette-border: #e2e8f0;
      }

      body.theme-executive_emerald {
        --palette-bg: #ffffff;
        --palette-surface: #f0fdf4;
        --palette-primary: #064e3b; /* Green 900 */
        --palette-secondary: #065f46; /* Green 800 */
        --palette-accent: #10b981; /* Emerald 500 - Highlight */
        --palette-text: #064e3b;
        --palette-text-muted: #3f6212;
        --palette-border: #dcfce7;
      }

      body.theme-modern_slate {
        --palette-bg: #ffffff;
        --palette-surface: #f1f5f9;
        --palette-primary: #1e293b; /* Slate 800 */
        --palette-secondary: #475569; /* Slate 600 */
        --palette-accent: #6366f1; /* Indigo 500 - Highlight */
        --palette-text: #0f172a;
        --palette-text-muted: #64748b;
        --palette-border: #e2e8f0;
      }

      body.theme-midnight_onyx {
        --palette-bg: #0f172a;
        --palette-surface: #1e293b;
        --palette-primary: #f8fafc;
        --palette-secondary: #cbd5e1;
        --palette-accent: #fbbf24; /* Amber 400 - Professional Gold */
        --palette-text: #f8fafc;
        --palette-text-muted: #94a3b8;
        --palette-border: #334155;
      }

      /* ── AI Slides (assistants/presentation_templates): one frame, one type scale ─────────────── */
      .cs-section { height: 100%; }
      .cs-slide { display: flex; flex-direction: column; gap: 36px; width: 1920px; height: 1080px;
                  padding: 72px 104px 44px; box-sizing: border-box; color: var(--palette-text); }
      .cs-head { display: flex; align-items: center; gap: 28px; }
      .cs-icon { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 76px;
                 width: 76px; height: 76px; border-radius: 22px; font-size: 40px;
                 background: var(--palette-surface); color: var(--palette-accent); border: 1px solid var(--palette-border); }
      .cs-icon-sm { flex-basis: 48px; width: 48px; height: 48px; border-radius: 14px; font-size: 26px; margin-right: 16px; }
      .cs-kicker { display: flex; align-items: center; font-size: 22px; color: var(--palette-text-muted); margin-bottom: 8px; }
      .reveal .cs-title { font-size: 56px; font-weight: 600; color: var(--palette-primary); line-height: 1.15; }
      .cs-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; justify-content: center; }
      .cs-takeaway { display: flex; gap: 22px; align-items: flex-start; padding: 26px 34px; border-radius: 18px;
                     background: var(--palette-surface); border-left: 6px solid var(--palette-accent);
                     font-size: 27px; line-height: 1.45; color: var(--palette-secondary); }
      .cs-takeaway > i { font-size: 36px; color: var(--palette-accent); margin-top: 2px; }
      .cs-takeaway strong { display: block; font-size: 20px; font-weight: 600; color: var(--palette-text-muted); margin-bottom: 4px; }
      /* Right padding keeps the slide number clear of Reveal's arrows. */
      .cs-foot { display: flex; justify-content: space-between; padding: 18px 120px 0 0; font-size: 19px;
                 color: var(--palette-text-muted); border-top: 1px solid var(--palette-border); }

      /* Tones: good news, bad news, neither */
      .cs-tone-positive { --cs-tone: #059669; --cs-tone-bg: #ecfdf5; }
      .cs-tone-negative { --cs-tone: #e11d48; --cs-tone-bg: #fff1f2; }
      .cs-tone-neutral  { --cs-tone: var(--palette-accent); --cs-tone-bg: var(--palette-surface); }
      .cs-icon-tone { color: var(--cs-tone); background: var(--cs-tone-bg); border-color: transparent; }

      /* Title slide */
      .cs-title-slide { justify-content: space-between; background: linear-gradient(120deg, var(--palette-surface), var(--palette-bg) 60%); }
      .cs-title-grid { flex: 1 1 auto; display: grid; grid-template-columns: 1.35fr 1fr; gap: 80px; align-items: center; }
      .reveal .cs-hero { font-size: 92px; font-weight: 600; line-height: 1.05; color: var(--palette-primary); margin: 18px 0 28px; }
      .cs-subtitle { font-size: 32px; line-height: 1.45; color: var(--palette-secondary); max-width: 1000px; }
      .cs-hero-figures { display: flex; flex-direction: column; gap: 22px; }
      .cs-hero-figure { padding: 28px 34px; border-radius: 20px; background: var(--palette-bg); border: 1px solid var(--palette-border);
                        border-left: 6px solid var(--palette-accent); box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05); }

      /* Key figures */
      .cs-figures { display: grid; gap: 28px; }
      .cs-cols-1 { grid-template-columns: 1fr; } .cs-cols-2 { grid-template-columns: repeat(2, 1fr); }
      .cs-cols-3 { grid-template-columns: repeat(3, 1fr); } .cs-cols-4 { grid-template-columns: repeat(4, 1fr); }
      .cs-figure { padding: 34px; border-radius: 22px; background: var(--palette-bg); border: 1px solid var(--palette-border);
                   border-top: 6px solid var(--cs-tone); box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05); }
      .cs-figure .cs-icon { margin-bottom: 26px; }
      .cs-figure-value { font-size: 64px; font-weight: 300; line-height: 1.1; color: var(--palette-primary); }
      .cs-figure-label { font-size: 25px; margin-top: 10px; color: var(--palette-secondary); }
      .cs-figure-context { font-size: 21px; margin-top: 8px; color: var(--palette-text-muted); }

      /* Cards: insights, chart, table, comparison */
      .cs-insights { display: grid; gap: 26px; }
      .cs-card { display: flex; gap: 24px; padding: 30px 32px; border-radius: 22px; background: var(--palette-bg);
                 border: 1px solid var(--palette-border); box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05); }
      .cs-card-title { display: flex; align-items: center; font-size: 28px; font-weight: 600; color: var(--palette-primary); margin-bottom: 8px; }
      .cs-card-text { font-size: 24px; line-height: 1.45; color: var(--palette-secondary); }
      .cs-chart-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: 40px; height: 100%; align-items: stretch; }
      .cs-chart-only { grid-template-columns: 1fr; }
      .cs-chart-card { min-height: 0; }
      .cs-chart-box { position: relative; width: 100%; height: 520px; }
      .cs-notes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; justify-content: center; gap: 22px; }
      .cs-notes li { display: flex; gap: 14px; font-size: 25px; line-height: 1.45; color: var(--palette-secondary); }
      .cs-notes li i { color: var(--palette-accent); font-size: 22px; margin-top: 8px; }
      .cs-table-card { display: block; padding: 8px 12px; }
      .cs-table { width: 100%; border-collapse: collapse; font-size: 23px; }
      .cs-table th { text-align: left; font-weight: 600; font-size: 21px; color: var(--palette-text-muted);
                     padding: 18px 20px; border-bottom: 2px solid var(--palette-border); }
      .cs-table td { padding: 16px 20px; border-bottom: 1px solid var(--palette-border); color: var(--palette-secondary); }
      .cs-table tr:last-child td { border-bottom: 0; }
      .cs-table .cs-highlight { color: var(--palette-primary); font-weight: 600; background: var(--palette-surface); }
      .cs-badge { display: inline-block; padding: 4px 14px; border-radius: 999px; font-size: 20px; color: var(--cs-tone); background: var(--cs-tone-bg); }
      .cs-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
      .cs-compare-side { flex-direction: column; }
      .cs-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 22px; }
      /* Reveal indents lists (".reveal ol/ul { margin-left: … }"); the slides' own lists sit flush. */
      .reveal .cs-steps, .reveal .cs-notes { display: flex; margin: 0; padding: 0; }
      .cs-steps li { display: flex; gap: 26px; align-items: flex-start; padding: 26px 30px; border-radius: 20px;
                     border: 1px solid var(--palette-border); background: var(--palette-bg); }
      .cs-step-number { flex: 0 0 56px; width: 56px; height: 56px; border-radius: 50%; display: inline-flex; align-items: center;
                        justify-content: center; font-size: 26px; font-weight: 600; color: #fff; background: var(--palette-accent); }

      /* Regenerate (generate_slides): out of the way, hidden in print */
      .cs-regenerate { position: fixed; top: 16px; right: 20px; z-index: 50; font: 500 14px/1 "Inter", sans-serif;
                       padding: 10px 16px; border-radius: 999px; background: #fff; color: var(--palette-secondary);
                       border: 1px solid var(--palette-border); box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08); text-decoration: none; }
      .cs-regenerate:hover { color: var(--palette-accent); }
      @media print { .cs-regenerate { display: none; } }

      /* Global resets and layout */
      .reveal {
        font-family: "Inter", sans-serif;
        background-color: var(--palette-bg);
        color: var(--palette-text);
      }

      .reveal .slides {
        text-align: left;
      }

      .reveal .slides section {
        padding: 0;
      }

      /* Reset headings for modern minimalist look */
      .reveal h1, .reveal h2, .reveal h3, .reveal h4, .reveal h5, .reveal h6 {
        text-transform: none;
        margin: 0;
        line-height: 1.1;
        font-family: inherit;
        color: var(--palette-primary);
        letter-spacing: -0.02em;
      }

      /* Premium Slide Standard Styles */
      .reveal .slides section.slide-premium {
        height: 100%;
        width: 100%;
        top: 0;
        box-sizing: border-box;
        background: transparent;
        overflow: hidden;
      }

      .slide-premium .slide-content {
        display: flex;
        flex-direction: column;
        justify-content: center; /* Center content vertically for better balance */
        align-items: flex-start;
        height: 100%;
        width: 100%;
        padding: 5% 8%; /* Breathable sides, but more vertical efficiency */
        box-sizing: border-box;
      }

      .reveal .slides section.slide-premium header {
        width: 100%;
        margin-bottom: 40px; /* Reduced from 60px for tighter top */
      }

      /* Glassmorphism Utilities */
      .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px) saturate(180%);
        -webkit-backdrop-filter: blur(12px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px; /* 2026 Modern Aesthetic */
      }

      .theme-midnight_onyx .glass-card {
        background: rgba(30, 41, 59, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .glass-border {
        border: 1px solid var(--palette-border);
        border-radius: 24px;
      }

      /* Animations */
      @keyframes softFadeIn {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .animate-soft-fade {
        animation: softFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      .stagger-1 { animation-delay: 0.1s; }
      .stagger-2 { animation-delay: 0.2s; }
      .stagger-3 { animation-delay: 0.3s; }
      .stagger-4 { animation-delay: 0.4s; }
      .stagger-5 { animation-delay: 0.5s; }
      .stagger-6 { animation-delay: 0.6s; }

      /* Print styles for PDF Export */
      @media print {
        :root {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .reveal .slides {
          transform: none !important;
          width: 100% !important;
          height: 100% !important;
          top: 0 !important;
          left: 0 !important;
        }

        .reveal .slides section {
          page-break-after: always !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
          height: 100% !important;
          display: block !important;
          opacity: 1 !important;
          visibility: visible !important;
        }

        .glass-card {
          /* Force backgrounds in PDF */
          background: rgba(255, 255, 255, 0.1) !important;
          -webkit-print-color-adjust: exact;
        }

        .theme-midnight_onyx .glass-card {
          background: rgba(30, 41, 59, 0.8) !important;
        }
      }
      /* Editable Slide Styles */
      [contenteditable="true"]:focus {
        outline: none;
      }
      .reveal .slides section[contenteditable="true"] {
        cursor: text;
      }
    </style>

    <%= yield :head %>
  </head>

  <body class="bg-slate-50 theme-<%= @palette || 'serene_blue' %>">
    <div id="body_class_trigger" style="display: none;" data-palette="<%= @palette || 'serene_blue' %>"></div>

    <script>
      // Listen for palette changes via Turbo Stream
      (function() {
        document.addEventListener('DOMContentLoaded', () => {
          const trigger = document.getElementById('body_class_trigger');
          if (!trigger) return;

          const updateBodyClass = () => {
            const palette = trigger.getAttribute('data-palette');
            if (palette) {
              const newClass = `bg-slate-50 theme-${palette}`;
              if (document.body.className !== newClass) {
                document.body.className = newClass;
              }
            }
          };

          const observer = new MutationObserver(updateBodyClass);
          observer.observe(trigger, { attributes: true, attributeFilter: ['data-palette'] });

          // Initial run
          updateBodyClass();
        });
      })();
    </script>

    <% if @print_pdf %>
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          setTimeout(() => {
            // Reveal.js needs a moment to layout
            window.print();
          }, 2000);
        });
      </script>
    <% end %>

    <%= yield :turbo_streams %>

    <%# The inline slide editor saves to a portfolio report extract, so it is attached only on an extract's
        page. Other decks using this layout (an assistant chat's AI Slides) have nothing to save to: building
        the URL there raised "No route matches … update_slides_content … id: nil". %>
    <% slides_editor_url = (update_slides_content_portfolio_report_extract_path(params[:id]) if controller_name == "portfolio_report_extracts" && params[:id].present?) %>
    <div class="reveal"
         <% if slides_editor_url %>data-controller="slides-editor" data-slides-editor-url-value="<%= slides_editor_url %>"<% end %>>

      <!-- Saving Indicator -->
      <div data-slides-editor-target="indicator"
           class="fixed top-4 right-4 z-[9999] bg-slate-900/80 text-white px-4 py-2 rounded-full text-xs font-semibold opacity-0 transition-opacity duration-300 pointer-events-none">
        Saving...
      </div>

      <div class="slides" id="slides_container"
           data-slides-editor-target="container"
           data-action="input->slides-editor#handleInput">
        <%= yield %>
      </div>
    </div>

    <!-- Reveal.js Core Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/reveal.js" integrity="sha384-rZIIVPQD/+U9IL3I62KrBHuVtPgYv+xdXvER5RBiVQRszJEJfLKRrcrZwI7fhcHT" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/plugin/notes/notes.min.js" integrity="sha384-RQD9EMyXsgqtoziP1gWQ5pboKqH0T6EqGPXp/r9DNN4t3iNzDnDYeuR0yQOLQ1Yf" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/plugin/markdown/markdown.min.js" integrity="sha384-SzehdV/wXZaCRWWjoj1n2ohaYv8Q08mj+nPimNjAB1lCWhup41K/57Hq5NoM/nRq" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/plugin/highlight/highlight.min.js" integrity="sha384-baEsj5jw38DYcKcEK0Qt3COpAiP2NO81DHK809rYRqJm0xKJQmOsPL52hS+QU7yv" crossorigin="anonymous"></script>

    <!-- Load the Rails JS bundle so Stimulus controllers (e.g., chart-renderer) work in presentation mode -->
    <%= javascript_importmap_tags %>

    <script>
      // Initialize / refresh Reveal.js.
      (function () {
        // High Fidelity PDF Export: Standardize query param for Reveal.js
        if (window.location.search.indexOf('print_pdf=true') !== -1 && window.location.search.indexOf('print-pdf') === -1) {
          const url = new URL(window.location);
          url.searchParams.set('print-pdf', '');
          window.history.replaceState({}, '', url.toString());
        }

        const initOrSync = () => {
          if (!window.Reveal || typeof window.Reveal.initialize !== 'function') return

          try {
            if (typeof window.Reveal.isReady === 'function' && window.Reveal.isReady()) {
              if (typeof window.Reveal.sync === 'function') window.Reveal.sync()
              if (typeof window.Reveal.layout === 'function') window.Reveal.layout()
              return
            }

            window.Reveal.initialize({
              hash: true,
              margin: 0,
              width: 1920,
              height: 1080,
              minScale: 0.2,
              maxScale: 2.0,
              center: false,
              pdfMaxPagesPerSlide: 1,
              pdfSeparateIndex: true,
              plugins: [ RevealMarkdown, RevealHighlight, RevealNotes ]
            })
          } catch (e) {
            console.error('[presentation] Reveal init/sync failed', e)
          }
        }

        document.addEventListener('DOMContentLoaded', initOrSync)
        document.addEventListener('turbo:load', initOrSync)

        const slidesEl = document.getElementById('slides_container')
        if (slidesEl && window.MutationObserver) {
          const observer = new MutationObserver(() => initOrSync())
          observer.observe(slidesEl, { childList: true })
        }
      })()
    </script>
  </body>
</html>
