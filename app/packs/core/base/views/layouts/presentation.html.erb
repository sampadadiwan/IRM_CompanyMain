<!DOCTYPE html>
<html class="reveal-presentation">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Presentation" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "/layouts/locale_date_meta" %>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Play CDN for isolation and rapid development) -->
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
            },
          },
        },
      }
    </script>

    <!-- Reveal.js Core Styles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/reveal.min.css">
    <!-- Base Reveal.js Theme (we'll override much with Tailwind) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/theme/white.min.css" id="theme">

    <!-- Tabler Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.45.0/tabler-icons.min.css">

    <style>
      :root {
        /* Default: Corporate Navy (Clean, Professional) */
        --palette-bg: #ffffff;
        --palette-surface: #f8fafc;
        --palette-primary: #0f172a; /* Navy 900 */
        --palette-secondary: #334155; /* Blue 700 */
        --palette-accent: #3b82f6; /* Blue 500 - Highlight */
        --palette-text: #0f172a;
        --palette-text-muted: #64748b;
        --palette-border: #e2e8f0;
      }

      body.theme-executive_emerald {
        --palette-bg: #ffffff;
        --palette-surface: #f0fdf4;
        --palette-primary: #064e3b; /* Green 900 */
        --palette-secondary: #065f46; /* Green 800 */
        --palette-accent: #10b981; /* Emerald 500 - Highlight */
        --palette-text: #064e3b;
        --palette-text-muted: #3f6212;
        --palette-border: #dcfce7;
      }

      body.theme-modern_slate {
        --palette-bg: #ffffff;
        --palette-surface: #f1f5f9;
        --palette-primary: #1e293b; /* Slate 800 */
        --palette-secondary: #475569; /* Slate 600 */
        --palette-accent: #6366f1; /* Indigo 500 - Highlight */
        --palette-text: #0f172a;
        --palette-text-muted: #64748b;
        --palette-border: #e2e8f0;
      }

      body.theme-midnight_onyx {
        --palette-bg: #0f172a;
        --palette-surface: #1e293b;
        --palette-primary: #f8fafc;
        --palette-secondary: #cbd5e1;
        --palette-accent: #fbbf24; /* Amber 400 - Professional Gold */
        --palette-text: #f8fafc;
        --palette-text-muted: #94a3b8;
        --palette-border: #334155;
      }

      /* Global resets and layout */
      .reveal {
        font-family: "Inter", sans-serif;
        background-color: var(--palette-bg);
        color: var(--palette-text);
      }

      .reveal .slides {
        text-align: left;
      }

      .reveal .slides section {
        padding: 0;
      }

      /* Reset headings for modern minimalist look */
      .reveal h1, .reveal h2, .reveal h3, .reveal h4, .reveal h5, .reveal h6 {
        text-transform: none;
        margin: 0;
        line-height: 1.1;
        font-family: inherit;
        color: var(--palette-primary);
        letter-spacing: -0.02em;
      }

      /* Premium Slide Standard Styles */
      .reveal .slides section.slide-premium {
        height: 100%;
        width: 100%;
        top: 0;
        box-sizing: border-box;
        background: transparent;
        overflow: hidden;
      }

      .slide-premium .slide-content {
        display: flex;
        flex-direction: column;
        justify-content: center; /* Center content vertically for better balance */
        align-items: flex-start;
        height: 100%;
        width: 100%;
        padding: 5% 8%; /* Breathable sides, but more vertical efficiency */
        box-sizing: border-box;
      }

      .reveal .slides section.slide-premium header {
        width: 100%;
        margin-bottom: 40px; /* Reduced from 60px for tighter top */
      }

      /* Glassmorphism Utilities */
      .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px) saturate(180%);
        -webkit-backdrop-filter: blur(12px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px; /* 2026 Modern Aesthetic */
      }

      .theme-midnight_onyx .glass-card {
        background: rgba(30, 41, 59, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .glass-border {
        border: 1px solid var(--palette-border);
        border-radius: 24px;
      }

      /* Animations */
      @keyframes softFadeIn {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .animate-soft-fade {
        animation: softFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      .stagger-1 { animation-delay: 0.1s; }
      .stagger-2 { animation-delay: 0.2s; }
      .stagger-3 { animation-delay: 0.3s; }
      .stagger-4 { animation-delay: 0.4s; }
      .stagger-5 { animation-delay: 0.5s; }
      .stagger-6 { animation-delay: 0.6s; }

      /* Print styles for PDF Export */
      @media print {
        :root {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .reveal .slides {
          transform: none !important;
          width: 100% !important;
          height: 100% !important;
          top: 0 !important;
          left: 0 !important;
        }

        .reveal .slides section {
          page-break-after: always !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
          height: 100% !important;
          display: block !important;
          opacity: 1 !important;
          visibility: visible !important;
        }

        .glass-card {
          /* Force backgrounds in PDF */
          background: rgba(255, 255, 255, 0.1) !important;
          -webkit-print-color-adjust: exact;
        }

        .theme-midnight_onyx .glass-card {
          background: rgba(30, 41, 59, 0.8) !important;
        }
      }
      /* Editable Slide Styles */
      [contenteditable="true"]:focus {
        outline: none;
      }
      .reveal .slides section[contenteditable="true"] {
        cursor: text;
      }
    </style>

    <%= yield :head %>
  </head>

  <body class="bg-slate-50 theme-<%= @palette || 'serene_blue' %>">
    <div id="body_class_trigger" style="display: none;" data-palette="<%= @palette || 'serene_blue' %>"></div>

    <script>
      // Listen for palette changes via Turbo Stream
      (function() {
        document.addEventListener('DOMContentLoaded', () => {
          const trigger = document.getElementById('body_class_trigger');
          if (!trigger) return;

          const updateBodyClass = () => {
            const palette = trigger.getAttribute('data-palette');
            if (palette) {
              const newClass = `bg-slate-50 theme-${palette}`;
              if (document.body.className !== newClass) {
                document.body.className = newClass;
              }
            }
          };

          const observer = new MutationObserver(updateBodyClass);
          observer.observe(trigger, { attributes: true, attributeFilter: ['data-palette'] });

          // Initial run
          updateBodyClass();
        });
      })();
    </script>

    <% if @print_pdf %>
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          setTimeout(() => {
            // Reveal.js needs a moment to layout
            window.print();
          }, 2000);
        });
      </script>
    <% end %>

    <%= yield :turbo_streams %>

    <div class="reveal"
         data-controller="slides-editor"
         data-slides-editor-url-value="<%= update_slides_content_portfolio_report_extract_path(params[:id]) %>">

      <!-- Saving Indicator -->
      <div data-slides-editor-target="indicator"
           class="fixed top-4 right-4 z-[9999] bg-slate-900/80 text-white px-4 py-2 rounded-full text-xs font-semibold opacity-0 transition-opacity duration-300 pointer-events-none">
        Saving...
      </div>

      <div class="slides" id="slides_container"
           data-slides-editor-target="container"
           data-action="input->slides-editor#handleInput">
        <%= yield %>
      </div>
    </div>

    <!-- Reveal.js Core Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/reveal.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/plugin/notes/notes.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/plugin/markdown/markdown.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/plugin/highlight/highlight.min.js"></script>

    <!-- Load the Rails JS bundle so Stimulus controllers (e.g., chart-renderer) work in presentation mode -->
    <%= javascript_importmap_tags %>

    <script>
      // Initialize / refresh Reveal.js.
      (function () {
        // High Fidelity PDF Export: Standardize query param for Reveal.js
        if (window.location.search.indexOf('print_pdf=true') !== -1 && window.location.search.indexOf('print-pdf') === -1) {
          const url = new URL(window.location);
          url.searchParams.set('print-pdf', '');
          window.history.replaceState({}, '', url.toString());
        }

        const initOrSync = () => {
          if (!window.Reveal || typeof window.Reveal.initialize !== 'function') return

          try {
            if (typeof window.Reveal.isReady === 'function' && window.Reveal.isReady()) {
              if (typeof window.Reveal.sync === 'function') window.Reveal.sync()
              if (typeof window.Reveal.layout === 'function') window.Reveal.layout()
              return
            }

            window.Reveal.initialize({
              hash: true,
              margin: 0,
              width: 1920,
              height: 1080,
              minScale: 0.2,
              maxScale: 2.0,
              center: false,
              pdfMaxPagesPerSlide: 1,
              pdfSeparateIndex: true,
              plugins: [ RevealMarkdown, RevealHighlight, RevealNotes ]
            })
          } catch (e) {
            console.error('[presentation] Reveal init/sync failed', e)
          }
        }

        document.addEventListener('DOMContentLoaded', initOrSync)
        document.addEventListener('turbo:load', initOrSync)

        const slidesEl = document.getElementById('slides_container')
        if (slidesEl && window.MutationObserver) {
          const observer = new MutationObserver(() => initOrSync())
          observer.observe(slidesEl, { childList: true })
        }
      })()
    </script>
  </body>
</html>
