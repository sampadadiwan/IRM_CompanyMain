<%#
  Region selector in the top bar, for users who belong to more than one regional deployment.

  Options come from User#switchable_region_codes - the user's stored `regions`, canonicalised,
  intersected with the regions that are actually deployed. The view does NO splitting, trimming
  or upcasing of its own: it used to do `current_user.regions.split(",")`, which rendered
  `" in ,US, us"` as three inconsistent options (two of which no region could ever match) and
  the JSON form `["US","IN"]` as the literal options `["IN"` and `"US"]`.

  The controller re-derives the same set and authorises against it, so these options are a
  convenience, never the authority.
%>
<%# `codes` is passed in by the caller (layouts/modernize/_topbar), which has already computed
    it for its own visibility check. Falls back to computing it for any other caller. %>
<% codes = local_assigns.fetch(:codes) { current_user.switchable_region_codes } %>
<% if codes.many? %>
  <%= form_with(model: current_user, method: :get, url: cross_site_link_user_path(current_user),
                id: "persona_form", data: { turbo: false }) do |form| %>
    <div class="form-group" data-controller="persona">
      <%= form.select :site,
                      codes.map { |code| [t("cross_region.regions.#{code}", default: code), code] },
                      { selected: SiteRegistry.current_code_or_nil },
                      { id: "site",
                        class: "form-control",
                        name: "site",
                        aria: { label: t("cross_region.choose_region", default: "Choose Region") },
                        data: { action: "change->persona#setRegion", toggle: "tooltip",
                                title: t("cross_region.choose_region", default: "Choose Region") } } %>
    </div>

    <%= form.submit "Submit", { hidden: true, id: "submit" } %>
  <% end %>
<% end %>
