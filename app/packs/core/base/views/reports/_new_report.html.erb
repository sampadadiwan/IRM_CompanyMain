<div data-controller="reports" class="row" style="align-items: center; gap: 0.5rem">
    <div class="col">
        <div class="row">
            <input type="text" class="form-control" placeholder="Search" data-action="input->reports#search">
        </div>
    </div>
    <div class="col">
        <%= form_tag(reports_path, method: :get, data: { action: "change->reports#onChange" }) do %>
            <div class="row">
                <%= select_tag :url, options_for_select(Report.reports_for),
                prompt: "New Report",
                class: "form-control" %>
            </div>
        <% end %>
    </div>

    <div class="col">
        <%= form_tag(reports_path(card: true), method: :get, data: { action: "change->reports#filter" }) do %>
        <div class="row">
            <%= select_tag :category, options_for_select(Report.reports_for.keys.map { |key| [key, key] }, params[:category]),
            prompt: "Filter",
            class: "form-control" %>
        </div>
        <% end %>
    </div>

    <%# One way to start a Report Builder report (report-builder-starting-points H1) %>
    <% if policy(Report.new(entity: current_user.entity)).create? %>
    <div class="col-auto dropdown rb-new-report">
      <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="ti ti-plus me-1"></i>New report
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><%= link_to report_builder_templates_path, class: "dropdown-item" do %><i class="ti ti-template me-2"></i>From a template<% end %></li>
        <li><%= link_to wizard_report_builder_path, class: "dropdown-item" do %><i class="ti ti-wand me-2"></i>Guided setup<% end %></li>
        <%# report-builder-assistant H1 — a report from a question %>
        <li><%= link_to report_builder_describe_path, class: "dropdown-item" do %><i class="ti ti-sparkles me-2"></i>Describe it<% end %></li>
        <%# Name + table on one page, then straight into the report builder %>
        <li><%= link_to new_report_builder_path, class: "dropdown-item" do %><i class="ti ti-tools me-2"></i>Blank report (builder)<% end %></li>
      </ul>
    </div>
    <% end %>
</div>
