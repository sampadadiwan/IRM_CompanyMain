<%# One Markdown document as an index card.
    Shared by the user-guides index and the staff-only internal-docs index so the
    two grids cannot drift apart.

    Locals:
      doc       — { id:, title:, description: } row built by the controller
      subtitle  — small grey label under the title (group or section name)
      path      — URL for the document
      cta       — button label ("View Guide", "View Document")
      icon      — Tabler icon class for the card corner
      accent    — note-has-grid accent class ("note-social", "note-business", …) %>
<div class="col-md-4 single-note-item all-category mb-4 <%= accent %>" data-list-filter-target="item">
  <div class="card card-body h-100 mb-0 shadow-sm border-0">
    <span class="side-stick"></span>
    <h6 class="note-title text-truncate w-75 mb-0">
      <%= link_to doc[:title], path, class: "fw-bolder text-dark", target: "_blank" %>
    </h6>
    <p class="note-date fs-2 text-muted mb-3"><%= subtitle %></p>
    <div class="note-content">
      <p class="note-inner-content doc-card-blurb text-muted mb-4">
        <%= doc[:description] %>
      </p>
    </div>
    <div class="d-flex align-items-center mt-auto pt-3 border-top">
      <%= link_to cta, path, class: "btn btn-sm btn-primary rounded-pill px-3", target: "_blank" %>
      <div class="ms-auto">
        <i class="ti <%= icon %> fs-5 text-muted"></i>
      </div>
    </div>
  </div>
</div>
