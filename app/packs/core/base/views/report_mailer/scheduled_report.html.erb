<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #1a1a1a; margin: 0; padding: 0; background: #f4f4f5; }
      .wrapper { max-width: 560px; margin: 32px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
      .header  { background: #1d4ed8; padding: 24px 32px; }
      .header h1 { color: #fff; margin: 0; font-size: 18px; font-weight: 600; }
      .body    { padding: 28px 32px; }
      .meta    { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 14px 16px; margin: 16px 0; font-size: 13px; color: #475569; }
      .meta dt { font-weight: 600; color: #1e293b; }
      .meta dd { margin: 2px 0 10px 0; }
      .footer  { border-top: 1px solid #f1f5f9; padding: 16px 32px; font-size: 12px; color: #94a3b8; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <h1>Scheduled Report: <%= @report.name %></h1>
      </div>
      <div class="body">
        <p>Your scheduled report is attached to this email as an Excel file.</p>

        <div class="meta">
          <dl>
            <dt>Report</dt>
            <dd><%= @report.name %></dd>
            <dt>Generated</dt>
            <dd><%= I18n.l(Time.current, format: :email, locale: :en) + " " + Time.current.strftime("%Z") %></dd>
            <% if @report.template&.dig("root_model").present? %>
              <dt>Data source</dt>
              <dd><%= @report.template["root_model"].humanize %></dd>
            <% end %>
          </dl>
        </div>

        <p style="font-size: 13px; color: #64748b;">
          This report was automatically generated and sent by the Report Builder.
          To change the schedule or recipients, open the report in the app.
        </p>
      </div>
      <div class="footer">
        Sent by IRM Report Builder &middot; <%= Time.current.year %>
      </div>
    </div>
  </body>
</html>
