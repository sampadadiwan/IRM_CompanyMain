<% if @custom_notification.present? %>

    <% if @custom_notification.is_erb %>
        <!-- C2: the known ERB tags are filled in from this view's records; nothing in the body is evaluated -->
        <%= @custom_notification.render_erb_body(self) %>
    <% else %>
        <!-- Render the HTML content, substituting any {{placeholder}} tokens -->
        <%= @custom_notification.render_safe_body(controller) %>
    <% end %>
    
    <!-- Anything else passed into the block -->
    <% if (block = yield).present? %>
        <%= block %>
    <% end %>

<% end %>
