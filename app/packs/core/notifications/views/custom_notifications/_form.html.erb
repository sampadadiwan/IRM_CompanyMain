<%= render FormCard.new(title: custom_notification.form_title) do %>

  <%= form_with(model: custom_notification, validate: true, data: { controller: "notification-placeholders", "notification-placeholders-placeholders-value": custom_notification.placeholders_by_email_method.to_json, "notification-placeholders-fund-defaults-value": custom_notification.fund_default_notifications.to_json }) do |form| %>
    <% if custom_notification.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(custom_notification.errors.count, "error") %> prohibited this custom_notification from being saved:</h2>

        <ul>
          <% custom_notification.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.text_field :entity_id, class: "form-control", hidden: true  %>
    <%= form.text_field :owner_id, class: "form-control", hidden: true  %>
    <%= form.text_field :owner_type, class: "form-control", hidden: true  %>
    <%= form.text_field :for_type, class: "form-control", hidden: true  %>

    <div data-controller="adhoc-notification">
      <div class="form-group">
        <%= form.label :email_method, "For Notification" %>
        <%= form.select :email_method, custom_notification.email_methods.map{|x| [x.humanize, x]}.sort, {}, class: "form-control", "data-action": "change->adhoc-notification#change change->notification-placeholders#emailMethodChanged", "data-notification-placeholders-target": "emailMethodSelect"  %>
        <small class="form-text text-muted">Which automatic email this template replaces. Only this one notification is customized - all others keep sending the default email.</small>
        <div class="alert alert-warning d-none mt-2" data-notification-placeholders-target="overrideWarning" role="alert"></div>
      </div>

      <% if custom_notification.owner.respond_to?(:adhoc_notifications_to) %>
      <div class="form-group" id="adhoc_notifications_to_form_group">
        <%= form.label :to %>
        <%= form.select :to, custom_notification.owner.adhoc_notifications_to.sort, {include_blank: true}, class: "form-control"  %>
        <small class="form-text text-muted">Which group of people should receive this notification. Leave blank to use the default recipients for this type of notification.</small>
      </div>
      <% end %>
    </div>

    <div class="form-group">
      <%= form.label :tag %>
      <%= form.text_field :tag, class: "form-control"  %>
      <small class="form-text text-muted">An internal label to help you find this template later. Recipients never see this.</small>
    </div>

    <div class="form-group">
      <%= form.label :subject %>
      <%= form.text_field :subject, class: "form-control"  %>
      <small class="form-text text-muted">The subject line recipients see in their inbox. Placeholders are not supported here, only in the body below.</small>
    </div>

    <div class="form-group">
      <%= form.label :body %>
      <small class="form-text text-muted d-block mb-2">Write the email body, then use the dropdown below to personalize it. Selecting a placeholder inserts a token like <code>{{investor_name}}</code> into the text, which is automatically replaced with the real value for each recipient when the email is sent. The placeholders on offer depend on the notification chosen above. Any token you type by hand that isn't recognized (e.g. a typo) is sent as plain text rather than being replaced, so double-check spelling if typing one manually.</small>
      <div class="mb-2" style="max-width: 320px;">
        <select id="custom_notification_placeholder_picker" class="form-control" data-notification-placeholders-target="placeholderSelect" data-action="change->notification-placeholders#insert">
          <option value="">+ Insert placeholder...</option>
        </select>
      </div>
      <%= form.rich_text_area :body, class: "form-control trix", data: { "notification-placeholders-target": "editor" }  %>
    </div>

    <div class="form-group">
      <%= form.label :whatsapp %>
      <%= form.text_area :whatsapp, class: "form-control"  %>
      <small class="form-text text-muted">A short, plain-text version of this message sent over WhatsApp where it's enabled. Avoid the characters &amp; ^ # ` ~ - WhatsApp won't display them correctly.</small>
    </div>

    <% if %w[CapitalCall CapitalDistribution].include?(custom_notification.owner_type) || %w[CapitalCall CapitalDistribution].include?(custom_notification.for_type) %>
        <div class="form-group">
          <%= form.label :show_details %>
          <%= form.check_box :show_details, class: "form-check-input"  %>
          <small class="form-text text-muted">Adds a table at the end of the email listing the full breakdown of this capital call/remittance or distribution (amount, fees, due date, etc).</small>
        </div>
    <% end %>

    <% if params[:debug].present? %>

      <div class="form-group">
        <%= form.label :password_protect_attachment %>
        <%= form.check_box :password_protect_attachment, class: "form-check-input"  %>
        <small class="form-text text-muted">Password protect the attachment sent via email</small>
      </div>

      <div class="form-group">
        <%= form.label :attachment_password, "Field used to set the password" %>
        <%= form.text_field :attachment_password, class: "form-control"  %>
        <small class="form-text text-muted">Contact support to set this up, if you are unsure. E.x investor_kyc.PAN </small>
      </div>

    <% end %>

    <div class="form-group">
      <%= form.label :attachment_names %>
      <%= form.text_field :attachment_names, class: "form-control"  %>
      <small class="form-text text-muted">
        Comma-separated names of documents already uploaded against this record
        (e.g. "Statement of Account, KYC Certificate"). Use * as a wildcard to
        match a family of documents, e.g. "SOA_*_03_2026" matches
        "SOA_FundA_03_2026". If a document name itself contains a comma (e.g. a
        date range like "01 July,2025 to 31 December,2025"), wrap that name in
        double quotes so it isn't split into separate entries, e.g.
        "SOA Unit 01 July,2025 to 31 December,2025 - *". Leave blank to send no
        attachments.
      </small>
    </div>

    <div class="form-group">
      <%= form.label :latest_doc_only, "Only attach the latest match" %>
      <%= form.check_box :latest_doc_only, class: "form-check-input"  %>
      <small class="form-text text-muted">
        Checked: attach only the most recently uploaded document matching each
        name/pattern above. Unchecked: attach every matching document. Examples:
        "Statement of Account" + checked &rarr; newest exact match only.
        "*Statement of Account*" + checked &rarr; newest document whose name contains
        that text (old "close match" behavior). "SOA_*_03_2026" + unchecked &rarr;
        every document matching that pattern is attached.
      </small>
    </div>

    <% if current_user.support? %>

      <div class="form-group">
        <%= form.label :is_erb, "Dynamic Template" %>
        <%= form.check_box :is_erb, class: "form-check-input"  %>
        <small class="form-text text-muted">Support only. Renders the body as ERB with full access to the underlying record, instead of running it through the placeholder picker above. Clients cannot edit a template once this is on.</small>
      </div>

    <% end %>

    <div class="form-group">
      <%= form.label :show_details_link %>
      <%= form.check_box :show_details_link, class: "form-check-input"  %>
      <small class="form-text text-muted">Adds a "View Details" link at the bottom of the email so recipients can open this record directly.</small>
    </div>

    <div class="form-group">
      <%= form.label :enabled %>
      <%= form.check_box :enabled, class: "form-check-input"  %>
      <small class="form-text text-muted">When off, this template is saved but won't be used - the default email is sent instead.</small>
    </div>

    <div class="form-group">
      <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
    </div>
  <% end %>

<% end %>
