<%#
  Company page: when the company is shared, say which LP layout its LPs get and why, or what is stopping them,
  each with a link to the place to act. Existing alert-info / alert-warning patterns.
  Worked examples E73, E74, E91, E92 — openspec/changes/lp-folio-portfolio-dashboard/business-rules.md
%>
<% if investor.show_to_lps %>
  <% layout = LpLayoutResolver.for(investor) %>
  <% fund_ids = AggregatePortfolioInvestment.where(portfolio_company_id: investor.id).distinct.pluck(:fund_id) %>
  <% all_hidden = fund_ids.any? && Fund.where(id: fund_ids).all? { |fund| fund.lp_portfolio_view == :hidden } %>
  <div id="lp_sharing_notice" class="mt-2">
    <% if all_hidden %>
      <%# E74 — shared, but every fund holding it hides its portfolio %>
      <div class="alert alert-info d-flex align-items-start gap-2">
        <i class="ti ti-info-circle"></i>
        <div>No LP can open this page yet: every fund holding this company hides its portfolio from LPs. Change it in Fund › Edit › LP portfolio view.</div>
      </div>
    <% end %>
    <% if layout.nil? %>
      <%# E73 — no LP layout with enabled widgets applies %>
      <div class="alert alert-warning d-flex align-items-start gap-2">
        <i class="ti ti-alert-triangle"></i>
        <div>
          LPs see only the holdings card for this company. Add widgets to an LP layout
          → <%= link_to "Set up LP layout", dashboard_widgets_path(q: DashboardWidget.layout_filter("LP")) %>
        </div>
      </div>
    <% else %>
      <%# E91 — the layout in use and why %>
      <div class="alert alert-info d-flex align-items-start gap-2">
        <i class="ti ti-info-circle"></i>
        <div>
          LPs see the "<%= layout.name %>" layout for this company
          (<%= layout.fallback? ? "no tag-specific layout matches" : "matched on its tag #{layout.matched_tags.map(&:titleize).join(', ')}" %>).
          → <%= link_to "Open layout", dashboard_widgets_path(q: DashboardWidget.layout_filter(layout.name)) %>
        </div>
      </div>
      <% if layout.tie_with.any? %>
        <%# E92 — two layouts match equally; name the winner %>
        <div class="alert alert-warning d-flex align-items-start gap-2">
          <i class="ti ti-alert-triangle"></i>
          <div>Two LP layouts match this company's tags ("<%= ([layout.name] + layout.tie_with).join('" and "') %>"). LPs see "<%= layout.name %>". Remove a tag or a layout to choose.</div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
