<% fund_ratios ||= []
  decimals ||= (params[:decimals] || 2).to_i
%>


<%= tag.div class: "fund-ratio-list w-100" do
      if fund_ratios.any?
        tag.table class: "table table-sm align-middle mb-0" do
          safe_join([
            tag.thead do
              tag.tr do
                safe_join([
                  tag.th("Funds", scope: "col", class: " text-white ", style: "font-size: 14px"),
                  tag.th("Value", scope: "col", class: " text-end text-white", style: "font-size: 14px"),
                  tag.th("As on", scope: "col", class: " text-end text-white", style: "font-size: 14px")
                ])
              end
            end,
            tag.tbody do
              safe_join(
                fund_ratios.map do |fund_ratio|
                  tag.tr do
                    safe_join([
                      tag.td(class: "text-dark") do
                        fund_ratio.owner.respond_to?(:name) ? fund_ratio.owner.name : fund_ratio.owner_type
                      end,
                      tag.td(class: "text-end") do
                        display_val = "#{number_with_precision(fund_ratio.value, precision: decimals)}"
                        if fund_ratio.name.upcase.include?("IRR")
                          display_val += " %"
                        else
                          display_val += " x"
                        end
                        display_val
                      end,
                      tag.td(class: "text-end text-muted") do
                        fund_ratio.end_date.present? ? l(fund_ratio.end_date.to_date, format: :long) : "—"
                      end
                    ])
                  end
                end
              )
            end
          ])
        end
      else
        tag.p("No data available.", class: "text-muted small mb-0")
      end
    end %>
