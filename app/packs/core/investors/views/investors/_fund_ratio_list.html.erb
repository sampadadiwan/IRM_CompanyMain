<% fund_ratios ||= [] %>

<%= tag.div class: "fund-ratio-list w-100" do
      if fund_ratios.any?
        tag.table class: "table table-sm align-middle mb-0" do
          safe_join([
            tag.thead do
              tag.tr do
                safe_join([
                  tag.th("Portfolio Company", scope: "col", class: "text-uppercase small fw-semibold"),
                  tag.th("Value", scope: "col", class: "text-uppercase small fw-semibold text-end"),
                  tag.th("As on", scope: "col", class: "text-uppercase small fw-semibold text-end")
                ])
              end
            end,
            tag.tbody do
              safe_join(
                fund_ratios.map do |fund_ratio|
                  tag.tr do
                    safe_join([
                      tag.td(class: "fw-semibold text-dark") do
                        fund_ratio.owner.respond_to?(:investor_name) ? fund_ratio.owner.investor_name : fund_ratio.owner_type
                      end,
                      tag.td(class: "text-end") do
                        fund_ratio.display_value.presence || number_with_precision(fund_ratio.value, precision: 2)
                      end,
                      tag.td(class: "text-end text-muted") do
                        fund_ratio.end_date.present? ? l(fund_ratio.end_date.to_date, format: :long) : "—"
                      end
                    ])
                  end
                end
              )
            end
          ])
        end
      else
        tag.p("No data available.", class: "text-muted small mb-0")
      end
    end %>
