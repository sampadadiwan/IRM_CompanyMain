<%= turbo_frame_tag "#{@dashboard_name.parameterize(separator: '_')}_frame", target: "_top", data: { turbo_action: "advance" } do %>
  <%  @funds, @selected_fund_ids = setup_fund_selection(current_user, params)

      admin_settings = JSON.parse(cookies[:adminSettings]) rescue {}
      theme = admin_settings["Theme"] == "dark" ? "bg-dark" : "bg-light"

      hidden_fields ||= {}
      hidden_fields[:multi_portfolio_dashboard] = params[:multi_portfolio_dashboard] if params[:multi_portfolio_dashboard].present? %>

  <%= render "/layouts/multi_portfolio_dashboard_filter",
             associations: [],
             hidden_fields: hidden_fields,
             tag_options: @tag_options,
             fund_tag_lookup: @fund_tag_lookup,
             sector_options: @sector_options,
             fund_sector_lookup: @fund_sector_lookup %>

  <% if @alert.present? %>
    <!-- Display the message -->
    <div class="alert alert-warning text-center">
      <%= @alert %>
    </div>
  <% end %>

  <% if @investors.present? %>
      <!-- Display the dashboard -->
    <%
      # One lookup serves the page and the menu (E5): no Show Menu widget means no menu row
      page_widgets = dashboard_widgets(@dashboard_name, current_user.entity_id, name: @name)
      all_widgets = dashboard_menu_widgets(page_widgets).to_a
    %>

    <% if all_widgets.any? %>
    <nav class="dashboard-nav sticky-top <%= theme %> shadow-sm d-none d-md-block"  style="top:70px; z-index: 1000;">
      <ul class="nav nav-pills <%= theme %> p-1" data-controller="nav-overflow" data-nav-overflow-target="nav">
          <!-- Add a link to the dashboard widgets -->

          <% all_widgets.each_with_index do |(name, dashboard_widget), index| %>
              <li class="nav-item" data-nav-overflow-target="item">
                  <a class="nav-link btn btn-sm" href="#<%= "#{dashboard_widget.widget_name.parameterize.underscore}_#{dashboard_widget.position}" %>" data-turbo=false>
                      <% label = dashboard_widget.tags.presence || dashboard_widget.widget_name %>
                      <%= label %>
                  </a>
              </li>
          <% end %>

          <li class="nav-item dropdown d-none" data-nav-overflow-target="more">
              <a class="nav-link btn btn-sm dropdown-toggle" href="#" id="moreWidgetsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  More
              </a>
              <ul class="dropdown-menu shadow" aria-labelledby="moreWidgetsDropdown" data-nav-overflow-target="moreDropdown">
                  <% all_widgets.each_with_index do |(name, dashboard_widget), index| %>
                      <li data-index="<%= index %>">
                          <a class="dropdown-item" href="#<%= "#{dashboard_widget.widget_name.parameterize.underscore}_#{dashboard_widget.position}" %>" data-turbo=false>
                              <% label = dashboard_widget.tags.presence || dashboard_widget.widget_name %>
                              <%= label %>
                          </a>
                      </li>
                  <% end %>

                  <!-- Move Reports dropdown items here if overflow exists -->
                  <% reports = Report.where("tag_list LIKE ?", "%#{@dashboard_name}%") %>
                  <% if reports.any? %>
                      <li class="d-none" data-nav-overflow-target="moreReportsDivider"><hr class="dropdown-divider"></li>
                      <li class="dropdown-header d-none" data-nav-overflow-target="moreReportsHeader">Reports</li>
                      <% reports.each do |report| %>
                          <li class="report-item d-none"><%= link_to report.name, report_url(@dashboard_name, report), class: "dropdown-item" %></li>
                      <% end %>
                  <% end %>
              </ul>
          </li>

          <!-- Standalone dropdown for reports if no overflow exists -->
          <% reports = Report.where("tag_list LIKE ?", "%#{@dashboard_name}%") %>
          <% if reports.any? %>
              <li class="nav-item dropdown" data-nav-overflow-target="reportsDropdown">
                  <a class="nav-link btn btn-sm btn-outline-primary dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                      Reports
                  </a>
                  <ul class="dropdown-menu shadow" aria-labelledby="navbarDropdown">
                      <% reports.each do |report| %>
                          <li><%= link_to report.name, report_url(@dashboard_name, report), class: "dropdown-item" %></li>
                      <% end %>
                  </ul>
              </li>
          <% end %>
      </ul>

    </nav>
    <% end %>

    <%# Widget settings in place — openspec/changes/dashboard-widget-inline-settings %>
    <% settings_allowed = widget_settings_allowed?(@dashboard_name, @name, entity_id: current_user.entity_id) %>
    <div class="row mt-4 portfolio-dashboard__widgets" <%= 'data-controller=widget-settings' if settings_allowed %>>

      <%# ② One settings popup per page %>
      <%= render "dashboard_widgets/settings_modal" if settings_allowed %>

      <% page_widgets.each do |name, dashboard_widget| %>
        <% widget_key = widget_frame_key(dashboard_widget) %>
        <%# ⑥ One-widget reload (D4): with ?only_widget=<key> only that widget is drawn, into its frame %>
        <% next if params[:only_widget].present? && params[:only_widget] != widget_key %>
        <div id="<%= widget_key %>" class="dashboard-widget-container position-relative <%= dashboard_widget.widget_size %>">

          <%# target _top: links and forms inside a widget still open full pages %>
          <%= turbo_frame_tag "dashboard_widget_#{widget_key}", target: "_top", class: "dashboard-widget-frame" do %>
            <%= render dashboard_widget.path, widget: dashboard_widget, name: dashboard_widget.widget_name, dashboard_widget:, widget_size: dashboard_widget.widget_size, args: dashboard_widget.metadata_args, tags: dashboard_widget.tags, investors: @investors, uri_params: params, funds: @funds %>
          <% end %>
          <%# ① The widget's settings icon %>
          <%= render "dashboard_widgets/settings_button", widget: dashboard_widget, dashboard_name: @dashboard_name, layout: @name if settings_allowed %>
        </div>
      <% end %>
    </div>
  <% end %>
    <%# The chat panel needs the agent record, but skip the lookup entirely unless the Portfolio Assistant is enabled %>
    <% portfolio_agent = SupportAgent.find_by(
       entity_id: current_user.entity_id,
       agent_type: "PortfolioAssistantAgent",
       enabled: true
     ) if current_user.entity.support_agents.set?(:portfolio_assistant) %>
  <% if portfolio_agent&.chat_enabled? %>
    <%= render "support_agents/chat_panel",
               support_agent: portfolio_agent,
               chattable: current_user.entity %>
  <% end %>

<% end %>

