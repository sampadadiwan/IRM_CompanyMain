<%= turbo_frame_tag "#{@dashboard_name.parameterize(separator: '_')}_frame", target: "_top", data: { turbo_action: "advance" } do %>

    <%
        widgets = dashboard_widgets("Portfolio Company Dashboard", current_user.entity_id, name: params[:name])
        if widgets["Data Card"].blank?
    %>
        <%= render "/investors/show" %>
    <% end %>

    <div class="single-portfolio-dashboard" >
        <%= render "/dashboard_widgets/dashboard",
              dashboard_name: @dashboard_name,
              name: @name,
              dashboard_names: @dashboard_names,
              uri_params: { owner_id: @investor.id, owner_type: "Investor" },
              logo: @logo,
              header_label: "Sector",
              header_value: @investor.sector,
              title: @investor.investor_name %>
    </div>

<% end %>


<% if @investor.category == "Portfolio Company" %>
  <%# The chat panel needs the agent record, but skip the lookup entirely unless the Portfolio Assistant is enabled %>
  <% portfolio_agent = SupportAgent.find_by(
       entity_id: current_user.entity_id,
       agent_type: "PortfolioAssistantAgent",
       enabled: true
     ) if current_user.entity.support_agents.set?(:portfolio_assistant) %>
  <% if portfolio_agent&.chat_enabled? %>
    <%= render "support_agents/chat_panel",
               support_agent: portfolio_agent,
               chattable: @investor %>
  <% end %>
<% end %>

