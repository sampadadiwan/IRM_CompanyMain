<%= render FormCard.new(title: "Stakeholder : #{investor.investor_name.presence || 'New'}") do %>

<div data-controller="investor">

  <%= form_with(model: investor, validate: true, data:{turbo: false}) do |form| %>
    <% if investor.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(investor.errors.count, "error") %> prohibited this investor from being saved:</h2>

        <ul>
          <% investor.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>


    <%= render "form_fields", investor: investor, form: form %>

    <div class="form-group">
      <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
    </div>
  <% end %>

  <% disabled = !investor.new_record? && investor.primary_email.present? && !params[:primary_email_edit].present? %>
  <% if disabled %>
    <div class="modal fade" id="editEmailModal" data-investor-target="editEmailModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><i class="ti ti-alert-triangle text-warning"></i> Edit Primary Email</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="border-start border-4 border-warning ps-3 py-1 mb-3">
              <div class="fw-bold text-dark small">⚠️ Please Review Carefully</div>
              <div class="text-muted small">Changing the email address will update this stakeholder's record company-wide. Here's what happens:</div>
            </div>

            <div class="d-flex flex-column gap-2 mb-3">
              <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fffbeb;">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:36px;height:36px;background:#fef3c7;">
                  <i class="ti ti-users fs-5" style="color:#d97706;"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark lh-sm">New stakeholder profile is linked</div>
                  <div class="text-muted small mt-1">The new email becomes the stakeholder's primary identity. If no profile exists for that email, a new one is created automatically.</div>
                </div>
              </div>

              <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#eff6ff;">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:36px;height:36px;background:#dbeafe;">
                  <i class="ti ti-arrows-shuffle fs-5" style="color:#2563eb;"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark lh-sm">All records point to the new profile</div>
                  <div class="text-muted small mt-1">Deal participations, portal access permissions, and notice delivery settings linked to this stakeholder are all updated to point to the new profile.</div>
                </div>
              </div>

              <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#f0fdf4;">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:36px;height:36px;background:#dcfce7;">
                  <i class="ti ti-user-check fs-5" style="color:#16a34a;"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark lh-sm">User accounts follow along</div>
                  <div class="text-muted small mt-1">If a user account belongs exclusively to this stakeholder, it is moved to the new profile so they keep their portal access.</div>
                </div>
              </div>

              <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fef2f2;">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:36px;height:36px;background:#fee2e2;">
                  <i class="ti ti-alert-circle fs-5" style="color:#dc2626;"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark lh-sm">Duplicate email not allowed</div>
                  <div class="text-muted small mt-1">If another stakeholder in the same fund already uses this email, the change will be rejected with an error.</div>
                </div>
              </div>
            </div>

            <hr class="my-3">
            <div class="text-muted small">
              <i class="ti ti-info-circle"></i>
              This change affects how the stakeholder appears in deals, notices, and portal access. Double-check the email before proceeding.
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-outline-warning" data-action="click->investor#enableEmailEditing">
              Enable Editing
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% end %>
