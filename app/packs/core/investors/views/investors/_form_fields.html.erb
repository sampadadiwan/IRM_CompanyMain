
  <div class="form-group" id="investor_name_group" data-controller="<%= investor.investor_entity_id.present? ? '' : 'investorsearch'%>">
    <%= form.label :investor_name, "New Stakeholder Name" %>
    <%= form.text_field :investor_name, class: "form-control", autocomplete: false %>
    <%= form.text_field :investor_entity_id, class: "form-control", hidden: true %>
    <small class="text-muted">Enter a unique stakeholder name</small>
  </div>

  <div class="form-group">
    <%= form.label :category %>
    <!-- Even though this is not a custom field, its class is set to custom_field to enable other custom_fields to be dependent on this -->
    <%= form.select :category, Investor.INVESTOR_CATEGORIES(current_user.entity) , {include_blank: true}, class: "form-control custom_field", data: { action: "investor#toggleSector" }  %>
    <small class="text-muted">Select the category grouping for the stakeholder</small>
  </div>

  <%# Email edits are blocked (server-side, in UpdateInvestor) once the stakeholder
      has users, so don't offer the unlock button in that case %>
  <% email_locked_by_users = investor.primary_email_locked? %>
  <% disabled = !investor.new_record? && investor.primary_email.present? && !params[:primary_email_edit].present? %>
  <div class="form-group" id="investor_name_group">
    <%= form.label :primary_email, "Primary Email" %>
    <div class="d-flex align-items-center gap-2">
      <%= form.text_field :primary_email, class: "form-control", required: true, disabled:, data: {validate: true, investor_target: "primaryEmailField"} %>
      <% if disabled && !email_locked_by_users %>
        <button type="button" id="editEmailBtn" class="btn btn-outline-warning btn-sm flex-shrink-0"
                data-investor-target="editEmailButton" data-bs-toggle="modal" data-bs-target="#editEmailModal">
          <i class="ti ti-pencil"></i> Edit Email
        </button>
      <% end %>
    </div>
    <%# Round-trips the unlock intent with the form submission. Without this, a server
        re-render after a validation failure would re-disable the field above, since
        `disabled` is derived from params[:primary_email_edit] which a plain client-side
        DOM unlock never sends. %>
    <%= hidden_field_tag :primary_email_edit, params[:primary_email_edit].presence || "false", data: {investor_target: "primaryEmailEditFlag"} %>
    <% if email_locked_by_users %>
      <small class="text-muted">Primary email cannot be changed because this stakeholder has users linked to it. Remove the stakeholder's users first to change the primary email.</small>
    <% else %>
      <small class="text-muted">Primary email is the unique ID for creating the stakeholder. This is not used for any communications.</small>
    <% end %>
  </div>



  <div class="form-group">
    <%= form.label :tag_list, "Tags" %>
    <%= form.text_field :tag_list, class: "form-control"  %>
    <small class="text-muted">Tags can be used to classify, sort or filter the stakeholders. For multiple tags enter a comma separated list. </small>
  </div>

  <div class="form-group" data-investor-target="sectorField" style="<%= investor.category == 'Portfolio Company' ? '' : 'display: none;' %>">
    <%= form.label :sector %>
    <%= form.text_field :sector, class: "form-control"  %>
    <small class="text-muted">Sector of the Portfolio Company</small>
  </div>

  <div class="form-group" id="investor_name_group">
    <%= form.label :city %>
    <%= form.text_field :city, class: "form-control" %>
    <small class="text-muted">City where the Stakeholder is based</small>
  </div>



  <%# When creating a Portfolio Company from the AI Portfolio Reports form, return_to carries the redirect path back to the report creation page with the new investor pre-selected %>
  <input type="hidden" name="return_to" value="<%= params[:return_to] %>">

  <%= custom_form_fields(investor, form) %>
