<%# Workflow state, worked out once for the top card and the Misc menu items below (admins only) %>
<% if policy(@investor).assign_workflow? %>
  <% active_workflow = @investor.workflow_instances.instance_active.first %>
  <% launchable_templates = active_workflow ? [] : @investor.launchable_workflow_templates %>
<% end %>
<div class="container-fluid mb-0">
  <%# Running workflow (and the launch modal) above the details, like the capital call journey %>
  <%= render "investors/workflow_summary", investor: @investor,
             active_instance: active_workflow, available_templates: launchable_templates || [] %>
  <%= render "investors/show" %>

  <div class="d-flex flex-wrap align-items-center gap-2">

    <% if policy(@investor).update? %>
      <%= link_to edit_investor_path(@investor),
                  class: "btn btn-outline-primary d-inline-flex align-items-center",
                  data: { turbo: false } do %>
        <i class="ti ti-pencil"></i> <%= t_common(:edit) %>
      <% end %>
    <% end %>

    <%# Notes, Tasks and Emails live in the Activity tab below (each list has its own New button) %>

    <% if policy(@investor).destroy? %>
      <%
        delete_data = { action: "click->confirm#popup", turbo: false }
        fund_ratio_count = @investor.fund_ratios.count
        # msg is rendered as HTML by confirm#popup: keep it to static text and a number only.
        # title is rendered as text, so the investor name is safe there.
        # With no ratios the popup's default title and message are used.
        if fund_ratio_count.positive?
          delete_data[:title] = "Delete #{@investor.investor_name}?"
          delete_data[:msg] = if fund_ratio_count == 1
                                "Deleting this investor will also delete its associated fund ratio. Proceed?"
                              else
                                "Deleting this investor will also delete its #{fund_ratio_count} associated fund ratios. Proceed?"
                              end
        end
      %>
      <%= button_to @investor,
                    method: :delete,
                    class: "btn btn-outline-danger d-inline-flex align-items-center",
                    form_class: "deleteButton",
                    data: delete_data do %>
        <i class="ti ti-trash"></i> <%= t_common(:delete) %>
      <% end %>
    <% end %>

    <div class="btn-group">
      <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle d-inline-flex align-items-center" type="button"
                data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <i class="ti ti-dots-vertical"></i> Misc
        </button>
        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">

          <% if policy(@investor).cap_table? %>
            <%= link_to investments_path(portfolio_company_id: @investor.id, show_captable: true),
                        class: "dropdown-item d-flex align-items-center", data: {turbo: false, bs_toggle: "tooltip", bs_title: "Opens detailed CapTable view"} do %>
              <i class="ti ti-table"></i> CapTable
            <% end %>
          <% end %>

          <%= link_to dashboard_investor_path(id: @investor.id),
                      class: "dropdown-item d-flex align-items-center",
                      data: { turbo: false, bs_toggle: "tooltip", bs_title: "Opens the detailed dashboard" } do %>
            <i class="ti ti-layout-dashboard"></i> Dashboard
          <% end %>

          <%= link_to folder_documents_path(folder_id: @investor.document_folder.id),
                      class: "dropdown-item d-flex align-items-center", data: {turbo: false, bs_toggle: "tooltip", bs_title: "Opens the documents data room"} do %>
            <i class="ti ti-folder"></i> Documents
          <% end %>

          <div class="dropdown-divider"></div>

          <%= link_to generate_reports_investor_path(@investor),
                      class: "dropdown-item d-flex align-items-center",
                      data: { turbo: false, bs_toggle: "tooltip", bs_title: "Generate Portfolio company analyst report using AI + templates"} do %>
            <i class="ti ti-report"></i> Portfolio Report
          <% end %>

          <%= link_to portfolio_investments_report_investor_path(@investor),
                      class: "dropdown-item d-flex align-items-center",
                      data: { turbo: false, bs_toggle: "tooltip", bs_title: "Generate an excel file with investment details for this portfolio company across funds"} do %>
            <i class="ti ti-file-text"></i> Portfolio Investment Report
          <% end %>

          <% if @investor.category == "Portfolio Company" %>
          <%# show company id in ransack filter %>
            <%= link_to portfolio_report_extracts_path(portfolio_company_id: @investor.id, q: { portfolio_company_id_eq: @investor.id }),
                        class: "dropdown-item d-flex align-items-center",
                        data: { turbo: false, bs_toggle: "tooltip", bs_title: "View all portfolio report extracts for this portfolio company" } do %>
              <i class="ti ti-search"></i> Portfolio Report Extracts
            <% end %>

             <%# Jump straight to the legacy bulk-generate options step (second screen) with this
                company pre-selected — no company-picking step, since we're already on its page.
                Only offered when at least one portfolio report exists to generate against. %>
            <% if policy_scope(PortfolioReport).exists? %>
              <%= button_to legacy_bulk_generate_options_portfolio_reports_path,
                            method: :post,
                            params: { portfolio_company_ids: [@investor.id], back_to: investor_path(@investor) },
                            class: "dropdown-item d-flex align-items-center",
                            data: { turbo: false, bs_toggle: "tooltip", bs_title: "Generate a portfolio report for this company" } do %>
                <i class="ti ti-report-analytics"></i> Portfolio Report (Legacy)
              <% end %>
            <% end %>
          <% end %>

          <div class="dropdown-divider"></div>

          <% if @investor.category == "Portfolio Company" %>
            <% if @investor.entity.support_agents.set?(:portfolio_company_agent) %>
              <button type="button" class="dropdown-item"
                      data-bs-toggle="modal" data-bs-target="#run-portfolio-company-agent-modal">
                <i class="ti ti-robot"></i> Run Portfolio Company Agent
              </button>

              <%= link_to assistant_path('assistant', assistant_type: 'PortfolioCompanyAssistant', owner_id: @investor.id, owner_type: "Investor"),
                          class: "dropdown-item d-flex align-items-center",
                          data: { turbo: false, bs_toggle: "tooltip", bs_title: "Launch AI Assistant for this Portfolio Company" } do %>
                <i class="ti ti-brand-github-copilot"></i> AI Assistant
              <% end %>
            <% else %>
              <span class="dropdown-item disabled text-muted" style="opacity:0.65; pointer-events:auto; cursor:default;" data-bs-toggle="tooltip" data-bs-title="Portfolio Company Agent is disabled. Contact support to enable it">
                <i class="ti ti-robot"></i> Run Portfolio Company Agent
                <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
              </span>
              <span class="dropdown-item disabled text-muted" style="opacity:0.65; pointer-events:auto; cursor:default;" data-bs-toggle="tooltip" data-bs-title="Portfolio Company Agent is disabled. Contact support to enable it">
                <i class="ti ti-brand-github-copilot"></i> AI Assistant
                <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
              </span>
            <% end %>

            <% if @investor.entity.support_agents.set?(:portfolio_scoring_agent) %>
              <button type="button" class="dropdown-item"
                      data-bs-toggle="modal" data-bs-target="#run-scoring-agent-modal">
                <i class="ti ti-chart-bar"></i> Run Scoring Agent
              </button>
            <% else %>
              <span class="dropdown-item disabled text-muted" style="opacity:0.65; pointer-events:auto; cursor:default;" data-bs-toggle="tooltip" data-bs-title="Portfolio Scoring Agent is disabled. Contact support to enable it">
                <i class="ti ti-chart-bar"></i> Run Scoring Agent
                <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
              </span>
            <% end %>

            <% if @investor.entity.support_agents.set?(:presentation_analyst_agent) %>
              <button type="button" class="dropdown-item"
                      data-bs-toggle="modal" data-bs-target="#run-presentation-analyst-modal">
                <i class="ti ti-files"></i> Run Presentation Analyst
              </button>
            <% else %>
              <span class="dropdown-item disabled text-muted" style="opacity:0.65; pointer-events:auto; cursor:default;" data-bs-toggle="tooltip" data-bs-title="Presentation Analyst Agent is disabled. Contact support to enable it">
                <i class="ti ti-files"></i> Run Presentation Analyst
                <i class="ti ti-lock ms-1" style="font-size:0.7rem"></i>
              </span>
            <% end %>
          <% end %>

          <% if @investor.category == "Portfolio Company" %>
            <%= link_to generate_agent_charts_investor_path(@investor),
                        class: "dropdown-item d-flex align-items-center",
                        data: { turbo: false, bs_toggle: "tooltip", bs_title: "Generate AI charts for this portfolio company using configured agent chart prompts" } do %>
              <i class="ti ti-chart-bar"></i> Generate AI Charts
            <% end %>
          <% end %>



          <%# Workflows (admins): launch one when nothing is running, and every past run for this investor %>
          <% if policy(@investor).assign_workflow? %>
            <% if launchable_templates.any? %>
              <button type="button" class="dropdown-item d-flex align-items-center"
                      data-bs-toggle="modal" data-bs-target="#launchWorkflowModal">
                <i class="ti ti-player-play"></i> Launch Workflow
              </button>
            <% end %>
            <%= link_to workflow_instances_path(workflowable_type: "Investor", workflowable_id: @investor.id),
                        class: "dropdown-item d-flex align-items-center",
                        data: { turbo: false, bs_toggle: "tooltip", bs_title: "Every workflow run on this investor" } do %>
              <i class="ti ti-history"></i> Workflow History
            <% end %>
          <% end %>

        </div>
      </div>
    </div>

    <%# ── Agent Run Confirmation Modals ──────────────────────────────────── %>
    <% if @investor.category == "Portfolio Company" %>
      <% if @investor.entity.support_agents.set?(:portfolio_company_agent) %>
        <%= render "support_agents/agent_run_modal",
                   modal_id:         "run-portfolio-company-agent-modal",
                   agent_type:       "PortfolioCompanyAgent",
                   target_type:      "Investor",
                   target_id:        @investor.id,
                   description:      PortfolioCompanyAgent::DESCRIPTION,
                   long_description: PortfolioCompanyAgent::SINGLE_LONG_DESCRIPTION %>
      <% end %>

      <% if @investor.entity.support_agents.set?(:portfolio_scoring_agent) %>
        <%= render "support_agents/agent_run_modal",
                   modal_id:         "run-scoring-agent-modal",
                   agent_type:       "PortfolioScoringAgent",
                   target_type:      "Investor",
                   target_id:        @investor.id,
                   description:      PortfolioScoringAgent::DESCRIPTION,
                   long_description: PortfolioScoringAgent::SINGLE_LONG_DESCRIPTION %>
      <% end %>

      <% if @investor.entity.support_agents.set?(:presentation_analyst_agent) %>
        <%= render "support_agents/agent_run_modal",
                   modal_id:         "run-presentation-analyst-modal",
                   agent_type:       "PresentationAnalystAgent",
                   target_type:      "Investor",
                   target_id:        @investor.id,
                   description:      PresentationAnalystAgent::DESCRIPTION,
                   long_description: PresentationAnalystAgent::SINGLE_LONG_DESCRIPTION %>
      <% end %>
    <% end %>

  </div>
</div>

<div id="progress_panel_new" class="container-fluid px-3 pb-3"></div>

<%# Summary cards for the tabs below, each linking to its tab. Full width like the tabs (outside the
    narrow container above); the existing compact density (custom/layout.scss) keeps the cards short %>
<div id="investor_show_stats_wrapper" data-density="compact" data-controller="tooltip">
  <%= render "investors/show_stats", investor: @investor %>
</div>

<div id="investor_associated_details" class="associated_entity">
  <%= render "investors/investor_details" , investor: @investor %>
</div>

<% if @investor.category == "Portfolio Company" %>
  <% portfolio_agent = SupportAgent.find_by(
    entity_id: @investor.entity_id,
    agent_type: "PortfolioAssistantAgent",
    enabled: true
  ) %>
  <% if portfolio_agent&.chat_enabled? %>
    <%= render "support_agents/chat_panel",
               support_agent: portfolio_agent,
               chattable: @investor %>
  <% end %>

<% end %>

