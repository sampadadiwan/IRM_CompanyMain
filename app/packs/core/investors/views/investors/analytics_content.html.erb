<%= turbo_frame_tag "investor_analytics_frame" do %>
  <div class="row g-4">
    <div class="col-md-6">
      <div class="p-3 border rounded h-100 bg-white shadow-sm">
        <%= investor_category_distribution_chart(@all_investors) %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="p-3 border rounded h-100 bg-white shadow-sm">
        <%= investor_city_distribution_chart(@all_investors) %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="p-3 border rounded h-100 bg-white shadow-sm">
        <%= investor_tag_distribution_chart(@all_investors) %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="p-3 border rounded h-100 bg-white shadow-sm">
        <%= investor_sector_distribution_chart(@all_investors) %>
      </div>
    </div>
  </div>
<% end %>
