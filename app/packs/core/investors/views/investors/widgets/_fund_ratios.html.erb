<%
args[:name] = args[:ratio_names] if args[:ratio_names].present?
args[:owner_id] = @investor.id
args[:owner_type] = "Investor"

if args[:for_commitments] == true
  args[:owner_type] = "CapitalCommitment"
  args[:owner_id] = @investor.capital_commitments.ids
end

args[:widget_id] ||= widget.id
%>

<%
  args_with_widget = args.merge(widget_id: widget.id)
  uri = URI(fund_ratios_path(title: "Company Ratios", show_funds: true, **args_with_widget))
%>
<%= render(
      WidgetCardComponent.new(
        widget: widget,
        args: args,
        widget_size: widget.widget_size
      )
    ) do
%>
    <% if args[:list].nil? || args[:list] == true %>
      <%= turbo_frame_tag "fund_ratios_frame_#{widget.id}", target: "_top", src: "#{uri.to_s}" do %>
      <% end %>
    <% elsif args[:chart].nil? || args[:chart] == true %>
      <%# Chart is now rendered in ratios index view with already fetched ratios , so we only render here if list is false i.e. when index wont render %>
      <%= turbo_frame_tag "fund_ratios_chart_frame_#{widget.id}" do %>
        <div class="mb-3 d-flex justify-content-end">
          <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Chart type">
            <% current_type = params[:chart_type] || "line" %>
            <% [["Area", "area"], ["Bar", "bar"], ["Line", "line"]].each do |label, type| %>
              <%= link_to label, request.params.merge(chart_type: type),
                  class: "btn #{current_type == type ? 'btn-primary' : 'btn-outline-primary bg-white'}",
                  data: { turbo_frame: "fund_ratios_chart_frame_#{widget.id}" } %>
            <% end %>
          </div>
        </div>
        <%= fund_ratios_line_chart(nil, args: args, owner_id: args[:owner_id], owner_type: args[:owner_type], ratio_names: args[:ratio_names], months: args[:months], chart_type: params[:chart_type]) %>
      <% end %>
    <% end %>

<% end %>
