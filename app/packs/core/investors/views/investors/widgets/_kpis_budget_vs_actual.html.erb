<%
  args ||= {}
  args[:portfolio_company_id] = @investor.id
  args[:entity_id] = @investor.entity_id
  args[:all] = true
  args[:budget_view] = true

  if args[:tag_list].present?
    tag_list = args[:tag_list].split(",").map(&:strip)
    tag_list ||= ["Actual", "Budget"]
    args[:tag_list] = tag_list
  end
  args[:num_periods] ||= 2
  args[:decimals] ||= 2

  uri = URI(kpi_reports_path(**args))
%>

<%= render(
      WidgetCardComponent.new(
        widget: widget,
        args: args,
        widget_size: widget.widget_size
      )
    ) do
%>
    <%= turbo_frame_tag "kpi_reports_budget", target: "_top", src: "#{uri.to_s}" do %>
    <%end%>

<% end %>
