<%
  widget_size ||= "col-md-12"
  name ||= nil
  uri_params ||= {}
  args ||= widget.metadata_args
  tabs = args[:tabs].split(",").map(&:strip) if args && args[:tabs].present?
%>

<%# Portfolio Report Widget %>
<%# Displays the latest PortfolioReportExtract that has data for the current investor. %>
<%# Supports optional metadata args: %>
<%#   - tabs: comma-separated section names to filter and order displayed tabs %>
<%#   - portfolio_report_id: scopes the widget to show extracts from a specific report template %>



<%# H12, E15: the latest extract that has data (a blank latest extract is skipped, however many in a row). %>
<% extracts = @investor.portfolio_report_extracts %>
<% extracts = extracts.where(portfolio_report_id: args[:portfolio_report_id]) if args&.dig(:portfolio_report_id).present? %>
<% portfolio_report_extract = extracts.latest_with_data %>


<% if portfolio_report_extract.present? && portfolio_report_extract.data.present? %>

    <%= render(
        WidgetCardComponent.new(
            widget: widget,
            args: args,
            widget_size: widget.widget_size
        )
        ) do
    %>



        <% section_data = JSON.parse(portfolio_report_extract.data) %>
        <%# If 'tabs' argument is provided, filter the sections and maintain the specified order. %>
        <% if params[:debug].present? %>
        <%= tabs %>
        <%= section_data.keys %>
        <% end %>

        <% if tabs.present? %>
            <% section_data = tabs.each_with_object({}) { |tab_name, hash| hash[tab_name] = section_data[tab_name] if section_data.key?(tab_name) } %>
        <% end %>
        <% section_icons = {}
           portfolio_report_extract.portfolio_report.portfolio_report_sections.where(name: section_data.keys).map{ |section| section_icons["#{section.name}"] = section.icon } %>

        <% title ||= args[:title] %>
        <% if title.present? %>
            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                <h1 class="card-title h3 mb-0 text-gray-800">
                <%= title %>
                </h1>
                <div class="ms-auto">
                    <%= link_to edit_portfolio_report_extract_path(portfolio_report_extract), class: "btn btn-sm btn-outline-success", title: "Edit Portfolio Report", data: { turbo_frame: "_top" } do %>
                        <i class="ti ti-edit fs-4"></i>
                    <% end %>
                </div>
            </div>
        <% end %>
        <!-- Create tabs for each section -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <nav class="nav nav-pills nav-justified p-3 rounded card flex-row flex-grow-1 mb-0 portfolio-report-tabs"  role="tablist">
                <% section_data.each_with_index do |(name, list_of_points), idx| %>
                    <a class="nav-link d-flex align-items-center justify-content-center gap-1 <%= idx == 0 ? 'active' : ''%>" data-bs-toggle="pill" data-bs-toggle="tab" href="#<%= name.gsub(" ", "").underscore %>-tab">
                    <% if section_icons.key?(name) %>
                        <i class="ti ti-<%= section_icons[name] %> fs-9"></i>
                    <% end %>
                        <%= name %>
                    </a>
                <% end %>
            </nav>
            <% unless title.present? %>
                <div class="ms-3">
                    <%= link_to edit_portfolio_report_extract_path(portfolio_report_extract), class: "btn btn-sm btn-outline-success", title: "Edit Portfolio Report", data: { turbo_frame: "_top" } do %>
                        <i class="ti ti-edit fs-4"></i>
                    <% end %>
                </div>
            <% end %>
        </div>

        <!-- Tab content -->
        <div class="tab-content" id="portfolioReportTabs">
            <% section_data.each_with_index do |(name, list_of_points), idx| %>
                <div class="tab-pane fade show <%= idx == 0 ? 'active' : ''%>" id="<%= name.gsub(" ", "").underscore %>-tab">
                    <% if list_of_points %>
                        <!-- Sometimes the AI returns a string instead of an array, so we just convert to array here. -->
                        <% list_of_points = [list_of_points] unless list_of_points.is_a?(Array) %>
                        <% list_of_points.each do |point| %>
                            <div class="hstack p-3 position-relative border-bottom">
                                <i class="ti ti-player-play fs-5"></i>
                                <div class="ms-3">
                                    <%= point %>
                                </div>
                            </div>
                        <% end %>
                    <% else %>
                        <div class="hstack p-3 position-relative border-bottom">
                            <i class="ti ti-player-play fs-5"></i>
                            <div class="ms-3">
                                <span class="text-muted">No data available</span>
                            </div>
                        </div>
                    <% end %>
                </div>
            <% end %>
        </div>

    <% end %>


<% end %>

