<%
  widget_size ||= "col-md-5"
  name ||= "Company Overview"
  args ||= {}
  title ||= args[:title].presence || name
  investor = @investor
  #  fields have lable and key
  #  Category:category,City:city,Sector:custom_fields.sector,Founder:custom_fields.founder
  fields_to_display = args[:fields] ? args[:fields].split(",").map { |field| field.strip.split(":") } : []
  uri_params ||= {}
%>

<%= render(
      WidgetCardComponent.new(
        widget: widget,
        args: args,
        widget_size: widget.widget_size,
        html_options: { id: "data_card_1" }
      )
    ) do %>

  <div class="card-title"><%= title %></div>
  <div class="data-card">
    <% fields_to_display.each do |label, key| %>
      <div>
        <strong><%= label.titleize %></strong>
        <% value = safe_field_value(investor, key) %>
        <% display_value = if value.is_a?(Date)
                              l(value)
                            elsif value.is_a?(Money)
                              money_to_currency(value, params)
                            else
                              value
                            end %>
        <% safe_title = CGI.escapeHTML(strip_tags(display_value.to_s)).html_safe %>
        <span title="<%= safe_title %>"><%= display_value %></span>
      </div>
    <% end %>
  </div>

<% end %>
