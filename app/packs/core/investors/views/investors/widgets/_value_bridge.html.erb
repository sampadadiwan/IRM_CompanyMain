<%
  widget_size ||= "col-md-6"
  name ||= nil
  args ||= {}
  uri_params ||= {}
  # The uris for the value bridges for each instrument
  uris = []
  # The list of instruments passed
  instrument_names = args[:instruments] || [] # names of the instrument
  across = args[:across] # "first last" or "last 2"
  show_form = args[:show_form]
  hide_table = args[:hide_table] || false
  date_format = args[:date_format]
  # Get the list of instruments for the investor for which the value bridge is to be shown

  if instrument_names == "All"
    # Get all the instruments for the investor
    investment_instruments = @investor.investment_instruments
  else
    # Get the instruments for the investor specified in the json_fields value_bridge_instruments
    instrument_names = @investor.json_fields["value_bridge_instruments"]&.split(",")
    if instrument_names.present?
      investment_instruments = @investor.investment_instruments.where(name: instrument_names)
    else
      # If no instruments are specified, show nothing
      investment_instruments = InvestmentInstrument.none
    end
  end

  valuations = if FormCustomField.where(form_type_id: @investor.valuations.pluck(:form_type_id)).pluck(:name).include?(Valuation::COMPUTE_VAL_BRIDGE_CF)
                  @investor.valuations.with_synthetic.search_custom_fields(Valuation::COMPUTE_VAL_BRIDGE_CF, "1")
                else
                  @investor.valuations.with_synthetic
                end
  # For each instrument, get the valuations and setup the uri
  investment_instruments.each do |instrument|

    valuations = valuations.where(investment_instrument_id: instrument.id)

    if across.nil? || across.strip.downcase == "first last"
      # Get the valuations for the given instrument, first and last
      initial_valuation = valuations.order(valuation_date: :asc).first
      final_valuation =   valuations.order(valuation_date: :asc).last
    else
      # Get the valuations for the given instrument, last 2
      initial_valuation = valuations.order(valuation_date: :desc).offset(1).limit(1).first
      final_valuation =   valuations.order(valuation_date: :desc).first
    end
    # Load the uri for the value bridge
    uri_params[:title] = args[:title]
    uri_params[:portfolio_company_id] = @investor.id
    uri_params[:hide_table] = hide_table
    uri_params[:show_form] = show_form
    uri_params[:initial_valuation_id] = initial_valuation.id if initial_valuation
    uri_params[:final_valuation_id] = final_valuation.id if final_valuation
    uri_params[:date_format] = date_format if date_format
    uri_params[:decimals] = args[:decimals] if args[:decimals]

    uris << URI("/valuations/value_bridge?#{URI.encode_www_form(uri_params)}") if initial_valuation && final_valuation
  end

%>

  <% uris.each do |uri| %>

      <%= render(
            WidgetCardComponent.new(
              widget: widget,
              args: args,
              widget_size: widget.widget_size
            )
          ) do
      %>


          <%= turbo_frame_tag "value_bridge_frame", target: "_top", src: "#{uri.to_s}" do %>
          <% end %>

      <% end %>

  <% end %>
