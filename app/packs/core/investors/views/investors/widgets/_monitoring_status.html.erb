<%# Monitoring Status — the portfolio company agent's latest check of this company (H5, E13, E14, X4, X5).
    Reuses the AI Portfolio Company Dashboard's report detail. openspec/changes/dashboard-insight-widgets/business-rules.md#2 %>
<% return unless insight_widget_visible? %>
<%
  args ||= {}
  # The company this dashboard is about
  company = owner.is_a?(Investor) ? owner : @investor
  # X4 — no agent for the firm (or the viewer may not see it): the widget is not rendered at all
  agent = insight_portfolio_company_agent
%>
<% return if agent.nil? %>
<% report = insight_monitoring_report(agent, company) %>
<%= render(WidgetCardComponent.new(widget: widget, args: args, widget_size: widget.widget_size)) do %>
  <div data-insight-widget="monitoring-status">
    <% if report.nil? %>
      <%# E13 — the agent has not checked this company yet %>
      <%= insight_empty_state("Not checked yet. The portfolio company agent checks each company once a period.") %>
    <% else %>
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted">Checked on <span data-insight-checked-on><%= l(report.updated_at.to_date) %></span></span>
        <%= link_to "All companies", portfolio_company_dashboard_path, class: "btn btn-outline-primary btn-sm",
                    data: { bs_toggle: "tooltip" }, title: "Open the Portfolio Company Dashboard (AI) with every company's latest check" %>
      </div>
      <%# H5, E14 — the latest report's KPI, document and valuation results, exactly as the AI dashboard shows them %>
      <%= render "portfolio_company_dashboard/report_detail", report: report, data: report.json_fields %>
    <% end %>
  </div>
<% end %>
