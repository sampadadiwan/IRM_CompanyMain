<%
  widget_size ||= "col-md-6"
  name ||= nil
  args ||= {}
  uri_params ||= {}
  date_format = args[:date_format] if args[:date_format].present?
  uri = URI("/valuations?owner_id=#{@investor.id}&owner_type=Investor&date_format=#{date_format}")
%>

<%= render(
      WidgetCardComponent.new(
        widget: widget,
        args: args,
        widget_size: widget.widget_size
      )
    ) do
%>
      <%= turbo_frame_tag "valuations_charts_frame", target: "_top", src: "#{uri.to_s}" do %>
      <%end%>


<% end %>

