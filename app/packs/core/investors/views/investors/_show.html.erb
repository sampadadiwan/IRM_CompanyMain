<%= render ToggleCard.new(title: "Stakeholder: #{@investor.investor_name}", css_class: "show_investors", state: "collapsed") do %>

  <%
    show_portfolio_company_agent = @investor.entity.support_agents.set?(:portfolio_company_agent) && @investor.support_agent_report.present?
  %>
  <%= render "/investors/portfolio_company_agent", investor: @investor if show_portfolio_company_agent %>

  <table class="table table-bordered dataTable">

    <tr>
      <td>
        Name
      </td>
      <td>
        <%= @investor.investor_name %>
      </td>
    </tr>

    <tr>
      <td>
        Category
      </td>
      <td>
        <%= @investor.category %>
      </td>
    </tr>

    <tr>
      <td>
        Primary Email
      </td>
      <td>
        <%= @investor.primary_email %>
      </td>
    </tr>


    <% if params[:debug].present? %>


      <tr>
        <td>
          Investee Entity
        </td>
        <td>
          <%= link_to @investor.entity.name, @investor.entity %>
        </td>
      </tr>

      <tr>
        <td>
          Investor Entity
        </td>
        <td>
          <%= link_to @investor.investor_entity.name, @investor.investor_entity %>
        </td>
      </tr>
    <% end %>

    <tr>
      <td>
        Tags
      </td>
      <td>
        <%= raw @investor.tag_list.split(",")&.collect{|tag| link_to(tag, search_investors_path(query: tag))}.join(", ") if @investor.tag_list %>
      </td>
    </tr>

    <% if @investor.category == "Portfolio Company" %>
    <tr>
      <td>
        Sector
      </td>
      <td>
        <%= @investor.sector %>
      </td>
    </tr>
    <% end %>


    <tr>
      <td>
        City
      </td>
      <td>
        <%= @investor.city %>
      </td>
    </tr>

    <%# Changed: Removed NDA exemption toggle from investor show page.
         Why: Exemption is now managed from the NDA Status dashboard via the
           three-dot kebab menu per investor row. Keeps all NDA actions in one place. %>

    <%= display_custom_fields(@investor) if current_user %>


  </table>

<% end %>
