<%= render ToggleCard.new(title: "Stakeholder: #{@investor.investor_name}", css_class: "show_investors", state: "collapsed") do %>

  <%
    show_portfolio_company_agent = @investor.entity.support_agents.set?(:portfolio_company_agent) && @investor.support_agent_report.present?
  %>
  <%= render "/investors/portfolio_company_agent", investor: @investor if show_portfolio_company_agent %>

  <table class="table table-bordered dataTable">

    <tr>
      <td>
        Name
      </td>
      <td>
        <%= @investor.investor_name %>
      </td>
    </tr>

    <tr>
      <td>
        Category
      </td>
      <td>
        <%= @investor.category %>
      </td>
    </tr>

    <tr>
      <td>
        Primary Email
      </td>
      <td>
        <%= @investor.primary_email %>
      </td>
    </tr>


    <% if params[:debug].present? %>


      <tr>
        <td>
          Investee Entity
        </td>
        <td>
          <%= link_to @investor.entity.name, @investor.entity %>
        </td>
      </tr>

      <tr>
        <td>
          Investor Entity
        </td>
        <td>
          <%= link_to @investor.investor_entity.name, @investor.investor_entity %>
        </td>
      </tr>
    <% end %>

    <tr>
      <td>
        Tags
      </td>
      <td>
        <%= raw @investor.tag_list.split(",")&.collect{|tag| link_to(tag, search_investors_path(query: tag))}.join(", ") if @investor.tag_list %>
      </td>
    </tr>

    <% if @investor.category == "Portfolio Company" %>
    <tr>
      <td>
        Sector
      </td>
      <td>
        <%= @investor.sector %>
      </td>
    </tr>
    <tr>
      <td>
        Managed by
      </td>
      <td id="investor_managed_by">
        <%= @investor.managed_by&.full_name %>
      </td>
    </tr>
    <% end %>


    <tr>
      <td>
        City
      </td>
      <td>
        <%= @investor.city %>
      </td>
    </tr>

    <%# NDA exemption toggle — investor-level control that bulk-updates all InvestorAccess
         records for this investor. Only visible when entity has Data Rooms enabled and
         the current user is a GP employee. Per product decision (2026-10-06). %>
    <% if @investor.entity.permissions.enable_data_rooms? && current_user.curr_role_employee? %>
      <% exempt = @investor.investor_accesses.where(entity_id: current_user.entity_id).exists?(exempt_from_nda: true) %>
      <tr>
        <td>Exempt from NDA</td>
        <td>
          <%= form_with url: toggle_nda_exemption_investor_path(@investor), method: :patch, data: { turbo: false } do |f| %>
            <%= f.check_box :exempt_from_nda, checked: exempt, class: "form-check-input", onchange: "this.form.submit()" %>
            <small class="text-muted ms-2"><%= exempt ? "All users bypass NDA" : "Users must accept NDA" %></small>
          <% end %>
        </td>
      </tr>
    <% end %>

    <%= display_custom_fields(@investor) if current_user %>


  </table>

<% end %>
