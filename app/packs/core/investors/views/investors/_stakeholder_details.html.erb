<%
  label = t('investor_details_nav.users')
%>

<div class="associated_entity" data-controller="tabs">
  <%
    # Access permissions decide which Access screens are listed (same rules as before: Investor Access
    # for anyone who can update the stakeholder, Employee Access also needs company admin)
    can_update = policy(investor).update?
    show_employee_access = can_update && current_user.has_cached_role?(:company_admin)
    # ?tab=access-rights-tab links (e.g. from access-right rows) land on the first access-rights screen shown
    employee_access_pane_id = "access-rights-tab"
    investor_access_pane_id = show_employee_access ? "access_rights_for_investors_tab" : "access-rights-tab"

    # Screens grouped under each dropdown tab (layouts/_dropdown_tab), filtered to what this user can see.
    # Investment Details holds the KYC (first, as it comes before investing) and what the stakeholder
    # holds: commitments and units for a fund, investments otherwise
    kyc_tab = ({ pane: "kycs-tab", icon: "ti-id", label: t('investor_details_nav.kyc'), hint: t('investor_details_nav_hints.kyc') } if investor.entity.permissions.enable_kycs?)
    holding_tabs = if current_user.entity.is_fund?
                     [{ pane: "commitments-tab", icon: "ti-file-certificate", label: t('investor_details_nav.commitments'), hint: t('investor_details_nav_hints.commitments') },
                      { pane: "fund-units-tab", icon: "ti-stack-2", label: t('investor_details_nav.units'), hint: t('investor_details_nav_hints.units') }]
                   elsif investor.entity.permissions.enable_investments?
                     [{ pane: "investments-tab", icon: "ti-briefcase", label: t('investor_details_nav.investments'), hint: t('investor_details_nav_hints.investments') }]
                   else
                     []
                   end
    investment_detail_tabs = [kyc_tab, *holding_tabs].compact
    # Activity holds what's been logged against the stakeholder: notes, tasks and (admins) filed emails
    # (panes in investors/_activity_panes, shared with the portfolio company page)
    show_emails = current_user.has_cached_role?(:company_admin) && policy(IncomingEmail.new).index?
    activity_tabs = [
      { pane: "notes-tab", icon: "ti-notes", label: t('investor_details_nav.notes'), hint: t('investor_details_nav_hints.notes') },
      { pane: "tasks-tab", icon: "ti-list-check", label: t('investor_details_nav.tasks'), hint: t('investor_details_nav_hints.tasks') },
      ({ pane: "emails-tab", icon: "ti-mail", label: t('investor_details_nav.emails'), hint: t('investor_details_nav_hints.emails') } if show_emails)
    ].compact
    manage_tabs = [
      ({ pane: employee_access_pane_id, icon: "ti-building", label: t('investor_details_nav.employee_access'), hint: t('investor_details_nav_hints.employee_access') } if show_employee_access),
      ({ pane: investor_access_pane_id, icon: "ti-shield-lock", label: t('investor_details_nav.investor_access'), hint: t('investor_details_nav_hints.investor_access') } if can_update)
    ].compact
  %>
  <%# Investment Details, Activity and Manage are dropdown tabs; every screen is a pane in the one tab-content below,
      so ?tab=<pane id> deep links open it directly %>
  <nav id="investor_tabs" class="nav nav-pills nav-justified p-3 mb-3 rounded align-items-center card flex-row"  role="tablist">

      <a id="stakeholder_users_tab" class="nav-link active" data-bs-toggle="pill" data-bs-toggle="tab" href="#investors-tab">
        <i class="ti ti-users me-1"></i><%= label %>
      </a>

      <%= render "layouts/dropdown_tab", icon: "ti-briefcase", label: t('investor_details_nav.investment_details'), items: investment_detail_tabs %>
      <%= render "layouts/dropdown_tab", icon: "ti-activity", label: t('investor_details_nav.activity'), items: activity_tabs %>
      <%= render "layouts/dropdown_tab", icon: "ti-settings", label: t('investor_details_nav.manage'), items: manage_tabs %>

  </nav>

  <div class="tab-content" data-controller="datatable">

        <div id="investors-tab" class="tab-pane fade show active">
          <div id="investor_accesses" class="associated_entity" data-controller="tooltip">
            <% params[:investor_id] = investor.id %>
            <%= render "/investor_accesses/index", investor_accesses: investor.investor_accesses.includes(:user, :granter),
                investor: investor, label: label %>
          </div>
        </div>

        <div id="investments-tab" class="tab-pane fade">
          <div id="investments" class="associated_entity">
            <%= turbo_frame_tag "investments_frame", target: "_top", src: investments_path(investor_id: investor.id), loading: :lazy do %>
              <%= render "/layouts/loading" %>
            <% end %>
          </div>
        </div>

        <%# Activity menu: notes, tasks, emails %>
        <%= render "investors/activity_panes", investor: investor, show_emails: show_emails %>

        <div id="reminders-tab" class="tab-pane fade">
          <div id="reminders" class="associated_entity">
            <%= turbo_frame_tag "reminders_list", target: "_top", src: reminders_path( owner_id: investor.id, owner_type: "Investor", sent: false), loading: :lazy do %>
              <%= render "/layouts/loading" %>
            <% end %>
          </div>
        </div>

        <% if investor.entity.permissions.enable_kycs? %>
          <div id="kycs-tab" class="tab-pane fade">
            <div id="kycs" class="associated_entity">
              <%= turbo_frame_tag "investor_kycs_frame", loading: :lazy, src: investor_kycs_path(investor_id: investor.id), target: "_top" do %>
                <%= render "/layouts/loading" %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div id="commitments-tab" class="tab-pane fade in">
          <div id="commitments" class="associated_entity">
            <%= turbo_frame_tag "capital_commitments_frame", target: "_top", loading: :lazy, src: capital_commitments_path(investor_id: investor.id) do %>
              <%= render "/layouts/loading" %>
            <% end %>
          </div>
        </div>

        <div id="fund-units-tab" class="tab-pane fade">
          <div id="fund_units" class="associated_entity">
            <%= turbo_frame_tag "fund_units_frame", target: "_top", src: fund_units_path(investor_id: investor.id, cols: "all"), loading: :lazy do %>
              <%= render "/layouts/loading" %>
            <% end %>
          </div>
        </div>


      <%# Access screens (Manage menu) %>
      <% if show_employee_access %>
        <div id="<%= employee_access_pane_id %>" class="tab-pane fade">
          <%= turbo_frame_tag "investor_access_rights_frame", target: "_top", loading: :lazy,  src: access_rights_path(owner_id: investor.id, owner_type: "Investor", entity_id: investor.entity_id, form_type: "investor_form", frame: "investor_access_rights_frame") do %>
          <% end %>
        </div>
      <% end %>

      <% if can_update %>
        <div id="<%= investor_access_pane_id %>" class="tab-pane fade">
          <%= turbo_frame_tag "access_rights_frame", target: "_top", loading: :lazy,  src: access_rights_path(investor_id: investor.id , entity_id: current_user.entity_id, form_type: "none", owner_id: investor.id, owner_type: "Investor", with_deleted: true)  do %>
          <% end %>
        </div>
      <% end %>

  </div>
</div>