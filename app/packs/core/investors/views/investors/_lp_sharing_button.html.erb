<%#
  Company page button bar: one "LPs" menu for everything LP-facing — its label shows the company's state
  (Visible to LPs / Not shared with LPs), and it holds Show to LPs or Hide from LPs plus Preview as LP…, in the
  bar's existing dropdown style (as Misc). Hide goes through the app's confirm popup; the posted value is explicit,
  so a double click does no harm.
  Worked examples H9, H13, H18, E45, E72 — openspec/changes/lp-folio-portfolio-dashboard/business-rules.md
%>
<div class="btn-group">
  <div class="dropdown">
    <%# The label is the company's current state, so it reads at a glance without opening the menu %>
    <button class="btn <%= investor.show_to_lps ? 'btn-outline-success' : 'btn-outline-secondary' %> dropdown-toggle d-inline-flex align-items-center"
            type="button" id="lp_sharing_menu" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
      <% if investor.show_to_lps %>
        <i class="ti ti-world"></i> Visible to LPs
      <% else %>
        <i class="ti ti-world-off"></i> Not shared with LPs
      <% end %>
    </button>
    <div class="dropdown-menu" aria-labelledby="lp_sharing_menu">
      <% if investor.show_to_lps %>
        <%# H18 — confirm first: LPs lose the page, their portfolio list keeps the company %>
        <%= button_to lp_sharing_investor_path(investor, show_to_lps: false), method: :patch,
                      class: "dropdown-item d-flex align-items-center",
                      data: { action: "click->confirm#popup", turbo: false, method: "patch", title: "Hide from LPs?",
                              msg: "LPs will no longer be able to open this company's page. Their portfolio list still shows the company." } do %>
          <i class="ti ti-world-off"></i> Hide from LPs
        <% end %>
      <% else %>
        <%# H9 — one click; the tooltip says who gains the page and what they see %>
        <%= button_to lp_sharing_investor_path(investor, show_to_lps: true), method: :patch,
                      class: "dropdown-item d-flex align-items-center",
                      data: { bs_toggle: "tooltip",
                              bs_title: "LPs who hold this company will be able to open its page. They see the holdings card and the widgets of the LP layout that matches this company's tags." } do %>
          <i class="ti ti-world"></i> Show to LPs
        <% end %>
      <% end %>

      <%# H13 — the fund team sees the LP Company Dashboard as a chosen LP %>
      <a href="#" class="dropdown-item d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#lpPreviewModal"
         title="See this company's LP page exactly as a chosen LP would">
        <i class="ti ti-eye"></i> Preview as LP…
      </a>
    </div>
  </div>
</div>
