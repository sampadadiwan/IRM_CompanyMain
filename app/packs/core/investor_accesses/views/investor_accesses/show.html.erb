<%= render ToggleCard.new(title: @investor_access.user, css_class: "show_ia", state: "show") do %>

  <table class="table table-bordered dataTable">

    <tr>
      <td>
        Stakeholder
      </td>
      <td>
        <%= @investor_access.investor.investor_name %>
      </td>
    </tr>
    <tr>
      <td>
        User
      </td>
      <td>
        <%= @investor_access.user.name if @investor_access.user %>
      </td>
    </tr>
    <tr>
      <td>
        Email
      </td>
      <td>
        <%= @investor_access.email %>
      </td>
    </tr>
    <tr>
      <td>
        Email Enabled
      </td>
      <td>
        <%= display_boolean @investor_access.email_enabled %>
      </td>
    </tr>
    <tr>
      <td>
        Approved
      </td>
      <td>
        <%= @investor_access.approved ? "Yes" : "No" %>
      </td>
    </tr>
    <tr>
      <td>
        Granted By
      </td>
      <td>
        <%= @investor_access.granter&.name %>
      </td>
    </tr>


  </table>



  <div>
    <%= link_to  t_common(:edit) , edit_investor_access_path(@investor_access), {class: "btn btn-outline-primary" } %>
    <%= button_to t_common(:delete) , @investor_access, method: :delete, class: "btn btn-outline-danger" , form_class: "deleteButton"%>
  </div>


  <% end %>




  <% if @advisor_access_rights %>

    <div class="table-responsive mt-5">
      <h4>Fund Access Granted as Investor Advisor</h4>
      <table class="table table-bordered dataTable">
        <thead>
          <tr>
            <th class="text-col">Fund</th>
            <th class="text-col">Granted By</th>
          </tr>
        </thead>
        <tbody>
          <% if @advisor_access_rights.present? %>
            <% @advisor_access_rights.each do |access_right| %>
              <tr>
                <td class="text-col">
                  <%= link_to access_right.owner.name, fund_path(access_right.owner) if access_right.owner %>
                </td>
                <td class="text-col">
                  <%= access_right.granted_by&.full_name %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td class="text-col" colspan="2">No fund access rights found for this advisor.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  <% end %>