<% investor_id ||= params[:investor_id] %>
<tr id="<%= dom_id investor_access %>">
  <% if investor_id.blank? %>
    <td class="text-col">
      <%= link_to investor_access.investor_name, investor_access.investor %>
    </td>
  <% end %>
  <td class="text-col">
    <%# User name links to this access's show page — same target and policy gate as
        the "View" action in the dropdown below; plain text when not permitted %>
    <% if investor_access.user %>
      <% if policy(investor_access).show? %>
        <%= link_to investor_access.user.name,
                    investor_access_path(investor_access, investor_id: investor_id) %>
      <% else %>
        <%= investor_access.user.name %>
      <% end %>
    <% end %>
  </td>
  <td class="text-col">
    <%= investor_access.is_investor_advisor ? "Advisor" : "Employee" %>
  </td>
  <td class="text-col">
    <%= investor_access.email %>
    <% if investor_access.cc.present? %>
      <% cc_emails = investor_access.cc.split(',').map(&:strip) %>
      <br>
      <span class="text-muted small">cc: <%= cc_emails.first %></span>
      <% if cc_emails.size > 1 %>
        <span class="badge bg-secondary ms-1"
              data-bs-toggle="tooltip"
              data-bs-placement="top"
              data-bs-html="true"
              title="<%= cc_emails[1..].join('<br>').html_safe %>"
              style="cursor: default;">+<%= cc_emails.size - 1 %> more</span>
      <% end %>
    <% end %>
  </td>
  <td class="text-col">
    <%= display_boolean investor_access.email_enabled %>
    <% if investor_access.tag_list.present? %>
      <br>
      <% investor_access.tag_list.split(',').map(&:strip).each do |tag| %>
        <span class="badge bg-primary-subtle text-primary me-1"><%= tag %></span>
      <% end %>
    <% else %>
      <br><span class="badge bg-secondary-subtle text-secondary">all topics</span>
    <% end %>
  </td>
  <td class="text-col">
    <%= "(#{investor_access.user.call_code})#{investor_access.user.phone}" %>
  </td>
  <td class="text-col">
    <%= display_boolean investor_access.whatsapp_enabled %>
  </td>
  <td class="text-col">
    <%= display_boolean investor_access.user.whatsapp_enabled %>
  </td>
  <td class="text-col">
    <%= display_boolean investor_access.approved %>
  </td>
  <td class="text-col">
    <%= investor_access.granter&.name %>
  </td>
  <td class="action-col">
    <%
      label = investor_access.approved ? "UnApprove" : "Approve"
      icon_class = investor_access.approved ? "ti ti-user-x" : "ti ti-user-check"
      btn_class = investor_access.approved ? "btn btn-outline-warning" : "btn btn-outline-success"
      # LP CRM: unapproved rows double as contact-only records, so make the
      # consequence of approving explicit before anyone bulk-approves contacts.
      help_text = investor_access.approved ? "Un-approve removes platform access and stops notifications for the user" : "Approve grants platform access and enables notifications for the user"
    %>
    <% if policy(investor_access).approve? %>
      <%# Bootstrap tooltip on hover — same data-bs-toggle pattern used elsewhere %>
      <span data-bs-toggle="tooltip" title="<%= help_text %>">
        <%= button_to approve_investor_access_path(investor_access, investor_id: investor_id),
                      method: :patch, class: btn_class, form_class: "deleteButton" do %>
          <i class="<%= icon_class %>"></i><%= label %>
        <% end %>
      </span>
    <% end %>
    <div class="btn-group">
      <div class="dropdown">
        <button class="btn btn-outline-primary dropdown-toggle" type="button"
                data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <i class="ti ti-settings"></i> <%= t_common(:actions) %>
        </button>
        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">

          <% if policy(investor_access).show? %>
            <%= link_to investor_access_path(investor_access, investor_id: investor_id), class: "dropdown-item" do %>
              <i class="ti ti-eye"></i> <%= t_common(:view) %>
            <% end %>
          <% end %>

          <% if policy(investor_access).edit? %>
            <%= link_to edit_investor_access_path(investor_access, investor_id: investor_id),
                        data: { turbo_frame: 'new_investor_access' }, class: "dropdown-item" do %>
              <i class="ti ti-edit"></i> <%= t_common(:edit) %>
            <% end %>
          <% end %>
          <% if Pundit.policy(current_user, investor_access).destroy? %>
            <%= button_to investor_access, method: :delete, class: "dropdown-item", form_class: "deleteButton",
                          data: { action: "click->confirm#popup" } do %>
              <i class="ti ti-trash"></i> <%= t_common(:delete) %>
            <% end %>
          <% end %>
          <% if policy(investor_access).edit? %>
            <%= link_to notifications_path(all: true, filter: true, entity_id: investor_access.entity_id,
                                            q: ransack_query_params("user_email", :eq, investor_access.email)),
                        class: "dropdown-item" do %>
              <i class="ti ti-bell"></i>Notifications
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </td>
</tr>
