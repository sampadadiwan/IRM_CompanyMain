

<div data-controller="investoraccess">
<%= render FormCard.new(title: "Stakeholder User", css_class: "dynamic_form") do %>

  <div id="toasts" aria-live="polite" aria-atomic="true" style="position: relative;"></div>

  <%
    # Loaded inline into the new_investor_access frame (list/tab flow), or as the
    # standalone /edit page reached from the show page? Both submit from inside
    # the frame markup, so the submit alone can't tell them apart — but only the
    # inline load *arrives* as a frame request. Decide here and carry the answer
    # through the submit. Same pattern as notes/_form.html.erb.
    inline_frame = turbo_frame_request_id == "new_investor_access"
  %>
  <%# Standalone page: escape the frame so update's redirect navigates the whole
      page back to show — Turbo would otherwise hunt for a new_investor_access
      frame in the destination and find none. %>
  <%= form_with(model: investor_access, validate: true, data: (inline_frame ? {} : { turbo_frame: "_top" })) do |form| %>
    <%= hidden_field_tag :inline_frame, "new_investor_access" if inline_frame %>
    <% if investor_access.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(investor_access.errors.count, "error") %> prohibited this investor_access from being saved:</h2>

        <ul>
          <% investor_access.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= hidden_field_tag :investor_id, params[:investor_id] %>

    <div class="form-group">
      <%= form.label :investor %>
      <%= form.text_field :investor_name, class: "form-control", value: investor_access.investor.investor_name, disabled: true %>
      <%= form.number_field :investor_id, class: "form-control", hidden: true  %>
    </div>

    <% if investor_access.user %>
    <div class="form-group">
      <%= form.label :user %>
      <%= form.text_field :user_name, class: "form-control", value: investor_access.user.name, disabled: true  %>
      <%= form.number_field :user_id, class: "form-control", hidden: true  %>
    </div>
    <% end %>

    <% if @investor_access.new_record? %>
    <div class="form-group">
      <%= form.label :email %>
      <%= form.text_field :email, class: "form-control"  %>
    </div>
    <% end %>


    <div class="form-group">
      <%= form.label :email_enabled %>
      <%= form.check_box :email_enabled, class: "form-check-input"  %>
      <small class="text-muted">Send email notifications to this user.</small>
    </div>

    <div class="form-group">
      <%= form.label :tag_list, "Notification Topics (tag_list)" %>
      <%= form.text_field :tag_list, class: "form-control", placeholder: "e.g. CapitalCall,KYC" %>
      <small class="text-muted">
        Comma-separated topics this contact subscribes to (e.g. <code>CapitalCall</code>, <code>KYC</code>, <code>Approval</code>, <code>Distribution</code>, <code>Deal</code>, <code>InvestmentOpportunity</code>, <code>SecondarySale</code>, <code>Kpi</code>).
        Leave blank to receive all notifications.
      </small>
    </div>

    <div class="form-group">
      <%= form.label :cc %>
      <%= form.text_field :cc, class: "form-control"  %>
      <small class="text-muted">Cc on emails sent to this user. Comma separated emails.</small>
    </div>

    <% if @investor_access.new_record? %>
    <div class="form-group">
      <%= form.label :first_name %>
      <%= form.text_field :first_name, class: "form-control"  %>
    </div>

    <div class="form-group">
      <%= form.label :last_name %>
      <%= form.text_field :last_name, class: "form-control"  %>
    </div>

    <div class="row">
      <div class="form-group col-5">
        <%= form.label "Country Code" %>
        <%= form.number_field :call_code, class: "form-control" %>
      </div>
      <div class="form-group col-7">
        <%= form.label :phone %>
        <%= form.number_field :phone, class: "form-control"  %>
      </div>
    </div>

    <div class="form-group">
      <%= form.label :whatsapp_enabled %>
      <%= form.check_box :whatsapp_enabled, class: "form-check-input"  %>
      <small class="text-muted">Send WhatsApp notifications to this user.</small>
    </div>


    <% end %>

    <%# LP CRM: tenant-configured contact fields (designation, POC role, intro,
        primary flag, ...) from the entity's "InvestorAccess" FormType. Renders
        nothing until the entity configures that form type — zero-impact default.
        Same helper every WithCustomField form uses (see tasks/_form). %>
    <%= custom_form_fields(investor_access, form) %>

    <div class="form-group">
      <%= form.label :approved %>
      <%= form.check_box :approved, class: "form-check-input"  %>
      <%# LP CRM: unapproved = CRM contact only — recorded for relationship
          tracking, no portal access and no notification until approved. %>
      <small class="text-muted">Leave unchecked to store this person as a contact only (no portal access).</small>
    </div>

    <%# Changed: Added exempt_from_nda checkbox for stakeholder-level NDA exemption.
         Why: Per product decision (2026-10-05) — GP can exempt an investor from NDA
         at the time of granting access. All users under this investor bypass the NDA gate. %>
    <div class="form-group">
      <%= form.label :exempt_from_nda, "Exempt from NDA" %>
      <%= form.check_box :exempt_from_nda, class: "form-check-input" %>
      <small class="text-muted">If checked, this stakeholder's users bypass the NDA requirement for all Data Room folders.</small>
    </div>


    <div class="form-group">
      <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
      <%# Close only makes sense in the inline (turbo-frame) flow, where it clears
          the form frame. On the standalone /edit page it would just blank the
          form with no navigation, so it is not rendered there. %>
      <% if inline_frame %>
        <a class="btn btn-outline-danger", data-action="click->investoraccess#close">Close</a>
      <% end %>
    </div>
  <% end %>

<% end %>
</div>

