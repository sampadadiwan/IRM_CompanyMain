<% show_form = params[:show_form] || true %>
<%= render FormCard.new(title: "Value Bridge") do %>
  <%= form_with(model: Valuation.new(entity_id: current_user.entity_id), url: value_bridge_valuations_path, method: :get, data: { turbo_frame: "value_bridge_frame", controller: "valuebridge" }) do |form| %>

    <% valuations = @portfolio_company.valuations.with_synthetic.order(valuation_date: :desc).map { |i| [i.to_extended_s, i.id] } %>

    <%= form.hidden_field :portfolio_company_id, value: @portfolio_company.id, name: :portfolio_company_id %>
    <%= form.hidden_field :show_form, value: show_form, name: :show_form %>
    <%= form.hidden_field :hide_table, value: params[:hide_table], name: :hide_table %>
    <% if params[:date_format].present? %>
      <%= form.hidden_field :date_format, value: params[:date_format], name: :date_format %>
    <% end %>

    <div class="d-flex align-items-end gap-5 w-100">
      <div class="flex-grow-1" style="min-width: 0;">
        <%= form.label :initial_valuation_id, "Start Point", class: "ms-1 form-label" %>
        <%= form.select :initial_valuation_id, valuations, { selected: params[:initial_valuation_id] }, class: "form-select", name: :initial_valuation_id, data: { action: "change->valuebridge#submit" } %>
      </div>

      <div class="flex-grow-1" style="min-width: 0;">
        <%= form.label :final_valuation_id, "End Point", class: "ms-1 form-label" %>
        <%= form.select :final_valuation_id, valuations, { selected: params[:final_valuation_id] }, class: "form-select", name: :final_valuation_id, data: { action: "change->valuebridge#submit" } %>
      </div>

      <div style="width: 130px; flex-shrink: 0">
        <%= form.select :moic, [["Amount", "0"], ["MOIC", "1"]], { selected: params[:moic] == "1" ? "1" : "0" }, class: "form-select", name: :moic, data: { action: "change->valuebridge#submit" } %>
      </div>
    </div>

  <% end %>
<% end %>
