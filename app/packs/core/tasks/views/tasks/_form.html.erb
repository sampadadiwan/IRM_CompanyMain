<div id="toasts" aria-live="polite" aria-atomic="true" style="position: relative;"></div>

<div data-controller="access task-recurrence task-owner" data-task-recurrence-advanced-visible-value="false">

<%= render FormCard.new(title: "Task", css_class: "dynamic_form") do %>

    <%= form_with(model: task, id: "task_form", class: "task_form", validates: true) do |form| %>
      <% if task.errors.any? %>
        <div class="alert alert-danger">
          <h2><%= pluralize(task.errors.count, "error") %> prohibited this task from being saved:</h2>

          <ul>
            <% task.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form.text_field :entity_id, class: "form-control", hidden: true  %>
      <%= form.text_field :for_entity_id, class: "form-control", hidden: true  %>
      <%= form.text_field :user_id, class: "form-control", hidden: true  %>
      <%= hidden_field_tag :embedded_task_context, params[:embedded_task_context] %>
      <%= hidden_field_tag :embedded_owner_id, params[:owner_id].presence || params.dig(:task, :owner_id) %>

      <%= hidden_field_tag :deal_id, params[:deal_id] if params[:deal_id].present? %>
      <%# Opened from a kanban card: the save must re-render a board card, not a
          list row (see update.turbo_stream.erb) %>
      <%= hidden_field_tag :board, params[:board] if params[:board].present? %>
      <%# The contact filter of the list this form was opened from — distinct from
          task[touch_point_id], which is the task's own contact. The controller
          compares the two to decide whether the saved task belongs in that list. %>
      <% list_touch_point_id = params[:list_touch_point_id].presence || params[:touch_point_id].presence %>
      <%= hidden_field_tag :list_touch_point_id, list_touch_point_id if list_touch_point_id %>
      <%# Echoed back so the row returned by the create/update stream carries the
          same columns as the list that opened this form (see tasks/_task.html.erb) %>
      <%= hidden_field_tag :show_owner, params[:show_owner] if params[:show_owner].present? %>

      <%
        task_context = params[:embedded_task_context].presence
        restricted_embedded_context = task_context.in?(%w[deal_tab deal_investor_tab])
        effective_owner_type = task.owner_type.presence
        effective_owner_type ||= "User" if task_context.blank?
        task.owner_type = effective_owner_type

        # Owner types this form has no picker for: the task was opened from that
        # record's own page (a capital commitment, a portfolio investment, a side
        # letter obligation...), so its owner is fixed. Without this the select
        # below offers only User/Investor, the browser falls back to the first
        # option, and saving silently re-owns the task to the editor — the same
        # bug DealInvestor tasks used to hit outside the deal tabs.
        record_owner_type = effective_owner_type.present? &&
                            !effective_owner_type.in?(%w[User Investor DealInvestor])

        investor_owner_options = current_user.entity.investors.includes(:investor_entity).sort_by { |investor| investor.investor_name }.map { |investor| [investor.investor_name, investor.id] }
        owner_options = nil
        if effective_owner_type == "DealInvestor"
          if params[:deal_id].present?
            deal = current_user.entity.deals.find_by(id: params[:deal_id])
            owner_options = deal&.deal_investors&.includes(:investor)&.sort_by { |di| di.investor_name }&.map { |di| [di.investor_name, di.id] }
          end
          owner_options ||= current_user.entity.deal_investors.includes(:investor).sort_by { |deal_investor| deal_investor.investor_name }.map { |deal_investor| [deal_investor.investor_name, deal_investor.id] }
        elsif record_owner_type
          # No options list — the hidden owner_id below carries the record it
          # belongs to. An investor select here would show nothing selected and
          # blank the owner on save.
          owner_options = nil
        elsif task_context.blank? || effective_owner_type == "Investor"
          owner_options = investor_owner_options
        end

        owner_type_disabled = restricted_embedded_context || record_owner_type
        owner_type_options = if task_context.blank?
          [["User", "User"], ["Investor", "Investor"]]
        elsif effective_owner_type == "Investor"
          [["Investor", "Investor"]]
        else
          [["Deal Investor", "DealInvestor"]]
        end

        # An existing task must always find its own owner type in this list. When
        # it doesn't — a DealInvestor task edited outside the deal tab, say — the
        # browser silently falls back to the first option (User) and saving
        # re-owns the task to the editor, unlinking it from its deal. Appending
        # the real type keeps "leave it alone" the default.
        if task.persisted? && effective_owner_type.present? &&
           owner_type_options.none? { |(_label, value)| value == effective_owner_type }
          owner_type_options += [[effective_owner_type.underscore.humanize.titleize, effective_owner_type]]
        end

        owner_locked = effective_owner_type == "DealInvestor" && task.owner_id.present? && task_context == "deal_investor_tab"
        show_for_field = effective_owner_type != "User"
        show_name_field = task_context.blank? && effective_owner_type == "User"
      %>

      <%# Opened from a deal or deal investor tab, the owner type is fixed (the
          controller forces DealInvestor regardless of what is posted), so the
          field is submitted hidden rather than shown as a greyed-out select
          that reads as editable. %>
      <% if owner_type_disabled %>
        <%= form.hidden_field :owner_type %>
      <% else %>
        <div class="form-group">
          <%= form.label :owner_type, "Owner Type" %>
          <%= form.select :owner_type,
                          owner_type_options,
                          { selected: effective_owner_type, include_blank: false },
                          class: "form-control",
                          data: {
                            "task-owner-target": "ownerType",
                            action: "change->task-owner#ownerTypeChanged"
                          } %>
        </div>
      <% end %>

      <% if owner_options.present? %>
        <%# Same for "For" on a deal investor's own tab: the investor is already
            chosen by the tab you are in. The deal tab keeps the select — there
            you still pick WHICH investor on the deal the task is for. %>
        <% if owner_locked %>
          <%= form.hidden_field :owner_id %>
        <% else %>
          <div class="form-group <%= show_for_field ? '' : 'd-none' %>" data-task-owner-target="ownerForGroup">
            <%= form.label :owner_id, "For" %>
            <%= form.select :owner_id,
                            owner_options,
                            { selected: task.owner_id, include_blank: true },
                            class: "form-control",
                            data: {
                              "task-owner-target": "ownerForSelect",
                              locked: false
                            } %>
          </div>
        <% end %>
      <% else %>
        <%# No picker for this owner type (a personal task, or one owned by a
            record this form has no options list for) — carry the id through as
            a real hidden field so it survives the save. %>
        <%= form.hidden_field :owner_id %>
      <% end %>

      <div class="form-group <%= show_name_field ? '' : 'd-none' %>" data-task-owner-target="ownerNameGroup">
        <%= form.label :owner_name, "Name" %>
        <%= text_field_tag :owner_name, current_user.full_name, class: "form-control", disabled: true %>
      </div>

      <div class="form-group">
        <%= form.label :details %>
        <%= form.rich_text_area :details, class: "form-control"  %>
      </div>

      <% if task.entity_id == current_user.entity_id %>
      <div class="form-group">
        <%= form.label :response %>
        <%= form.rich_text_area :response, class: "form-control"  %>
      </div>
      <% end %>

      <%# LP CRM: the person at the LP this task involves — the external counterpart
          to assigned_to (the internal GP user). Same rendering rule as the note
          form: only when the owner is already loaded, which covers both the
          stakeholder page and the deal investor tab (a DealInvestor offers its
          parent LP's contacts). %>
      <% if task.owner.respond_to?(:touch_point_options) %>
        <% touch_point_options = task.owner.touch_point_options %>
        <% if touch_point_options.present? %>
          <div class="form-group">
            <%= form.label :touch_point_id, "Touch Point" %>
            <%= form.select :touch_point_id, touch_point_options, { selected: task.touch_point_id, include_blank: true }, class: "form-control" %>
            <small class="text-muted">Who at the stakeholder this task involves.</small>
          </div>
        <% end %>
      <% end %>

      <div class="form-group">
        <%= form.label :due_date %>
        <%= form.date_field :due_date, class: "form-control"  %>
      </div>

      <div class="form-group" data-controller="otherselect" data-otherselect-select-id-value="#task_category">
        <%= form.label :category %>
        <%= form.select :category, Task::CATEGORIES, { include_blank: true }, class: "form-control", "data-action": "change->otherselect#checkOtherName"  %>
        <%= form.text_field :category, class: "form-control", disabled: true, id: "other_name", hidden: true %>
      </div>

      <% if task.owner == nil || current_user.entity_id == task.owner.entity_id %>
        <div class="form-group">
          <%= form.label :assigned_to %>
          <%= form.select :assigned_to_id, task.entity.employees.map{|u| [u.full_name, u.id]} ,{}, class: "form-control"  %>
        </div>

        <div class="form-group">
          <%= form.label :tags %>
          <%= form.text_field :tags, class: "form-control"  %>
        </div>

      <% end %>

      <%= custom_form_fields(task, form) %>


      <%
        show_completed ||= false
        if show_completed
      %>
        <div class="form-group">
          <%= form.label :completed %>
          <%= form.check_box :completed, class: "form-check-input"  %>
        </div>

      <% end %>

      <%
        if current_user.support?
      %>
        <div class="form-group">
          <%= form.label :for_support %>
          <%= form.check_box :for_support, class: "form-check-input"  %>
        </div>
      <% end %>

      <%
          is_recurring = task.task_recurrence_rule_id.present?
          rule = task.task_recurrence_rule
          # Simple parsing of RRULE: FREQ=DAILY;INTERVAL=1
          pattern = rule&.rrule&.match(/FREQ=([^;]+)/)&.captures&.first&.downcase || 'daily'
          interval = rule&.rrule&.match(/INTERVAL=(\d+)/)&.captures&.first || 1
        %>

        <div class="form-group">
          <%= label_tag :make_recurring, "Make Recurring", class: "form-check-label" %>

          <%= check_box_tag :make_recurring, "1", is_recurring, class: "form-check-input", data: { "task-recurrence-target": "recurrenceToggle", action: "change->task-recurrence#toggleRecurrence" } %>
        </div>

        <div class="<%= is_recurring ? '' : 'd-none' %>" data-task-recurrence-target="recurrenceFields">
          <div class="form-group">
            <%= label_tag :recurrence_pattern, "Pattern" %>
            <%= select_tag :recurrence_pattern, options_for_select([['Daily', 'daily'], ['Weekly', 'weekly'], ['Monthly', 'monthly'], ['Quarterly', 'quarterly'], ['Yearly', 'yearly']], pattern), class: "form-control", name: "recurrence_pattern" %>
          </div>
          <div class="form-group">
            <%= label_tag :recurrence_interval, "Repeat every" %>
            <%= number_field_tag :recurrence_interval, interval, min: 1, class: "form-control", name: "recurrence_interval" %>
          </div>
          <div class="form-group">
            <%= label_tag :recurrence_end_date, "End Date (Optional)" %>
            <%= date_field_tag :recurrence_end_date, rule&.end_date&.to_date, class: "form-control", name: "recurrence_end_date" %>
          </div>
        </div>

      <%# The Uppy drop area is tall and most tasks never carry a document, so it
          starts collapsed behind a link — on the kanban board especially, it was
          pushing Save below the fold. The markup is still rendered (Uppy needs to
          initialise), just hidden until asked for. %>
      <div class="form-group">
        <a class="btn btn-sm btn-outline-secondary" role="button"
           data-bs-toggle="collapse" href="#task_documents_upload"
           aria-expanded="false" aria-controls="task_documents_upload">
          <i class="ti ti-paperclip"></i> Add Documents
        </a>
      </div>

      <div class="collapse" id="task_documents_upload">
        <%= render "layouts/multi_upload", form: form, title: "Task Documents",
                    for_model: "task" %>
      </div>

      <div class="form-group">
        <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
        <a class="btn btn-outline-danger", data-action="click->access#close">Close</a>
      </div>
    <% end %>

<% end %>

</div>
