<%# Kanban card. id must be dom_id(task) — TasksController#update_status replaces
    it via turbo_stream after a drag so badges/completed state stay fresh. %>
<div id="<%= dom_id(task) %>"
     class="card mb-2 task-board-card"
     draggable="true"
     data-task-board-target="card"
     data-update-url="<%= update_status_task_path(task) %>"
     data-action="dragstart->task-board#dragStart dragend->task-board#dragEnd">
  <div class="card-body p-3">
    <% edit_path = edit_task_path(task, board: true, deal_id: params[:deal_id].presence) %>
    <div class="fw-semibold mb-2">
      <%# display_details falls back to the legacy details column for pre-ActionText rows.
          Opens the edit form in the board's own frame rather than navigating
          away: the board keeps its filters and scroll position, and saving
          re-renders this card in place. board=true tells the update response to
          render a card rather than a list row; deal_id keeps a deal board's
          scope so the card can be dropped if the save moves it out. %>
      <%= link_to task.display_details.truncate(90), edit_path,
                  class: "text-reset", data: { turbo_frame: "new_task" } %>
    </div>
    <% if task.owner %>
      <%# On a deal board the cards are a mix of deal-level work and per-investor
          work, and both render as a name — the icon says which is which. %>
      <div class="task-board-card-meta mb-1">
        <i class="ti <%= task.owner_type == "Deal" ? "ti-briefcase" : "ti-building" %>"></i>
        <%= task.owner.to_s %>
      </div>
    <% end %>
    <div class="d-flex justify-content-between align-items-center task-board-card-meta">
      <span>
        <% if task.assigned_to %>
          <i class="ti ti-user"></i> <%= task.assigned_to.name %>
        <% end %>
      </span>
      <span>
        <% if task.due_date %>
          <i class="ti ti-calendar"></i> <%= l(task.due_date) %>
        <% end %>
      </span>
    </div>
    <%# Badges left, actions bottom-right. justify-content-between keeps the menu
        pinned right even when the card carries no badges at all. %>
    <div class="mt-3 d-flex justify-content-between align-items-end gap-2">
      <div class="d-flex flex-wrap gap-1">
        <% if task.delayed? %>
          <span class="badge bg-danger">Delayed</span>
        <% end %>
        <% if task.category.present? %>
          <span class="badge bg-secondary"><%= task.category %></span>
        <% end %>
        <% if task.touch_point %>
          <%# LP CRM: the person at the LP this task involves %>
          <span class="badge bg-info"><%= task.touch_point.full_name %></span>
        <% end %>
        <% task.tags&.split(",")&.each do |tag| %>
          <span class="badge bg-light text-dark border"><%= tag.strip %></span>
        <% end %>
      </div>

      <%# Card actions, same three-dot pattern as the report cards. The title
          opens the editor, so this menu is the way to reach the task's own page.
          dropup because the menu sits at the bottom of the card. %>
      <div class="dropdown dropup">
        <a class="text-reset" href="#" role="button" data-bs-toggle="dropdown"
           aria-expanded="false" aria-label="Task actions">
          <i class="ti ti-dots-vertical fs-5"></i>
        </a>
        <div class="dropdown-menu dropdown-menu-end">
          <% if policy(task).show? %>
            <%= link_to "Show", task, class: "dropdown-item ti ti-eye" %>
          <% end %>
          <% if policy(task).update? %>
            <%= link_to "Edit", edit_path, class: "dropdown-item ti ti-edit",
                        data: { turbo_frame: "new_task" } %>
          <% end %>
          <% if policy(task).destroy? %>
            <%# Shared confirmation modal, same as every other destructive action
                (confirm_controller reads these data attributes off the button and
                replays this form inside #confirmModal). Deliberately NOT
                data-turbo=false: leaving Turbo on means the modal's submit gets
                the destroy action's turbo_stream, which removes just this card
                instead of bouncing you off the board. %>
            <%= button_to "Delete", task, method: :delete,
                          class: "dropdown-item ti ti-trash text-danger",
                          form_class: "deleteButton",
                          data: { action: "click->confirm#popup",
                                  title: "Delete task",
                                  msg: "This will permanently delete this task. Proceed?",
                                  reversible: "no" } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
