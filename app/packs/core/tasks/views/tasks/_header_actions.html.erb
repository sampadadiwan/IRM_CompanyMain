<%# The action buttons in the tasks header, shared by the list (tasks/_index) and
    the kanban board (tasks/_board) so both views offer exactly the same set —
    the board used to offer none of them, so creating or importing a task meant
    switching to the list first.

    The Board/List toggle is deliberately NOT here: it is the one control that
    has to differ between the two views, so each renders its own.

    Self-contained on purpose — it derives its scope from params rather than
    taking it as locals, because the board has none of the list's preamble to
    pass on. Callers supply only what params can't express: the resolved owner,
    the entity, an embedding page's investor, and a side letter scope.

    board: true is the kanban board. Two things change there — Show All and
    Incomplete must carry board=true (without it they silently drop the user into
    the list), and they must drive a full navigation, because the "task_list"
    turbo frame they target only exists in the list view. %>
<%
  board ||= false
  owner ||= nil
  for_entity ||= nil
  search ||= false
  investor = local_assigns[:investor]

  base_query = filter_query
  embedded_task_context = params[:embedded_task_context].presence
  restricted_embedded_task_context = embedded_task_context.in?(%w[deal_tab deal_investor_tab])

  # Side letter covenant tasks: scopes Show All / Incomplete to one side letter's
  # obligations (multi-owner, so owner_id alone can't express it).
  side_letter_id = local_assigns[:side_letter_id] || params[:side_letter_id]

  # A deal scope supersedes the owner params everywhere below: `owner` is the
  # Deal here, and owner_type=Deal ANDed with the deal scope hides every
  # DealInvestor task the scope exists to include.
  deal_board = params[:deal_id].presence

  # "For" repeats the same stakeholder on every row of a single-owner list, so
  # that column is dropped there. Seeded into the New Task links so a row that
  # comes back from a turbo stream matches the header it lands in. Recomputed
  # here rather than passed, so the board gets it too — both this and the list's
  # copy are pure functions of params, so they cannot disagree.
  show_owner = !single_owner_list?

  task_owner = owner || investor
  task_owner_id = task_owner&.id || params[:owner_id]
  task_owner_type = task_owner&.class&.name || params[:owner_type]
  new_task_record = Task.new(owner_id: task_owner_id, owner_type: task_owner_type, entity_id: current_user.entity_id, for_entity_id: current_user.entity_id)
  can_create_task = !restricted_embedded_task_context || (task_owner_id.present? && policy(new_task_record).create?)

  # Keep the user in the view they are already in, and target a frame that
  # actually exists there.
  view_params = board ? { board: true } : {}
  view_frame = board ? "_top" : "task_list"
%>

<% if investor && can_create_task %>
  <%# LP CRM: carry the touch-point filter into the form so the new task is
      pre-linked to that person (TasksController#new builds from task[...] params) %>
  <%= link_to new_task_path("task[owner_id]": investor.id, "task[owner_type]": "Investor", "task[touch_point_id]": params[:touch_point_id].presence, list_touch_point_id: params[:touch_point_id].presence, "task[category]": base_query["category_eq"], show_owner: show_owner, embedded_task_context: embedded_task_context),
              class: "btn btn-outline-primary d-inline-flex align-items-center flex-shrink-0",
              data: { turbo: false } do %>
    <i class="ti ti-plus"></i> New Task
  <% end %>
<% end %>

<% unless search %>
  <% if for_entity || owner || side_letter_id %>
    <%# New/Import need a concrete owner — a side-letter-scoped grid spans
        multiple obligation owners, so free-floating creation is suppressed.
        New Task stays a standalone button rather than joining the Actions menu
        below: it is the primary action on this screen. It opens the "new_task"
        frame, which both views render. %>
    <% if can_create_task && (for_entity || owner) %>
      <% if embedded_task_context == "deal_tab" %>
        <%= link_to new_task_path(
                      "task[owner_type]": "DealInvestor",
                      deal_id: params[:deal_id],
                      "task[category]": base_query["category_eq"],
                      show_owner: show_owner,
                      embedded_task_context: embedded_task_context),
                    class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center flex-shrink-0",
                    data: { turbo_frame: 'new_task' } do %>
          <i class="ti ti-plus"></i> New Task
        <% end %>
      <% else %>
        <%# list_touch_point_id is this view's own filter, carried through the
            form so the create response can tell whether the saved task belongs
            here — unlike task[touch_point_id], which the user can change before
            saving. %>
        <%= link_to new_task_path(
                      "task[owner_id]": owner&.id || params[:owner_id],
                      "task[owner_type]": owner&.class&.name || params[:owner_type],
                      "task[touch_point_id]": params[:touch_point_id].presence,
                      list_touch_point_id: params[:touch_point_id].presence,
                      "task[category]": base_query["category_eq"],
                      show_owner: show_owner,
                      embedded_task_context: embedded_task_context),
                    class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center flex-shrink-0",
                    data: { turbo_frame: 'new_task' } do %>
          <i class="ti ti-plus"></i> New Task
        <% end %>
      <% end %>
    <% end %>

    <%# Everything else the header used to spell out as its own coloured button.
        Same dropdown idiom as the other index headers (see investors/_index) so
        this screen doesn't read differently from them. Only rendered inside this
        guard, so it can never open empty: Show All and Incomplete always render
        here. %>
    <div class="dropdown flex-shrink-0">
      <button class="btn btn-sm btn-outline-primary dropdown-toggle d-inline-flex align-items-center"
              type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="ti ti-settings"></i> <%= t_common(:actions) %>
      </button>
      <div class="dropdown-menu dropdown-menu-end">
        <%# On a deal the owner params are dropped: `owner` is the Deal here, and
            owner_type=Deal ANDed with the deal scope hides every DealInvestor
            task (the tab then looks empty). deal_id alone is the right scope. %>
        <%= link_to tasks_path(view_params.merge(
                      assigned_to_id: params[:assigned_to_id],
                      investor_id: params[:investor_id],
                      deal_investor_id: params[:deal_investor_id],
                      touch_point_id: params[:touch_point_id],
                      due_filter: params[:due_filter],
                      owner_id: (owner&.id unless deal_board),
                      owner_type: (owner&.class&.name unless deal_board),
                      deal_id: params[:deal_id],
                      side_letter_id: side_letter_id,
                      embedded_task_context: embedded_task_context,
                      completed: :all,
                      q: base_query)),
                    class: "dropdown-item d-flex align-items-center gap-2",
                    data: { turbo_frame: view_frame } do %>
          <i class="ti ti-list-check"></i> Show All
        <% end %>

        <%# Same as Show All above: no owner params when the scope is a deal %>
        <%= link_to tasks_path(view_params.merge(
                      assigned_to_id: params[:assigned_to_id],
                      investor_id: params[:investor_id],
                      deal_investor_id: params[:deal_investor_id],
                      touch_point_id: params[:touch_point_id],
                      due_filter: params[:due_filter],
                      owner_id: (owner&.id unless deal_board),
                      owner_type: (owner&.class&.name unless deal_board),
                      deal_id: params[:deal_id],
                      side_letter_id: side_letter_id,
                      embedded_task_context: embedded_task_context,
                      q: base_query)),
                    class: "dropdown-item d-flex align-items-center gap-2",
                    data: { turbo_frame: view_frame } do %>
          <i class="ti ti-alert-triangle"></i> Incomplete
        <% end %>

        <%# Same owner guard as New Task above — an import needs one concrete
            owner to attribute the rows to. %>
        <% if can_create_task && (for_entity || owner) %>
          <div class="dropdown-divider"></div>
          <%= link_to new_import_upload_path("import_upload[import_type]": "Task",
                                             "import_upload[owner_id]": owner&.id || params[:owner_id],
                                             "import_upload[owner_type]": owner&.class&.name || params[:owner_type],
                                             "sample_upload": "TASK_SAMPLE"),
                      class: "dropdown-item d-flex align-items-center gap-2",
                      data: { turbo: false } do %>
            <i class="ti ti-upload"></i> Import Tasks
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
