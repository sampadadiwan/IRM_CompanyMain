<%# Kanban board view of tasks (params[:board] branch of tasks/index).
    Filterable by assignee, stakeholder (Investor owner), touch point (LP
    contact) and tag. Filter option data comes from
    TasksController#prepare_board_filters; drag & drop is handled by
    task_board_controller.js hitting PATCH update_status. %>
<% base_query = params[:q].to_unsafe_h rescue {} %>
<div data-controller="task-board">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Tasks Board</h1>

    <div class="d-flex flex-wrap align-items-center gap-2">
      <%# w-auto keeps the selects on one horizontal row — form-select is
          width:100% by default, which made each one wrap to its own line %>
      <%= form_with url: tasks_path, method: :get, local: true, class: "d-flex flex-wrap align-items-center gap-2" do %>
        <%# Without this, submitting a filter would fall back to the list view %>
        <%= hidden_field_tag :board, true %>
        <%# Preserve the owner/deal scope the Board link carried over from the
            list view, so filter submits don't silently widen the board. An
            Investor owner is NOT pinned here — the stakeholder select owns that
            filter (a hidden owner_id would override a new selection, since
            normalize_owner_filters! only maps investor_id when owner_id is blank). %>
        <% unless params[:owner_type] == "Investor" %>
          <%= hidden_field_tag :owner_id, params[:owner_id] if params[:owner_id].present? %>
          <%= hidden_field_tag :owner_type, params[:owner_type] if params[:owner_type].present? %>
        <% end %>
        <%= hidden_field_tag :deal_id, params[:deal_id] if params[:deal_id].present? %>
        <%# Preserve non-board ransack filters (e.g. category) across submits —
            tags_cont excluded, its select below submits it. Arrays re-encode as
            q[k][]; nested hashes (advanced grouping) can't ride hidden fields
            without corruption, so they are dropped rather than stringified. %>
        <% base_query.except("tags_cont").each do |k, v| %>
          <% if v.is_a?(Array) %>
            <% v.each do |vv| %>
              <%= hidden_field_tag "q[#{k}][]", vv %>
            <% end %>
          <% elsif !v.is_a?(Hash) %>
            <%= hidden_field_tag "q[#{k}]", v %>
          <% end %>
        <% end %>

        <%= select_tag :assigned_to_id,
                       options_for_select(@board_assignee_options, params[:assigned_to_id]),
                       include_blank: "All Assignees",
                       class: "form-select form-select-sm w-auto",
                       onchange: "this.form.requestSubmit();" %>

        <%# Owner filter kept minimal: Investors only. TaskList#normalize_owner_filters!
            maps investor_id -> owner_id/owner_type=Investor, so no new filter code. %>
        <%= select_tag :investor_id,
                       options_for_select(@board_stakeholder_options, @board_selected_investor&.id),
                       include_blank: "All Stakeholders",
                       class: "form-select form-select-sm w-auto",
                       onchange: "this.form.requestSubmit();" %>

        <% if @board_selected_investor %>
          <%# Touch points are contacts of a specific stakeholder, so the select
              only appears once one is chosen %>
          <%= select_tag :touch_point_id,
                         options_for_select(@board_selected_investor.touch_point_options, params[:touch_point_id]),
                         include_blank: "All Contacts",
                         class: "form-select form-select-sm w-auto",
                         onchange: "this.form.requestSubmit();" %>
        <% end %>

        <% if @board_tag_options.any? %>
          <%# tags is in Task.ransackable_attributes, so this rides the existing
              ransack query instead of needing a new filter param %>
          <%= select_tag "q[tags_cont]",
                         options_for_select(@board_tag_options, params.dig(:q, :tags_cont)),
                         include_blank: "All Tags",
                         class: "form-select form-select-sm w-auto",
                         onchange: "this.form.requestSubmit();" %>
        <% end %>
      <% end %>

      <%# Carries the full filter scope back — including an owner filter that
          arrived as owner_id/owner_type from the list's Board link %>
      <%= link_to tasks_path(assigned_to_id: params[:assigned_to_id],
                             investor_id: params[:investor_id],
                             owner_id: params[:owner_id],
                             owner_type: params[:owner_type],
                             deal_id: params[:deal_id],
                             touch_point_id: params[:touch_point_id],
                             q: base_query),
                  class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center",
                  data: { turbo_frame: "_top" } do %>
        <i class="ti ti-list"></i> List
      <% end %>
    </div>
  </div>

  <div class="row task-board">
    <% grouped = tasks.group_by(&:status) %>
    <% Task.statuses.keys.each do |status| %>
      <%= render "/tasks/board_column", status: status, tasks: grouped.fetch(status, []) %>
    <% end %>
  </div>
</div>
