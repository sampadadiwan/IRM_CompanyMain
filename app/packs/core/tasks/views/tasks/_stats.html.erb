  <%
    base_query = filter_query
    # permit only scalar values for these keys - to_unsafe_h would also pass nested hashes/arrays into the where clause
    # compact_blank: an unselected filter (e.g. the board's assigned_to_id select
    # auto-submitting as "") must not survive into owner_params — `where("" )`
    # matches no row and silently zeroed every stat card whenever the board form
    # posted at all, filter chosen or not.
    owner_params = params.permit(:owner_id, :owner_type, :assigned_to_id).to_h.compact_blank
    task_types = {
      completed: {
        path: tasks_path(owner_params.merge(completed: :all, q: base_query.merge(ransack_query_params("completed", :eq, true)).to_json)),
        subtitle: "Completed",
        progress_bar_color: "success",
        icon: "ti ti-check"
      },
      incomplete: {
        path: tasks_path(owner_params.merge(completed: :incomplete, q: base_query.merge(ransack_query_params("completed", :eq, false)).to_json)),
        subtitle: "Incomplete",
        progress_bar_color: "warning",
        icon: "ti ti-question-mark"
      },
      delayed: {
        path: tasks_path(owner_params.merge(q: base_query.merge(ransack_query_params("due_date", :lt, Date.today)).to_json)),
        subtitle: "Delayed",
        progress_bar_color: "danger",
        icon: "ti ti-clock-stop"
      },
      due_this_week: {
        path: tasks_path(owner_params.merge(q: base_query.merge(ransack_query_params_multiple([["due_date", "gteq", Date.today.beginning_of_week], ["due_date", "lteq", Date.today.end_of_week]])).to_json)),
        subtitle: "Due this week",
        progress_bar_color: "info",
        icon: "ti ti-calendar-event"
      }
    }
  %>

  <%# All four numbers in one query, once — this used to rebuild the scope and
      run a COUNT inside every card (Task.stat_counts). %>
  <%
    stat_scope = policy_scope(current_user.entity.tasks)
    stat_scope = stat_scope.where(owner_params) if owner_params.present?
    # Match the board/list's due-date quick filter (Task::DUE_FILTERS) — stats
    # describe the currently filtered set, same as the category/tag filters
    # below (those ride ransack so clean_query already covers them; due_filter
    # is a plain param, same shape as TaskList#call's due_filter handling).
    if params[:due_filter].present?
      due_range = Task.due_filter_range(params[:due_filter])
      stat_scope = stat_scope.where(due_date: due_range) if due_range
    end
    # Strip any existing 'completed' filter from the query so each card counts
    # its own condition rather than the one the page is currently filtered by
    clean_query = base_query.dup
    if clean_query["c"].is_a?(Hash)
      clean_query["c"] = clean_query["c"].reject { |_k, v| v["a"]&.any? { |_ak, av| av["name"] == "completed" } }
    end
    stat_counts = Task.stat_counts(stat_scope.ransack(clean_query).result)
  %>

  <div class="row">
    <% task_types.each do |type, data| %>
      <div class="col">
        <a href="<%= data[:path] %>">
          <div class="card" data-task-stat-title="<%= data[:subtitle] %>">
            <div class="card-body">
              <div class="d-flex align-items-center mb-3">
                <div>
                  <div data-controller="counters"
                      data-counters-value-value="<%= stat_counts[type] %>">
                    <h3 class="fs-7" data-counters-target="output">0</h3>
                  </div>
                  <h3 class="fs-6"></h3>
                  <h6 class="card-subtitle mb-1 text-muted"><%= data[:subtitle] %></h6>
                </div>
                <div class="ms-auto">
                  <span class="text-<%= data[:progress_bar_color] %> display-6"><i class="<%= data[:icon] %>"></i></span>
                </div>
              </div>
              <div class="progress-bar text-bg-<%= data[:progress_bar_color] %>" role="progressbar" style="width: 100%; height: 6px;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
          </div>
        </a>
      </div>
    <% end %>
  </div>
