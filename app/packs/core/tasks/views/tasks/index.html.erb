<%= render "/layouts/filter", associations: [:for_entity, :user, :assigned_to], hidden_fields: {owner_id: params[:owner_id], owner_type: params[:owner_type], assigned_to_id: params[:assigned_to_id]} %>
<%= render "/tasks/stats" %>
<%= turbo_frame_tag "tasks_frame", target: "_top" do %>
    <% if params[:timeline].present? %>
        <%= render "/tasks/timeline", tasks: @tasks, q: @q, lazy_load_data: false %>
    <% elsif params[:board].present? %>
        <%# Kanban board view — unpaginated (columns render all filtered tasks) %>
        <%= render "/tasks/board", tasks: @tasks %>
    <% else %>
        <%= render "/tasks/index", tasks: @tasks, owner: @owner, for_entity: @for_entity, search: @search %>
    <% end %>
    <%# @pagy is unset for the board view %>
    <%= raw pagy_bootstrap_nav(@pagy, anchor_string: %(data-turbo-frame="tasks_frame" data-remote="true")) if @pagy %>
<% end %>
