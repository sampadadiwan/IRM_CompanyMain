<%
  owner||= nil;
  base_query = params[:q].to_unsafe_h rescue {}
  label = "Tasks"
  if params[:owner_type] && params[:owner_id]
    owner ||= params[:owner_type].constantize.find_by(id: params[:owner_id])
    label = owner.to_s if owner
  end

  if params[:q] && params[:q][:category_eq].present?
    label += " : #{params[:q][:category_eq].titleize}"
  end

  search ||= false
%>
<%= turbo_frame_tag "task_list", target: "_top" do %>

<div id="#task_header" class="d-sm-flex align-items-center justify-content-between mb-4 task_header">

  <h1 class="h3 mb-0 text-gray-800"><%= label %></h1>

  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= form_with url: tasks_path, method: :get, local: true, data: { turbo_frame: "_top", controller: "autosubmit" }, class: "d-flex align-items-center" do |f| %>
      <%# Preserve other Ransack filters and params except category %>
      <% params.to_unsafe_h.except(:controller, :action, :q, :authenticity_token).each do |k, v| %>
        <%= hidden_field_tag k, v %>
      <% end %>
      <% if params[:q].is_a?(Hash) %>
        <% params[:q].to_unsafe_h.except(:category_eq).each do |k, v| %>
          <%= hidden_field_tag "q[#{k}]", v %>
        <% end %>
      <% end %>

      <%= select_tag "q[category_eq]", options_for_select(Task::CATEGORIES, params.dig(:q, :category_eq)),
                     id: "category_filter",
                     include_blank: "All Categories",
                     class: "form-select form-select-sm me-2",
                     onchange: "this.form.requestSubmit();" %>
    <% end %>

    <% investor ||= nil %>

    <% if investor %>
      <%= link_to new_task_path("task[investor_id]": investor.id, "task[category]": params.dig(:q, :category_eq)),
                  class: "btn btn-outline-primary d-inline-flex align-items-center",
                  data: { turbo: false } do %>
        <i class="ti ti-plus"></i> New Task
      <% end %>
    <% end %>

    <% unless search %>
      <% show_for = belongs_to_entity_id?(current_user, for_entity.id) ? nil : for_entity %>

      <% if for_entity || owner %>
        <%= link_to tasks_path(
                      assigned_to_id: params[:assigned_to_id],
                      owner_id: owner&.id,
                      owner_type: owner&.class&.name,
                      completed: :all,
                      q: base_query),
                    class: "btn btn-sm btn-outline-success d-inline-flex align-items-center",
                    data: { turbo_frame: 'task_list' } do %>
          <i class="ti ti-list-check"></i> Show All
        <% end %>

        <%= link_to tasks_path(
                      assigned_to_id: params[:assigned_to_id],
                      owner_id: owner&.id,
                      owner_type: owner&.class&.name,
                      q: base_query),
                    class: "btn btn-sm btn-outline-warning d-inline-flex align-items-center",
                    data: { turbo_frame: 'task_list' } do %>
          <i class="ti ti-alert-triangle"></i> Incomplete
        <% end %>

        <%= link_to new_task_path(
                      "task[owner_id]": owner&.id || params[:owner_id],
                      "task[owner_type]": owner&.class&.name || params[:owner_type],
                      "task[category]": params.dig(:q, :category_eq)),
                    class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center",
                    data: { turbo_frame: 'new_task' } do %>
          <i class="ti ti-plus"></i> New Task
        <% end %>
      <% end %>
    <% end %>
  </div>

</div>


    <div class="table-responsive">
        <%= turbo_frame_tag "new_task" do %>
        <% end %>

        <table id="tasks" class="table table-bordered dataTable">

            <thead>
                <tr>
                    <th>
                        Details
                    </th>
                    <th>
                        Type
                    </th>
                    <th>
                        For
                    </th>
                    <th>
                        Assigned to
                    </th>
                    <th>
                        Due
                    </th>
                    <th>
                        Completed
                    </th>
                    <th>
                        Category
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>

            <tbody id="tasks_body">
                <% tasks.each do |task| %>
                    <%= render task %>
                <% end %>
            </tbody>
        </table>

    </div>

<% end %>