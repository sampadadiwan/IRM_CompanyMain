<%
  owner||= nil;
  for_entity ||= nil
  base_query = filter_query
  label = "Tasks"
  if params[:owner_type] && params[:owner_id]
    owner ||= params[:owner_type].constantize.find_by(id: params[:owner_id])
    label = owner.to_s if owner
  elsif params[:deal_id].present?
    owner ||= Deal.find_by(id: params[:deal_id])
    label = owner.to_s if owner
  end

  if base_query["category_eq"].present?
    label += " : #{base_query["category_eq"].titleize}"
  end

  # "For" repeats the same stakeholder on every row of a single-owner list, so it
  # is dropped there. Seeded into the New Task links and the row partial too, so
  # rows that come back from a turbo stream match this header.
  show_owner = !single_owner_list?

  search ||= false
  embedded_task_context = params[:embedded_task_context].presence

  # Side letter covenant tasks: scopes the Board/Show All/Incomplete links to one
  # side letter's obligations (multi-owner, so owner_id alone can't express it).
  side_letter_id = local_assigns[:side_letter_id] || params[:side_letter_id]

  # A deal scope supersedes the owner params everywhere below: `owner` is the
  # Deal here, and owner_type=Deal ANDed with the deal scope hides every
  # DealInvestor task the scope exists to include.
  deal_board = params[:deal_id].presence
%>
<%= turbo_frame_tag "task_list", target: "_top" do %>

<div id="#task_header" class="d-sm-flex align-items-center justify-content-between mb-4 task_header">

  <h1 class="h3 mb-0 text-gray-800"><%= label %></h1>

  <div class="d-flex flex-wrap align-items-center gap-2">
    <%# Assignee / stakeholder / contact / tag / category / due date — the same
        bar the board renders, minus whatever this scope has already fixed.
        Search results come from Elasticsearch (TasksController#search) and no
        filter here applies to them, so the bar is left off there. %>
    <% unless search %>
      <%# The scope this list is showing, for pages that pass it as locals rather
          than as params (a side letter's covenant tasks, an event's tasks) —
          without it the bar there would filter the firm-wide list instead. %>
      <%= render "/tasks/filter_bar", scope: {
            owner_id: (owner&.id || params[:owner_id] unless deal_board),
            owner_type: (owner&.class&.name || params[:owner_type] unless deal_board),
            deal_id: deal_board,
            side_letter_id: side_letter_id,
            embedded_task_context: embedded_task_context
          } %>
    <% end %>

    <%# The deal's Tasks tab is embedded but still gets a Board link: its board is
        the whole deal (the Deal's own tasks plus every DealInvestor's), which is
        exactly the view that tab is for. Other embedded grids keep the list only. %>
    <% unless search || (embedded_task_context && deal_board.blank?) %>
      <%# Kanban board view of the same (filtered) tasks — full-page nav is fine,
          surrounding frames target _top anyway %>
      <%# owner local wins over params so embedded grids (e.g. an obligation's
          Tasks tab) get a board scoped to that owner, not the global board.
          On a deal board the owner filter is deliberately dropped: `owner` is the
          Deal here, and pinning owner_type=Deal would hide every DealInvestor
          task the deal scope exists to include. %>
      <%= link_to tasks_path(board: true,
                             assigned_to_id: params[:assigned_to_id],
                             investor_id: params[:investor_id],
                             deal_investor_id: params[:deal_investor_id],
                             deal_id: deal_board,
                             owner_id: (owner&.id || params[:owner_id] unless deal_board),
                             owner_type: (owner&.class&.name || params[:owner_type] unless deal_board),
                             touch_point_id: params[:touch_point_id],
                             side_letter_id: side_letter_id,
                             due_filter: params[:due_filter],
                             q: base_query),
                  class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center",
                  data: { turbo_frame: "_top" } do %>
        <i class="ti ti-layout-kanban"></i> Board
      <% end %>
    <% end %>

    <%# New Task / Actions — shared with the board so both views offer the same
        set (tasks/_header_actions). The Board toggle above stays here: it is the
        one control that differs between the two. %>
    <%= render "/tasks/header_actions",
               owner: owner,
               for_entity: for_entity,
               investor: local_assigns[:investor],
               side_letter_id: side_letter_id,
               search: search,
               board: false %>
  </div>

</div>


    <div class="table-responsive">
        <%= turbo_frame_tag "new_task" do %>
        <% end %>

        <table id="tasks" class="table table-bordered dataTable">

            <thead>
                <tr>
                    <th>
                        Details
                    </th>
                    <% if show_owner %>
                    <th>
                        For
                    </th>
                    <% end %>
                    <th>
                        Assigned to
                    </th>
                    <%# LP CRM: the person at the LP the task involves (Task#touch_point) %>
                    <th>
                        With
                    </th>
                    <th>
                        Due
                    </th>
                    <th>
                        Completed
                    </th>
                    <th>
                        Category
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>

            <tbody id="tasks_body">
                <% tasks.each do |task| %>
                    <%# show_owner passed explicitly: the row is also re-rendered by
                        turbo streams (create, update, the completed toggle), where
                        this list's params aren't in the request, and a row with a
                        different column count than the header would misalign %>
                    <%= render partial: "tasks/task", locals: { task: task, show_owner: show_owner } %>
                <% end %>
            </tbody>
        </table>

    </div>

<% end %>