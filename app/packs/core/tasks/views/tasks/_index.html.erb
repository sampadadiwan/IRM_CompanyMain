<%
  owner||= nil;
  for_entity ||= nil
  base_query = params[:q].to_unsafe_h rescue {}
  label = "Tasks"
  if params[:owner_type] && params[:owner_id]
    owner ||= params[:owner_type].constantize.find_by(id: params[:owner_id])
    label = owner.to_s if owner
  elsif params[:deal_id].present?
    owner ||= Deal.find_by(id: params[:deal_id])
    label = owner.to_s if owner
  end

  if params[:q] && params[:q][:category_eq].present?
    label += " : #{params[:q][:category_eq].titleize}"
  end

  search ||= false
  embedded_task_context = params[:embedded_task_context].presence
  restricted_embedded_task_context = embedded_task_context.in?(%w[deal_tab deal_investor_tab])

  investor = local_assigns[:investor]
  task_owner = owner || investor
  task_owner_id = task_owner&.id || params[:owner_id]
  task_owner_type = task_owner&.class&.name || params[:owner_type]
  new_task_record = Task.new(owner_id: task_owner_id, owner_type: task_owner_type, entity_id: current_user.entity_id, for_entity_id: current_user.entity_id)
  can_create_task = !restricted_embedded_task_context || (task_owner_id.present? && policy(new_task_record).create?)
%>
<%= turbo_frame_tag "task_list", target: "_top" do %>

<div id="#task_header" class="d-sm-flex align-items-center justify-content-between mb-4 task_header">

  <h1 class="h3 mb-0 text-gray-800"><%= label %></h1>

  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= form_with url: tasks_path, method: :get, local: true, data: { turbo_frame: "_top", controller: "autosubmit" }, class: "d-flex align-items-center" do |f| %>
      <%# Preserve other Ransack filters and params except category %>
      <% params.to_unsafe_h.except(:controller, :action, :q, :authenticity_token).each do |k, v| %>
        <%= hidden_field_tag k, v %>
      <% end %>
      <% if params[:q].is_a?(Hash) %>
        <% params[:q].to_unsafe_h.except(:category_eq).each do |k, v| %>
          <%= hidden_field_tag "q[#{k}]", v %>
        <% end %>
      <% end %>

      <%= select_tag "q[category_eq]", options_for_select(Task::CATEGORIES, params.dig(:q, :category_eq)),
                     id: "category_filter",
                     include_blank: "All Categories",
                     class: "form-select form-select-sm me-2",
                     onchange: "this.form.requestSubmit();" %>
    <% end %>

    <% unless search || embedded_task_context %>
      <%# Kanban board view of the same (filtered) tasks — full-page nav is fine,
          surrounding frames target _top anyway %>
      <%= link_to tasks_path(board: true,
                             assigned_to_id: params[:assigned_to_id],
                             owner_id: params[:owner_id],
                             owner_type: params[:owner_type],
                             touch_point_id: params[:touch_point_id],
                             q: base_query),
                  class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center",
                  data: { turbo_frame: "_top" } do %>
        <i class="ti ti-layout-kanban"></i> Board
      <% end %>
    <% end %>

    <% investor ||= nil %>

    <% if investor && can_create_task %>
      <%# LP CRM: carry the touch-point filter into the form so the new task is
          pre-linked to that person (TasksController#new builds from task[...] params) %>
      <%= link_to new_task_path("task[owner_id]": investor.id, "task[owner_type]": "Investor", "task[touch_point_id]": params[:touch_point_id].presence, "task[category]": params.dig(:q, :category_eq), embedded_task_context: embedded_task_context),
                  class: "btn btn-outline-primary d-inline-flex align-items-center",
                  data: { turbo: false } do %>
        <i class="ti ti-plus"></i> New Task
      <% end %>
    <% end %>

    <% unless search %>
      <% show_for = belongs_to_entity_id?(current_user, for_entity&.id) ? nil : for_entity %>

      <% if for_entity || owner %>
        <%= link_to tasks_path(
                      assigned_to_id: params[:assigned_to_id],
                      owner_id: owner&.id,
                      owner_type: owner&.class&.name,
                      deal_id: params[:deal_id],
                      embedded_task_context: embedded_task_context,
                      completed: :all,
                      q: base_query),
                    class: "btn btn-sm btn-outline-success d-inline-flex align-items-center",
                    data: { turbo_frame: 'task_list' } do %>
          <i class="ti ti-list-check"></i> Show All
        <% end %>

        <%= link_to tasks_path(
                      assigned_to_id: params[:assigned_to_id],
                      owner_id: owner&.id,
                      owner_type: owner&.class&.name,
                      deal_id: params[:deal_id],
                      embedded_task_context: embedded_task_context,
                      q: base_query),
                    class: "btn btn-sm btn-outline-warning d-inline-flex align-items-center",
                    data: { turbo_frame: 'task_list' } do %>
          <i class="ti ti-alert-triangle"></i> Incomplete
        <% end %>

        <% if can_create_task %>
          <% if embedded_task_context == "deal_tab" %>
            <%= link_to new_task_path(
                          "task[owner_type]": "DealInvestor",
                          deal_id: params[:deal_id],
                          "task[category]": params.dig(:q, :category_eq),
                          embedded_task_context: embedded_task_context),
                        class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center",
                        data: { turbo_frame: 'new_task' } do %>
              <i class="ti ti-plus"></i> New Task
            <% end %>
          <% else %>
            <%= link_to new_task_path(
                          "task[owner_id]": owner&.id || params[:owner_id],
                          "task[owner_type]": owner&.class&.name || params[:owner_type],
                          "task[touch_point_id]": params[:touch_point_id].presence,
                          "task[category]": params.dig(:q, :category_eq),
                          embedded_task_context: embedded_task_context),
                        class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center",
                        data: { turbo_frame: 'new_task' } do %>
              <i class="ti ti-plus"></i> New Task
            <% end %>
          <% end %>

          <%= link_to new_import_upload_path("import_upload[import_type]": "Task",
                                             "import_upload[owner_id]": owner&.id || params[:owner_id],
                                             "import_upload[owner_type]": owner&.class&.name || params[:owner_type],
                                             "sample_upload": "TASK_SAMPLE"),
                      class: "btn btn-sm btn-outline-info d-inline-flex align-items-center",
                      data: { turbo: false } do %>
            <i class="ti ti-upload"></i> Import Tasks
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

</div>


    <div class="table-responsive">
        <%= turbo_frame_tag "new_task" do %>
        <% end %>

        <table id="tasks" class="table table-bordered dataTable">

            <thead>
                <tr>
                    <th>
                        Details
                    </th>
                    <th>
                        For
                    </th>
                    <th>
                        Assigned to
                    </th>
                    <%# LP CRM: the person at the LP the task involves (Task#touch_point) %>
                    <th>
                        With
                    </th>
                    <th>
                        Due
                    </th>
                    <th>
                        Completed
                    </th>
                    <th>
                        Category
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>

            <tbody id="tasks_body">
                <% tasks.each do |task| %>
                    <%= render task %>
                <% end %>
            </tbody>
        </table>

    </div>

<% end %>