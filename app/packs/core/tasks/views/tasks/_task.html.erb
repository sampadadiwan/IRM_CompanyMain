<tr id="<%= dom_id task %>">
  <td>
    <%# Pre-ActionText rows keep their text in the legacy details column, which
        task.details hides — the board's cards already fall back, so without the
        same fallback here the list shows an empty cell for a task the board
        shows text for. sanitize because the legacy column is raw user HTML. %>
    <%= link_to task do %>
      <%= task.legacy_details? ? sanitize(task.details_html) : task.details %>
    <% end %>
    <div>
    <% task.tags&.split(",")&.each do |tag| %>
      <small><%= link_to tag, search_tasks_path(query: tag) %></small>
    <% end %>
    </div>
  </td>
  <%# show_owner matches the "For" header in _index.html.erb. Passed as a local by
      the list; turbo-stream re-renders fall back to the echoed form param. %>
  <% show_owner = local_assigns.fetch(:show_owner) { params[:show_owner].to_s != "false" } %>
  <% if show_owner %>
  <td>
    <%# Linked like the notes list. The href comes from owner_type/owner_id, so
        routing costs nothing; the name uses the preloaded owner. %>
    <% path = owner_path(task.owner_type, task.owner_id) %>
    <% if path && task.owner.present? %>
      <%= link_to task.owner.to_s, path %>
    <% else %>
      <%= task.owner&.to_s %>
    <% end %>
  </td>
  <% end %>
  <td>
    <%= task.assigned_to&.first_name %>
  </td>
  <%# LP CRM: touch point — matches the "With" header in _index.html.erb; linked
      to that person's own contact page with the Tasks tab open, which lists their
      whole history (stakeholder follow-ups and deal follow-ups alike, completed
      included). Blank when not person-specific. %>
  <td>
    <%= link_to task.touch_point.full_name, investor_access_path(task.touch_point, tab: "tasks-tab") if task.touch_point %>
  </td>
  <td>
    <%= l task.due_date if task.due_date %>
    <% if task.delayed? %>
      <br>
      <span class="badge bg-danger"> Delayed </span>
    <% end %>
  </td>
  <td>
    <%= display_boolean(task.completed) %>
  </td>
  <td>
    <%= task.category %>
  </td>
  <td>
    <% if policy(task).update? %>
      <% checked = task.completed == 1 ? "checked" : ""%>
      <%# show_owner rides along on both round-trips: each replaces this row, and
          without it the replacement would come back with a different column
          count than the table it lands in %>
      <%= form_with(model: task, url: completed_task_path(task), class: "inline_form") do |form| %>
          <%= hidden_field_tag :show_owner, show_owner %>
          <%= form.check_box :completed, class: "task-done-checkbox", onchange:"this.form.requestSubmit();"  %>
      <% end %>

      <%= link_to  "Edit", edit_task_path(task, show_owner: show_owner), class: "btn btn-outline-success ti ti-edit", data: { turbo_frame: 'new_task' }%>
    <% end %>

    <%= link_to  "Show" , task , {class: "btn btn-outline-primary ti ti-eye" } if policy(task).show? %>
  </td>
</tr>