<%# Define the list of potential charts to be displayed based on request parameters %>
<% diluted_chart ||= params[:diluted_chart] || 'pie' %>

<%# Shareholding positions (e.g. Founders/Employees uploaded via "Upload Stakeholder Positions")
    are folded into the holdings/investor charts alongside Investment records. %>
<% portfolio_company_id = params[:portfolio_company_id].presence || investments.first&.portfolio_company_id %>
<% shareholder_positions = portfolio_company_id.present? ? ShareholderPosition.approved.where(portfolio_company_id: portfolio_company_id) : ShareholderPosition.none %>

<%# When a portfolio company's cap table data comes exclusively from uploaded Shareholder
    Positions (no Investment records at all), the Investment-amount-driven charts have nothing
    meaningful to show, so they're hidden rather than rendering empty/zeroed charts. %>
<% shareholder_positions_only = portfolio_company_id.present? && shareholder_positions.exists? && !Investment.where(portfolio_company_id: portfolio_company_id).exists? %>

<% charts = [
  { visible: (params[:self_ownership_trend].blank? || params[:self_ownership_trend] == "true"), title: "Ownership Trend", content_method: :self_ownership_trend, args: [investments], kwargs: { shareholder_positions: shareholder_positions, portfolio_company_id: portfolio_company_id } },
  { visible: !shareholder_positions_only && (params[:amount_by_funding_round].blank? || params[:amount_by_funding_round] == "true"), title: "Amount By Funding Round", content_method: :investment_amount_by_funding_round, args: [investments], kwargs: { shareholder_positions: shareholder_positions } },
  { visible: (params[:diluted_share_holdings].blank? || params[:diluted_share_holdings] == "true"), title: "Diluted Share Holdings", content_method: :fully_diluted_holdings, args: [investments], kwargs: { shareholder_positions: shareholder_positions, portfolio_company_id: portfolio_company_id, chart_type: diluted_chart.to_sym } },
  { visible: !shareholder_positions_only && (params[:amount_by_investor].blank? || params[:amount_by_investor] == "true"), title: "Amount By Investor", content_method: :investment_amount_by_investor, args: [investments], kwargs: { shareholder_positions: shareholder_positions } },
  { visible: !shareholder_positions_only && (params[:self_by_funding_round].blank? || params[:self_by_funding_round] == "true"), title: "Self By Funding Round", content_method: :investment_amount_by_funding_round, args: [investments], kwargs: { shareholder_positions: shareholder_positions, category: "Self" } }
].select { |c| c[:visible] } %>

<div class="row">
  <%# Iterate through visible charts and calculate column sizing dynamically %>
  <% charts.each_with_index do |chart, index| %>
    <% is_last = (index == charts.length - 1) %>
    <% is_odd_total = charts.length.odd? %>
    <%# If there is an odd number of charts, the last one takes the full width (col).
        Otherwise, they are displayed in two columns (col-md-6). %>
    <% col_class = (is_last && is_odd_total) ? "col" : "col-md-6" %>

    <div class="<%= col_class %>">
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="card-title"><%= chart[:title] %></h5>
        </div>
        <div class="card-body">
          <%# Dynamically call the helper method with positional and keyword arguments %>
          <div id=""><%= send(chart[:content_method], *chart[:args], **(chart[:kwargs] || {})) %></div>
        </div>
      </div>
    </div>
  <% end %>
</div>
