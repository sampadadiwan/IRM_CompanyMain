<%# D21 — the firm's chosen columns (or the list's own, Investment::LIST_COLUMNS). Ransack sort links as before; paged
    by pagy when @use_pagy, else in the page by jQuery DataTables. openspec/changes/grid-columns-inline-settings %>
<% investments_table = RansackTable.new(Investment, q: @q, default_columns_map: Investment::LIST_COLUMNS, current_user: current_user,
                                        records: @investments, report_id: params["report_id"], turbo_frame: "_top",
                                        referrer: request.referrer, pagy: (@pagy if @use_pagy),
                                        table_css_class: (@use_pagy ? "" : "jqDataTable")) %>
<div data-controller="datatable" data-datatable-money-columns-value="<%= investments_table.money_column_indexes %>">
  <%= render investments_table %>
</div>
