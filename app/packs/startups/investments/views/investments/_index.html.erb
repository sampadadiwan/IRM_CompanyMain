<div class="table-responsive" data-controller="datatable">
  <!-- Use jq pagination if not using pagy -->
  <table id="investments" class="table table-bordered dataTable <%= @use_pagy ? "" : "jqDataTable"%>">
    <thead>
      <tr>
        <th class="text-col">
          <%= sort_link @q, :portfolio_company_investor_name, "Portfolio Company" %>
        </th>
        <th class="text-col">
          <%= sort_link @q, :category, "Category" %>
        </th>
        <th class="text-col">
          <%= sort_link @q, :investor_name, "Investor Name" %>
        </th>
        <th class="text-col">
          <%= sort_link @q, :investment_type, "Investment Type" %>
        </th>
        <th class="text-col">
          <%= sort_link @q, :funding_round, "Funding Round" %>
        </th>
        <th class="num-col">
          <%= sort_link @q, :quantity, "Quantity" %>
        </th>
        <th class="num-col">
          <%= sort_link @q, :price_cents, "Price" %>
        </th>
        <th class="num-col">
          <%= sort_link @q, :amount_cents, "Amount" %>
        </th>
        <th class="date-col">
          <%= sort_link @q, :investment_date, "Investment Date" %>
        </th>
        <th class="action-col">
        </th>
      </tr>
    </thead>
    <tbody>
      <% @investments.each do |investment| %>
        <%= render investment %>
      <% end %>
    </tbody>
  </table>
  <%= raw pagy_bootstrap_nav(@pagy) if @use_pagy %>
</div>
