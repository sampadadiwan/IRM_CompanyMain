<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 me-3 flex-shrink-0 text-gray-800">Investments</h1>

  <%
    portfolio_company_id = params[:portfolio_company_id]

    # Investments and Shareholder Positions are two separate, mutually exclusive ways of
    # tracking a portfolio company's cap table data. A brand new portfolio company (no data
    # of either kind yet) is offered both entry points; once one kind of data exists, its
    # button(s) stay and the other kind's entry point(s) are hidden so a company's cap table
    # never ends up being built from a mix of both. When there's no portfolio_company_id
    # context at all (e.g. the global Investments list), everything stays visible as before.
    has_investments = portfolio_company_id.present? && Investment.where(portfolio_company_id: portfolio_company_id).exists?
    has_shareholder_positions = portfolio_company_id.present? && ShareholderPosition.approved.where(portfolio_company_id: portfolio_company_id).exists?
    show_investment_actions = portfolio_company_id.blank? || !has_shareholder_positions
    show_shareholder_upload = portfolio_company_id.blank? || !has_investments
    # A company with neither kind of data yet has nothing to download, so skip the download
    # buttons to keep the row of entry points compact.
    show_downloads = portfolio_company_id.blank? || has_investments || has_shareholder_positions
  %>

  <div id="investment_header_actions" class="d-flex flex-wrap align-items-center gap-2">
    <%# The one primary action stays a button; every upload/view/download entry point lives in the Actions menu below %>
    <% if show_investment_actions %>
      <%= link_to new_investment_path(portfolio_company_id: params[:portfolio_company_id]), class: "btn btn-outline-primary d-inline-flex align-items-center" do %>
        <i class="ti ti-plus me-1"></i> New Investment
      <% end %>
    <% end %>

    <%# A company holding both kinds of data gets no entry points at all, so skip an empty menu %>
    <% if show_investment_actions || show_shareholder_upload %>
      <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="ti ti-settings"></i> Actions
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <%# Investments section: upload, list and (only when there is data) download %>
          <% if show_investment_actions %>
            <li><h6 class="dropdown-header">Investments</h6></li>
            <li>
              <%= link_to new_import_upload_path("import_upload[import_type]": "Investment", "sample_upload": "INVESTMENT_SAMPLE"), class: "dropdown-item" do %>
                <i class="ti ti-upload me-1"></i> <%= t("investment.upload_investments") %>
              <% end %>
            </li>
            <li>
              <%= link_to investments_path(portfolio_company_id: params[:portfolio_company_id], index: true), class: "dropdown-item" do %>
                <i class="ti ti-list me-1"></i> View Investments
              <% end %>
            </li>
            <% if show_downloads %>
              <% xl_link = download_xl_link(investments_path(params: params.to_unsafe_h, format: :xlsx)) %>
              <li>
                <%= link_to xl_link, class: "dropdown-item", data: { turbo: false } do %>
                  <i class="ti ti-download me-1"></i> <%= t("investment.download_investments") %>
                <% end %>
              </li>
            <% end %>
          <% end %>

          <%# Divider only when both sections are shown (the global Investments list, or a brand new company) %>
          <% if show_investment_actions && show_shareholder_upload %>
            <li><hr class="dropdown-divider"></li>
          <% end %>

          <%# Shareholding Patterns section: same three entry points for shareholder positions %>
          <% if show_shareholder_upload %>
            <li><h6 class="dropdown-header">Shareholding Patterns</h6></li>
            <li>
              <%= link_to new_shareholder_position_upload_path(
                            "sample_upload": "SHAREHOLDER_POSITION_SAMPLE",
                            "owner_id": params[:portfolio_company_id],
                            "owner_type": (params[:portfolio_company_id].present? ? "Investor" : nil)),
                          class: "dropdown-item" do %>
                <i class="ti ti-upload me-1"></i> Upload Shareholding Patterns
              <% end %>
            </li>
            <li>
              <%= link_to shareholder_positions_path(portfolio_company_id: params[:portfolio_company_id]), class: "dropdown-item" do %>
                <i class="ti ti-list me-1"></i> View Shareholding Patterns
              <% end %>
            </li>
            <% if show_downloads %>
              <% shareholder_positions_xl_link = download_xl_link(shareholder_positions_path(portfolio_company_id: params[:portfolio_company_id], format: :xlsx)) %>
              <li>
                <%= link_to shareholder_positions_xl_link, class: "dropdown-item", data: { turbo: false } do %>
                  <i class="ti ti-download me-1"></i> <%= t("investment.download_shareholding_patterns") %>
                <% end %>
              </li>
            <% end %>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>


<%= render "/layouts/filter", associations: [:portfolio_company] %>

<%= turbo_frame_tag with_frame("investments_frame"), target: "_top"  do %>



  <% if params[:portfolio_company_id].present? && params[:show_captable].present? %>

    <%= render "/investments/horizontal_captable" %>

    <div class="investments_captable associated_entity">

      <% if params[:show_charts].blank? || params[:show_charts] == "true"  %>
        <%= render "/investments/charts", investments: @investments %>
      <% end %>

      <% if params[:show_captable].blank? || params[:show_captable] == "true"  %>
        <%= render "/investments/captable", investments: @investments %>
      <% end %>

    </div>
  <% else %>
    <% if params[:show_investments].blank? || params[:show_investments] == "true"  %>
      <% if params[:ag].present? %>
        <%= render "/investments/index_ag" %>
      <% else %>
        <%= render "/investments/index" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>



