<%= render FormCard.new(title: "KpiMapping #{@investor_kpi_mapping.reported_kpi_name}") do %>
  <table class="table table-bordered dataTable">
    <tr>
      <td>
        Investor
      </td>
      <td>
        <%= link_to @investor_kpi_mapping.investor, investor_path(@investor_kpi_mapping.investor, tab: "kpi-mappings-tab") %>
      </td>
    </tr>
    <tr>
      <td>
        Reported Kpi Name
      </td>
      <td>
        <%= @investor_kpi_mapping.reported_kpi_name %>
      </td>
    </tr>
    <tr>
      <td>
        Standard Kpi Name
      </td>
      <td>
        <%= @investor_kpi_mapping.standard_kpi_name %>
      </td>
    </tr>
    <tr>
      <td>
        Category
      </td>
      <td>
        <%= @investor_kpi_mapping.category %>
      </td>
    </tr>


    <tr>
      <td>
        Denomination
      </td>
      <td>
        <%= @investor_kpi_mapping.denomination&.humanize %>
      </td>
    </tr>


    <% if @investor_kpi_mapping.base_for_common_size %>
      <tr>
        <td>
          Base For Common Size
        </td>
        <td>
          <%= display_boolean @investor_kpi_mapping.base_for_common_size %>
        </td>
      </tr>
    <% end %>

    <tr>
      <td>
        Parent Kpi
      </td>
      <td>
        <% if @investor_kpi_mapping.parent %>
          <%= link_to @investor_kpi_mapping.parent.reported_kpi_name, investor_kpi_mapping_path(@investor_kpi_mapping.parent) %>
        <% else %>
          None
        <% end %>
      </td>
    </tr>

    <tr>
      <td>
        Position
      </td>
      <td>
        <%= @investor_kpi_mapping.position %>
      </td>
    </tr>

    <tr>
      <td>
        Data Type
      </td>
      <td>
        <%= @investor_kpi_mapping.data_type.humanize %>
      </td>
    </tr>

    <tr>
      <td>
        Auto Fill
      </td>
      <td>
        <%= @investor_kpi_mapping.autofill&.humanize || 'NA' %>
      </td>
    </tr>

    <tr>
      <td>
        Compute Formula
      </td>
      <td>
        <%= @investor_kpi_mapping.compute_formula %>
      </td>
    </tr>

    <tr>
      <td>
        Show In Report
      </td>
      <td>
        <%= display_boolean @investor_kpi_mapping.show_in_report %>
      </td>
    </tr>
    <tr>
      <td>
        Lower Threshhold
      </td>
      <td>
        <%= @investor_kpi_mapping.lower_threshold %>
      </td>
    </tr>
    <tr>
      <td>
        Upper Threshold
      </td>
      <td>
        <%= @investor_kpi_mapping.upper_threshold %>
      </td>
    </tr>
    <tr>
      <td>
        RAG Rule
      </td>
      <td>
        <%= @investor_kpi_mapping.rag_rule_summary %>
      </td>
    </tr>

    <%= display_custom_fields(@investor_kpi_mapping, collapsed: false) if current_user %>
  </table>
  <div data-controller="confirm">
    <% if policy(@investor_kpi_mapping).edit? %>
      <%= link_to  t_common(:edit), edit_investor_kpi_mapping_path(@investor_kpi_mapping), {class: "btn btn-outline-primary"} %>
      <%# Delete: refused for a parent mapping (disabled, the tooltip names the children); a mapping KPIs use
          warns what goes with it; an unused one confirms as before.
          Worked examples H11, H12, X5 — openspec/changes/kpi-report-journey/design.md#worked-examples %>
      <% delete_impact = InvestorKpiMappingDelete.impact(@investor_kpi_mapping) %>
      <% if delete_impact[:children].any? %>
        <span class="d-inline-block" tabindex="0" id="investor_kpi_mapping_delete_blocked"
              data-bs-toggle="tooltip" data-bs-title="Move or delete <%= delete_impact[:children].to_sentence %> first">
          <button type="button" class="btn btn-outline-danger" disabled><%= t_common(:delete) %></button>
        </span>
      <% elsif delete_impact[:kpis].positive? %>
        <%= button_to t_common(:delete), @investor_kpi_mapping, method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton",
                      id: "investor_kpi_mapping_delete_btn",
                      data: { action: "click->confirm#popup", turbo: false, method: :delete,
                              msg: investor_kpi_mapping_delete_action_summary(@investor_kpi_mapping, delete_impact) } %>
      <% else %>
        <%= button_to t_common(:delete), @investor_kpi_mapping, method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton",
                      id: "investor_kpi_mapping_delete_btn", data: {action: "click->confirm#popup", turbo:false}  %>
      <% end %>
    <% end %>
    <% if policy(@investor_kpi_mapping).recompute_rag? %>
      <%= button_to "Recompute RAG Status", recompute_rag_investor_kpi_mapping_path(@investor_kpi_mapping), method: :patch, class: "btn btn-outline-success",
          data: { action: "click->confirm#popup", turbo: false, method: :patch, notification: "no",
                  msg: "This will re-evaluate RAG status for every approved KPI reported under this mapping. Proceed?" } %>
    <% end %>
  </div>
<% end %>
