<%= render FormCard.new(title: "Kpi Mapping") do %>

<%= form_with(model: investor_kpi_mapping) do |form| %>
  <% if investor_kpi_mapping.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(investor_kpi_mapping.errors.count, "error") %> prohibited this investor_kpi_mapping from being saved:</h2>

      <ul>
        <% investor_kpi_mapping.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <%= form.text_field :entity_id, class: "form-control", hidden: true %>
    <%= form.text_field :investor_id, class: "form-control", hidden: true %>

  <div class="form-group">
    <%= form.label :reported_kpi_name %>
    <%= form.text_field :reported_kpi_name, class: "form-control"  %>
  </div>

  <div class="form-group">
    <%= form.label :standard_kpi_name %>
    <%= form.text_field :standard_kpi_name, class: "form-control"  %>
  </div>

  <div class="form-group" data-controller="otherselect" data-otherselect-select-id-value="#investor_kpi_mapping_category">
    <%= form.label :category %>
    <%= form.select :category, InvestorKpiMapping::CATEGORIES, {include_blank: true}, class: "form-control", "data-action": "change->otherselect#checkOtherName"  %>
    <%= form.text_field :category, class: "form-control", disabled: true, id: "other_name", hidden: true %>
  </div>

  <div class="form-group">
    <%= form.label :data_type %>
    <%= form.select :data_type, InvestorKpiMapping.data_types.keys.map { |type| [type.humanize, type] }, { include_blank: false }, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :denomination %>
    <%= form.select :denomination, InvestorKpiMapping.denominations.keys.map { |type| [type.humanize, type] }, { include_blank: "NA" }, class: "form-control" %>
    <small class="form-text text-muted">Select the denomination for this KPI. This is used in importing the data from the input kpi sheets.</small>
  </div>

  <div class="form-group">
    <%= form.label :parent_id %>
    <%= form.select :parent_id, InvestorKpiMapping.where(investor_id: investor_kpi_mapping.investor_id).map { |kpi| [kpi.reported_kpi_name, kpi.id] }, { include_blank: true }, class: "form-control select2" %>
    <small class="form-text text-muted">Select a parent KPI if this KPI is a sub-KPI of another. This will create a hierarchy.</small>
  </div>

  <div class="form-group">
    <%= form.label :position %>
    <%= form.number_field :position, class: "form-control", value: investor_kpi_mapping.position || 0 %>
  </div>


  <div class="form-group" data-controller="toggle-display" data-toggle-display-value-value="compute" data-toggle-display-selector-value="#compute_formula_group">
    <%= form.label :autofill, "Auto Fill" %>
    <%= form.select :autofill, InvestorKpiMapping.autofills.keys.map { |type| [type.humanize, type] }, { include_blank: "NA" }, class: "form-control", data: { action: "change->toggle-display#toggle" } %>
    <small class="form-text text-muted">Select the aggregation/fill method for this KPI over time periods.</small>
  </div>

  <div class="form-group" id="compute_formula_group">
    <%= form.label :compute_formula, "Compute Formula" %>
    <%= form.text_field :compute_formula, class: "form-control"  %>
    <small class="form-text text-muted">Enter formula for 'Compute' mode. Use KPI names in brackets. Example: `Revenue - Cost`</small>
  </div>

  <div class="form-group">
    <%= form.label :show_in_report %>
    <%= form.check_box :show_in_report, class: "form-check-input"  %>
  </div>


  <div class="form-group">
    <%= form.label :base_for_common_size %>
    <%= form.check_box :base_for_common_size, class: "form-check-input"  %>
    <small class="form-text text-muted">Check this if this KPI should be used as a base for common size calculations.</small>
  </div>

  <div class="form-group">
    <%= form.label :lower_threshold %>
    <%= form.text_field :lower_threshold, class: "form-control"  %>
  </div>

  <div class="form-group">
    <%= form.label :upper_threshold %>
    <%= form.text_field :upper_threshold, class: "form-control"  %>
  </div>

  <hr>

  <div class="form-group">
    <a class="btn btn-outline-secondary" data-bs-toggle="collapse" href="#rag_rules_section" role="button"
       aria-expanded="<%= investor_kpi_mapping.rag_configured? %>" aria-controls="rag_rules_section">
      RAG Rule (Red / Amber / Green) <i class="ti ti-caret-down"></i>
    </a>
    <%= link_to user_guide_path("kpi_rag_status_user_guide", anchor: "setting-up-a-rag-rule"), target: "_blank", rel: "noopener",
                class: "ms-2", data: { bs_toggle: "tooltip", bs_title: "How to set up a RAG rule" } do %>
      <i class="ti ti-info-circle text-primary fs-4"></i>
    <% end %>
    <a href="#" class="ms-2" data-bs-toggle="modal" data-bs-target="#rag_rules_examples_modal" title="See example RAG rules">
      <i class="ti ti-bulb text-primary fs-4"></i>
    </a>
  </div>

  <div class="collapse<%= ' show' if investor_kpi_mapping.rag_configured? %>" id="rag_rules_section">
    <% rag_tag_options = (["Budget"] + KpiReport.where(portfolio_company_id: investor_kpi_mapping.investor_id).distinct.pluck(:tag_list)).compact_blank.uniq.sort %>
    <div class="form-group" data-controller="otherselect" data-otherselect-select-id-value="#investor_kpi_mapping_rag_comparator_tag" data-otherselect-other-id-value="#rag_comparator_tag_other">
      <%= form.label :rag_comparator_tag, "RAG comparator tag" %>
      <%= form.select :rag_comparator_tag, rag_tag_options + ["Other"], { include_blank: "None — judge the value directly" }, class: "form-control", "data-action": "change->otherselect#checkOtherName" %>
      <%= form.text_field :rag_comparator_tag, class: "form-control", disabled: true, id: "rag_comparator_tag_other", hidden: true, placeholder: "Enter a custom tag" %>
      <small class="form-text text-muted">The tag of the report to compare the actual value against (e.g. "Budget", "PriorYear"). Choose "None — judge the value directly" for a KPI with no comparator (e.g. a margin % or a ratio that's already self-contained). Choose "Other" to type a tag not listed here yet.</small>
    </div>

    <div class="form-group">
      <%= form.label :rag_direction, "RAG direction" %>
      <%= form.select :rag_direction, InvestorKpiMapping.rag_directions.keys.map { |k| [k.titleize, k] }, { include_blank: true }, class: "form-control" %>
      <small class="form-text text-muted">"Higher is better" for KPIs like Revenue or Margin; "Lower is better" for KPIs like Churn or Burn.</small>
    </div>

    <div class="form-group">
      <%= form.label :rag_red_threshold, "RAG red threshold" %>
      <%= form.text_field :rag_red_threshold, class: "form-control" %>
      <small class="form-text text-muted">Below this value is flagged red (or above it, when direction is "Lower is better").</small>
    </div>

    <div class="form-group">
      <%= form.label :rag_green_threshold, "RAG green threshold" %>
      <%= form.text_field :rag_green_threshold, class: "form-control" %>
      <small class="form-text text-muted">At or above this value is flagged green (or at/below it, when direction is "Lower is better"). Everything between red and green is amber.</small>
    </div>

    <% if investor_kpi_mapping.rag_configured? %>
      <div class="form-group">
        <small class="form-text text-muted"><strong>Current rule:</strong> <%= investor_kpi_mapping.rag_rule_summary %></small>
      </div>
    <% end %>
  </div>

  <hr>

  <%= custom_form_fields(@investor_kpi_mapping, form) %>

  <div class="form-group">
    <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
  </div>
<% end %>

<div class="modal fade" id="rag_rules_examples_modal" tabindex="-1" aria-labelledby="rag_rules_examples_modal_label" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="rag_rules_examples_modal_label">
          <i class="ti ti-bulb text-primary me-1"></i> Example RAG Rules
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted">A few real-world examples of how funds commonly set these fields up:</p>
        <div class="table-responsive">
          <table class="table table-bordered table-sm">
            <thead>
              <tr>
                <th>KPI</th>
                <th>Comparator tag</th>
                <th>Direction</th>
                <th>Red</th>
                <th>Green</th>
                <th>What it means</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Revenue</td>
                <td>Budget</td>
                <td>Higher is better</td>
                <td>0.7</td>
                <td>0.9</td>
                <td>Red if actual revenue is below 70% of budget; green at 90% or above.</td>
              </tr>
              <tr>
                <td>Net Burn</td>
                <td>Budget</td>
                <td>Lower is better</td>
                <td>1.2</td>
                <td>1.0</td>
                <td>Red if spending is more than 120% of the budgeted burn.</td>
              </tr>
              <tr>
                <td>Gross Margin %</td>
                <td><em>(none)</em></td>
                <td>Higher is better</td>
                <td>0.40</td>
                <td>0.55</td>
                <td>Judged directly, no comparator — red under 40%, green at 55% or above.</td>
              </tr>
              <tr>
                <td>Cash Runway (months)</td>
                <td><em>(none)</em></td>
                <td>Higher is better</td>
                <td>6</td>
                <td>12</td>
                <td>Red under 6 months of runway; green at 12 months or more.</td>
              </tr>
              <tr>
                <td>Customer Churn %</td>
                <td>Budget</td>
                <td>Lower is better</td>
                <td>1.5</td>
                <td>1.0</td>
                <td>Red if churn is more than 1.5× the budgeted rate.</td>
              </tr>
              <tr>
                <td>Revenue Growth YoY</td>
                <td>PriorYear</td>
                <td>Higher is better</td>
                <td>1.10</td>
                <td>1.20</td>
                <td>Red if this year is below 110% of last year's figure (under 10% growth).</td>
              </tr>
              <tr>
                <td>Leverage Ratio (debt covenant)</td>
                <td><em>(none)</em></td>
                <td>Lower is better</td>
                <td>4.0</td>
                <td>3.6</td>
                <td>Red if leverage exceeds the 4.0x covenant limit.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <%= link_to "Full guide", user_guide_path("kpi_rag_status_user_guide"), target: "_blank", rel: "noopener", class: "btn btn-outline-primary" %>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<% end %>
