
<%= render FormCard.new(title: "Kpi : #{@kpi.name} : #{@kpi.kpi_report.as_of}") do %>
<table class="table table-bordered dataTable">
  <tr>
    <td>
      Entity
    </td>
    <td>
      <%= link_to @kpi.entity %>
    </td>
  </tr>
  <tr>
    <td>
      As Of
    </td>
    <td>
      <%= l @kpi.kpi_report.as_of %>
    </td>
  </tr>
  <tr>
    <td>
      Name
    </td>
    <td>
      <%= @kpi.name %>
    </td>
  </tr>

  <tr>
    <td>
      Period
    </td>
    <td>
      <%= @kpi.kpi_report.period %>
    </td>
  </tr>

  <tr>
    <td>
      Value
    </td>
    <td>
      <%= @kpi.value %>
    </td>
  </tr>

  <tr>
    <td>
      Status
    </td>
    <td>
      <%= @kpi.status&.titleize %>
    </td>
  </tr>

  <% if @kpi.common_size_value %>
  <tr>
    <td>
      Common Size Value
    </td>
    <td>
      <%= @kpi.common_size_value %>
    </td>
  </tr>
  <% end %>

  <tr>
    <td>
      Display Value
    </td>
    <td>
      <%= @kpi.display_value %>
    </td>
  </tr>
  <tr>
    <td>
      Percentage Change
    </td>
    <td>
      <%= @kpi.percentage_change %> %
    </td>
  </tr>

  <tr>
    <td>
      Investor Kpi Mapping
    </td>
    <td>
      <%= link_to @kpi.investor_kpi_mapping if @kpi.investor_kpi_mapping.present? %>
    </td>
  </tr>

  <tr>
    <td>
      Notes
    </td>
    <td>
      <%= @kpi.notes %>
    </td>
  </tr>
  <tr>
    <td>
      Source
    </td>
    <td>
      <%= @kpi.source %>
    </td>
  </tr>
  <tr>
    <td>
      Kpi Report
    </td>
    <td>
      <%= link_to @kpi.kpi_report %>
    </td>
  </tr>
  <tr>
    <td>
      Tag
    </td>
    <td>
      <%= @kpi.kpi_report.tag_list %>
    </td>
  </tr>

</table>
<% end %>
<div data-controller="confirm">
  <%= button_to t_common(:approve), approve_kpi_path(@kpi), method: :patch, class: "btn btn-outline-success",
      data: { action: "click->confirm#popup", turbo: false, method: :patch, notification: "no",
              msg: "This will overwrite the current approved value for #{@kpi.name} with #{@kpi.value}. Proceed? <br><br><small class='text-muted'>Tip: Use 'Approve All Staged' in the Actions menu to approve all pending KPIs at once.</small>" } if policy(@kpi).approve? %>

  <%= button_to t_common(:reject), reject_kpi_path(@kpi), method: :patch, class: "btn btn-outline-warning",
      data: { action: "click->confirm#popup", turbo: false, method: :delete, notification: "no",
              msg: "Are you sure you want to reject and delete the unapproved value for #{@kpi.name}? This action cannot be undone." } if policy(@kpi).reject? %>

  <%= button_to t_common(:delete), @kpi, method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton", data: {action: "click->confirm#popup", turbo:false} if policy(@kpi).destroy? %>

  <%= link_to t_common(:edit), edit_kpi_path(@kpi), class: "btn btn-outline-success" if policy(@kpi).update? %>
</div>
