<%= render FormCard.new(title: "KPI") do %>
  <% kpi = form.object %>

  <%= form.text_field :entity_id, class: "form-control", hidden: true  %>
  <%= form.text_field :kpi_report_id, class: "form-control", hidden: true  %>
  <%= form.text_field :portfolio_company_id, class: "form-control", hidden: true  %>
  <%= form.text_field :investor_kpi_mapping_id, class: "form-control", hidden: true  %>

  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-control", disabled: true, value: kpi.name&.titleize %>
    <%= form.text_field :name, class: "form-control", hidden: true, value: kpi.name %>
  </div>

  <div class="form-group">
    <%= form.label :value %>
    <%= form.text_field :value, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :display_value %>
    <%= form.text_field :display_value, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :percentage_change %>
    <%= form.text_field :percentage_change, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :common_size_value %>
    <%= form.text_field :common_size_value, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :status %>
    <%= form.select :status, Kpi.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :rag_status %>
    <%= form.select :rag_status, %w[green yellow red], { include_blank: true }, class: "form-control" %>
  </div>

  <%= custom_form_fields(kpi, form) %>

  <div class="form-group">
    <%= form.label :notes %>
    <%= form.text_area :notes, class: "form-control"  %>
  </div>

  <div class="form-group">
    <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
  </div>

<% end %>
