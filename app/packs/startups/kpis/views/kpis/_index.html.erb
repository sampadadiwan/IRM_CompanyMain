<% kpi_report ||= nil %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Kpis</h1>
  <%#= link_to "New Kpi", new_kpi_path, {class: "btn btn-outline-primary"}  %>
</div>
<div class="table-responsive">
  <table id="kpis" class="table table-bordered dataTable jqDataTable">
    <thead>
      <tr>
        <% unless kpi_report %>
          <th>
            Entity
          </th>
        <% end %>
        <th>
          Name
        </th>
        <th>
          Period
        </th>
        <th>
          Value
        </th>
        <th>
          % Change
        </th>
        <th>
          Notes
        </th>
        <th>
          Status
        </th>
        <th>

        </th>
      </tr>
    </thead>
    <tbody>
      <% kpis.each do |kpi| %>
        <%= render "/kpis/kpi", kpi: kpi, kpi_report: kpi_report %>
      <% end %>
    </tbody>
  </table>

  <% if kpis.present? && @pagy %>
  <div class="d-flex justify-content-between align-items-center">
      <%= raw pagy_info(@pagy) %>
      <%= raw pagy_bootstrap_nav(@pagy) %>
  </div>
  <% end %>

</div>
