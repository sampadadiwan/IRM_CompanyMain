<%# Grid view table for KPI reports with parent-child hierarchy support.
    Groups KPIs by investor_kpi_mapping_id (not name) to correctly handle
    duplicate names under different parents (e.g., "Enterprise" under both
    Net Sales and Operating Cost). Child rows are visually indented with a
    tree connector (└) prefix. %>
<div class="sticky-table-wrapper" style="overflow: auto; max-height: 80vh; position: relative;">
  <%
    view_unapproved = params[:view_unapproved] == 'true'
    # Group KPIs by report_id and investor_kpi_mapping_id for precise lookup.
    # Name-based grouping breaks when duplicate names exist under different parents.
    kpis_by_report_and_mapping = {}
    kpi_reports.each do |kr|
      kpis = kr.kpis
      kpis = kpis.select(&:approved?) unless view_unapproved
      kpis_by_report_and_mapping[kr.id] = kpis.group_by(&:investor_kpi_mapping_id)
    end
  %>
  <table id="kpi_reports_grid" class="table table-bordered table-striped sticky-table">
    <thead>
      <tr>
        <th class="sticky-col">
          <div class="d-flex align-items-center justify-content-between gap-2">
            KPI
            <% if local_assigns[:show_currency_toggle] %>
              <button class="btn btn-light btn-sm py-0 px-2 text-dark"
                      data-kpi-currency-toggle-target="button"
                      data-action="click->kpi-currency-toggle#toggle">
                <i class="ti ti-arrows-exchange me-1"></i>Viewing: <%= local_assigns[:fund_currency] %> (Fund)
              </button>
            <% end %>
          </div>
        </th>
        <th>Category</th>
        <% kpi_reports.each do |kpi_report| %>
          <th>
            <%= l(kpi_report.as_of, format: :month_year) %>
            <span class="d-block">
              <% if kpi_report.tag_list.present? %>
                <small class="badge badge-pill <%= tag_badge_class(kpi_report.tag_list) %>"><%= kpi_report.tag_list %></small>
              <% end %>
              <% if kpi_report.owner.present? %>
                <small class="badge badge-pill bg-info-subtle text-info"><%= kpi_report.owner %></small>
              <% end %>
            </span>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="sticky-col">Period</td>
        <td></td>
        <% kpi_reports.each_with_index do |kpi_report, idx| %>
          <td>
            <%= link_to kpi_report.period, show_performance_kpi_reports_path(as_of: kpi_report.as_of, portfolio_company_id: kpi_report.portfolio_company_id), target: "_blank" %>
          </td>
        <% end %>
      </tr>
      <% investor_kpi_mappings.each do |ikm| %>
        <tr class="<%= 'child-row' if ikm.parent_id.present? %>">
          <td class="sticky-col">
            <div class="d-flex align-items-center gap-2">
              <input type="checkbox" class="form-check-input"
                                 data-kpi-chart-target="kpiCheckbox"
                                 data-action="change->kpi-chart#toggleKpi"
              data-kpi-name="<%= ikm.standard_kpi_name %>">
              <% if ikm.parent_id.present? %>
                <span class="text-muted ms-2">└</span>
              <% end %>
              <%# Child rows show reported_kpi_name (raw Excel name, e.g., "Enterprise") instead of
    the full prefixed standard_kpi_name ("Net Sales - Enterprise") because the └ indent
    already communicates the parent-child relationship. The full prefixed name is retained
    in the database (standard_kpi_name) for uniqueness, search, exports, and chart labels.
    Parent rows continue to show standard_kpi_name as before. %>
              <% display_name = ikm.parent_id.present? ? ikm.reported_kpi_name : ikm.standard_kpi_name %>
              <%= ikm.id ? link_to(display_name, investor_kpi_mapping_path(ikm.id)) : display_name %>

              <% if ikm.child_count.to_i > 0 %>
                <small class="badge bg-secondary-subtle text-secondary"><%= ikm.child_count %></small>
              <% end %>
            </div>
          </td>
          <td>
            <%= ikm.category %>
          </td>
          <% kpi_reports.each do |kpi_report| %>
            <%# Look up KPIs by mapping ID — handles duplicate names under different parents %>
            <%
                            report_kpis = kpis_by_report_and_mapping.dig(kpi_report.id, ikm.id) || []
                        %>
            <td class="value_<%= report_kpis.first&.id %>">
              <% if report_kpis.any? %>
                <% report_kpis.each do |kpi| %>
                  <div class="<%= kpi.unapproved? ? 'text-warning' : '' %>" <%= "style='border-left: 3px solid #ffc107; padding-left: 5px;'".html_safe if kpi.unapproved? %>>
                    <% if kpi.unapproved? %>
                      <small class="badge bg-warning-subtle text-warning mb-1">Pending</small><br>
                    <% end %>
                    <% if kpi.rag_status.present? %>
                      <small class="badge <%= rag_status_badge_class(kpi.rag_status) %> mb-1"><%= kpi.rag_status.titleize %></small><br>
                    <% end %>
                    <%= fx_tooltip_wrap(display_kpi(kpi, ikm, params: params), kpi, ikm, portfolio_company, params: params) %>
                    <br>
                    <%= kpi_percentage_class(kpi, ikm).html_safe %>
                    <% if kpi.notes.present? %>
                      <i class="ti ti-info-circle text-primary float-end fs-4" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= kpi.notes %>"></i>
                    <% end %>
                    <div class="d-flex gap-1 mt-1">
                      <% if policy(kpi).approve? && kpi.unapproved? %>
                        <%= button_to approve_kpi_path(kpi), method: :patch, class: "btn btn-sm btn-success ti ti-check", form_class: "approveButton",
                                                    data: { action: "click->confirm#popup", turbo: false, method: :patch, notification: "no",
                                                            msg: "This will overwrite the current approved value for #{kpi.name} with #{kpi.value}. Proceed? <br><br><small class='text-muted'>Tip: Use 'Approve All Staged' in the Actions menu to approve all pending KPIs at once.</small>" } do %>
                          Approve
                        <% end %>
                      <% end %>
                      <% if policy(kpi).reject? %>
                        <%= button_to reject_kpi_path(kpi), method: :delete, class: "btn btn-sm btn-danger ti ti-x", form_class: "rejectButton",
                                                    data: { action: "click->confirm#popup", turbo: false, method: :delete, notification: "no",
                                                            msg: "Are you sure you want to reject and delete the unapproved value for #{kpi.name}? This action cannot be undone." } do %>
                          Reject
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                  <% if report_kpis.length > 1 && kpi != report_kpis.last %>
                    <hr class="my-1">
                  <% end %>
                <% end %>
              <% else %>
                N/A
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
      <tr>
        <td class="sticky-col">Documents</td>
        <td></td>
        <% kpi_reports.each_with_index do |kpi_report, idx| %>
          <td>
            <ul>
              <% kpi_report.documents.filter{|d| !d.csv?}.each_with_index do |doc, idx| %>
                <li>
                  <small>
                    <%= idx + 1 %>.
                    <%=  link_to doc.name, doc.file.url(expires_in: 60*60*24*7, response_content_disposition: "inline; filename=#{doc.name_with_extension}"), target: "_blank" %>,
                  </small>
                </li>
              <% end %>
            </ul>
          </td>
        <% end %>
      </tr>
      <tr>
        <td class="sticky-col">Link</td>
        <td></td>
        <% kpi_reports.each do |kpi_report| %>
          <td>
            <small><%=  link_to kpi_report %></small>
          </td>
        <% end %>
      </tr>
    </tbody>
  </table>
</div>
