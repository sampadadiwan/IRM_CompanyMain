<div id="kpi_grid_view_chart_container">
  <%
    # Determine which configs to render
    configs_to_render = local_assigns[:chart_configs] || []

    # Fallback for manual chart param or initial load
    show_default = configs_to_render.empty? && (params[:chart].nil? || params[:chart] == "true")
  %>
  <% configs_to_render.each_with_index do |chart_config_obj, idx| %>
    <%
        config_name = chart_config_obj[:name]
        chart_config = chart_config_obj[:config]
        kpi_names = chart_config.map{|c| c[:name] || c["name"]}

        # Ensure we have all mappings for the investor (not just the filtered category) for name resolution
        all_investor_mappings = investor&.investor_kpi_mappings || []

        # Map standard names back to reported names to find the actual Kpi records
        relevant_mappings = all_investor_mappings.select { |m| kpi_names.map(&:downcase).include?(m.standard_kpi_name.downcase) }
        reported_names = relevant_mappings.map(&:reported_kpi_name).uniq

        # Fallback: if no mappings found, use kpi_names directly
        reported_names = kpi_names if reported_names.empty?

        # kpi_reports is a plain, pre-loaded array when rendered via _grid_view.html.erb, but
        # KpiReportsController#index/#chart_refresh render this partial directly with the still-lazy
        # @kpi_reports Relation - #map(&:id) on a Relation would force a full load of every column
        # (including its eager-loaded :kpis/:documents/:owner associations) just to grab ids, so
        # pluck directly in that case instead.
        #
        # unscope(:order) is required, not just an optimisation: with ?s=entity_name the relation
        # carries order("entities.name ...") and KpiReportSearch ends in .distinct, and plucking a
        # single column off that raises "Expression #1 of ORDER BY clause is not in SELECT list ...
        # this is incompatible with DISTINCT". Dropping the order also keeps eager_loading? false,
        # so the pluck stays a narrow single-table query.
        kpi_report_ids = kpi_reports.is_a?(ActiveRecord::Relation) ? kpi_reports.unscope(:order).pluck(:id) : kpi_reports.map(&:id)
        kpis = Kpi.approved.where("LOWER(name) IN (?)", reported_names.map(&:downcase)).where(kpi_report_id: kpi_report_ids)
        kpi_mappings = all_investor_mappings.group_by{|ikm| [ikm.investor_id, ikm.reported_kpi_name.downcase] }
    %>
    <div class="associated_entity mb-4">
      <div class="row">
        <div class="col-lg-12">
          <div class="card shadow">
            <div class="card-header py-3">
              <h6 class="m-0 font-weight-bold text-primary"> <%= config_name %> </h6>
            </div>
            <div class="card-body">
              <%= flexible_kpi_chart(kpis, id: "flexible_kpi_chart_#{idx}", investor_kpi_mappings: kpi_mappings, chart_config: chart_config) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <% if show_default %>
    <%
        all_investor_mappings = investor&.investor_kpi_mappings || []
        kpi_names = investor_kpi_mappings.collect(&:standard_kpi_name)
        reported_names = investor_kpi_mappings.collect(&:reported_kpi_name).uniq
        # See the comment above the first kpi_report_ids assignment in this file - same fix applies here.
        kpi_report_ids = kpi_reports.is_a?(ActiveRecord::Relation) ? kpi_reports.unscope(:order).pluck(:id) : kpi_reports.map(&:id)
        kpis = Kpi.approved.where("LOWER(name) IN (?)", reported_names.map(&:downcase)).where(kpi_report_id: kpi_report_ids)
        kpi_mappings = all_investor_mappings.group_by{|ikm| [ikm.investor_id, ikm.reported_kpi_name.downcase] }
    %>
    <div class="associated_entity">
      <div class="row">
        <div class="col-lg-12 mb-4">
          <div class="card shadow">
            <div class="card-header py-3">
              <h6 class="m-0 font-weight-bold text-primary"> KPIs </h6>
            </div>
            <div class="card-body">
              <% id = params[:report_id] %>
              <%= multiple_entity_kpi_lines_by_date(kpis, id: "kpi_lines_#{id}", investor_kpi_mappings: kpi_mappings) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
