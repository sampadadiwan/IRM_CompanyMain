<% acting_user = current_user || @signed_id_user %>
<% is_portco_user = acting_user.nil? || acting_user.entity_id != @kpi_report.entity_id %>
<% is_readonly = is_portco_user %>
<% via_signed_id = params[:signed_id].present? %>

<div class="wizard_container" data-controller="wizard">

  <%# Page title + status badge — always visible above the wizard steps so both fund admins and
      portco users always know what page they're on and where this report stands, regardless of
      which step is currently showing. %>
  <div class="row justify-content-md-center mb-2">
    <div class="col-md-8 d-flex align-items-center gap-2">
      <h3 class="mb-0">KPI Report</h3>
      <% unless @kpi_report.new_record? %>
        <% badge_class = case @kpi_report.status
           when 'submitted' then 'bg-success'
           when 'reviewed'  then 'bg-primary'
           when 'draft_saved' then 'bg-warning text-dark'
           when 'link_sent'   then 'bg-info text-dark'
           else 'bg-secondary'
           end %>
        <span class="badge <%= badge_class %>"><%= @kpi_report.status.humanize.titleize %></span>
        <% if @kpi_report.submitted_at.present? %>
          <span class="text-muted">Submitted <%= l(@kpi_report.submitted_at.to_date, format: :short) %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="row justify-content-md-center">
    <div class="stepwizard hidden col-md-8">
        <div class="stepwizard-row setup-panel">
            <div class="stepwizard-step">
                <a href="#step-1" type="button" class="btn btn-outline-primary btn-outline-primary btn-outline-circle">1</a>
                <p>What to Expect</p>
            </div>
            <div class="stepwizard-step">
                <a href="#step-2" type="button" class="btn disabled btn-outline-primary btn-outline-circle">2</a>
                <p>Report Details</p>
            </div>
            <div class="stepwizard-step">
                <a href="#step-3" type="button" class="btn disabled btn-outline-primary btn-outline-circle">3</a>
                <p>Upload &amp; Validate</p>
            </div>
            <div class="stepwizard-step">
                <a href="#step-4" type="button" class="btn disabled btn-outline-primary btn-outline-circle">4</a>
                <p>Additional Details</p>
            </div>
        </div>
    </div>
  </div>

  <%= form_with(model: kpi_report, validate: true, id: "kpi-report-form", class: "wizard_form row justify-content-md-center") do |form| %>
    <% if kpi_report.errors.any? %>
      <div class="col-md-8">
        <div class="alert alert-danger">
          <h2><%= pluralize(kpi_report.errors.count, "error") %> prohibited this kpi_report from being saved:</h2>

          <ul>
            <% kpi_report.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%= form.text_field :entity_id, class: "form-control", hidden: true %>
    <%= form.text_field :portfolio_company_id, class: "form-control", hidden: true %>
    <%= form.text_field :user_id, class: "form-control", hidden: true %>
    <%= form.text_field :form_type_id, class: "form-control", hidden: true %>
    <%= hidden_field_tag :signed_id, params[:signed_id] if params[:signed_id].present? %>
    <%= hidden_field_tag :submit_action, 'draft', id: 'submit_action_field' %>

    <%# ══════════════════════════════════════════════════════════════════
        STEP 1 — What to Expect: a plain-language orientation page, with
        extra emphasis on the anonymous magic-link case, before any inputs.
        ══════════════════════════════════════════════════════════════════ %>
    <div class="col-md-8 setup-content" id="step-1">
      <div class="card">
        <div class="card-header">1. What to Expect</div>
        <div class="card-body">

          <h4 class="fw-semibold mb-1">Reporting KPIs<% if kpi_report.for_name.present? %> for <%= kpi_report.for_name %><% end %></h4>
          <p class="text-muted mb-4">
            A few quick things to know before you start. You'll confirm the exact period and reporting date on the next step.
          </p>

          <% if via_signed_id %>
            <div class="d-flex align-items-start gap-3 p-3 rounded-3 mb-3 bg-primary-subtle">
              <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 kpi-info-icon bg-white">
                <i class="ti ti-link fs-5 text-primary-emphasis"></i>
              </span>
              <div>
                <div class="fw-semibold text-dark">You're using a secure, personal link</div>
                <div class="text-muted mt-1">
                  No account or login is required — this link was generated for you specifically and is valid for a limited time.
                  You can come back to it as many times as you need before it expires to save a draft or finish your submission.
                  Please don't forward it — anyone with the link can submit on your company's behalf.
                </div>
              </div>
            </div>
          <% end %>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100 bg-success-subtle">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 kpi-info-icon bg-white">
                  <i class="ti ti-file-spreadsheet fs-5 text-success-emphasis"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark">What you'll need</div>
                  <div class="text-muted mt-1">
                    A KPI workbook (<strong>.xlsx, .xls or .csv</strong>) with the period across the first row and the metric name down the first column.
                    Don't have one handy? A pre-filled template with your company's metric names is available on the upload step.
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100 bg-warning-subtle">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 kpi-info-icon bg-white">
                  <i class="ti ti-file-search fs-5 text-warning-emphasis"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark">We check it before you submit</div>
                  <div class="text-muted mt-1">
                    Once uploaded, we automatically scan the file and show you exactly how each value will be read —
                    any blocking errors are flagged so you can fix them before submitting.
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="fw-semibold text-dark mb-2"><i class="ti ti-list-check me-1"></i>How this works</div>
          <div class="row g-2 mb-4">
            <div class="col-md-3">
              <div class="p-3 border rounded-3 h-100">
                <div class="text-muted mb-1">Step 1</div>
                <div class="fw-semibold">What to Expect</div>
                <div class="text-muted">You're here — a quick overview of the process.</div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="p-3 border rounded-3 h-100">
                <div class="text-muted mb-1">Step 2</div>
                <div class="fw-semibold">Report Details</div>
                <div class="text-muted">Confirm the company, period and reporting date.</div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="p-3 border rounded-3 h-100">
                <div class="text-muted mb-1">Step 3</div>
                <div class="fw-semibold">Upload &amp; Validate</div>
                <div class="text-muted">Upload your workbook and review the automated check.</div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="p-3 border rounded-3 h-100">
                <div class="text-muted mb-1">Step 4</div>
                <div class="fw-semibold">Additional Details</div>
                <div class="text-muted">Add any extra fields and notes, then submit.</div>
              </div>
            </div>
          </div>

          <div class="d-flex align-items-start gap-3 p-3 rounded-3 mb-4 bg-secondary-subtle">
            <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 kpi-info-icon bg-white">
              <i class="ti ti-send fs-5 text-secondary"></i>
            </span>
            <div>
              <div class="fw-semibold text-dark">After you submit</div>
              <div class="text-muted mt-1">
                Your values are staged for review and will not appear on dashboards until approved.
                The fund team is notified automatically once your data has been imported.
                <% if is_portco_user %>Submitted reports can no longer be edited — if something needs to change afterwards, please contact your fund manager.<% end %>
              </div>
            </div>
          </div>

          <% if @kpi_report.persisted? && @kpi_report.portfolio_company.present? %>
            <%= link_to template_kpi_report_path(@kpi_report, format: :xlsx, signed_id: params[:signed_id].presence), class: "btn btn-outline-secondary mb-3", data: { turbo: false } do %>
              <i class="ti ti-download me-1"></i>Download KPI template
            <% end %>
          <% end %>

          <div class="d-flex justify-content-end">
            <button class="btn btn-outline-primary nextBtn btn-lg" type="button">Let's get started <i class="ti ti-arrow-right ms-1"></i></button>
          </div>

        </div>
      </div>
    </div>
    <!-- End step-1 -->

    <%# ══════════════════════════════════════════════════════════════════
        STEP 2 — Report Details: which company, which period, which tag.
        ══════════════════════════════════════════════════════════════════ %>
    <div class="col-md-8 setup-content" id="step-2">
      <div class="card">
        <div class="card-header">2. Report Details</div>
        <div class="card-body">

          <div class="form-group">
            <%= form.label :portfolio_company_id %>
            <%= form.select :portfolio_company_id, kpi_report.entity.investors.portfolio_companies.map{|pc| [pc.investor_name, pc.id]}, {}, class: "form-control", disabled: is_readonly  %>
          </div>

          <div class="form-group">
            <%= form.label :as_of %>
            <%= form.date_field :as_of, class: "form-control", disabled: is_readonly  %>
          </div>


          <div class="form-group col">
            <%= form.label :period %>
            <%= form.select :period, KpiReport::PERIODS, {}, class: "form-control", disabled: is_readonly %>
          </div>

          <% if @kpi_report.portfolio_company_id.present? %>
            <div class="form-group">
              <%= form.label :tag_list %>
              <%= form.text_field :tag_list, class: "form-control", disabled: is_readonly  %>
            </div>
          <% end %>

          <div class="d-flex justify-content-between mt-3">
            <button class="btn btn-outline-secondary prevBtn" type="button"><i class="ti ti-arrow-left me-1"></i>Back</button>
            <button class="btn btn-outline-primary nextBtn btn-lg" type="button"><%= t_common(:next) %></button>
          </div>

        </div>
      </div>
    </div>
    <!-- End step-2 -->

    <%# ══════════════════════════════════════════════════════════════════
        STEP 3 — Upload & Validate: the KPI workbook upload plus the
        server-side check/preview panel.
        ══════════════════════════════════════════════════════════════════ %>
    <div class="col-md-8 setup-content" id="step-3">
      <div class="card">
        <div class="card-header">3. Upload &amp; Validate KPIs</div>
        <div class="card-body">

          <div class="form-group">
              <%# Spreadsheets only (§2.1 G) — the server re-checks the file type in KpiWorkbookReader (not_spreadsheet). %>
              <%= file_fields("KPIs", @kpi_report, form, required: false, meta_data: "KPIs", allowed_types: KpiReport::WORKBOOK_FILE_TYPES) %>
              <small class="form-text text-muted">Please upload the KPIs as an Excel or CSV workbook (.xlsx, .xls, .csv).</small>
              <% if @kpi_report.persisted? && @kpi_report.portfolio_company.present? %>
                <div class="mt-1">
                  <%# Pre-filled workbook: this portco's KPI names + the requested period, in a layout the importer reads without guesswork %>
                  <%= link_to template_kpi_report_path(@kpi_report, format: :xlsx, signed_id: params[:signed_id].presence), class: "btn btn-outline-secondary", data: { turbo: false } do %>
                    <i class="ti ti-download me-1"></i>Download KPI template
                  <% end %>
                </div>
              <% end %>
              <small class="form-text text-danger">Please ensure the first row indicates the period (eg: January 2025, Q12025,FY2025 etc) and the first column contains the name of the relevant metric.</small>
          </div>

          <% if is_readonly || @kpi_report.new_record? %>
            <%= form.hidden_field :upload_new_kpis, value: true %>
          <% else %>
            <div class="form-group">
              <%= form.label :upload_new_kpis, "Upload new KPIs"%>
              <%= form.check_box :upload_new_kpis, class: "form-check-input", value: false  %>
              <small class="form-text text-muted">Check this box to upload the KPIs from the file selected above (if the file has changed).</small>
            </div>
          <% end %>

          <% unless is_readonly %>
          <div class="form-group">
            <%= form.label :update_existing_kpis, "Update existing KPIs"%>
            <%= form.check_box :update_existing_kpis, class: "form-check-input", value: false  %>
            <small class="form-text text-danger">Check this box to update existing KPIs with data from the file above. If unchecked only new values will be added.</small>
          </div>
          <% else %>
            <%= form.hidden_field :update_existing_kpis, class: "form-check-input", value: true  %>
          <% end %>

          <%= render "/kpi_reports/xlsx_preview", kpi_report: @kpi_report %>

          <div class="d-flex justify-content-between mt-3">
            <button class="btn btn-outline-secondary prevBtn" type="button"><i class="ti ti-arrow-left me-1"></i>Back</button>
            <button class="btn btn-outline-primary nextBtn btn-lg" type="button"><%= t_common(:next) %></button>
          </div>

        </div>
      </div>
    </div>
    <!-- End step-3 -->

    <%# ══════════════════════════════════════════════════════════════════
        STEP 4 — Additional Details: custom fields, notes, save/submit.
        ══════════════════════════════════════════════════════════════════ %>
    <div class="col-md-8 setup-content" id="step-4">
      <div class="card">
        <div class="card-header">4. Additional Details</div>
        <div class="card-body">

          <%= custom_form_fields(@kpi_report, form) %>

          <div class="form-group">
            <%= form.label :notes %>
            <%= form.text_area :notes, class: "form-control"  %>
          </div>


          <div class="form-group d-flex gap-2 align-items-center justify-content-between">
            <button class="btn btn-outline-secondary prevBtn" type="button"><i class="ti ti-arrow-left me-1"></i>Back</button>

            <div class="d-flex gap-2 align-items-center">
              <% if is_portco_user %>
                <% if @kpi_report.status_submitted? || @kpi_report.status_reviewed? %>
                  <span class="badge bg-success fs-6 p-2">Report Already Submitted</span>
                <% else %>
                  <%# data-kpi-submit-guard: "draft" is disabled only on blocking errors; "final" also while no
                      workbook has been checked yet, or while any workbook warning is still unacknowledged
                      (kpi_validation_panel_controller.js) %>
                  <%= form.submit "Save Draft", class: "btn btn-outline-secondary", data: { kpi_submit_guard: "draft" } %>
                  <button type="button" class="btn btn-success"
                          data-bs-toggle="modal" data-bs-target="#submitReportModal"
                          data-kpi-submit-guard="final"
                          title="Upload your KPI workbook and acknowledge all warnings to enable submission">
                    Submit Report
                  </button>
                <% end %>
              <% else %>
                <%# Fund users are not gated on "no file yet", but a workbook with blocking errors cannot be saved
                    (kpi_validation_panel_controller.js disables "draft"-guarded buttons on errors; the server re-checks) %>
                <%= form.submit t_common(:save), class: "btn btn-outline-primary", data: { kpi_submit_guard: "draft" } %>
              <% end %>
            </div>
          </div>

        </div>
      </div>
    </div>
    <!-- End step-4 -->

  <% end %>

  <%# Bootstrap confirmation modal for Submit Report %>
  <% if is_portco_user && !(@kpi_report.status_submitted? || @kpi_report.status_reviewed?) %>
    <div class="modal fade" id="submitReportModal" tabindex="-1" aria-labelledby="submitReportModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header border-bottom-0">
            <h5 class="modal-title fw-semibold" id="submitReportModalLabel">Submit KPI Report</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body pt-1">
            <p class="mb-1">You are about to submit this KPI report to the fund.</p>
            <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-0">
              <i class="ti ti-lock fs-5 flex-shrink-0"></i>
              <span><strong>This cannot be undone.</strong> Once submitted you will no longer be able to edit this report.</span>
            </div>
          </div>
          <div class="modal-footer border-top-0">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-success" data-kpi-submit-guard="final"
                    onclick="document.getElementById('submit_action_field').value='final'; document.getElementById('kpi-report-form').requestSubmit();">
              Confirm &amp; Submit
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

</div>
