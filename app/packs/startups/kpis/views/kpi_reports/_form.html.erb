<% acting_user = current_user || @signed_id_user %>
<% is_portco_user = acting_user.nil? || acting_user.entity_id != @kpi_report.entity_id %>
<% is_readonly = is_portco_user %>

<%= render FormCard.new(title: "KPI Report") do %>

  <%= form_with(model: kpi_report, validate: true, id: "kpi-report-form") do |form| %>
    <% if kpi_report.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(kpi_report.errors.count, "error") %> prohibited this kpi_report from being saved:</h2>

        <ul>
          <% kpi_report.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.text_field :entity_id, class: "form-control", hidden: true %>
    <%= form.text_field :portfolio_company_id, class: "form-control", hidden: true %>
    <%= form.text_field :user_id, class: "form-control", hidden: true %>
    <%= form.text_field :form_type_id, class: "form-control", hidden: true %>
    <%= hidden_field_tag :signed_id, params[:signed_id] if params[:signed_id].present? %>
    <%= hidden_field_tag :submit_action, 'draft', id: 'submit_action_field' %>

    <%# Status badge — shows both fund admins and portco users where this report stands %>
    <% unless @kpi_report.new_record? %>
      <div class="mb-3">
        <% badge_class = case @kpi_report.status
           when 'submitted' then 'bg-success'
           when 'reviewed'  then 'bg-primary'
           when 'draft_saved' then 'bg-warning text-dark'
           when 'link_sent'   then 'bg-info text-dark'
           else 'bg-secondary'
           end %>
        <span class="badge <%= badge_class %>"><%= @kpi_report.status.humanize.titleize %></span>
        <% if @kpi_report.submitted_at.present? %>
          <small class="text-muted ms-2">Submitted <%= l(@kpi_report.submitted_at.to_date, format: :short) %></small>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :portfolio_company_id %>
      <%= form.select :portfolio_company_id, kpi_report.entity.investors.portfolio_companies.map{|pc| [pc.investor_name, pc.id]}, {}, class: "form-control", disabled: is_readonly  %>
    </div>

    <div class="form-group">
      <%= form.label :as_of %>
      <%= form.date_field :as_of, class: "form-control", disabled: is_readonly  %>
    </div>


    <div class="form-group col">
      <%= form.label :period %>
      <%= form.select :period, KpiReport::PERIODS, {}, class: "form-control", disabled: is_readonly %>
    </div>

    <% if @kpi_report.portfolio_company_id.present? %>
      <div class="form-group">
        <%= form.label :tag_list %>
        <%= form.text_field :tag_list, class: "form-control", disabled: is_readonly  %>
      </div>
    <% end %>


    <div class="form-group">
        <%# Spreadsheets only (§2.1 G) — the server re-checks the file type in KpiWorkbookReader (not_spreadsheet). %>
        <%= file_fields("KPIs", @kpi_report, form, required: false, meta_data: "KPIs", allowed_types: KpiReport::WORKBOOK_FILE_TYPES) %>
        <small class="form-text text-muted">Please upload the KPIs as an Excel or CSV workbook (.xlsx, .xls, .csv).</small>
        <% if @kpi_report.persisted? && @kpi_report.portfolio_company.present? %>
          <div class="mt-1">
            <%# Pre-filled workbook: this portco's KPI names + the requested period, in a layout the importer reads without guesswork %>
            <%= link_to template_kpi_report_path(@kpi_report, format: :xlsx, signed_id: params[:signed_id].presence), class: "btn btn-outline-secondary", data: { turbo: false } do %>
              <i class="ti ti-download me-1"></i>Download KPI template
            <% end %>
          </div>
        <% end %>
        <small class="form-text text-danger">Please ensure the first row indicates the period (eg: January 2025, Q12025,FY2025 etc) and the first column contains the name of the relevant metric.</small>
    </div>

    <% if is_readonly || @kpi_report.new_record? %>
      <%= form.hidden_field :upload_new_kpis, value: true %>
    <% else %>
      <div class="form-group">
        <%= form.label :upload_new_kpis, "Upload new KPIs"%>
        <%= form.check_box :upload_new_kpis, class: "form-check-input", value: false  %>
        <small class="form-text text-muted">Check this box to upload the KPIs from the file selected above (if the file has changed).</small>
      </div>
    <% end %>

    <% unless is_readonly %>
    <div class="form-group">
      <%= form.label :update_existing_kpis, "Update existing KPIs"%>
      <%= form.check_box :update_existing_kpis, class: "form-check-input", value: false  %>
      <small class="form-text text-danger">Check this box to update existing KPIs with data from the file above. If unchecked only new values will be added.</small>
    </div>
    <% else %>
      <%= form.hidden_field :update_existing_kpis, class: "form-check-input", value: true  %>
    <% end %>

    <%= custom_form_fields(@kpi_report, form) %>

    <div class="form-group">
      <%= form.label :notes %>
      <%= form.text_area :notes, class: "form-control"  %>
    </div>


    <div class="form-group d-flex gap-2 align-items-center">
      <% if is_portco_user %>
        <% if @kpi_report.status_submitted? || @kpi_report.status_reviewed? %>
          <span class="badge bg-success fs-6 p-2">Report Already Submitted</span>
        <% else %>
          <%# data-kpi-submit-guard: "draft" is disabled only on blocking errors; "final" also while no
              workbook has been checked yet (kpi_validation_panel_controller.js) %>
          <%= form.submit "Save Draft", class: "btn btn-outline-secondary", data: { kpi_submit_guard: "draft" } %>
          <button type="button" class="btn btn-success"
                  data-bs-toggle="modal" data-bs-target="#submitReportModal"
                  data-kpi-submit-guard="final"
                  title="Upload your KPI workbook to enable submission">
            Submit Report
          </button>
        <% end %>
      <% else %>
        <%# Fund users are not gated on "no file yet", but a workbook with blocking errors cannot be saved
            (kpi_validation_panel_controller.js disables "draft"-guarded buttons on errors; the server re-checks) %>
        <%= form.submit t_common(:save), class: "btn btn-outline-primary", data: { kpi_submit_guard: "draft" } %>
      <% end %>
    </div>
  <% end %>

  <%# Bootstrap confirmation modal for Submit Report %>
  <% if is_portco_user && !(@kpi_report.status_submitted? || @kpi_report.status_reviewed?) %>
    <div class="modal fade" id="submitReportModal" tabindex="-1" aria-labelledby="submitReportModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header border-bottom-0">
            <h5 class="modal-title fw-semibold" id="submitReportModalLabel">Submit KPI Report</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body pt-1">
            <p class="mb-1">You are about to submit this KPI report to the fund.</p>
            <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-0">
              <i class="ti ti-lock fs-5 flex-shrink-0"></i>
              <span><strong>This cannot be undone.</strong> Once submitted you will no longer be able to edit this report.</span>
            </div>
          </div>
          <div class="modal-footer border-top-0">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-success" data-kpi-submit-guard="final"
                    onclick="document.getElementById('submit_action_field').value='final'; document.getElementById('kpi-report-form').requestSubmit();">
              Confirm &amp; Submit
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>


<% end %>
