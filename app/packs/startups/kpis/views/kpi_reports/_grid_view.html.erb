<%
    portfolio_company_id = params[:portfolio_company_id] || params[:id]
    # This partial renders every matching report as a grid column, so the full set is going to be
    # loaded no matter what. Sorting in Ruby (rather than ORDER BY as_of) avoids a MySQL filesort:
    # filter_by_portfolio_company's "portfolio_company_id = ? OR entity_id = ?" forces an index-merge
    # that can't return rows pre-sorted, so an ORDER BY there filesorts the full wide row set
    # regardless of indexing (confirmed via EXPLAIN - Using union(...); Using filesort).
    #
    # as_of is nullable at the DB level (no NOT NULL constraint - not adding one here, since old
    # rows predating the model's presence validation could violate it) even though the model
    # validates its presence for new records, so a bare sort_by(&:as_of) would raise
    # "comparison of Date with nil failed" if any legacy row ever has a nil as_of. The fallback
    # date just needs to sort consistently first; it's never displayed.
    #
    # id is the tiebreaker because Ruby's sort_by is not stable and ties are real here: each report
    # renders as its own column, and params[:tag_list] accepts a comma-separated list (see
    # KpiReportsController#fetch_kpi_reports), so e.g. Actual and Budget for the same as_of both
    # appear. Without it the column order - and which report last_kpi_report_id below resolves to -
    # could differ between two renders of the same data.
    kpi_reports = kpi_reports.reorder(nil).to_a.sort_by { |r| [r.as_of || Date.new(1900, 1, 1), r.id] }
    investor = Investor.where(id: portfolio_company_id).first if portfolio_company_id.present?

    kpi_chart_settings = KpiChartSetting.where(user_id: current_user.id)
    kpi_chart_settings = kpi_chart_settings.where(portfolio_company_id: portfolio_company_id) if portfolio_company_id.present?

    kpi_currency = investor&.json_fields&.dig('kpi_currency')
    fund_currency = investor&.entity&.currency
    show_currency_toggle = kpi_currency.present? && kpi_currency != fund_currency

    # kpi_reports is already a loaded, as_of-sorted array at this point - free in-memory lookup.
    last_kpi_report_id = kpi_reports.last&.id
%>
<!-- FLEXIBLE CHART VERSION 2.0 -->
<div data-controller="kpi-chart <%= 'kpi-currency-toggle' if show_currency_toggle %>"
     data-kpi-chart-portfolio-company-id-value="<%= portfolio_company_id %>"
     data-kpi-chart-entity-id-value="<%= current_user.entity_id %>"
     data-kpi-chart-refresh-url-value="<%= chart_refresh_kpi_reports_path %>"
     <% if show_currency_toggle %>
       data-kpi-currency-toggle-kpi-currency-value="<%= kpi_currency %>"
       data-kpi-currency-toggle-fund-currency-value="<%= fund_currency %>"
     <% end %>>
  <% if params[:no_actions].blank? %>
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
      <div data-controller="export-xl"></div>
      <%= turbo_frame_tag "remote_modal_alerts" %>
      <h1 class="h4 mb-0 text-800 me-auto">
        KPIs:
        <% if params[:portfolio_company_id].present? %>
          <%=  investor ? link_to(investor.investor_name, investor) : @entity.name %>
        <% end %>
      </h1>
      <span>
        <% if params[:q].blank?%>
          <%= render "kpi_reports/filter", entity: @entity %>
        <% end %>
        <div class="btn-group me-2">
          <div class="dropdown">
            <button class="btn btn-outline-info dropdown-toggle ti ti-chart-dots" type="button"
                  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              Saved Charts
            </button>
            <div class="dropdown-menu shadow" aria-labelledby="savedChartsDropdown" style="min-width: 250px;">
              <div class="px-3 py-2 border-bottom mb-2">
                <label class="small font-weight-bold d-block mb-1">Select Charts to Draw</label>
                <div id="saved-settings-list" data-kpi-chart-target="savedSettingsList" style="max-height: 300px; overflow-y: auto;">
                  <% if kpi_chart_settings.any? %>
                    <% kpi_chart_settings.each do |s| %>
                      <div class="px-3 py-1 dropdown-item-text">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" value="<%= s.id %>" id="setting_<%= s.id %>"
                               data-action="change->kpi-chart#toggleSavedSetting click->kpi-chart#stopProp">
                          <label class="form-check-label small" for="setting_<%= s.id %>" data-action="click->kpi-chart#stopProp">
                            <%= s.name %>
                          </label>
                        </div>
                      </div>
                    <% end %>
                  <% else %>
                    <div class="px-3 small text-muted">No saved settings</div>
                  <% end %>
                </div>
              </div>
              <div class="px-3 py-2 text-center d-flex justify-content-center gap-3">
                <button class="btn btn-sm btn-link text-primary p-0" data-action="click->kpi-chart#addAll">Add All</button>
                <button class="btn btn-sm btn-link text-danger p-0" data-action="click->kpi-chart#clearAll">Clear All</button>
              </div>
            </div>
          </div>
        </div>
        <div class="btn-group">
          <div class="dropdown">
            <button class="btn btn-outline-primary dropdown-toggle ti ti-settings" type="button"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              Actions
            </button>
            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
              <% if params[:view_unapproved] == 'true' %>
                <%= link_to "Hide Staged", kpi_reports_path(params.to_unsafe_h.merge(view_unapproved: false)), class: "dropdown-item text-warning ti ti-eye-off" %>
              <% else %>
                <%# Drop :period — staged KPIs can land under a different period type than whatever
                  the grid happens to be filtered to (e.g. a freshly-imported Quarter/Year report
                  while the grid is filtered to Month), so carrying the filter over here would hide
                  the very staged rows this link is meant to surface. %>
                <%= link_to "View Including Staged", kpi_reports_path(params.to_unsafe_h.except("period").merge(view_unapproved: true)), class: "dropdown-item text-warning ti ti-eye" %>
              <% end %>
              <% if investor && params[:view_unapproved] == 'true' && Kpi.unapproved.where(portfolio_company_id: investor.id).exists? %>
                <%
                            approve_all_msg = "This will approve all pending KPIs for #{investor.investor_name}. Proceed?"
                            reject_all_msg = "This will reject and delete all pending KPIs for #{investor.investor_name}. Proceed?"
                        %>
                <%= button_to approve_all_kpis_path(portfolio_company_id: investor.id), method: :patch, class: "dropdown-item text-success ti ti-check", form_class: "approveButton",
                            data: { action: "click->confirm#popup", turbo: false, method: :patch, notification: "no", msg: approve_all_msg } do %>
                  Approve All Staged
                <% end %>
                <%= button_to approve_all_kpis_path(portfolio_company_id: investor.id, reject: true), method: :patch, class: "dropdown-item text-danger ti ti-x", form_class: "rejectButton",
                            data: { action: "click->confirm#popup", turbo: false, method: :patch, notification: "no", msg: reject_all_msg } do %>
                  Reject All Staged
                <% end %>
              <% end %>
              <%= link_to "New", new_kpi_report_path('kpi_report[portfolio_company_id]': investor.id), class: "dropdown-item ti ti-plus", data: {bs_toggle: "tooltip", bs_title: "Add a new KPI report"} if investor %>
              <%= link_to "Reports", kpis_path(filter: true), class: "dropdown-item ti ti-report", data: {bs_toggle: "tooltip", bs_title: "Opens the report view for KPI analytics"} %>
              <%= content_tag :button, "Download", class: "dropdown-item ti ti-download", data: {action: "click->export-xl#export", tableid: "kpi_reports_grid", filename: 'kpi_reports', bs_toggle: "tooltip", bs_title: "Download KPI reports as Excel file"} %>
              <%= button_to "Recompute Percentages", recompute_percentage_change_kpi_report_path(last_kpi_report_id), method: :patch, class: "dropdown-item ti ti-percentage", data: {bs_toggle: "tooltip", bs_title: "Regenrate % change compared to the previous period (by default this is computed when uploading KPI data)"} if last_kpi_report_id %>
              <%= button_to "Recompute Auto-Fill", recompute_cumulative_kpi_report_path(last_kpi_report_id), method: :patch, class: "dropdown-item ti ti-refresh", data: {bs_toggle: "tooltip", bs_title: "Recompute cumulative and forward fill calculations for this company"} if last_kpi_report_id %>
              <%= button_to "Recompute FX Conversion", recompute_fx_conversion_kpi_report_path(last_kpi_report_id), method: :patch, class: "dropdown-item ti ti-currency-dollar", data: {bs_toggle: "tooltip", bs_title: "Recompute currency conversion using current exchange rates for this company"} if last_kpi_report_id %>
              <% if investor %>
                <a href="#" class="dropdown-item ti ti-bell" data-bs-toggle="modal" data-bs-target="#sendReminderModal-<%= investor.id %>">
                  Send Reminder
                </a>
              <% end %>
              <!-- This is no longer used - its there just to satisfy tests. See KpiWorkbookReader -->
              <%= link_to "Upload",
                        new_import_upload_path(
                            "import_upload[import_type]": "Kpi",
                            "import_upload[entity_id]": current_user.entity_id,
                            "import_upload[owner_id]": params[:portfolio_company_id],
                            "import_upload[owner_type]": "Investor",
                            "sample_upload": "KPIS_SAMPLE"),
                            { class: "dropdown-item ti ti-upload"} if Rails.env.test? %>
              <%= link_to "Compare", kpis_path(grid_view: true, q: ransack_query_params(:portfolio_company_investor_name, :eq, investor.investor_name)), class: "dropdown-item ti ti-line-scan", data: {bs_toggle: "tooltip", bs_title: "Generate report to compare period KPIs for this company"} if investor %>
              <%= link_to "Actuals/Budget", kpi_reports_path(portfolio_company_id: params[:portfolio_company_id], budget_view: true, tag_list: ["Actual","Budget"], all: true, num_periods: 2), class: "dropdown-item ti ti-presentation-analytics", data: {bs_toggle: "tooltip", bs_title: "Opens the analytical view showing actual vs budget"} %>
            </div>
          </div>
        </div>
      </span>
      <% if investor %>
        <div class="modal fade" id="sendReminderModal-<%= investor.id %>" tabindex="-1" aria-labelledby="sendReminderModalLabel" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <%= form_with url: send_portco_notification_kpi_reports_path(modal_id: "sendReminderModal-#{investor.id}"), method: :post do |f| %>
                <div class="modal-header">
                  <h5 class="modal-title" id="sendReminderModalLabel">Send KPI Report Reminder</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <%= f.hidden_field :portfolio_company_id, value: investor.id %>

                  <div class="border-start border-4 border-primary ps-3 py-1 mb-3">
                    <div class="fw-bold text-dark small">Immediate Actions</div>
                    <div class="text-muted small">The following will happen immediately when you click <strong>Send Reminder</strong>:</div>
                  </div>

                  <div class="d-flex flex-column gap-2 mb-3">
                    <!-- Step 1: Email -->
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#eff6ff;">
                      <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                            style="width:36px;height:36px;background:#dbeafe;">
                        <i class="ti ti-mail fs-5" style="color:#2563eb;"></i>
                      </span>
                      <div>
                        <div class="fw-semibold text-dark lh-sm">Fresh link emailed to portfolio company</div>
                        <div class="text-muted small mt-1">A magic link is generated and sent to the company contacts so they can submit data without needing a password.</div>
                      </div>
                    </div>

                    <!-- Step 2: Shell -->
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#f0fdf4;">
                      <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                            style="width:36px;height:36px;background:#dcfce7;">
                        <i class="ti ti-file-plus fs-5" style="color:#16a34a;"></i>
                      </span>
                      <div>
                        <div class="fw-semibold text-dark lh-sm">KPI Report shell created</div>
                        <div class="text-muted small mt-1">A new report entry is automatically created for the specified period to house the incoming data.</div>
                      </div>
                    </div>

                    <!-- Step 3: Status -->
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fffbeb;">
                      <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                            style="width:36px;height:36px;background:#fef3c7;">
                        <i class="ti ti-refresh fs-5" style="color:#d97706;"></i>
                      </span>
                      <div>
                        <div class="fw-semibold text-dark lh-sm">Status updated to <span class="badge bg-warning text-dark">Link Sent</span></div>
                        <div class="text-muted small mt-1">The report status is updated to track the request — you can monitor progress in the KPI dashboard.</div>
                      </div>
                    </div>

                    <!-- Step 4: Notification -->
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fdf4ff;">
                      <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                            style="width:36px;height:36px;background:#f3e8ff;">
                        <i class="ti ti-bell-check fs-5" style="color:#9333ea;"></i>
                      </span>
                      <div>
                        <div class="fw-semibold text-dark lh-sm">You'll be notified on submission</div>
                        <div class="text-muted small mt-1">Once the portfolio company submits their data, you will receive a notification to review and approve the report.</div>
                      </div>
                    </div>
                  </div>

                  <hr class="my-3">

                  <div class="mb-3">
                    <%= f.label :as_of, "Period Ending Date", class: "form-label fw-semibold" %>
                    <%= f.date_field :as_of, class: "form-control", required: true, value: Date.today.end_of_month %>
                  </div>
                  <div class="mb-3">
                    <%= f.label :period, "Period", class: "form-label fw-semibold" %>
                    <%= f.select :period, KpiReport::PERIODS, { selected: "Month" }, class: "form-control", required: true %>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Close</button>
                  <%= f.submit "Send Reminder", class: "btn btn-outline-primary" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= render "kpi_reports/journey_return_banner" if params[:journey_report_id].present? %>
  <%= render "kpi_reports/unapproved_stats" if params[:view_unapproved] == 'true' %>

  <%# kpi_reports is already a loaded array here, so .any? is a free in-memory check %>
  <% if kpi_reports.any? %>
  <%# We only render the chart controls if kpi reports are present so as not to have html with elements and data attributes but no content inside.
    Such elements cause issues when we want to hide empty widget cards on the dashboard as cleaning the html tags still doesnt clean certain things like the data attrs and then we see an empty card %>
    <div class="card shadow mb-4 d-none" id="kpi-chart-controls-panel" data-kpi-chart-target="mainControls">
      <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Chart Controls</h6>
        <button class="btn btn-sm btn-outline-secondary ti ti-x" data-action="click->kpi-chart#clearAll"></button>
      </div>
      <div class="card-body">
        <div data-kpi-chart-target="controlsContainer"></div>
        <div class="border-top pt-3 mt-3 d-flex gap-2 align-items-end">
          <button class="btn btn-primary" data-action="click->kpi-chart#refreshChart">Update Chart</button>
          <button class="btn btn-outline-secondary" data-action="click->kpi-chart#clearAll">Clear All</button>
          <div class="flex-grow-1">
            <input type="text" class="form-control" placeholder="Setting Name" data-kpi-chart-target="settingNameInput">
          </div>
          <button class="btn btn-outline-success" data-action="click->kpi-chart#saveSetting">Save Setting</button>
        </div>
      </div>
    </div>

    <div class="modal fade" id="kpiChartAlertModal" tabindex="-1" aria-labelledby="kpiChartAlertModalLabel" aria-hidden="true" data-kpi-chart-target="alertModal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="kpiChartAlertModalLabel">KPI Chart</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" data-kpi-chart-target="alertModalBody">
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
          </div>
        </div>
      </div>
    </div>
    <%
      investor_kpi_mappings = set_investor_kpi_mappings(kpi_reports, investor, current_user, category: params[:category])
    %>

    <%# The default chart plots approved KPIs only, so in the staged review (View Including Staged) it is an
        empty "No data" card — skip it there. The container stays for the kpi-chart controller (a saved
        chart picked from the menu still renders into it). %>
    <div id="kpi_grid_view_chart_container" data-kpi-chart-target="chartContainer">
      <%= render "/kpi_reports/grid_view_chart", kpi_reports:, investor_kpi_mappings:, chart_configs: [], investor: investor unless params[:view_unapproved] == 'true' %>
    </div>

    <%# .present? does not handle string "false" properly - and returns true
    # so we use standard boolean casting instead of relying on .present? %>
    <% if ActiveModel::Type::Boolean.new.cast(params[:compound]) %>
      <%= render "/kpi_reports/grid_view_compound_table", kpi_reports:, investor_kpi_mappings:, portfolio_company: investor, show_currency_toggle: show_currency_toggle, fund_currency: fund_currency %>
    <% else %>
      <%= render "/kpi_reports/grid_view_table", kpi_reports:, investor_kpi_mappings:, portfolio_company: investor, show_currency_toggle: show_currency_toggle, fund_currency: fund_currency %>
    <% end %>

  <% end %>
</div>
