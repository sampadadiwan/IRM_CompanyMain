<%= turbo_frame_tag "remote_modal" do %>
  <div class="modal fade" data-controller="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <%= form_with url: send_portco_notification_kpi_reports_path, method: :post do |f| %>
          <div class="modal-header border-bottom-0 pb-0">
            <div>
              <h5 class="modal-title fw-semibold">Send KPI Report Reminder</h5>
              <p class="text-muted small mb-0">Request portfolio companies to upload their KPI data</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <div class="modal-body pt-2">

            <div class="border-start border-4 border-primary ps-3 py-1 mb-4">
              <div class="fw-bold text-dark small">What Happens Next</div>
              <div class="text-muted small">The following will occur for each selected company when you click <strong>Send Reminders</strong>:</div>
            </div>
              
              <!-- Step 1: Email -->
              <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#eff6ff;">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:36px;height:36px;background:#dbeafe;">
                  <i class="ti ti-mail fs-5" style="color:#2563eb;"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark lh-sm">Fresh link emailed to portfolio companies</div>
                  <div class="text-muted small mt-1">Each selected company receives a secure magic link — no login required.</div>
                </div>
              </div>

              <!-- Step 2: Shell -->
              <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#f0fdf4;">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:36px;height:36px;background:#dcfce7;">
                  <i class="ti ti-file-plus fs-5" style="color:#16a34a;"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark lh-sm">KPI Report shells created</div>
                  <div class="text-muted small mt-1">New report entries are automatically created for the specified period to house incoming data.</div>
                </div>
              </div>

              <!-- Step 3: Status -->
              <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fffbeb;">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:36px;height:36px;background:#fef3c7;">
                  <i class="ti ti-refresh fs-5" style="color:#d97706;"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark lh-sm">Status updated to <span class="badge bg-warning text-dark">Link Sent</span></div>
                  <div class="text-muted small mt-1">Report statuses are updated to track requests — you can monitor progress in the KPI dashboard.</div>
                </div>
              </div>

              <!-- Step 4: Notification -->
              <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fdf4ff;">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:36px;height:36px;background:#f3e8ff;">
                  <i class="ti ti-bell-check fs-5" style="color:#9333ea;"></i>
                </span>
                <div>
                  <div class="fw-semibold text-dark lh-sm">You'll be notified on submission</div>
                  <div class="text-muted small mt-1">You'll receive email notifications as each company submits; mark them as Reviewed when done.</div>
                </div>
              </div>
            </div>

            <%# Form fields %>
            <div class="mb-3">
              <%= f.label :portfolio_company_ids, class: "form-label fw-semibold" do %>
                Portfolio Companies
                <span class="text-muted fw-normal small ms-1">— who should receive the reminder?</span>
              <% end %>
              <%= f.select :portfolio_company_ids,
                           options_for_select([["All Companies", "all"]], @selected_ids.include?("all") ? "all" : nil) +
                           options_from_collection_for_select(@portfolio_companies, :id, :investor_name, @selected_ids),
                           {},
                           { class: "form-select select2", multiple: true, data: { controller: "select2" } } %>
              <div class="form-text">Companies that have already submitted for this period will be skipped automatically.</div>
            </div>

            <div class="row g-3 mb-2">
              <div class="col-sm-6">
                <%= f.label :as_of, class: "form-label fw-semibold" do %>
                  Period Ending Date
                <% end %>
                <%= f.date_field :as_of, class: "form-control", required: true, value: Date.today.end_of_month %>
                <div class="form-text">The date the reporting period ends (e.g. 31 Mar 2025).</div>
              </div>
              <div class="col-sm-6">
                <%= f.label :period, class: "form-label fw-semibold" do %>
                  Period
                <% end %>
                <%= f.select :period, KpiReport::PERIODS, { selected: "Month" }, class: "form-control", required: true %>
                <div class="form-text">Monthly, quarterly, etc.</div>
              </div>
            </div>

            <%# Tips %>
            <div class="alert alert-info alert-sm d-flex gap-2 align-items-start py-2 mb-0 mt-3" style="font-size: .85rem;">
              <i class="ti ti-info-circle fs-5 flex-shrink-0 mt-1"></i>
              <div>
                <strong>Re-sending is safe.</strong> If a company already has a pending request for this period the existing report is reused — no duplicate is created and the status does not regress.
              </div>
            </div>

          </div>

          <div class="modal-footer border-top pt-3">
            <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
            <%= f.submit "Send Reminders", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
