<% show_tags = params[:show_tags].to_s == "false" ? false : true %>
<div class="table-responsive" data-controller="datatable">
<%
  # Group KPIs by report_id and investor_kpi_mapping_id instead of name to correctly
  # handle duplicate child names under different parents (e.g., "Enterprise" under both
  # Net Sales and Operating Cost). Matches the fix applied in _grid_view_table.html.erb.
  kpis_by_report_and_mapping = {}
  kpi_reports.each do |kr|
    kpis_by_report_and_mapping[kr.id] = kr.kpis.index_by(&:investor_kpi_mapping_id)
  end
%>

  <table id="kpi_reports_grid" class="table table-bordered dataTable table-grey numberTable" data-controller="row-toggle">
    <thead>
      <tr>
        <th>
          <% if local_assigns[:show_currency_toggle] %>
            <button class="btn btn-light btn-sm py-0 px-2 text-dark"
                    data-kpi-currency-toggle-target="button"
                    data-action="click->kpi-currency-toggle#toggle">
              <i class="ti ti-arrows-exchange me-1"></i>Viewing: <%= local_assigns[:fund_currency] %> (Fund)
            </button>
          <% end %>
        </th>
        <% kpi_reports.each do |kpi_report| %>
          <th class="number_col">
            <%= link_to l(kpi_report.as_of, format: :month_year), show_performance_kpi_reports_path(as_of: kpi_report.as_of) %>
            <span class="d-block">
              <% if show_tags && kpi_report.tag_list.present? %>
                <small class="badge badge-pill <%= tag_badge_class(kpi_report.tag_list) %>"><%= kpi_report.tag_list %></small>
              <% end %>
              <% if kpi_report.owner.present? %>
                <small class="badge badge-pill bg-info-subtle text-info"><%= kpi_report.owner %></small>
              <% end %>
            </span>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% investor_kpi_mappings.each do |ikm| %>
        <% row_class = ikm.parent_id.blank? ? 'parent' : 'child' %>
        <tr class="<%= row_class %>">
          <td data-action="click->row-toggle#toggle" data-row-toggle-target="control" class="text_col" aria-expanded="false">
            <% if ikm.parent_id.present? %>
              &nbsp;&nbsp;
              <i class="">&nbsp;&nbsp;</i>
            <% end %>
            <%# Child rows show reported_kpi_name (raw Excel name, e.g., "Enterprise") instead of
    the full prefixed standard_kpi_name ("Net Sales - Enterprise") because the indent
    already communicates the parent-child relationship. The full prefixed name is retained
    in the database (standard_kpi_name) for uniqueness, search, exports, and chart labels. %>
            <% display_name = ikm.parent_id.present? ? ikm.reported_kpi_name : ikm.standard_kpi_name %>
            <% if ikm.json_fields&.[](InvestorKpiMapping::HIGHLIGHT_KPI_CF).to_s == "1" %>
              <%# used weight 1000 instead of bold as it was not noticable for kedaara %>
              <span style="font-weight: 1000;"><%= display_name %></span>
            <% else %>
            <%= display_name %>
            <% end %>

            <%# .to_i handles nil child_count for ad-hoc InvestorKpiMapping.new objects (non-fund entities) %>
            <% if ikm.child_count.to_i > 0 %>
              <span class="expand">></span>
            <% end %>
          </td>
          <% kpi_reports.each do |kpi_report| %>
            <!-- Find the kpi with the name or an alias for the name and show its value-->
            <%# Look up KPI by investor_kpi_mapping_id instead of name to correctly handle
                duplicate child names under different parents (e.g., "Enterprise" under both
                Net Sales and Operating Cost). Matches the fix applied in _grid_view_table.html.erb. %>
            <% kpi = kpis_by_report_and_mapping.dig(kpi_report.id, ikm.id)
              kpi_class = kpi&.value.to_f.negative? ? 'text-danger' : nil
              kpi_style = ikm.json_fields&.[](InvestorKpiMapping::HIGHLIGHT_KPI_CF).to_s == "1" ? "font-weight: 1000;" : nil
            %>
            <td id="value_<%=kpi&.id%>" class="<%= kpi_class %>" style="<%= kpi_style %>">
              <% if kpi %>
                <%= fx_tooltip_wrap(display_kpi(kpi, ikm, params: params), kpi, ikm, portfolio_company, params: params) %>
              <% else %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
