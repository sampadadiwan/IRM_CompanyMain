<%#
  KPI workbook check + preview.

  The check is entirely server-side (KpiReportsController#validate_upload → KpiWorkbookReader#validate);
  the kpi-xlsx-report Stimulus controller only forwards the uploaded file reference and renders the
  turbo_stream response into #kpi_validation_panel. See docs/technical/kpi_portco_upload_validation_review.md.
%>
<%
  kpi_document = kpi_report.persisted? ? kpi_report.documents.where(name: "KPIs").first : nil
  # A stored verdict is only shown when it describes the document that is actually attached — a
  # verdict from an upload that was checked but never saved must not stand in for it. When a document
  # exists without a matching verdict the JS asks the server to check it on load.
  stored_verdict = kpi_report.try(:validation_result)
  stored_verdict = nil unless kpi_document.present? && stored_verdict.present? && stored_verdict['document_id'] == kpi_document.id
  # A verdict computed by this very request (save refused because of blocking errors) takes precedence
  stored_verdict = @verdict if @verdict.present?
  # Saved report → member route (magic-link signed_id preserved); New page → collection route, the JS
  # appends the form's portfolio company / as_of / period / tag so the server knows the context.
  validate_url = kpi_report.persisted? ? validate_upload_kpi_report_path(kpi_report, signed_id: params[:signed_id].presence) : validate_upload_kpi_reports_path
%>
<div id="kpi-xlsx-report" class="mt-4"
     data-controller="kpi-xlsx-report"
     data-upload-id="custom_file_kp_is"
     data-kpi-xlsx-report-url-value="<%= validate_url %>"
     data-kpi-xlsx-report-persisted-value="<%= kpi_report.persisted? %>"
     data-kpi-xlsx-report-has-document-value="<%= kpi_document.present? %>"
     data-kpi-xlsx-report-has-verdict-value="<%= stored_verdict.present? %>">

  <div class="d-flex align-items-center justify-content-between">
    <span class="h4 mb-0">KPI workbook check</span>
    <% if validate_url && kpi_document.present? %>
      <button type="button" class="btn btn-outline-secondary" data-action="kpi-xlsx-report#recheck">
        <i class="ti ti-refresh me-1"></i>Re-check file
      </button>
    <% end %>
  </div>
  <div data-kpi-xlsx-report-target="spinner" class="d-none mt-2 text-muted">
    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Checking your workbook…
  </div>

  <%= render "kpi_reports/validation_panel", verdict: stored_verdict, kpi_report: kpi_report %>
</div>

<!-- Stimulus XLSX Preview Controller (display only) -->
<div id="xlsx-preview" class="table-responsive"
    data-controller="xlsx-preview"
    data-upload-id="custom_file_kp_is"
    data-headers='<%= kpi_report.headers if kpi_report.respond_to?(:headers) %>'
    data-xlsx-preview-tabs="true"
    <%# KpiWorkbookReader scans every sheet, unlike the sheet-0-only importers,
        so the preview must not single out one sheet as "used for import". %>
    data-xlsx-preview-all-sheets="true">

  <div data-xlsx-preview-target="card" class="card mt-3 d-none">
    <div class="card-header fw-bold">
      <span class="h3" data-xlsx-preview-target="filename"></span>
    </div>
    <div class="card-body" data-controller="datatable">
      <div data-xlsx-preview-target="status"></div>
      <div data-xlsx-preview-target="table"></div>
    </div>
  </div>
</div>
