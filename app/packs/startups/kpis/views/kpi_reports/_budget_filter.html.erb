<%
  @portfolio_company ||= nil
  portfolio_company_id = params[:portfolio_company_id].presence || @portfolio_company&.id
  @portfolio_company ||= policy_scope(Investor).find_by(id: portfolio_company_id) if portfolio_company_id.present?
  categories = @portfolio_company.investor_kpi_mappings.pluck(:category).uniq if @portfolio_company.present?
  categories ||= InvestorKpiMapping::CATEGORIES
  model ||= current_user
%>
<%= form_with(url: "/kpi_reports", method: :get, id: "kpi_reports_filter", data: { turbo_frame: "kpi_reports_budget" }) do |form| %>

  <input name="portfolio_company_id" value="<%= portfolio_company_id %>" hidden="hidden">
  <input name="budget_view" value="true" hidden="hidden">
  <input name="compound" value="<%=params[:compound]%>" hidden="hidden">
  <input name="decimals" value="<%=params[:decimals]%>" hidden="hidden">
  <input name="all" value="true" hidden="hidden">
  <% form.hidden_field :entity_id, value: current_user.entity_id %>

  <div class="row align-items-center g-2">
    <div class="col-auto d-flex align-items-center gap-2">
      <% no_of_periods = params[:num_periods].presence || 2 %>
      <%= form.label :num_periods, "No of Periods", class: "col-form-label" %>
      <%= form.text_field :num_periods, class: "form-control", style: "width: 60px;", name: "num_periods", value: no_of_periods %>
    </div>

    <div class="col-auto gap-2">
      <% category = params[:category].presence %>
      <%= form.select :category, categories, {selected: category, include_blank: true}, class: "form-control", name: "category" %>
    </div>

    <div class="col-auto gap-2">
      <% period = params[:period].presence || 'Quarter' %>
      <%= form.select :period, KpiReport::PERIODS, {selected: period, include_blank: false}, class: "form-control", name: "period" %>
    </div>

    <div class="col-auto gap-2">
      <% units = params[:units].presence %>
      <%= form.select :units, ["Crores", "Lakhs", "Million"], {selected: units, include_blank: true}, class: "form-control", name: "units" %>
    </div>

    <div class="col-auto d-flex align-items-center gap-2">
      <%
        selected_tags = params[:tag_list].is_a?(Array) ? params[:tag_list] : params[:tag_list].split(",").map(&:strip) if params[:tag_list].present?
        selected_tags ||= ["Actual"]
      %>
      <%= form.label :tag_list, "Tags", class: "col-form-label mb-0 text-nowrap" %>
      <%= form.select :tag_list, current_user.entity.kpi_reports.pluck(:tag_list).uniq, { selected: selected_tags, include_blank: false, include_hidden: false }, class: "form-control select2", name: "tag_list[]", multiple: true, data: { width: "180px" } %>
    </div>

    <div class="col-auto ms-auto d-flex gap-2">
      <%= button_tag type: :submit, class: "btn btn-outline-success", id: "submit" do %>
        <i class="ti ti-filter"></i> Filter
      <% end %>
      <button class="btn btn-outline-secondary" data-controller="export-xl"
              data-action="click->export-xl#export"
              data-tableid="kpi_reports_budget_grid"
              data-filename="Comparison">
        <i class="ti ti-table-export"></i> <%= t_common(:export_visible) %>
      </button>
    </div>
  </div>

<% end %>
