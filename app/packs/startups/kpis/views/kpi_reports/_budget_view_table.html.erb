<%
    tags_from_params = params[:tag_list].presence
    # Handle both array and comma-separated string if applicable, though select2 usually sends array
    tags_from_params = tags_from_params.is_a?(Array) ? tags_from_params : tags_from_params.to_s.split(",").map(&:strip)
    tags_from_params = tags_from_params.reject(&:blank?)

    # If tags are provided in params, they come in the order selected by user or rendered in filter.
    # We want tag_1 / tag_2 based on this order.
    # BUT: Rails params usually alphabetical for multi-selects unless we forced order in JS.
    # With the JS fix, we expect the order to be preserved in the URL/params.
    tag_list_to_use = tags_from_params.presence || @tag_list
    service_result = KpiBudgetViewService.call(current_user, params, kpi_reports, tag_list_to_use)
    precision = service_result.precision
    investor_kpi_mappings = service_result.investor_kpi_mappings
    quarterly_reports = service_result.quarterly_reports
    year_reports = service_result.year_reports
    grouped_quarterly_reports = service_result.grouped_quarterly_reports
    grouped_yearly_reports = service_result.grouped_yearly_reports
    show_achievement_column = service_result.show_achievement_column
    tag_lists_to_display = service_result.tag_lists_to_display
    achievement_tags = service_result.achievement_tags

    # Group all KPIs by report_id and then by name (lowercase) to avoid redundant find/map in loops
    all_reports = (quarterly_reports + year_reports).uniq
    kpis_by_report_and_name = {}
    all_reports.each do |kr|
      kpis_by_report_and_name[kr.id] = kr.kpis.index_by { |k| k.name.downcase }
    end
    title ||= params[:title].presence
%>


<%= turbo_frame_tag "kpi_reports_budget", target: "_top" do %>
    <% if title.present? %>
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
      <h1 class="card-title h3 mb-0 text-gray-800">
        <%= title %>
      </h1>
    </div>
    <% end %>

    <%= render "/kpi_reports/budget_filter", entity: @entity %>

    <div class="table-responsive" data-controller="datatable">
        <table id="kpi_reports_budget_grid" class="table table-bordered table-striped dataTable table-grey numberTable">
            <thead>
                <tr>
                    <th rowspan="2" class="text_col">Particulars</th>
                    <% quarterly_reports.map { |r| r.as_of.is_a?(String) ? Date.local_parse(r.as_of) : r.as_of }.compact.uniq.sort.each do |as_of_date| %>
                        <th colspan="<%= tag_lists_to_display.count + (show_achievement_column ? 1 : 0) %>" class="text-center">
                            <%= l(as_of_date, format: :month_year) %>
                        </th>
                    <% end %>
                    <% year_reports.map { |r| r.as_of.is_a?(String) ? Date.local_parse(r.as_of) : r.as_of }.compact.uniq.sort.each do |as_of_date| %>
                        <th colspan="<%= tag_lists_to_display.count + (show_achievement_column ? 1 : 0) %>" class="text-center">
                            <%= l(as_of_date, format: :month_year) %>
                        </th>
                    <% end %>
                </tr>
                <tr>
                    <% quarterly_reports.map(&:as_of).uniq.sort.each do |as_of_date| %>
                        <% tag_lists_to_display.each do |tag| %>
                            <th class="text-center"><%= tag %></th>
                        <% end %>
                        <% if show_achievement_column %>
                            <th class="text-center"><%= achievement_tags.first %> / <%= achievement_tags.last %> (%)</th>
                        <% end %>
                    <% end %>
                    <% year_reports.map(&:as_of).uniq.sort.each do |as_of_date| %>
                        <% tag_lists_to_display.each do |tag| %>
                            <th class="text-center"><%= tag %></th>
                        <% end %>
                        <% if show_achievement_column %>
                            <th class="text-center"><%= achievement_tags.first %> / <%= achievement_tags.last %> (%)</th>
                        <% end %>
                    <% end %>
                </tr>
            </thead>

            <tbody>

                <% investor_kpi_mappings.each do |ikm| %>
                    <tr>
                        <td class="text_col">
                            <%= ikm.id ? link_to(ikm.standard_kpi_name, investor_kpi_mapping_path(ikm.id)) : ikm.standard_kpi_name %>
                        </td>
                        <% # Render quarterly reports %>
                        <% quarterly_reports.map(&:as_of).uniq.sort.each do |as_of_date| %>
                            <% tag_lists_to_display.each do |tag| %>
                                <% kpi_report = grouped_quarterly_reports[as_of_date][tag] %>
                                <% kpi = kpis_by_report_and_name.dig(kpi_report&.id, ikm.standard_kpi_name.downcase) %>
                                <td class="value_<%= kpi&.id %>">
                                    <% if kpi_report %>
                                        <% if kpi %>
                                            <span class="<%= kpi.value.to_f.negative? ? 'text-danger' : nil %>"><%= fx_tooltip_wrap(display_kpi(kpi, ikm, params: params), kpi) %></span>
                                        <% end %>
                                    <% end %>
                                </td>
                            <% end %>
                            <% if show_achievement_column %>
                                <!-- Achievement % Column -->
                                <td>
                                    <%
                                        tag1_report = grouped_quarterly_reports[as_of_date][achievement_tags.first]
                                        tag2_report = grouped_quarterly_reports[as_of_date][achievement_tags.last]
                                        tag1_kpi = kpis_by_report_and_name.dig(tag1_report&.id, ikm.standard_kpi_name.downcase)
                                        tag2_kpi = kpis_by_report_and_name.dig(tag2_report&.id, ikm.standard_kpi_name.downcase)
                                        tag1_value = tag1_kpi&.value
                                        tag2_value = tag2_kpi&.value
                                    %>
                                    <% if tag1_value.present? && tag2_value.present? && tag2_value.to_f != 0 %>
                                        <% result = (tag1_value.to_f / tag2_value.to_f) * 100
                                           element_class =  if result.positive?
                                                                'text-success'
                                                            elsif result.negative?
                                                                'text-danger'
                                                            else
                                                                ''
                                                            end
                                        %>
                                        <span class="<%= element_class %>">
                                            <%= number_to_percentage_for_ui(result, precision:, negative_in_parentheses: true) %>
                                        </span>
                                    <% else %>

                                    <% end %>
                                </td>
                            <% end %>
                        <% end %>

                        <% # Render yearly reports %>
                        <% year_reports.map(&:as_of).uniq.sort.each do |as_of_date| %>
                            <% tag_lists_to_display.each do |tag| %>
                                <% kpi_report = grouped_yearly_reports[as_of_date][tag] %>
                                <% kpi = kpis_by_report_and_name.dig(kpi_report&.id, ikm.standard_kpi_name.downcase) %>
                                <td class="value_<%= kpi&.id %>">
                                    <% if kpi_report %>
                                        <% if kpi %>
                                            <span class="<%= kpi.value.to_f.negative? ? 'text-danger' : nil %>"><%= fx_tooltip_wrap(display_kpi(kpi, ikm, params: params), kpi) %></span>
                                        <% end %>
                                    <% end %>
                                </td>
                            <% end %>
                            <% if show_achievement_column %>
                                <!-- Achievement % Column -->
                                <td>
                                    <%
                                        tag1_report = grouped_yearly_reports[as_of_date][achievement_tags.first]
                                        tag2_report = grouped_yearly_reports[as_of_date][achievement_tags.last]
                                        tag1_kpi = kpis_by_report_and_name.dig(tag1_report&.id, ikm.standard_kpi_name.downcase)
                                        tag2_kpi = kpis_by_report_and_name.dig(tag2_report&.id, ikm.standard_kpi_name.downcase)
                                        tag1_value = tag1_kpi&.value
                                        tag2_value = tag2_kpi&.value
                                    %>
                                    <% if tag1_value.present? && tag2_value.present? && tag2_value.to_f != 0 %>

                                        <% result = (tag1_value.to_f / tag2_value.to_f) * 100
                                           element_class =  if result.positive?
                                                                'text-success'
                                                            elsif result.negative?
                                                                'text-danger'
                                                            else
                                                                ''
                                                            end

                                        %>
                                        <span class="<%= element_class %>">
                                            <%= number_to_percentage_for_ui(result, precision:, negative_in_parentheses: true) %>
                                        </span>
                                    <% else %>

                                    <% end %>
                                </td>
                            <% end %>
                        <% end %>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>
<% end %>
