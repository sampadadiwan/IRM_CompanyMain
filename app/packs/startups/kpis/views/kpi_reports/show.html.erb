<%= render FormCard.new(title: "Kpi Report #{@kpi_report.portfolio_company} : #{l(@kpi_report.as_of)}") do %>
<table class="table table-bordered dataTable">
  <tr>
    <td>
      Entity
    </td>
    <td>
      <%= link_to @kpi_report.entity %>
    </td>
  </tr>

  <% if @kpi_report.portfolio_company %>
  <tr>
    <td>
      Portfolio Company
    </td>
    <td>
      <%= link_to @kpi_report.portfolio_company %>
    </td>
  </tr>
  <% end %>

  <% if @kpi_report.owner %>
  <tr>
    <td>
      Owner
    </td>
    <td>
      <%= link_to @kpi_report.owner %>
    </td>
  </tr>
  <% end %>

  <tr>
    <td>
      As Of
    </td>
    <td>
      <%= l @kpi_report.as_of %>
    </td>
  </tr>

  <tr>
    <td>
      Period
    </td>
    <td>
      <%= @kpi_report.period %>
    </td>
  </tr>

  <% if @kpi_report.status.present? %>
    <tr>
      <td>
        Status
      </td>
      <td>
        <% badge_class = case @kpi_report.status
           when 'submitted'   then 'bg-success'
           when 'reviewed'    then 'bg-primary'
           when 'draft_saved' then 'bg-warning text-dark'
           when 'link_sent'   then 'bg-info text-dark'
           else 'bg-secondary'
           end %>
        <span class="badge <%= badge_class %>"><%= @kpi_report.status.humanize.titleize %></span>
        <% if @kpi_report.submitted_at.present? %>
          <small class="text-muted ms-2">Submitted <%= I18n.l(@kpi_report.submitted_at, format: :short) %></small>
        <% end %>
        <%# Portco self-reporting: nothing can be imported until the fund configures KPI mappings (§2.7) %>
        <% if @kpi_report.enable_portco_upload && @kpi_report.no_kpi_mappings? %>
          <span class="badge bg-danger ms-2" data-bs-toggle="tooltip" title="Add mappings under Investors → KPI Mappings; the portco's uploads are rejected until then">No KPI mappings configured</span>
        <% end %>
      </td>
    </tr>
  <% end %>

  <%# Outcome of the last workbook check / import (§2.2 E, §2.10) — the fund's at-a-glance summary %>
  <% verdict = @kpi_report.validation_result %>
  <% if @kpi_report.import_status.present? || verdict.present? %>
    <tr>
      <td>
        Workbook import
      </td>
      <td>
        <% case @kpi_report.import_status
           when 'pending' %><span class="badge bg-info text-dark">Import pending</span>
        <% when 'imported' %><span class="badge bg-success">Imported</span>
        <% when 'failed' %><span class="badge bg-danger">Import failed — reopened for the portco</span>
        <% end %>
        <% if verdict.present? %>
          <% err_n = Array(verdict['errors']).size; warn_n = Array(verdict['warnings']).size %>
          <span class="badge <%= err_n.positive? ? 'bg-danger' : 'bg-success' %> ms-1"><%= pluralize(err_n, 'error') %></span>
          <span class="badge <%= warn_n.positive? ? 'bg-warning text-dark' : 'bg-light text-dark border' %> ms-1"><%= pluralize(warn_n, 'warning') %></span>
          <% if verdict.dig('summary', 'cells_ok').present? %>
            <span class="ms-2"><%= verdict.dig('summary', 'cells_ok') %> values staged<% if verdict.dig('summary', 'cells_changed').to_i.positive? %>, <%= verdict.dig('summary', 'cells_changed') %> differ from approved<% end %></span>
          <% end %>
          <% if @kpi_report.validated_at.present? %>
            <small class="text-muted ms-2">checked <%= I18n.l(@kpi_report.validated_at, format: :short) %></small>
          <% end %>
        <% end %>
      </td>
    </tr>
  <% end %>

  <% if @kpi_report.tag_list.present? %>
    <tr>
      <td>
        Tags
      </td>
      <td>
        <%= @kpi_report.tag_list %>
      </td>
    </tr>
  <% end %>

  <%= display_custom_fields(@kpi_report, collapsed: false) if current_user %>

  <tr>
    <td>
      Notes
    </td>
    <td>
      <%= @kpi_report.notes %>
    </td>
  </tr>
  <tr>
    <td>
      By
    </td>
    <td>
      <%= @kpi_report.user.full_name %>
    </td>
  </tr>

  <% if @kpi_report.import_uploads.present? %>
  <tr>
    <td>
      Imported Data
    </td>
    <td>
      <%= link_to @kpi_report.import_uploads.last %>
    </td>
  </tr>
  <% end %>



</table>
<div>
  <% if policy(@kpi_report).update? %>
    <%= button_to "Analyze", analyze_kpi_report_path(@kpi_report), class: "btn btn-outline-warning", data: {action: "click->confirm#popup", msg: "Analysis will be done using an LLM and will take time, so please be patient. Your data will be sent to an external LLM. Proceed?", turbo:false, method: :post} if current_user.entity.enable_ai_chat %>

    <%= button_to "Send Notification", send_portco_notification_kpi_reports_path(portfolio_company_id: @kpi_report.portfolio_company_id), method: :post, class: "btn btn-outline-info", data: {action: "click->confirm#popup", msg: "Send a notification reminder to the Portfolio Company to complete this KPI report", method: :post, bs_toggle: "tooltip", bs_title: "Send a notification reminder to the Portfolio Company to complete this KPI report"} if policy(@kpi_report).send_portco_notification? && false  %>

<%= link_to  t_common(:edit), edit_kpi_report_path(@kpi_report, signed_id: params[:signed_id]), {class: "btn btn-outline-primary"} %>

    <%# Fund side: send a submitted/reviewed report back to the portco and re-send the magic link (§3.4 Q) %>
    <% if policy(@kpi_report).reopen? && (@kpi_report.status_submitted? || @kpi_report.status_reviewed?) && @kpi_report.enable_portco_upload %>
      <%= button_to "Reopen & ask to re-upload", reopen_kpi_report_path(@kpi_report), method: :patch, form_class: "d-inline",
                    class: "btn btn-outline-warning",
                    data: { action: "click->confirm#popup", msg: "This puts the report back to Draft Saved and emails the portfolio company a fresh upload link. Proceed?", method: :patch, turbo: false } %>
    <% end %>

    <% msg = "Refreshing will re-run the import which will create and update the KPIs. Do you want to proceed?" %>
    <% if policy(@kpi_report).refresh_import? %>
      <%= button_to "Refresh", refresh_import_kpi_report_path("kpi_report[id]": @kpi_report.id, "kpi_report[upload_new_kpis]": true, "kpi_report[update_existing_kpis]": true),
                    method: :patch,
                    form_class: "deleteButton",
                    data: {
                      bs_toggle: "tooltip", bs_title: "Refresh Imported Data",
                      action: "click->confirm#popup",
                      msg: msg,
                      method: :patch,
                      turbo: false
                    },
                    class: "btn btn-outline-secondary"
                    %>
    <% end %>


    <%= button_to t_common(:delete), @kpi_report, method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton", data: {action: "click->confirm#popup", turbo:false}  if policy(@kpi_report).destroy? %>

    <% if policy(@kpi_report).mark_reviewed? && @kpi_report.status_submitted? %>
      <%= link_to "View Including Staged",
            kpi_reports_path(portfolio_company_id: @kpi_report.portfolio_company_id, view_unapproved: true, grid_view: true),
            class: "btn btn-outline-success" %>
    <% end %>

  <% end %>
</div>

<div class="associated_entity">
  <%= render "/kpi_reports/details", kpi_report: @kpi_report %>
</div>
<% end %>

<%# The full workbook check (errors / warnings / how each cell was read) — same partial the portco saw %>
<% if @kpi_report.validation_result.present? && current_user %>
  <%= render ToggleCard.new(title: "Workbook check details", state: "hide") do %>
    <%= render "kpi_reports/validation_panel", verdict: @kpi_report.validation_result, kpi_report: @kpi_report %>
  <% end %>
<% end %>
