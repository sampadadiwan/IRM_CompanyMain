<%= render FormCard.new(title: "Kpi Report #{@kpi_report.portfolio_company} : #{l(@kpi_report.as_of)}") do %>
<table class="table table-bordered dataTable">
  <tr>
    <td>
      Entity
    </td>
    <td>
      <%= link_to @kpi_report.entity %>
    </td>
  </tr>

  <% if @kpi_report.portfolio_company %>
  <tr>
    <td>
      Portfolio Company
    </td>
    <td>
      <%= link_to @kpi_report.portfolio_company %>
    </td>
  </tr>
  <% end %>

  <% if @kpi_report.owner %>
  <tr>
    <td>
      Owner
    </td>
    <td>
      <%= link_to @kpi_report.owner %>
    </td>
  </tr>
  <% end %>

  <tr>
    <td>
      As Of
    </td>
    <td>
      <%= l @kpi_report.as_of %>
    </td>
  </tr>

  <tr>
    <td>
      Period
    </td>
    <td>
      <%= @kpi_report.period %>
    </td>
  </tr>

  <% if @kpi_report.tag_list.present? %>
    <tr>
      <td>
        Tags
      </td>
      <td>
        <%= @kpi_report.tag_list %>
      </td>
    </tr>
  <% end %>

  <%= display_custom_fields(@kpi_report, collapsed: false) if current_user %>

  <tr>
    <td>
      Notes
    </td>
    <td>
      <%= @kpi_report.notes %>
    </td>
  </tr>
  <tr>
    <td>
      By
    </td>
    <td>
      <%= @kpi_report.user.full_name %>
    </td>
  </tr>

  <% if @kpi_report.import_uploads.present? %>
  <tr>
    <td>
      Imported Data
    </td>
    <td>
      <%= link_to @kpi_report.import_uploads.last %>
    </td>
  </tr>
  <% end %>



</table>
<div>
  <% if policy(@kpi_report).update? %>
    <%= button_to "Analyze", analyze_kpi_report_path(@kpi_report), class: "btn btn-outline-warning", data: {action: "click->confirm#popup", msg: "Analysis will be done using an LLM and will take time, so please be patient. Your data will be sent to an external LLM. Proceed?", turbo:false, method: :post} if current_user.entity.enable_ai_chat %>

    <%= button_to "Send Notification", send_portco_notification_kpi_reports_path(portfolio_company_id: @kpi_report.portfolio_company_id), method: :post, class: "btn btn-outline-info", data: {action: "click->confirm#popup", msg: "Send a notification reminder to the Portfolio Company to complete this KPI report", method: :post, bs_toggle: "tooltip", bs_title: "Send a notification reminder to the Portfolio Company to complete this KPI report"} if policy(@kpi_report).send_portco_notification? && false  %>

    <% if policy(KpiReport).trigger_periodic_reports? && !@kpi_report.status_submitted? && !@kpi_report.status_reviewed? %>
      <%
          has_users = @kpi_report.portfolio_company&.notification_users&.any?
          msg = if has_users
                  "Manually trigger the notification to upload KPIs for this company?"
                else
                  "No notification users found for this company."
                end
      %>
      <%= button_to "Trigger Upload Notification", trigger_periodic_reports_kpi_report_path(@kpi_report),
          method: :post,
          class: "btn btn-outline-success #{'disabled' unless has_users}",
          disabled: !has_users,
          data: {bs_toggle: "tooltip", bs_title: msg, action: "click->confirm#popup", turbo: false, method: :post, notification: "yes", msg: msg} %>
    <% end %>

    <%= link_to  t_common(:edit), edit_kpi_report_path(@kpi_report, signed_id: params[:signed_id]), {class: "btn btn-outline-primary"} %>

    <% msg = "Refreshing will re-run the import which will create and update the KPIs. Do you want to proceed?" %>
    <% if policy(@kpi_report).refresh_import? %>
      <%= button_to "Refresh", refresh_import_kpi_report_path("kpi_report[id]": @kpi_report.id, "kpi_report[upload_new_kpis]": true, "kpi_report[update_existing_kpis]": true),
                    method: :patch,
                    form_class: "deleteButton",
                    data: {
                      bs_toggle: "tooltip", bs_title: "Refresh Imported Data",
                      action: "click->confirm#popup",
                      msg: msg,
                      method: :patch,
                      turbo: false
                    },
                    class: "btn btn-outline-secondary"
                    %>
    <% end %>


    <%= button_to t_common(:delete), @kpi_report, method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton", data: {action: "click->confirm#popup", turbo:false}  if policy(@kpi_report).destroy? %>

    <% if policy(@kpi_report).mark_reviewed? && @kpi_report.status_submitted? %>
      <%= link_to "View Including Staged",
            kpi_reports_path(portfolio_company_id: @kpi_report.portfolio_company_id, view_unapproved: true, grid_view: true),
            class: "btn btn-outline-success" %>
    <% end %>

  <% end %>
</div>

<div class="associated_entity">
  <%= render "/kpi_reports/details", kpi_report: @kpi_report %>
</div>
<% end %>
