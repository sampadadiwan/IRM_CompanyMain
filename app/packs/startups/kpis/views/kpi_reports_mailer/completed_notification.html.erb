<%# KPI report journey's completion email. Worked examples H8 — openspec/changes/kpi-report-journey/design.md#worked-examples %>
<p>Dear <%= @user.name %>,</p>

<p>The KPI report for <strong><%= @kpi_report.for_name %></strong> for the period ending <strong><%= l @kpi_report.as_of %></strong> is complete: its KPIs are imported, approved and the report is closed.</p>

<p><%= link_to 'Open KPI Report', kpi_report_url(@kpi_report, host: @entity.sub_domain + '.' + ENV.fetch('DOMAIN', 'localhost')), class: "btn btn-outline-primary" %></p>

<p>Thank you,<br><%= @entity.name %> System</p>
