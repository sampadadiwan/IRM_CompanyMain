<% if current_user.curr_role.casecmp?("investor")%>

<%= render "/deal_investors/investor_view", deal_investors: deal_investors %>

<% else %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Deal Investors</h1>

  <span>
    <%= link_to "New Deal Investor", new_deal_investor_path("deal_investor[deal_id]": params[:deal_id],
                "deal_investor[entity_id]": current_user.entity_id ),
                {class: "btn btn-outline-primary"} if params[:deal_id] && !current_user.curr_role.casecmp?("investor") %>

    <%= render "investments/currency_form" %>
  </span>
</div>

<%# D21 — the firm's chosen columns (or the list's own, DealInvestor::LIST_COLUMNS), sorted, searched and paged in
    the page by jQuery DataTables (the datatable controller sits around this partial in index.html.erb).
    openspec/changes/grid-columns-inline-settings %>
<%= render RansackTable.new(DealInvestor, q: @q, default_columns_map: DealInvestor::LIST_COLUMNS, current_user: current_user,
                            records: deal_investors, report_id: params["report_id"], turbo_frame: "deal_investors_frame",
                            referrer: request.referrer, pagy: nil, table_css_class: "jqDataTable", sortable: false) %>

<% end %>
