<div class="row mb-4">
  <div class="col-lg-4">
    <div class="card shadow mb-4">
      <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Investor Status</h6>
      </div>
      <div class="card-body">
        <div class="chart-area" style="height: 300px;">
          <%= deal_investors_status(deal) %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow mb-4">
      <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Activity Completion Health</h6>
      </div>
      <div class="card-body">
        <div class="chart-area" style="height: 300px;">
          <%= deal_activities_completion(deal) %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow mb-4">
      <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Investment Allocation Breakdown</h6>
      </div>
      <div class="card-body">
        <div class="chart-pie pt-4 pb-2" style="height: 300px;">
          <%
            investors = deal.deal_investors.not_declined
            breakdown_data = {
              "Primary" => investors.sum(:primary_amount_cents) / 100.0,
              "Secondary" => investors.sum(:secondary_investment_cents) / 100.0,
              "Fees" => investors.sum(:fee_cents) / 100.0
            }
          %>
          <%= pie_chart breakdown_data, library: {
            plotOptions: { pie: { dataLabels: { enabled: true, format: '<b>{point.name}</b>: {point.percentage:.1f}%' } } },
            **chart_theme_color
          } %>
        </div>
      </div>
    </div>
  </div>
</div>
