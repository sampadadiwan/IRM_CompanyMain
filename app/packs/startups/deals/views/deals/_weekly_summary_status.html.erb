<%#
  Status Changes panel — investors who changed status during the period.
  @param period_deltas [Hash] period delta data from report json_fields
%>

<%
  status_changes = period_deltas.dig("status_changes") || {}
  by_status = status_changes["by_status"] || {}
  details = status_changes["details"] || {}
  total = status_changes["total"] || 0

  status_icons = {
    "Active"    => { icon: "ti-check",         bg: "success" },
    "Complete"  => { icon: "ti-circle-check",  bg: "success" },
    "Completed" => { icon: "ti-circle-check",  bg: "success" },
    "Declined"  => { icon: "ti-x",             bg: "danger" },
    "Pending"   => { icon: "ti-clock",         bg: "warning" }
  }
  default_icon = { icon: "ti-switch-horizontal", bg: "info" }
%>

<div class="card h-100 shadow-sm border-0">
  <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
    <h6 class="mb-0 fw-bold">Status Changes</h6>
    <span class="badge bg-info text-white rounded-pill"><%= total %></span>
  </div>
  <div class="card-body">
    <% if by_status.any? %>
      <% by_status.each_with_index do |(status, count), idx| %>
        <%
          si = status_icons[status] || default_icon
          collapse_id = "status-#{status.parameterize}-list"
          investor_list = details[status] || []
        %>
        <div class="d-flex justify-content-between align-items-center py-2"
             <% if investor_list.any? %>data-bs-toggle="collapse" data-bs-target="#<%= collapse_id %>"<% end %>
             role="button" aria-expanded="false" style="cursor: pointer;">
          <div class="d-flex align-items-center">
            <span class="rounded-circle bg-<%= si[:bg] %> bg-opacity-10 d-inline-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px;">
              <i class="ti <%= si[:icon] %> text-<%= si[:bg] %>" style="font-size: 14px;"></i>
            </span>
            <span>Companies <%= status.downcase == "declined" ? "declined" : "moved to #{status.downcase}" %></span>
          </div>
          <div class="d-flex align-items-center">
            <span class="badge bg-<%= si[:bg] %> <%= si[:bg] == 'warning' ? 'text-dark' : '' %> rounded-pill me-2"><%= count %></span>
            <i class="ti ti-chevron-right text-muted" style="font-size: 14px;"></i>
          </div>
        </div>
        <% if investor_list.any? %>
          <div class="collapse" id="<%= collapse_id %>">
            <ul class="list-group list-group-flush small ms-4">
              <% investor_list.each do |inv| %>
                <li class="list-group-item px-0 py-1 border-0">
                  <%= inv["investor_name"] %>
                  <span class="text-muted ms-1">
                    (<%= Time.parse(inv["changed_at"]).strftime("%d %b") %>)
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% unless idx == by_status.size - 1 %><hr class="my-1"><% end %>
      <% end %>
    <% else %>
      <p class="text-muted small mb-0">No status changes this period.</p>
    <% end %>
  </div>
</div>
