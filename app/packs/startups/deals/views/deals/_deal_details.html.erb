<%
  show_deal ||= "Yes"
  show_investors ||= "Yes"
%>
<div class="associated_entity" data-controller="tabs tabdetails">
  <nav class="nav nav-pills nav-justified p-3 mb-3 rounded align-items-center card flex-row"  role="tablist">
    <a class="nav-link active" data-bs-toggle="pill" data-bs-toggle="tab" href="#charts-tab">Charts</a>
    <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#access-tab">Access Rights</a>
    <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#docs-tab">Documents</a>
    <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#widgets-tab">Widgets</a>
    <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#track-records-tab">Track Record</a>
    <% if show_deal == "Yes" %>
      <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#deal-tab" id="deal_tab">Deal</a>
    <% end %>
    <% if show_investors == "Yes" %>
      <a  class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#investors-tab" id="deal_investments">Deal Investors</a>
    <% end %>
    <a  class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#activities-tab">Deal Steps</a>
    <a  class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#tasks-tab">Tasks</a>
    <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#reminders-tab">Reminders</a>
    <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#notifications-tab">Custom Notifications</a>
    <% if current_user.entity_id == deal.entity_id && deal.entity.support_agents.set?(:deal_management_agent) %>
      <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#ai-agent-tab"><i class="ti ti-robot me-1"></i>AI Agent</a>
    <% end %>
  </nav>
  <div class="tab-content">
    <div id="charts-tab" class="tab-pane fade in show active">
      <div id="deal_charts" class="associated_entity">
        <%= render "deals/list_view_charts", deal: deal %>
      </div>
    </div>
    <div id="deal-tab" class="tab-pane fade">
      <div id="deal_docs" class="associated_entity">
        <%= render "/deals/show", deal: deal %>
      </div>
    </div>
    <div id="docs-tab" class="tab-pane fade">
      <div id="docs" class="associated_entity">
        <%= turbo_frame_tag "documents_tree_frame", target: "_top", src: folder_documents_path(entity_id: deal.entity_id, folder_id: deal.document_folder.id), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="widgets-tab" class="tab-pane fade">
      <div id="widgets" class="associated_entity">
        <%= render "/ci_widgets/index", ci_widgets: deal.ci_widgets, owner: deal, target: "_blank" %>
      </div>
    </div>
    <div id="track-records-tab" class="tab-pane fade">
      <div id="track_records" class="associated_entity">
        <%= render "/ci_track_records/index", ci_track_records: deal.ci_track_records, owner: deal, target: "_blank" %>
      </div>
    </div>
    <div id="activities-tab" class="tab-pane fade">
      <div id="deal_activities" class="associated_entity">
        <%= turbo_frame_tag "deal_activities_frame", target: "_top", src: deal_activities_path(deal_id: deal.id, template: true, all: true), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="tasks-tab" class="tab-pane fade">
      <div id="deal_tasks" class="associated_entity">
        <%# Load tasks for both the Deal and its DealInvestors by passing deal_id %>
        <%= turbo_frame_tag "tasks_frame", target: "_top", src: tasks_path(deal_id: deal.id), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="investors-tab" class="tab-pane fade">
      <div id="deal_investors" class="associated_entity">
        <%= turbo_frame_tag "deal_investors_frame", target: "_top", src: deal_investors_path(deal_id: deal.id), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="access-tab" class="tab-pane fade">
      <div id="access_rights" class="associated_entity">
        <%= turbo_frame_tag "access_rights_frame", target: "_top", src: access_rights_path(owner_id: deal.id, owner_type: "Deal", form_type: "deals/access_rights_form", entity_id: deal.entity_id, access_type: "Deal"), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="reminders-tab" class="tab-pane fade">
      <div id="reminders" class="associated_entity">
        <%= turbo_frame_tag "reminders_list", target: "_top", src: reminders_path( owner_id: deal.id, owner_type: "Deal", sent: false), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="notifications-tab" class="tab-pane fade">
      <div id="custom_notifications" class="associated_entity">
        <%= turbo_frame_tag "custom_notifications_frame", target: "_top", src: custom_notifications_path(q: { owner_id_eq: deal.id, owner_type_eq: "Deal" }), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <% if current_user.entity_id == deal.entity_id && deal.entity.support_agents.set?(:deal_management_agent) %>
      <div id="ai-agent-tab" class="tab-pane fade">
        <% deal_agent   = SupportAgent.find_by(entity_id: deal.entity_id, agent_type: "DealManagementAgent", enabled: true) %>
        <% deal_reports = deal_agent ? SupportAgentReport.where(support_agent: deal_agent, owner: deal).order(updated_at: :desc) : [] %>

        <%# ── Toolbar: last run + Run Now ── %>
        <div class="d-flex align-items-center justify-content-between mt-3 mb-2">
          <span class="fw-semibold"><i class="ti ti-robot me-1"></i> Deal Management Agent</span>
          <div class="d-flex align-items-center gap-2">
            <% if deal_reports.any? %>
              <span class="text-muted small">Last run: <%= deal_reports.first.updated_at.strftime("%d %b %Y, %H:%M") %></span>
            <% end %>
            <%= button_to "Run Now",
                  run_support_agents_path(agent_type: "DealManagementAgent", target_type: "Deal", target_id: deal.id),
                  method: :post, class: "btn btn-sm btn-primary", data: { turbo: false } %>
          </div>
        </div>

        <%# ── Full report (same partial as the SupportAgent Deal Reports tab) ── %>
        <%= render "/support_agents/deal_reports_tab",
                   support_agent: deal_agent,
                   deal_reports:  deal_reports %>
      </div>
    <% end %>
  </div>
</div>
