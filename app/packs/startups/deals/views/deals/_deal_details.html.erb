<%# Deal details partial — tabbed view with activities, investors, tasks, reminders,
    notifications, and agent settings for a single deal.
    @param deal [Deal] the deal record
    @param show_deal [String] "Yes"/"No" toggle for deal section visibility
    @param show_investors [String] "Yes"/"No" toggle for investors section visibility %>
<%
  show_deal ||= "Yes"
  show_investors ||= "Yes"
%>
<div class="associated_entity" data-controller="tabs tabdetails">
  <%
    # Screens grouped under each dropdown tab (layouts/_dropdown_tab), filtered to what this deal shows
    deal_tabs = [
      ({ pane: "deal-tab", icon: "ti-briefcase", label: "Deal", hint: "Deal details", id: "deal_tab" } if show_deal == "Yes"),
      ({ pane: "investors-tab", icon: "ti-users", label: "Deal Investors", hint: "Investors in this deal", id: "deal_investments" } if show_investors == "Yes"),
      { pane: "activities-tab", icon: "ti-route", label: "Deal Steps", hint: "Steps each deal investor goes through" }
    ].compact
    agent_enabled = deal.entity.support_agents.set?(:deals_report_agent)
    manage_tabs = [
      { pane: "tasks-tab", icon: "ti-list-check", label: "Tasks", hint: "Tasks on this deal and its investors" },
      { pane: "reminders-tab", icon: "ti-alarm", label: "Reminders", hint: "Scheduled reminders" },
      { pane: "notifications-tab", icon: "ti-bell", label: "Custom Notifications", hint: "Custom email notifications" },
      { pane: "access-tab", icon: "ti-lock", label: "Access Rights", hint: "Who can see this deal" },
      # Shown greyed out (not hidden) when the agent is off, so users know the setting exists
      { pane: "agent-settings-tab", icon: "ti-robot", label: "Agent Settings",
        hint: agent_enabled ? "Deals Report Agent settings" : "Agent disabled - contact support", disabled: !agent_enabled }
    ]
    # Pending emails the Deal Update Agent couldn't auto-file, shown as a badge on the Warehouse tab
    warehouse_count = deal.warehouse_items.pending.count
  %>
  <nav class="nav nav-pills nav-justified p-3 mb-3 rounded align-items-center card flex-row"  role="tablist">
    <a class="nav-link active" data-bs-toggle="pill" data-bs-toggle="tab" href="#charts-tab"><i class="ti ti-chart-bar me-1"></i>Charts</a>
    <%= render "layouts/dropdown_tab", icon: "ti-briefcase", label: "Deal", items: deal_tabs %>
    <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#docs-tab"><i class="ti ti-file-text me-1"></i>Documents</a>
    <%# Warehouse stays a tab of its own so its pending-count badge is always visible %>
    <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#warehouse-tab">
      <i class="ti ti-inbox me-1"></i>Warehouse
      <% if warehouse_count > 0 %>
        <span class="badge bg-warning"><%= warehouse_count %></span>
      <% end %>
    </a>
    <%= render "layouts/dropdown_tab", icon: "ti-settings", label: "Manage", items: manage_tabs %>
  </nav>
  <div class="tab-content">
    <div id="charts-tab" class="tab-pane fade in show active">
      <div id="deal_charts" class="associated_entity">
        <%= render "deals/list_view_charts", deal: deal %>
      </div>
    </div>
    <div id="deal-tab" class="tab-pane fade">
      <div id="deal_docs" class="associated_entity">
        <%= render "/deals/show", deal: deal %>
      </div>
    </div>
    <div id="docs-tab" class="tab-pane fade">
      <div id="docs" class="associated_entity">
        <%= turbo_frame_tag "documents_tree_frame", target: "_top", src: folder_documents_path(entity_id: deal.entity_id, folder_id: deal.document_folder.id), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="activities-tab" class="tab-pane fade">
      <div id="deal_activities" class="associated_entity">
        <%= turbo_frame_tag "deal_activities_frame", target: "_top", src: deal_activities_path(deal_id: deal.id, template: true, all: true), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="tasks-tab" class="tab-pane fade">
      <div id="deal_tasks" class="associated_entity">
        <%# Load tasks for both the Deal and its DealInvestors by passing deal_id %>
        <%= turbo_frame_tag "tasks_frame", target: "_top", src: tasks_path(deal_id: deal.id, embedded_task_context: "deal_tab"), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="investors-tab" class="tab-pane fade">
      <div id="deal_investors" class="associated_entity">
        <%= turbo_frame_tag "deal_investors_frame", target: "_top", src: deal_investors_path(deal_id: deal.id), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="access-tab" class="tab-pane fade">
      <div id="access_rights" class="associated_entity">
        <%= turbo_frame_tag "access_rights_frame", target: "_top", src: access_rights_path(owner_id: deal.id, owner_type: "Deal", form_type: "deals/access_rights_form", entity_id: deal.entity_id, access_type: "Deal"), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="reminders-tab" class="tab-pane fade">
      <div id="reminders" class="associated_entity">
        <%= turbo_frame_tag "reminders_list", target: "_top", src: reminders_path( owner_id: deal.id, owner_type: "Deal", sent: false), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
    <div id="notifications-tab" class="tab-pane fade">
      <div id="custom_notifications" class="associated_entity">
        <%= turbo_frame_tag "custom_notifications_frame", target: "_top", src: custom_notifications_path(q: { owner_id_eq: deal.id, owner_type_eq: "Deal" }), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>
        <%# Warehouse tab pane — lazy-loaded list of pending warehouse items %>
    <div id="warehouse-tab" class="tab-pane fade">
      <div id="warehouse_items" class="associated_entity">
        <%= turbo_frame_tag "warehouse_items_frame", target: "_top", src: deal_warehouse_items_path(deal), loading: :lazy do %>
          <%= render "/layouts/loading" %>
        <% end %>
      </div>
    </div>

    <% if deal.entity.support_agents.set?(:deals_report_agent) %>
      <div id="agent-settings-tab" class="tab-pane fade">
        <%= render "deals/deal_agent_settings", deal: deal %>
      </div>
    <% end %>
  </div>
</div>
