<!-- Sidepanel for DealInvestor Show -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="dealInvestorSidepanel" aria-labelledby="dealInvestorSidepanelLabel" style="width: 50%;">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title" id="dealInvestorSidepanelLabel">Investor Details</h5>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body p-0">
    <turbo-frame id="deal_investor_frame">
      <div class="p-4 text-center">
        <div class="spinner-border text-primary" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
      </div>
    </turbo-frame>
  </div>
</div>
