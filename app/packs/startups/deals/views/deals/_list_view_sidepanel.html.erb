<!-- Sidepanel for DealInvestor Show -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="dealInvestorSidepanel" aria-labelledby="dealInvestorSidepanelLabel">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title" id="dealInvestorSidepanelLabel">Investor Details</h5>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body p-0">
    <%# Plain div rather than a <turbo-frame src="..."> - the controller
        (deals_list_ag_grid_controller.js #loadSidepanelContent) fetches each
        investor's HTML itself and swaps it in via innerHTML instead of letting
        Turbo manage the frame's src. That gives it control to abort a stale
        in-flight request when a different investor is opened before the first
        one finishes loading, which a src-driven turbo-frame doesn't expose. %>
    <div id="deal_investor_panel_content" class="h-100">
      <div class="p-4 text-center">
        <div class="spinner-border text-primary" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
      </div>
    </div>
  </div>
</div>
