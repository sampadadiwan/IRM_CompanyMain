
<div class="card shadow mb-4">
  <div class="card-header py-3 d-flex align-items-center justify-content-between">
    <h6 class="m-0 font-weight-bold text-primary">Investors</h6>
    <button id="clear-grid-filters"
            class="btn btn-sm btn-outline-danger align-items-center gap-1"
            style="display: none;"
            data-action="click->deals-list-ag-grid#clearFilters">
      <i class="ti ti-filter-off"></i> Clear Filters
    </button>
  </div>
  <div class="card-body p-0" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <div
      id="deals_list_grid"
      class="<%= get_ag_theme %>"
      style="height: 800px; min-height: 800px; width: 100%; min-width: 1500px;"
      data-source="<%= deal_investors_path(params.to_unsafe_h.merge(format: :json, deal_id: deal.id, all: params[:all])) %>"
    >
    </div>
  </div>
</div>
