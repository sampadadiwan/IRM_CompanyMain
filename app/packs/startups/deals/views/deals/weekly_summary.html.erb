<%
  period_deltas = @data["period_deltas"] || {}
  stagnation = @data["stagnation_breakdown"] || {}
  tasks_summary = @data["tasks_summary"] || {}
  charts_data = @data["charts_data"] || {}
  weekly_insight = @data["weekly_insight"]

  period_start = period_deltas["period_start"]
  period_end = period_deltas["period_end"]
%>

<div class="container-fluid py-4">
  <%# Header: deal name, date range, report selector %>
  <%= render "deals/weekly_summary_header",
             deal: @deal,
             report: @report,
             past_reports: @past_reports,
             period_start: period_start,
             period_end: period_end %>

  <% if @report.present? %>
    <%# Executive Summary %>
    <%
      new_count = period_deltas.dig("new_investors", "count") || 0
      transitions_total = period_deltas.dig("step_transitions", "total") || 0
      stagnant_total = stagnation["total"] || 0
      status_by = stagnation.dig("status_changes", "by_status") || period_deltas.dig("status_changes", "by_status") || {}
      completed_status = status_by["Complete"] || status_by["Completed"] || 0
      declined_status = status_by["Declined"] || 0
      overdue_count = tasks_summary["overdue_count"] || 0

      summary_sentences = []
      summary_sentences << "#{new_count} new #{'investor'.pluralize(new_count)} added to the pipeline" if new_count > 0
      summary_sentences << "#{transitions_total} #{'investor'.pluralize(transitions_total)} advanced across stages" if transitions_total > 0
      summary_sentences << "#{stagnant_total} remain stagnant" if stagnant_total > 0
      summary_sentences << "#{completed_status} completed" if completed_status > 0
      summary_sentences << "#{declined_status} declined" if declined_status > 0
      executive_text = if summary_sentences.any?
                         "This week, #{summary_sentences.join(', ')}."
                       else
                         "No significant pipeline movement this week."
                       end
    %>
    <div class="card mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #f0f4ff 0%, #fff 100%);">
      <div class="card-body d-flex align-items-center">
        <div class="me-3" style="min-width: 56px;">
          <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
            <i class="ti ti-report-analytics text-primary fs-3"></i>
          </div>
        </div>
        <div class="flex-grow-1">
          <h6 class="fw-bold mb-1">Executive Summary</h6>
          <p class="mb-0 text-muted"><%= executive_text %></p>
        </div>
        <div class="ms-3 text-end">
          <%= link_to deal_path(@deal), class: "btn btn-outline-primary btn-sm" do %>
            <i class="ti ti-external-link me-1"></i>View Full Dashboard
          <% end %>
        </div>
      </div>
    </div>

    <%# Section 1: Deals Summary — three panels side by side %>
    <h6 class="fw-bold text-muted mb-3"><i class="ti ti-chart-arrows-vertical text-warning me-1"></i> 1. Deals Summary</h6>
    <div class="row mb-2">
      <div class="col-md-4">
        <%= render "deals/weekly_summary_progress", period_deltas: period_deltas %>
      </div>
      <div class="col-md-4">
        <%= render "deals/weekly_summary_stagnation", stagnation: stagnation %>
      </div>
      <div class="col-md-4">
        <%= render "deals/weekly_summary_status", period_deltas: period_deltas %>
      </div>
    </div>
    <p class="text-muted small mb-4"><i class="ti ti-bulb text-warning me-1"></i>Click on any count to view the details</p>

    <%# Section 2: Tasks Summary %>
    <h6 class="fw-bold text-muted mb-3"><i class="ti ti-checklist text-success me-1"></i> 2. Pending Tasks Summary</h6>
    <%= render "deals/weekly_summary_tasks", tasks_summary: tasks_summary, deal: @deal %>

    <%# Section 3: Pipeline Charts %>
    <h6 class="fw-bold text-muted mb-3"><i class="ti ti-chart-pie text-primary me-1"></i> 3. Pipeline Overview</h6>
    <%= render "deals/weekly_summary_charts", deal: @deal %>

    <%# AI Insight (if present) %>
    <% if weekly_insight.present? %>
      <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #fffbeb 0%, #fff 100%);">
        <div class="card-body d-flex align-items-start justify-content-between">
          <div class="d-flex align-items-start">
            <i class="ti ti-sparkles text-warning me-3 fs-4 mt-1"></i>
            <div>
              <h6 class="fw-bold mb-1">AI Insight</h6>
              <p class="mb-0"><%= weekly_insight %></p>
            </div>
          </div>
          <span class="badge bg-light text-muted ms-3 text-nowrap"><i class="ti ti-robot me-1"></i>Powered by CapHive AI</span>
        </div>
      </div>
    <% end %>

  <% else %>
    <div class="card">
      <div class="card-body text-center py-5">
        <i class="ti ti-report-analytics text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">No Weekly Summary Available</h5>
        <p class="text-muted mb-0">
          The Deal Management Agent hasn't generated a weekly summary yet.
          <% if policy(@deal).update? %>
            Configure and run it from the
            <%= link_to "Agent Settings", agent_settings_deal_path(@deal) %> tab.
          <% end %>
        </p>
      </div>
    </div>
  <% end %>
</div>
