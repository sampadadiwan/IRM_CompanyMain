<% if policy(deal).show_detail_tabs? %>
<%
  show_deal ||= "Yes"
  show_investors ||= "Yes"
%>
<div class="associated_entity" data-controller="tabs tabdetails">
    <nav class="nav nav-pills nav-justified p-3 mb-3 rounded align-items-center card flex-row"  role="tablist">


      <a class="nav-link active" data-bs-toggle="pill" data-bs-toggle="tab" href="#docs-tab">Documents</a>
      <% if show_deal == "Yes" %>
        <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#deal-tab" id="deal_tab">Deal</a>
      <% end %>

      <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#access-tab">Access Rights</a>

      <% if show_investors == "Yes" %>
        <a  class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#investors-tab" id="deal_investments">Deal Investors</a>
      <% end %>

      <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#reminders-tab">Reminders</a>

      <% if current_user.entity_id == deal.entity_id && deal.entity.support_agents.set?(:deal_management_agent) %>
        <a class="nav-link" data-bs-toggle="pill" data-bs-toggle="tab" href="#ai-agent-tab"><i class="ti ti-robot me-1"></i>AI Agent</a>
      <% end %>

    </nav>



  <div class="tab-content">
      <div id="deal-tab" class="tab-pane fade">
        <div id="deal" class="associated_entity">
          <%= render "/deals/show", deal: deal %>
        </div>
      </div>
      <div id="docs-tab" class="tab-pane fade in show active">
        <div id="docs" class="associated_entity">
            <%= turbo_frame_tag "documents_tree_frame", target: "_top", src: folder_documents_path(entity_id: deal.entity_id, folder_id: deal.document_folder.id), loading: :lazy do %>
              <%= render "/layouts/loading" %>
            <% end %>
        </div>
      </div>

      <div id="investors-tab" class="tab-pane fade">
        <div id="deal_investors" class="associated_entity">
          <%= turbo_frame_tag "deal_investors_frame", target: "_top", src: deal_investors_path(deal_id: deal.id), loading: :lazy do %>
            <%= render "/layouts/loading" %>
          <% end %>
        </div>
      </div>

      <div id="access-tab" class="tab-pane fade">
        <div id="access_rights" class="associated_entity">
          <%= turbo_frame_tag "access_rights_frame", target: "_top", src: access_rights_path(owner_id: deal.id, owner_type: "Deal", form_type: "deals/access_rights_form", entity_id: deal.entity_id, access_type: "Deal"), loading: :lazy do %>
            <%= render "/layouts/loading" %>
          <% end %>
        </div>
      </div>

      <div id="reminders-tab" class="tab-pane fade">
        <div id="reminders" class="associated_entity">
          <%= turbo_frame_tag "reminders_list", target: "_top", src: reminders_path( owner_id: deal.id, owner_type: "Deal", sent: false), loading: :lazy do %>
            <%= render "/layouts/loading" %>
          <% end %>
        </div>
      </div>

      <% if current_user.entity_id == deal.entity_id && deal.entity.support_agents.set?(:deal_management_agent) %>
        <div id="ai-agent-tab" class="tab-pane fade">
          <% deal_agent  = SupportAgent.find_by(entity_id: deal.entity_id, agent_type: "DealManagementAgent", enabled: true) %>
          <% deal_report = SupportAgentReport.find_by(owner: deal, support_agent: deal_agent) %>
          <div class="card mt-3">
            <div class="card-header d-flex align-items-center justify-content-between">
              <strong><i class="ti ti-robot me-1"></i> Deal Management Agent</strong>
              <div class="d-flex align-items-center gap-2">
                <% if deal_report %>
                  <span class="text-muted small">Last run: <%= l(deal_report.updated_at, format: :abbr_date_time) %></span>
                  <%= link_to "Full Report", support_agent_path(deal_agent, tab: "deal_reports"), class: "btn btn-sm btn-outline-secondary", data: { turbo: false } %>
                <% end %>
                <button type="button" class="btn btn-sm btn-primary"
                        data-bs-toggle="modal" data-bs-target="#run-deal-mgmt-agent-modal">
                  <i class="ti ti-robot"></i> Run Now
                </button>
              </div>
            </div>
            <% if deal_report %>
              <% jf          = deal_report.json_fields || {} %>
              <% progress    = jf["progress_issues"]  || [] %>
              <% doc_issues  = jf["document_issues"]  || [] %>
              <% terms       = jf["extracted_terms"]  || {} %>
              <% leaderboard = jf["score_leaderboard"] || [] %>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-md-6">
                    <div class="small text-muted text-uppercase mb-1"><i class="ti ti-activity"></i> Progress</div>
                    <% stagnant_count = progress.count { |i| i["type"] == "stagnant" } %>
                    <% overdue_count  = progress.count { |i| i["type"] == "overdue"  } %>
                    <% if stagnant_count == 0 && overdue_count == 0 %>
                      <span class="text-success small"><i class="ti ti-check"></i> All investors on track</span>
                    <% else %>
                      <% if stagnant_count > 0 %><div class="text-danger small"><i class="ti ti-clock"></i> <%= stagnant_count %> stagnant investor<%= stagnant_count > 1 ? 's' : '' %></div><% end %>
                      <% if overdue_count  > 0 %><div class="text-warning small"><i class="ti ti-calendar-x"></i> <%= overdue_count %> overdue activit<%= overdue_count > 1 ? 'ies' : 'y' %></div><% end %>
                    <% end %>
                  </div>
                  <div class="col-md-6">
                    <div class="small text-muted text-uppercase mb-1"><i class="ti ti-file-check"></i> Documents</div>
                    <% missing_count = doc_issues.count { |i| i["type"] == "missing" } %>
                    <% present_count = doc_issues.count { |i| i["type"] == "present" } %>
                    <% if doc_issues.empty? %>
                      <span class="text-muted small">No checklist configured</span>
                    <% elsif missing_count == 0 %>
                      <span class="text-success small"><i class="ti ti-check"></i> All <%= present_count %> required documents present</span>
                    <% else %>
                      <span class="text-danger small"><i class="ti ti-x"></i> <%= missing_count %> document<%= missing_count > 1 ? 's' : '' %> missing</span>
                    <% end %>
                  </div>
                  <% if terms.any? %>
                    <div class="col-12">
                      <div class="small text-muted text-uppercase mb-1"><i class="ti ti-file-text"></i> Deal Terms</div>
                      <div class="d-flex flex-wrap gap-2">
                        <% terms.compact.first(6).each do |key, value| %>
                          <span class="badge bg-light text-dark border">
                            <span class="text-muted" style="font-size:0.65rem;"><%= key.to_s.humanize %>:</span>
                            <strong><%= value %></strong>
                          </span>
                        <% end %>
                        <% if terms.compact.size > 6 %>
                          <span class="text-muted small align-self-center">+<%= terms.compact.size - 6 %> more → <%= link_to "view all", support_agent_path(deal_agent, tab: "deal_reports"), data: { turbo: false } %></span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                  <% if leaderboard.any? %>
                    <div class="col-12">
                      <div class="small text-muted text-uppercase mb-1"><i class="ti ti-trophy"></i> Investor Scores</div>
                      <div class="d-flex flex-column gap-1">
                        <% leaderboard.first(5).each do |row| %>
                          <% score = (row["ai_score"] || row[:ai_score]).to_i %>
                          <% grade = (row["ai_grade"] || row[:ai_grade]).to_s %>
                          <% bar_class = score >= 80 ? "bg-success" : score >= 60 ? "bg-primary" : score >= 40 ? "bg-warning" : "bg-danger" %>
                          <div class="d-flex align-items-center gap-2">
                            <span class="small" style="width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= row["investor_name"] || row[:investor_name] %></span>
                            <div class="progress flex-grow-1" style="height:6px;"><div class="progress-bar <%= bar_class %>" style="width:<%= score %>%;"></div></div>
                            <span class="small fw-bold" style="width:28px;"><%= score %></span>
                            <span class="badge <%= bar_class %> small" style="width:36px;"><%= grade %></span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% else %>
              <div class="card-body text-muted small">No report yet — click <strong>Run Now</strong> to analyse this deal.</div>
            <% end %>
          </div>

          <% if deal_agent %>
            <%= render "support_agents/agent_run_modal",
                       modal_id:         "run-deal-mgmt-agent-modal",
                       agent_type:       "DealManagementAgent",
                       target_type:      "Deal",
                       target_id:        deal.id,
                       description:      DealManagementAgent::DESCRIPTION,
                       long_description: DealManagementAgent::LONG_DESCRIPTION %>
          <% end %>
        </div>
      <% end %>

  </div>

</div>
<% elsif current_user.curr_role == "investor" %>
<%= render "/deals/deal_investor_details", deal: deal, show_investors: "No" %>
<% end %>
