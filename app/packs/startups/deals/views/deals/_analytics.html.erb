<div class="collapse mb-4" id="dealsAnalytics">
  <div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Deals Analytics</h5>
      <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#dealsAnalytics" aria-label="Close"></button>
    </div>
    <div class="card-body">
      <%= turbo_frame_tag "deals_analytics_frame", src: analytics_deals_path(tag: params[:tag], include_archived: params[:include_archived]), loading: "lazy" do %>
        <div class="d-flex justify-content-center p-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
