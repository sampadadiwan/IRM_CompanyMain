<div class="d-sm-flex align-items-center justify-content-between mb-4 pt-4">
  <h3 class="h3 mb-0 text-gray-600"><%= deal.name %> </h3>
  <span>
    <% if params[:all].blank? %>
      <%= link_to "Clear Filters", deal_path(deal, list_view: true, all: true), class: "btn btn-outline-primary" %>
    <% else %>
      <%= link_to "Not Declined", deal_path(deal, list_view: true), class: "btn btn-outline-primary" %>
    <% end %>
    <%= link_to "Download Excel", deal_path(deal, list_view: true, format: :xlsx), class: "btn btn-outline-primary" %>
    <% if policy(ImportUpload.new(entity: deal.entity, owner: deal)).new? %>
      <%= link_to new_import_upload_path("import_upload[import_type]": "DealInvestor",
                                         "import_upload[owner_id]": deal.id,
                                         "import_upload[owner_type]": "Deal",
                                         sample_upload: "DEAL_INVESTORS_SAMPLE"),
            class: "btn btn-outline-success" do %>
        <i class="ti ti-upload"></i> Import Investors
      <% end %>
    <% end %>
    <% if policy(DealInvestor.new(deal: deal, entity: deal.entity)).new? %>
      <%= link_to "Add #{investor_label}", new_deal_investor_path(deal_investor: { deal_id: deal.id }, turbo_frame: "deal_investor_frame"), class: "btn btn-primary", data: { action: "click->deals-list-ag-grid#addInvestor" } %>
    <% end %>
  </span>
</div>
