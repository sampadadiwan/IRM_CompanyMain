<%# Header bar for the deals list view — title, filter toggle, Weekly Summary link,
    Excel download, and new-deal button.
    @param deal [Deal] the deal record (used for entity-level feature flags) %>
<div class="d-sm-flex align-items-center justify-content-between mb-4 pt-4">
  <div>
    <h3 class="h3 mb-0 text-gray-600"><%= deal.name %></h3>
    <%= render "deals/deal_ingest_address",
               deal: deal,
               ingest_address: @deal_ingest_address %>
  </div>

  <span>
    <% if params[:all].blank? %>
      <%= link_to deal_path(deal, list_view: true, all: true), class: "btn btn-outline-primary" do %>
        <i class="ti ti-filter-off"></i> Clear Filters
      <% end %>
    <% else %>
      <%= link_to deal_path(deal, list_view: true), class: "btn btn-outline-primary" do %>
        <i class="ti ti-filter"></i> Not Declined
      <% end %>
    <% end %>
    <%# Weekly Summary button — moved here from deal_details tabs for quick access %>
    <% if deal.entity.support_agents.set?(:deal_management_agent) %>
      <%= link_to weekly_summary_deal_path(deal), class: "btn btn-outline-primary" do %>
        <i class="ti ti-report-analytics"></i> Weekly Summary
      <% end %>
    <% end %>
    <%= link_to deal_path(deal, list_view: true, format: :xlsx), class: "btn btn-outline-primary" do %>
      <i class="ti ti-file-spreadsheet"></i> Download Excel
    <% end %>
    <% if policy(ImportUpload.new(entity: deal.entity, owner: deal)).new? %>
      <%= link_to new_import_upload_path("import_upload[import_type]": "DealInvestor",
                                         "import_upload[owner_id]": deal.id,
                                         "import_upload[owner_type]": "Deal",
                                         sample_upload: "DEAL_INVESTORS_SAMPLE"),
            class: "btn btn-outline-success" do %>
        <i class="ti ti-upload"></i> Import Investors
      <% end %>
    <% end %>
    <% if policy(DealInvestor.new(deal: deal, entity: deal.entity)).new? %>
      <%= link_to new_deal_investor_path(deal_investor: { deal_id: deal.id }, turbo_frame: "deal_investor_frame"), class: "btn btn-primary", data: { action: "click->deals-list-ag-grid#addInvestor" } do %>
        <i class="ti ti-user-plus"></i> Add <%= investor_label %>
      <% end %>
    <% end %>
  </span>
</div>
