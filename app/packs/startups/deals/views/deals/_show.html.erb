<%= turbo_frame_tag "deal_show", target: "_top" do %>

  <table class="table table-bordered dataTable ">

    <tr>
      <td>
        Entity
      </td>
      <td>
        <%= deal.entity.name %>
      </td>
    </tr>
    <tr>
      <td>
        Name
      </td>
      <td>
        <%= deal.name %>
      </td>
    </tr>
    <tr>
      <td>
        Deal Amount
      </td>
      <td>
        <%= money_to_currency deal.amount, params %>
      </td>
    </tr>
    <tr>
      <td>
        Start Date
      </td>
      <td>
        <%= deal.start_date ? l(deal.start_date) : "Not Started" %>
      </td>
    </tr>
    </tr>
    <tr>
      <td>
        Status
      </td>
      <td>
        <%= deal.status %>
      </td>
    </tr>

    <tr>
      <td>
         Currency
      </td>
      <td>
         <%= deal.currency %>
      </td>
   </tr>

    <tr>
      <td>
         Tags
      </td>
      <td>
         <%= deal.tags %>
      </td>
   </tr>

   <tr>
      <td>
         Card View Attributes
      </td>
      <td>
         <%= deal.card_view_attrs&.map(&:titleize)&.join(", ") %>
      </td>
   </tr>

   <!-- <tr>
      <td>
         Currency Units
      </td>
      <td>
         <%= deal.units %>
      </td>
   </tr> -->

    <tr>
      <td>
        Archived
      </td>
      <td>
        <%= deal.archived ? "Yes" : "No" %>
      </td>
    </tr>


    <%= display_custom_fields(deal) if current_user %>

  </table>

  <% if current_user.entity_id == deal.entity_id %>
    <div class="d-flex align-items-center gap-2 mt-2">
      <%= link_to t_common(:edit), edit_deal_path(deal), class: "btn btn-outline-primary" %>
      <%= button_to t_common(:delete), deal, method: :delete, class: "btn btn-outline-danger", form_class: "deleteButton", data: { action: "click->confirm#popup", turbo: false } %>
      <% if deal.entity.support_agents.set?(:deal_management_agent) %>
        <% deal_agent = SupportAgent.find_by(entity_id: deal.entity_id, agent_type: "DealManagementAgent", enabled: true) %>
        <% if deal_agent %>
          <button type="button" class="btn btn-outline-secondary"
                  data-bs-toggle="modal" data-bs-target="#run-deal-management-agent-modal">
            <i class="ti ti-robot me-1"></i> Run Deal Agent
          </button>
          <%= render "support_agents/agent_run_modal",
                     modal_id:         "run-deal-management-agent-modal",
                     agent_type:       "DealManagementAgent",
                     target_type:      "Deal",
                     target_id:        deal.id,
                     description:      DealManagementAgent::DESCRIPTION,
                     long_description: DealManagementAgent::LONG_DESCRIPTION %>
        <% end %>
      <% end %>
    </div>
    <div id="progress_panel_new" class="mt-3"></div>
  <% end %>


<% end %>
