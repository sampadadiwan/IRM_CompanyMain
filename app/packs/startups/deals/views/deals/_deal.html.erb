<%# One deal in the Deals index grid view: the chosen columns (RansackTableRow), then its View action %>
<tr id="<%= dom_id deal %>">
  <%= render RansackTableRow.new(model: deal, columns:) %>
  <% if actions_column %>
    <td class="action-col">
      <%= link_to t_common(:view), deal_path(deal), {
        class: "btn btn-outline-primary ti ti-eye",
        title: "Show details for #{deal.name}",
        aria: { label: "Show details for #{deal.name}" },
        data: { bs_toggle: "tooltip", bs_title: "Show details for #{deal.name}" }
      } %>
    </td>
  <% end %>
</tr>
