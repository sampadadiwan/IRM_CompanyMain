<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <%= @deal.name %>
    </h1>
</div>

<div class="row">
    <div class="col-lg-12 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Deal Funnel</h6>
            </div>
            <div class="card-body">
                <script src="https://cdnjs.cloudflare.com/ajax/libs/highcharts/11.4.1/highcharts.js"></script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/highcharts/11.4.1/modules/funnel.js"></script>

                <div
                  id="funnel-chart-container"
                  style="width:100%; height:400px;"
                  data-controller="highcharts-funnel"
                  data-highcharts-funnel-data-value="<%= kanban_funnel_data(@deal).to_json %>"
                  data-highcharts-funnel-theme-value="<%= chart_theme_color.to_json %>"
                ></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Potential investments</h6>
            </div>
            <div class="card-body">
                <%= deal_investors_money(@deal) %>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Investor Status</h6>
            </div>
            <div class="card-body">
                <%= deal_investors_status(@deal) %>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Deal Steps</h6>
            </div>
            <div class="card-body">
                <%= deal_activities_completion(@deal) %>
            </div>
        </div>
    </div>
</div>
