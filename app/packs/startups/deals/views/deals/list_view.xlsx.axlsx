wb = xlsx_package.workbook

wb.styles do |style|
  header_style = style.add_style(bg_color: "4472C4", fg_color: "FFFFFF", b: true, alignment: { horizontal: :center, vertical: :center })
  money_style = style.add_style(format_code: '#,##0.00', alignment: { horizontal: :right })
  style.add_style(format_code: '0%', alignment: { horizontal: :center })
  centered_style = style.add_style(alignment: { horizontal: :center })

  # Status Styles
  status_styles = {
    'Active' => style.add_style(fg_color: "008000", b: true),     # Green
    'Pending' => style.add_style(fg_color: "FFA500", b: true),    # Orange
    'Stagnant' => style.add_style(fg_color: "FF0000", b: true),   # Red
    'Closed' => style.add_style(fg_color: "808080", b: true),     # Grey
    'Completed' => style.add_style(fg_color: "008000", b: true),  # Green
    'Complete' => style.add_style(fg_color: "008000", b: true),   # Green
    'Incomplete' => style.add_style(fg_color: "FF0000", b: true), # Red
    'Skip' => style.add_style(fg_color: "808080", b: true)        # Grey
  }

  currency = @deal.currency
  di_headers = [
    "Deal Investor", "Status", "Tags", "Source", "Deal Lead", "Tier",
    "Primary Amount (#{currency})", "Secondary Amount (#{currency})",
    "Pre Money Valuation (#{currency})", "Fee (#{currency})", "Total Amount (#{currency})",
    "Investor Advisor", "Company Advisor", "Notes", "Health Score", "Last Interaction"
  ]

  wb.add_worksheet(name: "Deal Investors") do |sheet|
    sheet.add_row di_headers, style: header_style

    @deal_investors.each do |di|
      sheet.add_row([
        di.investor_name,
        di.status,
        di.tags,
        di.source,
        di.deal_lead,
        di.tier,
        di.primary_amount,
        di.secondary_investment,
        di.pre_money_valuation,
        di.fee,
        di.total_amount,
        di.investor_advisor,
        di.company_advisor,
        di.notes.to_plain_text.presence,
        di.health_score,
        di.last_interaction_date
      ], style: [
        nil,                          # Deal Investor
        status_styles[di.status],     # Status
        nil,                          # Tags
        nil,                          # Source
        nil,                          # Deal Lead
        nil,                          # Tier
        money_style,                  # Primary Amount
        money_style,                  # Secondary Amount
        money_style,                  # Pre Money Valuation
        money_style,                  # Fee
        money_style,                  # Total Amount
        nil,                          # Investor Advisor
        nil,                          # Company Advisor
        nil,                          # Notes
        centered_style,               # Health Score
        centered_style                # Last Interaction
      ])
    end

    sheet.auto_filter = "A1:P1"
    sheet.sheet_view.pane do |pane|
      pane.top_left_cell = 'A2'
      pane.state = :frozen
      pane.y_split = 1
    end
  end

  # ── Deal Steps sheet ──────────────────────────────────────────────────────
  wb.add_worksheet(name: "Deal Steps") do |sheet|
    templates = DealActivity.templates(@deal)
    sheet.add_row(["Deal Investor"] + templates.map(&:title), style: header_style)

    @deal_investors.each do |deal_investor|
      activity_statuses = templates.map do |template|
        activity = deal_investor.deal_activities.find { |a| a.template_id == template.id }
        activity&.status || '-'
      end

      activity_row_styles = activity_statuses.map { |s| status_styles[s] }
      sheet.add_row([deal_investor.investor_name] + activity_statuses,
                    style: [nil] + activity_row_styles)
    end

    sheet.sheet_view.pane do |pane|
      pane.top_left_cell = 'A2'
      pane.state = :frozen
      pane.y_split = 1
    end
  end

  # ── Notes sheet ───────────────────────────────────────────────────────────
  wb.add_worksheet(name: "Notes") do |sheet|
    sheet.add_row(["Deal Investor", "On", "Details", "Tags", "Reminder Emails", "Reminder Date"],
                  style: header_style)

    @notes.each do |note|
      sheet.add_row([
        note.investor_name,
        note.on,
        note.details.to_plain_text,
        note.tags,
        note.reminder&.email,
        note.reminder&.due_date
      ])
    end

    sheet.sheet_view.pane do |pane|
      pane.top_left_cell = 'A2'
      pane.state = :frozen
      pane.y_split = 1
    end
  end
end
