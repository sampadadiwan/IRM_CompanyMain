<%back_to ||= params[:back_to] || nil %>
<%= turbo_frame_tag "new_deal_activity" do %>
  <div id="toasts" aria-live="polite" aria-atomic="true" style="position: relative;"></div>
  <div class="card shadow mb-4">
    <div class="card-header py-3">
      <h6 class="m-0 font-weight-bold text-primary">Deal Step</h6>
    </div>
    <div class="card-body">
      <%= form_with(model: deal_activity, validate: true, data: {turbo: false}) do |form| %>
        <% if deal_activity.errors.any? %>
          <div class="alert alert-danger">
            <h2><%= pluralize(deal_activity.errors.count, "error") %> prohibited this deal_activity from being saved:</h2>
            <ul>
              <% deal_activity.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="form-group">
          <%= form.text_field :deal_id, class: "form-control", hidden: true  %>
          <%= form.text_field :back_to, class: "form-control", hidden: true, name: "back_to", value: params[:back_to] || back_to  %>
        </div>
        <% if deal_activity.deal_investor_id.present? %>
          <div class="form-group">
            <%= form.label :deal_investor_id %>
            <%= form.text_field :deal_investor, class: "form-control", disabled: "disabled", value: deal_activity.investor_name  %>
            <%= form.text_field :deal_investor_id, class: "form-control", hidden: true %>
          </div>
        <% end %>
        <div class="form-group">
          <%= form.label :sequence, "Sequence / Order" %>
          <%= form.number_field :sequence, class: "form-control", min: 1 %>
        </div>
        <div class="form-group">
          <%= form.label :title %>
          <%= form.text_field :title, class: "form-control"  %>
        </div>
        <div class="form-group">
          <%= form.label :details %>
          <%= form.rich_text_area :details, class: "form-control"  %>
        </div>
        <div class="form-group">
          <%= form.label :days %>
          <%= form.number_field :days, class: "form-control"  %>
        </div>
        <%# Tasks CSV field: Allows defining a list of tasks for this step.
            Each segment separated by a comma or newline will become a separate Task record. %>
        <div class="form-group">
          <%= form.label :tasks_csv, "Tasks (one per line or comma-separated)" %>
          <%= form.text_area :tasks_csv, class: "form-control", rows: 5, placeholder: "e.g. Verify ID, Sign NDAs, Review Financials" %>
        </div>
        <div class="form-group d-flex gap-4 mb-3">
          <div class="form-check">
            <%= form.check_box :notify_employees, class: "form-check-input" %>
            <%= form.label :notify_employees, "Notify Employees on Stage Move", class: "form-check-label" %>
          </div>
          <div class="form-check">
            <%= form.check_box :notify_investor, class: "form-check-input" %>
            <%= form.label :notify_investor, "Notify Investor on Stage Move", class: "form-check-label" %>
          </div>
        </div>
        <div class="form-group">
          <%= form.label :status %>
          <% status_options = deal_activity.deal_investor_id.present? ? ["Incomplete", "Complete", "Skip"] : ["Template"] %>
          <%= form.select :status, status_options, {}, class: "form-control" %>
        </div>
        <% if deal_activity.deal_investor_id.present? %>
          <div class="form-group">
            <%= form.label :by_date %>
            <%= form.date_field :by_date, class: "form-control"  %>
          </div>
          <div class="form-group">
            <%= form.label :completed %>
            <%= form.select :completed, ["Yes", "No", "N/A"], {}, class: "form-control"  %>
          </div>
        <% end %>
        <%= render "layouts/multi_upload", form: form, title: "Documents",
                    for_model: "deal_activity" %>
        <div class="form-group">
          <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
