<tr id="<%= dom_id deal_activity %>" class="item">
    <td class="">
        <%= deal_activity.sequence %>
    </td>
    <td>
        <%= link_to(deal_activity.title, deal_activity) %>
    </td>
    <td>
        <%= belongs_to_entity_id?(current_user, deal_activity.entity_id) ?
                link_to(deal_activity.deal_name, deal_activity.deal) : deal_activity.deal_name %>

    </td>
    <td>
        <%= belongs_to_entity_id?(current_user, deal_activity.entity_id) && deal_activity.deal_investor ?
            link_to(deal_activity.investor_name, deal_activity.deal_investor) : deal_activity.investor_name %>
    </td>
    <td>
        <%= l deal_activity.by_date if deal_activity.by_date %>
    </td>
    <td>
        <%= deal_activity.status %>
    </td>
    <td>
        <span class="badge <%= completed_badge(deal_activity) %>">
            <%= deal_activity.completed_status %>
        </span>
    </td>
    <td>
        <%= deal_activity.days %>
    </td>
    <td>
        <%= link_to  t_common(:show), deal_activity, class: "btn btn-outline-primary" %>
        <%= link_to  t_common(:edit), edit_deal_activity_path(deal_activity), class: "btn btn-outline-success" if policy(deal_activity).update? %>
        <% if deal_activity.Template? && policy(deal_activity).destroy? %>
          <% derived_count = deal_activity.derived_activities.count %>
          <% warning_msg = "Delete template \"#{deal_activity.title}\"? This will also delete #{derived_count} linked investor step(s). This action is not reversible." %>
          <%= button_to t_common(:delete), deal_activity_path(deal_activity), method: :delete,
              class: "btn btn-outline-danger", form_class: "deleteButton",
              data: { action: "click->confirm#popup", turbo: false,
                      title: "Delete Step Template",
                      msg: warning_msg,
                      reversible: "no",
                      "other-info": "#{derived_count} investor step(s) will also be permanently deleted." } %>
        <% end %>
    </td>
</tr>