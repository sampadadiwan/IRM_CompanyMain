<%# Company table — one row per company (latest analysis report), filtered by
    the active tier. Expanding a row reuses support_agents/presentation_report_detail
    verbatim — the same panel the investor widget and report tab show — so there
    is no second detail view to maintain. %>
<%= turbo_frame_tag "presentation_table_frame" do %>
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
          <h6 class="fw-bold mb-0">Company Scores</h6>
          <% if status_filter.present? %>
            <span class="badge bg-primary-subtle text-primary">
              <%= presenter.filter_label(status_filter) %>
            </span>
            <%= link_to presentation_dashboard_path_with(status: nil),
                  class: "btn btn-sm btn-outline-secondary", data: { turbo: false } do %>
              <i class="ti ti-x"></i> Clear
            <% end %>
          <% end %>
        </div>

        <div class="d-flex gap-2">
          <%= form_tag presentation_dashboard_path_with(q: nil),
                method: :get, data: { controller: "search", turbo_frame: "presentation_table_frame" },
                class: "d-flex search-form" do %>
            <div class="input-group input-group-sm" style="width: 220px;">
              <span class="input-group-text"><i class="ti ti-search"></i></span>
              <%= text_field_tag "q[investor_investor_name_cont]", search_value,
                    class: "form-control", placeholder: "Search company...",
                    data: { "search-target": "searchInput", action: "keydown->search#debouncedSearchInput" } %>
            </div>
            <%= hidden_field_tag "status", status_filter if status_filter.present? %>
            <%= hidden_field_tag "sector", @sector_filter if @sector_filter.present? %>
            <%= hidden_field_tag "tag", @tag_filter if @tag_filter.present? %>
            <%= hidden_field_tag "sort", @sort %>
            <%= hidden_field_tag "dir", @direction %>
            <%= submit_tag "Submit", hidden: true, data: { target: "search.submit" } %>
          <% end %>
        </div>
      </div>

      <% if reports.none? %>
        <div class="alert alert-secondary mb-0">
          <i class="ti ti-info-circle"></i>
          <% if status_filter.present? %>
            No companies in this bucket.
          <% else %>
            No analysis reports yet. Run the agent to populate the dashboard.
          <% end %>
        </div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-bordered dataTable action_table hover no_hover_table">
            <thead>
              <tr>
                <th>
                  <%= link_to presentation_sort_path("company"), class: "text-decoration-none text-body",
                        data: { turbo_frame: "presentation_table_frame" },
                        "data-bs-toggle": "tooltip", title: presentation_sort_hint("company") do %>
                    Company <%= presentation_sort_caret("company") %>
                  <% end %>
                </th>
                <th>
                  <%= link_to presentation_sort_path("sector"), class: "text-decoration-none text-body",
                        data: { turbo_frame: "presentation_table_frame" },
                        "data-bs-toggle": "tooltip", title: presentation_sort_hint("sector") do %>
                    Sector <%= presentation_sort_caret("sector") %>
                  <% end %>
                </th>
                <th>
                  <%= link_to presentation_sort_path("score"), class: "text-decoration-none text-body",
                        data: { turbo_frame: "presentation_table_frame" },
                        "data-bs-toggle": "tooltip", title: presentation_sort_hint("score") do %>
                    Score &amp; Grade <%= presentation_sort_caret("score") %>
                  <% end %>
                </th>
                <th class="text-center">
                  <%= link_to presentation_sort_path("delta"), class: "text-decoration-none text-body",
                        data: { turbo_frame: "presentation_table_frame" },
                        "data-bs-toggle": "tooltip",
                        title: "Change since this company's previous analysis run. #{presentation_sort_hint('delta')}" do %>
                    Δ <%= presentation_sort_caret("delta") %>
                  <% end %>
                </th>
                <th data-bs-toggle="tooltip" title="Periods this run covered">Periods</th>
                <th data-bs-toggle="tooltip" title="Cross-period flag items across all five lenses">Flags</th>
                <th data-bs-toggle="tooltip" title="Pre-board briefing questions">Questions</th>
                <th>
                  <%= link_to presentation_sort_path("analyzed"), class: "text-decoration-none text-body",
                        data: { turbo_frame: "presentation_table_frame" },
                        "data-bs-toggle": "tooltip", title: presentation_sort_hint("analyzed") do %>
                    Analyzed <%= presentation_sort_caret("analyzed") %>
                  <% end %>
                </th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% reports.each do |report| %>
                <% score = presenter.score_for(report) %>
                <% tier_slug = presenter.tier_for_report(report) %>
                <% color = presenter.color_for_report(report) %>
                <% delta = presenter.delta_for(report) %>
                <tr class="sd-tier--<%= tier_slug || 'not_analyzed' %>">
                  <td>
                    <% if report.owner %>
                      <%= link_to report.owner.investor_name, investor_path(report.owner),
                            class: "fw-semibold text-decoration-none", data: { turbo: false } %>
                    <% else %>
                      <strong><%= presenter.company_name(report) %></strong>
                    <% end %>
                  </td>
                  <td>
                    <% if presenter.sector_for(report).present? %>
                      <%= link_to presentation_dashboard_path_with(sector: presenter.sector_for(report), status: nil),
                            class: "text-decoration-none", data: { turbo: false },
                            "data-bs-toggle": "tooltip",
                            title: "Scope the dashboard to #{presenter.sector_for(report)}" do %>
                        <span class="badge bg-light text-dark border"><%= presenter.sector_for(report) %></span>
                      <% end %>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>

                  <td>
                    <% if score %>
                      <div class="d-flex align-items-center gap-2" style="min-width: 190px;">
                        <div class="progress flex-grow-1" style="height: 8px;"
                             data-bs-toggle="tooltip"
                             title="<%= presenter.label_for(tier_slug) %> — score <%= score %> of 100">
                          <div class="progress-bar bg-<%= color %>" role="progressbar"
                               style="width: <%= score %>%;"
                               aria-valuenow="<%= score %>" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <span class="fw-bold" style="font-variant-numeric: tabular-nums;"><%= score %></span>
                        <% if presenter.grade_for(report).present? %>
                          <span class="badge bg-<%= color %>"
                                data-bs-toggle="tooltip"
                                title="Management Accountability grade">
                            <i class="ti <%= presenter.tier_meta(tier_slug.to_s)[:icon] %>"></i>
                            <%= presenter.grade_for(report) %>
                          </span>
                        <% end %>
                      </div>
                    <% elsif presenter.scoring_disabled?(report) %>
                      <span class="badge bg-light text-muted border"
                            data-bs-toggle="tooltip" title="Scoring is turned off for this agent — this run still produced cross-period flags and briefing questions">
                        <i class="ti ti-power"></i> Scoring Disabled
                      </span>
                    <% else %>
                      <span class="badge bg-danger-subtle text-danger"
                            data-bs-toggle="tooltip" title="This run found nothing usable to analyze">
                        <i class="ti ti-alert-triangle"></i> Not Analyzed
                      </span>
                      <% if presenter.error_for(report) %>
                        <div class="text-danger mt-1"><small><%= presenter.error_for(report) %></small></div>
                      <% end %>
                    <% end %>
                  </td>

                  <td class="text-center">
                    <% if delta.nil? %>
                      <span class="text-muted" data-bs-toggle="tooltip"
                            title="No previous run to compare against">—</span>
                    <% elsif delta.zero? %>
                      <span class="badge bg-light text-muted border" data-bs-toggle="tooltip"
                            title="Same score as the previous run">
                        <i class="ti ti-minus"></i>
                      </span>
                    <% else %>
                      <span class="badge bg-<%= delta.positive? ? 'success' : 'danger' %>-subtle text-<%= delta.positive? ? 'success' : 'danger' %>"
                            style="font-variant-numeric: tabular-nums;"
                            data-bs-toggle="tooltip"
                            title="<%= delta.positive? ? 'Up' : 'Down' %> <%= delta.abs %> points since the previous run">
                        <i class="ti ti-<%= delta.positive? ? 'arrow-up' : 'arrow-down' %>"></i><%= delta.abs %>
                      </span>
                    <% end %>
                  </td>

                  <td class="text-muted"><%= presenter.periods_analyzed_for(report).size %></td>
                  <td class="text-muted"><%= presenter.flags_count_for(report) %></td>
                  <td class="text-muted"><%= presenter.questions_count_for(report) %></td>

                  <td class="text-muted">
                    <%= l(report.created_at, format: :abbr_month_day_year) %>
                    <% if score && presenter.stale?(report) %>
                      <span class="badge bg-warning-subtle text-warning" data-bs-toggle="tooltip"
                            title="Older than <%= presenter.staleness_days %> days — re-run to refresh">Stale</span>
                    <% end %>
                  </td>

                  <td>
                    <% unless presenter.blocked?(report) %>
                      <button type="button" class="btn btn-sm btn-outline-secondary"
                              data-bs-toggle="collapse"
                              data-bs-target="#pres-detail-<%= report.id %>"
                              title="Show the score breakdown, cross-period flags and briefing questions">
                        <i class="ti ti-chevron-down"></i>
                      </button>
                    <% end %>
                  </td>
                </tr>

                <% unless presenter.blocked?(report) %>
                  <%= render "support_agents/presentation_report_detail", report: report, colspan: 9 %>
                <% end %>
              <% end %>
            </tbody>
          </table>

          <% if pagy && pagy.pages > 1 %>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <small class="text-muted"><%= raw pagy_info(pagy) %></small>
              <%= raw pagy_bootstrap_nav(pagy, anchor_string: %(data-turbo-frame="presentation_table_frame" data-remote="true"), params: sticky_presentation_filters.compact) %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if status_filter == PresentationAnalystPresenter::NOT_ANALYZED[:slug] && presenter.unanalyzed_companies.any? %>
        <div class="mt-4">
          <h6 class="fw-bold">Never Analyzed — no report exists</h6>
          <p class="text-muted mb-2">
            <small>These companies have never been run through the agent.</small>
          </p>
          <div class="table-responsive">
            <table class="table table-bordered dataTable action_table hover no_hover_table">
              <thead>
                <tr>
                  <th>Company</th>
                  <th>Sector</th>
                </tr>
              </thead>
              <tbody>
                <% presenter.unanalyzed_companies.each do |company| %>
                  <tr>
                    <td>
                      <%= link_to company[:name], investor_path(company[:id]),
                            class: "text-decoration-none", data: { turbo: false } %>
                    </td>
                    <td class="text-muted"><%= company[:sector].presence || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
