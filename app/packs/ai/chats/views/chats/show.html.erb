<%# A chat about a record (the KPI report Analysis tab opens these) on the chat kit: the record's chats
    beside this one, and the thread in a "chat-thread" frame. New chat opens the full new-chat form.
    @see openspec/changes/ai-chat-kit/design.md (card ① Chat screens) %>
<%= render layout: "ai_chat/layout",
           locals: { rows: @rows, frame: "chat-thread", active_id: @chat.id, root_class: "chat-page",
                     new_url: new_chat_path("chat[owner_id]": @chat.owner_id, "chat[owner_type]": @chat.owner_type),
                     new_frame: "_top", storage_key: "chats.sidebarCollapsed",
                     ids: { new: "chat-new", search: "chat-search", list: "chat-conversations" } } do %>
  <%= turbo_frame_tag "chat-thread", class: "d-flex flex-column h-100", style: "min-height: 0;", data: { turbo_action: "advance" } do %>
    <%= render "chats/thread", chat: @chat, items: @items %>
  <% end %>
<% end %>
