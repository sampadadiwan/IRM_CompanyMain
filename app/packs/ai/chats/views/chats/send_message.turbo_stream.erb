<%# H5 — the question and its pending answer join the thread at once; ChatStreamJob streams the answer into
    chat_response_<request id> and re-renders the box when it ends. %>
<%= turbo_stream.remove "chat-panel-empty" %>
<%= turbo_stream.append "chat-panel-items" do %>
  <%= render "ai_chat/question", item: AiChatItem.transient(dom_id: "chat_question_#{@request_id}", role: "user", content: @query) %>
  <%= render "ai_chat/answer", item: AiChatItem.transient(dom_id: "chat_response_#{@request_id}", role: "assistant", status: :running),
                               mode: :rich %>
<% end %>
<%= turbo_stream.replace "chat-composer" do %>
  <%= render "chats/composer", chat: @chat, running: true %>
<% end %>
