<%# A chat Message drawn by the chat kit (ai_chat/_question, ai_chat/_answer), for any `render message`.
    Message's own broadcasts use it. Local: message (Message). %>
<% item = AiChatItem.from_message(message) %>
<% if item.question? %>
  <%= render "ai_chat/question", item: item %>
<% else %>
  <%= render "ai_chat/answer", item: item, mode: :rich %>
<% end %>
