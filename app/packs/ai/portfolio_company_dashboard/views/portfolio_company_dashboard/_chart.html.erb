<%# Bar chart showing number of companies with missing data per compliance category. %>
<div class="card border-0 shadow-sm h-100">
  <div class="card-body">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h6 class="fw-bold mb-0">Missing by Type</h6>
      <i class="ti ti-info-circle text-muted" data-bs-toggle="tooltip"
         title="Number of companies with blocking issues per compliance category"></i>
    </div>
    <div data-controller="portfolio-dashboard-chart"
         data-portfolio-dashboard-chart-labels-value="<%= presenter.issues_by_type.keys.to_json %>"
         data-portfolio-dashboard-chart-values-value="<%= presenter.issues_by_type.values.to_json %>"
         style="position: relative; height: 280px;">
      <canvas data-portfolio-dashboard-chart-target="canvas"></canvas>
    </div>
    <small class="text-muted mt-2 d-block text-center">
      Number of companies with missing data per category
    </small>
  </div>
</div>
