<%# Footer — recommended next steps and last run timestamp. %>
<div class="row g-4">
  <%# Recommended Next Steps %>
  <div class="col-md-8">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h6 class="fw-bold mb-3">Recommended Next Steps</h6>
        <div class="d-flex flex-column gap-2">
          <% if presenter.overdue_companies.any? %>
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center gap-2">
                <i class="ti ti-mail-forward text-primary"></i>
                <%# Send Now shortcut — mirrors the actions panel Send Reminders button.
                     Shows last-sent date + days-ago below the label and includes
                     the same warning in the confirm dialog to prevent accidental re-sends. %>
                <div>
                  <span>Send reminder to <%= presenter.overdue_companies.size %> overdue companies</span>
                  <%
                    footer_last_sent = presenter.last_reminder_sent_at
                    footer_days_ago = footer_last_sent ? (Date.current - footer_last_sent).to_i : nil
                    footer_confirm = if footer_last_sent
                                       "Last reminders were sent on #{footer_last_sent.strftime('%b %d, %Y')} (#{footer_days_ago} #{'day'.pluralize(footer_days_ago)} ago). Send again to #{presenter.overdue_companies.size} companies?"
                                     else
                                       "Send reminders to #{presenter.overdue_companies.size} overdue companies?"
                                     end
                  %>
                  <% if footer_last_sent %>
                    <br><small class="text-muted">Last sent: <%= footer_last_sent.strftime('%b %d, %Y') %> (<%= footer_days_ago %> <%= 'day'.pluralize(footer_days_ago) %> ago)</small>
                  <% end %>
                </div>
              </div>
              <%= button_to "Send Now", send_reminders_portfolio_company_dashboard_path,
                    method: :post, class: "btn btn-sm btn-primary",
                    data: { confirm: footer_confirm } %>
            </div>
          <% end %>
          <% if presenter.total_issues > 0 %>
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center gap-2">
                <i class="ti ti-checkbox text-warning"></i>
                <span>Review <%= presenter.total_issues %> issues that need attention</span>
              </div>
              <%= link_to "Review", portfolio_company_dashboard_path(status: "issues", anchor: "portfolio_table_frame"),
                    class: "btn btn-sm btn-outline-warning" %>
            </div>
          <% end %>
          <% if presenter.fully_complete > 0 && presenter.fully_complete == presenter.total_companies %>
            <div class="d-flex align-items-center gap-2 text-success">
              <i class="ti ti-circle-check"></i>
              <span>All portfolio companies are fully compliant!</span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Last Run Info %>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <small class="text-muted">
            <i class="ti ti-sparkles"></i>
            AI-powered portfolio compliance monitoring
          </small>
          <% last_report = portfolio_reports&.first %>
          <% if last_report&.updated_at %>
            <br>
            <small class="text-muted">
              Last run: <%= last_report.updated_at.strftime("%b %d, %Y %I:%M %p") %>
            </small>
          <% end %>
        </div>
        <span class="badge bg-success-subtle text-success">
          <i class="ti ti-point-filled"></i> Active
        </span>
      </div>
    </div>
  </div>
</div>
