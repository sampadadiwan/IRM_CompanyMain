<style>
  .card-body .d-flex.flex-column .border.rounded:hover {
    border-color: #4e73df !important;
  }
</style>

<%# Agent action buttons — Run Validation, Send Reminders, and pending companies list.
     - Run Validation: triggers PortfolioCompanyAgent batch run across all portfolio companies.
     - Send Reminders: emails companies with any missing items (KPIs, documents, valuations).
       Each email lists only what's missing. Deduplicates via last_kpi_reminder_sent_at.
     - Overdue Companies: lists top 5 companies with blocking issues sorted by issue count.%>
     
<div class="card border-0 shadow-sm h-100">
  <div class="card-body">
    <h6 class="fw-bold mb-3">Agent Actions</h6>

    <div class="d-flex flex-column gap-2 mb-4">
            <%# Run Validation — triggers run_with_steps with Entity target (batch mode).
           Includes a "Check period" dropdown that lets the FM select which period-end
           date to validate against. "Auto" (default) uses the most recently completed
           period; past period-end dates are shown for historical checks.
           The selected value is passed as check_as_on_date to the agent. %>
      <%
        # Compute the last 4 period-end dates for the dropdown.
        # Uses the agent's due_period setting (Quarterly by default).
        due_period = support_agent.json_fields["due_period"] || "Quarter"
        auto_date = Date.previous_end_of_period(due_period)
        period_options = [auto_date]
        3.times { period_options << Date.previous_end_of_period(due_period, period_options.last) }

        # Build human-readable labels: "Q2 - Jun 30, 2026"
        period_choices = period_options.map do |d|
          quarter_num = ((d.month - 1) / 3) + 1
          label = case due_period.to_s.downcase
                  when "month"   then d.strftime("%B %Y")
                  when "quarter" then "Q#{quarter_num} - #{d.strftime('%b %d, %Y')}"
                  when "half year", "half_year", "halfyear"
                    (d.month <= 6 ? "H1" : "H2") + " - #{d.strftime('%b %d, %Y')}"
                  when "year"    then d.strftime("%Y")
                  else d.to_s
                  end
          [label, d.to_s]
        end
      %>
            <%# Form posts to the dashboard's own run_validation action (not the shared
           support_agents run_with_steps). Passes target_mode + target selections
           alongside check_as_on_date to PortfolioValidationJob.
           Stimulus controller handles panel show/hide and submit validation. %>
      <%= form_with url: run_validation_portfolio_company_dashboard_path,
                    method: :post,
                    class: "border rounded p-3 text-start",
                    style: "transition: border-color 0.2s; cursor: default;",
                    data: { controller: "portfolio-validation-target",
                            portfolio_validation_target_total_count_value: presenter.total_companies } do |f| %>
        <div class="d-flex align-items-center gap-2 mb-2">
          <i class="ti ti-player-play"></i>
          <div>
            <strong>Run Validation</strong><br>
            <small class="text-muted">Check data for completeness</small>
          </div>
        </div>

        <%# Check period dropdown (existing) %>
        <div class="mt-2">
          <label class="form-label small text-muted mb-1">Check period</label>
          <%= f.select :check_as_on_date,
                options_for_select([["Auto (#{period_choices.first[0]})", ""]] + period_choices, ""),
                {},
                class: "form-select form-select-sm" %>
        </div>

        <%# Target selector — controls which companies to validate %>
        <div class="mt-2">
          <label class="form-label small text-muted mb-1">Run on</label>
          <select name="target_mode" class="form-select form-select-sm"
                  data-action="change->portfolio-validation-target#modeChanged">
            <option value="all">All Companies (<%= presenter.total_companies %>)</option>
            <option value="selected">Selected Companies</option>
            <% if tags_for_select.present? %>
              <option value="by_tag">By Tag</option>
            <% end %>
            <% if sectors_for_select.present? %>
              <option value="by_sector">By Sector</option>
            <% end %>
          </select>
        </div>

        <%# Panel: Selected Companies — scrollable checklist of all portfolio companies %>
        <div hidden data-portfolio-validation-target-target="selectedPanel" class="mt-2"
             style="max-height: 180px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 0.5rem;">
          <% portfolio_companies.each do |name, id| %>
            <div class="form-check">
              <input type="checkbox" name="target_ids[]" value="<%= id %>"
                     class="form-check-input" id="target_company_<%= id %>">
              <label class="form-check-label small" for="target_company_<%= id %>"><%= name %></label>
            </div>
          <% end %>
        </div>

        <%# Panel: By Tag — checkboxes for each existing tag across portfolio companies %>
        <% if tags_for_select.present? %>
          <div hidden data-portfolio-validation-target-target="tagPanel" class="mt-2"
               style="max-height: 150px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 0.5rem;">
            <% tags_for_select.each do |tag, count| %>
              <div class="form-check">
                <input type="checkbox" name="target_tags[]" value="<%= tag %>"
                       class="form-check-input" id="target_tag_<%= tag.parameterize %>">
                <label class="form-check-label small" for="target_tag_<%= tag.parameterize %>">
                  <%= tag %> <span class="text-muted">(<%= count %>)</span>
                </label>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# Panel: By Sector — checkboxes for each existing sector across portfolio companies %>
        <% if sectors_for_select.present? %>
          <div hidden data-portfolio-validation-target-target="sectorPanel" class="mt-2"
               style="max-height: 150px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 0.5rem;">
            <% sectors_for_select.each do |sector, count| %>
              <div class="form-check">
                <input type="checkbox" name="target_sectors[]" value="<%= sector %>"
                       class="form-check-input" id="target_sector_<%= sector.parameterize %>">
                <label class="form-check-label small" for="target_sector_<%= sector.parameterize %>">
                  <%= sector %> <span class="text-muted">(<%= count %>)</span>
                </label>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= f.submit "Run", class: "btn btn-primary btn-sm mt-2 w-100",
              data: { action: "click->portfolio-validation-target#validateAndSubmit" } %>
      <% end %>



      <%# Batch progress panel appears here after Run Validation is clicked %>
      <div id="batch_progress_panel"></div>
      
      <%# Send Reminders — sends consolidated reminder emails to overdue companies %>
      <%
        last_sent = presenter.last_reminder_sent_at
        days_ago = last_sent ? (Date.current - last_sent).to_i : nil
        confirm_msg = if last_sent
                        "Last reminders were sent on #{last_sent.strftime('%b %d, %Y')} (#{days_ago} #{'day'.pluralize(days_ago)} ago). Send again to #{presenter.overdue_companies.size} companies?"
                      else
                        "Send reminders to #{presenter.overdue_companies.size} companies with missing submissions?"
                      end
      %>
      <%= button_to send_reminders_portfolio_company_dashboard_path,
            method: :post,
            class: "border rounded p-3 text-start d-flex align-items-center gap-2",
            style: "transition: border-color 0.2s; background: none;",
            disabled: presenter.overdue_companies.empty?,
            data: { confirm: confirm_msg } do %>
        <i class="ti ti-mail-forward"></i>
        <div>
          <strong>Send Reminders</strong><br>
          <small class="text-muted">
            Email <%= presenter.overdue_companies.size %> companies with missing submissions
            <% if last_sent %>
              <br>Last sent: <%= last_sent.strftime('%b %d, %Y') %> (<%= days_ago %> <%= 'day'.pluralize(days_ago) %> ago)
            <% end %>
          </small>
        </div>
      <% end %>



      <%# View Pending Issues — server-side filter %>
      <%= link_to portfolio_company_dashboard_path(status: "issues", anchor: "portfolio_table_frame"),
            class: "border rounded p-3 text-start d-flex align-items-center gap-2",
            style: "transition: border-color 0.2s;",
            data: { turbo: false } do %>
        <i class="ti ti-eye"></i>
        <div>
          <strong>View Pending Issues</strong><br>
          <small class="text-muted">Filter and review all issues</small>
        </div>
      <% end %>
    </div>

    <%# Pending Companies List %>
    <% if presenter.overdue_companies.any? %>
      <h6 class="fw-bold mb-2">Overdue Companies</h6>

      <div class="list-group list-group-flush">
        <% presenter.overdue_companies.first(5).each do |company| %>
          <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
            <div class="d-flex align-items-center gap-2">
              <span class="text-danger"><i class="ti ti-point-filled"></i></span>
              <span><%= company[:name] %></span>
            </div>
            <span class="text-danger small fw-bold">
              <%= company[:issues_count] %> issues
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
  