<%# Agent action buttons — Run Validation, Send Reminders, and pending companies list.
     - Run Validation: triggers PortfolioCompanyAgent batch run across all portfolio companies.
     - Send Reminders: emails only companies with missing KPI reports (not all blocked companies).
       Deduplicates via last_kpi_reminder_sent_at stored in report json_fields.
     - KPI Reminders Due: lists top 5 companies with missing KPIs sorted by issue count.
     - Generate Report: disabled placeholder for Phase 2 quarterly summary feature. %>
<div class="card border-0 shadow-sm h-100">
  <div class="card-body">
    <h6 class="fw-bold mb-3">Agent Actions</h6>

    <div class="d-flex flex-column gap-2 mb-4">
      <%# Run Validation — triggers run_with_steps with Entity target (batch mode) %>
<%= button_to run_with_steps_support_agent_path(support_agent),
      method: :post,
      params: { target_type: "Entity", target_id: support_agent.entity_id },
      class: "btn btn-outline-primary text-start d-flex align-items-center gap-2",
      data: { confirm: "Run validation on all portfolio companies?" } do %>

        <i class="ti ti-player-play"></i>
        <div>
          <strong>Run Validation</strong><br>
          <small class="text-muted">Check all data for completeness</small>
        </div>
      <% end %>

      <%# Batch progress panel appears here after Run Validation is clicked %>
      <div id="batch_progress_panel"></div>

      <%# Send Reminders — sends KPI reminder emails to overdue companies %>
      <%= button_to send_reminders_portfolio_company_dashboard_path,
            method: :post,
            class: "btn btn-outline-info text-start d-flex align-items-center gap-2",
            disabled: presenter.overdue_companies.empty?,
            data: { confirm: "Send KPI reminders to #{presenter.overdue_companies.size} companies with missing KPIs?" } do %>
        <i class="ti ti-mail-forward"></i>
        <div>
          <strong>Send Reminders</strong><br>
          <small class="text-muted">Email <%= presenter.overdue_companies.size %> companies with missing KPIs</small>
        </div>
      <% end %>


      <%# View Pending Issues — server-side filter %>
      <%= link_to portfolio_company_dashboard_path(status: "issues", anchor: "portfolio_table_frame"),
            class: "btn btn-outline-warning text-start d-flex align-items-center gap-2",
            data: { turbo: false } do %>
        <i class="ti ti-eye"></i>
        <div>
          <strong>View Pending Issues</strong><br>
          <small class="text-muted">Filter and review all issues</small>
        </div>
      <% end %>
    </div>

    <%# Pending Companies List %>
    <% if presenter.overdue_companies.any? %>
      <h6 class="fw-bold mb-2">KPI Reminders Due</h6>
      <div class="list-group list-group-flush">
        <% presenter.overdue_companies.first(5).each do |company| %>
          <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
            <div class="d-flex align-items-center gap-2">
              <span class="text-danger"><i class="ti ti-point-filled"></i></span>
              <span><%= company[:name] %></span>
            </div>
            <span class="text-danger small fw-bold">
              <%= company[:issues_count] %> issues
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
