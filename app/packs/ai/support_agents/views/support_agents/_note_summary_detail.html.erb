<% data = (data || {}).with_indifferent_access %>

<div class="row mb-3">
  <div class="col-md-2">
    <small class="text-muted">Report ID:</small><br>
    <strong>#<%= report.id %></strong>
  </div>
  <div class="col-md-3">
    <small class="text-muted">Period:</small><br>
    <strong>
      <% if data[:period_label].present? && data[:period_start].present? %>
        <%= data[:period_label] %>
        (<%= Date.parse(data[:period_start]).strftime("%b %d") %> –
        <%= Date.parse(data[:period_end]).strftime("%b %d, %Y") %>)
      <% else %>
        --
      <% end %>
    </strong>
  </div>
  <div class="col-md-2">
    <small class="text-muted">Notes processed:</small><br>
    <strong><%= data[:note_count] || "--" %></strong>
  </div>
  <div class="col-md-2">
    <small class="text-muted">Status:</small><br>
    <strong><%= (data[:final_status].presence&.titleize) || report.status.to_s.titleize %></strong>
  </div>
  <div class="col-md-3">
    <small class="text-muted">Run at:</small><br>
    <strong>
      <% run_at = data[:run_at].present? ? (Time.zone.parse(data[:run_at]) rescue nil) : nil %>
      <%= run_at ? run_at.strftime("%b %d, %Y %I:%M %p") : "--" %>
    </strong>
  </div>
</div>

<% if data[:summary_text].present? %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <h6 class="card-title mb-3">
        <i class="ti ti-notes text-primary me-1"></i> Summary
      </h6>
      <%# summary_text arrives as plain markdown-style text; render line breaks faithfully %>
      <div class="note-summary-body" style="white-space: pre-wrap; font-size: 0.9rem; line-height: 1.7;">
        <%= data[:summary_text] %>
      </div>
    </div>
  </div>
<% else %>
  <div class="alert alert-secondary">
    <i class="ti ti-info-circle"></i>
    No summary text available — the period may have had no notes, or the LLM call failed.
  </div>
<% end %>

<%# Show auto-tagging outcome if it ran %>
<% tagging_issues = Array(data[:tagging_issues]) %>
<% if tagging_issues.any? %>
  <p class="text-muted small mb-0">
    <i class="ti ti-tag"></i>
    <%= tagging_issues.map { |i| i["message"] || i[:message] }.join(" · ") %>
  </p>
<% end %>
