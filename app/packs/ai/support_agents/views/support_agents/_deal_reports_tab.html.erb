<%
  is_deal_mgmt = local_assigns[:support_agent]&.agent_type == "DealManagementAgent"
  format_amount = ->(cents, curr) {
    cents.present? ? Money.new(cents.to_i, curr).format : "--"
  }
  status_label = {
    "complete"        => "Complete",
    "on_track"        => "On Track",
    "needs_attention" => "Needs Attention",
    "closed"          => "Closed"
  }
  status_color = {
    "complete"        => "green",
    "on_track"        => "#1a73e8",
    "needs_attention" => "red",
    "closed"          => "#888"
  }
%>

<% if deal_reports.empty? %>
  <div class="alert alert-secondary">
    <i class="ti ti-info-circle"></i> No deal reports yet. Run the agent to generate reports.
  </div>
<% elsif is_deal_mgmt %>
  <%# DealManagementAgent — shows issues summary, extracted terms, score leaderboard %>
  <div class="table-responsive mb-4">
    <table class="table table-bordered table-hover">
      <thead class="table-light">
        <tr>
          <th>Deal</th>
          <th>Status</th>
          <th>Issues</th>
          <th>Score</th>
          <th>Terms Extracted</th>
          <th>Last Run</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% deal_reports.each do |report| %>
          <% data    = report.json_fields.with_indifferent_access %>
          <% owner   = report.owner %>
          <%# JSON round-trips turn symbol keys into strings; check both to be safe %>
          <% all_issues     = [*(data["progress_issues"] || []), *(data["document_issues"] || [])] %>
          <% blocking_count = all_issues.count { |i| (i["severity"] || i[:severity]).to_s == "blocking" } %>
          <% warning_count  = all_issues.count { |i| (i["severity"] || i[:severity]).to_s == "warning" } %>
          <% terms_count    = (data["extracted_terms"] || {}).count { |_, v| v.present? } %>
          <% leaderboard    = (data["score_leaderboard"] || []).first(3) %>
          <% status_badge   = report.status == "completed" ? "success" : "danger" %>
          <tr>
            <td><strong><%= owner&.name || "Deal ##{report.owner_id}" %></strong></td>
            <td><span class="badge bg-<%= status_badge %>"><%= report.status %></span></td>
            <td>
              <% if blocking_count > 0 %>
                <span class="text-danger"><%= blocking_count %> blocking</span>
              <% end %>
              <% if warning_count > 0 %>
                <%= ", " if blocking_count > 0 %>
                <span class="text-warning"><%= warning_count %> warning(s)</span>
              <% end %>
              <% if blocking_count == 0 && warning_count == 0 %>
                <span class="text-success">✓ No issues</span>
              <% end %>
            </td>
            <td style="font-size:13px;">
              <% if leaderboard.any? %>
                <%= leaderboard.map { |r| "#{r["investor_name"] || r[:investor_name]}: #{r["ai_score"] || r[:ai_score]}" }.join(", ") %>
              <% else %>
                <span class="text-muted">--</span>
              <% end %>
            </td>
            <td><%= terms_count > 0 ? "#{terms_count} term(s)" : "--" %></td>
            <td style="color:#888; font-size:12px;">
              <%= l(report.updated_at, format: :abbr_date_time) %>
            </td>
            <td class="text-nowrap">
              <% if owner.present? %>
                <%= link_to "View Deal", deal_path(owner), class: "btn btn-sm btn-outline-primary", target: "_top" %>
              <% end %>
              <button type="button" class="btn btn-sm btn-outline-secondary ms-1"
                      data-bs-toggle="collapse"
                      data-bs-target="#deal-mgmt-detail-<%= report.id %>">
                <i class="ti ti-chevron-down"></i> Details
              </button>
            </td>
          </tr>
          <%# Expandable detail row %>
          <tr class="collapse" id="deal-mgmt-detail-<%= report.id %>">
            <td colspan="7" class="bg-light p-0">
              <%= render 'deal_management_report_detail', report: report, data: data %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%# DealsReportAgent — shows deal summary with amounts, fill rate, pipeline stage distribution %>
  <div class="table-responsive mb-4">
    <table class="table table-bordered table-hover">
      <thead class="table-light">
        <tr>
          <th>Deal</th>
          <th>Status</th>
          <th class="text-end">Target</th>
          <th class="text-end">Committed</th>
          <th class="text-end">Fill %</th>
          <th class="text-center">Investors</th>
          <th>Last Run</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% deal_reports.each do |report| %>
          <% data  = report.json_fields.with_indifferent_access %>
          <% ds    = data[:deal_status].to_s %>
          <% curr  = data[:currency] || "INR" %>
          <% fill  = data[:fill_rate].to_f %>
          <tr>
            <td><strong><%= data[:deal_name] %></strong></td>
            <td style="color:<%= status_color[ds] %>; font-weight:bold;">
              <%= status_label[ds] || ds.titleize %>
              <% if data[:stale] %>
                <span class="badge bg-warning text-dark ms-1" title="<%= data[:stale_days] %> days since last activity">Stale</span>
              <% end %>
            </td>
            <td class="text-end"><%= format_amount.call(data[:target_cents], curr) %></td>
            <td class="text-end" style="color:green;">
              <%= format_amount.call(data[:committed_cents], curr) %>
            </td>
            <td class="text-end" style="color:<%= status_color[ds] %>; font-weight:bold;">
              <%= fill %>%
              <div style="background:#eee; border-radius:3px; height:6px; margin-top:3px;">
                <div style="background:<%= status_color[ds] %>; width:<%= [fill, 100].min %>%; height:6px; border-radius:3px;"></div>
              </div>
            </td>
            <td class="text-center" style="font-size:13px;">
              <span class="text-success"><%= data[:active_count] %> active</span> /
              <span class="text-primary"><%= data[:pending_count] %> pending</span> /
              <span class="text-danger"><%= data[:declined_count] %> declined</span>
            </td>
            <td style="color:#888; font-size:12px;">
              <%= l(report.updated_at, format: :abbr_date_time) %>
            </td>
            <td>
              <% deal = report.owner %>
              <% if deal.present? %>
                <%= link_to "View Deal", deal_path(deal), class: "btn btn-sm btn-outline-primary", target: "_top" %>
              <% end %>
            </td>
          </tr>
          <%# Step distribution inline detail %>
          <% step_dist = data[:step_distribution] %>
          <% if step_dist.present? && step_dist.any? %>
            <tr class="table-light">
              <td colspan="8" style="padding:4px 16px; font-size:12px; color:#555;">
                <strong>Pipeline:</strong>
                <% step_dist.each do |step| %>
                  <% step = step.is_a?(Hash) ? step.with_indifferent_access : step %>
                  <span class="me-3">
                    <%= step[:sequence] %>. <%= step[:step_title] %>
                    <span class="badge bg-secondary"><%= step[:investor_count] %></span>
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
