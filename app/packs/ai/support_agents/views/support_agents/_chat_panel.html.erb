<%# The floating agent chat window on the chat kit: the "Need help?" bubble, and a window whose inside
    (support_agents/_chat_window, served by SupportAgentChatsController#index) loads when first opened.
    Locals: support_agent, chattable, content_container_selector (optional).
    @see openspec/changes/ai-chat-kit/design.md (card ① Chat screens, card ⑥ Browser behaviour) %>
<% if support_agent.chat_enabled? %>
  <%# data-turbo-temporary: Turbo strips this element from cached snapshots so the Stimulus controller
      does not double-attach on back-nav, which would otherwise duplicate the chat bubble. Do not remove
      without a replacement fix for the duplicate-bubble issue. %>
  <div class="ai-chat-window" data-controller="ai-chat-window" data-turbo-temporary
       data-ai-chat-window-content-container-value="<%= local_assigns.fetch(:content_container_selector, "").to_s %>">
    <div data-ai-chat-window-target="toggle" data-action="click->ai-chat-window#open" role="button"
         class="aic-window-toggle position-fixed d-flex align-items-center gap-2" title="Chat with <%= support_agent.name %>">
      <div class="bg-white shadow rounded-3 px-3 py-2 small">
        <span class="text-primary">Need help?</span> <span class="text-body-secondary">Ask <%= support_agent.name %></span>
      </div>
      <span class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center aic-window-button">
        <i class="ti ti-message-chatbot fs-4 m-0"></i>
      </span>
    </div>

    <div data-ai-chat-window-target="panel" class="aic-window d-none position-fixed bg-white shadow-lg border rounded-4 overflow-hidden"
         data-action="mousedown->ai-chat-window#startResize mousemove->ai-chat-window#updateCursor">
      <%= turbo_frame_tag agent_chat_frame_id(support_agent), src: agent_chat_url(support_agent, chattable), loading: :lazy,
                                                               class: "d-flex flex-column h-100" do %>
        <div class="p-3"><%= render "ai_chat/pending", text: "Loading…" %></div>
      <% end %>
    </div>
  </div>
<% end %>
