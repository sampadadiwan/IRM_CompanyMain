<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Support Agents</h1>
  <div class="d-flex align-items-center gap-2">
    <%= user_guide_info_icon %>
    <% if policy(:support_agent).llm_keys? %>
      <%= link_to llm_keys_support_agents_path, class: "btn btn-outline-secondary" do %>
        <i class="ti ti-key me-1"></i> LLM Keys
      <% end %>
    <% end %>
    <% if @setup_preview %>
      <button class="btn btn-success"
              type="button"
              data-bs-toggle="modal"
              data-bs-target="#setupAgentsModal">
        <i class="ti ti-wand me-1"></i> Setup All Agents
      </button>
    <% end %>
    <div class="dropdown">
      <button class="btn btn-outline-primary dropdown-toggle" type="button" id="newSupportAgentDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        New Support Agent
      </button>
      <ul class="dropdown-menu" aria-labelledby="newSupportAgentDropdown">
        <% FormType.where(entity_id: current_user.entity_id, name: "SupportAgent").each do |form_type| %>
          <li><%= link_to form_type.tag, new_support_agent_path(support_agent: { form_type_id: form_type.id, agent_type: form_type.tag }), class: "dropdown-item" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

<%# ── Setup All Agents modal ───────────────────────────────────────────────── %>
<% if @setup_preview %>
  <%
    to_create = @setup_preview.select { |r| r[:status] == :create }
    to_change = @setup_preview.select { |r| [:extend, :update].include?(r[:status]) }
    has_work  = to_create.any? || to_change.any?
  %>
  <div class="modal fade" id="setupAgentsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">

        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title">Setup Support Agents</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body pt-2">
          <% if has_work %>
            <p class="text-muted mb-3">The following changes will be made. Existing settings are never overwritten.</p>
            <ul class="list-unstyled mb-0">
              <% to_create.each do |row| %>
                <li class="d-flex align-items-center gap-2 py-1">
                  <i class="ti ti-circle-plus text-success flex-shrink-0"></i>
                  <span><%= row[:name] %></span>
                  <span class="badge bg-success-subtle text-success ms-auto">New</span>
                </li>
              <% end %>
              <% to_change.each do |row| %>
                <li class="d-flex align-items-center gap-2 py-1">
                  <i class="ti ti-refresh text-primary flex-shrink-0"></i>
                  <span><%= row[:name] %></span>
                  <span class="badge bg-primary-subtle text-primary ms-auto">Update</span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted mb-0">All agents are already configured. Running setup again is safe and makes no changes.</p>
          <% end %>
        </div>

        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= button_to has_work ? "Run Setup" : "Run Anyway",
                        setup_support_agents_path,
                        method: :post,
                        class: "btn btn-success",
                        data: { turbo: false } %>
        </div>

      </div>
    </div>
  </div>
<% end %>

<div data-controller="filter-agents">
  <%# ── Search bar ────────────────────────────────────────────── %>
  <div class="input-group mb-4">
    <input type="text"
           data-filter-agents-target="query"
           data-action="input->filter-agents#filter"
           class="form-control border-end-0"
           placeholder="Filter agents by name, category, description…"
           autofocus>
    <span class="input-group-text bg-white border-start-0">
      <i class="ti ti-search text-secondary"></i>
    </span>
    <button class="btn btn-outline-secondary"
            data-action="click->filter-agents#clear"
            data-filter-agents-target="clearButton"
            type="button"
            style="display: none;">
      <i class="ti ti-x"></i>
    </button>
  </div>

  <%
    # Map each predefined category to a color + icon + soft background for the section accent
    category_styles = {
      "Ops"        => { color: "#4f46e5", icon: "ti-settings" },
      "Finance"    => { color: "#059669", icon: "ti-currency-dollar" },
      "Portfolio"  => { color: "#7c3aed", icon: "ti-chart-pie" },
      "Onboarding" => { color: "#0891b2", icon: "ti-user-plus" },
      "Other"      => { color: "#64748b", icon: "ti-dots" }
    }
    uncategorized_style = { color: "#94a3b8", icon: "ti-help" }
    default_style       = { color: "#475569", icon: "ti-tag" }

    category_order = SupportAgent::CATEGORIES

    # Sort: predefined categories in CATEGORIES order → custom values alphabetically → nil last
    sorted_groups = @support_agents.group_by(&:category).sort_by do |cat, _agents|
      if cat.nil?
        [2, "", ""]
      elsif category_order.include?(cat)
        [0, category_order.index(cat), ""]
      else
        [1, cat.to_s.downcase, ""]
      end
    end
  %>

  <% sorted_groups.each do |category, agents| %>
    <%
      label = category.presence || "Uncategorized"
      style = if category.nil?
                uncategorized_style
              elsif category_styles.key?(category)
                category_styles[category]
              else
                default_style
              end
      count = agents.size

      # Dynamic column class so single- and double-card sections fill the row nicely
      col_class = case count
                  when 1 then "col-xl-6 col-lg-8 offset-xl-3 offset-lg-2 mb-4"
                  when 2 then "col-xl-6 col-lg-6 mb-4"
                  else        "col-xl-4 col-lg-6 mb-4"
                  end

      # Subtle section tint so the group reads as a "shelf" with the cards floating on top
      bg_tint = style[:color].then { |c| "#{c}0A" } # ~4% alpha hex
    %>
    <section class="support-agent-category-section mb-5"
             data-filter-agents-target="section"
             style="border-left: 4px solid <%= style[:color] %>; background: <%= bg_tint %>; border-radius: 0 12px 12px 0; padding: 1rem 1.25rem 0.25rem;">
      <header class="d-flex align-items-center gap-2 mb-3 pt-1">
        <h4 class="h5 mb-0 d-flex align-items-center gap-2" style="color: <%= style[:color] %>;">
          <i class="ti <%= style[:icon] %>"></i>
          <%= label %>
        </h4>
        <span class="badge rounded-pill" style="background: <%= style[:color] %>; color: #fff;"><%= count %></span>
      </header>

      <div class="row g-4" style="align-items: flex-start;">
        <% agents.each do |support_agent| %>
          <%= render "support_agent_card", support_agent: support_agent, col_class: col_class %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ── No results message ────────────────────────────────────────── %>
  <div data-filter-agents-target="noResults" class="d-none text-center py-5">
    <i class="ti ti-search-off" style="font-size: 2.5rem; color: #94a3b8;"></i>
    <p class="mt-3 text-secondary fs-5">No agents match your filter</p>
  </div>
</div>