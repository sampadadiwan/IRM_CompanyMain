<%
  guide_icon = user_guide_icon_for(@support_agent.agent_type, tooltip: "#{@support_agent.name} User Guide")
  agent_title = "<span class='d-flex align-items-center gap-2'>#{@support_agent} #{guide_icon}</span>"
%>
<%= render FormCard.new(title: agent_title) do %>
<% active_tab = params[:tab].presence || 'general' %>

  <div class="associated_entity" data-controller="tabs">
    <%# Tab Navigation %>
    <nav class="nav nav-pills nav-justified p-3 mb-3 rounded align-items-center card flex-row" role="tablist">
      <a class="nav-link <%= 'active' if active_tab == 'general' %>"  data-bs-toggle="pill" href="#general-tab">
        General
      </a>
      <a class="nav-link <%= 'active' if active_tab == 'schedule' %>" data-bs-toggle="pill" href="#schedule-tab">
        Schedule
      </a>
      <a class="nav-link <%= 'active' if active_tab == 'execution_history' %>" data-bs-toggle="pill" href="#execution-history-tab">
        Execution History
      </a>
      <% if @support_agent.agent_type == "CashFlowAssistantAgent" %>
        <a class="nav-link <%= 'active' if active_tab == 'fund_reports' %>" data-bs-toggle="pill" href="#fund-reports-tab">
          Fund Reports
        </a>
      <% end %>
      <% if @support_agent.agent_type == "PortfolioCompanyAgent" %>
        <a class="nav-link <%= 'active' if active_tab == 'portfolio_reports' %>" data-bs-toggle="pill" href="#portfolio-reports-tab">
          Portfolio Agent Reports
        </a>
      <% end %>
      <% if @support_agent.agent_type == "PortfolioScoringAgent" %>
        <a class="nav-link <%= 'active' if active_tab == 'scoring_reports' %>" data-bs-toggle="pill" href="#scoring-reports-tab">
          Scoring Reports
        </a>
      <% end %>      <% if @support_agent.agent_type == "DealsReportAgent" %>
        <a class="nav-link <%= 'active' if active_tab == 'deal_reports' %>" data-bs-toggle="pill" href="#deal-reports-tab">
          Deal Reports
        </a>
      <% end %>
      <% if @support_agent.agent_type == "NoteSummarizerAgent" %>
        <a class="nav-link <%= 'active' if active_tab == 'note_summaries' %>" data-bs-toggle="pill" href="#note-summaries-tab">
          Note Summaries
        </a>
      <% end %>
      <% if @support_agent.agent_type == "DealManagementAgent" %>
        <a class="nav-link <%= 'active' if active_tab == 'deal_reports' %>" data-bs-toggle="pill" href="#deal-reports-tab">
          Deal Reports
        </a>
      <% end %>
      <% if @support_agent.agent_type == "PresentationAnalystAgent" %>
        <a class="nav-link <%= 'active' if active_tab == 'presentation_reports' %>" data-bs-toggle="pill" href="#presentation-reports-tab">
          Presentation Reports
        </a>
      <% end %>
      <% if @support_agent.agent_type == "RtaReconciliationAgent" %>
        <a class="nav-link <%= 'active' if active_tab == 'rta_reports' %>" data-bs-toggle="pill" href="#rta-reports-tab">
          Reconciliation History
        </a>
      <% end %>

    </nav>

    <%# Tab Content %>
    <div class="tab-content">
      <%# General Tab %>
      <div id="general-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'general' %>">
        <%= render 'general_tab', support_agent: @support_agent %>
      </div>

      <%# Schedule Tab %>
      <div id="schedule-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'schedule' %>">
        <%= render 'schedule_tab', support_agent: @support_agent, agent_schedule: @agent_schedule %>
      </div>

      <%# Execution History Tab %>
      <div id="execution-history-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'execution_history' %>">
        <%= render 'execution_history_tab', support_agent: @support_agent, execution_logs: @execution_logs, agent_schedule: @agent_schedule %>
      </div>

      <% if @support_agent.agent_type == "CashFlowAssistantAgent" %>
        <%# Fund Reports Tab %>
        <div id="fund-reports-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'fund_reports' %>">
          <%= render 'fund_reports_tab', support_agent: @support_agent, fund_reports: @fund_reports %>
        </div>
      <% end %>

      <% if @support_agent.agent_type == "PortfolioCompanyAgent" %>
        <%# Portfolio Agent Reports Tab %>
        <div id="portfolio-reports-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'portfolio_reports' %>">
          <%= render 'portfolio_reports_tab',
            support_agent: @support_agent,
            portfolio_reports: @portfolio_reports,
            portfolio_presenter: @portfolio_presenter,
            paginated_portfolio_reports: @paginated_portfolio_reports,
            pagy_portfolio: @pagy_portfolio,
            portfolio_status_filter: @portfolio_status_filter,
            portfolio_search_value: @portfolio_search_value %>

        </div>
      <% end %>

      <% if @support_agent.agent_type == "PortfolioScoringAgent" %>
        <%# Scoring Reports Tab %>
        <div id="scoring-reports-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'scoring_reports' %>">
          <%= render 'scoring_reports_tab', support_agent: @support_agent, scoring_reports: @scoring_reports %>
        </div>
      <% end %>
      <% if @support_agent.agent_type == "DealsReportAgent" %>
        <%# Deal Reports Tab %>
        <div id="deal-reports-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'deal_reports' %>">
          <%= render 'deal_reports_tab', support_agent: @support_agent, deal_reports: @deal_reports %>
        </div>
      <% end %>


      <% if @support_agent.agent_type == "NoteSummarizerAgent" %>
        <%# Note Summaries Tab %>
        <div id="note-summaries-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'note_summaries' %>">
          <%= render 'note_summaries_tab', support_agent: @support_agent, note_summaries: @note_summaries %>
        </div>
      <% end %>
      <% if @support_agent.agent_type == "PresentationAnalystAgent" %>
        <div id="presentation-reports-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'presentation_reports' %>">
          <%= render 'presentation_reports_tab', support_agent: @support_agent, presentation_reports: @presentation_reports %>
        </div>
      <% end %>

      <% if @support_agent.agent_type == "RtaReconciliationAgent" %>
        <div id="rta-reports-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'rta_reports' %>">
          <%= render 'rta_reconciliation_reports_tab', support_agent: @support_agent, rta_reports: @rta_reports %>
        </div>
      <% end %>

      <% if @support_agent.agent_type == "DealManagementAgent" %>
        <%# Deal Reports Tab %>
        <div id="deal-reports-tab" class="tab-pane fade in <%= 'show active' if active_tab == 'deal_reports' %>">
          <% if @filtered_deal %>
            <div class="d-flex align-items-center gap-2 mt-2 mb-1">
              <%= link_to deal_path(@filtered_deal, anchor: "ai-agent-tab"),
                    class: "btn btn-sm btn-outline-secondary", data: { turbo: false } do %>
                <i class="ti ti-arrow-left me-1"></i> Back to <%= @filtered_deal.name %>
              <% end %>
              <span class="text-muted" style="font-size:0.85rem;">
                All runs for <strong><%= @filtered_deal.name %></strong>
              </span>
            </div>
          <% end %>
          <%= render 'deal_reports_tab', support_agent: @support_agent, deal_reports: @deal_reports, pagy: @pagy_deal_reports %>
        </div>
      <% end %>

    </div>
  </div>

<% end %>


<%= render "support_agents/chat_panel", support_agent: @support_agent, chattable: @support_agent %>

