<%# frozen_string_literal: true %>
<%#
  RemittanceReconciliationAgent run modal with bank statement (xlsx) upload.
  Same "Immediate Actions" layout as documents/_fix_me and investor_kycs/_request_updates_modal:
  an intro callout, tinted action-summary cards spelling out every consequence, then the input
  the run needs, then Cancel / Confirm.
  Required locals: modal_id, capital_call
  Optional locals: support_agent (used to reflect the current auto_apply_exact setting)
%>

<% auto_apply = local_assigns[:support_agent]&.json_fields&.dig("auto_apply_exact").to_s.casecmp("yes").zero? %>

<div class="modal fade" id="<%= modal_id %>" tabindex="-1" aria-labelledby="<%= modal_id %>Label" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="<%= modal_id %>Label">
          <i class="ti ti-file-check me-2"></i>Run Remittance Reconciliation
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: run_support_agents_path, method: :post, multipart: true,
                    data: { controller: "modal-form", action: "turbo:submit-end->modal-form#close" } do |f| %>
        <%= f.hidden_field :agent_type, value: "RemittanceReconciliationAgent" %>
        <%= f.hidden_field :target_type, value: "CapitalCall" %>
        <%= f.hidden_field :target_id,   value: capital_call.id %>

        <div class="modal-body">
          <div class="action-summary__intro">
            <div class="fw-bold text-dark">Immediate Actions</div>
            <div class="text-muted">The following will happen when you click <strong>Run Reconciliation</strong>:</div>
          </div>

          <div class="action-summary__list">
            <div class="action-summary__item action-summary__item--blue">
              <span class="action-summary__icon"><i class="ti ti-search"></i></span>
              <div>
                <div class="action-summary__title">Every deposit narration is parsed and matched</div>
                <div class="action-summary__desc">
                  Each deposit row in the statement is read through a bank-specific parser to pull out
                  the depositor's name and account number, then matched against the outstanding
                  remittances on <strong><%= capital_call.name %></strong> only — never against other calls.
                </div>
              </div>
            </div>

            <div class="action-summary__item action-summary__item--green">
              <span class="action-summary__icon"><i class="ti ti-shield-check"></i></span>
              <div>
                <div class="action-summary__title">Matches are proposed, not recorded</div>
                <div class="action-summary__desc">
                  Results are tagged Matched, Likely match, Needs review, No match, or Internal.
                  Nothing is written to a remittance until you confirm or reassign a row yourself in
                  the results panel afterwards.
                </div>
              </div>
            </div>

            <div class="action-summary__item action-summary__item--<%= auto_apply ? 'amber' : 'grey' %>">
              <span class="action-summary__icon"><i class="ti ti-bolt"></i></span>
              <div>
                <div class="action-summary__title">
                  Auto-apply exact matches is currently <%= auto_apply ? "ON" : "OFF" %>
                </div>
                <div class="action-summary__desc">
                  <% if auto_apply %>
                    Matched deposits (account number confirmed against KYC or the assigned virtual
                    account) automatically create a payment. Re-running the same statement never
                    creates a duplicate.
                  <% else %>
                    Every match — including Matched — waits for you to confirm it manually. Turn
                    this on in the agent's settings if you want Matched deposits to record automatically.
                  <% end %>
                </div>
              </div>
            </div>

            <div class="action-summary__item action-summary__item--purple">
              <span class="action-summary__icon"><i class="ti ti-bell"></i></span>
              <div>
                <div class="action-summary__title">Runs in the background</div>
                <div class="action-summary__desc">
                  Depending on the size of the statement this can take anywhere from a few seconds to
                  a couple of minutes. Results appear in the Remittance Reconciliation panel on this
                  page once the run completes.
                </div>
              </div>
            </div>

            <div class="action-summary__item action-summary__item--red">
              <span class="action-summary__icon"><i class="ti ti-alert-triangle"></i></span>
              <div>
                <div class="action-summary__title">Always review before confirming</div>
                <div class="action-summary__desc">
                  A matched account number that contradicts the investor's KYC record is flagged as a
                  discrepancy, not silently accepted — verify source of funds yourself before confirming.
                </div>
              </div>
            </div>
          </div>

          <hr class="my-3">

          <div class="mb-1">
            <label class="form-label fw-semibold" for="bank_statement_upload">
              Bank Statement (xlsx) <span class="text-danger">*</span>
            </label>
            <small class="text-muted d-block mb-2">
              Upload the bank statement covering this call's due window — one workbook, one sheet per
              bank account (e.g. ICICI and Axis in the same file) is fine.
            </small>
            <%= f.file_field :bank_statement, id: "bank_statement_upload",
                             accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                             class: "form-control", required: true %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Run Reconciliation", class: "btn btn-outline-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
