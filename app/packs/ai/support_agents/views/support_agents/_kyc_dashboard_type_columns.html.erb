<%# KYC Dashboard two-column layout — Individual and Non-Individual side by side.
    Each column shows its own stat cards (clickable, filter the table) plus a
    half-donut chart. Top failure reasons sits full-width below both columns.
    Stat card clicks pass both status and kyc_type to the Stimulus controller.
    Locals: type_stats (Hash with :individual, :non_individual — each has
            :validated, :pending, :successful, :failed, :partial, :expired),
            top_failures (Array of failure hashes),
            support_agent (SupportAgent) %>
<%
  card_defs = [
    { key: "validated",  label: "Total KYCs",         color: "primary",   icon: "clipboard-check" },
    { key: "pending",    label: "Pending",             color: "secondary", icon: "clock" },
    { key: "successful", label: "Successful",          color: "success",   icon: "circle-check" },
    { key: "failed",     label: "Failed",              color: "danger",    icon: "circle-x" },
    { key: "partial",    label: "Partially Failed",    color: "warning",   icon: "alert-triangle" },
    { key: "expired",    label: "Expired",             color: "dark",      icon: "calendar-off" }
  ]

  chart_colors = { "Successful" => "#198754", "Failed" => "#dc3545",
                   "Partially Failed" => "#ffc107", "Expired" => "#6c757d" }

  columns = [
    { key: :individual,     label: "Individual KYCs",     sti_type: "IndividualKyc" },
    { key: :non_individual, label: "Non-Individual KYCs", sti_type: "NonIndividualKyc" }
  ]
%>

<div class="row g-3 mb-4" data-kyc-dashboard-filter-target="statsRow">
  <% columns.each do |col| %>
    <% stats = type_stats[col[:key]] %>
    <% total = [stats[:validated], 1].max %>

    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-header py-2"><strong><%= col[:label] %></strong></div>
        <div class="card-body pb-2">

          <%# Stat cards — two rows of 3 cards each %>
          <div class="row g-2 mb-3">
            <% card_defs.each do |cd| %>
              <% count = stats[cd[:key].to_sym] %>
              <% pct = ((count.to_f / total) * 100).round(1) %>
              <div class="col-4 d-flex">
                <div class="card m-0 border-top stat-card-accent border-<%= cd[:color] %> shadow-sm flex-fill cursor-pointer"
                     data-action="click->kyc-dashboard-filter#filterByCard"
                     data-kyc-dashboard-filter-status-param="<%= cd[:key] %>"
                     data-kyc-dashboard-filter-kyc-type-param="<%= col[:sti_type] %>"
                     data-kyc-dashboard-filter-target="statCard"
                     data-status="<%= cd[:key] %>"
                     data-kyc-type="<%= col[:sti_type] %>">
                  <div class="card-body py-2 px-3">
                    <h3 class="fs-5 fw-normal mb-0"><%= count %></h3>
                    <span class="card-subtitle mb-0 text-<%= cd[:color] %> small"><%= cd[:label] %></span>
                    <div class="small text-muted"><%= pct %>%</div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <%# Half-donut chart — filter out zero-value entries so Highcharts
              color array stays aligned with the rendered slices. %>
          <%
            chart_entries = [
              ["Successful",       stats[:successful]],
              ["Failed",           stats[:failed]],
              ["Partially Failed", stats[:partial]],
              ["Expired",          stats[:expired]]
            ].select { |_, v| v.to_i > 0 }
            chart_total = chart_entries.sum(&:last)
            chart_active_colors = chart_entries.map { |label, _| chart_colors[label] }
          %>
          <% if chart_total > 0 %>
            <div style="height: 140px; overflow: hidden;">
              <div style="height: 280px;">
                <%= pie_chart(chart_entries.to_h,
                      donut: true, colors: chart_active_colors,
                      legend: false, library: {
                        plugins: { legend: { display: false } },
                        exporting: { enabled: false },
                        plotOptions: { pie: { startAngle: -90, endAngle: 90 } }
                      }) %>
              </div>
            </div>
            <div class="d-flex justify-content-center gap-3 mt-1 small">
              <% chart_colors.each do |label, color| %>
                <span><span style="color: <%= color %>;">&#9679;</span> <%= label %></span>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted text-center my-3">No agent runs yet</p>
          <% end %>

        </div>
      </div>
    </div>
  <% end %>
</div>

<%# Top Failure Reasons — full width below both columns %>
<div class="row mb-4">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-header py-2"><strong>Top Failure Reasons</strong></div>
      <div class="card-body p-0">
        <% if top_failures.any? %>
          <table class="table table-sm table-hover mb-0">
            <thead>
              <tr class="small text-muted">
                <th class="ps-3" style="width: 30px;">#</th>
                <th>Failure Reason</th>
                <th class="text-end pe-3" style="width: 50px;">Count</th>
              </tr>
            </thead>
            <tbody>
              <% top_failures.each_with_index do |failure, idx| %>
                <tr>
                  <td colspan="3" class="p-0 border-0">
                    <a href="#failure-detail-<%= idx %>"
                       class="d-flex align-items-center text-decoration-none text-body px-3 py-2"
                       style="cursor: pointer;"
                       data-bs-toggle="collapse"
                       role="button"
                       aria-expanded="false"
                       aria-controls="failure-detail-<%= idx %>">
                      <span class="text-muted me-3" style="min-width: 16px;"><%= idx + 1 %>.</span>
                      <span class="flex-grow-1"><%= failure[:message] %></span>
                      <span class="badge rounded-pill bg-danger ms-2"><%= failure[:count] %></span>
                      <i class="ti ti-chevron-down ms-2 text-muted" style="font-size: 14px; transition: transform 0.2s;"></i>
                    </a>
                    <div class="collapse" id="failure-detail-<%= idx %>">
                      <div class="px-3 pb-3" style="padding-left: 2.5rem !important;">
                        <div class="d-flex flex-wrap gap-1">
                          <% failure[:affected].each do |inv| %>
                            <%= link_to investor_kyc_path(inv[:kyc_id]),
                                class: "text-decoration-none" do %>
                              <span class="badge border text-primary bg-primary bg-opacity-10"
                                    style="font-weight: 500; font-size: 0.75rem;">
                                <i class="ti ti-user me-1" style="font-size: 11px;"></i><%= inv[:kyc_name] %>
                              </span>
                            <% end %>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-muted mb-0 p-3">No failures found</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
