<%= render FormCard.new(title: "Support Agents : #{support_agent.presence || 'New'}") do %>
  <%= form_with(model: support_agent, validate: true) do |form| %>
    <% if support_agent.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(support_agent.errors.count, "error") %> prohibited this support_agent from being saved:</h2>
        <ul>
          <% support_agent.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="form-group">
      <%= form.label :name %>
      <%= form.text_field :name, class: "form-control"  %>
    </div>
    <div class="form-group">
      <%= form.label :description %>
      <%= form.text_field :description, class: "form-control"  %>
    </div>

    <div class="form-group" data-controller="otherselect" data-otherselect-select-id-value="#support_agent_category">
      <%= form.label :category %>
      <%= form.select :category, SupportAgent::CATEGORIES, { include_blank: true },
           class: "form-control",
           id: "support_agent_category",
           data: { action: "change->otherselect#checkOtherName" } %>
      <%= form.text_field :category, class: "form-control", disabled: true, id: "other_name", hidden: true %>
    </div>

    <%= form.hidden_field :form_type_id, value: support_agent.form_type_id %>
    <%= form.hidden_field :agent_type, value: support_agent.agent_type %>

    <%= custom_form_fields(@support_agent, form) %>

    <% if support_agent.agent_type == "CashFlowAssistantAgent" %>
      <%= render "support_agents/cash_flow_config", support_agent: support_agent, form: form %>
    <% end %>

    <% if support_agent.agent_type == "KycDocExtractorAgent" %>
      <%= render "support_agents/kyc_doc_extractor_config", support_agent: support_agent, form: form %>
    <% end %>
    <% if support_agent.agent_type == "DealManagementAgent" %>
      <%= render "support_agents/deal_management_config", support_agent: support_agent, form: form %>
    <% end %>

    


    <div class="form-group">
      <%= form.label :enabled %>
      <%= form.check_box :enabled, class: "form-check-input" %>
    </div>

    <%# "Enable on Demand Run" (with_steps) checkbox removed — replaced by NON_RUNNABLE_TYPES check in _general_tab %>
    <div class="form-group">
      <%= label_tag "chat_enabled", "Enable Chat Assistant" %>
      <%= check_box_tag "chat_config[enabled]", "true", support_agent.chat_enabled?, class: "form-check-input", id: "chat_enabled" %>
    </div>

    <div class="form-group">
      <%= form.label :llm_model, "AI Model" %>
      <% available_models = support_agent.entity.entity_setting.available_llm_models %>
      <% if available_models.empty? %>
        <div class="alert alert-danger mb-1">
          <strong>No AI provider API keys configured.</strong>
          Go to <strong>Entity Settings</strong> and add an OpenAI, Anthropic, or Gemini API key before setting up a support agent.
        </div>
      <% else %>
        <%= form.select :llm_model,
              grouped_options_for_select(available_models, support_agent.llm_model),
              { prompt: "— Select a model —" },
              { class: "form-control", required: true } %>
      <% end %>
    </div>

    <div class="form-group">
      <%= form.submit t_common(:save), {class: "btn btn-outline-primary"}%>
    </div>
  <% end %>
<% end %>