<% if scoring_reports.empty? %>
  <div class="alert alert-secondary">
    <i class="ti ti-info-circle"></i> No scoring reports yet. Run the agent on a portfolio company to generate a score.
  </div>
<% else %>
  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>Portfolio Company</th>
          <th>Sector</th>
          <th>Score</th>
          <th>Grade</th>
          <th>Status</th>
          <th>Scored At</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% scoring_reports.each do |report| %>
          <% score  = report.json_fields["score"] || {} %>
          <% overall = score["overall_score"].to_i %>
          <% grade   = score["grade"].to_s %>
          <% sector  = report.json_fields["sector"].presence || report.owner&.sector %>
          <% bar_class = case overall
                         when 80..100 then "bg-success"
                         when 60..79  then "bg-primary"
                         when 40..59  then "bg-warning"
                         else              "bg-danger"
                         end %>
          <tr>
            <td>
              <% if report.owner %>
                <%= link_to report.owner.investor_name, investor_path(report.owner), data: { turbo: false } %>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <td><%= sector %></td>
            <td>
              <% if score.present? && report.status.to_s == "completed" %>
                <div class="d-flex align-items-center gap-2" style="min-width: 120px;">
                  <div class="progress flex-grow-1" style="height: 8px;">
                    <div class="progress-bar <%= bar_class %>" role="progressbar"
                         style="width: <%= overall %>%;"
                         aria-valuenow="<%= overall %>" aria-valuemin="0" aria-valuemax="100"></div>
                  </div>
                  <span class="fw-bold small"><%= overall %></span>
                </div>
              <% else %>
                <span class="text-muted small">—</span>
              <% end %>
            </td>
            <td>
              <% if grade.present? %>
                <span class="badge fs-6 px-2 py-1 <%= bar_class %>"><%= grade %></span>
              <% end %>
            </td>
            <td>
              <% if report.status.to_s == "completed" %>
                <span class="badge bg-success">Completed</span>
              <% elsif report.status.to_s == "failed" %>
                <span class="badge bg-danger">Failed</span>
              <% else %>
                <span class="badge bg-secondary"><%= report.status.to_s.titleize %></span>
              <% end %>
            </td>
            <td class="text-muted small"><%= report.created_at.strftime("%d %b %Y, %H:%M") %></td>
            <td>
              <button type="button" class="btn btn-sm btn-outline-secondary"
                      data-bs-toggle="collapse"
                      data-bs-target="#score-detail-<%= report.id %>">
                <i class="ti ti-chevron-down"></i>
              </button>
            </td>
          </tr>
          <tr class="collapse" id="score-detail-<%= report.id %>">
            <td colspan="7" class="bg-light p-0">
              <% if report.status.to_s == "completed" && score.present? %>
                <% can_run  = report.owner.present? && policy(report.owner).update? %>
              <% can_edit = report.owner.present? && policy(report.owner).update? %>
                <%= render "investors/widgets/score_display",
                           report:        report,
                           scoring_agent: support_agent,
                           investor:      report.owner,
                           can_run:       can_run,
                           can_edit:      can_edit %>
              <% else %>
                <div class="p-3">
                  <span class="text-danger small"><%= report.json_fields["error"] %></span>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="text-muted small">
    <i class="ti ti-calendar"></i>
    Last run: <%= scoring_reports.first&.created_at&.strftime("%d %b %Y at %H:%M") %>
  </p>
<% end %>
