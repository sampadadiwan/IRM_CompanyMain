<%# Progress bar - Locals: report (SupportAgentReport) %>
<%
  percentage = report&.progress_percentage || 0
  completed = report&.completed_steps_count || 0
  total = report&.steps&.size || 0

  bar_color = case report&.final_status
              when "ready" then "bg-success"
              when "blocked" then "bg-danger"
              when "cancelled" then "bg-secondary"
              else "bg-primary"
              end
%>
<div id="progress_bar_<%= report&.id %>">
  <div class="d-flex align-items-center mb-1 gap-2">
    <span class="small text-muted"><%= completed %> of <%= total %> steps</span>
    <% if percentage == 100 %>
      <span class="badge bg-success" style="font-size: 11px;">100% Complete</span>
    <% end %>
  </div>
  <div class="progress" style="height: 10px; border-radius: 6px;">
    <div class="progress-bar <%= bar_color %> <%= 'progress-bar-striped progress-bar-animated' if report&.running? %>"
         role="progressbar"
         style="width: <%= percentage %>%; border-radius: 6px;"
         aria-valuenow="<%= percentage %>"
         aria-valuemin="0"
         aria-valuemax="100">
    </div>
  </div>
</div>
