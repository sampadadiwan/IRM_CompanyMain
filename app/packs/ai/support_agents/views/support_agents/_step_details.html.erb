<%# Step details - Locals: step (Hash) %>
<%
  status = step["status"]
  border_color = case status
                 when "success" then "border-success"
                 when "failed" then "border-danger"
                 else "border-primary"
                 end
%>
<div class="alert <%= border_color %> border-start border-4 py-2" id="step_details_<%= step['step'] %>">
  <div class="d-flex justify-content-between align-items-start">
    <div class="flex-grow-1">
      <strong><%= step["label"] %></strong>
      <% if step["message"].present? %>
        <p class="mb-2 small"><%= step["message"] %></p>
      <% end %>
      
      <% if step["failed_records"].present? %>
        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
          <table class="table table-sm table-hover mb-0 small">
            <thead class="table-light sticky-top">
              <tr>
                <th style="width: 5%">#</th>
                <th style="width: 50%">Name</th>
                <th style="width: 45%">Issue</th>
              </tr>
            </thead>
            <tbody>
              <% step["failed_records"].each_with_index do |record, index| %>
                <tr>
                  <td class="text-muted"><%= index + 1 %></td>
                  <td>
                    <% if record["link"].present? %>
                      <%= link_to record["name"], record["link"] %>
                    <% else %>
                      <%= record["name"] %>
                    <% end %>
                  </td>
                  <td><span class="text-danger"><%= record["reason"] %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
    <button type="button" class="btn-close ms-2" data-action="click->support-agent-progress#hideStepDetails"></button>
  </div>
</div>
