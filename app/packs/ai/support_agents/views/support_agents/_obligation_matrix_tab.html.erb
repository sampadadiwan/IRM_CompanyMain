<%# Obligation matrix tab rendered on the SideLetterObligationAgent and
    CpCsExtractionAgent show pages. The "Open Obligation Matrix" link
    pre-selects the legal_category Ransack filter via q[legal_category_eq]
    so the standalone page is scoped to the relevant obligation type.
    Locals: support_agent, obligations %>
<%# legal_category_eq values: 0 = CP, 1 = CS, 2 = SLO.
    CP/CS agent pre-selects CP (0); SLO agent pre-selects SLO (2). %>
<% legal_category_value = support_agent.agent_type == "CpCsExtractionAgent" ? 0 : 2 %>
<div class="d-flex justify-content-between align-items-center mb-2">
  <p class="text-muted mb-0">
    <% if support_agent.agent_type == "CpCsExtractionAgent" %>
      Conditions precedent and subsequent extracted from investment documents.
      Pending items need counsel review before tasks and alerts go live.
    <% else %>
      Obligations extracted from side letters. Pending items need counsel review before
      tasks and alerts go live.
    <% end %>
  </p>
  <%= link_to side_letter_obligations_path(q: { legal_category_eq: legal_category_value }),
              class: "btn btn-outline-primary d-inline-flex align-items-center" do %>
    <i class="ti ti-table"></i> Open Obligation Matrix
  <% end %>
</div>
<%= render "side_letter_obligations/matrix", obligations: obligations %>
<%# Action modals (Fire/Waive/Revert) are rendered in show.html.erb OUTSIDE the
    FormCard — container-type: inline-size on .card breaks Bootstrap's fixed-position
    modal placement, causing flicker. See show.html.erb after the FormCard block. %>
