<%# Obligation matrix tab rendered on the SideLetterObligationAgent and
    CpCsExtractionAgent show pages. The "Open Full Matrix" link passes a
    context param so the standalone page pre-filters and adapts columns:
    cp_cs hides the legal category column (always CP/CS), side_letter
    hides it too (always SLO). Locals: support_agent, obligations %>
<% matrix_context = support_agent.agent_type == "CpCsExtractionAgent" ? "cp_cs" : "side_letter" %>
<div class="d-flex justify-content-between align-items-center mb-2">
  <p class="text-muted mb-0">
    <% if matrix_context == "cp_cs" %>
      Conditions precedent and subsequent extracted from investment documents.
      Pending items need counsel review before tasks and alerts go live.
    <% else %>
      Obligations extracted from side letters. Pending items need counsel review before
      tasks and alerts go live.
    <% end %>
  </p>
  <%= link_to side_letter_obligations_path(context: matrix_context),
              class: "btn btn-outline-primary d-inline-flex align-items-center" do %>
    <i class="ti ti-table"></i> Open Full Matrix
  <% end %>
</div>
<%= render "side_letter_obligations/matrix", obligations: obligations %>
<%# Action modals (Fire/Waive/Revert) are rendered in show.html.erb OUTSIDE the
    FormCard — container-type: inline-size on .card breaks Bootstrap's fixed-position
    modal placement, causing flicker. See show.html.erb after the FormCard block. %>
