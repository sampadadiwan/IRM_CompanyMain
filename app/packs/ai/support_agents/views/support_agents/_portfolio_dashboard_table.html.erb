<%= turbo_frame_tag "portfolio_table_frame", data: { portfolio_dashboard_filter_target: "tableFrame" } do %>
<div class="card border-0 shadow-sm">
  <div class="card-body">
    <%# Table Header with Search + Filter %>
    <% active_filter = local_assigns[:status_filter] %>
    <% search_q = local_assigns[:search_value].present? ? { "q[investor_investor_name_cont]": local_assigns[:search_value] } : {} %>
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div class="d-flex align-items-center gap-2">
        <h6 class="fw-bold mb-0">Company Wise Status</h6>
        <% if active_filter.present? %>
          <span class="badge bg-primary-subtle text-primary">
            Filtered: <%= active_filter.titleize %>
          </span>
          <%= link_to support_agent_path(support_agent, tab: "portfolio_reports", **search_q),
                class: "btn btn-sm btn-outline-secondary", data: { turbo_frame: "portfolio_table_frame" } do %>
            <i class="ti ti-x"></i> Clear
          <% end %>
        <% end %>
      </div>
      <div class="d-flex gap-2">
        <select class="form-select form-select-sm" style="width: 150px;"
                data-action="change->portfolio-dashboard-filter#statusDropdownChange"
                data-fallback-url="<%= support_agent_path(support_agent, tab: "portfolio_reports", **search_q) %>">
          <option value="<%= support_agent_path(support_agent, tab: "portfolio_reports", **search_q) %>">All Statuses</option>
          <option value="<%= support_agent_path(support_agent, tab: "portfolio_reports", status: "Complete", **search_q) %>" <%= "selected" if active_filter == "Complete" %>>Complete</option>
          <option value="<%= support_agent_path(support_agent, tab: "portfolio_reports", status: "Incomplete", **search_q) %>" <%= "selected" if active_filter == "Incomplete" %>>Incomplete</option>
          <option value="<%= support_agent_path(support_agent, tab: "portfolio_reports", status: "Pending", **search_q) %>" <%= "selected" if active_filter == "Pending" %>>Pending</option>
        </select>
        <%= form_tag support_agent_path(support_agent, tab: "portfolio_reports", status: active_filter),
              method: :get, data: { controller: "search", turbo_frame: "portfolio_table_frame" },
              class: "d-flex search-form" do %>
          <div class="input-group input-group-sm" style="width: 220px;">
            <span class="input-group-text"><i class="ti ti-search"></i></span>
            <%= text_field_tag "q[investor_investor_name_cont]",
                  local_assigns[:search_value],
                  class: "form-control", placeholder: "Search company...",
                  data: { "search-target": "searchInput", action: "keydown->search#debouncedSearchInput" } %>
          </div>
          <%= hidden_field_tag "tab", "portfolio_reports" %>
          <%= hidden_field_tag "status", active_filter if active_filter.present? %>
          <%= submit_tag "Submit", hidden: true, data: { target: "search.submit" } %>
        <% end %>
      </div>
    </div>

    <%# Table %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Company Name</th>
            <th>Status</th>
            <th class="text-center">KPI</th>
            <th class="text-center">Valuation</th>
            <% presenter.document_types.each do |doc_type| %>
              <th class="text-center"><%= doc_type %></th>
            <% end %>
            <th class="text-center">Issues</th>
            <th>Last Updated</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody data-portfolio-dashboard-filter-target="tableBody">
          <% portfolio_reports.each do |report| %>
            <% data = (report.json_fields || {}).with_indifferent_access %>
            <% status = presenter.report_status(report) %>
            <% color = presenter.report_status_color(report) %>
            <tr data-status="<%= status %>"
                data-company="<%= (report.owner&.name || report.owner_name || '').downcase %>"
                data-issues="<%= presenter.blocking_count(report) %>">
              <td>
                <strong><%= report.owner&.name || report.owner_name || "N/A" %></strong>
              </td>
              <td>
                <span class="badge bg-<%= color %>"><%= status %></span>
              </td>
              <td class="text-center">
                <% if presenter.category_ok?(report, :kpi) %>
                  <i class="ti ti-check text-success fs-5"></i>
                <% else %>
                  <i class="ti ti-x text-danger fs-5"></i>
                <% end %>
              </td>
              <td class="text-center">
                <% if presenter.category_ok?(report, :valuation) %>
                  <i class="ti ti-check text-success fs-5"></i>
                <% else %>
                  <i class="ti ti-x text-danger fs-5"></i>
                <% end %>
              </td>
              <% presenter.document_types.each do |doc_type| %>
                <td class="text-center">
                  <% if presenter.document_ok?(report, doc_type) %>
                    <i class="ti ti-check text-success fs-5"></i>
                  <% else %>
                    <i class="ti ti-x text-danger fs-5"></i>
                  <% end %>
                </td>
              <% end %>
              <td class="text-center">
                <% count = presenter.blocking_count(report) %>
                <% if count > 0 %>
                  <span class="text-danger fw-bold"><%= count %></span>
                <% else %>
                  <span class="text-success">0</span>
                <% end %>
              </td>
              <td>
                <% if data[:run_at].present? %>
                  <% run_at = Time.zone.parse(data[:run_at]) rescue nil %>
                  <small><%= run_at&.strftime("%b %d, %Y") || "--" %></small>
                <% else %>
                  <small>--</small>
                <% end %>
              </td>
              <td>
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-secondary"
                          data-bs-toggle="collapse"
                          data-bs-target="#report-detail-<%= report.id %>"
                          title="View Details">
                    <i class="ti ti-eye"></i>
                  </button>
                  <% if report.owner_id.present? %>
                    <%= link_to investor_path(report.owner_id),
                          class: "btn btn-outline-secondary",
                          title: "View Company",
                          data: { turbo: false } do %>
                      <i class="ti ti-chart-bar"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
            <%# Expandable detail row — reuses existing partial %>
            <tr class="collapse" id="report-detail-<%= report.id %>">
              <td colspan="<%= 7 + presenter.document_types.size %>" class="bg-light p-3">
                <%= render 'portfolio_report_detail', report: report, data: data %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if local_assigns[:pagy] && pagy.pages > 1 %>
      <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted"><%= raw pagy_info(pagy) %></small>
        <% pagy_params = { tab: "portfolio_reports", status: active_filter, q: local_assigns[:search_value].present? ? { investor_investor_name_cont: local_assigns[:search_value] } : nil }.compact %>
        <%= raw pagy_bootstrap_nav(pagy, anchor_string: %(data-turbo-frame="portfolio_table_frame" data-remote="true"), params: pagy_params) %>
      </div>
      <% end %>

    </div>
  </div>
</div>
<% end %>
