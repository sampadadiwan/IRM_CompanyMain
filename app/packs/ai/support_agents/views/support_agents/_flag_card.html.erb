<div class="<%= col_class %>">
  <div class="card border h-100 shadow-none">
    <div class="card-header py-2 px-3 bg-white border-bottom">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="fw-semibold small"><%= title %></span>
        <div class="d-flex align-items-center gap-1">
          <% if local_assigns[:score_dim] %>
            <span class="badge bg-light text-secondary border" style="font-size:0.66rem;">→ <%= score_dim %></span>
          <% end %>
          <span class="badge bg-secondary" style="font-size:0.72rem;"><%= count %></span>
        </div>
      </div>
      <div class="text-muted" style="font-size:0.71rem;"><%= help_text %></div>
    </div>
    <div class="card-body p-0">
      <table class="table table-sm mb-0 align-top" style="table-layout:auto;width:100%;">
        <%= yield %>
      </table>
    </div>
  </div>
</div>
