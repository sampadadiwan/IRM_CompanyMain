<p>Dear team,</p>

<p>
  The <strong>E-Sign Monitor</strong> has completed its scheduled scan for
  <strong><%= @entity&.name %></strong> and identified items that need your attention.
</p>

<% if @pending_docs.any? %>
  <h3 style="font-size:16px; margin:24px 0 8px; color:#333;">
    Pending Signatures (<%= @pending_docs.size %> document<%= @pending_docs.size != 1 ? "s" : "" %>)
  </h3>
  <p style="margin:0 0 12px; color:#555; font-size:14px;">
    These documents have been in "requested" state and have not yet been fully signed.
    Please follow up with the signatories listed below.
  </p>

  <table style="width:100%; border-collapse:collapse; margin-bottom:24px;">
    <thead>
      <tr style="background:#f5f5f5;">
        <th style="padding:8px 12px; border:1px solid #ddd; text-align:left; font-size:13px;">Document</th>
        <th style="padding:8px 12px; border:1px solid #ddd; text-align:left; font-size:13px; white-space:nowrap;">Waiting</th>
        <th style="padding:8px 12px; border:1px solid #ddd; text-align:left; font-size:13px;">Pending Signers</th>
      </tr>
    </thead>
    <tbody>
      <% @pending_docs.each do |doc| %>
        <% doc = doc.with_indifferent_access %>
        <tr>
          <td style="padding:8px 12px; border:1px solid #ddd; font-size:13px;"><%= doc[:name] %></td>
          <td style="padding:8px 12px; border:1px solid #ddd; font-size:13px; white-space:nowrap;">
            <%= doc[:days_waiting] %> day<%= doc[:days_waiting].to_i != 1 ? "s" : "" %>
          </td>
          <td style="padding:8px 12px; border:1px solid #ddd; font-size:13px;">
            <% signers = Array(doc[:pending_signers]) %>
            <% if signers.any? %>
              <ul style="margin:0; padding-left:16px;">
                <% signers.each do |s| %>
                  <% s = s.with_indifferent_access %>
                  <li>
                    <%= s[:label].presence || s[:email] %>
                    <% if s[:label].present? && s[:email].present? %>
                      <span style="color:#888; font-size:12px;">(<%= s[:email] %>)</span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <span style="color:#888;">—</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @expired_issues.any? %>
  <h3 style="font-size:16px; margin:24px 0 8px; color:#c00;">
    Expired / Voided (<%= @expired_issues.size %> document<%= @expired_issues.size != 1 ? "s" : "" %>)
  </h3>
  <p style="margin:0 0 12px; color:#555; font-size:14px;">
    These documents have an expired, cancelled, or voided e-sign status and cannot be automatically
    resent. Please re-initiate e-signing from the document page.
  </p>

  <table style="width:100%; border-collapse:collapse; margin-bottom:24px;">
    <thead>
      <tr style="background:#fff5f5;">
        <th style="padding:8px 12px; border:1px solid #ddd; text-align:left; font-size:13px;">Document</th>
        <th style="padding:8px 12px; border:1px solid #ddd; text-align:left; font-size:13px;">Status</th>
      </tr>
    </thead>
    <tbody>
      <% @expired_issues.each do |issue| %>
        <% issue = issue.with_indifferent_access %>
        <tr>
          <td style="padding:8px 12px; border:1px solid #ddd; font-size:13px;"><%= issue[:name] %></td>
          <td style="padding:8px 12px; border:1px solid #ddd; font-size:13px; color:#c00;"><%= issue[:message] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p style="color:#555; font-size:13px;">
  This report was generated by the <strong><%= @support_agent&.name || "E-Sign Monitor" %></strong> agent
  and sent automatically. No action was taken on any document — this is a notification only.
</p>
