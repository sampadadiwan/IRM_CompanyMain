<%
  total_issues = @pending_docs.size + @expired_issues.size
  overall_tone = @expired_issues.any? ? :danger : @pending_docs.any? ? :warning : :success
  overall_label = @expired_issues.any? ? "Re-Signing Required" : @pending_docs.any? ? "Signatures Pending" : "All Clear"
%>

<%= sa_intro("The <strong>E-Sign Monitor</strong> has completed its scan for <strong>#{h @entity&.name}</strong> and found #{total_issues} item#{total_issues == 1 ? '' : 's'} that need#{total_issues == 1 ? 's' : ''} attention.".html_safe) %>

<%= sa_banner(
  title:    "E-Sign Status — #{I18n.l(Time.zone.today, format: :month_year_full)}",
  label:    overall_label,
  subtitle: "#{@pending_docs.size} pending signature#{@pending_docs.size == 1 ? '' : 's'} · #{@expired_issues.size} expired/voided",
  tone:     overall_tone
) %>

<% if @pending_docs.any? %>
  <%= sa_section(
    title:     "Pending Signatures (#{@pending_docs.size} document#{@pending_docs.size != 1 ? 's' : ''})",
    top_margin: false
  ) %>

  <%= sa_callout(
    tone: :warning,
    body: "These documents have been in \"requested\" state and have not yet been fully signed. Please follow up with the signatories listed below.".html_safe
  ) %>

  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:28px">
    <%= sa_th("Document", ["Waiting", {align: :right}], "Pending Signers") %>
    <tbody>
      <% @pending_docs.each do |doc| %>
        <% doc = doc.with_indifferent_access %>
        <% signers = Array(doc[:pending_signers]) %>
        <tr>
          <%= sa_td(doc[:name].to_s, bold: true) %>
          <%= sa_td("#{doc[:days_waiting]} day#{doc[:days_waiting].to_i != 1 ? 's' : ''}", align: :right, nowrap: true) %>
          <td style="padding:9px 12px;border:1px solid #e0e0e0;font-size:13px">
            <% if signers.any? %>
              <ul style="margin:0;padding-left:16px">
                <% signers.each do |s| %>
                  <% s = s.with_indifferent_access %>
                  <li>
                    <%= s[:label].presence || s[:email] %>
                    <% if s[:label].present? && s[:email].present? %>
                      <span style="color:#aaa;font-size:12px">(<%= s[:email] %>)</span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <span style="color:#aaa">—</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @expired_issues.any? %>
  <%= sa_section(title: "Expired / Voided (#{@expired_issues.size} document#{@expired_issues.size != 1 ? 's' : ''})") %>

  <%= sa_callout(
    tone: :danger,
    body: "These documents have an expired, cancelled, or voided e-sign status and cannot be automatically resent. Please re-initiate e-signing from the document page in CapHive.".html_safe
  ) %>

  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:28px">
    <%= sa_th("Document", "Status") %>
    <tbody>
      <% @expired_issues.each do |issue| %>
        <% issue = issue.with_indifferent_access %>
        <tr>
          <%= sa_td(issue[:name].to_s, bold: true) %>
          <%= sa_td(issue[:message].to_s, color: SupportAgentEmailHelper::SA_COLORS[:danger][:text]) %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= sa_footer("This report was generated by the #{h @support_agent&.name || 'E-Sign Monitor'} agent and sent automatically. No action was taken on any document — this is a notification only.") %>
