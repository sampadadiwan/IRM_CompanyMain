<%
  deal_url   = deal_url(@deal)
  report_url = support_agent_url(@support_agent, tab: "deal_reports")

  stagnant = @progress_issues.select { |i| i["type"] == "stagnant" || i[:type] == :stagnant }
  overdue  = @progress_issues.select { |i| i["type"] == "overdue"  || i[:type] == :overdue }

  blocking_docs = @document_issues.select { |i| (i["severity"] || i[:severity]).to_s == "blocking" }
  present_docs  = @document_issues.select { |i| (i["severity"] || i[:severity]).to_s == "success" && (i["type"] || i[:type]).to_s == "present" }

  has_issues     = @has_blocking || stagnant.any? || overdue.any? || blocking_docs.any?
  overall_tone   = has_issues ? :danger : :success
  overall_label  = has_issues ? "Attention Required" : "On Track"
  overall_sub    = "#{h @deal.name} · #{@entity.name} · #{@run_at.strftime('%d %b %Y %H:%M')}"
%>

<%= sa_banner(
  title:    "Deal Management Digest",
  label:    overall_label,
  subtitle: overall_sub,
  tone:     overall_tone
) %>

<p style="margin:0 0 20px;font-size:13px;color:#555">
  <a href="<%= deal_url %>" style="color:#1565c0;text-decoration:none;font-weight:600">Open Deal &rarr;</a>
  &nbsp;&nbsp;&middot;&nbsp;&nbsp;
  <a href="<%= report_url %>" style="color:#1565c0;text-decoration:none;font-weight:600">Full Report &rarr;</a>
</p>

<%= sa_section(title: "Deal Progress", top_margin: false) %>

<% if stagnant.any? || overdue.any? %>
  <% if stagnant.any? %>
    <%= sa_callout(
      tone:    :warning,
      heading: "Stagnant Investors (no activity > #{@support_agent.json_fields['stagnant_days'] || 7} days)",
      body:    stagnant.map { |i|
        msg = h(i["message"] || i[:message])
        "#{msg} &mdash; <a href=\"#{deal_url}\" style=\"color:#1565c0\">View Deal</a>"
      }.join("<br>").html_safe
    ) %>
  <% end %>

  <% if overdue.any? %>
    <%= sa_callout(
      tone:    :danger,
      heading: "Overdue Activities",
      body:    overdue.map { |i|
        act_id = i["activity_id"] || i[:activity_id]
        msg    = h(i["message"] || i[:message])
        link   = act_id.present? ? " &mdash; <a href=\"#{deal_activity_url(act_id)}\" style=\"color:#1565c0\">View Activity</a>" : ""
        "#{msg}#{link}"
      }.join("<br>").html_safe
    ) %>
  <% end %>
<% else %>
  <%= sa_callout(tone: :success, body: "No stagnant investors or overdue activities.".html_safe) %>
<% end %>

<% if @document_issues.any? %>
  <%= sa_section(title: "Document Checklist", link_text: "Open data room", link_url: deal_url) %>

  <% if blocking_docs.any? %>
    <%= sa_callout(
      tone:    :danger,
      heading: "Missing Required Documents",
      body:    [
        blocking_docs.map { |i| "&#10007; #{h(i['document_name'] || i[:document_name])} <em>(missing)</em>" },
        present_docs.map  { |i| "<span style=\"color:#{SupportAgentEmailHelper::SA_COLORS[:success][:text]}\">&#10003; #{h(i['document_name'] || i[:document_name])}</span>" }
      ].flatten.join("<br>").html_safe
    ) %>
  <% else %>
    <%= sa_callout(tone: :success, body: "All required documents are present.".html_safe) %>
  <% end %>
<% end %>

<% if @score_leaderboard.any? %>
  <%= sa_section(title: "Investor Scores", link_text: "Full score breakdown", link_url: report_url) %>

  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:8px">
    <%= sa_th("Investor", "Status", ["Score", {align: :right}], ["Grade", {align: :center}]) %>
    <tbody>
      <% @score_leaderboard.each do |r| %>
        <% inv_id = r["investor_id"] || r[:investor_id] %>
        <% inv_name = r["investor_name"] || r[:investor_name] %>
        <tr>
          <td style="padding:9px 12px;border:1px solid #e0e0e0">
            <% if inv_id.present? %>
              <a href="<%= report_url %>#inv-<%= inv_id %>" style="color:#1565c0;text-decoration:none"><%= inv_name %></a>
            <% else %>
              <%= inv_name %>
            <% end %>
          </td>
          <%= sa_td((r["status"] || r[:status]).to_s) %>
          <%= sa_td("<strong>#{r['ai_score'] || r[:ai_score]}</strong>".html_safe, align: :right) %>
          <%= sa_td("<strong>#{r['ai_grade'] || r[:ai_grade]}</strong>".html_safe, align: :center) %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p style="font-size:12px;color:#aaa;margin:4px 0 20px">
    Each of 5 dimensions scored 0–20 &nbsp;&middot;&nbsp; Grade: A &ge; 85, B &ge; 70, C &ge; 55, D &ge; 40, F &lt; 40
  </p>
<% end %>

<% if @extracted_terms.present? %>
  <%= sa_section(title: "Extracted Deal Terms") %>
  <%= sa_kv_table(rows: @extracted_terms.reject { |_, v| v.nil? }.map { |k, v| [k.to_s.humanize, v] }) %>
<% end %>

<%= sa_footer("Sent by the Deal Management Agent · #{h @entity.name} · <a href=\"#{deal_url}\" style=\"color:#aaa\">Open Deal</a> · <a href=\"#{report_url}\" style=\"color:#aaa\">Full Report</a>".html_safe) %>
