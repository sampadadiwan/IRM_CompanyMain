<%
  format_amount = ->(cents, currency) {
    cents.present? ? Money.new(cents.to_i, currency).format : "--"
  }

  sub = @entity.sub_domain

  shortfall_funds = @fund_results.select { |f| f[:fund_status] == "shortfall" }
  watch_funds     = @fund_results.select { |f| f[:fund_status] == "watch" }
  ready_funds     = @fund_results.select { |f| f[:fund_status] && f[:fund_status] != "blocked" }
  blocked_funds   = @fund_results.select { |f| f[:fund_status] == "blocked" }

  overall_tone  = shortfall_funds.any? ? :danger : watch_funds.any? ? :warning : :success
  overall_label = shortfall_funds.any? ? "Action Required" : watch_funds.any? ? "Monitor" : "All Clear"
  overall_sub   = "#{ready_funds.size} of #{@fund_results.size} funds reporting" +
                  (shortfall_funds.any? ? " — #{shortfall_funds.size} shortfall#{shortfall_funds.size != 1 ? 's' : ''} need attention" : "") +
                  (blocked_funds.any? ? " — #{blocked_funds.size} blocked (stale data)" : "")
%>

<%= sa_intro("This is an automated cash flow analysis report for <strong>#{h @entity.name}</strong> covering #{@fund_results.size} fund#{@fund_results.size != 1 ? 's' : ''}. Review any shortfalls and initiate capital calls promptly.".html_safe) %>

<%= sa_banner(
  title:    "Overall Status — #{Time.zone.today.strftime('%B %Y')}",
  label:    overall_label,
  subtitle: overall_sub,
  tone:     overall_tone
) %>

<% if shortfall_funds.any? %>
  <%= sa_callout(
    tone:    :danger,
    heading: "Action Required",
    body:    shortfall_funds.map { |f|
      "#{h f[:name]} &mdash; capital call of <strong>#{format_amount.call(f[:recommended_call], @currency)}</strong> recommended. <a href=\"#{capital_calls_url(subdomain: sub)}\" style=\"color:#{SupportAgentEmailHelper::SA_COLORS[:danger][:text]};font-weight:600;text-decoration:none\">Raise Call &rarr;</a>"
    }.join("<br>").html_safe
  ) %>
<% end %>

<%= sa_section(title: "Portfolio Summary", top_margin: false) %>

<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:32px">
  <%= sa_th("Fund", "Status", ["Net Position", {align: :right}], ["Runway", {align: :right}], "Action") %>
  <tbody>
    <% @fund_results.each do |fund| %>
      <% fs = fund[:fund_status] || fund[:status] %>
      <% tone = sa_tone_for(fs) %>
      <tr>
        <%= sa_td(fund[:name].to_s, bold: true) %>
        <td style="padding:9px 12px;border:1px solid #e0e0e0">
          <%= sa_badge(label: fs&.titleize || "—", tone: tone) %>
        </td>
        <% if fs == "blocked" %>
          <%= sa_td("&mdash;".html_safe, align: :right, color: "#aaa") %>
          <%= sa_td("&mdash;".html_safe, align: :right, color: "#aaa") %>
          <%= sa_td("Update stale data", color: "#757575") %>
        <% else %>
          <%= sa_td(format_amount.call(fund[:net_position], @currency), align: :right, bold: fs == "shortfall", color: SupportAgentEmailHelper::SA_COLORS[tone][:text]) %>
          <%= sa_td(fund[:runway_days] >= 999 ? "180+ days" : "#{fund[:runway_days]} days", align: :right) %>
          <td style="padding:9px 12px;border:1px solid #e0e0e0">
            <% if fs == "shortfall" %>
              <a href="<%= capital_calls_url(subdomain: sub) %>" style="color:#{SupportAgentEmailHelper::SA_COLORS[:danger][:text]};font-weight:600;text-decoration:none">
                Call <%= format_amount.call(fund[:recommended_call], @currency) %> &rarr;
              </a>
            <% elsif fs == "watch" %>
              <span style="color:#{SupportAgentEmailHelper::SA_COLORS[:warning][:text]}">Monitor</span>
            <% else %>
              <span style="color:#{SupportAgentEmailHelper::SA_COLORS[:success][:text]}">None</span>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<% ready_funds.each do |fund| %>
  <% fs = fund[:fund_status] %>
  <% tone = sa_tone_for(fs) %>

  <%= sa_section(
    title:     "#{fund[:name]} — Detail",
    link_text: "View Commitments",
    link_url:  capital_commitments_url(subdomain: sub)
  ) %>

  <%= sa_kv_table(rows: [
    ["Cash Available",       format_amount.call(fund[:cash_available], @currency)],
    ["Upcoming Investments", format_amount.call(fund[:upcoming_investments], @currency)],
    ["Estimated Expenses",   format_amount.call(fund[:estimated_expenses], @currency)],
    ["Buffer Required",      format_amount.call(fund[:buffer_required], @currency)],
    ["Net Position",         format_amount.call(fund[:net_position], @currency), { tone: tone, bold: true }]
  ]) %>

  <% if fund[:cash_breakdown]&.any? %>
    <p style="font-size:12px;font-weight:700;color:#555;margin:12px 0 6px;text-transform:uppercase;letter-spacing:0.5px">Cash by Entity</p>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:12px">
      <% fund[:cash_breakdown].each do |entry| %>
        <tr>
          <td style="padding:6px 10px;border-bottom:1px solid #f0f0f0;font-size:13px"><%= entry[:entity_name] %></td>
          <td style="padding:6px 10px;border-bottom:1px solid #f0f0f0;text-align:right;font-size:13px"><%= format_amount.call(entry[:amount_cents], @currency) %></td>
          <td style="padding:6px 10px;border-bottom:1px solid #f0f0f0;color:#aaa;font-size:12px">
            <% if entry[:last_updated] %>
              <%= (Time.zone.today - entry[:last_updated]).to_i %> days ago
            <% end %>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <% if fs == "shortfall" %>
    <%= sa_callout(
      tone: :danger,
      body: "This fund has insufficient cash to cover upcoming investments and expenses. Raise a capital call of <strong>#{format_amount.call(fund[:recommended_call], @currency)}</strong> to restore the required buffer. <a href=\"#{capital_calls_url(subdomain: sub)}\" style=\"color:#{SupportAgentEmailHelper::SA_COLORS[:danger][:text]};font-weight:600;text-decoration:none\">Raise Capital Call &rarr;</a>".html_safe
    ) %>
  <% elsif fs == "watch" %>
    <%= sa_callout(
      tone: :warning,
      body: "Runway is within the watch threshold. No immediate action required, but monitor cash position closely over the next few weeks.".html_safe
    ) %>
  <% end %>
<% end %>

<% if shortfall_funds.any? %>
  <%= sa_cta(label: "Open CapHive to Raise Capital Calls", url: capital_calls_url(subdomain: sub)) %>
<% end %>

<%= sa_footer("Report generated: #{Time.zone.now.strftime('%d %b %Y, %I:%M %p')} · #{ready_funds.size} of #{@fund_results.size} funds have current data. This report runs automatically — configure recipients in the Cash Flow Assistant Agent settings in CapHive.") %>
