<%
  if @days_until_due.negative?
    tone  = :danger
    label = "Overdue by #{@days_until_due.abs} day#{@days_until_due.abs == 1 ? '' : 's'}"
  elsif @days_until_due.zero?
    tone  = :warning
    label = "Due Today"
  else
    tone  = :info
    label = "Due in #{@days_until_due} day#{@days_until_due == 1 ? '' : 's'}"
  end
%>

<%= sa_banner(title: "Activity Reminder", label: label, subtitle: "#{h @deal.name} · #{h @entity.name}", tone: tone) %>

<%= sa_kv_table(rows: [
  ["Deal",     h(@deal.name)],
  ["Investor", h(@investor_name)],
  ["Activity", h(@activity.title)],
  ["Due Date", @activity.by_date&.strftime("%d %b %Y") || "—"]
] + (@activity.details.present? ? [["Details", h(@activity.details.to_plain_text)]] : [])) %>

<%= sa_footer("This reminder was sent by the Deal Management Agent for #{h @entity.name}.") %>
