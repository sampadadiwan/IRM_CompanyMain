<%
  sub            = @support_agent.entity.sub_domain
  blocked_funds  = @fund_statuses.select { |f| f[:status] == "blocked" }
  ready_funds    = @fund_statuses.reject { |f| f[:status] == "blocked" }
  overall_tone   = blocked_funds.any? ? :warning : :success
  overall_label  = blocked_funds.any? ? "Data Update Needed" : "All Data Current"
  run_date       = I18n.l(@next_run_at.to_date, format: :abbr_month_day_year)
%>

<%= sa_intro("The Cash Flow Report for <strong>#{h @support_agent.entity.name}</strong> is scheduled to run on <strong>#{run_date}</strong> (#{@days_until_run} day#{@days_until_run == 1 ? '' : 's'} from now). The table below shows the data readiness for each fund.".html_safe) %>

<%= sa_banner(
  title:    "Data Readiness — #{run_date}",
  label:    overall_label,
  subtitle: "#{ready_funds.size} of #{@fund_statuses.size} funds have current data",
  tone:     overall_tone
) %>

<%= sa_section(title: "Fund Data Status", link_text: "Update cash data", link_url: capital_calls_url(subdomain: sub), top_margin: false) %>

<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:24px">
  <%= sa_th("Fund", "Status", "Details") %>
  <tbody>
    <% @fund_statuses.each do |fund| %>
      <% tone = fund[:status] == "ready" ? :success : :warning %>
      <tr>
        <%= sa_td(fund[:name], bold: true) %>
        <td style="padding:9px 12px;border:1px solid #e0e0e0">
          <%= sa_badge(label: fund[:status] == "ready" ? "Fresh" : "Stale", tone: tone) %>
        </td>
        <td style="padding:9px 12px;border:1px solid #e0e0e0;font-size:13px;color:#555">
          <% if fund[:status] == "ready" %>
            No action needed<% if fund[:last_cash_update] %> — last updated <%= (Time.zone.today - fund[:last_cash_update]).to_i %> days ago<% end %>
          <% else %>
            <ul style="margin:0;padding-left:16px">
              <% fund[:block_reasons]&.each do |reason| %>
                <li><%= reason %></li>
              <% end %>
            </ul>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if blocked_funds.any? %>
  <%= sa_callout(
    tone:    :warning,
    heading: "Action Required Before #{run_date}",
    body:    "#{blocked_funds.size} fund#{blocked_funds.size == 1 ? '' : 's'} #{blocked_funds.size == 1 ? 'has' : 'have'} stale data. Please update the data listed above so the cash flow report generates correctly.".html_safe
  ) %>
  <%= sa_cta(label: "Update Cash Data in CapHive", url: capital_calls_url(subdomain: sub)) %>
<% else %>
  <%= sa_callout(tone: :success, body: "All fund data is current. The report will generate on schedule — no action needed.".html_safe) %>
<% end %>

<%= sa_footer("This reminder is sent automatically by the Cash Flow Assistant Agent for #{h @support_agent.entity.name}. You can manage schedules and recipients in CapHive.") %>
