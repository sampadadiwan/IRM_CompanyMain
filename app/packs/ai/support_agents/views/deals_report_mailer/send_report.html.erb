<%
  format_amount = ->(cents, currency) {
    cents.present? ? Money.new(cents.to_i, currency).format : "--"
  }

  attention_deals = @deal_results.select { |d| d[:deal_status] == "needs_attention" }
  stale_deals     = @deal_results.select { |d| d[:stale] }

  overall_tone  = attention_deals.any? ? :danger : stale_deals.any? ? :warning : :success
  overall_label = attention_deals.any? ? "Action Required" : stale_deals.any? ? "Monitor" : "On Track"
  overall_sub   = "#{@deal_results.size} deal#{@deal_results.size == 1 ? '' : 's'} — #{attention_deals.size} need#{attention_deals.size == 1 ? 's' : ''} attention"

  status_label = { "complete" => "Complete", "on_track" => "On Track", "needs_attention" => "Needs Attention", "closed" => "Closed" }
%>

<%= sa_intro("Deal fundraising update for <strong>#{h @support_agent.entity.name}</strong> &mdash; #{I18n.l(Time.zone.today, format: :month_year_full)}.".html_safe) %>

<%= sa_banner(title: "Deal Fundraising — #{I18n.l(Time.zone.today, format: :month_year_full)}", label: overall_label, subtitle: overall_sub, tone: overall_tone) %>

<% if attention_deals.any? %>
  <%= sa_callout(
    tone:    :danger,
    heading: "Action Required",
    body:    attention_deals.map { |d|
      "#{h d[:deal_name]}: Fill rate #{d[:fill_rate]}% — needs investor engagement."
    }.join("<br>").html_safe
  ) %>
<% end %>

<% if @include_stale_items && stale_deals.any? %>
  <%= sa_callout(
    tone:    :warning,
    heading: "No Activity",
    body:    stale_deals.map { |d|
      "#{h d[:deal_name]}: #{d[:stale_days]} days since last activity."
    }.join("<br>").html_safe
  ) %>
<% end %>

<%= sa_section(title: "Deal Summary", top_margin: false) %>

<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:32px">
  <%= sa_th("Deal", "Status", ["Target", {align: :right}], ["Committed", {align: :right}], ["Fill %", {align: :right}], ["Investors", {align: :center}]) %>
  <tbody>
    <% @deal_results.each do |deal| %>
      <% ds = deal[:deal_status].to_s %>
      <% tone = sa_tone_for(ds) %>
      <% curr = deal[:currency] || "INR" %>
      <tr>
        <%= sa_td("<strong>#{h deal[:deal_name]}</strong>".html_safe) %>
        <td style="padding:9px 12px;border:1px solid #e0e0e0">
          <%= sa_badge(label: status_label[ds] || ds.titleize, tone: tone) %>
        </td>
        <%= sa_td(format_amount.call(deal[:target_cents], curr), align: :right) %>
        <%= sa_td(format_amount.call(deal[:committed_cents], curr), align: :right, color: SupportAgentEmailHelper::SA_COLORS[:success][:text]) %>
        <%= sa_td("#{deal[:fill_rate]}%", align: :right, bold: ds == "needs_attention", color: SupportAgentEmailHelper::SA_COLORS[tone][:text]) %>
        <td style="padding:9px 12px;border:1px solid #e0e0e0;text-align:center;font-size:12px">
          <span style="color:<%= SupportAgentEmailHelper::SA_COLORS[:success][:text] %>"><%= deal[:active_count] %> active</span> /
          <span style="color:<%= SupportAgentEmailHelper::SA_COLORS[:info][:text] %>"><%= deal[:pending_count] %> pending</span> /
          <span style="color:<%= SupportAgentEmailHelper::SA_COLORS[:danger][:text] %>"><%= deal[:declined_count] %> declined</span>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% @deal_results.each do |deal| %>
  <% curr = deal[:currency] || "INR" %>
  <% ds = deal[:deal_status].to_s %>
  <% tone = sa_tone_for(ds) %>

  <%= sa_section(title: "#{deal[:deal_name]} — Detail") %>

  <%= sa_kv_table(rows: [
    ["Target Raise",      format_amount.call(deal[:target_cents], curr)],
    ["Committed",         format_amount.call(deal[:committed_cents], curr), { tone: :success }],
    ["Pending",           format_amount.call(deal[:pending_cents], curr), { tone: :info }],
    ["Declined",          format_amount.call(deal[:declined_cents], curr), { tone: :danger }],
    ["Remaining to Close", format_amount.call(deal[:remaining_cents], curr), { bold: true }]
  ]) %>

  <% step_dist = deal[:step_distribution] %>
  <% if @include_updates && step_dist.present? && step_dist.any? %>
    <p style="font-size:12px;font-weight:700;color:#555;margin:16px 0 6px;text-transform:uppercase;letter-spacing:0.5px">Investor Pipeline by Step</p>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:12px">
      <% step_dist.each do |step| %>
        <% step = step.is_a?(Hash) ? step.with_indifferent_access : step %>
        <tr>
          <%= sa_td(step[:sequence].to_s, color: "#aaa", nowrap: true) %>
          <%= sa_td(step[:step_title].to_s) %>
          <%= sa_td(step[:investor_count].to_s, align: :right, bold: true) %>
        </tr>
      <% end %>
    </table>
  <% end %>

  <% if @include_tasks_due %>
    <%
      deal_record = Deal.find_by(id: deal[:deal_id])
      tasks_due = deal_record ? Task.where(owner_id: deal_record.id, owner_type: "Deal")
                                    .where("due_date >= ? AND due_date <= ?", Date.today, 7.days.from_now)
                                    .where(completed: false)
                                    .order(:due_date) : []
    %>
    <% if tasks_due.any? %>
      <%= sa_callout(
        tone: :info,
        heading: "Tasks Due (next 7 days)",
        body: tasks_due.map { |t| "#{h t.title} — due #{t.due_date ? I18n.l(t.due_date, format: :short) : ''}" }.join("<br>").html_safe
      ) %>
    <% end %>
  <% end %>

  <% if @include_tasks_overdue %>
    <%
      deal_record ||= Deal.find_by(id: deal[:deal_id])
      tasks_overdue = deal_record ? Task.where(owner_id: deal_record.id, owner_type: "Deal")
                                        .where("due_date < ?", Date.today)
                                        .where(completed: false)
                                        .order(:due_date) : []
    %>
    <% if tasks_overdue.any? %>
      <%= sa_callout(
        tone: :danger,
        heading: "Overdue Tasks",
        body: tasks_overdue.map { |t| "#{h t.title} — was due #{t.due_date ? I18n.l(t.due_date, format: :short) : ''}" }.join("<br>").html_safe
      ) %>
    <% end %>
  <% end %>
<% end %>

<%= sa_footer("Sent automatically by the Deals Report Agent for #{h @support_agent.entity.name}. Configure recipients and frequency in CapHive.") %>
