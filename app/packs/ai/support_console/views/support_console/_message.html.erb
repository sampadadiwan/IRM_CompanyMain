<%
  # One Support Console message, drawn by the chat kit (ai_chat/_question, ai_chat/_answer).
  # SupportConsoleTurnJob passes the in-flight text and progress as locals while a turn streams.
  metadata = local_assigns.fetch(:metadata, message.metadata) || {}
  # X23 — a follow-up may come from another support user than the conversation's starter.
  asker = (User.find_by(id: metadata["asked_by_id"]) if metadata["asked_by_id"]) || message.agent_chat_session.analyst
  item = AiChatItem.from_agent_chat_message(message, content: local_assigns[:content], metadata: metadata,
                                                     asker: asker.full_name)
%>
<% if item.question? %>
  <%= render "ai_chat/question", item: item %>
<% else %>
  <%# X24 — the Console's answers render strictly (no images, ids, classes or data-* from the answer). %>
  <%= render "ai_chat/answer", item: item, mode: :strict %>
<% end %>
