<%
  # One sidebar row (H15): the first question, then who started it, when it last changed, and the
  # latest answer's status. support_console_sidebar_controller#addConversation builds the same markup
  # for a conversation started on this page.
  question = support_console_conversation_title(first_question)
  badge = SupportConsoleHelper::STATUS_BADGES[status]
%>
<%= link_to support_console_entity_path(entity, session_id: conversation.id),
            class: "sc-conversation d-block fw-normal px-3 py-2 rounded-3 #{'active' if active}",
            data: { support_console_sidebar_target: "conversation", turbo_frame: "support-console-thread",
                    session_id: conversation.id },
            title: question,
            aria: { current: (active ? "page" : nil) } do %>
  <span class="d-block text-truncate" data-role="first-question"><%= question %></span>
  <span class="d-flex align-items-center gap-2 small text-body-secondary" data-role="meta">
    <span class="text-truncate"><%= conversation.analyst.full_name %> · <%= support_console_conversation_when(conversation.updated_at) %></span>
    <% if badge %>
      <%# Hidden on the open conversation, whose thread already shows its status live (CSS). %>
      <span class="badge fw-normal bg-<%= badge[0] %>-subtle text-<%= badge[0] %> ms-auto" data-role="status"><i class="ti <%= badge[1] %> me-1"></i><%= badge[2] %></span>
    <% end %>
  </span>
<% end %>
