<%
  # The newest assistant message decides what the composer allows (E4) and what the footer shows.
  last_answer = messages.reverse.find { |m| m.role == "assistant" }
  status = last_answer&.metadata&.dig("turn_status")
  running = %w[queued running].include?(status)
  # X4 — when the machine could not be reached, the question goes back into the box.
  failed_question = (messages.reverse.find { |m| m.role == "user" }&.content if status == "failed")
  lag = last_answer&.metadata&.dig("lag_seconds")
  code_rev = last_answer&.metadata&.dig("code_rev")
  # E29 — a new conversation starts on Sonnet; inside one, the last choice is kept.
  model = last_answer&.metadata&.dig("model")
  model = SupportConsoleTurnJob::DEFAULT_MODEL unless SupportConsoleTurnJob::MODELS.include?(model)
  # H10 — the whole conversation's tokens and approximate cost; answers saved before usage was recorded add nothing.
  answers = messages.select { |m| m.role == "assistant" }
  tokens = answers.sum { |m| (m.metadata&.dig("usage") || {}).values_at("input", "output", "cache_read", "cache_write").sum(&:to_i) }
  cost = answers.sum { |m| m.metadata&.dig("cost_usd").to_f }
  # H14 / H18 — the follow-ups above the box (ai_chat/_follow_ups) read the thread as kit items.
  items = messages.map { |m| AiChatItem.from_agent_chat_message(m) }
%>
<%# The Console's question box: the chat kit's composer (ai_chat/_composer) with the Console's slots —
    Stop (E9), follow-ups (H14/H18), the model choice (E29) and the data/code/usage footer. %>
<% before = capture do %>
  <% if running %>
    <%# Stop lives in its own form (forms cannot nest); its button below points at it with form=. %>
    <%= form_with url: support_console_stop_turn_path(entity), method: :delete, id: "support-console-stop-form",
                  data: { turbo: true }, class: "d-none" do %>
      <%= hidden_field_tag :session_id, session.id %>
    <% end %>
  <% end %>
<% end %>
<% above = render("ai_chat/follow_ups", items: items, id: "support-console-follow-ups", running: running) %>
<% extras = capture do %>
  <%# E29 — Sonnet (faster, cheaper; the default) or Opus (deeper) for this question. %>
  <%= select_tag :model, options_for_select([["Sonnet", "sonnet"], ["Opus", "opus"]], model),
                 class: "form-select form-select-sm border-0 bg-transparent shadow-none w-auto text-muted aic-model",
                 id: "support-console-model", title: "Sonnet: faster and cheaper. Opus: deeper, for hard investigations.",
                 aria: { label: "Model" } %>
<% end %>
<% stop_button = capture do %>
  <button type="submit" form="support-console-stop-form" class="btn btn-secondary rounded-circle aic-send" id="support-console-stop" title="Stop">
    <i class="ti ti-player-stop-filled"></i><span class="visually-hidden">Stop</span>
  </button>
<% end %>
<% footer = capture do %>
  <div class="text-center small text-muted mt-2">
    <% if failed_question %>
      <i class="ti ti-arrow-back-up me-1"></i>Your question is back in the box — press Enter to try again.
    <% else %>
      Answers cite the code and the rows behind them
    <% end %>
    <% if last_answer && !running && (lag || code_rev) %>
      <%# E18 — lag above 60 s is highlighted. Lag is unknown without replica status (local mode, or no REPLICATION CLIENT grant). %>
      · <span class="<%= lag.to_i > SupportConsoleTurnJob::LAG_WARNING_SECONDS ? 'text-danger fw-semibold' : 'text-muted' %>" id="support-console-footer"><% unless lag.nil? %>Data as of <%= lag.to_i %> seconds ago · <% end %>Code version <%= code_rev.to_s.first(7) %></span>
    <% end %>
    <% usage = [(number_to_human(tokens, units: { unit: "", thousand: "k", million: "M", billion: "B" }, precision: 3, format: "%n%u") + " tokens" if tokens.positive?),
                ("≈ $#{number_with_precision(cost, precision: 2)}" if cost.positive?)].compact %>
    <% if usage.any? %>
      · <span id="support-console-usage" title="This conversation so far, at Claude API prices. On the subscription token the actual charge is the flat plan.">Conversation: <%= usage.join(" · ") %></span>
    <% end %>
  </div>
<% end %>
<%= render "ai_chat/composer", id: "support-console-composer", form_url: support_console_turns_path(entity),
                               hidden: { session_id: session&.id }, question_id: "support-console-question",
                               ask_id: "support-console-ask", value: failed_question, running: running,
                               placeholder: (session ? "Ask a follow-up" : "Ask anything about #{entity.name}"),
                               before: before, above: above, extras: extras, stop_button: stop_button, footer: footer %>
