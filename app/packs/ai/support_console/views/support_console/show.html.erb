<%# One window: the page title lives in the chat header (with the client switcher), not a row above it.
    The layout, sidebar and thread are the chat kit's (app/packs/ai/ai_chat/views/ai_chat). %>
<%= render layout: "ai_chat/layout",
           locals: { rows: @rows, frame: "support-console-thread", new_url: support_console_entity_path(@entity),
                     active_id: @session&.id, root_class: "support-console", controllers: "support-console-fit",
                     storage_key: "supportConsole.sidebarCollapsed",
                     # The retention rule (SupportConsoleRetentionJob), visible where the list is.
                     footer_note: "kept #{SupportConsoleRetentionJob::RETENTION.inspect}",
                     ids: { new: "support-console-new", search: "support-console-search", list: "support-console-conversations" } } do %>
  <%# Opening a conversation, New chat and asking all reload only this frame, not the page.
      advance: the URL follows, so a reload or a shared link opens the same conversation. %>
  <%= turbo_frame_tag "support-console-thread", class: "d-flex flex-column h-100", style: "min-height: 0;", data: { turbo_action: "advance" } do %>
    <%= render "support_console/chat", entity: @entity, session: @session, entities: @entities %>
  <% end %>
<% end %>
