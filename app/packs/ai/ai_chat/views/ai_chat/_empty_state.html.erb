<%# An empty thread: what the assistant can answer, and optional suggested questions
    (ai_chat/_suggestions). Locals: title, text, suggestions (SafeBuffer, optional). %>
<div class="h-100 d-flex flex-column align-items-center justify-content-center text-center">
  <h2 class="h4 mb-2"><%= title %></h2>
  <p class="text-muted mb-0"><%= text %></p>
  <% if local_assigns[:suggestions].present? %>
    <div class="mt-4"><%= suggestions %></div>
  <% end %>
</div>
