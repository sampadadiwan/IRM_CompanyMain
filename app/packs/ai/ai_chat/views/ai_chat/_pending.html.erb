<%# H1 — what the assistant is doing right now: its latest step, or "Thinking…". Local: text. %>
<div class="d-flex align-items-center gap-2 text-muted mb-2">
  <span class="spinner-grow spinner-grow-sm text-primary" role="status"></span>
  <span class="text-truncate"><%= local_assigns[:text].presence || "Thinking…" %></span>
</div>
