<%#
  One assistant conversation on the chat kit's thread (ai_chat/_thread), with the page's own tools:
  the record link and Export menu in the header, and hold-to-speak in the box.
  Lives inside the "assistant-thread" frame, so the tools follow the open conversation.
  Locals: chat (Chat), items (Array<AiChatItem>), description (the assistant's DESCRIPTION).
%>
<% owner = chat.owner unless chat.owner.is_a?(User) %>
<% header = capture do %>
  <span class="text-muted"><%= chat.assistant_type.titleize %></span>
  <% if owner %>
    <%# E6 — an assistant about one record links to it; the cross-record assistants have none. %>
    <i class="ti ti-chevron-right text-muted small"></i>
    <%= link_to owner.to_s, owner, class: "text-body text-truncate", data: { turbo_frame: "_top" } %>
  <% end %>
  <div class="dropdown ms-auto">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="assistant-export"
            data-bs-toggle="dropdown" aria-expanded="false">
      <i class="ti ti-file-export"></i>Export
    </button>
    <div class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="assistant-export">
      <%# The AI Slides deck opens in its own tab; it is generated in the background and fills in when ready. %>
      <%= link_to generate_slides_assistants_path(chat_id: chat.id), id: "assistant-ai-slides", target: "_blank", rel: "noopener",
                  class: "dropdown-item d-flex align-items-center gap-2", data: { turbo: false } do %>
        <i class="ti ti-presentation text-primary"></i>AI Slides
      <% end %>
      <div class="dropdown-divider"></div>
      <button type="button" class="dropdown-item d-flex align-items-center gap-2" data-action="click->ppt-export#export">
        <i class="ti ti-file-export text-success"></i>Export PowerPoint
      </button>
      <div class="dropdown-divider"></div>
      <%= link_to efficiency_report_assistants_path(chat_id: chat.id, assistant_type: chat.assistant_type),
                  class: "dropdown-item d-flex align-items-center gap-2", data: { turbo: false } do %>
        <i class="ti ti-chart-bar text-warning"></i>Efficiency Report
      <% end %>
    </div>
  </div>
<% end %>
<% empty_state = capture do %>
  <%= render "ai_chat/empty_state", title: "Hello, #{current_user.name.split.first}",
                                    text: description.presence || "I'm the CapHive assistant for #{owner || 'your data'}. How can I help you today?" %>
<% end %>
<div class="d-flex flex-column h-100 position-relative" data-controller="voice-chat ppt-export">
  <%= render layout: "ai_chat/thread",
             locals: { id: "assistant-chat", scroller_id: "assistant-messages",
                       data: { session_id: chat.id,
                               session_url: assistant_path("assistant", assistant_type: chat.assistant_type, chat_id: chat.id),
                               first_question: items.find(&:question?)&.content,
                               session_meta: "#{chat.user.full_name} · #{ai_chat_when(chat.updated_at)}" },
                       # H4 — Export PowerPoint reads the answers from here.
                       items_data: { ppt_export_target: "responses" },
                       header: header, streams: turbo_stream_from(chat, :assistant),
                       empty: items.empty?, empty_state: empty_state,
                       composer: render("assistants/composer", chat: chat, running: false, items: items) } do %>
    <% items.each do |item| %>
      <% if item.question? %>
        <%= render "ai_chat/question", item: item %>
      <% else %>
        <%= render "ai_chat/answer", item: item, mode: :rich %>
      <% end %>
    <% end %>
  <% end %>
</div>
