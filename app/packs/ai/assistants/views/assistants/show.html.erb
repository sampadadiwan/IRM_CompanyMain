<%# The Assistants page (Fund, Specific Fund, Portfolio, Portfolio Company and Capital Commitment
    assistants) on the chat kit: the user's conversations with this assistant beside the thread.
    Opening a conversation and New chat reload only the "assistant-thread" frame; the URL follows.
    @see openspec/changes/ai-chat-kit/design.md (card ① Chat screens) %>
<% if @chat %>
  <%= render layout: "ai_chat/layout",
             locals: { rows: @rows, frame: "assistant-thread", active_id: @chat.id, root_class: "assistant-page",
                       new_url: assistant_path("assistant", assistant_type: @chat.assistant_type, new: true,
                                                            owner_id: @chat.owner_id, owner_type: @chat.owner_type),
                       storage_key: "assistants.sidebarCollapsed",
                       ids: { new: "assistant-new", search: "assistant-search", list: "assistant-conversations" } } do %>
    <%= turbo_frame_tag "assistant-thread", class: "d-flex flex-column h-100", style: "min-height: 0;", data: { turbo_action: "advance" } do %>
      <%= render "assistants/thread", chat: @chat, items: @items, description: @assistant_description %>
    <% end %>
  <% end %>
<% end %>
