<div id="assistant-chat" class="d-flex flex-column h-100 ai-chat-container position-relative"
     data-controller="voice-chat ppt-export slideshow"
     data-slideshow-chat-id-value="<%= @chat&.id %>"
     data-voice-chat-chat-id-value="<%= @chat&.id %>">
  <%= turbo_stream_from [current_user, "assistant"] if current_user %>

  <!-- Header Section -->
  <header class="chat-header d-flex align-items-center justify-content-between p-3 border-bottom bg-white sticky-top">
    <div class="d-flex align-items-center gap-3">
      <div class="header-icon rounded-circle d-flex align-items-center justify-content-center">
        <i class="ti ti-sparkles text-primary fs-4"></i>
      </div>
      <div>
        <h5 class="mb-0 fw-bold text-dark">CapHive Assistant</h5>
        <p class="small text-muted mb-0"><%= @chat.owner %></p>
      </div>
    </div>

    <div class="d-flex gap-2 align-items-center">
      <!-- Actions Dropdown (Present/Export) -->
      <div class="btn-group">
        <div class="dropdown">
          <button class="btn btn-outline-success dropdown-toggle" type="button" id="commitment_actions"
                  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="ti ti-file-export"></i> Export
          </button>
          <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4" aria-labelledby="dropdownMenuButton">
            <button class="dropdown-item d-flex align-items-center gap-2 py-2" data-action="click->slideshow#openNew">
              <i class="ti ti-presentation text-primary"></i> AI Slides (New)
            </button>

            <button class="dropdown-item d-flex align-items-center gap-2 py-2" data-action="click->slideshow#openOld" data-chat-id="<%= @chat&.id %>">
              <i class="ti ti-layers-subtract text-info"></i> Chat Slides (Old)
            </button>

            <div class="dropdown-divider"></div>

            <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2" data-action="click->ppt-export#export">
              <i class="ti ti-file-export text-success "></i> Export PowerPoint
            </button>
          </div>
        </div>
      </div>

      <form action="<%= assistant_path('assistant') %>" method="get" data-turbo-frame="_self" class="d-flex gap-2 align-items-center">
        <a href="<%= assistant_path('assistant', assistant_type: params[:assistant_type], new: true, owner_id: @chat.owner&.id, owner_type: @chat.owner_type) %>"
           class="btn btn-outline-primary"
           title="Start new chat">
          <i class="ti ti-plus"></i> <span class="d-none d-md-inline">New Chat</span>
        </a>

        <% if @chats.present? %>
          <select name="chat_id"
                  class="chat-select"
                  onchange="this.form.requestSubmit()">
            <option value="" <%= 'selected' if params[:chat_id].blank? %> disabled>History...</option>
            <% @chats.each do |chat| %>
              <option value="<%= chat.id %>" <%= 'selected' if @chat&.id == chat.id %>>
                <%= chat.name.presence || "Chat ##{chat.id}" %>
              </option>
            <% end %>
          </select>
        <% end %>

        <select name="assistant_type"
                class="chat-select"
                data-voice-chat-target="assistantType"
                onchange="const chatId = this.form.querySelector('select[name=chat_id]'); if(chatId) chatId.disabled = true; this.form.requestSubmit()">
          <option value="" <%= 'selected' if params[:assistant_type].blank? %> disabled>Choose Assistant...</option>
          <option value="fund" <%= 'selected' if params[:assistant_type] == 'fund' %>>Fund</option>
          <option value="specific_fund" <%= 'selected' if params[:assistant_type] == 'specific_fund' %>>Specific Fund</option>
          <option value="portfolio" <%= 'selected' if params[:assistant_type] == 'portfolio' %>>Portfolio</option>
          <option value="portfolio_company" <%= 'selected' if params[:assistant_type] == 'portfolio_company' %>>Company</option>
          <option value="capital_commitment" <%= 'selected' if params[:assistant_type] == 'capital_commitment' %>>Commitment</option>
        </select>

        <% if params[:fund_id].present? %>
          <input type="hidden" name="fund_id" value="<%= params[:fund_id] %>">
        <% end %>

        <% if params[:capital_commitment_id].present? %>
          <input type="hidden" name="capital_commitment_id" value="<%= params[:capital_commitment_id] %>">
        <% elsif params[:portfolio_company_id].present? %>
          <input type="hidden" name="portfolio_company_id" value="<%= params[:portfolio_company_id] %>">
        <% end %>
      </form>
    </div>
  </header>

  <% if params[:assistant_type].present? %>
    <main class="chat-main overflow-auto" id="chat-feed" data-voice-chat-target="chatInterface">
      <!-- Slideshow Overlay (Moved inside main for containment) -->
      <div class="slideshow-overlay d-none" data-slideshow-target="container">
        <div class="d-flex flex-column h-100 position-relative">
          <div class="p-3 d-flex justify-content-between align-items-center bg-white border-bottom shadow-sm">
            <h5 class="mb-0"><i class="ti ti-presentation text-primary me-2"></i>Assistant Presentation</h5>
            <button type="button" class="btn-close" data-action="click->slideshow#close"></button>
          </div>
          <div class="reveal flex-grow-1" data-slideshow-target="reveal">
            <div class="slideshow-loading d-none text-center" data-slideshow-target="loading">
              <div class="spinner-border text-primary" role="status"></div>
              <p class="mt-2 text-primary fw-medium">Generating High-Fidelity Slides...</p>
            </div>
            <div class="slides" data-slideshow-target="slides"></div>
          </div>
        </div>
      </div>

      <div class="container-fluid py-5 px-3 d-flex flex-column align-items-center">
        <div class="chat-content-wrapper">
          <!-- Empty State / Welcome -->
          <div class="welcome-state text-center py-5 <%= 'd-none' if @messages.present? %>" id="welcome-message" data-voice-chat-target="welcome">
            <div class="welcome-icon bg-white shadow-sm rounded-circle d-inline-flex align-items-center justify-content-center mb-4">
              <span class="fs-1">⚡</span>
            </div>
            <h2 class="fw-bold text-dark mb-3">Hello, <%= current_user.name.split.first %></h2>
            <p class="lead text-muted mb-4"><%= @assistant_description || "I'm the CapHive assistant for #{@chat&.owner}. How can I help you today?" %></p>
            <div class="mt-4 small text-muted opacity-50">Session ID: <%= @chat&.id %></div>
          </div>

          <!-- Messages -->
          <div data-voice-chat-target="responses" data-ppt-export-target="responses" data-slideshow-target="source" class="d-flex flex-column gap-4">
            <% if @messages.present? %>
              <% @messages.each do |msg| %>
                <%= render partial: "assistants/ask", locals: { msg: msg } %>
              <% end %>
            <% end %>

            <!-- Typing Indicator (Moved inside responses container) -->
            <div class="typing-indicator d-none py-4" data-voice-chat-target="spinner">
              <div class="dot"></div>
              <div class="dot"></div>
              <div class="dot"></div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer Input Area -->
    <footer class="chat-footer p-3 bg-white border-top">
      <div class="container-md">
        <div class="input-card shadow-sm border rounded-pill overflow-hidden bg-light d-flex align-items-center px-2 py-1">
          <textarea
            class="form-control border-0 bg-transparent shadow-none py-2 px-3"
            rows="1"
            placeholder="Ask anything about your data..."
            style="resize: none; min-height: 44px; max-height: 200px;"
            data-voice-chat-target="input"
            data-action="keydown.enter->voice-chat#handleEnter input->voice-chat#autoResize"
          ></textarea>

          <div class="d-flex gap-2 align-items-center px-2">
            <!-- Send Button -->
            <button class="btn btn-send rounded-circle p-0"
                    type="button"
                    data-action="click->voice-chat#sendText"
                    title="Send Message">
              <i class="ti ti-arrow-up fs-4"></i>
            </button>

            <!-- Mic Button -->
            <button class="btn btn-mic rounded-circle p-0"
                    type="button"
                    data-voice-chat-target="micBtn"
                    data-action="mousedown->voice-chat#startRecording mouseup->voice-chat#stopRecording mouseleave->voice-chat#stopRecording touchstart->voice-chat#startRecording touchend->voice-chat#stopRecording"
                    title="Voice Message">
              <i class="ti ti-microphone fs-4"></i>
            </button>
          </div>
        </div>
        <div class="text-center mt-2 text-muted-extra-small" data-voice-chat-target="hint">
          Hold <i class="ti ti-microphone"></i> to speak • Press <strong>Enter</strong> to send
        </div>
      </div>
    </footer>
  <% end %>

  <style>
    .slideshow-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: white;
      z-index: 2000;
    }
  </style>
</div>
