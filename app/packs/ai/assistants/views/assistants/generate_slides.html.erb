<%#
  This page is rendered with the `presentation` layout and is often opened in a new tab.
  Slides are generated asynchronously via `GenerateSlidesJob`, which broadcasts a Turbo Stream
  update to replace the contents of `#slides_container`.
%>

<% content_for :turbo_streams do %>
  <%#
    Use instance var (set in controller) to avoid calling `current_user` outside a request context.
  %>
  <%= turbo_stream_from([@slides_user, "assistant_slides", params[:chat_id].to_s]) %>
<% end %>

<% content_for :turbo_streams do %>
  <%# Decks are saved once; Regenerate redraws this chat's deck with the current slide templates. %>
  <%= link_to generate_slides_assistants_path(chat_id: params[:chat_id], generate: true), class: "cs-regenerate",
              id: "slides-regenerate", data: { turbo: false } do %>
    <i class="ti ti-refresh"></i> Regenerate
  <% end %>
<% end %>

<% if defined?(@slides_html) && @slides_html.present? %>
  <%= @slides_html.html_safe %>
<% else %>
  <section>
    <div class="p-10">
      <h2 class="text-2xl font-semibold text-slate-900">Generating slides…</h2>
      <p class="mt-2 text-slate-700">This may take a minute. This page will update automatically.</p>
    </div>
  </section>
<% end %>
