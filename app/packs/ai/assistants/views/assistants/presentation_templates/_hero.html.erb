<section class="h-full w-full bg-slate-50 flex items-center justify-center p-0 overflow-hidden relative selection:bg-blue-100">
  <!-- Subtle Background Pattern -->
  <div class="absolute inset-0 z-0 opacity-[0.4]" style="background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 32px 32px;"></div>

  <!-- Gradient Blob for Depth -->
  <div class="absolute -top-[20%] -right-[10%] w-[600px] h-[600px] bg-blue-100/50 rounded-full blur-3xl opacity-60"></div>
  <div class="absolute -bottom-[20%] -left-[10%] w-[500px] h-[500px] bg-indigo-50/60 rounded-full blur-3xl opacity-60"></div>

  <div class="relative z-10 max-w-5xl w-full px-12 flex flex-col justify-center h-full">

    <!-- Top Meta -->
    <div class="absolute top-12 left-12 flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center shadow-sm">
        <i class="ti ti-<%= local_assigns[:icon].presence || 'rocket' %> text-lg"></i>
      </div>
      <span class="text-xs font-semibold text-slate-500 tracking-wider uppercase">Intelligence Report</span>
    </div>

    <!-- Main Content -->
    <div class="space-y-8">
      <div class="inline-block px-3 py-1 bg-blue-50 border border-blue-100 rounded-full text-blue-600 text-xs font-semibold tracking-wide uppercase mb-4">
        <%= Date.today.strftime("%B %Y") %> Update
      </div>

      <h1 class="text-7xl font-bold text-slate-900 tracking-tight leading-[1.1]">
        <%= title %>
      </h1>

      <% if local_assigns[:subtitle].present? %>
        <p class="text-3xl text-slate-500 font-light leading-relaxed max-w-3xl border-l-4 border-blue-500 pl-6 mt-8">
          <%= subtitle %>
        </p>
      <% end %>
    </div>

    <!-- Bottom Footer -->
    <div class="absolute bottom-12 left-12 right-12 flex items-center justify-between border-t border-slate-200 pt-6">
      <div class="flex gap-8 text-xs font-medium text-slate-400 uppercase tracking-widest">
        <span>Generated by CapHive AI</span>
        <span>Confidential</span>
      </div>
      <div class="text-slate-300">
        <i class="ti ti-command text-xl"></i>
      </div>
    </div>
  </div>
</section>
