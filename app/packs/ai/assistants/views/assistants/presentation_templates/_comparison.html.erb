<%# Two sides compared, each with its own title, icon and points. %>
<%= render layout: "assistants/presentation_templates/frame", locals: { slide:, index:, total:, record:, date:, kicker: "Comparison" } do %>
  <div class="cs-compare">
    <% [slide["left"], slide["right"]].each do |side| %>
      <div class="cs-card cs-compare-side">
        <div class="cs-card-title"><span class="cs-icon cs-icon-sm"><i class="ti ti-<%= side["icon"] %>"></i></span><%= side["title"] %></div>
        <ul class="cs-notes">
          <% Array(side["items"]).first(6).each do |item| %>
            <li><i class="ti ti-point"></i><span><%= item %></span></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
<% end %>
