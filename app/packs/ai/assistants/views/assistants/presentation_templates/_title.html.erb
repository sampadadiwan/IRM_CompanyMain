<%# The deck's opening slide: what it is about, and up to three headline numbers. %>
<section class="cs-section" data-slide-template="title">
  <div class="cs-slide cs-title-slide">
    <div class="cs-title-grid">
      <div>
        <div class="cs-kicker"><span class="cs-icon cs-icon-sm"><i class="ti ti-<%= slide["icon"] %>"></i></span><%= record.presence || "CapHive" %></div>
        <h1 class="cs-hero"><%= slide["title"] %></h1>
        <% if slide["subtitle"].present? %><p class="cs-subtitle"><%= slide["subtitle"] %></p><% end %>
      </div>
      <% if Array(slide["figures"]).any? %>
        <div class="cs-hero-figures">
          <% slide["figures"].first(3).each do |figure| %>
            <div class="cs-hero-figure">
              <div class="cs-figure-value"><%= figure["value"] %></div>
              <div class="cs-figure-label"><%= figure["label"] || figure["text"] %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <footer class="cs-foot">
      <span><%= [record.presence, date].compact.join(" · ") %> · Generated by CapHive AI from the conversation</span>
      <span data-slide-number><%= index %> / <%= total %></span>
    </footer>
  </div>
</section>
