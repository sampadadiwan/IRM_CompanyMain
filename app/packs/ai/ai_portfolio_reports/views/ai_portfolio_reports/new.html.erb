<div class="container mt-4"
     data-controller="ai-portfolio-report-form"
     data-ai-portfolio-report-form-investor-folders-value="<%= Investor.where(category: 'Portfolio Company').where.not(document_folder_id: nil).joins(:document_folder).pluck(:id, :document_folder_id, 'folders.documents_count').map { |id, fid, count| [id.to_s, { folder_id: fid, doc_count: count.to_i }] }.to_h.to_json %>"
     data-ai-portfolio-report-form-new-investor-url-value="<%= new_investor_path(investor: { entity_id: current_user.entity.id }, default_category: 'Portfolio Company', return_to: request.path) %>">

  <h1>Create New AI Portfolio Report</h1>
  
  <%= form_with model: @report, class: 'mt-4' do |f| %>
    <% if @report.errors.any? %>
      <div class="alert alert-danger">
        <h5>Errors:</h5>
        <ul>
          <% @report.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <div class="mb-3">
      <%= f.label :portfolio_company_id, 'Portfolio Company', class: 'form-label' %>
      <%= f.collection_select :portfolio_company_id, 
          Investor.where(category: 'Portfolio Company').order(:name), 
          :id, :name, 
          { prompt: 'Select a portfolio company' }, 
          class: 'form-control',
          data: { ai_portfolio_report_form_target: 'portfolioSelect', action: 'change->ai-portfolio-report-form#portfolioCompanyChanged' } %>


          <small>
            <a href="#" class="text-primary" data-action="click->ai-portfolio-report-form#openNewInvestor">+ Create new portfolio company</a>
            <span class="mx-2">|</span>
            <a href="#" class="text-primary" style="display: none;" data-ai-portfolio-report-form-target="manageDocumentsLink" data-action="click->ai-portfolio-report-form#openDocuments">Manage Documents</a>
          </small>




    </div>
    
    <div class="mb-3">
      <%= f.label :report_date, class: 'form-label' %>
      <%= f.date_field :report_date, class: 'form-control', value: Date.today %>
    </div>
    
    <!-- NEW: Investment Fit Criteria Section -->
  <hr class="my-4">
  <h4>Investment Fit Criteria</h4>
  <p class="text-muted">Define the evaluation criteria used to assess how well this company aligns with your investment thesis. 
  The AI will analyze the company's pitch deck and documents against each criterion and provide a fit rating 
  (Strong Fit, Moderate Fit, Weak Fit, or Not Applicable) with supporting evidence.</p>

  <div class="template-selection">
  
    <% if @templates.any? %>
      <div class="form-check mt-2">
        <%= radio_button_tag :template_action, 'use_existing', false, class: "form-check-input", data: { action: 'change->ai-portfolio-report-form#templateActionChanged' } %>
        <%= label_tag :template_action_use_existing, "Use existing template", class: "form-check-label" %>
      </div>
      
      <div id="existing-template-select" class="ml-4 mt-2" style="display: none;" data-ai-portfolio-report-form-target="existingTemplateSelect">

          <%= select_tag :investment_criteria_template_id, 
            options_from_collection_for_select(@templates, :id, :name_with_usage),
            prompt: "-- Select a Template --",
            class: "form-control",
            data: { ai_portfolio_report_form_target: 'templateSelect' } %>

        <button type="button" class="btn btn-link" data-action="click->ai-portfolio-report-form#previewTemplate">Preview</button>

        <div class="mt-2" style="display: none;" data-ai-portfolio-report-form-target="templatePreview"></div>

      </div>
    <% end %>

    <div class="form-check mt-2">
      <%= radio_button_tag :template_action, 'create_new', false, class: "form-check-input", data: { action: 'change->ai-portfolio-report-form#templateActionChanged' } %>

      <%= label_tag :template_action_create_new, "Create new template", class: "form-check-label" %>
    </div>

        <div id="new-template-form" class="ml-4 mt-3" style="display: none;" data-ai-portfolio-report-form-target="newTemplateForm">

      <div class="form-group">
        <%= label_tag "new_template[name]", "Template Name" %>
        <%= text_field_tag "new_template[name]", nil, 
            placeholder: "e.g., Series A Tech Standard",
            class: "form-control" %>
      </div>

      <label>Evaluation Criteria</label>
            <div id="criteria-container" data-ai-portfolio-report-form-target="criteriaContainer">

        <!-- Dynamic criteria rows added by JS -->
        <div class="criteria-row d-flex mb-2">
          <%= text_field_tag "new_template[criteria][0][name]", nil,
              placeholder: "e.g., Team & Leadership", class: "form-control mr-2", style: "flex: 0.35" %>
          <%= text_field_tag "new_template[criteria][0][value]", nil,
              placeholder: "e.g., Founder experience >10 years", class: "form-control mr-2", style: "flex: 0.6" %>
                    <button type="button" class="btn btn-danger btn-sm" data-action="click->ai-portfolio-report-form#removeCriterion">×</button>

        </div>
      </div>
            <button type="button" class="btn btn-link" data-action="click->ai-portfolio-report-form#addCriterion">+ Add Another Criterion</button>

      
      <p class="text-muted mt-2">
        <small>This template will be automatically saved for future use.</small>
      </p>
    </div>
  </div>



    <div class="mt-4">
      <%= f.submit 'Create Report', class: 'btn btn-primary' %>
      <%= link_to 'Cancel', ai_portfolio_reports_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>



</div>
