<%# Run-scoring target selector. Mirrors the Portfolio Company Dashboard's
    "Run on" pattern: all / specific companies / by sector / by tag, plus an
    "unscored only" mode so an FM can fill gaps without paying for a full re-run.

    Every mode is re-resolved server-side against entity_id and a non-blank
    sector — see PortfolioScoringDashboardController#resolve_target_ids. %>
<div class="modal fade" id="run-scoring-batch-modal" tabindex="-1"
     aria-labelledby="run-scoring-batch-modal-label" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <%= form_with url: run_scoring_portfolio_scoring_dashboard_path,
                    method: :post, data: { turbo: false } do %>
        <div class="modal-header">
          <h5 class="modal-title" id="run-scoring-batch-modal-label">
            <i class="ti ti-robot"></i> Run Scoring Agent
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body" data-controller="scoring-run-target">
          <%# The agent's own description of what a run does — kept in one place
              on the service class rather than duplicated into this view. %>
          <p class="text-muted"><%= PortfolioScoringAgent::DESCRIPTION %></p>

          <div class="alert alert-secondary py-2">
            <small>
              <i class="ti ti-info-circle"></i>
              Only companies with a sector set can be scored — the sector selects which
              skill file the agent uses. <strong><%= portfolio_companies.size %></strong>
              of <%= total_portfolio_companies %> companies qualify.
              <%# Both figures are portfolio-wide on purpose: a run is not limited
                  to the sector/tag the page is scoped to, so quoting the scoped
                  total here would read as "40 of 5". %>
            </small>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold" for="scoring-target-mode">Run on</label>
            <select class="form-select" id="scoring-target-mode" name="target_mode"
                    data-action="change->scoring-run-target#modeChanged">
              <option value="all">All portfolio companies with a sector</option>
              <option value="unscored">Only companies never scored (<%= presenter.not_scored_breakdown[:never_run] %>)</option>
              <option value="selected">Specific companies</option>
              <option value="by_sector">By sector</option>
              <option value="by_tag">By tag</option>
            </select>
          </div>

          <%# Each selector is hidden until its mode is chosen. Kept in the DOM
              rather than lazily loaded so the form submits whatever is visible. %>
          <div class="mb-3 d-none" data-scoring-run-target-target="selectedPanel">
            <label class="form-label" for="scoring-target-ids">Companies</label>
            <select class="form-select" id="scoring-target-ids" name="target_ids[]" multiple size="10">
              <% portfolio_companies.each do |name, id| %>
                <option value="<%= id %>"><%= name %></option>
              <% end %>
            </select>
            <small class="text-muted">Hold Ctrl/Cmd to select more than one.</small>
          </div>

          <div class="mb-3 d-none" data-scoring-run-target-target="sectorPanel">
            <label class="form-label" for="scoring-target-sectors">Sectors</label>
            <select class="form-select" id="scoring-target-sectors" name="target_sectors[]" multiple size="8">
              <%# sectors_for_select is a [sector, count] tally, same as tags —
                  taking the pair as one variable put the whole array in the
                  option value, so every "by sector" run matched nothing. %>
              <% sectors_for_select.each do |sector, count| %>
                <option value="<%= sector %>"><%= sector %> (<%= count %>)</option>
              <% end %>
            </select>
          </div>

          <div class="mb-3 d-none" data-scoring-run-target-target="tagPanel">
            <label class="form-label" for="scoring-target-tags">Tags</label>
            <select class="form-select" id="scoring-target-tags" name="target_tags[]" multiple size="8">
              <% tags_for_select.each do |tag, count| %>
                <option value="<%= tag %>"><%= tag %> (<%= count %>)</option>
              <% end %>
            </select>
          </div>

          <details>
            <summary class="text-muted"><small>What the agent does on each company</small></summary>
            <pre class="text-muted mt-2 mb-0" style="white-space: pre-wrap;"><%= PortfolioScoringAgent::LONG_DESCRIPTION %></pre>
          </details>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <i class="ti ti-player-play"></i> Start Scoring
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
