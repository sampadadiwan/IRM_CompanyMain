<%# Headline strip — the single figure the FM repeats in an IC meeting.
    Five tier cards make the reader assemble this themselves; stating it is the
    page's job. Three parts: the portfolio score with its movement, a stacked
    share-of-portfolio bar, and the value sitting in the tiers needing action. %>
<%
  # When a tier or movement filter is active, the hero describes THAT selection
  # rather than the whole book — otherwise clicking "Watch List" leaves the
  # biggest element on the page showing numbers that have nothing to do with
  # what is now on screen. The portfolio figure stays visible underneath so the
  # selection can be read against it.
  selection        = presenter.reports_for_filter(status_filter)
  filtered         = status_filter.present?
  portfolio_score  = presenter.headline_score

  # "Not Scored" has no average to show, and its true size is larger than the
  # selection: companies with no report at all never appear in reports_for_filter.
  # It therefore shows a count, not a score.
  unscored_view    = status_filter == PortfolioScoringPresenter::NOT_SCORED[:slug]
  selection_size   = unscored_view ? presenter.not_scored_count : selection.size

  headline         = filtered ? presenter.average_score_of(selection) : portfolio_score
  headline_tier    = presenter.tier_for(headline)
  delta            = filtered ? presenter.average_delta_of(selection) : presenter.headline_delta
  compared_count   = filtered ? selection.count { |r| presenter.delta_for(r) } : presenter.comparable_count

  attention_value  = filtered ? presenter.value_cents_of(selection) : presenter.value_needing_attention_cents
  attention_count  = filtered ? selection_size : presenter.counts_by_tier["watch"] + presenter.counts_by_tier["at_risk"]
%>
<div class="card sd-hero mb-3 <%= headline_tier ? "sd-tier--#{headline_tier}" : "sd-tier--not_scored" %>">
  <div class="card-body">
    <div class="row g-4 align-items-center">

      <%# ── Portfolio score ─────────────────────────────────────────────── %>
      <div class="col-md-4">
        <div class="d-flex align-items-center gap-3">
          <div class="sd-hero-score">
            <b><%= unscored_view ? selection_size : (headline || "—") %></b>
            <small>
              <% if unscored_view %>
                companies
              <% elsif filtered %>
                avg of <%= selection_size %>
              <% else %>
                avg of <%= presenter.scored_reports.size %> scored
              <% end %>
            </small>
          </div>

          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="sd-hero-title"
                    data-bs-toggle="tooltip"
                    title="<%= filtered ?
                              "Mean score of the #{selection.size} selected #{'company'.pluralize(selection.size)}." :
                              "Mean of every company's 0-100 score, across the #{presenter.scored_reports.size} scored. The #{presenter.not_scored_count} unscored #{'company'.pluralize(presenter.not_scored_count)} are excluded. Switch to By value to weight by FMV instead." %>">
                <%= filtered ? presenter.filter_label(status_filter) : "Portfolio Score" %>
              </span>
              <% if filtered %>
                <%= link_to scoring_dashboard_path_with(status: nil),
                      class: "sd-clear text-decoration-none", data: { turbo: false },
                      "data-bs-toggle": "tooltip",
                      title: "Clear the filter and show the whole portfolio" do %>
                  <i class="ti ti-x"></i> Clear filter
                <% end %>
              <% end %>
              <% if headline && !unscored_view %>
                <span class="badge sd-solid"
                      data-bs-toggle="tooltip"
                      title="Grade band for the portfolio score. Bands come from the 0-100 score, not from any grade text.">
                  <i class="ti <%= presenter.tier_meta(headline_tier.to_s)[:icon] %>"></i>
                  <%= presenter.band_for(headline) %>
                </span>
              <% end %>
              <span class="badge bg-light text-dark border"
                    data-bs-toggle="tooltip"
                    title="<%= basis == :value ? 'Weighted by portfolio FMV, so a large holding moves this more than a small one.' : 'A plain average across every scored company.' %>">
                <i class="ti <%= basis == :value ? 'ti-coin' : 'ti-building' %>"></i>
                <%= basis == :value ? "Value weighted" : "Company average" %>
              </span>
            </div>

            <div class="mt-1">
              <% if unscored_view %>
                <% b = presenter.not_scored_breakdown %>
                <small class="text-muted">
                  <%= [("#{b[:failed]} failed" if b[:failed].positive?),
                       ("#{b[:no_sector]} no sector" if b[:no_sector].positive?),
                       ("#{b[:never_run]} never run" if b[:never_run].positive?)].compact.join(" · ") %>
                </small>
              <% elsif delta.nil? %>
                <small class="text-muted"
                       data-bs-toggle="tooltip"
                       title="Movement needs a second scoring run to compare against.">
                  <i class="ti ti-minus"></i> No prior run to compare
                </small>
              <% else %>
                <% delta_color = delta.positive? ? "success" : (delta.negative? ? "danger" : "secondary") %>
                <span class="badge bg-<%= delta_color %>-subtle text-<%= delta_color %>"
                      data-bs-toggle="tooltip"
                      title="Average score change per company, across the <%= compared_count %> <%= filtered ? 'selected companies' : 'companies' %> that have a previous run.">
                  <i class="ti ti-<%= delta.positive? ? 'arrow-up' : (delta.negative? ? 'arrow-down' : 'minus') %>"></i>
                  <%= delta.positive? ? "+" : "" %><%= delta %> avg
                </span>
                <small class="text-muted ms-1">since last run</small>
              <% end %>
            </div>

            <% if !filtered && presenter.not_scored_count.positive? %>
              <%# The headline covers only scored companies — say so rather than
                  letting it read as a figure for the whole book. %>
              <small class="text-muted d-block mt-1">
                Excludes
                <%= link_to scoring_dashboard_path_with(status: "not_scored"),
                      class: "text-decoration-underline", data: { turbo: false } do %><%= presenter.not_scored_count %> unscored<% end %>
                of <%= presenter.total_companies %> companies
              </small>
            <% end %>

            <% if filtered && portfolio_score && !unscored_view %>
              <%# Anchor the selection against the whole book. %>
              <small class="text-muted d-block mt-1">
                Whole portfolio: <strong><%= portfolio_score %></strong>
                across <%= presenter.total_companies %> companies
              </small>
            <% end %>
          </div>
        </div>
      </div>

      <%# ── Stacked share bar ───────────────────────────────────────────── %>
      <%# One line answering "how much of the book is in trouble" — the question
          five separate cards make you compute. %>
      <div class="col-md-5">
        <div class="d-flex justify-content-between align-items-baseline mb-1">
          <small class="text-muted fw-semibold">
            Share of portfolio
            <i class="ti ti-info-circle"
               data-bs-toggle="tooltip"
               title="Every portfolio company, by tier. Widths are <%= basis == :value ? 'portfolio FMV' : 'company count' %>."></i>
          </small>
          <small class="text-muted">
            <%= presenter.total_companies %> <%= "company".pluralize(presenter.total_companies) %>
          </small>
        </div>

        <div class="progress sd-share">
          <% PortfolioScoringPresenter::TIERS.each do |tier| %>
            <% share = presenter.share_for_tier(tier[:slug]) %>
            <% next if share.zero? %>
            <div class="progress-bar sd-tier--<%= tier[:slug] %> <%= "is-dimmed" if filtered && status_filter != tier[:slug] %>"
                 style="width: <%= share %>%;"
                 data-bs-toggle="tooltip"
                 title="<%= presenter.label_for(tier[:slug]) %> — <%= presenter.counts_by_tier[tier[:slug]] %> companies, <%= share %>%">
              <% if share >= 10 %><%= share.round %>%<% end %>
            </div>
          <% end %>
          <%# Same basis as the tier segments, so the bar totals 100% in both
              modes — this used to be a company-count share sitting next to
              value-weighted segments, overflowing the bar to ~116%. %>
          <% not_scored_share = presenter.share_for_not_scored %>
          <% if not_scored_share.positive? %>
            <div class="progress-bar sd-tier--not_scored <%= "is-dimmed" if filtered && status_filter != "not_scored" %>"
                 style="width: <%= not_scored_share %>%;"
                 data-bs-toggle="tooltip"
                 title="Not Scored — <%= presenter.not_scored_count %> companies, <%= not_scored_share %>% of portfolio <%= basis == :value ? 'value' : 'count' %>">
            </div>
          <% end %>
        </div>

        <%# Legend doubles as the tier key, with icons so tier is not encoded by
            colour alone. %>
        <div class="d-flex flex-wrap gap-3 mt-2">
          <% PortfolioScoringPresenter::TIERS.each do |tier| %>
            <small class="text-muted d-flex align-items-center gap-2 sd-tier--<%= tier[:slug] %>">
              <span class="sd-legend-dot"></span>
              <%= tier[:label] %>
            </small>
          <% end %>
        </div>
      </div>

      <%# ── Value needing attention ─────────────────────────────────────── %>
      <div class="col-md-3">
        <div class="border-start ps-3 h-100">
          <small class="text-muted d-block">
            <%= filtered ? "Selected value" : "Needs attention" %>
            <i class="ti ti-info-circle"
               data-bs-toggle="tooltip"
               title="Portfolio FMV held by companies on the Watch List or At Risk. Falls back to invested amount where no valuation is recorded."></i>
          </small>
          <div class="sd-hero-figure">
            <%= presenter.format_cents(attention_value) %>
          </div>
          <%= link_to scoring_dashboard_path_with(status: "watch"),
                class: "text-decoration-none", data: { turbo: false } do %>
            <span class="badge bg-warning-subtle text-warning">
              <i class="ti ti-eye"></i> <%= presenter.counts_by_tier["watch"] %> watch
            </span>
          <% end %>
          <%= link_to scoring_dashboard_path_with(status: "at_risk"),
                class: "text-decoration-none", data: { turbo: false } do %>
            <span class="badge bg-danger-subtle text-danger">
              <i class="ti ti-alert-triangle"></i> <%= presenter.counts_by_tier["at_risk"] %> at risk
            </span>
          <% end %>
          <small class="text-muted d-block mt-1"><%= attention_count %> of <%= presenter.total_companies %> companies</small>
        </div>
      </div>

    </div>
  </div>
</div>
