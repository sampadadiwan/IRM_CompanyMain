
<%= render "/layouts/steps", steps: ["Setup Secondary Sales", "Customize Sale", "Setup Access Rights",
                        "View/Approve Offers", "Receive/Shortlist Interests"].freeze if current_user.has_cached_role?(:employee) %>

  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Secondary Sales</h1>
    <%= link_to t('secondaries_actions.new_secondary_sale') , new_secondary_sale_path("secondary_sale[entity_id]": current_user.entity_id),
      {class: "btn btn-outline-primary ti ti-plus" } if current_user.has_cached_role?(:employee) %>
  </div>

  <%# D21 — the firm's chosen columns (or the list's own, SecondarySale::LIST_COLUMNS), sorted, searched and paged in
      the page by jQuery DataTables (sortable: false, pagy: nil). openspec/changes/grid-columns-inline-settings %>
  <%# Headings translated as the hand-built list's were (secondaries_actions.<label>, e.g. total_offered; the label itself when there is no translation) %>
  <% list_columns = SecondarySale::LIST_COLUMNS.to_h { |label, key| [t("secondaries_actions.#{label.parameterize(separator: '_')}", default: label), key] } %>
  <% secondary_sales_table = RansackTable.new(SecondarySale, q: @q, default_columns_map: list_columns,
                                              current_user: current_user, records: @secondary_sales, turbo_frame: "_top",
                                              referrer: request.referrer, pagy: nil, table_css_class: "jqDataTable", sortable: false) %>
  <div data-controller="datatable" data-datatable-money-columns-value="<%= secondary_sales_table.money_column_indexes %>">
    <%= render secondary_sales_table %>
  </div>
