<%# One allocation in the Allocations list: the chosen columns (RansackTableRow), then its actions.
    openspec/changes/grid-columns-inline-settings — D21 %>
<%# RansackTable passes a decorated record; SaleBasePolicy picks the role policy from record.class, so ask it with the
    record itself %>
<tr id="<%= dom_id allocation %>">
  <%= render RansackTableRow.new(model: allocation, columns:) %>
  <td>
    <%= link_to  t_common(:show), allocation , {class: "btn btn-outline-primary ti ti-eye"}%>
    <%= link_to  t_common(:edit), edit_allocation_path(allocation), {class: "btn btn-outline-success ti ti-edit"} if policy(allocation.try(:decorated?) ? allocation.object : allocation).update? %>
  </td>
</tr>
