<% options = custom_field.options %>
<% if options.count == 2 %>
    <% value = options[0] if ["true", true, "1", 1].include?(value) %>
    <% value = options[1] if ["false", false, "0", 0].include?(value) %>
    <%= value %>
<% else %>
    <% bool_val = ["true", true, "1", 1].include?(value) %>
    <%= display_boolean(bool_val) %>
<% end %>
