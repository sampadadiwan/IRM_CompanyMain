<% if @form_custom_field.errors.any? %>
  <%# Re-render the form with validation errors back inside the inline panel %>
  <%= turbo_stream.replace "fcf_edit_panel" do %>
    <turbo-frame id="fcf_edit_panel">
      <%= render FormCard.new(title: "Edit Custom Field: #{@form_custom_field.human_label}") do %>
        <%= render "form", form_custom_field: @form_custom_field %>
      <% end %>
    </turbo-frame>
  <% end %>
<% else %>
  <%# Replace the table row with the freshly-saved field values %>
  <%= turbo_stream.replace "fcf_row_#{@form_custom_field.id}" do %>
    <%= render "form_custom_field", f: @form_custom_field %>
  <% end %>
  <%# Clear the inline edit panel %>
  <%= turbo_stream.update "fcf_edit_panel", "" %>
<% end %>
