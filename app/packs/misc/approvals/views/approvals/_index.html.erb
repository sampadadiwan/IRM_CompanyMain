
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Approvals</h1>
  <% if policy(Approval.new(entity_id: current_user.entity_id)).new? %>
    <%= link_to new_approval_path, class: "btn btn-outline-primary" do %>
      <i class="ti ti-checkup-list"></i>New Approval
    <% end %>
  <% end %>

</div>

<%# D21 — the firm's chosen columns (or the list's own: Approval::LIST_COLUMNS, plus Responses Status for the firm's
    own users), sorted, searched and paged in the page by jQuery DataTables (sortable: false, pagy: nil).
    openspec/changes/grid-columns-inline-settings %>
<% show_stats = ["Company", "Investment Fund", "Angel Fund"].include?(current_user.entity_type) %>
<% approvals_table = RansackTable.new(Approval, q: @q, default_columns_map: show_stats ? Approval::LIST_COLUMNS_WITH_STATS : Approval::LIST_COLUMNS,
                                      current_user: current_user, records: approvals, turbo_frame: "_top", referrer: request.referrer,
                                      pagy: nil, table_css_class: "jqDataTable", sortable: false) %>
<div data-controller="datatable" data-datatable-money-columns-value="<%= approvals_table.money_column_indexes %>">
  <%= render approvals_table %>
</div>
