<%# One approval in the Approvals list: the chosen columns (RansackTableRow), then its actions.
    openspec/changes/grid-columns-inline-settings — D21 %>
<tr id="<%= dom_id approval %>">
  <%= render RansackTableRow.new(model: approval, columns:) %>
  <td>
    <%= link_to  t_common(:show) , approval , {class: "btn btn-outline-primary ti ti-eye" }%>
  </td>
</tr>
