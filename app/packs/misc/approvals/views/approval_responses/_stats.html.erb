<% colors = ["success", "warning", "danger", "primary", "secondary", "info"].freeze %>

<% index = 0 %>
<div class="row">
    
    <% status_count = approval_responses.group(:status).count %>
    <% approval.response_status&.split(',')&.each do |status| %>
    <% 
        color = colors[index % colors.length]; index += 1 
        count = status_count[status] || 0
    %>
    <div class="col">
        <a href="<%= approval_responses_path(approval_id: approval&.id, status:) %>" data-turbo-frame="approval_responses">
            <div class="card border-top stat-card-accent border-<%=color%> shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                <div>
                    <h3 class="fs-8"><%= count %></h3>
                    <h6 class="card-subtitle mb-1 text-<%=color%>"><%= status %></h6>
                </div>
                <div class="ms-auto">
                    <span class="text-<%=color%> display-6 number-stats-icon"><i class="ti ti-clipboard-text"></i></span>
                </div>
                </div>


            </div>
            </div>
        </a>
    </div>
    <% end %>

    <% color = "success" %>
    <div class="col">
        <a href="<%= approval_responses_path(approval_id: approval&.id, status: nil) %>" data-turbo-frame="approval_responses">
            <div class="card border-top stat-card-accent border-<%=color%> shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                <div>
                    <h3 class="fs-8"><%= approval_responses.count %></h3>
                    <h6 class="card-subtitle mb-1 text-<%=color%>">All</h6>
                </div>
                <div class="ms-auto">
                    <span class="text-<%=color%> display-6 number-stats-icon"><i class="ti ti-clipboard-text"></i></span>
                </div>
                </div>


            </div>
            </div>
        </a>
    </div>
  
</div>