<%# One response in the Approval Responses list: the chosen columns (RansackTableRow), then its actions.
    openspec/changes/grid-columns-inline-settings — D21 %>
<tr id="<%= dom_id approval_response %>">
  <%= render RansackTableRow.new(model: approval_response, columns:) %>
  <td>
    <%= link_to  t_common(:show) , approval_response , {class: "btn btn-outline-primary" }%>
    <% if policy(approval_response).update? %>
      <%= link_to  t_common(:edit) , edit_approval_response_path(approval_response) , {class: "btn btn-outline-success" }%>
    <% end %>
    <%= render "/approval_responses/quick_response", approval_response: approval_response if policy(approval_response).approve? %>
  </td>
</tr>
