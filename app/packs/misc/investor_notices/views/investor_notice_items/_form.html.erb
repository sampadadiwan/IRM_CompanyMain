<div class='nested-fields row'>

    <div class="form-group col-md-2">
        <%= form.label :position %>
        <%= form.text_field :position, class: "form-control" %>
    </div>

    <div class="form-group col-md-2">
      <%= form.label :title %>
      <%= form.text_field :title, class: "form-control"  %>
    </div>

    <div class="form-group col-md-2">
      <%= form.label :details %>
      <%= form.text_area :details, class: "form-control"  %>
    </div>

    <%# link can carry [user.xxx] variables (InvestorNoticeLinkInterpolator) —
        support only, same gate as InvestorNotice#criteria. %>
    <% if current_user.support? %>
      <div class="form-group col-md-2">
        <%= form.label :link %>
        <%= form.text_field :link, class: "form-control", placeholder: "[user.entity.sub_domain]" %>
      </div>
    <% end %>

</div>
