<%= render NewCard.new do %>
    <%= render FormCard.new(title: "Upload : #{@import_upload.import_type}") do %>
        <%= render "form", import_upload: @import_upload %>
    <% end %>
<% end %>

<%= render "xlsx_preview", import_upload: @import_upload %>

<% if @import_upload.import_type.blank? %>
    <%= render NewCard.new(col_md: "col-lg-5") do %>
        <%= render FormCard.new(title: "Templates") do %>
            <table class="table table-bordered  dataTable">
                <% ImportUpload::SAMPLES.sort.each do |name, path| %>
                <tr>
                    <td><%= link_to name.humanize, path %></td>
                </tr>
                <% end %>
            </table>
        <% end %>
    <% end %>
<% end %>
