<tr id="<%= dom_id import_upload %>">
  <td>
    <%= import_upload.name %>
  </td>
  <td>
    <%= link_to import_upload.owner %>
  </td>
  <td>
    <%= import_upload.user.full_name %>
  </td>
  <td>
    <%= import_upload.import_type %>
  </td>
  <td>
    <%# A running import has partial counts, so it must not fall through to Failed %>
    <% if import_upload.in_progress? %>
      <span class="badge bg-info">In Progress</span>
    <% elsif import_upload.failed? %>
      <span class="badge bg-danger">Failed</span>
    <%# The warning itself is shown in the Status row on the upload's page %>
    <% elsif import_upload.success_with_warnings? %>
      <span class="badge bg-warning" title="<%= import_upload.status %>">Success with warnings</span>
    <% else %>
      <span class="badge bg-success">Success</span>
    <% end %>

  </td>
  <td>
    <%= import_upload.processed_row_count %> / <%= import_upload.total_rows_count %>  
  </td>
  <td>
    <%= l import_upload.created_at %>  
  </td>
  <td>
    <%= link_to  t_common(:show), import_upload , {class: "btn btn-outline-primary ti ti-eye"}%>
  </td>
</tr>
