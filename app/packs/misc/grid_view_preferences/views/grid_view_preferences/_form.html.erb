<%# Edit one saved grid column (heading, data type, alignment, position; a derived field's key). Saving goes back
    to Configure Grids with this column open on the right, so the list there is current.
    openspec/changes/grid-columns-inline-settings — D19 %>
<% owner = grid_view_preference.owner %>
<div class="card-header d-flex justify-content-between align-items-center">
  <h5 class="card-title mb-0"><i class="ti ti-edit me-1 text-primary"></i>Edit <%= grid_view_preference.clean_label %></h5>
  <%= link_to grid_view_preference_path(grid_view_preference), class: "btn-close", aria: { label: "Close" },
              data: { turbo_frame: "grid_column_detail" } do %><% end %>
</div>
<div class="card-body">
  <%= form_with(model: grid_view_preference, id: "grid_view_form", data: { turbo_frame: "_top" }) do |form| %>
    <% if grid_view_preference.errors.any? %>
      <div class="alert alert-danger py-2 small">
        <% grid_view_preference.errors.full_messages.each do |message| %><div><%= message %></div><% end %>
      </div>
    <% end %>

    <% if grid_view_preference.derived_field %>
      <div class="mb-3">
        <%= form.label :key, "Key", class: "form-label" %>
        <%= form.text_field :key, class: "form-control", maxlength: 255, placeholder: "e.g. investor.custom_fields.relationship_manager" %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :label, "Heading", class: "form-label" %>
      <%# The heading as shown (no "; css" part); the alignment suffix is kept on save %>
      <%= form.text_field :label, value: grid_view_preference.clean_label, class: "form-control", placeholder: grid_view_preference.clean_name %>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-6">
        <%= form.label :data_type, "Data type", class: "form-label" %>
        <%= form.select :data_type, options_for_select(GridColumnsSave::DATA_TYPES, grid_view_preference.data_type), { include_blank: "Default" }, class: "form-select" %>
      </div>
      <div class="col-6">
        <%= form.label :alignment, "Alignment", class: "form-label" %>
        <%= form.select :alignment, options_for_select([["Left", "text-start"], ["Centre", "text-center"], ["Right", "text-end"]], grid_view_preference.alignment), { include_blank: "Default" }, class: "form-select" %>
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :sequence, "Position", class: "form-label" %>
      <%= form.number_field :sequence, class: "form-control", min: 1 %>
    </div>

    <div class="d-flex justify-content-end gap-2">
      <%= link_to "Cancel", grid_view_preference_path(grid_view_preference), class: "btn btn-sm btn-link text-muted text-decoration-none",
                  data: { turbo_frame: "grid_column_detail" } %>
      <%= form.button type: "submit", class: "btn btn-sm btn-primary rounded-pill px-3" do %>
        <i class="ti ti-check me-1"></i><%= t_common(:save) %>
      <% end %>
    </div>
  <% end %>
</div>
