<%# Configure Grids: the same columns editor as the side panel, embedded in the page, with Show / Edit / Delete on
    each saved column; Show and Edit open in the detail panel on the right (Turbo frame "grid_column_detail").
    openspec/changes/grid-columns-inline-settings — D19; H16, H17, E26, E27, X20 %>
<div class="row g-3">
  <div class="col-xl-7">
    <div class="card h-100" data-controller="grid-columns" data-grid-columns-embedded="true">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">
          <i class="ti ti-table-options me-1 text-primary"></i>Grid columns: <%= @parent %>
          <i class="ti ti-info-circle text-muted fs-5" data-bs-toggle="tooltip"
             title="The columns every table of this record type shows (or this report's columns), in order. The same list opens from the Columns button next to a table's search box."></i>
        </h3>
      </div>
      <div class="card-body">
        <%= render "grid_columns/editor", context: @context, rows: @rows, errors: nil, reset: false,
                                          embedded: true, can_save: @can_save %>
      </div>
    </div>
  </div>
  <div class="col-xl-5">
    <%# Show / Edit of one saved column load here %>
    <div class="card grid-column-detail-card">
      <%= turbo_frame_tag "grid_column_detail", src: (grid_view_preference_path(params[:show_id]) if params[:show_id].present?) do %>
        <%= render "grid_view_preferences/detail_empty" %>
      <% end %>
    </div>
  </div>
</div>
