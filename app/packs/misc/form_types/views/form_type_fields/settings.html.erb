<%# ③ The custom fields side panel's body, inside the "form_type_fields" frame. Same look as the widget settings
    and table columns panels. openspec/changes/grid-columns-inline-settings — phase 4; H10, H11, E14, E16, E21, X13–X15 %>
<% note, note_tip = form_type_fields_note(@model_class, @form_type) %>
<%= turbo_frame_tag "form_type_fields", class: "widget-settings-frame" do %>
  <div class="offcanvas-header widget-settings-header">
    <div class="min-w-0">
      <h5 class="offcanvas-title mb-1 text-truncate" id="form_type_fields_title">
        <i class="ti ti-forms me-1 text-primary"></i><%= form_type_fields_title(@model_class) %>
        <span class="text-muted fw-normal">· <%= @form_type.tag.presence || "Default" %></span>
      </h5>
      <div class="text-muted small text-truncate" data-form-type-fields-note data-bs-toggle="tooltip"
           data-bs-container=".form-type-fields-panel" title="<%= note_tip %>">
        <i class="ti ti-users me-1"></i><%= note %>
      </div>
    </div>
    <button type="button" class="btn-close ms-2" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <%= form_with url: save_form_type_fields_path, method: :patch, class: "widget-settings-form grid-columns-editor",
                data: { controller: "form-type-fields-form", action: "submit->form-type-fields-form#serialise" } do %>
    <% if @record %>
      <%= hidden_field_tag :record_type, @record.class.name %>
      <%= hidden_field_tag :record_id, @record.id %>
    <% else %>
      <%= hidden_field_tag :form_type_id, @form_type.id %>
    <% end %>
    <%= hidden_field_tag :fields, "", data: { form_type_fields_form_target: "fields" } %>

    <div class="offcanvas-body widget-settings-body">
      <% if @errors.present? %>
        <div class="alert alert-danger py-2 small" role="alert" data-form-type-fields-errors>
          <% @errors.each do |message| %><div><%= message %></div><% end %>
        </div>
      <% end %>

      <% unless @record %>
        <%# Opened from a form: the page refreshes after saving %>
        <p class="text-danger small" data-form-type-fields-form-note>
          <i class="ti ti-alert-triangle me-1"></i>Saving refreshes this page — anything typed in the form and not yet saved is lost.
        </p>
      <% end %>
      <p class="widget-settings-hint">
        <i class="ti ti-bulb me-1"></i>Drag <i class="ti ti-grip-vertical"></i> to reorder, click a label to rename,
        <i class="ti ti-chevron-down"></i> for help text. Nothing changes until you save.
      </p>

      <label class="form-label">
        <i class="ti ti-list-details widget-settings-field-icon" aria-hidden="true"></i>Fields
        <i class="ti ti-info-circle widget-settings-tip" data-bs-toggle="tooltip" data-bs-container=".form-type-fields-panel"
           title="In the order they appear on the form and this page. Toggles: * required, lock = read only, eye-off = internal (hidden from investors)."></i>
        <span class="ms-auto fw-normal" data-form-type-fields-form-target="count"></span>
      </label>
      <% if @fields.empty? %>
        <p class="text-muted small" data-form-type-fields-empty>No custom fields yet — add one below.</p>
      <% end %>
      <ul class="grid-columns-list" data-form-type-fields-form-target="list">
        <% @fields.each do |field| %>
          <%= render "form_type_fields/row", field: field %>
        <% end %>
      </ul>
      <p class="text-danger small d-none" data-form-type-fields-form-target="removeNote" data-form-type-fields-remove-note>
        <i class="ti ti-alert-triangle me-1"></i>Removed fields disappear from forms and pages; values already entered stay stored.
      </p>

      <label class="form-label">
        <i class="ti ti-plus widget-settings-field-icon" aria-hidden="true"></i>Add a field
        <i class="ti ti-info-circle widget-settings-tip" data-bs-toggle="tooltip" data-bs-container=".form-type-fields-panel"
           title="A new field on the form. Options are for Select fields, separated by commas. Money uses your firm's currency."></i>
      </label>
      <div class="form-type-fields-add mb-3">
        <div class="row g-2">
          <div class="col-7"><input type="text" class="form-control form-control-sm" maxlength="254" placeholder="Label, e.g. Source of funds"
                                    data-form-type-fields-form-target="newLabel" aria-label="New field label"></div>
          <div class="col-5">
            <select class="form-select form-select-sm" data-form-type-fields-form-target="newType" data-action="form-type-fields-form#typeChanged" aria-label="New field type">
              <% FormTypeFieldsSave::NEW_FIELD_TYPES.each do |type| %><option value="<%= type %>"><%= type %></option><% end %>
            </select>
          </div>
          <div class="col-12 d-none" data-form-type-fields-form-target="optionsBox">
            <input type="text" class="form-control form-control-sm" placeholder="Options: Salary, Business, Inheritance"
                   data-form-type-fields-form-target="newOptions" aria-label="New field options">
          </div>
          <div class="col-12 text-end">
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-action="form-type-fields-form#add" data-form-type-fields-add>
              <i class="ti ti-plus me-1"></i>Add
            </button>
          </div>
        </div>
      </div>

      <div class="small text-muted"><i class="ti ti-adjustments me-1"></i>Conditions, validation rules, steps and calculations: on the full form type page.</div>
    </div>

    <div class="widget-settings-footer">
      <% if @form_type.persisted? %>
        <%= link_to edit_form_type_path(@form_type), class: "widget-settings-full-page me-auto",
                    title: "Open the full form type page: conditions, validation rules, steps", aria: { label: "Open the full form type page" },
                    data: { turbo_frame: "_top", bs_toggle: "tooltip", bs_container: ".form-type-fields-panel" } do %>
          <i class="ti ti-external-link"></i>
        <% end %>
      <% else %>
        <span class="me-auto"></span>
      <% end %>
      <button type="button" class="btn btn-sm btn-link text-muted text-decoration-none" data-bs-dismiss="offcanvas">Cancel</button>
      <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3" data-form-type-fields-save
              title="Save, then refresh this page in place" data-bs-toggle="tooltip" data-bs-container=".form-type-fields-panel">
        <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true" data-side-panel-spinner></span>
        <i class="ti ti-check me-1" data-side-panel-save-icon></i>Save
      </button>
    </div>
  <% end %>
<% end %>
