<%# One custom field in the panel. Locals: field (Hash from FormTypeFieldsHelper). A saved field goes back by id
    (name, type and options never come from the browser — E17); a new one by label, type and options.
    Locked: a calculation field for a user who is not CapHive support (E14). %>
<% locked = field[:locked] %>
<%# M14 ⑨ (bank-detail-change-controls H18, X17, X18) — a KYC text field can be a payout field: the bank icon says so,
    the choice sits in the details row; once marked, only CapHive support unmarks or removes it (no "No", no ✕). %>
<% payout_shown = !locked && (field[:payout_markable] || field[:payout_field].present?) %>
<% payout_locked = field[:payout_locked] %>
<li class="grid-columns-row <%= 'locked' if locked %> <%= 'removed' if field[:removed] %>" data-form-type-fields-row
    data-id="<%= field[:id] %>" data-name="<%= field[:name] %>" data-field-type="<%= field[:field_type] %>"
    data-options="<%= field[:options] %>" data-locked="<%= locked %>" data-removed="<%= field[:removed] %>"
    data-required="<%= field[:required] ? 'true' : 'false' %>" data-read-only="<%= field[:read_only] ? 'true' : 'false' %>"
    data-internal="<%= field[:internal] ? 'true' : 'false' %>" draggable="<%= !locked %>">
  <div class="grid-columns-main">
    <i class="ti ti-grip-vertical grid-columns-handle" title="Drag to reorder" aria-hidden="true"></i>
    <div class="grid-columns-name">
      <input type="text" value="<%= field[:label] %>" maxlength="254" aria-label="Label of <%= field[:label] %>"
             data-form-type-fields-label <%= 'disabled' if locked %>>
      <div class="grid-columns-key"><%= field[:name] %></div>
    </div>
    <span class="grid-columns-chip"><%= field[:field_type] == "Calculation" ? raw('<i class="ti ti-math-function"></i> ') : "" %><%= field[:field_type] %></span>
    <% if locked %>
      <span class="grid-columns-chip" title="Calculation fields are changed by CapHive support"><i class="ti ti-lock"></i> Support</span>
    <% else %>
      <% if payout_shown %>
        <span class="form-type-fields-flag <%= 'on' if field[:payout_field].present? %>" data-payout-flag
              title="Payout field: a change needs a second approver. A change to it is treated like a bank account change — Bank Verified is switched off, the investor and approvers are emailed, and a different KYC approver must verify the KYC."
              aria-label="Payout field"><i class="ti ti-building-bank"></i></span>
      <% end %>
      <% if payout_locked %>
        <span class="grid-columns-chip" data-payout-locked
              title="Payout fields are unmarked by CapHive support: unmarking would let one person change this field alone. Ask CapHive support if it should no longer count as bank details."><i class="ti ti-lock"></i> Support</span>
      <% end %>
      <% [["required", "ti-asterisk", "Required"], ["read_only", "ti-lock", "Read only"], ["internal", "ti-eye-off", "Internal: hidden from investors"]].each do |flag, icon, title| %>
        <button type="button" class="form-type-fields-flag <%= 'on' if field[flag.to_sym] %>" data-flag="<%= flag %>"
                data-action="form-type-fields-form#toggleFlag" title="<%= title %>" aria-label="<%= title %>"
                aria-pressed="<%= field[flag.to_sym] ? 'true' : 'false' %>"><i class="ti <%= icon %>"></i></button>
      <% end %>
    <% end %>
    <button type="button" class="grid-columns-icon-btn" data-action="form-type-fields-form#toggleDetails" title="Help text"
            aria-label="Help text of <%= field[:label] %>"><i class="ti ti-chevron-down"></i></button>
    <% unless locked || payout_locked %>
      <button type="button" class="grid-columns-remove" data-action="form-type-fields-form#toggleRemove"
              title="Remove from the form (values already entered stay stored)" aria-label="Remove <%= field[:label] %>">
        <i class="ti <%= field[:removed] ? 'ti-arrow-back-up' : 'ti-x' %>"></i>
      </button>
    <% end %>
  </div>
  <div class="grid-columns-details d-none" data-grid-columns-details>
    <input type="text" class="form-control form-control-sm" placeholder="Help text shown under the field"
           value="<%= field[:help_text] %>" data-form-type-fields-help <%= 'disabled' if locked %>>
    <% if payout_shown %>
      <% choices = [["Bank code (shown in full)", "code"], ["Account identifier (last 4 only)", "account"]] %>
      <% choices.unshift(["No — not bank details", ""]) unless payout_locked %>
      <label class="small text-muted mt-2 d-block">Payout field
        <select class="form-select form-select-sm mt-1" data-form-type-fields-payout data-action="form-type-fields-form#payoutChanged"
                aria-label="Payout field of <%= field[:label] %>">
          <% choices.each do |label, value| %>
            <option value="<%= value %>" <%= 'selected' if field[:payout_field].to_s == value %>><%= label %></option>
          <% end %>
        </select>
      </label>
      <div class="small text-muted mt-1">A change to this field is treated like a bank account change: a second approver must verify. Marking it changes no KYC.</div>
    <% end %>
  </div>
</li>
