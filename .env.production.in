INCOMING_EMAIL_DOMAIN=prod.caphive.app
# The S3 buckets where the docs are stored
AWS_S3_REGION=ap-south-1
# Ensure CORS policy is set for bucket on AWS, and bucket is in the AWS_S3_REGION
AWS_S3_BUCKET=docs.caphive.com.production
# The S3 bucket where the docs are replicated
AWS_S3_BUCKET_REPLICA=docs.caphive.com.production.ap-south-2
# The DB backup (xtrabackup) replica bucket. By convention this would be
# "#{AWS_S3_BUCKET_REPLICA}-backup-xtra", but this env's bucket was created
# manually with a different name, so it is set explicitly here (checked by
# DbBackupFreshnessJob and used by rake aws:provision_s3_buckets).
AWS_S3_BUCKET_REPLICA_XTRA=docs.caphive.com.production-backup-xtra-ap-south2
AWS_S3_REPLICA_REGION=ap-south-2

BASE_URL=https://app.caphive.com
DIGIO_BASE_URL=https://api.digio.in
DIGIO_CLIENT_URL=https://app.digio.in
DOMAIN=caphive.com
ELASTIC_SEARCH_URL=10.0.3.182:9200
HOST=app.caphive.com
BASE_DOMAIN=caphive.com
# Hosts that get the static company website from public/website (first entry
# is canonical, the rest 301 to it). See lib/middleware/website.rb.
WEBSITE_HOSTS=caphive.com,www.caphive.com
REDIS_URL=redis://10.0.3.182:6379
# Emails to be used in development only
SANDBOX_EMAILS='thimmaiah@gmail.com'
SUPPORT_EMAIL_FROM=support@caphive.com
SUPPORT_EMAIL_TO=support@caphive.com
# Where demo requests captured from the public website are announced. Separate
# from SUPPORT_EMAIL_TO so leads do not land in the support/exception firehose.
WEBSITE_LEADS_EMAIL_TO=hello@caphive.com
SMTP_SERVER=email-smtp.ap-south-1.amazonaws.com
# Makes ApplicationMailer#tag_for_bounce_tracking add the X-SES-CONFIGURATION-SET header,
# which is what causes SES to publish Bounce/Complaint events to SNS and on to
# POST /ses_notifications. Without it the pipeline is silent. Created by
# rake "ses:setup_bounce_tracking[production.in]"; check with ses:verify_bounce_tracking.
SES_CONFIGURATION_SET=caphive-production-in
# The ONLY SNS topic /ses_notifications will accept events from. A valid SNS signature only
# proves the message came from some topic in some AWS account, so without this anyone could
# subscribe the endpoint to a topic they control and inject bounce events. The controller
# fails closed: unset means nothing is accepted.
SES_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:825199636520:caphive-ses-events-production-in
# WATI template to be used to send WA messages
CAPHIVE_NOTIFICATION=caphive_notification_6
# XIRR API URL
XIRR_API=http://localhost:8000
CAPHIVE_ENTITY_ID=23
# The region where the app is running
AWS_REGION=ap-south-1
# The region where the backups of the AMIS are stored, recover into this region in DR
AWS_BACKUP_REGION=ap-south-2
KEYNAME=caphive
DB_RESTORE_AMI_NAME="DB-Redis-ES"
PRIVATE_SUBNET_ID=subnet-02c0ca2718fbd6c11
DB_CHECK_STORAGE=30
EXAMPLE_FORMULAS_ENTITY_IDS=841,6349,3103,451,69

SITES={"IN":"https://app.caphive.com","US":"https://app.caphive.us"}
CURRENT_SITE=IN
CLARITY_CODE=tdkfg7xas0


#OPEN_WEB_UI_API_BASE=http://10.0.1.121/api/v1
#OPEN_WEB_UI_URL=https://ai.caphive.com
FAQ_ASSISTANT_ID=asst_PiwMwaXwHB8If9ysjCth4Baf
# ── LP mobile app (openspec/changes/lp-mobile-app, mobile/DEPLOYMENT.md) ──
# Push is on when this region's credentials hold mobile.expo_access_token; leave this false here.
MOBILE_PUSH_ENABLED=false
MOBILE_MIN_APP_VERSION=1.0.0
