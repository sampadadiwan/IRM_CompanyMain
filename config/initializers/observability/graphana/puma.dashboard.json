{
  "id": null,
  "uid": null,
  "title": "Puma Metrics Dashboard",
  "tags": [],
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Puma Workers",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "ruby_puma_workers",
          "legendFormat": "Workers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Booted Workers",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "ruby_puma_booted_workers",
          "legendFormat": "Booted",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Old Workers",
      "description": "Workers from the previous version during a phased restart — should return to 0",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "ruby_puma_old_workers",
          "legendFormat": "Old Workers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Running Threads",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "ruby_puma_running_threads",
          "legendFormat": "Threads",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Request Backlog",
      "description": "Requests waiting for a free thread — non-zero means thread pool is saturated",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "ruby_puma_request_backlog",
          "legendFormat": "Backlog",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Thread Pool Capacity",
      "description": "Free thread slots available to accept new requests",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "ruby_puma_thread_pool_capacity",
          "legendFormat": "Capacity",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Thread Pool — Capacity vs Backlog (trend)",
      "description": "Capacity dropping and backlog rising together is the saturation warning signal",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "ruby_puma_thread_pool_capacity",
          "legendFormat": "Free Thread Capacity",
          "refId": "A"
        },
        {
          "expr": "ruby_puma_running_threads",
          "legendFormat": "Running Threads",
          "refId": "B"
        },
        {
          "expr": "ruby_puma_request_backlog",
          "legendFormat": "Request Backlog",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 }
    },
    {
      "type": "timeseries",
      "title": "Workers (trend)",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "ruby_puma_workers",
          "legendFormat": "Total Workers",
          "refId": "A"
        },
        {
          "expr": "ruby_puma_booted_workers",
          "legendFormat": "Booted Workers",
          "refId": "B"
        },
        {
          "expr": "ruby_puma_old_workers",
          "legendFormat": "Old Workers",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "annotations": { "list": [] }
}
