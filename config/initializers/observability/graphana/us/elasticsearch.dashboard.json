{
  "uid": "caphive-elasticsearch",
  "title": "Elasticsearch",
  "tags": [
    "caphive",
    "data-box"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Health (0 green · 1 yellow · 2 red)",
      "description": "Yellow is normal on a single node (replica shards have nowhere to go). Red = a primary shard is unassigned.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "max(elasticsearch_cluster_health_status{color=\"red\"}) * 2 + max(elasticsearch_cluster_health_status{color=\"yellow\"})",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Heap used %",
      "description": "Includes garbage not yet collected, so it saw-tooths. Only a high level that stays is a problem.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "100 * max(elasticsearch_jvm_memory_used_bytes{area=\"heap\"}) / max(elasticsearch_jvm_memory_max_bytes{area=\"heap\"})",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Live data % of heap",
      "description": "Old generation = data that survives garbage collection. Low here means the heap is bigger than needed.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "100 * max(elasticsearch_jvm_memory_pool_used_bytes{pool=\"old\"}) / max(elasticsearch_jvm_memory_max_bytes{area=\"heap\"})",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Heap size",
      "description": "Heap Elasticsearch reserved (ES_JAVA_OPTS -Xmx, or ~50% of RAM when unset). It holds all of it from start-up.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "max(elasticsearch_jvm_memory_max_bytes{area=\"heap\"})",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Index size (primary)",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum(elasticsearch_indices_store_size_bytes_primary)",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Documents",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum(elasticsearch_indices_docs_primary)",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Memory",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 8,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "JVM Memory (used, committed, max)",
      "description": "Committed is what the JVM holds from the OS. Used below committed is free heap Elasticsearch still keeps.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "label_replace(max(elasticsearch_jvm_memory_used_bytes{area=\"heap\"}), \"series\", \"heap used\", \"\", \"\") or label_replace(max(elasticsearch_jvm_memory_committed_bytes{area=\"heap\"}), \"series\", \"heap committed\", \"\", \"\") or label_replace(max(elasticsearch_jvm_memory_max_bytes{area=\"heap\"}), \"series\", \"heap max\", \"\", \"\") or label_replace(max(elasticsearch_jvm_memory_committed_bytes{area=\"non-heap\"}), \"series\", \"non-heap committed\", \"\", \"\")",
          "legendFormat": "{{series}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Live Data (old generation) vs Heap",
      "description": "Size the heap from the live data: about 3x the old generation leaves room for indexing and searches.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "label_replace(max(elasticsearch_jvm_memory_pool_used_bytes{pool=\"old\"}), \"series\", \"old generation\", \"\", \"\") or label_replace(max(elasticsearch_jvm_memory_max_bytes{area=\"heap\"}), \"series\", \"heap max\", \"\", \"\")",
          "legendFormat": "{{series}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Activity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 11,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Search Queries / s",
      "description": "Query rate across all indices.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum(rate(elasticsearch_indices_search_query_total[5m]))",
          "legendFormat": "queries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Search Latency (ms per query)",
      "description": "Average time per search query over 5 minutes.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "1000 * sum(rate(elasticsearch_indices_search_query_time_seconds[5m])) / sum(rate(elasticsearch_indices_search_query_total[5m]))",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Indexing Operations / s",
      "description": "Documents written per second (reindexes show as spikes).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum(rate(elasticsearch_indices_indexing_index_total[5m]))",
          "legendFormat": "index ops",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "GC Time (s per s)",
      "description": "Share of time spent in garbage collection. Rising old-generation GC means the heap is too small.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum by(gc)(rate(elasticsearch_jvm_gc_collection_seconds_sum[5m]))",
          "legendFormat": "{{gc}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Circuit Breaker Trips (per hour)",
      "description": "Requests Elasticsearch refused to protect its heap. Any trip means a request failed.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum by(breaker)(increase(elasticsearch_breakers_tripped[1h]))",
          "legendFormat": "{{breaker}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Index Size per Index (primary)",
      "description": "On-disk size of each index.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "max by(index)(elasticsearch_indices_store_size_bytes_primary)",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ]
}