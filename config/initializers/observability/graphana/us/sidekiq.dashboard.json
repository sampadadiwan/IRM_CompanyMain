{
  "id": null,
  "uid": "caphive-sidekiq",
  "title": "Sidekiq Memory & Jobs Dashboard",
  "tags": ["sidekiq", "memory"],
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Sidekiq Processes",
      "description": "Live Sidekiq processes pushing metrics — should equal the number of app servers. 0 = Sidekiq is dead (SidekiqDown alert fires)",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "count(count by(hostname)(ruby_rss{type=\"sidekiq\"})) or vector(0)",
          "legendFormat": "Processes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Total Sidekiq RSS",
      "description": "Combined resident memory of all Sidekiq processes across app servers",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by()(ruby_rss{type=\"sidekiq\"})",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 734003200 },
              { "color": "red", "value": 1073741824 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Enqueued Jobs",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "max by()(ruby_sidekiq_stats_enqueued)",
          "legendFormat": "Enqueued",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Queue Latency",
      "description": "How long the oldest waiting job has been queued",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "max by()(ruby_sidekiq_queue_latency_seconds) or vector(0)",
          "legendFormat": "Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Retry Queue",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "max by()(ruby_sidekiq_stats_retry_size)",
          "legendFormat": "Retries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Dead Queue",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "max by()(ruby_sidekiq_stats_dead_size)",
          "legendFormat": "Dead",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Sidekiq Process RSS by Host",
      "description": "Resident memory of each Sidekiq process. Steady growth that never plateaus = leak; sawtooth = normal (monit/restart reclaims)",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "ruby_rss{type=\"sidekiq\"}",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 }
    },
    {
      "type": "timeseries",
      "title": "Sidekiq Heap Live Slots by Host",
      "description": "Live Ruby heap objects in the Sidekiq process — grows with retained objects, complements RSS which also includes malloc/fragmentation",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "max without(pid)(ruby_heap_live_slots{type=\"sidekiq\"})",
          "legendFormat": "{{hostname}} live",
          "refId": "A"
        },
        {
          "expr": "min without(pid)(ruby_heap_free_slots{type=\"sidekiq\"})",
          "legendFormat": "{{hostname}} free",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 }
    },
    {
      "type": "timeseries",
      "title": "Memory Growth Rate by Job Class",
      "description": "RSS growth attributed to each job class (ruby_sidekiq_job_rss_growth_bytes, pushed by SidekiqJobMemoryMetrics middleware). Attribution is approximate under concurrency — sustained leaders are the job classes leaking or spiking memory",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "topk(10, sum by(job_name)(rate(ruby_sidekiq_job_rss_growth_bytes[$__rate_interval])))",
          "legendFormat": "{{job_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "unit": "Bps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 }
    },
    {
      "type": "timeseries",
      "title": "Avg Memory Growth per Job Run",
      "description": "Average RSS growth per execution over the last hour, by job class — the 'cost per run' view. A job averaging 100MB+/run deserves batching or streaming",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by(job_name)(increase(ruby_sidekiq_job_rss_growth_bytes[1h])) / sum by(job_name)(increase(ruby_sidekiq_jobs_total[1h])) > 0",
          "legendFormat": "{{job_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 }
    },
    {
      "type": "timeseries",
      "title": "Object Allocation Rate by Job Class",
      "description": "Ruby objects allocated per second attributed to each job class (ruby_sidekiq_job_allocated_objects). High allocators cause GC pressure and latency even without leaking",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "topk(10, sum by(job_name)(rate(ruby_sidekiq_job_allocated_objects[$__rate_interval])))",
          "legendFormat": "{{job_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 }
    },
    {
      "type": "timeseries",
      "title": "Job Executions per Second by Class",
      "description": "Throughput context for the memory panels — a modest per-run cost times a high execution rate can still dominate total memory churn",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "topk(10, sum by(job_name)(rate(ruby_sidekiq_jobs_total[$__rate_interval])))",
          "legendFormat": "{{job_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 }
    }
  ],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "annotations": { "list": [] }
}
