{
  "uid": "caphive-redis",
  "title": "Redis",
  "tags": [
    "caphive",
    "data-box"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Redis down (0 = up)",
      "description": "Redis holds Sidekiq's queues: while it is down no background job is enqueued or run.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "max(1 - redis_up)",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Used memory",
      "description": "Memory Redis uses for data.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "max(redis_memory_used_bytes)",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Used % of maxmemory",
      "description": "Blank while maxmemory is unlimited. With noeviction, Redis rejects writes at 100%.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "100 * max(redis_memory_used_bytes) / max(redis_memory_max_bytes > 0)",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Connected clients",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum(redis_connected_clients)",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Keys",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum(redis_db_keys)",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Commands / s",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum(rate(redis_commands_processed_total[5m]))",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Memory",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 8,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memory (used, RSS, maxmemory)",
      "description": "maxmemory 0 = unlimited. RSS well above used means fragmentation.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "label_replace(max(redis_memory_used_bytes), \"series\", \"used\", \"\", \"\") or label_replace(max(redis_memory_used_rss_bytes), \"series\", \"RSS\", \"\", \"\") or label_replace(max(redis_memory_max_bytes), \"series\", \"maxmemory\", \"\", \"\")",
          "legendFormat": "{{series}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Fragmentation Ratio",
      "description": "Above ~1.5 on a busy instance, Redis holds noticeably more than its data. On a near-empty one it is naturally high.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "max(redis_mem_fragmentation_ratio)",
          "legendFormat": "RSS / used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Activity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 11,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Commands / s",
      "description": "All commands, including Sidekiq polling.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum(rate(redis_commands_processed_total[5m]))",
          "legendFormat": "commands",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Clients (connected, blocked)",
      "description": "Blocked clients are Sidekiq workers waiting on a queue (BRPOP) - normal.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "label_replace(sum(redis_connected_clients), \"series\", \"connected\", \"\", \"\") or label_replace(sum(redis_blocked_clients), \"series\", \"blocked\", \"\", \"\")",
          "legendFormat": "{{series}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Keys per Database",
      "description": "Key count per Redis database (empty databases hidden).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum by(db)(redis_db_keys) > 0",
          "legendFormat": "db {{db}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Rejected Work (per s)",
      "description": "Rejected connections (maxclients reached) and evicted keys. Both should stay at 0 - with noeviction, a full Redis rejects writes instead of evicting.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "label_replace(sum(rate(redis_rejected_connections_total[5m])), \"series\", \"rejected connections\", \"\", \"\") or label_replace(sum(rate(redis_evicted_keys_total[5m])), \"series\", \"evicted keys\", \"\", \"\")",
          "legendFormat": "{{series}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Error Replies (per s)",
      "description": "Commands Redis answered with an error (OOM at maxmemory shows here).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "dDciTfBDz"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dDciTfBDz"
          },
          "expr": "sum(rate(redis_total_error_replies[5m]))",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}